_values": ["v1.5", "", 30, 0.8, 1, 3, 1000, 120, 4, false, false, true], "inputs": [{"name": "audio", "link": 37, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"shape": 7, "name": "dialogue_audio_s2", "label": "dialogue_audio_s2", "type": "AUDIO", "localized_name": "dialogue_audio_s2"}, {"widget": {"name": "text"}, "name": "text", "link": 36, "type": "STRING"}], "flags": {}, "id": 21, "type": "IndexTTSRun", "properties": {"Node name for S&R": "IndexTTSRun"}, "order": 6}, {"mode": 0, "outputs": [], "size": [573.7554321289062, 112], "pos": [1607.6719970703125, 950.5384521484375], "widgets_values": ["audio/ComfyUI", ""], "inputs": [{"name": "audio", "link": 11, "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "flags": {}, "id": 15, "type": "SaveAudio", "properties": {"Node name for S&R": "SaveAudio"}, "order": 12}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "rgba(38, 73, 116, 0.7)", "widgets_values": ["深秋的上海飘着冷雨，陆沉站在落地窗前，指尖摩挲着那枚褪色的蓝宝石袖扣——那是七年前沈星眠送他的生日礼物。记忆如潮水般涌来：\n那年外滩的烟火大会上，她踮脚为他戴上袖扣，发丝间沾着桂花甜香。他许诺要带她走遍世界的角落，却在三个月后因家族联姻被迫娶了商业对手的女儿。沈星眠在雨夜敲开他公寓的门，浑身湿透地攥着两张机票，却被他冷笑着推出门外：“你以为这七年，我当真能忘了订婚宴上你亲手递给我的离婚协议？”\n\n再次重逢已是三年后。沈星眠褪去了少女的青涩，成为华尔街最年轻的并购顾问。她带着收购陆氏集团的方案走进总裁办公室，却在听到他沙哑的咳嗽声时浑身颤抖——医生诊断书上“肺癌晚期”的字样刺痛了她的眼睛。原来那场车祸后，他冒死为她挡下的钢筋不仅留下疤痕，更抽走了他全部的生机。\n\n“为什么要回来？”陆沉将止痛药扔进垃圾桶，任由癌细胞啃噬着身体。沈星眠颤抖着解开衬衫纽扣，露出锁骨下狰狞的疤痕：“这道你亲手缝的伤口，和当年你父亲派人毁我容貌的刀口，哪个更疼？”她掏出泛黄的日记本，里面夹着他们初遇时买的电影票根，“我策划了三年复仇，却在看到你咳血的瞬间……”\n暴雨拍打着玻璃幕墙，陆沉突然抓住她的手。监控屏幕上，他布满针孔的手背与她无名指上的戒痕重叠——那是她被迫嫁给他人时，他连夜打造的钛钢戒指。此刻两颗心脏在心电图上疯狂跳动，奏响比外滩钟声更悲怆的旋律。\n\n（注：情节融合了青梅竹马背叛、家族阴谋、带病追妻等经典虐恋元素，通过物品意象与身体伤痕强化戏剧张力，符合都市虐恋中“极致爱恨交织”的核心特征\n"], "inputs": [], "flags": {}, "type": "LayerUtility: TextBox", "title": "朗读文本", "mode": 0, "size": [400, 200], "pos": [282.7409362792969, 965.7446899414062], "id": 19, "properties": {"Node name for S&R": "LayerUtility: TextBox"}, "order": 2}, {"outputs": [{"name": "text", "links": [5, 20, 29, 36], "label": "text", "type": "S