": "tile_size", "type": "INT", "localized_name": "tile_size"}, {"widget": {"name": "overlap"}, "name": "overlap", "type": "INT", "localized_name": "overlap"}], "flags": {}, "id": 50, "type": "VAEDecodeAudioTiled", "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecodeAudioTiled"}, "order": 11}, {"mode": 0, "showAdvanced": true, "outputs": [{"name": "CONDITIONING", "links": [47, 44], "type": "CONDITIONING", "localized_name": "条件"}, {"name": "seconds", "links": [45], "type": "FLOAT", "localized_name": "seconds"}], "size": [500, 750], "pos": [2530, 190], "widgets_values": ["Global Metadata\n曲风：工业朋克（Industrial Punk）\n速度：160 BPM，4/4 拍\n调性：E 小调\n情绪：焦躁 → 爆发 → 决绝\n总时长：约 60 秒\n整体氛围：机械压迫感、急促喘息的节奏，副歌有重击式吉他墙\n\nVocal Details\n主唱：男性，嗓音沙哑带吼，主歌为压抑的紧咬字眼，副歌转为全撕裂式嘶吼，加 1 轨高八度和声，制造“群喊”效果。Bridge 段（如果有）省略，直接前后副歌串联。\n\nArrangement\n\n前奏（0–5s）：失真吉他单音 + 底鼓连击 + 打字机采样（渐快）\n\n主歌（5–20s）：合成器低音 + 踩镲 + 清音吉他分解，人声半说半唱\n\n副歌（20–40s）：全员爆裂——失真强力和弦、双底鼓、贝斯同步，锯齿波合成器叠加，人声吼叫\n\n第二主歌（40–45s）：仅贝斯 + 底鼓，两句衔接（压缩）\n\n末段副歌（45–55s）：同上副歌，加一层噪音\n\n尾奏（55–60s）：鼓点骤停，只剩吉他回授音 + 打卡机切断声", "[Intro]\n（器乐 + 打卡声 + 机械节拍）\n\n[Verse 1]  (5–20s)\n闹钟刺穿梦\n身体困牢笼\n地铁挤平庸\n打卡吞分钟\n\n[Chorus]  (20–40s)\n996是刀 割断美好\n青春变老 梦想苦笑\n画饼嘲笑 我们是草\n烧掉 烧掉 全烧掉\n\n[Verse 2]  (40–45s)\n蓝图是谎 不敢抵抗\n健康透支 循环一样\n\n[Chorus]  (45–55s)\n996是刀 割断美好\n青春变老 梦想苦笑\n画饼嘲笑 我们是草\n烧掉 烧掉 全烧掉\n\n[Outro]  (55–60s)\n（人声呢喃：“够了…”  + 吉他回授 + 关机声）", 222, "fixed", 60, 1.7, 50], "inputs": [{"name": "clip", "link": 43, "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "caption"}, "name": "caption", "type": "STRING", "localized_name": "caption"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "seed"}, "name": "seed", "link": 55, "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_duration"}, "name": "max_duration", "type": "FLOAT", "localized_name": "max_duration"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "type": "F