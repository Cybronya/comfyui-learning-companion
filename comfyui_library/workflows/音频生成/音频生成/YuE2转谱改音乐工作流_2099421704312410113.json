calized_name": "style"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "link": 6, "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "cot"}, "name": "cot", "label": "cot", "type": "COMBO", "localized_name": "cot"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}], "flags": {}, "type": "YuE2Plan", "title": "⑥ 谱规划（只出谱，秒级）", "mode": 0, "bgcolor": "#335", "size": [420, 280], "pos": [490, 700], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "YuE2Plan"}, "order": 6}, {"outputs": [{"name": "audio", "links": [10], "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "abc_score", "label": "abc_score", "type": "STRING", "localized_name": "abc_score"}], "color": "#223", "widgets_values": [-1], "inputs": [{"name": "pipe", "link": 2, "label": "pipe", "type": "YUE2_PIPE", "localized_name": "pipe"}, {"name": "plan", "link": 8, "label": "plan", "type": "YUE2_PLAN", "localized_name": "plan"}, {"shape": 7, "name": "abc_override", "link": 7, "label": "abc_override", "type": "STRING", "localized_name": "abc_override"}, {"shape": 7, "name": "sampling", "link": 4, "label": "sampling", "type": "YUE2_SAMPLING", "localized_name": "sampling"}, {"widget": {"name": "seed_override"}, "name": "seed_override", "label": "seed_override", "type": "INT", "localized_name": "seed_override"}], "flags": {}, "type": "YuE2Render", "title": "⑦ 谱渲染（seed -1 = 沿用规划种子）", "mode": 0, "bgcolor": "#335", "size": [420, 240], "pos": [960, 120], "id": 7, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "YuE2Render"}, "order": 7}, {"outputs": [{"name": "STRING", "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#223", "widgets_values": [], "inputs": [{"name": "source", "link": 9, "label": "source", "type": "*", "localized_name": "source"}], "flags": {}, "type": "PreviewAny", "title": "⑧ 规划出的乐谱（复制这里去改谱）", "mode": 0, "bgcolor": "#335", "size": [420, 340], "pos": [960, 400], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 8}, {"outputs": [{"name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#223", "widgets_values": ["yue2_rescore"], "inputs": [{"name": "audio", "link": 10, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudio", "title": "⑨ 保存歌曲", "mode": 0, "bgcolor": "#335", "size": [420, 220], "pos": [960, 780], "id": 9, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 9}, {"outputs": [], "color": "#432", "widgets_values": ["【使用说明 · 先出谱，再改谱，最后渲染】\n这个工作流把作曲拆成两步，让你能【只改旋律，不动歌词和风格】。\n\n第 1 步 · 出谱（秒级，不渲染音频）\n  直接点运行。谱规划会按「音乐风格 + 歌词」产出一份 ABC 乐谱，\n  结果在「规划出的乐谱」预览框里 —— 整段复制出来。\n\n第 2 步 · 改谱\n  把复制到的 ABC 谱粘进「ABC 乐谱（改谱用）」，然后按需要动手：\n  · 改音高/节奏 → 编辑谱里的音符字母与数字\n  · 换调式/速度 → 改谱头的调号与 BPM\n  · 精简段落 → 删掉不想要的乐句\n  注意：留空「ABC 乐谱」= 按自动规划的谱渲染（即不改谱的用法）。\n\n第 3 步 · 渲染\n  再点一次运行，谱渲染节点会按你改后的谱生成完整歌曲。\n\n【小技巧】\n· 演绎种子：同一份谱换个种子，能得到不同唱法与演绎（-1 = 沿用规划种子）。\n· 只想换歌词不换旋律：改「歌词」后保持 ABC 谱留空，谱会自动跟着新歌词重排。\n· 歌词分段用 [Verse] / [Chorus] / [Bridge] 标签，模型靠它判断段落结构。\n· 谱渲染比出谱慢得多，请耐心等待。"], "inputs": [], "flags": {}, "type": "Note", "title": "📖 使用说明（先出谱 → 改谱 → 渲染）", "mode": 0, "bgcolor": "#653", "size": [620, 560], "pos": [1430, 120], "id": 10, "properties": {"widget_ue_connectable": {}}, "order": 5}], "extra": {"0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [522.2222222222222, 622.2222222222222], "scale": 0.45}}, "groups": [], "links": [[1, 1, 0, 6, 0, "YUE2_PIPE"], [2, 1, 0