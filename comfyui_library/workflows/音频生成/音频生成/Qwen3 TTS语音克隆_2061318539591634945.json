14955139160156], "widgets_values": ["石峡村的聚落起源与明代军事防御体系紧密相关。明万历年间，朝廷在此修筑石峡峪堡，设守备一员，驻扎戍卒，控扼居庸关以北通往塞外的峡谷通道。清初顺治年间，随着军事功能消退，郭、梅、董、刘等姓氏移民陆续迁入，军堡转型为民居聚落。这一“军堡村落”的演变路径，是长城沿线数以百计聚落的典型发展模式。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 7, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 1}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [1973.8388006422256, 604.5171152750651], "scale": 0.45}}, "groups": [], "links": [[9, 6, 0, 1, 0, "AUDIO"], [12, 6, 0, 8, 0, "AUDIO"], [14, 1, 0, 8, 8, "STRING"], [17, 7, 0, 8, 3, "STRING"], [19, 8, 0, 12, 0, "AUDIO"]], "id": "f9d622a9-5f73-4d43-bc0c-3da52845f794", "config": {}, "version": 0.4, "last_node_id": 12, "revision": 0}