label": "unload_after", "type": "BOOLEAN", "localized_name": "unload_after"}], "flags": {}, "id": 20, "type": "Qwen3ASRLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Qwen3ASRLoader"}, "order": 0}, {"outputs": [{"name": "STRING", "links": [14], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#322", "widgets_values": ["你知道吗，我原本以为我已经不在乎了，真的，我甚至告诉自己，forget it，let it go，就当一切都没有发生过。可是一到深夜，我还是会想起你说话的声音，想起你站在门口回头看我的那一秒，想起你明明什么都没承诺，却让我一个人把未来想得那么远。我不是舍不得输，我只是突然觉得，原来我认真过，原来我真的把你放进过心里。你可以不爱我，你可以离开，你甚至可以一句解释都不给，可你不能假装那些瞬间从来没有存在过。因为对你来说，也许只是 a moment，可对我来说，那是整整一段 life。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Prompt", "mode": 0, "bgcolor": "#533", "size": [335.85858154296875, 189.93467712402344], "pos": [901.565673828125, 59.29240417480469], "id": 15, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.9.1", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 1}, {"mode": 0, "outputs": [{"name": "audio", "links": [40], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [400, 328], "pos": [441.28399658203125, 44.2161979675293], "widgets_values": ["LongCat-AudioDiT-3.5B-bf16", "Hello! This is your Longcat Audio node speaking, everything is set-up and running smoothly!", 40, 4, "apg", "auto", "bf16", "auto", 789169250, "fixed", true], "inputs": [{"widget": {"name": "model_path"}, "name": "model_path", "label": "model_path", "type": "COMBO", "localized_name": "model_path"}, {"widget": {"name": "text"}, "name": "text", "link": 4, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "guidance_strength"}, "name": "guidance_strength", "label": "guidance_strength", "type": "FLOAT", "localized_name": "guidance_strength"}, {"widget": {"name": "guidance_method"}, "name": "guidance_method", "label": "guidance_method", "type": "COMBO", "localized_name": "guidance_method"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "dtype"}, "name": "dtype", "label": "dtype", "type": "COMBO", "localized_name": "dtype"}, {"widget": {"name": "attention"}, "name": "attention", "label": "attention", "type": "COMBO", "localized_name": "attention"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}], "flags": {}, "id": 1, "type": "LongCatTTS", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LongCatTTS"}, "order": 13}, {"outputs": [{"name": "prompt_list", "links": [], "label": "prompt_list", "type": "LIST", "localized_name": "prompt_list"}, {"shape": 6, "name": "prompt_strings", "links": [], "label": "prompt_strings", "type": "STRING", "localized_name": "prompt_strings"}], "color": "#322", "widgets_values": ["Today we’re talking about a speech model that has been getting a lot of attention lately: LongCat-AudioDiT. This is not just a basic TTS system that reads text aloud. It focuses much more on naturalness, speaker similarity, and controllable multi-speaker dialogue. In simple terms, if you want to build podcasts, character dialogue, model explainers, or even zero-shot voice cloning inside ComfyUI, this model is worth testing. What matters is not just whether it can speak, but whether it sounds human, whether the emotion stays stable, whether long-form speech breaks down, and whether mixed Chinese and English content is handled naturally. That is exactly why many people are starting to compare it with traditional autoregressive TTS systems.", "If you’re looking for a speech model that can run directly in ComfyUI and still sound fairly natural, you should seriously try LongCat-AudioDiT. What impressed me most is not the parameter count, but the fact that the generated voice feels much more like a real person speaking. That matters a lot for short-form content such as model explainers, recommendations, and storytelling clips, where robotic TTS instantly kills the vibe. You can use it for model introductions, character dubbing, two-person dialogue, and even mixed-language text with a few English words. It’s not perfect, but it is exactly the kind of model that fits a practical “get results first” workflow.", "Do you know what hurts the most? I honestly thought I was over it. I kept telling myself, forget it, let it go, just pretend none of it ever happened. But every time the night gets quiet, I still remember the sound of your voice. I still remember that one second when you turned back and looked at me at the door. You never promised me anything, not really, and yet I let myself imagine a whole future alone. It’s not that I can’t accept losing. It’s that I suddenly realized I was sincere. I truly let you into my heart. You don’t have to love me. You can leave. You can even walk away without giving me a single explanation. But you do not get to pretend those moments were never real. Because to you, maybe it was just a moment. To me, it was an entire chapter of my life.", "[speaker_1]: Welcome to today’s AI Audio Talk. We’re discussing a speech model that has been getting a lot of attention recently: LongCat-AudioDiT.\n[speaker_2]: Right. It has become quite popular in the ComfyUI community because people found that it can do much more than standard TTS. It also supports zero-shot voice cloning and multi-speaker dialogue.\n[speaker_1]: And what makes it interesting is that people are not only testing pronunciation accuracy. They are also looking at naturalness, emotional stability, and whether long-form generation starts to drift.\n[speaker_2]: Exactly. When you’re making podcasts, character dialogue, or model explainers, what really matters is whether it sounds like a person speaking instead of a machine just reading the words.\n[speaker_1]: Another key point is mixed-language performance. If you insert a few English technical terms into Chinese, does the model transition naturally, or does the rhythm suddenly break?\n[speaker_2]: So if you want to use it in real content production, don’t judge it by one short demo. Test long-form speech, multi-speaker dialogue, and different reference audios together. Otherwise your conclusion will be too shallow.", "[speaker_1]: I didn’t ask both of you to come here to create more drama. I asked because if we don’t say things clearly now, even more people are going to get hurt.\n[speaker_2]: And you’re saying this now? Don’t you think it’s a little too late? You knew I liked you for a long time, and yet all you ever gave me was that almost-love kind of illusion.\n[speaker_3]: I didn’t even want to come, but I also didn’t want to stay in the dark anymore. The things you told her, you told me too. You said you needed time, but the truth is you were just wavering between two answers.\n[speaker_1]: I admit it. I handled all of this terribly. I thought that as long as I never officially started anything, then I wasn’t really hurting anyone. Now I know that was wrong.\n[speaker_2]: Your mistake wasn’t hesitation. Your mistake was getting close and then stepping back, making me believe in something, and then telling me at the last second that you weren’t ready.\n[speaker_3]: The saddest part is that I’m not even upset because I lost to her. I’m upset because I suddenly realized that neither of us was ever chosen with real certainty.\n[speaker_1]: If an apology still means anything, then I’m sorry. Not because I expect forgiveness, but because for once, I don’t want to run away from what I did."], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "optional_prompt_list", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#533", "size": [406.0674133300781, 730.5181274414062], "pos": [-811.5198974609375, 9.660276412963867], "id": 30, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptList"}, "order": 3}, {"outputs": [{"name": "STRING", "links": [4], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#322", "widgets_values": ["如果你最近在找一个能在 ComfyUI 里直接跑、而且听感比较自然的语音模型，那你真的可以试一下 LongCat-AudioDiT。它最吸引我的地方，不是参数多大，而是生成出来的 voice 真的更像人在说话，尤其是一些介绍类、安利类、storytelling 风格的短视频文案，会明显比那种很机械的 TTS 更有 vibe。你可以拿它测模型解说、角色配音、双人对话，甚至是带一点 English words 的混合文本。说白了，它不是完美，但它很适合做“先出效果”的工作流测试。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Prompt", "mode": 0, "bgcolor": "#533", "size": [335.85858154296875, 189.93467712402344], "pos": [71.0245361328125, 53.40885925292969], "id": 2, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.9.1", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secon