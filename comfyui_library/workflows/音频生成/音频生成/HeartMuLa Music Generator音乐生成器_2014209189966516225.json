ATION}}秒"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 13, "type": "CR Text", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 0}, {"outputs": [], "color": "#432", "widgets_values": ["## RH专用优化节点\n------\n## 本地的话换成\n----\n## 🍱[大炮Qwen3VL本地反推润色](https://github.com/paolaoshi/ComfyUI-Qwen3VL-DP)👈点击跳转"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [437.1629638671875, 211.93438720703125], "pos": [5752.9716796875, 4654.837890625], "id": 29, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"outputs": [{"name": "text", "links": [11], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#0e7e7c", "widgets_values": ["说唱"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#084746", "size": [330.5163269042969, 108], "pos": [4571.70458984375, 4881.95703125], "id": 20, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 2}, {"outputs": [{"name": "text", "links": [8], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#0e7e7c", "widgets_values": ["奋斗"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#084746", "size": [330.5163269042969, 118.10203552246094], "pos": [4595.47509765625, 4702.6381