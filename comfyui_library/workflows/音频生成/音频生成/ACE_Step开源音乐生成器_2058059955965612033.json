ning", "link": 255, "label": "conditioning", "type": "CONDITIONING", "localized_name": "conditioning"}], "flags": {"collapsed": true}, "type": "ConditioningZeroOut", "mode": 0, "bgcolor": "#533", "size": [230, 80], "pos": [1956.35107421875, -479.29437255859375], "id": 47, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ConditioningZeroOut", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["古风：\n演唱：成熟御姐音，带沧桑悲凉感，主歌咬字沉稳叙事如泣如诉，副歌带隐忍的愤懑与撕裂感，尾音带轻微颤音\n曲风定位：古风权谋 / 世家悲歌\n曲风：表面雍容华贵冰冷威严，内里暗流汹涌彻骨悲凉，主歌压抑克制积蓄力量，副歌爆发式控诉，结尾归于死寂\n节奏：中速偏沉，4/4拍，BPM 88，主歌每小节4拍平稳推进，副歌鼓点加重节奏加快，间奏留白2秒营造窒息感\n乐器：低沉古筝琶音、悲怆二胡长音、琵琶轮指、大提琴铺底、沉重大鼓、青铜编钟，间奏加入埙的呜咽声\n混音：人声居中靠前，二胡和古筝分布左右声道，大鼓在低频中心，编钟在高频两侧，整体混响1.5秒，营造大殿空旷感\n\n[前奏]\n\n[第一节]\n朱门深院锁重楼\n玉砌雕栏映月钩\n一朝权倾天下手\n生杀予夺\n尽在王侯\n\n[第二节]\n寒门书生血溅阶\n良家女子泪成海\n一纸诏令覆冤魂\n天理昭昭\n何曾到来\n\n[副歌]\n世家百年\n不过是窃国之贼\n朱门酒肉\n哪管那路有冻骨\n金戈铁马\n踏碎了多少归途\n荣华富贵\n堆起了多少白骨\n\n[间奏]\n\n[副歌]\n世家百年\n不过是窃国之贼\n朱门酒肉\n哪管那路有冻骨\n金戈铁马\n踏碎了多少归途\n荣华富贵\n堆起了多少白骨\n\n[尾奏]\n\n电子舞曲：\n\n演唱：活力女声，带电子感，咬字清晰有力，副歌高亢有爆发力\n曲风定位：电子舞曲 / Future Bass\n曲风：动感十足，充满能量，主歌轻快跳跃，副歌drop部分冲击力强，旋律洗脑\n节奏：快速，4/4拍，BPM 168，4/4拍强拍清晰，鼓点密集有力，bassline律动性强\n乐器：合成器lead、pluck音色、808贝斯、电子鼓、采样人声切片，drop部分加入wobble bass\n混音：bass和鼓点突出，人声在drop部分稍靠后，整体低频饱满，高频明亮，动态范围8dB\n\n[前奏]\n\n[第一节]\n霓虹勾勒破晓边界\n热血挣脱世俗枷锁\n奔赴旷野挣脱平庸\n肆意奔赴\n无畏前路\n[第二节]\n声波划破沉寂夜幕\n信念随节拍不停奔赴\n冲破桎梏挣脱束缚\n心火永驻\n踏碎迷雾\n[副歌]\n迎着风浪奔赴远方\n不惧前路世事跌宕\n怀揣热忱肆意闯荡\n心有光芒\n自有方向\n挣脱迷茫挣脱过往\n以热爱赴每场风浪\n少年锋芒无可阻挡\n肆意生长\n[Drop]\n\n[副歌]\n迎着风浪奔赴远方\n不惧前路世事跌宕\n怀揣热忱肆意闯荡\n心有光芒\n自有方向\n挣脱迷茫挣脱过往\n以热爱赴每场风浪\n少年锋芒无可阻挡\n肆意生长\n[尾奏]\n\n儿歌实例：\n\n演唱：甜美童声，咬字清晰圆润，语气活泼可爱，带一点点奶音\n曲风定位：儿童儿歌 / 童趣治愈\n曲风：活泼可爱轻快明亮，充满童真与想象力，旋律简单重复易记，适合3-8岁小朋友跟唱\n节奏：轻快活泼，4/4拍，BPM 80，节奏鲜明跳跃，每小节重拍清晰\n乐器：钢琴、木琴、铃鼓、三角铁、小提琴、轻快吉他分解和弦，间奏加入童声合唱和清脆鸟鸣音效\n混音：人声非常靠前，乐器音量稍低，整体明亮欢快，混响0.8秒\n\n[第一节]\n太阳公公微微笑\n小鸟枝头唱童谣\n花儿朵朵点头笑\n蝴蝶飞呀\n蜜蜂闹呀\n\n[第二节]\n小朋友们手拉手\n蹦蹦跳跳去郊游\n小河叮咚向前跑\n风儿吹呀\n笑声飘呀\n\n[副歌]\n快乐像小鸟\n飞呀飞呀飞\n幸福像小花\n开呀开呀开\n\n[间奏]\n\n[副歌]\n快乐像小鸟\n飞呀飞呀飞\n幸福像小花\n开呀开呀开\n\n[结尾]\n每天都开心\n健康长高高\n我们是快乐的\n小小太阳花"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [504.2691955566406, 896.1151123046875], "pos": [-197.28164672851562, -1091.9332275390625], "id": 192, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 2}, {"outputs": [], "color": "#432", "widgets_values": ["audio/ACE_Step1.5_xl_turbo", "V0"], "inputs": [{"name": "audio", "link": 263, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudioMP3", "mode": 0, "bgcolor": "#653", "size": [580.7922973632812, 136], "pos": [1565.3062744140625, -965.2462158203125], "id": 107, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"filename_prefix": true, "audioUI": true, "quality": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "SaveAudioMP3", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 16}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [256], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [259.4420166015625, 262], "pos": [1918.764892578125, -387.9237060546875], "widg