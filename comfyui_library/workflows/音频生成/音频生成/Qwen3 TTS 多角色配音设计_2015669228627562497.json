_connectable": {"purge_models": true, "purge_cache": true}}, "widget_ue_connectable": {"purge_models": true, "purge_cache": true}, "secondTabText": "Send Back", "aux_id": "flybirdxx/ComfyUI_LayerStyle", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LayerUtility: PurgeVRAM V2", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 11}, {"outputs": [{"name": "audio", "links": [139], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#2a363b", "widgets_values": ["旁白：深夜亥时，永安宫偏殿已成冷宫，朔风裹着碎雪从破窗渗入，残烛摇曳，寒意刺骨。苏凝华身着旧素衣，发髻散乱，跪伏在青石板上暗自垂泪；萧珩一身玄色常服负手立殿中，周身威压比风雪更甚，脚下踩着昔日为苏凝华插戴的绢花，只剩狼藉。\n\n苏凝华：皇上啊！臣妾真心可昭日月，为何信那毒妇谗言将我打入冷宫？这心……比殿外的雪还凉！臣妾侍奉您十载，从未有过半分异心啊！\n\n萧珩：住口！人证物证俱在，岂容你巧言狡辩！你父兄结党营私、勾结外戚，你敢说一无所知？\n\n苏凝华：臣妾不知！父兄之事与我无关，定是柳贵妃构陷！她嫉妒臣妾得宠，捏造证据挑拨离间，皇上明察啊！\n\n旁白：萧珩眸色微沉，眼底闪过一丝转瞬即逝的复杂，垂眸看着她沾满泪痕与尘土的手，昔日温情余烬转瞬被皇权冷硬熄灭。\n\n萧珩：柳贵妃贤良公允，怎会构陷你？念及旧情与十载侍奉，朕不赐你死罪、不牵累苏家，已是天恩。再敢聒噪提及贵妃，即刻赐白绫！\n\n苏凝华：天恩？不过是囚我、疑我、碾碎我真心罢了。罢了……十年深情，终究是我错付。\n\n旁白：萧珩喉结微动，终是一言不发，转身淡漠吩咐：“永安宫禁足，无朕旨不得探视，断其份例，只留一宫婢伺候。” 玄色身影离去，殿门合上，隔绝了过往温情。残烛燃尽，黑暗笼罩冷宫，只剩苏凝华的压抑哭声伴着风雪回荡。深宫之中，真心从来最廉价。", "1.7B", "auto", "bf16", "Auto", 1, true, 4, 567475524083864, "randomize", 2048, 0.8, 20, 1, 1.05], "inputs": [{"name": "role_bank", "link": 141, "label": "role_bank", "type": "QWEN3_ROLE_BANK", "localized_name": "role_bank"}, {"widget": {"name": "script"}, "name": "script", "label": "script", "type": "STRING", "localized_name": "script"}, {"widget": {"name": "model_choice"}, "name": "model_choice", "label": "model_choice", "type": "COMBO", "localized_name": "model_choice"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "precision"}, "name": "precision", "label": "precision", "type": "COMBO", "localized_name": "precision"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "pause_seconds"}, "name": "pause_seconds", "label": "