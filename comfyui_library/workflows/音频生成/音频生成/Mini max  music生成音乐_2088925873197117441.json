"diffusion_models", "url": "https://huggingface.co/Comfy-Org/MiniMax-Music-3/resolve/main/diffusion_models/minimax_music3_dit_fp16.safetensors"}], "ver": "0.31.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 3}, {"outputs": [{"name": "CLIP", "links": [64], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#233", "widgets_values": ["minimax_music3_text_encoder_pruned_bf16.safetensors", "minimax", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#355", "size": [480, 120], "pos": [1190.301513671875, 323.127685546875], "id": 46, "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "minimax_music3_text_encoder_pruned_int8_convrot.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MiniMax-Music-3/resolve/main/text_encoders/minimax_music3_text_encoder_pruned_int8_convrot.safetensors"}], "ver": "0.31.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 4}, {"outputs": [{"name": "VAE", "links": [72, 76], "type": "VAE", "localized_name": "VAE"}], "color": "#233", "widgets_values": ["minimax_music3_dav.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "type": "VAELoader", "mode": 0, "bgcolor": "#355", "size": [480, 70], "pos": [1189.1651611328125, 488.937744140625], "id": 47, "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "minimax_music3_dav.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/MiniMax-Music-3/resolve/main/vae/minimax_music3_dav.safetensors"}], "ver": "0.31.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 5}, {"outputs": [], "color": "#2a55cf", "widgets_values": ["## MiniMax Music 3 显卡配置指南\n\n### Configuration Tiers\n\n| 档位 | 显存 | 推荐显卡 | 适用版本 | 体验说明 |\n|---|---|---|---|---|\n| 极限尝鲜 | 8 GB | RTX 3050 / 4060 8G | INT8 | 速度很慢，短音频碰碰运气 |\n| 最低可用 | 12 GB | RTX 3060、4070 | INT8 | 开启 lowvram，≤90 秒音乐 |\n| 主力推荐 | 16 GB | RTX 4060Ti、5070Ti | INT8 | 稳定生成完整 3 分钟歌曲 |\n| 满画质 | 24 GB | RTX 4090、5090 | FP16 / INT8 随便选 | 无卸载、生成速度最快 |\n\n### Deployment Notes\n\n- **System RAM**: pair a 12 GB GPU with ≥32 GB system RAM, and a 16 GB GPU with ≥48 GB. CPU offloading under `--lowvram` is memory-heavy.\n- **Song length**: longer tracks consume more KV-cache. A 3-minute song uses roughly 3–4 GB more VRAM than a 30-second clip on the same card.\n- **Hardware**: AMD GPUs have poor ROCm support on Windows and may fail or produce noise; stick with NVIDIA. Laptop GPUs underperform desktop cards with the same VRAM.\n- **Weight choice**: use INT8 ConvRot on anything below 20 GB. FP16 requires 20 GB+ and will OOM on 16 GB cards.\n\n### 吴限宇宙AIGC注释\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "MiniMax Music 3 显卡配置指南", "mode": 0, "bgcolor": "#16171c", "size": [442.5190734863281, 526.3035888671875], "pos": [664.1630249023438, 132.00306701660156], "id": 60, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 6}, {"outputs": [], "color": "#2a55cf", "widgets_values": ["## MiniMax Music 3 歌词段落标签说明\n在Lyrics歌词输入栏中使用方括号标签控制整首歌曲结构，标签是可执行的结构指令，用来划分乐曲段落，规范歌曲篇章排布。\n\n### Parameters\n| Parameter | Description |\n|----|----|\n| [Intro] | 前奏，乐曲开篇段落，适合放置氛围音效、哼唱铺垫，一般不安排主唱演唱 |\n| [Verse] | 主歌，叙事段落，承载主体歌词，旋律舒缓，推进故事情绪 |\n| [Instrumental] | 器乐间奏，纯音乐段落，无人声演唱，用于段落过渡、氛围延展 |\n| [Chorus] | 副歌，全曲核心记忆段落，旋律抓耳、情绪上扬，可重复出现 |\n| [Bridge] | 桥段（过渡段落），旋律与和声产生变化，制造听觉转折，承上启下 |\n| [Outro] | 尾奏/尾声，乐曲收尾段落，音量逐步缓慢淡出，完成整首歌曲收束 |\n\n### Prompt Writing Guide\n段落标签建议**单独成行**放置在对应歌词片段前方，模型识别稳定性最高；\n标签可以自由调整顺序、循环复用，自由搭建完整歌曲结构；\n段落时长受max_duration总时长限制，无法单独指定单段时长。\n\n### 吴限宇宙AIGC注释"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "MiniMax Music 3 歌词段落标签说明", "mode": 0, "bgcolor": "#16171c", "size": [437.7943115234375, 500.2127990722656], "pos": [664.8981323242188, 715.606689453125], "id": 70, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 7}, {"outputs": [{"name": "seed", "links": [73, 74], "label": "seed", "type": "INT", "localized_name": "seed"}], "color": "#233", "widgets_values": [759530641104174, "randomize"], "inputs": [{"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "SeedNode", "mode": 0, "bgcolor": "#355", "size": [485.47406005859375, 108.22937774658203], "pos": [1188.5487060546875, 609.721435546875], "id": 52, "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "SeedNode"}, "order": 8}, {"outputs": [{"name": "MODEL", "links": [85], "label": "MODEL", "type": "MODEL", "localized_name": "模型"}], "color": "#233", "widgets_values": ["auto", false], "inputs": [{"name": "model", "link": 87, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "sage_attention"}, "name": "sage_attention", "label": "sage_attention", "type": "COMBO", "localized_name": "sage_attention"}, {"widget": {"name": "allow_compile"}, "shape": 7, "name": "allow_compile", "label": "allow_compile", "type":