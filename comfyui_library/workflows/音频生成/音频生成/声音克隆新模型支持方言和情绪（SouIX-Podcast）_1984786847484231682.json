有了！比如压干花的时候，得耐心等一周，做钥匙扣时要小心控制滴胶，过程慢但很治愈，反而能让我从快节奏里慢下来。我觉得大家偶尔试试这种小众爱好，说不定能发现新的快乐呢～"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 4, "bgcolor": "#3f5159", "size": [381.5369567871094, 318.0771484375], "pos": [-966.9043579101562, 1043.343994140625], "id": 42, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 1}, {"outputs": [], "color": "#432", "widgets_values": [" # 参数说明\n\n - label=\"temperature\", info=\"采样温度：↑更活跃多样，↓更稳定。语速慢可略升至 0.8~0.9\"\n - label=\"repetition_penalty\", info=\"重复惩罚：↑更少重复但可能卡顿；逐字读可降到 1.02~1.08\"\n - label=\"top_p\", info=\"核采样累计概率：↑更顺畅自然，↓更保守稳定\"\n - info=\"候选限制：↑更自由，↓更稳定。与 top_p 搭配使用\"\n - info=\"Ras窗口：↑增强跨词连贯、减少停顿；过大可能失控\"\n - info=\"Ras阈值：↓更连贯更快，↑更克制防重复。逐字读可降至 0.10~0.12\""], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 4, "bgcolor": "#653", "size": [501.1159362792969, 164.6886749267578], "pos": [2127.72509765625, 1031.1300048828125], "id": 5, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"outputs": [], "color": "#2a363b", "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 31, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "type": "SaveAudio", "mode": 4, "bgcolor": "#3f5159", "size": [292.2368469238281, 141.259033203125], "pos": [2376.2177734375, 713.5256958007812], "id": 32, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 37}, {"outputs": [], "color": "#2a363b", "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 23, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": 