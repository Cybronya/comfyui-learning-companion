 for S&R": "ImpactSwitch"}, "order": 23}, {"outputs": [{"name": "text", "links": [30], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["蓝调无人听"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [630, 176], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 13}, {"outputs": [{"name": "text", "links": [32], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["## 主歌 1\n\n电台循环着热闹的流行说唱\n老旧蓝调 没人跟着节拍摇晃\n弯折的音符裹着尘封过往\n路人摇头 嫌它节奏太过漫长\n\n## 预副歌\n\n没有短视频里洗脑的段落\n没有强劲鼓点追赶着烟火\n蓝调还在诉说旧日的坎坷\n人群匆匆 不愿驻足去琢磨\n\n## 副歌\n\n榜单之上 蓝调不受欢迎\n沉重词句 慢慢归于寂静\n世人偏爱欢喜 不愿触碰心痛\n古老蓝调 留不住听众\n榜单之上 蓝调不受欢迎\n琴弦低泣 迷失在人海中\n世人偏爱欢喜 不愿触碰心痛\n古老蓝调 留不住听众\n\n## 主歌 2\n\n酒馆灯光暗 吉他低声呜咽\n寥寥几个客 静静守着长夜\n歌唱苦日子 离别和眼泪\n世人忙着刷屏 没时间体会\n\n## 桥段\n\n它是摇滚之源 是 R&B 根基\n我们熟悉的歌 都从这里而起\n可这深埋的根 难被人看清\n没人停下脚步 用心倾听\n\n## 尾奏\n\n老蓝调……\n如今少人听\n老蓝调……\n悄悄归于平静"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [1030, 176], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 14}, {"outputs": [{"name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#323", "widgets_values": ["audio1/ComfyUI"], "inputs": [{"name": "audio", "link": 33, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudio", "mode": 0, "bgcolor": "#535