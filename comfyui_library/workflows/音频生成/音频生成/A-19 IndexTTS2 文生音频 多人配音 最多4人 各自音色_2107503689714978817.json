ext"}, "shape": 7, "name": "emotion_text", "label": "emotion_text", "type": "STRING", "localized_name": "emotion_text"}, {"widget": {"name": "enabled"}, "shape": 7, "name": "enabled", "label": "enabled", "type": "BOOLEAN", "localized_name": "enabled"}], "flags": {}, "id": 44, "type": "IndexTTS2_SpeakerEmotionConfig", "title": "Student1 - Confident & Excited", "properties": {"cnr_id": "comfyui-indextts2", "ver": "d162633b900a92447fbf19ddf56cd90ae1fbc520", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "aux_id": "xuchenxu168/Comfyui-Index-TTS2", "Node name for S&R": "IndexTTS2_SpeakerEmotionConfig"}, "order": 0}, {"outputs": [], "color": "#432", "widgets_values": ["# A-19 多人对话配音（最多4人·上传4段声音）\n\n上传 **4 段参考音频**（每位说话人一段）→ 写一份对话脚本 → 直接出一段多人对话配音。\n不用训练、不用写提示词，音色跟着参考音频走。\n\n**怎么用（按左边 ①②③④ 顺序）**\n\n1. **① ~ ④ 说话人参考音频** —— 四位各传一段：**5~12 秒、干净人声、无背景音乐**最稳。\n   只用到 2~3 个人的话，多余的口也传上（可以传同一段凑数，脚本里不写他就不会出现在成品里）。\n2. **⑤ 对话脚本** —— 一行一句，**每句都要用 `Speaker1:` ~ `Speaker4:` 开头**，例如：\n   `Speaker1: 你吃饭了吗？`\n   `Speaker2: 刚吃过，你呢？`\n   脚本里出现几个人，成品里就是几个人的对话。\n3. **⑥ 语速 / 句间停顿** —— `speed` 控制整体语速（1 = 正常），`silence_duration` 控制句子之间的停顿时长。\n4. 运行，到输出目录取 mp3。\n\n**调参提示**\n\n* 参考音频别超过 12 秒、别带 BGM / 混响，否则音色会飘；\n* 每位说话人可以单独配情绪（节点里的 8 维情绪滑条 + 情绪描述），本版统一清成中性，\n  想调就进节点改，没放进用户参数里；\n* 说话人越多、脚本越长，出片越慢；先拿 4 行脚本跑通再上长稿。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [1200, 620], "pos": [-40, -760], "id": 120, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"outputs": [], "color": "#432", "widgets_values": ["① ~ ④ 四位说话人的参考音频\n· 各传 5~12 秒、干净人声、无 BGM\n· 人少也要传满 4 段（可以传同一段）"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [330, 260], "pos": [-380, 0], "id": 121, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"outputs": [], "color": "#432", "widgets_values": ["⑤ 对话脚本：一行一句\n每句都要用 Speaker1: ~ Speaker4: 开头"], "inputs": [], "flags": {}, "t