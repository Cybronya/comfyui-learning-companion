": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#535", "size": [480, 120], "pos": [480, 4262.5], "id": 43, "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "minimax_music3_text_encoder_pruned_int8_convrot.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MiniMax-Music-3/resolve/main/text_encoders/minimax_music3_text_encoder_pruned_int8_convrot.safetensors"}], "ver": "0.31.0", "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 1}, {"outputs": [{"name": "text", "links": [68], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["Global Metadata\n\n  Mandopop / Pop Ballad（华语流行 / 抒情芭乐），配器取向温暖、偏 acoustic-cinematic。速度徐缓，约 70\n  BPM，整体保持从容的叙事感。调性为温暖的大调，略带一丝苦涩的底色。情绪走向：以孤独而怀旧的乡愁开场——一种安静的牵挂——随后经主歌与副歌逐步累积温度与坚定，在副歌处推向充满希望的高点，最终\n  在尾声温柔地消散。画面意象：远方的故乡、月光、袅袅炊烟、游子归家。制作质感：精良高保真，声场宽阔，低频温暖、高频通透；前奏留白，副歌逐渐铺满、压缩感增强以放大情绪。\n\n  Vocal Details\n\n  单一男声，清澈温暖的男高音（tenor）音色；低声区带轻微气声、亲昵内敛，高音区则转为饱满有力的投射。演唱处理：主歌采用克制的叙事口吻，副歌逐渐转为高亢而富有情感的延音与轻微颤音，传递思念\n  与期盼。副歌处加入叠唱的自和声（三度堆叠），增添合唱般的温暖厚度而不喧宾夺主。人声混音：适度板式混响营造纵深，副歌长音处加轻微 delay 拓展空间感，轻压缩保证动态变化中的稳定性。\n\n  Arrangement\n\n  Intro：仅一架三角钢琴，稀疏的分解和弦，无打击乐，奠定怀旧而静谧的氛围。\n\n  Verse 1：钢琴延续琶音；柔和弦乐铺底轻轻进入；木吉他指弹加入温柔律动；软质刷鼓与底鼓确立心跳般的轻脉搏。\n\n  Pre-Chorus：弦乐轻微上扬；节奏收拢为标准 kick-snare；贝斯进入，向副歌蓄力。\n\n  Chorus：钢琴转为更饱满的柱式和弦；完整弦乐组上扬；鼓组展开，加入踩镲与吊镲；木吉他改扫弦；和声加厚，情绪顶点。\n\n  Verse 2：配器回落到钢琴 + 指弹吉他 + 柔弦，呼应第一主歌但更添暖意。\n\n  Pre-Chorus 2：按前一次重建，加入桶鼓填充。\n\n  Chorus 2：比首次更满，弦乐与和声更密。\n\n  Bridge：织体收薄，只余钢琴与弦乐；一把清音电吉他加入克制的对位旋律，节奏似悬停、亲密而克制。\n\n  Final Chorus：全曲最开阔处——完整乐队、弦乐与和声齐进，饱满却不失温度，作为情感的最终释放。\n\n  Outro：层层剥落，只留钢琴与渐弱的弦乐，收在一个长音上，如远去的汽笛。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [448.817