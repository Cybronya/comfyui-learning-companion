, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 5}, {"mode": 0, "outputs": [{"name": "prompt", "links": [19], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [-2272.345458984375, -1047.2373046875], "widgets_values": ["今天是周六，天气特别舒服，不冷不热，风吹在身上很惬意。我想着早上先去弄堂口的小摊买一套大饼油条，再带一杯咸豆浆，上海人早餐就喜欢吃这个，香气扑鼻！\n吃完早餐，打算去豫园逛逛，顺便看看九曲桥旁边的荷花有没有开。要是走累了，就找一家老字号茶馆，点一壶龙井，坐下来歇会儿，听听旁边叔叔阿姨聊天，讲讲上海的老故事，特别有滋味。\n到了下午，再去南京路步行街逛逛，不一定买什么东西，就是看看人来人往，感受下上海的热闹劲儿。傍晚的时候，去外滩吹吹江风，看看对岸陆家嘴的高楼大厦亮灯，那时候的上海，真的特别漂亮！\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 8, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "text", "links": [20], "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "segments_alignment", "label": "segments_alignment", "type": "whisper_alignment", "localized_name": "segments_alignment"}, {"name": "words_alignment", "links": [], "label": "words_alignment", "type": "whisper_alignment", "localized_name": "words_alignment"}], "size": [270, 122], "pos": [-1894.773193359375, -802.7626953125], "widgets_values": ["whisper-large-v3", "auto"], "inputs": [{"name": "audio", "link": 15, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "language"}, "shape": 7, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "id": 11, "type": "Apply Whisper", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Apply Whisper"}, "order": 3}, {"mode": 0, "outputs": [{"name": "Generated Audio", "links": [10], "labe