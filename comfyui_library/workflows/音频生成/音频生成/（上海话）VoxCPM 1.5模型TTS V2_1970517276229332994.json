es": ["大师兄诶～坏事体哉！师父拨隔壁格只妖怪拎得去哉！伊只面孔墨墨乌，牙齿豁豁开，‘嗖’一记就飞到城隍庙上头，快得我连生煎都来不及咬一口！"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 7, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 5}, {"outputs": [], "color": "#432", "widgets_values": ["提示词"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [210, 88], "pos": [-2526.903564453125, -1024.2620849609375], "id": 10, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"outputs": [{"name": "Generated Audio", "links": [10], "label": "Generated Audio", "type": "AUDIO", "localized_name": "Generated Audio"}], "color": "#232", "widgets_values": ["VoxCPM1.5", "哎呀，大师兄，不好咯！师父又遭妖怪抓起跑咯！这回是哪个批妖孽哦，黑黢黢的一坨，扛着师父‘嗖’一下就没得影儿咯！我追得屁儿翻天，结果一跟头栽到田头，啃了一嘴泥巴！师父在那儿喊：‘八戒救我！’我救个铲铲哦，我自身都难保！你还不赶紧翻你的筋斗云，拿你的金箍棒，去给他两坨子！再慢点，师父就要被蒸起、煮起、红烧起咯！老子肚皮都饿扁咯，还等你打妖妖，打完回去吃斋饭！快点儿哦，猴哥，我屁儿都冒烟咯！", 2, 10, false, 910829567787504, "randomize", false, "cuda", 3, 6, ""], "inputs": [{"shape": 7, "name": "prompt_audio", "link": 12, "label": "prompt_audio", "type": "AUDIO", "localized_name": "prompt_audio"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "text"}, "name": "text", "link": 14, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "cfg_value"}, "name": "cfg_value", "label": "cfg_value", "type": "FLOAT", "localized_name": "cfg_value"}, {"widget": {"name": "inference_timesteps"}, "name": "inference_timesteps", "label": "inference_timesteps", "type": "INT", "localized_name": "inference_timesteps"}, {"widget": {"name": "normalize_text"}, "name": "normalize_text", "label": "normalize_text", "type": "BOOLEAN", "localized_name": "normalize_text"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed