mpt_wav", "type": "AUDIO", "localized_name": "prompt_wav"}, {"widget": {"name": "text"}, "name": "text", "link": 89, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "topk"}, "name": "topk", "label": "topk", "type": "INT", "localized_name": "topk"}, {"widget": {"name": "prompt_text"}, "shape": 7, "name": "prompt_text", "label": "prompt_text", "type": "STRING", "localized_name": "prompt_text"}], "flags": {}, "id": 68, "type": "FireRedTTS2MonologueNode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "FireRedTTS2MonologueNode"}, "order": 2}, {"mode": 0, "outputs": [{"name": "prompt", "links": [89], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [1915.0421142578125, 559.3268432617188], "widgets_values": ["贞贞，见字如晤，展笺如面。春水初生，春林渐盛，春风十里，不及卿之一笑之温。自卿之影映于心田，若朝霞染岫，波光潋滟；如晨露濡华，拂尽尘襟之倦。每闻卿名，心间便自开净莲，亭亭出水，隔千万里，似仍可倾听卿低语。卿之眸，澄若星汉，清光可照九州；卿之仪，若姑射仙子临风，冰肌玉骨，纤尘不染。举手投足，皆动我心弦，清音袅袅，余韵绕梁。纵知云端尘世，天涯相隔，然心之所向，千山万水不过一瞬。愿倾寸心，书数千素字，字字为卿；愿付余生，守一轮明月，岁岁并看。倘得与卿同游——春可踏花，夏可听雨，秋可观叶，冬可煮雪。纵岁月流转，山长水阔，亦不负今生相思之约。是信也，愿渡红尘之嚣，越万里之遥，抵卿掌心，伴卿眉间笑。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 67, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 0}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.16.8", "VHS_latentpreview": false, "ds": {"offset": [-1581.1559343058834, 322.72196474556455], "scale": 0.7972024500000007}}, "groups": [{"color": "#3f789e", "font_size": 240, "flags": {}, "id": 1, "tit