_name": "text_d"}, {"widget": {"name": "delimiter"}, "name": "delimiter", "label": "delimiter", "type": "STRING", "localized_name": "delimiter"}, {"widget": {"name": "clean_whitespace"}, "name": "clean_whitespace", "label": "clean_whitespace", "type": "COMBO", "localized_name": "clean_whitespace"}], "flags": {}, "id": 49, "type": "Text Concatenate", "properties": {"cnr_id": "was-node-suite-comfyui", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {"delimiter": true, "clean_whitespace": true}, "Node name for S&R": "Text Concatenate"}, "order": 10}, {"mode": 0, "outputs": [{"name": "PODCAST_INPUT", "links": [23], "label": "PODCAST_INPUT", "type": "PODCAST_INPUT", "localized_name": "PODCAST_INPUT"}], "size": [583.8505859375, 546.9284057617188], "pos": [296.1352844238281, 3860.635009765625], "widgets_values": ["json", "[S1] 哎呀，大师兄，不好咯！师父又遭妖怪抓起跑咯！这回是哪个批妖孽哦，黑黢黢的一坨，扛着师父‘嗖’一下就没得影儿咯！我追得屁儿翻天，结果一跟头栽到田头，啃了一嘴泥巴！师父在那儿喊：‘八戒救我！’我救个铲铲哦，我自身都难保！你还不赶紧翻你的筋斗云，拿你的金箍棒，去给他两坨子！再慢点，师父就要被蒸起、煮起、红烧起咯！老子肚皮都饿扁咯，还等你打妖妖，打完回去吃斋饭！快点儿哦，猴哥，我屁儿都冒烟咯！", "{\n    \"speakers\": {\n      \"S1\": {\n        \"prompt_audio\": \"example/audios/female_mandarin.wav\",\n        \"prompt_text\": \"喜欢攀岩、徒步、滑雪的语言爱好者，以及过两天要带着全部家当去景德镇做陶瓷的白日梦想家。\",\n        \"dialect_prompt\": \"<|Sichuan|>要得要得！前头几个耍洋盘，我后脚就背起铺盖卷去景德镇耍泥巴，巴适得喊老天爷！\"\n      },\n      \"S2\": {\n        \"prompt_audio\": \"example/audios/male_mandarin.wav\",\n        \"prompt_text\": \"呃，还有一个就是要跟大家纠正一点，就是我们在看电影的时候，尤其是游戏玩家，看电影的时候，在看到那个到西北那边的这个陕北民谣，嗯，这个可能在想，哎，是不是他是受到了黑神话的启发？\",\n        \"dialect_prompt\": \"<|Yue|>，又跟广东靓仔学了句“猴赛雷”，现在走路都带三省混音，气势拉满！T8你就给我在家抱着显卡哭，等老娘心情好了再考虑把你从黑名单里放出来，到时候记得把搓衣板换成火锅底料，跪起来才够味儿！\"\n      }\n    },\n    \"text\": [\n      [\"S1\", \"<|Sichuan|>哎呀，大师兄，不好咯！师父又遭妖怪抓起跑咯！这回是哪个批妖孽哦，黑黢黢的一坨，扛着师父‘嗖’一下就没得影儿咯！我追得屁儿翻天，结果一跟头栽到田头，啃了一嘴泥巴！师父在那儿喊：‘八戒救我！’我救个铲铲哦，我自身都难保！你还不赶紧翻你的筋斗云，拿你的金箍棒，去给他两坨子！再慢点，师父就要被蒸起、煮起、红烧起咯！老子肚皮都饿扁咯，还等你打妖妖，打完回去吃斋饭！快点儿哦，猴哥，我屁儿都冒烟咯！\"]\n    ]\n  }"], "inputs": [{"name": "soulx_model", "link": 25, "label": "soulx_model", "type": "SOULX_MODEL", "localized_name": "soulx_model"}, {"shape": 7, "name": "S1_prompt_audio", "link": 26, "label": "S1_prompt_audio", "type": "AUDIO", "localized_name": "S1_prompt_audio"}, {"shape": 7, "name": "S2_prompt_audio", "label": "S2_prompt_audio", "type": "AUDIO", "localized_name": "S2_prompt_audio"}, {"widget": {"name": "input_mode"}, "name": "input_mode", "label": "input_mode", "type": "COMBO", "localized_name": "input_mode"}, {"widget": {"name": "dialogue_script"}, "shape": 7, "name": "dialogue_script", "label": "dialogue_script", "type": "STRING", "localized_name": "dialogue_script"}, {"widget": {"name": "json_config"}, "shape": 7, "name": "json_config", "link": 31, "label": "json_config", "type": "STRING", "localized_name": "json_config"}], "flags": {}, "id": 44, "type": "SoulXPodcastInputParser", "properties": {"cnr_id": "soulx-podcast", "ver": "3c6f56382ffbfd246b39c691d37cf6fb3a3482e0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {"json_config": true, "input_mode": true, "dialogue_script": true}, "Node name for S&R": "SoulXPodcastInputParser"}, "order": 11}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [958.597900390625, 470.8897705078125], "pos": [249.95419311523438, 4475.24658203125], "widgets_values": ["{\n    \"speakers\": {\n      \"S1\": {\n        \"prompt_audio\": \"example/audios/female_mandarin.wav\",\n        \"prompt_text\": \"喜欢攀岩、徒步、滑雪的语言爱好者，以及过两天要带着全部家当去景德镇做陶瓷的白日梦想家。\",\n        \"dialect_prompt\": \"<|Sichuan|>要得要得！前头几个耍洋盘，我后脚就背起铺盖卷去景德镇耍泥巴，巴适得喊老天爷！\"\n      },\n      \"S2\": {\n        \"prompt_audio\": \"example/audios/male_mandarin.wav\",\n        \"prompt_text\": \"呃，还有一个就是要跟大家纠正一点，就是我们在看电影的时候，尤其是游戏玩家，看电影的时候，在看到那个到西北那边的这个陕北民谣，嗯，这个可能在想，哎，是不是他是受到了黑神话的启发？\",\n        \"dialect_prompt\": \"<|Yue|>，又跟广东靓仔学了句“猴赛雷”，现在走路都带三省混音，气势拉满！T8你就给我在家抱着显卡哭，等老娘心情好了再考虑把你从黑名单里放出来，到时候记得把搓衣板换成火锅底料，跪起来才够味儿！\"\n      }\n    },\n    \"text\": [\n      [\"S1\", \"<|Sichuan|>哎呀，大师兄，不好咯！师父又遭妖怪抓起跑咯！这回是哪个批妖孽哦，黑黢黢的一坨，扛着师父‘嗖’一下就没得影儿咯！我追得屁儿翻天，结果一跟头栽到田头，啃了一嘴泥巴！师父在那儿喊：‘八戒救我！’我救个铲铲哦，我自身都难保！你还不赶紧翻你的筋斗云，拿你的金箍棒，去给他两坨子！再慢点，师父就要被蒸起、煮起、红烧起咯！老子肚皮都饿扁咯，还等你打妖妖，打完回去吃斋饭！快点儿哦，猴哥，我屁儿都冒烟咯！\"]\n    ]\n  }"], "inputs": [{"name": "text", "link": 32, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 50, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 12}, {"outputs": [], "color": "#432", "widgets_values": [" # 参数说明\n\n - label=\"temperature\", info=\"采样温度：↑更活跃多样，↓更稳定。语速慢可略升至 0.8~0.9\"\n - label=\"repetition_penalty\", info=\"重复惩罚：↑更少重复但可能卡顿；逐字读可降到 1.02~1.08\"\n - label=\"top_p\", info=\"核采样累计概率：↑更顺畅自然，↓更保守稳定\"\n - info=\"候选限制：↑更自由，↓更稳定。与 top_p 搭配使用\"\n - info=\"Ras窗口：↑增强跨词连贯、减少停顿；过大可能失控\"\n - info=\"Ras阈值：↓更连贯更快，↑更克制防重复。逐字读可降至 0.10~0.12\""], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [525.0966796875, 371.0878601074219], "pos": [1272.1922607421875, 4330.0556640625], "id": 41, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}}, "order": 9}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [21, 24], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "size": [270, 246], "pos": [929.0169677734375, 3928.193359375], "widgets_values": [3919864923, "randomize", 0.8, 1.2500000000000002, 150, 0.9000000000000001, 8, 3000], "inputs": [{"name": "soulx_model", "link": 22, "label": "soulx_model", "type": "SOULX_MODEL", "localized_name": "soulx_model"}, {"name":