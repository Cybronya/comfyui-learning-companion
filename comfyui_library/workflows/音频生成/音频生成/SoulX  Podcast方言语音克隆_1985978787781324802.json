get": {"name": "upload"}, "name": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 7, "type": "LoadAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.3.66", "widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 2}, {"mode": 0, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [216.79737854003906, 272.0701599121094], "pos": [1063.6820068359375, 1146.9462890625], "widgets_values": ["粤语\n\n[S1]<|Yue|>讲起呢个AI真系搞笑，我上个礼拜教佢识别点心头像，点知佢将虾饺烧卖分得清清楚楚唔在讲，仲自己发明咗个「流沙包指数」——边个茶楼嘅流沙包爆浆率超过78.6%，佢就自动帮我落单订位，搞到而家成个家族饮茶都等我部手机发号施令！\n[S2]<|Yue|>你呢个都未算厉害！我个AI助手先至癫，琴日将我阿嬷嘅陈皮鸭配方分析出三百几种分子结构，半夜自己同智能砂煲开研讨会，今朝整出隻会随住室温变色嘅梦幻陈皮鸭，成条街嘅流浪猫排住队嚌我屋企窗口口水！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 44, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}, {"outputs": [], "color": "#432", "widgets_values": ["官方仓库地址\nhttps://github.com/Soul-AILab/soulX-Podcast"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [418.912353515625, 88], "pos": [448.4606628417969, 959.6483154296875], "id": 39, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"outputs": [], "color": "#432", "widgets_values": ["陪跑学习AI咨询\nV+:laibin4201"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [210, 88], "pos": [207.4534454345703, 957.9734497070312], "id": 38, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"mode": 0, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [407.4641418457031, 272.98248291015625], "pos": [631.2808227539062, 1144.7373046875], "widgets_values": ["河南话\n\n\n[S1]<|Henan|>俺前阵子想学AI那个劲儿啊，就跟三伏天想喝井拔凉水一样！看见人家搞智能推荐，馋得俺半夜蹲院儿里挠墙！报上咱这儿的AI班才明白，啥叫机器学习！就跟俺娘揉面团似的，数据越揉越光溜！头天学了个推荐算法，第二天俺那小卖部营业额跟坐窜天猴似的！老师教俺整的那个用户画像，准得跟老中医号脉一样！哪个顾客想买啥，俺一瞅一个准儿！街坊都说俺成精了，其实俺就是把AI使唤得跟自家驴一样听话！最得劲的是现在看数据看报表，那些数字自个儿会说话！俺坐店里喝着茶，手机叮叮当当响个不停——全是AI给俺挣的钱！这玩意儿比养个能干儿子还管用哩！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 36, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}, {"mode": 0, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [407.4641418457031, 272.98248291015625], "pos": [1615.8568115234375, 1154.2164306640625], "widgets_values": ["情绪表达：\n大笑 <|laughter|>\n叹气 <|sigh|>\n呼吸 <|breathing|>\n咳凑 <|coughing|>\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 40, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [431.5152587890625, 438.0224609375], "pos": [1622.4027099609375, 1522.060546875], "widgets_values": ["参数设置\n\n- **temperature**（当前值：0.6）：\n  控制生成内容的“多样性/随机性”。数值越低（如0.2）生成越固定、聚焦；越高（如1.0）越随机、有创意。0.6属于“中等偏稳”的设定。\n\n- **repetition_penalty**（当前值：1.25）：\n  抑制内容重复的参数。数值越大，模型越会避免重复用词/句子（1.25属于轻度抑制重复）。\n\n- **top_k**（当前值：100）：\n  生成每个词时，只从“概率最高的前100个词”中选择。数值越小，选择范围越窄，内容越固定；越大则越灵活。\n\n- **top_p**（当前值：0.90）：\n  生成每个词时，只从“累积概率达到90%的词”中选择（动态范围，概率高的词会被优先保留）。0.9属于“保留多数合理选项”的设定。\n\n- **min_tokens**（当前值：8）：\n  生成内容的“最少长度”（至少生成8个词/标记，避免内容过短）。\n\n- **max_tokens**（当前值：3000）：\n  生成内容的“最长长度”（最多生成3000个词/标记，避免内容过长）。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 35, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 8}, {"mode": 0, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [407.4641418457031, 272.98248291015625], "pos": [200.79298400878906, 1144.11669921875], "widgets_values": ["描述方式 \n\n多人对话模板：\n[S1]美女\n[S2]帅哥\n[S1]你好\n[S2]我好\n\n窍门：让Deepseek帮修改方言文字\n\n方言-在前面加上：\n河南话 <|Henan|>\n粤语 <|Yue|>\n四川话 <|Sichuan|>\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 34, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 9}, {"mode": 0, "outputs": [{"name": "PODCAST_INPUT", "links": [27], "label": "PODCAST_INPUT", "type": "PODCAST_INPUT", "localized_name": "PODCAST_INPUT"}], "size": [421.82452392578125, 521.1929931640625], "pos": [564.4732055664062, 1523.4271240234375], "widgets_values": ["simple", "[S1]<|Sichuan|>哎哟我那个麻将机才叫妖艳儿，昨晚自己洗牌搞出清一色龙七对，把隔壁子王大爷气得胡子翘起八丈高！\n[S2] <|Sichuan|>你算啥子嘛！我家泡菜坛子成精了，前天自己往里头加了二荆条和花椒，现在泡出来的萝卜都在坛子里跳《麻辣 disco》！", "{}"], "inputs": [{"name": "soulx_model", "link": 24, "label": "soulx_model", "type": "SOULX_MODEL", "localized_name": "soulx_model"}, {"shape": 7, "name": "S1_prompt_audio", "link": 39, "label": "S1_prompt_audio", "type": "AUDIO", "localized_name": "S1_prompt_audio"}, {"shape": 7, "name": "S2_prompt_audio", "link": 32, "label": "S2_prompt_audio", "type": "AUDIO", "localized_name": "S2_prompt_audio"}, {"widget": {"name": "input_mode"}, "name": "input_mode", "label": "input_mode", "type": "COMBO", "localized_name": "input_mode"}, {"widget": {"name": "dialogue_script"}, "shape": 7, "name": "dialogue_script", "label": "dialogue_script", "type": "STRING", "localized_name": "dialogue_script"}, {"widget": {"name": "json_config"}, "shape": 7, "name": "json_config", "label": "json_config", "typ