": [1487.0924072265625, -205.67588806152344], "id": 124, "properties": {"ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}}, "order": 12}, {"mode": 0, "outputs": [{"name": "STRING", "links": [130], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [400, 200], "pos": [1481.071044921875, -630.5555419921875], "widgets_values": ["俺老孙来也！三界之内谁不知俺齐天大圣的名号？当年大闹天宫，金箍棒一挥，十万天兵都拦不住；五行山下压了五百年，照样初心不改，跟着唐僧西天取经，降妖除魔从不含糊！\n俺这根定海神针能长能短，火眼金睛识得所有妖魔鬼怪，七十二变玩转各路神通！别瞧俺偶尔调皮捣蛋，可护师父、护师弟的心比谁都真，一路上闯过火焰山、打过白骨精，啥难关没见过？\n如今虽已成斗战胜佛，但那股天不怕地不怕的劲儿可没丢！做人就得像俺这样，敢闯敢拼、讲义气、有担当！不管遇到啥麻烦，只要拿出勇气和智慧，就没有跨不过的坎！\n怎么样，想不想跟着俺老孙一起，活出咱自己的精彩？冲就完事儿了！\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 140, "type": "Text Multiline", "properties": {"cnr_id": "was-node-suite-comfyui", "ver": "1.0.2", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 13}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.32.9", "VHS_latentpreview": false, "ds": {"offset": [-589.8578257296335, 1064.8356716673252], "scale": 0.9646149645000038}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "single person", "bounding": [1157.462646484375, -1053.8687744140625, 2513.1806640625, 1094.583984375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Group", "bounding": [1477.0924072265625, -405.6758728027344, 396.880859375, 298.40850830078125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "two person", "bounding": [1155.15673828125, 74.93536376953125, 2542.430419921875, 1277.2586669921875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "emo text", "boundin