B", "oss-20260123", 484466004787486, "randomize", 240, 50, 1, 1.5, true, "auto", false], "inputs": [{"widget": {"name": "lyrics"}, "name": "lyrics", "link": 24, "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "tags"}, "name": "tags", "link": 26, "label": "tags", "type": "STRING", "localized_name": "tags"}, {"widget": {"name": "version"}, "name": "version", "label": "version", "type": "COMBO", "localized_name": "version"}, {"widget": {"name": "codec_version"}, "name": "codec_version", "label": "codec_version", "type": "COMBO", "localized_name": "codec_version"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_audio_length_seconds"}, "name": "max_audio_length_seconds", "label": "max_audio_length_seconds", "type": "INT", "localized_name": "max_audio_length_seconds"}, {"widget": {"name": "topk"}, "name": "topk", "label": "topk", "type": "INT", "localized_name": "topk"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "offload_mode"}, "name": "offload_mode", "label": "offload_mode", "type": "COMBO", "localized_name": "offload_mode"}, {"widget": {"name": "quantize_4bit"}, "name": "quantize_4bit", "label": "quantize_4bit", "type": "BOOLEAN", "localized_name": "quantize_4bit"}], "flags": {}, "id": 31, "type": "HeartMuLa_Generate", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "HeartMuLa_Generate"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["1. max_audio_length_ms\n含义：最大音频长度，单位是毫秒（ms）\n作用：设置输入音频的最长允许时长。这里设为 240000，也就是240 秒（4 分钟）。\n超过这个时长的音频会被自动截断，确保模型处理的音频长度在设计范围内，避免内存溢出或性能问题。\n2. topk\n含义：Top-K 采样\n作用：生成时只从概率最高的前 K 个候选词中随机选择。这里设为 50。\n值越大，生成结果越丰富但可能发散；值越小，结果越聚焦但可能单调。\n它常用于文本生成、语音合成或音乐生成类模型，平衡多样性与连贯性。\n3. temperature\n含义：温度系数\n作用：控制生成结果的随机性。这里设为 1.0，是中性值。\n温度越高（>1），生成越随机、创意性越强；温度越低（<1），生成越保守、越倾向于高概率内容。\n1.0 表示完全按照模型预测的概率分布进行采样，不做额外调整。\n4. cfg_scale (Classifier-Free Guidance Scale)\n含义：无分类器引导系数\n作用：控制提示词（Prompt）对生成结果的影响强度。这里设为 1.5。\n值越高，生成结果越严格遵循提示词；值越低，生成结果更自由、受提示词约束更小。\n常见范围在 1~10 之间，1.5 属于较低的引导强度，适合希望保留一定生成自由度的场景。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [421.1338195800781, 269.5132751464844], "pos": [410.1844482421875, 468.4607238769531], "id": 6, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"mode": 0, "outputs": [], "size": [423.38555908203125, 209.80332946777344], "pos": [888.8880004882812, -31.159252166748047], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 19, "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 2, "type": "SaveAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.10.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 9}, {"mode": 0, "outputs": [{"name": "text", "links": [24, 25], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [547.2273559570312, 418.5643005371094], "pos": [-435.06707763671875, -166.75083923339844], "widgets_values": ["[Verse]  \n你轻声在耳边诉说  \n像春风唤醒了沉睡的草坡  \n每一寸光影都闪烁  \n回忆在心中悄然洒落  \n\n[Prechorus]  \n你的笑容是我的星河  \n指引我走过每个曲折  \n时间的沙漏慢慢流过  \n只愿此刻永恒不朽  \n\n[Chorus]  \n爱像一首未完的歌  \n每个音符都是你的轮廓  \n在梦里与你共舞一刻  \n心跳在你眼中沸腾着  \n\n[Verse]  \n雨滴轻落窗前的花朵  \n像你柔情浸润我的生活  \n每一句话温暖了冷漠  \n彼此依靠，彼此探索  \n\n[Bridge]  \n时间在指尖悄然滑落  \n未来的路谁都无法预测  \n只要有你，哪怕风雨交错  \n心中世界依然闪烁  \n\n[Chorus]  \n爱像一首未完的歌  \n每个音符都是你的轮廓  \n在梦里与你共舞一刻  \n心跳在你眼中沸腾着  \n\n[Outro]  \n你是我故事的开端和结果  \n在这人生的剧本里永久闪烁"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 9, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}, {"mode": 0, "outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 150], "pos": [426.90814208984375, -241.1432647705078], "widgets_values": ["", "", "txt", true], "inputs": [{"name": "text", "link": 25, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "output_file_path"}, "name": "output_file_path", "label": "output_file_path", "type": "STRING", "localized_name": "output_file_path"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overwrite", "type": "BOOLEAN", "localized_name": "overwrite"}], "flags": {}, "id": 30, "type": "easy saveText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy saveText"}, "order": 7}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.37.11", "VHS_latentpreview": true, "ds": {"offset": [1257.8661565781824, 1351.2474670698696], "scale": 0.3073560549142824}