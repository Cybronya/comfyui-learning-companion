一遍遍改稿 守住初心模样\\n好设计自带 属于它的立场\\n替沉默的人 轻声诉说所想\\n就算所有人 都催我退让\\n我要把美 安放在该去的地方\\n\\n[Bridge]\\n如果你熬过 这样漫长夜晚\\n如果你反复 修改一遍又一遍\\n请记得\\n我们放大的是温度 不是字号\\n我们守住的是光 不是外表\\n\\n[Chorus]\\n我依然热爱 这份笨拙的倔强\\n把美留在 该在的地方"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 9, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [378.25817190240514, -215.92755282438577], "scale": 1.167184107045001}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Group", "bounding": [71.6506576538086, 242.62319946289062, 2342.541259765625, 923.2481079101562]}], "links": [[1, 1, 1, 2, 0, "CLIP"], [2, 1, 1, 3, 0, "CLIP"], [3, 1, 0, 4, 0, "MODEL"], [4, 2, 1, 5, 0, "FLOAT"], [5, 5, 0, 4, 3, "LATENT"], [6, 2, 0, 4, 1, "CONDITIONING"], [7, 2, 0, 4, 2, "CONDITIONING"], [8, 4, 0, 6, 0, "LATENT"], [9, 1, 2, 6, 1, "VAE"], [10, 3, 0, 2, 3, "STRING"], [11, 6, 0, 7, 0, "AUDIO"], [12, 6, 0, 8, 0, "AUDIO"], [17, 10, 0, 3, 1, "STRING"], [18, 10, 0, 2, 1, "STRING"], [19, 9, 0, 3, 2, "STRING"], [20, 9, 0, 2, 2, "STRING"]], "id": "53a4b6ea-be80-46b3-b4e8-52782fc43bf2", "config": {}, "version": 0.4, "last_node_id": 10, "revision": 0}