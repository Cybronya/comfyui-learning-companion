 "label": "nfe_steps", "type": "INT", "localized_name": "nfe_steps"}, {"widget": {"name": "cfg_strength"}, "name": "cfg_strength", "label": "cfg_strength", "type": "FLOAT", "localized_name": "cfg_strength"}, {"widget": {"name": "sway_sampling_coef"}, "name": "sway_sampling_coef", "label": "sway_sampling_coef", "type": "FLOAT", "localized_name": "sway_sampling_coef"}], "flags": {}, "id": 3, "type": "AuKGenerateEdit_Doc", "properties": {"widget_ue_connectable": {"use_prompt_enhancer": true, "seed": true, "cfg_strength": true, "instruction": true, "nfe_steps": true, "sway_sampling_coef": true, "generation_seconds": true}, "Node name for S&R": "AuKGenerateEdit_Doc"}, "order": 5}, {"outputs": [], "color": "#432", "widgets_values": ["# 本地 llama.cpp 提示词增强\n\n1. 在 Llama-cpp Model Loader 中选择自己的 GGUF 指令模型。\n2. 按模型选择 chat_handler；纯文本 GGUF 通常用 None，mmproj 也可选 None。\n3. 保持 Generate 的 Enable Prompt Enhancer 开启，然后运行。\n\n不需要 API Key 或 HTTP 服务。官方多阶段增强流程仍会运行。\n\n本示例需要已安装的 **llama-cpp_vllm** 插件，适配输出类型 LLAMACPPMODEL。其他同名加载器不保证兼容。\n\n默认增强后卸载本地模型，下次自动重载。该模型为加载器共享实例，其他使用同一插件的节点需要时也会重载。\n\nLoader 的 vram_limit 是近似值；此插件的 0 不表示纯 CPU。默认示例设 2 GB，不代表整条流程一定低于 8 GB。\n\n模型需能遵循指令并输出有效 JSON；思考模式可能占满输出长度。上下文不足时调整 n_ctx。参考音频的 ASR 仍走 AuK 原有流程。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "本地增强使用说明", "mode": 0, "bgcolor": "#653", "size": [480, 640], "pos": [694.7531127929688, 603.2673950195312], "id": 9, "properties": {"widget_ue_connectable": {}}, "order": 0}], "extra": {"links_added_by_ue": [], "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-139.726651486894, -150.27812477375957], "scale": 1.2839025177495011}}, "groups": [], "links": [[1, 1, 0, 3, 0, "AUK_ENGINE_Doc"], [2, 3, 0, 4, 0, "AUDIO"], [3, 3, 0, 5, 0, "AUDIO"], [4, 6, 0, 3, 2, "AUK_LLM_CONFIG_Doc"], [5, 8, 0, 6, 0, "LLAMACPPMODEL"], [6, 10, 0, 3, 1, "AUDIO"]], "id": "66938a1a-2443-4372-a138-c61f99b0f6e0", "config": {}, "version": 0.4, "last_node_id": 14, "revision": 0}