ame": "剪枝类型"}], "flags": {}, "id": 104, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "models": [{"name": "acestep_v1.5_turbo.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/ace_step_1.5_ComfyUI_files/resolve/main/split_files/diffusion_models/acestep_v1.5_turbo.safetensors"}], "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 4}, {"mode": 0, "outputs": [], "size": [310, 136], "pos": [1650, -820], "widgets_values": ["audio/ComfyUI", "V0"], "inputs": [{"name": "audio", "link": 263, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 107, "type": "SaveAudioMP3", "properties": {"cnr_id": "comfy-core", "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"filename_prefix": true, "audioUI": true, "quality": true}, "Node name for S&R": "SaveAudioMP3"}, "order": 11}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [254, 255], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "size": [500, 730], "pos": [350, -750], "widgets_values": ["Zen Epic Electronic: A profound fusion of ancient Zen aesthetics and modern cinematic electronics. The ethereal sound of the Guqin (seven-stringed zither) deepens the atmosphere, accompanied by heavy industrial percussion and soaring synth pads. A haunting female vocal whisper-sings, building into a powerful, wide-range operatic climax. The texture balances the silence of a bamboo forest with the gravity of a cosmic storm. female voice.", "[Intro - Ethereal Guqin & Distant Reverb] 菩提本无树，明镜亦非台\n\n[Verse 1 - Minimalist Electronic Pulse & Guqin] 菩提本无树，明镜亦非台。本来无一物，何处惹尘埃。身如琉璃，内外明澈。\n\n[Verse 2 - Driving Industrial Percussion & Dark Bass] 坐断乾坤，万缘放下。看破红尘梦，转瞬已千年。心如止水，波澜不惊，却见惊雷起。\n\n[Chorus - Massive Orchestral Surge & High-pitch Vocals] 无我，无相。万法归一，归于虚无。如是我闻，如梦幻泡影，如露亦如电。\n\n[Outro - Fading Echo & Wind Chimes] 亦如电。无一物……何处惹尘埃。", 31, "fixed", 190, 120, "4", "zh", "E minor"], "inputs": [{"name": "clip", "link": 261, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "tags"}, "name": "tags", "label": "tags", "type": "STRING", "localized_name": "tags"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "seed"}, "name": "seed", "link": 257, "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "bpm"}, "name": "bpm", "label": "bpm", "type": "INT", "localized_name": "bpm"}, {"widget": {"name": "duration"}, "name": "duration", "link": 251, "label": "duration", "type": "FLOAT", "localized_name": "duration"}, {"widget": {"name": "timesignature"}, "name": "timesignature", "label": "timesignature", "type": "COMBO", "localized_name": "timesignature"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "keyscale"}, "name": "keyscale", "label": "keyscale", "type": "COMBO", "localized_name": "keyscale"}], "flags": {}, "id": 94, "type": "TextEncodeAceStepAudio1.5", "properties": {"cnr_id": "comfy-core", "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {"duration": true, "seed": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"duration": true, "seed": true, "timesignature": true, "language": true, "k