, "type": "BOOLEAN", "localized_name": "download_if_missing"}, {"widget": {"name": "accept_model_license"}, "name": "accept_model_license", "label": "accept_model_license", "type": "BOOLEAN", "localized_name": "accept_model_license"}], "flags": {}, "type": "T8_BreezeTTS_ModelLoader", "title": "① 模型加载器 · 先勾选许可证", "mode": 0, "bgcolor": "#535", "size": [313.3918151855469, 174], "pos": [1214.991943359375, 1033.7374267578125], "id": 12, "properties": {"cnr_id": "comfyui-breeze-tts-T8", "ver": "0.2.5", "widget_ue_connectable": {}, "Node name for S&R": "T8_BreezeTTS_ModelLoader"}, "order": 2}, {"outputs": [{"name": "audio", "slot_index": 0, "links": [16], "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "generation_info", "slot_index": 1, "label": "generation_info", "type": "STRING", "localized_name": "generation_info"}], "color": "#323", "widgets_values": [], "inputs": [{"name": "model", "link": 9, "label": "model", "type": "BREEZE_T8_MODEL", "localized_name": "model"}, {"name": "request", "link": 10, "label": "request", "type": "BREEZE_T8_REQUEST", "localized_name": "request"}, {"name": "settings", "link": 11, "label": "settings", "type": "BREEZE_T8_SETTINGS", "localized_name": "settings"}], "flags": {}, "type": "T8_BreezeTTS_Generate", "title": "5 生成音频", "mode": 0, "bgcolor": "#535", "size": [330, 160], "pos": [1669.4276123046875, 1265.9661865234375], "id": 11, "properties": {"cnr_id": "comfyui-breeze-tts-T8", "ver": "0.2.5", "widget_ue_connectable": {}, "Node name for S&R": "T8_BreezeTTS_Generate"}, "order": 20}, {"outputs": [{"name": "text", "links": [14, 27], "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "segments_alignment", "label": "segments_alignment", "type": "whisper_alignment", "localized_name": "segments_alignment"}, {"name": "words_alignment", "label": "words_alignment", "type": "whisper_alignment", "localized_name": "words_alignment"}], "color": "#323", "widgets_values": ["whisper-large-v3-turbo", "auto", ""], "inputs": [{"name": "audio", "link": 17, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "language"}, "shape": 7, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "prompt"}, "shape": 7, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "Apply Whisper", "mode": 0, "bgcolor": "#535", "size": [304.4606628417969, 147.30039978027344], "pos": [484.2406005859375, 1065.2684326171875], "id": 16, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Apply Whisper"}, "order": 14}, {"outputs": [{"name": "output", "type": "*", "localized_name": "output"}], "color": "#323", "widgets_values": ["安心地去吧,不要在这耍赖了。"], "inputs": [{"shape": 7, "name": "anything", "link": 27, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#535", "size": [310.2100830078125, 146.6132049560547], "pos": [837.2147216796875, 1067.90771484375], "id": 31, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 17}, {"outputs": [{"name": "request", "slot_index": 0, "links": [10], "label": "request", "type": "BREEZE_T8_REQUEST", "localized_name": "request"}], "color": "#323", "widgets_values": ["我们需要认真讨论一下昨晚发生的事情。", "请替换为参考音频的准确逐字稿。", "语速放慢，语气克制而严肃。", 4], "inputs": [{"name": "reference_audio", "link": 12, "label": "reference_audio", "type": "AUDIO", "localized_name": "reference_audio"}, {"widget": {"name": "text"}, "name": "text", "link": 34, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "reference_text"}, "name": "reference_text", "link": 14, "label": "reference_text", "type": "STRING", "localized_name": "reference_text"}, {"widget": {"name": "direction"}, "name": "direction", "link": 15, "label": "direction", "type": "STRING", "localized_name": "direction"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}], "flags": {}, "type": "T8_BreezeTTS_DirectionRequest", "title": "③ 声音导演 · 填准确逐字稿", "mode": 0, "bgcolor": "#535", "size": [319.4417419433594, 220], "pos": [1218.341796875, 1284.839111328125], "id": 13, "properties": {"cnr_id": "comfyui-breeze-tts-T8", "ver": "0.2.5", "widget_ue_connectable": {}, "Node name for S&R": "T8_BreezeTTS_DirectionRequest"}, "order": 19}, {"outputs": [{"name": "prompt", "links": [35], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#323", "widgets_values": ["---\nname: emotion-tone-tagging\ndescription: 为中文对白、口播稿、短剧台词、小说对话和字幕文本分析情绪、关系张力与表达意图，并在自然气口、语义转折和情绪落点插入简洁的[语气词]表演标签；当用户要求“加语气词”“加情绪”“标注语气”“优化台词表现”“按气口加[笑]/[冷哼]”或需要可直接用于配音、TTS、短剧和视频生成的带标签文本时使用。\n---\n\n# 情绪语气词增强\n\n## 目标\n\n将用户提供的文本处理成可直接用于配音、TTS、短剧或视频生成的带语气标签文本。先在内部判断情绪曲线、说话人意图、对象关系、情绪强度和停连，再以最小改动插入标签。\n\n默认只输出处理后的文本，不展示冗长分析，不改写原句，不新增实义信息。用户明确要求分析、解释或对照时，再补充情绪判断。\n\n## 处理流程\n\n1. 读取原文，识别段落、说话人、对白边界、标点、已有舞台指示和换行。\n2. 按上下文判断每个段落或台词的：\n   - 主要情绪和可能的次级情绪。\n   - 说话目的，例如试探、调侃、拒绝、安慰、质问、威胁、解释或告别。\n   - 说话人与对象的关系，以及情绪是外露、克制还是反讽。\n   - 情绪强度和变化方向，例如由轻松转冷、由克制转爆发、由嘴硬转脆弱。\n3. 标出适合换气或改变表演状态的位置。\n4. 为每个关键位置选择一个短、具体、可表演的标签。\n5. 将标签插入原文，复核语义、标点、节奏、角色身份和标签数量。\n6. 输出增强后的全文；除非用户要求，否则不输出分析表或修改说明。\n\n## 输入识别\n\n- 将引号中的内容、角色名后的台词、剧本对白和无引号的自然语言默认视为可处理的说话内容。\n- 处理多角色文本时，按说话人和每个自然段分别判断，不能把上一角色的情绪误传给下一角色。\n- 对旁白、动作说明、标题、注释、代码、命令、网址、表格和已有结构化标签保持原样，除非用户明确要求“全文包含旁白”或指定处理范围。\n- 识别并保留用户已有的`[标签]`、`（动作）`、`<音效>`等标记；不要重复添加同义标签，也不要把已有标签嵌套进新标签。\n- 输入只有一句或信息不足时，使用最保守的判断；无法确认情绪时可以不加标签，不要为了覆盖率强行添加。\n\n## 情绪判断\n\n根据整句和前后文判断，不要只根据单个词机械匹配。重点区分以下容易混淆的状态：\n\n- 真笑、礼貌笑、苦笑、嘲笑和冷笑。\n- 生气、压着火、失望、轻蔑和单纯语气强硬。\n- 害怕、震惊、尴尬、迟疑和故意停顿。\n- 温柔、宠溺、安慰、平静和冷淡。\n- 口头上的肯定或否定与真实意图相反的反讽、嘴硬和试探。\n\n将情绪强度粗略分为低、中、高三级：\n\n- 低强度使用`[轻笑]`、`[淡淡地]`、`[低声]`、`[迟疑]`等克制标签。\n- 中强度使用`[玩味]`、`[冷哼]`、`[叹气]`、`[沉声]`、`[压着火]`等明确标签。\n- 高强度使用`[大笑]`、`[怒斥]`、`[咬牙]`、`[哽咽]`、`[颤声]`等强标签，但必须有文本证据支撑。\n\n情绪不等于音量。除非文本明确表现出喊叫、低语或急促，否则不要擅自添加`[提高音量]`、`[压低声音]`或`[急促]`。\n\n## 气口定位\n\n优先在以下位置考虑插入标签：\n\n- 整句或整行开始处：标签作用于整句的初始状态，例如`[冷淡]我只是随口一问。`\n- 称呼之后：称呼后情绪明显变化时，例如`[轻笑]江辰，你还真来了。`\n- 逗号、分号、破折号、省略号或换行形成的自然停连处。\n- “但是”“可是”“原来”“所以”“你以为”“没想到”等语义转折或揭示前后。\n- 反问、质问、威胁、表白、道歉、拒绝和关键落点之前。\n- 同一句中从一种情绪切换到另一种情绪的边界处。\n\n遵守以下插入规则：\n\n- 一个标签默认统领其后的一个短语或分句；标签要贴近它所修饰的内容。\n- 标签直接贴在台词前，例如`[笑]江辰，你不会以为我真的喜欢你吧？`\n- 标签不替代原标点，不额外制造逗号、句号或引号。原文有标点就保留原标点。\n- 标签只放在自然可呼吸的位置，不要插入人名、词语内部、数字、专有名词或固定搭配中间。\n- 短句通常插入0至1个标签；较长句按情绪转折插入1至2个标签；除非用户要求高密度表演标注，否则单句不超过3个。\n- 语气连续时不要每个分句都加标签；宁可少而准，也不要形成“标签噪音”。\n- 不要为了制造气口而重写词序、补句、删句或改变人称。\n\n## 标签选择\n\n使用简短、具体、能被演员或语音模型执行的标签。优先从下表选择，也可根据上下文生成同类短标签：\n\n| 表演状态 | 常用标签 |\n| --- | --- |\n| 自然喜悦、友好 | `[笑]`、`[轻笑]`、`[欣慰]`、`[宠溺]` |\n| 调侃、玩味、反讽 | `[玩味]`、`[嗤笑]`、`[冷笑]`、`[讥讽]` |\n| 不屑、鄙夷 | `[冷哼]`、`[不屑]`、`[轻蔑]`、`[嘲弄]` |\n| 生气、压抑、爆发 | `[压着火]`、`[咬牙]`、`[沉怒]`、`[怒斥]`、`[厉声]` |\n| 悲伤、无奈、受伤 | `[叹气]`、`[苦笑]`、`[低声]`、`[哽咽]`、`[失落]` |\n| 犹豫、停顿、欲言又止 | `[迟疑]`、`[停顿]`、`[欲言又止]`、`[深吸气]` |\n| 惊讶、害怕、慌乱 | `[惊讶]`、`[愕然]`、`[倒吸凉气]`、`[颤声]`、`[慌乱]` |\n| 平静、认真、冷淡 | `[平静]`、`[认真]`、`[淡淡地]`、`[冷淡]`、`[沉声]` |\n| 音量、速度和发声方式 | `[轻声]`、`[压低声音]`、`[提高音量]`、`[急促]`、`[缓慢]` |\n\n不要把抽象心理诊断直接当作标签，例如`[感到复杂]`、`[内心十分矛盾]`；将其转换为可听见或可表演的表现，例如`[迟疑]`、`[苦笑]`、`[深吸气]`。不要堆叠多个近义标签，例如不要同时使用`[冷笑][讥讽][不屑]`，除非用户明确要求逐层表演。\n\n用户指定标签词表、标签语言、标签密度、标签格式或禁用词时，优先遵守用户约束；无法兼容时，保留原文并说明冲突。\n\n## 输出规则\n\n- 默认只输出增强后的文本，不加“分析结果”“修改后”等标题，不使用代码围栏，不重复一份未处理原文。\n- 保留原文的说话人、段落、换行、引号、标点和文本顺序。只新增方括号标签。\n- 使用半角方括号格式`[标签]`，除非用户要求改用其他括号。\n- 用户要求“只加语气词”时，禁止润色、改错别字、补标点或重写句子。\n- 用户要求展示分析时，先给一段简短的情绪概括，再给增强后的全文；分析要说明主要情绪、情绪转折和标签依据，不逐字解释。\n- 用户要求多个版本时，提供“克制版”“自然版”“强化版”等差异明确的版本，分别控制标签数量和强度；不要只机械替换标签。\n\n## 复核清单\n\n输出前逐项检查：\n\n- 每个标签都能从上下文找到依据。\n- 标签放在可换气或情绪变化的位置。\n- 没有把反讽误判成真诚，也没有把克制误判成爆发。\n- 没有改变原文事实、人物关系、语义、标点和顺序。\n- 没有连续堆叠同义标签，也没有给每个标点都加标签。\n- 标签短、具体、可听见、可表演。\n- 标签不会误伤旁白、标题、代码、网址或用户已有标记。\n\n## 示例\n\n输入：\n\n```text\n江辰，你不会以为我真的喜欢你吧？你也不照照镜子看看你是什么东西！\n```\n\n输出：\n\n```text\n[笑]江辰，你不会以为我真的喜欢你吧？[冷哼]你也不照照镜子看看你是什么东西！\n```\n\n输入：\n\n```text\n我没事，真的。\n```\n\n输出：\n\n```text\n[强装镇定]我没事，[低声]真的。\n```\n\n输入：\n\n```text\n你回来就好。\n```\n\n输出：\n\n```text\n[轻声]你回来就好。\n```\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#535", "size": [301.1695861816406, 317.83636474609375], "pos": [843.962646484375, 1531.9627685546875], "id": 36, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 3}, {"outputs": [{"name": "response", "links": [30], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "raw_response", "label": "raw_response", "type": "STRING", "localized_name": "raw_response"}], "color": "#323", "widgets_values": ["qwen/qwen3.8-max", "You are a helpful assistant", "Hello", 0.6, 4096, 1, 0, 0, "none", 1973505467, "randomize", false], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "model"}, "name": "model", "l