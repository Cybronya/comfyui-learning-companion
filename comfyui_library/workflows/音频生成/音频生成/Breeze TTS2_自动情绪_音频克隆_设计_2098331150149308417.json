{"last_link_id": 35, "nodes": [{"outputs": [{"name": "audio", "slot_index": 0, "links": [4], "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "generation_info", "slot_index": 1, "label": "generation_info", "type": "STRING", "localized_name": "generation_info"}], "color": "#7a405f", "widgets_values": [], "inputs": [{"name": "model", "link": 1, "label": "model", "type": "BREEZE_T8_MODEL", "localized_name": "model"}, {"name": "request", "link": 2, "label": "request", "type": "BREEZE_T8_REQUEST", "localized_name": "request"}, {"name": "settings", "link": 3, "label": "settings", "type": "BREEZE_T8_SETTINGS", "localized_name": "settings"}], "flags": {}, "type": "T8_BreezeTTS_Generate", "title": "4 生成音频", "mode": 4, "bgcolor": "#38202f", "size": [330, 160], "pos": [1109.53271484375, 2265.18994140625], "id": 4, "properties": {"cnr_id": "comfyui-breeze-tts-T8", "ver": "0.2.5", "widget_ue_connectable": {}, "Node name for S&R": "T8_BreezeTTS_Generate"}, "order": 15}, {"outputs": [{"name": "settings", "slot_index": 0, "links": [3], "label": "settings", "type": "BREEZE_T8_SETTINGS", "localized_name": "settings"}], "color": "#4b4777", "widgets_values": [1500, 0.9, 50, 1, 1.1, 0.9, 50, 1, 1908543058, "randomize"], "inputs": [{"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "top_p"}, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "repetition_penalty"}, "name": "repetition_penalty", "label": "repetition_penalty", "type": "FLOAT", "localized_name": "repetition_penalty"}, {"widget": {"name": "depth_temperature"}, "name": "depth_temperature", "label": "depth_te