outputs": [{"name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#222", "widgets_values": ["audio/audio_minimax_music3", "mp3", "V0"], "inputs": [{"name": "audio", "link": 79, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "format"}, {"widget": {"name": "format.quality"}, "name": "format.quality", "label": "format.quality", "type": "COMBO", "localized_name": "quality"}], "flags": {}, "type": "SaveAudioAdvanced", "mode": 0, "bgcolor": "#000", "size": [210, 106], "pos": [2728.38037109375, 706.1666259765625], "id": 35, "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveAudioAdvanced"}, "order": 11}, {"showAdvanced": true, "outputs": [{"name": "CONDITIONING", "links": [65, 68], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}, {"name": "seconds", "links": [66], "label": "seconds", "type": "FLOAT", "localized_name": "seconds"}], "color": "#222", "widgets_values": ["Chinese Folk, Acoustic Guitar, Harmonica, Male vocal, storytelling, nostalgic, warm, slow tempo, indie folk, raw emotion, campfire vibe", "[Intro]\n(Acoustic guitar fingerpicking, slow and nostalgic)\n(Sound of a distant train whistle and wind)\n[Verse 1]\n老站台的长椅掉漆了半边\n卖报纸的大爷换了新的老花眼\n我背着那把破木吉他坐在屋檐\n看着绿皮火车吐出一圈圈白烟\n[Verse 2]\n你说南方的冬天不会下大雪\n那里的榕树一年四季都不落叶\n我把写满梦想的草稿揉成团\n扔进站台旁那个生锈的垃圾桶里面\n[Chorus]\n开往南方的慢车 晃晃悠悠地走\n带走我的十九岁 和没说出口的挽留\n车窗外的风景 像倒带的旧电影\n谁在岁月的尽头 等着我回头\n(和声：等着我回头~)\n[Interlude]\n(Harmonica solo, melancholic and warm, acoustic guitar accompaniment)\n[Verse 3]\n后来我在拥挤的地铁里睡着\n梦里又闻到老家院子里的桂花香\n房东太太催缴房租的敲门声\n把我从二十平米的出租屋敲醒到天亮\n[Chorus]\n开往南方的慢车 晃晃悠悠地走\n带走我的十九岁 和没说出口的挽留\n车窗外的风景 像倒带的旧电影\n谁在岁月的尽头 等着我回头\n[Bridge]\n(Strumming becomes heavier, emotion builds up, slight vocal rasp)\n他们说青春就是一场回不去的旅行\n可我为何总在深夜里红了眼睛\n如果那张单程车票还能退改签\n我愿用所有繁华 换回那个秋天\n[Guitar Solo]\n(Emotional acoustic guitar solo with light Cajon percussion)\n[Chorus]\n(Vocal with full emotion, slightly raspy)\n开往南方的慢车 晃晃悠悠地走\n带走我的十九岁 和没说出口的挽留\n车窗外的风景 像倒带的旧电影\n谁在岁月的尽头 笑着看我回头\n[Outro]\n(Tempo slows down, returning to simple fingerpicking)\n老站台的长椅 掉漆了半边...\n卖报纸的大爷 已经不见...\n(Humming)\n嗯... 晃晃悠悠... 晃晃悠悠...\n(Fade out with a final warm guitar chord)\n[End]", 222, "fixed", 180, 1.7, 50], "inputs": [{"name": "clip", "link": 64, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "caption"}, "name": "caption", "label": "caption", "type": "STRING", "localized_name": "caption"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "seed"}, "name": "seed", "link": 73, "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_duration"}, "name": "max_duration", "label": "max_duration", "type": "FLOAT", "localized_name": "max_duration"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}], "flags": {}, "type": "MiniMaxMusic3TextEncode", "mode": 0, "bgcolor": "#000", "size": [350.5503845214844, 667.613525390625], "pos": [1119.7313232421875, 637.6461791992188], "id": 45, "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"seed": true, "caption": true, "lyrics": true}, "Node name for S&R": "MiniMaxMusic3TextEncode"}, "order": 4}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "