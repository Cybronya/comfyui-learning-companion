AUDIO", "localized_name": "audio"}, {"widget": {"name": "model_size"}, "name": "model_size", "label": "model_size", "type": "COMBO", "localized_name": "model_size"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "id": 44, "type": "WhisperSTT", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "WhisperSTT"}, "order": 6}, {"mode": 0, "outputs": [{"name": "是否启用优先", "label": "是否启用优先", "type": "BOOLEAN", "localized_name": "是否启用优先"}, {"name": "输出结果", "links": [60, 61], "label": "输出结果", "type": "*", "localized_name": "输出结果"}], "size": [206.36190795898438, 46], "pos": [-1290.3499755859375, -346.3537902832031], "inputs": [{"shape": 7, "name": "优先输入", "link": 58, "label": "优先输入", "type": "*", "localized_name": "优先输入"}, {"shape": 7, "name": "备用输入", "link": 59, "label": "备用输入", "type": "*", "localized_name": "备用输入"}], "flags": {}, "id": 50, "type": "AnySwitch", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AnySwitch"}, "order": 5}, {"mode": 0, "outputs": [{"name": "audio", "links": [55], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [373.3451843261719, 498], "pos": [-763.1752319335938, -388.59521484375], "widgets_values": ["昨天有个小伙伴给我发消息，他说：“我想搞点副业，但我翻来覆去想了三天，发现自己什么都不会。没特长，没学历，怎么办？”\n我叹了口气，这问题我听了没有 100 遍，也有 80 遍了。\n我反问他：“你会打字吗？会说话吗？”\n他愣住了，回了一串省略号。\n我说，只要你会其中一样，是个大活人，在互联网上就饿不死。\n很多人啊，就是被 “技能” 这两个金光闪闪的大字给吓破了胆。总觉得非得会写代码、会做设计、会拍电影才叫本事，才配赚钱。\n不是的。\n你帮一个忙得脚不沾地的老板，把他杂乱无章的网盘资料整理得清清楚楚，分类命名，一键搜索就能找到。这是不是技能？太是了。这能收钱吗？当然能！而且不少小白领、小老板就缺这个 “整理” 的手。\n你性格开朗，特别能聊，能接住各种梗，能让一个郁闷的人开心起来。你去试试 “陪伴聊天”，一小时几十块，有没有市场？你去看看那些语音直播，不就是变着法儿地陪人说话吗？\n说得再邪乎点，你脾气爆，嘴皮子利索，逻辑清晰。现在甚至有 “代骂” 服务，当然这个咱不提倡啊，但存在即合理，它说明一个什么问题？只要你能解决一部分人的特定需求，哪怕这个需求有点 “歪”，它就能变成钱。\n你觉得这都太低级？那好，咱们说点 “高级” 的。\n你每天刷抖音、刷 B 站，对吧？看到那些几百万赞的热门视频，解说电影的、讲历史的、分享知识的。你心里是不是也嘀咕过：“这我也能讲啊。”\n对，你就能。\n你不用成为第一个发明轮子的人，你只需要学会怎么把轮子描述得让人心动。你把那个热门视频的文案，用自己的大白话重新说一遍，配上你自己的表情和肢体语言，拍出来。这就是你的作品，这就是你的 “复述” 技能。\n多少人靠解读名著、解读电影、解读热点活着，而且活得很好。他们是最初的作者吗？不是。但他们提供了新的视角、新的情绪价值。\n千万别掉进 “准备陷阱”。总想等自己什么都学会了，装备都买齐了，再轰轰烈烈开始。最好的学习，永远是 “在打仗中学会打仗”。\n你不是什么都不会，你只是还没把你 “会” 的东西，用商业的眼光看一遍。把你日常做的、能做的任何小事，乘以一个 “有人可能需要”，再乘以一个 “我愿意收费”，一个新世界的大门可能就打开了。", "0.6B", "auto", "bf16", "Auto", "", 605011508346934, "randomize", 2048, 0.8, 20, 1, 1.05, false, "auto", false], "inputs": [{"shape": 7, "name": "ref_audio", "link": 61, "label": "ref_audio", "type": "AUDIO", "localized_name": "ref_audio"}, {"shape": 7, "name": "voice_clone_prompt", "label": "voice_clone_prompt", "type": "VOICE_CLONE_PROMPT", "localized_name": "voice_clone_prompt"}, {"widget": {"name": "target_text"}, "name": "target_text", "link": 63, "label": "target_text", "type": "STRING", "localized_name": "target_text"}, {"widget": {"name": "model_choice"}, "name": "model_choice", "label": "model_choice", "type": "COMBO", "localized_name": "model_choice"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "precision"}, "name": "precision", "label": "precision", "type": "COMBO", "localized_name": "precision"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "ref_text"}, "shape": 7, "name": "ref_text", "link": 53, "label": "ref_text", "type": "STRING", "localized_name": "ref_text"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_new_tokens"}, "shape": 7, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "top_p"}, "shape": 7, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "top_k"}, "shape": 7, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "temperature"}, "shape": 7, "name": "temperature", "label": "temperature", "ty