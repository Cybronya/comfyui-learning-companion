fix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 7, "type": "SaveAudioMP3", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudioMP3"}, "order": 6}, {"mode": 0, "outputs": [{"name": "prompt", "links": [5], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [366.2543640136719, 480.3280029296875], "pos": [-103.81803131103516, -136.48269653320312], "widgets_values": ["最近我一直在测试一台新的相机。\n\n它的传感器从 24MP 提升到了 48MP，但我觉得真正值得关注的，其实不是这个数字。\n\n我更在意的是视频对焦。\n\n目前这台相机运行的是 Firmware 2.1，我分别测试了 Windows PC 和 Mac 两套工作流程。\n\n如果使用 Windows，可以直接通过 USB-C 连接电脑，再打开官方软件完成升级。整个过程大概需要 8 分钟。\n\n如果是 Mac，部分功能则需要通过 Web UI 完成。\n\n除了这些比较常规的操作之外，我还特别测试了它在低光环境下的表现。\n\n晚上拍摄的时候，我把快门速度降低到 1/50 秒，再配合 ISO 3200。\n\n这个时候如果人物移动比较快，自动对焦就会开始面临更大的压力。\n\n但从我这几天的实际体验来看，这一代的表现确实比之前稳定了不少。\n\n所以如果你平时主要拍 Vlog、旅行或者室内视频，这次更新还是值得关注的。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 6, "type": "CR Prompt Text", "title": "生成文本", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 1}, {"mode": 0, "outputs": [{"name": "IndexTTS 2.5 模型", "links": [1], "label": "IndexTTS 2.5 模型", "type": "T8_INDEXTTS25_MODEL", "localized_name": "IndexTTS 2.5 模型"}, {"name": "模型信息", "links": [], "label": "模型信息", "type": "STRING", "localized_name": "模型信息"}], "size": [390, 342], "pos": [302.4372863769531, -335.2119140625], "widgets_values": ["IndexTTS-2.5", "auto", "auto", "off", false, false, 0, false, "auto", false, true, ""], "inputs": [{"widget": {"name": "model_name"}, "name":