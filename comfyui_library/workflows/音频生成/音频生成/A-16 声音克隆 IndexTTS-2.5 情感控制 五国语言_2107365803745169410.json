TRING", "type": "STRING", "localized_name": "字符串"}], "size": [240, 90], "pos": [0, 1300], "widgets_values": ["ES"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "id": 204, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 5}, {"mode": 0, "outputs": [{"name": "STRING", "links": [105], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [240, 90], "pos": [0, 1400], "widgets_values": ["AR"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "id": 205, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["# A-16 声音克隆IndexTTS-2.5（上传参考音频·情感控制）\n\n上传一段参考音频 → 克隆音色 → 输入想说的话 → 出一段 mp3。全程不用写提示词。\n\n**怎么用（按左列 ①②③④ 顺序）**\n\n1. **① LoadAudio** —— 上传参考音频：**5~12 秒、干净人声、无背景音乐**最稳。\n2. **② AudioCrop** —— 自动只取前 12 秒。参考音频长于 12 秒时，多出来的部分不会用上；\n   想换片段就改 start_time / end_time。\n3. **③ 说话内容** —— 写要说的话，一行一句也可以。\n   **语言支持中 / 英 / 日 / 西 / 阿五种**，在合成节点的 `language` 下拉里切换（默认 ZH=中文）。\n4. **④ 文件名前缀** —— 出片文件名前缀，留空也行；结果在输出目录里取 mp3。\n\n**情感控制**：默认 `emotion_mode = none`，只克隆音色（最稳）。\n要做情绪，把 emotion_mode 换成对应模式（音频参考 / 情感向量 / 情感文本），\n再配合 `emotion_alpha`（强度）使用；也可以直接给 `emotion_audio` 接口接一段带情绪的参考音频。\n\n**调参提示**\n\n* 语速听着不对：调 `duration_factor`（1 = 正常，>1 更慢更长，<1 更快更短）。\n* 换语种：把 `language` 从 ZH 改成 EN / JA / ES / AR；用中文参考音频念外语也可以（模型支持跨语种）。\n* 每次结果不一样是正常的，`seed` 固定后同一个 seed 出同一条声音。\n* 显存不够：Loader 的 `memory_mode` 从 keep_loaded 换成更省的模式，或 `precision` 换 fp16。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [1080, 500], "pos": [-40, -560], "id": 100, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["① 上传参考音频\n5~12 秒、干净人声、无 BGM 最稳"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [400, 130], "pos": [280, 240], "id": 101, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"outputs": [], "color": "#432", "widgets_values": ["② 自动只取前 12 秒\n想换片段改 start_time / end_time"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [400, 130], "pos": [280, 480], "id": 102, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"outputs": [], "color": "#432", "widgets_values": ["③ 要说的话写这里\n语言可切：中/英/日/西/阿（默认中文）"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [400, 160], "pos": [280, 720], "id": 103, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"outputs": [{"name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#3f384f", "widgets_values": ["", "V0"], "inputs": [{"name": "audio", "link": 69, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "link": 70, "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {"pinned": true, "collapsed": false}, "type": "SaveAudioMP3", "mode": 0, "bgcolor": "#6c6088", "size": [262.1181945800781, 140], "pos": [1374.7977294921875, 204.92237854003906], "id": 39, "properties": {"widget_ue_connectable": {"filename_prefix": true, "quality": true}, "Node name for S&R": "SaveAudioMP3"}, "order": 25}, {"outputs": [], "color": "#432", "widgets_values": ["④ 出片文件名前缀（可留空）"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [400, 110], "pos": [1650.0675048828125, -34.141639709472656], "id": 104, 