讲几遍 多讲几遍\n多讲几遍 让我听见\n\n[outro] [outro] [outro] [outro] [outro] [outro] [outro] [outro] [outro] [outro]"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 4, "type": "Text Multiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 3}, {"mode": 0, "outputs": [], "size": [359.80621337890625, 260.0506896972656], "pos": [2548.59521484375, 460.2786560058594], "widgets_values": ["xiaren"], "inputs": [{"name": "audio", "link": 1, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 2, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "VHS_latentpreview": false, "ds": {"offset": [-1315.7457578498233, 408.4648001637488], "scale": 0.6588450000000002}}, "groups": [], "links": [[1, 8, 0, 2, 0, "AUDIO"], [4, 9, 0, 8, 0, "SONGBLOOM_MODEL"], [13, 3, 0, 13, 1, "AUDIO"], [14, 9, 0, 13, 0, "SONGBLOOM_MODEL"], [15, 12, 0, 13, 9, "FLOAT"], [16, 13, 0, 8, 1, "LATENT"], [17, 3, 0, 14, 0, "AUDIO"], [18, 4, 0, 13, 2, "STRING"]], "id": "e1acd3a9-b81e-44ba-a749-6cea358deeef", "config": {}, "version": 0.4, "last_node_id": 14, "revision": 0}