好啊……我就不一样了，为了看凌晨三点那场球，白天上班差点睡着了，被老板骂得跟孙子似的。\n", 2, 10, 499361854508249, "randomize", "", "", "", "", "", false, false, 4096, true], "inputs": [{"name": "model", "link": 15, "label": "model", "type": "VOXCPM_MODEL", "localized_name": "model"}, {"shape": 7, "name": "audio_1", "link": 17, "label": "audio_1", "type": "AUDIO", "localized_name": "audio_1"}, {"shape": 7, "name": "audio_2", "link": 64, "label": "audio_2", "type": "AUDIO", "localized_name": "audio_2"}, {"shape": 7, "name": "audio_3", "link": 65, "label": "audio_3", "type": "AUDIO", "localized_name": "audio_3"}, {"shape": 7, "name": "audio_4", "label": "audio_4", "type": "AUDIO", "localized_name": "audio_4"}, {"shape": 7, "name": "audio_5", "label": "audio_5", "type": "AUDIO", "localized_name": "audio_5"}, {"widget": {"name": "script"}, "name": "script", "label": "script", "type": "STRING", "localized_name": "script"}, {"widget": {"name": "cfg_value"}, "name": "cfg_value", "label": "cfg_value", "type": "FLOAT", "localized_name": "cfg_value"}, {"widget": {"name": "inference_steps"}, "name": "inference_steps", "label": "inference_steps", "type": "INT", "localized_name": "inference_steps"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "control_1"}, "shape": 7, "name": "control_1", "label": "control_1", "type": "STRING", "localized_name": "control_1"}, {"widget": {"name": "control_2"}, "shape": 7, "name": "control_2", "label": "control_2", "type": "STRING", "localized_name": "control_2"}, {"widget": {"name": "control_3"}, "shape": 7, "name": "control_3", "label": "control_3", "type": "STRING", "localized_name": "control_3"}, {"widget": {"name": "control_4"}, "shape": 7, "name": "control_4", "label": "control_4", "type": "STRING", "localized_name": "control_4"}, {"widget": {"name": "control_5"}, "shape": 7, "name": "control_5", "label": "control_5", "type": "STRING", "localized_name": "control_5"}, {"widget": {"name": "normalize_text"},