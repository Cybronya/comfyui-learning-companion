一个方向\n我学会在平凡里 抬头去寻找希望\n在安静的日子里 安放最真诚的梦想\n\n(Bridge)\n如果未来真的很漫长 那就一步一步地走\n无论这条路多遥远 我决定了不再回头\n因为我已经懂得 生活里那种温柔\n藏在最简单的日子里 也有无尽的理由\n\n(Outro)\n晨光里的答案…\n是坚持和期盼…\n在流转的岁月里…"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [359.5855407714844, 499.3394470214844], "pos": [-321.5729064941406, 863.40576171875], "id": 85, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}, {"outputs": [], "color": "#2a363b", "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 117, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudio", "mode": 0, "bgcolor": "#3f5159", "size": [270, 112], "pos": [1391.406494140625, 819.5029907226562], "id": 106, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio", "ttNbgOverride": {"bgcolor": "#3f5159", "groupcolor": "#3f789e", "color": "#2a363b"}}, "order": 6}, {"outputs": [], "color": "#233", "widgets_values": ["audio/ComfyUI", "V0"], "inputs": [{"name": "audio", "link": 108, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudioMP3", "mode": 0, "bgcolor": "#355", "size": [270, 136], "pos": [960.54766845703