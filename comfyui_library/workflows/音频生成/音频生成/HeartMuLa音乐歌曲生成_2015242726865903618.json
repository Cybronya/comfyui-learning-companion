 "localized_name": "提示词"}], "flags": {}, "id": 4, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 1}, {"mode": 0, "outputs": [], "size": [353.1059875488281, 115.42704772949219], "pos": [711.4359741210938, 283.1715393066406], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 6, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 3, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 3}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1382.6542845622384, 671.1626606513374], "scale": 0.45000000000000107}}, "groups": [], "links": [[4, 4, 0, 6, 0, "STRING"], [5, 5, 0, 6, 1, "STRING"], [6, 6, 0, 3, 0, "AUDIO"]], "id": "6de4c1d9-8296-4d28-a2f2-ee842a6d5a08", "config": {}, "version": 0.4, "last_node_id": 6, "revision": 0}