 "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 56, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "#sdppp_simple_content": "canvas", "#sdppp_label": "", "ver": "0.18.2", "#sdppp_variant": "default", "#sdppp_simple_boundary": "canvas", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"image": true, "upload": true}, "#sdppp_simple_mask": "canvas", "Node name for S&R": "LoadImage"}, "order": 5}, {"outputs": [], "color": "#c09430", "widgets_values": ["## 声音设计格式书写\n\n> **一句话规则**：纯中文用 `，` 分隔 / 纯英文用 `, ` 分隔 / 不混用 / 精确匹配下表词汇\n\n---\n\n## 📖 支持参数一览\n\n### 🇨🇳 中文参数（分隔符：全角逗号 `，`）\n\n| 类别 | 可选值 |\n|:---:|:---|\n| **性别** | `女`， `男` |\n| **年龄** | `儿童`， `少年`， `青年`， `中年`， `老年` |\n| **音调** | `低音调`， `中音调`， `高音调`， `极低音调`， `极高音调` |\n| **方言** | `东北话`， `云南话`， `四川话`， `宁夏话`， `桂林话`， `河南话`， `济南话`， `甘肃话`， `贵州话`， `陕西话`， `青岛话`， `石家庄话` |\n| **其他** | `耳语` |\n\n### 🇬🇧 英文参数（分隔符：英文逗号+空格 `, `）\n\n| 类别 | 可选值 |\n|:---:|:---|\n| **Gender** | `female`， `male` |\n| **Age** | `child`， `teenager`， `young adult`， `middle-aged`， `elderly` |\n| **Pitch** | `low pitch`， `moderate pitch`， `high pitch`， `very low pitch`， `very high pitch` |\n| **Accent** | `american accent`， `australian accent`， `british accent`， `canadian accent`， `chinese accent`， `indian accent`， `japanese accent`， `korean accent`， `portuguese accent`， `russian accent` |\n| **Other** | `whisper` |\n\n---\n\n## ✅ 正确写法示例\n\n| 场景 | 正确输入 |\n|:---|:---|\n| 标准女声 | `女，青年，中音调` |\n| 标准男声 | `男，青年，中音调` |\n| 东北老大爷 | `男，老年，东北话` |\n| 四川小朋友 | `女，儿童，四川话` |\n| 英式英语男声 | `male, middle-aged, british accent` |\n| 美式英语女声 | `female, young adult, american accent` |\n| 轻声耳语 | `女，青年，低音调，耳语` |\n\n---\n\n## ❌ 常见错误对照\n\n| ❌ 错误写法 | 问题 | ✅ 正确写法 |\n|:---|:---|:---|\n| `女，青年，高音调，普通话` | 不支持“普通话” | 去掉或换方言 |\n| `女，青年，高音调，广东话` | 不支持“广东话” | 换成 `四川话` 等 |\n| `男，老人，高音调` | 不支持“老人” | `男，老年，高音调` |\n| `female, young adult, 高音调` | 中英文混用 | 全中文或全英文 |\n| `男,中年,低音调` | 用了英文逗号 | `男，中年，低音调` |\n\n---\n\n> 💡 **提示**：不指定方言/口音时，模型使用默认标准发音。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "-", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [482.9693298339844, 1107.767578125], "pos": [236.42124938964844, 3611.52490234375], "id": 53, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 6}, {"outputs": [], "color": "#c09430", "widgets_values": ["  ## 参数设置\n\n |参数|默认值|范围|说明|\n|-----------|---------|-------|-------------|\n|steps|32|4-64|扩散步骤。16=更快，32=平衡，64=最佳质量|\n|guidance_scale|2.0|0-10|无分类器指导。更高=文本对齐效果越好|\n|t_shift|0.1|0-1|时间步移。较小=强调早期步骤|\n|speed|1.0|0.5-2.0|说话速度。>1=更快，<1=较慢|\n|duration|0.0|0-60|固定输出持续时间（秒）。超越速度。0=自动|\n|position_temperature|5.0|0-20|掩码位置随机性。0=贪心算法（确定性），更高=更随机|\n|class_temperature|0.0|0-5|令牌采样随机性。0=贪心算法（确定性），更高=更随机|\n|layer_penalty_factor|5.0|0-20|较深码本层的惩罚|\n|denoise|True|-|在输入内容的前面添加去噪标记\t通常能提升输出质量|\n|preprocess_prompt|True|-|删除过长的沉默时段，添加标点符号|\n|postprocess_output|True|-|移除输出中的长时段沉默部分|\n|keep_model_loaded|True|-|将模型保留在内存中（在运行之间卸载到CPU）|\n\n\n\n  ## **语音克隆长音频单独参数**\n\n  | Parameter | Default | Range | Description |\n  |-----------|---------|-------|-------------|\n  | words_per_chunk | 100 | 0-500 | 每块文本的单词数（0 表示不进行分块） |\n\n\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "-", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [489.7701721191406, 561.789794921875], "pos": [221.97625732421875, 2892.323974609375], "id": 54, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 7}, {"mode": 0, "outputs": [{"name": "whisper_model", "links": [13], "label": "whisper_model", "type": "WHISPER_ASR", "localized_name": "whisper_model"}], "size": [369.0605773925781, 106], "pos": [2629.6328125, 3136.22705078125], "