{"last_link_id": 245, "nodes": [{"outputs": [], "color": "#232", "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 242, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudio", "mode": 0, "bgcolor": "#353", "size": [389.1679382324219, 126.0197525024414], "pos": [284.3955383300781, -1788.3193359375], "id": 147, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 3}, {"outputs": [{"name": "AUDIO", "links": [240], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "color": "#232", "widgets_values": ["ed385e5e345d591ce6feff520d3b69156aba14f28a6f753515aa1a92f1f968b5.mp3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadAudio", "mode": 0, "bgcolor": "#353", "size": [315, 136], "pos": [-461.6604309082031, -1788.26708984375], "id": 73, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 0}, {"outputs": [{"name": "string", "links": [241], "label": "string", "type": "STRING", "localized_name": "string"}], "color": "#232", "widgets_values": ["我的参赛作品《小孩与绿毛怪》，是一部聚焦儿童情绪与心理健康的治愈系短片。作品以抑郁儿童的内心世界为切入点，讲述了一个小女孩从封闭自我、被阴霾包裹，到接纳情绪、拥抱阳光的故事。核心主题是：情绪不是敌人，而是陪伴我们的温柔力量。\n创作灵感源于我对身边同学的观察：有些孩子遇到低落时习惯独自躲藏，不愿说出心事。于是我设计了 “绿毛小怪” 这一 IP 形象，它既是负面情绪的化身，也是默默守护孩子的陪伴者，通过 “先误会、后和解” 的悬念叙事，引导观众理解并接纳情绪。\n在技术实现上，我全程使用了 AIGC 工具：通过豆包完成故事脚本、旁白文案与分镜设计；用即梦/RUNNINGHUB生成绿毛小怪的三视图与关键镜头画面；最后在剪映中完成镜头剪辑、配乐合成与调色，实现了从创意到成片的全流程创作。\n创作中单眼绿毛小怪 IP和主角小女孩为手绘转三视图。通过抑郁儿童从阴霾走向阳光的 2 分钟短片分镜，使用绘本风格和本人旁白，并用从冷灰到暖黄的色调渐变完成悬念反转。\n这部作品是希望让更多孩子学会正视情绪、拥抱不完美的自己，也让社会关注儿童心理健康。愿每个躲在阴天里的小孩，都能找到自己的 “绿毛小怪”，在陪伴中走出阴霾，拥抱属于自己的万丈光芒\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "Text", "mode": 0, "bgcolor": "#353", "size": [329.1465759277344, 120.42607879638672], "pos": [-470.110595703125, -1580.9871826171875], "id": 85, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 1}, {"outputs": [{"name": "audio", "links": [242], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#232", "widgets_values": ["v1.5", 30, 0.8, 2, 3, 1000, 120, 3, true, false, true, true], "inputs": [{"name": "audio", "link": 240, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "text", "link": 241, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "dialogue_audio_s2", "label": "dialogue_audio_s2", "type": "AUDIO", "localized_name": "dialogue_audio_s2"}, {"widget": {"name": "version"}, "name": "version", "label": "version", "type": "COMBO", "localized_name": "version"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "top_p"}, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "num_beams"}, "name": "num_beams", "label": "num_beams", "type": "INT", "localized_name": "num_beams"}, {"wi