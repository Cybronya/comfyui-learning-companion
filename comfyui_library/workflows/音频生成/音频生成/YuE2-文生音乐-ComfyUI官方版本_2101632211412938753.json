widgets_values": ["female, bright, pop, happy, guitar and piano"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Text (Style)", "mode": 0, "bgcolor": "#353", "size": [480, 260], "pos": [2194.58740234375, -930.776123046875], "id": 54, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 7}, {"outputs": [{"name": "STRING", "links": [84, 85], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["【主歌1】\n窗外的雨 轻轻落在屋檐\n像我想你 时心跳的声线\n翻开日记 写满你的侧脸\n每一页 都是心动的瞬间\n\n【主歌2】\n咖啡微甜 是你惯用的语言\n每次遇见 假装不经意的寒暄\n我低着头 怕你看见我红的脸\n却偷偷 把你的名字念了千遍\n\n【副歌】\n你是我藏不住的喜欢\n像风吹过发梢那样自然\n每一次呼吸 都为你变得柔软\n你是我藏不住的喜欢\n像星星落在温柔的夜晚\n只要你在身边 世界就变得好慢\n\n【主歌3】\n翻开手机 反复看你的留言\n短短几句 却让我笑了整夜\n小心翼翼 把心事折成纸鸢\n希望它 能飞到你的梦里面\n\n【副歌重复】\n你是我藏不住的喜欢\n像风吹过发梢那样自然\n每一次呼吸 都为你变得柔软\n你是我藏不住的喜欢\n像星星落在温柔的夜晚\n只要你在身边 世界就变得好慢\n\n【桥段】\n也许我不够勇敢\n说不出那句答案\n但每个眼神 每次靠近\n都在替我说 你是我的答案\n\n【尾声 / 副歌变奏】\n你是我藏不住的喜欢\n像春天花开那样的必然\n往后的每一天 都想和你一起看完\n你是我藏不住的喜欢\n不用太多华丽的誓言\n只想牵着你的手 走到时间的尽头\n\n【结束句】\n你是我 藏不住的喜欢……"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Text (Lyrics)", "mode": 0, "bgcolor": "#353", "size": [480, 260], "pos": [2188, -560], "id": 55, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 8}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.52.7", "VHS_latentpreview": false, "ds": {"offset": [-2070.3915692254927, 610.878639189301], "scale": 1.5535220464768984}}, "groups": [], "links": [[64, 41, 1, 42, 0, "CLIP"], [65, 44, 0, 43, 0, "STRING"], [66, 47, 0, 44, 2, "BOOLEAN"], [67, 41, 1, 4