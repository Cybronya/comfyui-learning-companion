e": [400, 512], "pos": [10129.904296875, 2075.468017578125], "widgets_values": ["[\n  {\"speaker\": \"系统\", \"text\": \"冰冷的金属音毫无起伏，回荡在白色处置室。\"},\n  {\"speaker\": \"系统\", \"text\": \"公民凯恩，编号七三四‑F九一。经职能阶层纪律仲裁，确认泄露业务涉密材料，损害新穹集团利益。剥夺全部职能特权，身份重标定：役属阶层。莫比乌斯芯片强制重写，风险标记：黄灯。即刻下放第三十七聚居区。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"我……我还没来得及说清楚。\"},\n  {\"speaker\": \"纠察队员A\", \"text\": \"没时间了。跟我们走。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"维伦，他伪造的证据呢？\"},\n  {\"speaker\": \"纠察队员B\", \"text\": \"证据在系统里，你签过字。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"我……那天晚上，我只是想问问他账目对不对。\"},\n  {\"speaker\": \"纠察队员A\", \"text\": \"(laugh) 不是每个人都能被原谅的。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"我没做错事，我只做了该做的事。\"},\n  {\"speaker\": \"纠察队员B\", \"text\": \"你没选对站队的时间。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"(clears throat) 那……我的家人呢？\"},\n  {\"speaker\": \"纠察队员A\", \"text\": \"他们已转为待分配流民，登记在第三十七区的临时户籍簿上。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"我还能见他们一面吗？\"},\n  {\"speaker\": \"纠察队员B\", \"text\": \"明天凌晨三点前，他们会把你押送至聚居区入口。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"[叹气] 我的权限……我的豁免权……都成了笑话。\"},\n  {\"speaker\": \"系统\", \"text\": \"莫比乌斯芯片重写中……情绪抑制启动……愤怒、不甘、屈辱，正被逐步抹平。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"我……还能记得我的名字吗？\"},\n  {\"speaker\": \"纠察队员A\", \"text\": \"[笑] 只要芯片没坏，你就能活下来。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"(cough) 我的指尖在发抖……但心还在跳。\"},\n  {\"speaker\": \"纠察队员B\", \"text\": \"别浪费情绪了。第三十七区等你很久了。\"},\n  {\"speaker\": \"凯恩\", \"text\": \"我走之前，还能再看一眼外面的天吗？\"},\n  {\"speaker\": \"纠察队员A\", \"text\": \"你看吧，新穹集团的高塔，明天就该拆了。\"}\n]", 0.3, 3000, 0.9, 50, 1, 1.1, 0.9, 50, 1, 1, "fixed"], "inputs": [{"name": "breeze_model", "link": 16, "label": "breeze_model", "type": "BREEZE_TTS2_MODEL", "localized_name": "breeze_model"}, {"shape": 7, "name": "speaker_1", "link": 41, "label": "speaker_1", "type": "BREEZE_SPEAKER", "localized_name": "speaker_1"}, {"shape": 7, "name": "speaker_2", "link": 47, "label": "speaker_2", "type": "BREEZE_SPEAKER", "localized_name": "speaker_2"}, {"shape": 7, "name": "speaker_3", "label"