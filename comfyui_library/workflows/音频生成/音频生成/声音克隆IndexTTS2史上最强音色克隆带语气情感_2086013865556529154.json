outputs": [{"name": "STRING", "links": [47], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#432", "widgets_values": ["害，我是元小玺\n不少家庭置业，把教育作为首要考量，却常常只关注直线距离，忽略现实的通勤场景。\n现实生活当中，每天早起赶路、长途接送，消耗的不只是时间，更是孩子的休息与家庭的精力。选房，不只是看周边有哪些学校，更要评估往返路程给日常生活带来的实际影响。\n元玺书院周边分布职工子弟小学、五百村小学、音体美中学、高邑县第三中学。\n多所已投用的学校形成生活圈内的教育资源，不用跨越大半个县城往返就学，孩子能够拥有更充足的休息时间，也减少家长每日接送的奔波。\n当然教育只是置业的一部分。项目周边成熟商业、医疗资源同样齐全，兼顾孩子就学与全家人的日常生活。一套适合家庭的房子，应当平衡教育、居住、生活多重需求，而不是单一追求某一项标签。\n想入手高邑品质好房，记得关注我"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Text 提示词", "mode": 0, "bgcolor": "#653", "size": [372.88299560546875, 667.894287109375], "pos": [1406.4422607421875, -278.9406433105469], "id": 46, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 5}, {"mode": 0, "outputs": [{"name": "audio", "links": [44, 49], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [322.3429870605469, 672.5040283203125], "pos": [1847.1724853515625, -290.9493408203125], "widgets_values": [30, 0.8, 0.8, 3, 1500, 120, false, false, true, 1, "", false, "", false, 1, "", false, "", false], "inputs": [{"name": "audio", "link": 46, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "text", "link": 47, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "dialogue_audio_s2", "label": "dialogue_audio_s2", "type": "AUDIO", "localized_name": "dialogue_audio_s2"}, {"shape": 7, "name": "emo_audio_prompt", "link": 48, "label": "emo_audio_prompt", "type": "AUDIO", "localized_name": "emo_audio_prompt"}, {"shape": 7, "name": "emo_audio_prompt_s2", "label": "emo_audio_prompt_s2", "type": "AUDIO", "localized_name": "emo_audio_prompt_s2"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "top_p"}, "name": 