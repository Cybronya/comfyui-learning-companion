90cc6d53dcd69351d15203277fb4.mp3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 17, "type": "LoadAudio", "title": "说话人2", "properties": {"cnr_id": "comfy-core", "ver": "0.13.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 3}, {"mode": 0, "outputs": [{"name": "模型", "links": [46], "label": "模型", "type": "QWEN3_TTS_MODEL", "localized_name": "模型"}], "size": [270, 106], "pos": [-1017.3012084960938, 1385.7701416015625], "widgets_values": ["Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign", "cuda", "fp16"], "inputs": [{"widget": {"name": "模型名称"}, "name": "模型名称", "label": "模型名称", "type": "COMBO", "localized_name": "模型名称"}, {"widget": {"name": "运行设备"}, "name": "运行设备", "label": "运行设备", "type": "COMBO", "localized_name": "运行设备"}, {"widget": {"name": "精度"}, "name": "精度", "label": "精度", "type": "COMBO", "localized_name": "精度"}], "flags": {}, "id": 28, "type": "Qwen3TTSModelLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Qwen3TTSModelLoader"}, "order": 4}, {"mode": 0, "outputs": [{"name": "音频", "links": [48, 50], "label": "音频", "type": "AUDIO", "localized_name": "音频"}], "size": [400, 430], "pos": [-1009.3270874023438, 1638.425537109375], "widgets_values": ["惠普推出了游戏笔记本订阅服务 OMEN Gaming Subscription，允许用户以按月付费的方式租用笔记本电脑，用户不拥有所有权，长期租用的费用会超过笔记本的零售价。", "角色姓名：苏星禾\n\n性别：女\n\n音色信息：音量柔和，音域偏细且有质感，语速平缓舒展，语气温柔却有力量，咬字细腻，自带亲和力，擅长共情式表达，既能沉稳解读科技趋势，也能温柔分享科技背后的人文故事，声音有记忆点。\n\n身份背景：25岁，传媒专业本科毕业，曾在科技媒体担任编辑记者，深耕科技领域两年，擅长挖掘科技产品背后的研发故事、行业人物与社会影响，而非单纯讲解技术参数。熟悉播客策划与内容输出，擅长把控节目节奏，兼顾专业性与趣味性，能精准捕捉听众需求，负责播客的话题引导、嘉宾访谈与内容串联，与江屿形成专业互补。\n\n外貌特征：身形娇小匀称，身高165cm左右，五官清秀柔和，长发常束成低马尾或丸子头，眼神温柔澄澈，自带亲和力。穿搭简约精致，多以浅色系针织衫、衬衫裙、休闲西装为主，搭配小巧的科技类配饰（如智能手表、简约耳机），兼顾优雅与科技感，气质干净舒服。\n\n性格特质：沉稳细腻，心思缜密，擅长梳理逻辑，能快速整合复杂的科技信息并清晰输出；温柔共情，善于倾听，无论是嘉宾分享还是听众反馈，都能耐心回应，擅长挖掘科技背后的人文温度；严谨认真，对播客内容严格把控，注重细节，同时灵活变通，能根据现场氛围调整话题方向；乐观温和，不急躁，与江屿的活泼形成互补，让播客节奏张弛有度。\n\n人生信条：“解读科技的同时，也读懂每一份创新背后的热爱与坚守。”", "中文", false, 2048, 101024550041963, "randomize", 1, false, 0.8, 50, 0.8, 1.1, false], "inputs": [{"name": "模型", "link": 46, "label": "模型", "type": "QWEN3_TTS_MODEL", "localized_name": "模型"}, {"widget": {"name": "文本"}, "name": "文本", "label": "文本", "type": "STRING", "localized_name": "文本"}, {"widget": {"name": "提示词"}, "name": "提示词", "label": "提示词", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "语言"}, "name": "语言", "label": "语言", "type": "COMBO", "localized_name": "语言"}, {"widget": {"name": "自动卸载模型"}, "name": "自动卸载模型", "label": "自动卸载模型", "type": "BOOLEAN", "localized_name": "自动卸载模型"}, {"widget": {"name": "最大生成Token数"}, "name": "最大生成Token数", "label": "最大生成Token数", "type": "INT", "localized_name": "最大生成Token数"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "语速"}, "name": "语速", "label": "语速", "type": "FLOAT", "localized_name": "语速"}, {"widget": {"name": "批量模式"}, "shape": 7, "name": "批量模式", "label": "批量模式", "type": "BOOLEAN", "localized_name": "批量模式"}, {"widget": {"name": "top_p"}, "shape": 7, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "top_k"}, "shape": 7, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "temperature"}, "shape": 7, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "repetition_penalty"}, "shape": 7, "name": "repetition_penalty", "label": "repetition_penalty", "type": "FLOAT", "localized_name": "repetition_penalty"}, {"widget": {"name": "启用高级采样配置"}, "sha