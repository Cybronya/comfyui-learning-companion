e": "clip_id1"}, {"name": "clip_id2", "label": "clip_id2", "type": "STRING", "localized_name": "clip_id2"}, {"name": "tags", "label": "tags", "type": "STRING", "localized_name": "tags"}, {"name": "title", "label": "title", "type": "STRING", "localized_name": "title"}], "size": [240, 432], "pos": [540, 0], "widgets_values": ["命中注定", "写一首伤感的粤语情歌", "v5.5", 1319331660, "randomize", true, ""], "inputs": [{"widget": {"name": "title"}, "name": "title", "link": 18, "label": "title", "type": "STRING", "localized_name": "title"}, {"widget": {"name": "description_prompt"}, "name": "description_prompt", "link": 19, "label": "description_prompt", "type": "STRING", "localized_name": "description_prompt"}, {"widget": {"name": "version"}, "name": "version", "label": "version", "type": "COMBO", "localized_name": "version"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "make_instrumental"}, "name": "make_instrumental", "label": "make_instrumental", "type": "BOOLEAN", "localized_name": "make_instrumental"}, {"widget": {"name": "apikey"}, "shape": 7, "name": "apikey", "link": 21, "label": "apikey", "type": "STRING", "localized_name": "apikey"}], "flags": {"collapsed": false}, "id": 11, "type": "Comfly_suno_description", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Comfly_suno_description"}, "order": 10}, {"mode": 0, "outputs": [], "size": [240, 140], "pos": [1080, 0], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 15, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {"collapsed": false}, "id": 14, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 11}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#11 Comfly_suno_description\n作用：将歌曲标题、风格描述和 Suno 版本参数提交给 Suno 接口，一次生成两首音乐并返回音频与任务信息。\n参数：\n- title：当前值=命中注定；作用：设置歌曲标题；会写入 Suno 任务元数据，也方便后续区分两首生成结果；范围：字符串，建议 1 ~ 80 字符；默认：空标题。\n- description_prompt：当前值=写一首伤感的粤语情歌；作用：描述音乐风格、情绪、语言和编曲方向；写得越具体，生成结果越接近目标；范围：字符串，建议 5 ~ 500 字符；默认：空字符串。\n- version：当前值=v5.5；作用：选择调用的 Suno 模型版本；不同版本会影响音色细节、稳定性和能力边界；范围：下拉枚举（如 `v5.5` 等节点提供项）；默认：节点当前预设版本。\n- seed：当前值=367028716；作用：控制生成随机性；固定后更容易复现相近结果，改掉则更容易换出新旋律；范围：整数，常见 0 ~ 2^63-1；默认：0。\n- control_after_generate：当前值=randomize；作用：设置每次生成后种子如何变化；固定可复测同一路结果，随机化更适合连续探索多个版本；范围：固定 / 随机 / 递增 等节点提供项；默认：fixed。\n- make_instrumental：当前值=True；作用：决定是否生成纯音乐；打开后更倾向无演唱版本，关闭则允许生成人声歌曲；范围：布尔值：true/false；默认：false。\n- apikey：当前值=；作用：接收上游 `Comfly_api_set` 输出的接口凭证；没有它通常无法提交 Suno 生成任务；范围：STRING 连线输入或手填 API Key 字符串；默认：必须连接上游节点或手动填写。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 694], "pos": [540, 480], "id": 25, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#14 SaveAudio\n作用：将上游音频数据写成音频文件保存到磁盘，作为流程最终交付结果。\n参数：\n- filename_prefix：当前值=audio/ComfyUI；作用：输出文件名前缀；范围：字符串（文件系统合法字符）；默认：ComfyUI。\n- audioUI：当前值=null；作用：音频上传控件的附加输入位（通常可留空）；范围：上传控件数据或空值；默认：空。\n- audio：当前值=来自 节点#11 Comfly_suno_description 的 `audio1` 输出；作用：接收上游音频数据；范围：AUDIO 类型数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 298], "pos": [1080, 188], "id": 26, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#15 SaveAudio\n作用：将上游音频数据写成音频文件保存到磁盘，作为流程最终交付结果。\n参数：\n- filename_prefix：当前值=audio/ComfyUI；作用：输出文件名前缀；范围：字符串（文件系统合法字符）；默认：ComfyUI。\n- audioUI：当前值=null；作用：音频上传控件的附加输入位（通常可留空）；范围：上传控件数据或空值；默认：空。\n- audio：当前值=来自 节点#11 Comfly_suno_description 的 `audio2` 输出；作用：接收上游音频数据；范围：AUDIO 类型数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 298], "pos": [1080, 770], "id": 27, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#17 CR Prompt Text\n作用：输出一段固定文本提示词，供下游生成或处理节点直接读取使用。\n参数：\n- prompt：当前值=写一首伤感的情歌；作用：主编辑提示词，描述目标结果；范围：字符串，建议 1 ~ 2048 字符；默认：空字符串。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 154], "pos": [0, 746], "id": 28, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#18 CR Prompt Text\n作用：输出一段固定文本提示词，供下游生成或处理节点直接读取使用。\n参数：\n- prompt：当前值=命中注定；作用：主编辑提示词，描述目标结果；范围：字符串，建议 1 ~ 2048 字符；默认：空字符串。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 154], "pos": [0, 248], "id": 29, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"mode": 0, "outputs": [{"name": "prompt", "links": [18], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [240, 200], "pos": [0, 0], "widgets_values": ["酒醉的蝴蝶"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {"collapsed": false}, "id": 18, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 6}, {"mode": 0, "outputs": [{"name": "apikey", "links": [21], "label": "apikey", "type": "STRING", "localized_name": "apikey"}], "size": [240, 140], "pos": [0, 996], "widgets_values": ["zhenzhen", "sk-HXxqrQthN0GBHA6RyskQtaX8vRJzWvy8we2tNItbQQNTKtIi", ""], "inputs": [{"widget": {"name": "api_base"}, "name": "api_base", "label": "api_base", "type": "COMBO", "localized_name": "api_base"}, {"widget": {"name": "apikey"}, "name": "apikey", "label": "apikey", "type": "STRING", "localized_name": "apikey"}, {"widget": {"name": "custom