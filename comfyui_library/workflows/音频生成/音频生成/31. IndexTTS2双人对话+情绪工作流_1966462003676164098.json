24.01675415039062, 9.310413360595703], "widgets_values": ["fbcdc63ab835a02d9b2bd96d3974420e226dafeb03230d12aab4481099d18fb2.MP3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 9, "type": "LoadAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"upload": true, "audio": true, "audioUI": true}, "Node name for S&R": "LoadAudio"}, "order": 1}, {"mode": 0, "outputs": [{"name": "STRING", "links": [16, 17, 18], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 200], "pos": [-201.2430877685547, 202.34014892578125], "widgets_values": ["[S1] 2024年02月14日 Valentine’s Day，你居然忘了？！\n[S2] Babe 对不起！我特意订了 dinner at 7:30 PM，还买了你最爱的 rose，99朵，每朵¥13.14，total ¥1300.86！\n[S1] 哼…那520.13元的红包呢？去年你说“我爱你一生”都发了，今年呢？\n[S2] Already sent！Alipay 提示音你没听到？\n[S1] …那周末去三亚的机票？你上个月说“March 15日出发，住海景房¥2888.88/晚”？\n[S2] Confirmed！Flight MU5378，3月15日08:45起飞。房费我pay，你负责…smile like sunshine！\n[S1] 这还差不多～但下次纪念日别用“Babe”糊弄我！\n[S2] Yes, my Queen！下次发红包¥1314.52。\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "id": 18, "type": "PrimitiveStringMultiline", "properties": {"cnr_id": "comfy-core", "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {"value": true}, "version": "7.0.1"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 2}, {"mode": 0, "outputs": [], "size": [270, 112], "pos": [770.0313110351562, -165.73916625976562], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 14, "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 15, "type": "SaveAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"filename_prefix": true, "audioUI": true}, "Node name for S&R": "SaveAudio"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["V2重要参数说明（全是可选的）：\n\ndeepspeed: 是否开启 deepspeed 加速（需要先安装deepspeed）。\n\nemo_audio_prompt: 第一个说话人，情绪音频参考。\n\nemo_alpha: 第一个说话人，情绪强度。\n\nemo_vector: 第一个说话人，情绪控制向量，英文格式输入类似这样的列表 [0, 0, 0, 0, 0, 0, 0.45, 0]（每一个强度范围0-1，表示惊喜强度 0.45），数字分别对应 : [Happy, Angery, Sad, Fear, Hate, Low, Surprise, Neutral]， 几乎无限组合。\n\nuse_emo_text: 第一个说话人，是否开启提示词控制情绪。如果使用提示词控制，情绪参考音频失效。\n\nemo_text: 第一个说话人，情绪控制提示词。随便写，例如 哭哭。。。苦苦。。。\n\nuse_random: 第一个说话人，是否开启随机性。\n\nemo_audio_prompt_s2: 第二个说话人，同上。\n\nemo_alpha_s2: 第二个说话人，同上。\n\nemo_vector_s2: 第二个说话人，同上。\n\nuse_emo_text_s2: 第二个说话人，同上。\n\nemo_text_s2: 第二个说话人，同上。\n\nuse_random_s2: 第二个说话人，同上。\n\n如果不提供任何情绪控制，自动使用克隆音频作为情绪参考。\n\n重要参数说明(其他参数不是很重要的就不一一介绍了):\n\nmax_mel_tokens: 控制生成的语音长度, 长文本需要增加这个参数.\nmax_text_tokens_per_sentence: 分句的最大token数，越小，推理速度越快，占用内存更多，可能影响质量\nsentences_bucket_max_size: 分句分桶的最大容量，越大，推理速度越快，占用内存更多，可能影响质量\nfast_inference: 开启快速推理\ncustom_cuda_kernel: 开启自定义 CUDA 内核, 第一次运行将自动构建 CUDA 内核扩展\ndialogue_audio_s2: 双人会话时的第二个音频, 如果输入这个音频, 自动启动会话模式. 会话模式下, 输入文本必须如下([S1] 表示第一个说话者, [S2] 表示第二个说话者):\n\n[S1] 轻喘像风掠过耳畔，\n[S2] 你靠近时，连呼吸都慢了半拍。\n[S1] 指尖在我锁骨上游移，\n[S2] 仿佛试探一扇未曾开启的门。\n\n'愤怒:0.00', '高兴:0.00', '恐惧:0.00', '反感:0.00', '悲伤:0.95', '低落:0.03', '惊讶:0.00', '自然:0.02'"], "inputs": [], "flags": {}, "type": "Note", "title": "节点参数说明", "mode": 0, "bgcolor": "#653", "size": [625.3336181640625, 696.772216796875], "pos": [-851.0335083007812, -257.07684326171875], "id": 17, "properties": {"ue_properties": {"widget_ue_connectable": {}, "version": 