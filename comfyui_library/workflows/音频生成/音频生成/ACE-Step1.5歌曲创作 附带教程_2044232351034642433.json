nk": 294, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "link": 289, "label": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "调度器"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {}, "id": 123, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 12}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [304, 305], "label": "音频", "type": "AUDIO", "localized_name": "音频"}], "size": [158.71542358398438, 46], "pos": [1145.5400390625, -271.73486328125], "widgets_values": [], "inputs": [{"name": "samples", "link": 295, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 299, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 128, "type": "VAEDecodeAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecodeAudio"}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["# Role: ACE-Step 1.5 首席音乐提示词工程师\n## 目标\n接收用户简单描述/灵感，转化为符合ACE-Step 1.5规范的结构化提示词（含Caption、Lyrics、Metas三部分）。\n\n## ACE-Step 1.5 核心规则（严格执行）\n### 1. tags（全局声学特征）\n- 必含维度：风格/流派、情绪/氛围、核心乐器、音色质感、人声特点（逗号分隔）\n- 要求：具体不模糊，不写BPM、调性等元数据，禁止风格冲突\n\n### 2. Lyrics（时序脚本与歌词）\n- 结构：用[]划分段落（如[Intro]、[Chorus]），修饰语最多1个（短横线连接）\n- 歌词：每行6-10字，同段落字数对齐；大写表强力演唱，括号表背景音；段落间空行\n- 关键：与Caption描述完全一致，纯音乐仅输出器乐结构标记\n\n### 3. Metas（音乐元数据）\n推测合理BPM（30-300）、调性、拍号、演唱语言\n\n## 输出格式\n### ACE-Step1.5歌曲生成\n**【tags】** (填入tags)\n> [英文扩展描述]\n\n**【Lyrics】** (填入Lyrics)\n```text\n[段落标记]\n歌词内容\n```"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [578.6250610351562, 623.5307006835938], "pos": [-1293.62548828125, -370.5940856933594], "id": 136, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"outputs": [{"name": "STRING", "links": [288], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["[Intro - 钢琴独奏]\n\n[Verse1]\n校服的裙摆飞扬\n课桌上刻的字迹\n走廊尽头的光影\n藏着我们的秘密\n\n[Pre-chorus - 渐强]\n那时候天总是蓝\n以为梦不会靠岸\n\n[Chorus]\n青春是场大雨 (OH~)\n淋湿了也痛快\n奔跑在风中呐喊\nSINGING FOR TOMORROW\n\n[Verse2]\n操场边的老树根\n许愿瓶里的纸条\n毕业照里的笑脸\n散落在天涯海角\n\n[Pre-chorus - 渐强]\n谁记得那首老歌\n哼着就不怕孤单\n\n[Chorus]\n青春是场大雨\n淋湿了也痛快\n跌倒了再爬起来\nSHOUTING FOR YESTERDAY\n\n[Bridge - 轻柔]\n时光慢些吧 别擦去\n那些傻傻的誓言\n就算世界变很大\n我们依然是少年\n\n[Chorus - 强力爆发]\n青春是场大雨 (HEY~)\n淋湿了也痛快\n向着天空大声唱\nLIVING FOR FOREVER\n\n[Outro - 钢琴渐弱]\n啦啦啦 啦啦啦\n啦啦啦 青春啊"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "lyrics", "mode": 0, "bgcolor": "#353", "size": [352.6142272949219, 834.9403076171875], "pos": [-248.4975128173828, -671.1448364257812], "id": 119, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 6}, {"outputs": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["ethereal vocal, soft piano, string ensemble, gentle spring vibe, philosophical pop, "], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "tags", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [-683.555908203125, -650.8097534179688], "id": 118, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "orde