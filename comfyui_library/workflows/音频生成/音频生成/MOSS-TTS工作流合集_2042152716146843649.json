l": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "id": 16, "type": "WhisperSTT", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "WhisperSTT"}, "order": 10}, {"mode": 0, "outputs": [], "size": [270, 136], "pos": [3022.4443359375, 129.1111297607422], "widgets_values": ["audio/ComfyUI", "V0"], "inputs": [{"name": "audio", "link": 9, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 11, "type": "SaveAudioMP3", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudioMP3"}, "order": 21}, {"mode": 0, "outputs": [{"name": "string", "links": [11], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [433.8684387207031, 474.71063232421875], "pos": [1912.4444580078125, 619.1110229492188], "widgets_values": ["[S1]：各位观众朋友们晚上好！欢迎收看这场万众期待的“魔都高校德比”，由复旦大学对阵上海交大！我是詹俊，今天在我身旁为大家带来评述的依然是张路指导！\n[S2]：嘿嘿，大家好！今天这现场气氛可不一般啊，看台上红蓝两色泾渭分明，加油声已经盖过我的耳机声了！\n[S1]：没错！比赛开始第15分钟，场上僵局就被打破！复旦大学中场连续的短传配合，突然一脚过顶长传撕开了交大的防线！前锋心领神会反越位成功，面对出击的门将非常冷静地晃过，推射空门得手！球进了！一比零！复旦大学率先取得领先！\n[S2]：嘿嘿，这球交大两个中卫的协同防守出了问题啊，一个上抢冒失了，另一个没能及时补位保护，给复旦的前锋留出了太大的纵深空间，抓住了就是单刀啊。\n[S1]：落后的交大并没有慌乱，他们加强了中场的逼抢力度！哎呀！交大这边断球后立刻发动反击，一脚势大力沉的远射！皮球蹭着立柱偏出了底线！复旦门将惊出了一身冷汗啊！\n[S2]：交大这是把阵型前提，要搏一下了。这么打很有威胁，但身后的空当也更大了，就看复旦的反击能不能抓住了，比赛好看了！\n[S1]：下半场易边再战！第六十五分钟，交大的不懈努力终于收到了回报！交大边路球员强行突破后传中，禁区内一片混战！复旦后卫解围不远，交大十一号球员在乱军之中抢先一脚捅射！球进了！一比一平！上海交大顽强地扳平了比分！\n[S2]：嘿嘿，这就是意志力的体现！复旦的后卫在禁区里处理球稍微犹豫了那么一下，就被对方抓住了机会。交大这股不服输的劲儿，值得称赞！\n[S1]：比赛进入白热化！时间来到第八十八分钟，就在我们以为比赛要以平局告终的时候——复旦获得了一个前场右侧的角球！战术角球开出，回传到大禁区线上！复旦的中场核心迎球怒射！世界波！皮球像炮弹一样直挂球门左上死角！绝杀！这绝对是一记绝杀！二比一！\n[S2]：嘿嘿，这球真是神来之笔啊！首先这个战术角球就出其不意，交大防守队员的注意力都在禁区里。这脚凌空打门的发力、角度都堪称完美，门将是毫无办法！关键时刻，还得看核心球员啊！\n[S1]：全场比赛结束！最终，复旦大学凭借着这记石破天惊的世界波，2比1险胜上海交大！这场德比真是跌宕起伏，直到最后一刻才分出胜负！\n[S2]：嘿嘿，一场高质量的比赛。交大虽败犹荣，展现了顽强的斗志。复旦这边则是把握机会的能力更胜一筹，为我们奉献了一场精彩的对决。\n[S1]：没错！再次恭喜复旦大学赢下这场德比之战！也感谢两队球员的精彩表现！感谢各位观众的收看，我们下次再见！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 13, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 4}, {"outputs": [], "color": "#432", "widgets_values": ["| 生成节点              | 适配的模型变体              | 功能                                           |\n|---------------------|---------------------------|----------------------------------------------|\n| MossTTSGenerate     | 所有模型均可（通用）        | 文本转语音，支持参考音频克隆                     |\n| MossTTSVoiceDesign  | MOSS-VoiceGenerator       | 通过文字描述（instruction）控制音色风格           |\n| MossTTSSoundEffect  | MOSS-SoundEffect          | 根据文字描述生成音效（环境音、特效音）            |\n| MossTTSDialogue     | MOSS-TTSD v1.0            | 多说话人对话生成，支持 [S1][S2] 标签 + 音频克隆   |"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [490.10345458984375, 174.80355834960938], "pos": [1121.603515625, -861.5684204101562], "id": 21, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"mode": 0, "outputs": [{"name": "audio", "links": [7], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [400, 382], "pos": [140, -520], "widgets_values": ["auto", "天哪天哪天哪！我中了！我真的中了！一等奖！妈你快来看！", "年轻女性，狂喜尖叫，激动到语无伦次", 1067288335978672, "randomize", 1.5, 0.6, 50, 1.1, 4096, 0, 0], "inputs": [{"name": "moss_pipe", "link": 4, "label": "moss_pipe", "type": "MOSS_TTS_PIPE", "localized_name": "moss_pipe"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text