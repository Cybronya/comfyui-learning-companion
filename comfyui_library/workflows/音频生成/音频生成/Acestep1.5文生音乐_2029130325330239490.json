ion": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "DualCLIPLoader"}, "order": 6}, {"mode": 0, "outputs": [], "size": [700, 136], "pos": [1280, -670], "widgets_values": ["audio/ComfyUI", "V0"], "inputs": [{"name": "audio", "link": 263, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 107, "type": "SaveAudioMP3", "properties": {"cnr_id": "comfy-core", "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"filename_prefix": true, "quality": true}, "Node name for S&R": "SaveAudioMP3"}, "order": 16}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [270, 271], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "size": [594.1424560546875, 747.291748046875], "pos": [270, -790], "widgets_values": ["【Style Prompt】\nChinese rap with aggressive social critique\nTrap and electronic rock fusion\nBPM 140\nDark, gritty, urban atmosphere\nStrong contrast between tense rap verses and explosive hook\nStage-ready, high energy, confrontational\n\n【Voice / Timbre Prompt】\nMale vocal\nRap sections: sharp articulation, fast and punchy flow\nHook sections: powerful semi-sung delivery, strong chest voice\nModern trap vocal processing with slight distortion\nEmotion arc from suppressed anger to full explosive release", "[Intro]\n高楼像铁笼\n灯光像审判\n我在夜里被时间追赶\n\n[Verse - Rap]\n电梯里挤满相同面孔\n眼神空洞像复制的梦\n工位像一排排牢笼\n打卡声替代了心跳的钟\n\n他们说努力会改变命运\n可命运早被写进剧本\n赢家站在舞台顶端\n输的人连名字都不被承认\n\n会议室里堆满漂亮谎言\nKPI像刀挂在头顶盘旋\n笑容变成一种表演\n连疲惫都要装作自愿\n\n[Pre-Hook]\n我把怒火压进胸口\n把疑问锁在尽头\n他们说沉默才成熟\n可沉默只是慢慢腐朽\n\n[Hook]\n这世界像台旧机器\n人被拧成螺丝钉\n这世界像台旧机器\n梦想被碾成灰烬\n\n这世界像台旧机器\n谁还能保持清醒\n这世界像台旧机器\n我偏要逆着转动它的引擎\n\n[Verse - Rap]\n手机里全是成功故事\n像广告一样无限复制\n他们说失败只是懒惰\n却没人提规则多讽刺\n\n努力被包装成神话\n苦难被称作代价\n有人在塔尖俯瞰天下\n有人连阳光都要赊价\n\n规则像迷宫没有出口\n每一步都被计算透\n你越拼命往上游\n越发现河流早就被分走\n\n[Pre-Hook]\n呼吸变得急促\n世界越来越粗\n如果我继续沉默\n那我早就已经输了\n\n[Hook]\n这世界像台旧机器\n人被拧成螺丝钉\n这世界像台旧机器\n梦想被碾成灰烬\n\n这世界像台旧机器\n谁还能保持清醒\n这世界像台旧机器\n我偏要逆着转动它的引擎\n\n[Outro]\n也许我只是微小火星\n在巨大夜色里燃尽\n但只要还有一点光\n我就不会变成他们的影子", 502173662899350, "randomize", 120, 190, "4", "zh", "F# minor", true, 2, 0.85, 0.9, 0, 0], "inputs": [{"name": "clip", "link": 279, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "tags"}, "name": "tags", "label": "tags", "type": "STRING", "localized_name": "tags"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "seed"}, "name": "seed", "link": 268, "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "bpm"}, "name": "bpm", "label": "bpm", "type": "INT", "localized_name": "bpm"}, {"widget": {"name": "duration"}, "name": "duration", "link": 269, "label": "duration", "type": "FLOAT", "localized_name": "duration"}, {"widget": {"name": "timesignature"}, "name": "timesignature", "label": "timesignature", "type": "COMBO", "localized_name": "timesignature"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "keyscale"}, "name": "keyscale", "label": "keyscale", "type": "COMBO", "localized_name": "keyscale"}, {"widget": {"name": "generate_audio_codes"}, "name": "generate_audio_codes", "label": "generate_audio_codes", "type": "BOOLEAN", "localized_name": "generate_audio_codes"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLO