ame": "max_mel_tokens"}, "name": "max_mel_tokens", "label": "max_mel_tokens", "type": "INT", "localized_name": "max_mel_tokens"}, {"widget": {"name": "max_text_tokens_per_sentence"}, "name": "max_text_tokens_per_sentence", "label": "max_text_tokens_per_sentence", "type": "INT", "localized_name": "max_text_tokens_per_sentence"}, {"widget": {"name": "sentences_bucket_max_size"}, "name": "sentences_bucket_max_size", "label": "sentences_bucket_max_size", "type": "INT", "localized_name": "sentences_bucket_max_size"}, {"widget": {"name": "fast_inference"}, "name": "fast_inference", "label": "fast_inference", "type": "BOOLEAN", "localized_name": "fast_inference"}, {"widget": {"name": "custom_cuda_kernel"}, "name": "custom_cuda_kernel", "label": "custom_cuda_kernel", "type": "BOOLEAN", "localized_name": "custom_cuda_kernel"}, {"widget": {"name": "unload_model"}, "name": "unload_model", "label": "unload_model", "type": "BOOLEAN", "localized_name": "unload_model"}], "flags": {}, "id": 56, "type": "IndexTTSRun", "properties": {"cnr_id": "indextts-mw", "ver": "6f2de5cbacafbbf46793ddbf630940d231894d83", "widget_ue_connectable": {"top_p": true, "num_beams": true, "max_text_tokens_per_sentence": true, "custom_cuda_kernel": true, "fast_inference": true, "top_k": true, "unload_model": true, "temperature": true, "max_mel_tokens": true, "sentences_bucket_max_size": true, "version": true}, "aux_id": "billwuhao/ComfyUI_IndexTTS", "Node name for S&R": "IndexTTSRun"}, "order": 12}, {"mode": 0, "outputs": [], "size": [398.17724609375, 147.4033203125], "pos": [1067.061767578125, -17.971256256103516], "widgets_values": ["dapaoaudio", "320k"], "inputs": [{"name": "audio", "link": 104, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 57, "type": "SaveAudioMP3", "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {"filename_prefix": true, "audioUI": true, "quality": true}, "Node name for S&R": "SaveAudioMP3"}, "order": 14}, {"outputs": [{"name": "AUDIO", "links": [116], "label": "音频", "type": "AUDIO", "localized_name": "音频"}], "color": "#232", "widgets_values": ["a4522e37426da07ebd7681e2660e77e4f747bfb5f95bae061011835cecb6933e.mp3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadAudio", "mode": 4, "bgcolor": "#353", "size": [425, 136], "pos": [1572.2691650390625, 172.9515838623047], "id": 69, "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {"upload": true, "audio": true, "audioUI": true}, "Node name for S&R": "LoadAudio"}, "order": 1}, {"outputs": [], "color": "#432", "widgets_values": ["IndexTTS Run 参数说明\n\nversion】\n模型版本，图里选的是 v1.5，不同版本可能在音质、速度、拟声表现上有差异\n\n【top_k】\n控制采样时从概率分布里取前多少个候选词，数字越大，声音表达可能更丰富；越小则更稳定\n建议：20-50 之间调整\n\n【top_p】\n又叫 nucleus sampling，决定采样的累计概率阈值，0.8 表示从累计概率前 80% 的候选中采样\n越低 → 稳定；越高 → 多样\n\n【temperature】\n控制采样“随机性”\n1.0 = 默认随机度；>1 声音更有表现力但可能跑偏；<1 更稳定更单调\n\n【num_beams】\nBeam Search 的束宽，越大越精准，但生成速度会慢\n常用值：3-5\n\n【max_mel_tokens】\nMel 频谱的最大 token 数，影响生成语音长度，数值越大 → 支持更长的语音\n1024 算比较高，适合长文本\n\n【max_text_tokens_per_sentence】\n单句最大 token 数。\n限制一条语音中输入文本的长度，避免超长导致崩溃或断句错误\n\n【sentences_bucket_max_size】\n控制一次处理多少句子，1 表示逐句生成，能避免卡顿\n\n【fast_inference】\n是否开启快速推理，开启（true）生成更快，但可能牺牲一点音质\n\n【custom_cuda_kernel】\n是否启用自定义 CUDA 内核优化，一般保持 false，除非自己编译过 CUDA 内核\n\n【unload_model】\n是否在推理后卸载模型\ntrue 可以释放显存，适合显存紧张的情况\nfalse 会保留模型在显存中，下次生成更快"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [436.14013671875, 528.3545532226562], "pos": [2978.690185546875, -67.82194519042969], "id": 78, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"outputs": [], "color": "#432", "widgets_values": ["\n### 重要参数说明\n\n（其他不太重要的参数就不一一介绍了）\n\n#### **1. `max_mel_tokens`**\n*   **作用：** 控制生成的语音的长度。\n*   **说明：** 对于长文本，需要增加此参数的值。\n\n#### **2. `max_text_tokens_per_sentence`**\n*   **作用：** 每个句子的最大标记数。\n*   **说明：** 值越小，推理速度越快，但会消耗更多内存，并且可能会影响质量。\n\n#### **3. `sentences_bucket_max_size`**\n*   **作用：** 句子分桶的最大容量。\n*   **说明：** 值越大，推理速度越快，但会消耗更多内存，并且可能会影响质量。\n\n#### **4. `fast_inference`**\n*   **作用：** 启用快速推理。\n\n#### **5. `custom_cuda_kernel`**\n*   **作用：** 启用自定义 CUDA 内核。\n*   **说明：** CUDA 内核扩展将在首次运行时自动构建。\n\n#### **6. `dialogue_audio_s2`**\n*   **作用：** 双人对话的第二个音频。\n*   **说明：** 输入此音频将自动开启对话模式。对话模式下，输入的文本必须如下格式：\n\n    ```\n    [S1] 轻喘像风掠过耳畔， \n    [S2] 你靠近时，连呼吸都慢了半拍。\n    [S1] 指尖在我锁骨上游移， \n    [S2] 仿佛试探一扇未曾开启的门。\n    ```\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [399.3558654785156, 606.8486938476562], "pos": [2568.34765625, -66.22460174560547], "id": 63, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"outputs": [], "color": "#432", "widgets_values": ["On the wide-open plains of life, every step you take holds meaning.\n\nSometimes, the path is muddy and the way ahead unclear, leaving us weary and lost. Then, try not to be harsh on yourself for moving slowly, or to worry endlessly about how far the destination is. What matters isn’t the speed, but whether you are still moving forward. Like a seed buried deep in the earth, even unseen by the sun, it gathers strength silently, waiting only for the breathtaking moment it breaks through the soil.\n\nEmbrace yourself, just as you are – your vulnerabilities, your weariness, the dreams not yet realized, the puzzles still unsolved. They aren’t chains binding you, but the unique texture of your true life. Allow for cracks to exist; only then can light seep in. Those sleepless nights that weigh heavy, those moments that bring tears – in time, they will become the bedrock of your deepest resilience.\n\nBelieve: you possess far more strength than you imagine. In places hidden from view, life is weaving miracles for you, in its own way. Perhaps it’s a sudden gentle breeze, a kindness from a stranger, a book that suddenly opens your mind, or even just a sliver of morning sunlight through your window – the universe gently reminds you: beauty is never truly gone; love has always remained nearby.\n\nDon’t envy others’ blooming seasons; you have your own rhythm. What’s crucial isn’t how fast you run, but that you keep loving the ground beneath your feet and never stop gazing at the stars. When you feel overwhelmed, pause. Take a deep breath, feel the beat of your heart – life itself is cheering you on. Taking just that first small step? That, in itself, is an act of courage.\n\nThe world can be loud, but remember to safeguard the quiet sanctuary within you. It’s like a lamp that never dims, lighting your way when you lose direction. Treat yourself with the same tenderness you would offer the world’s most unique treasure. You deserve gentleness, especially from yourself.\n\nMake a simple promise starting today: no matter what happens, never stop believing in yourself or loving life. As long as you are here, light exists. Keep walking. Ahead, surely lies scenery bursting with blooming paths meant just for you. ✨"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [398.2657775878906, 768.434814453125], "pos": [-29.410072326660156, -69.99392700195312], "id": 76, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "size": [551.4334106445312, 82], "pos": [1211.2626953125, -218.9463653564453], "inputs": [], "flags": {}, "id": 73, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "克隆", "showNav": true, "toggleRestriction": "default"}, "order": 5}, {"outputs": [{"name": "text", "links": [101], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["在生命的旷野上，你正在行走的每一步，都有它独特的意义。\n\n有时，路途泥泞，前路模糊，我们难免会感到疲惫和迷茫。这时，请别苛责自己走得慢，也别急着担忧终点还远。重要的不是速度，而是你是否依然在向前。 就像一颗扎根在土壤深处的种子，即使看不见阳光，它也从未停止积蓄力量，只为破土而出那一刻的惊艳。\n\n接纳此刻的自己吧——你的脆弱、你的疲惫、那些尚未实现的梦想和未解的难题。它们不是你的枷锁，而是你真实生命的纹理。允许存在裂缝，光才能照进来。 那些让你辗转难眠的夜晚，那些让你泪流满面的瞬间，最终都会化为你灵魂深处最坚韧的基石。\n\n请相信，你远比自己想象的更有力量。 在你看不见的地方，生命正以它自己的方式为你编织着奇迹。也许是一缕不经意的微风，一句陌生人的善意，一本让你豁然开朗的书，甚至只是清晨窗边洒落的一缕阳光——宇宙以温柔的方式提醒你：美好从未远离，爱一直都在。\n\n不必羡慕别人的花期，你有自己的节奏。重要的不是你跑多快，而是你始终热爱着脚下的土地，从未放弃仰望星空。 当感到无力时，就停下来，深吸一口气，感受心跳的起伏，那是生命本身在为你鼓劲。迈出小小的第一步，这本身就是一种勇敢。\n\n世界或许喧嚣，但请记得守护内心的那片宁静。它像一盏永不熄灭的灯，在你迷失时为你照亮方向。善待自己，如同善待这世界上独一无二的珍宝。 你值得被温柔以待，尤其值得被你自己。\n\n从今天起，做一个简单的约定：不管发生什么，都不要放弃对自己的信任和对生活的热爱。 你在，光就在。继续走吧，前方，一定有属于你的、繁花似锦的风景。\n"], "inputs": [{"widget": {"name": "multi_line_prompt"}, "name": "multi_line_prompt", "label": "multi_line_prompt", "type": "STRING", "localized_name": "multi_line_prompt"}], "flags": {}, "type": "MultiLinePromptIndex", "mode": 0, "bgcolor": "#353", "size": [303.5643310546875, 358.93353271484375], "pos": [425.8506774902344, 171.75250244140625], "id": 11, "properties": {"cnr_id": "indextts-mw", "ver": "6f2de5cbacafbbf46793ddbf630940d231894d83", "widget_ue_connectable": {"multi_line_prompt": true}, "aux_id": "billwuhao/ComfyUI_IndexTTS", "Node name for S&R": "MultiLinePromptIndex"}, "order": 6}, {"mode": 4, "outputs": [], "size": [469.69488525390625, 136], "pos": [2043.135498046875, 392.9271545410156], "widgets_values": ["dapaoaudio", "320k"], "inputs": [{"name": "audio", "link": 112, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "l