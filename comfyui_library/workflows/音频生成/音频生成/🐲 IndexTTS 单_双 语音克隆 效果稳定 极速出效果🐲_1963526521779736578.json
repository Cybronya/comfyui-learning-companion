ext_tokens_per_sentence", "label": "max_text_tokens_per_sentence", "type": "INT", "localized_name": "max_text_tokens_per_sentence"}, {"widget": {"name": "sentences_bucket_max_size"}, "name": "sentences_bucket_max_size", "label": "sentences_bucket_max_size", "type": "INT", "localized_name": "sentences_bucket_max_size"}, {"widget": {"name": "fast_inference"}, "name": "fast_inference", "label": "fast_inference", "type": "BOOLEAN", "localized_name": "fast_inference"}, {"widget": {"name": "custom_cuda_kernel"}, "name": "custom_cuda_kernel", "label": "custom_cuda_kernel", "type": "BOOLEAN", "localized_name": "custom_cuda_kernel"}, {"widget": {"name": "unload_model"}, "name": "unload_model", "label": "unload_model", "type": "BOOLEAN", "localized_name": "unload_model"}], "flags": {}, "id": 67, "type": "IndexTTSRun", "properties": {"cnr_id": "indextts-mw", "ver": "6f2de5cbacafbbf46793ddbf630940d231894d83", "widget_ue_connectable": {"top_p": true, "num_beams": true, "max_text_tokens_per_sentence": true, "custom_cuda_kernel": true, "fast_inference": true, "top_k": true, "unload_model": true, "temperature": true, "max_mel_tokens": true, "sentences_bucket_max_size": true, "version": true}, "Node name for S&R": "IndexTTSRun"}, "order": 11}, {"outputs": [{"name": "text", "links": [115], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["[S1] 你知道吗？我昨天下载了一个健身App，它会自动生成训练计划，每天只要坚持20分钟，就能“蜕变成更好的自己”。\n[S2] 哟，听起来很燃啊，那你昨天练了吗？\n[S1] 练是练了……我花了20分钟在研究要不要开通它的年度会员。\n[S2] ……所以唯一锻炼的是你手指点来点去？\n[S1] 后来我问AI：“为什么我光研究App，不去动手练？” 它说：“App负责给你计划，但不负责帮你迈开腿。”\n[S2] 哈哈，这话说得挺实在的。合着你的健身之路卡在第一步：点‘开始训练’。\n[S1] 更尴尬的是，我在朋友圈晒了‘Day 1打卡’，结果根本没练，纯截图。\n[S2] 你这是健身App的最佳用法：社交展示功能100%，运动效果0%。\n[S1] 我也想坚持啊，可每次准备做平板支撑的时候，手就很自然地伸去摸零食。\n[S2] 那不叫平板支撑，那叫“平板吃撑”。\n[S1] AI安慰我：“想健身的人，是把零食当奖励；不想健身的人，是把零食当训练。”\n[S2] ……所以计划、工具、AI，最后全变成了你“自我安慰体系”的一部分？\n[S1] 对，真正被我训练成功的，只有找借口的速度。\n[S2] 那你现在算是练成了——嘴皮子六块腹肌，身体还是原装配置。"], "inputs": [{"widget": {"name": "multi_line_prompt"}, "name": "multi_l