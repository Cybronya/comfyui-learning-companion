: [373.77197265625, 88], "pos": [117.7831802368164, -141.4078369140625], "widgets_values": [], "inputs": [{"name": "audio", "link": 8, "label": "音频", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 9, "type": "PreviewAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.3.59", "widget_ue_connectable": {}, "Node name for S&R": "PreviewAudio"}, "order": 15}, {"outputs": [{"name": "STRING", "links": [49], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["哎呀，今儿个可真忙煞俺咧！（山东话）\n\n早上刚跟客户开完 Zoom meeting，对方讲：“Can you send the report by EOD?”（英语）\n\n我立马回他：“No problem, I’ll get it done!”\n\n结果转头我妹又发来 KakaoTalk 消息：「오빠, 오늘 저녁에 김치찌개 끓일 거야! 같이 먹을래?」（韩语：哥，今晚我要煮泡菜汤！一起吃吗？）\n\n我正想答应呢，手机又“叮”一声——日本同事 LINE 来了：「田中さん、資料の件、大丈夫ですか？」（日语：田中先生，资料的事，没问题吗？）\n\n俺一拍大腿：“哎哟喂，这日子过得，比赶集还热闹！”（山东话）\n\n行吧行吧，先整完 report，再去食泡菜汤，顺道学两句日语，争取下次回个「はい、問題ありません！」（是的，没问题！）"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "mode": 0, "bgcolor": "#353", "size": [353.3966369628906, 480.5706787109375], "pos": [-731.2279052734375, 93.37361907958984], "id": 38, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 0}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "rgba(38, 73, 116, 0.7)", "widgets_values": ["师父让那帮倒霉妖怪给绑票咧！那玩意儿长得嘿，青皮蓝靛脸，龇着大獠牙，一嘴天津口音还‘哏儿’地乐，扛着师父‘嗖’就飞南市那边去了！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "LayerUtility: TextBox", "title": "参考语音文本", "mode": 4, "size": [322.343017578125, 126.83248901367188], "pos": [-389.28936767578125, 965.2271728515625], "id": 40, "properties": {"widget_ue_connectable": {}, "Node name f