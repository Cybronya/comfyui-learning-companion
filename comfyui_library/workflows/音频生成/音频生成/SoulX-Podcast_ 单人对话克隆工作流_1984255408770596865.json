et_ue_connectable": {}, "Node name for S&R": "SoulXPodcastInputParser"}, "order": 7}, {"mode": 0, "outputs": [], "size": [270, 112], "pos": [1275.3084716796875, 808.6655883789062], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 4, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 7, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 9}, {"mode": 0, "outputs": [{"name": "string", "links": [], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [396.5789489746094, 384.7369079589844], "pos": [-23.862272262573242, 1146.20068359375], "widgets_values": ["[S1] 哈啰大家好啊，欢迎收听我哋慨节目。喂，我今日想问你样嘢啊，你觉唔觉得，嗯，而家揸电动车，最烦，最烦慨一样嘢系咩啊？\n\n[S1] 系咪先。如果我而家同你讲，充电可以快到同入油差唔多时间，你信唔信先？喂你平时喺油站入满一缸油，要几耐啊？五六分钟？\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "id": 12, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 1}, {"outputs": [], "color": "#432", "widgets_values": [" - [S1]哈喽，AI时代的冲浪先锋们！欢迎收听《AI生活进行时》。啊，一个充满了未来  感，然后，还有一点点，<|laughter|>神经质的播客节目，我是主持人小希。\n\n - [S1]最近活得特别赛博朋克哈！以前觉得AI是科幻片里的，<|sigh|> 现在，现在连我妈都用AI写广场舞文案了。\n\n - [S1]没错。\n\n ## 单人需要注意Json文本的格式,特别是标点符号和括号,缺一不可\n"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [750, 160], "pos": [192.8800048828125, 282.82000732421875], "id": 6, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"mode": 0, "outputs": [{"name": "string", "links": [8], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [420, 380], "pos": [422.8800048828125, 1112.8199462890625], "widgets_values": ["{\n  \"speakers\": {\n    \"S1\": {\n      \"prompt_text\": \"喜欢攀岩、徒步、滑雪的语言爱好者，以及过两天要带着全部家当去景德镇做陶瓷的白日梦想家。\"\n    }\n  },\n  \"text\": [\n    [\"S1\", \"<|Henan|>活人嘞道理？哎，这你这一说，我嘞兴致“腾”一下就上来啦！觉住咱这嗑儿，一下儿从搞笑视频蹿到文化顶上了。那你赶紧给我白话白话，这里头到底有啥道道儿？我特别想知道——为啥一提起咱河南人，好些人脑子里“蹦”出来嘞头一个词儿，就是实在？这个实在，骨子里到底是啥嘞？ \"]\n  ]\n}"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "id": 10, "type": "Text", "properties": {"cnr_id": "kaytool", "ver": "88d4ad5e270287cba566f1744097d718722eeaa3", "widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 3}, {"outputs": [], "color": "#432", "widgets_values": [" # JSON文本最简单的写法参考如上"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [343.5668640136719, 88], "pos": [422.4957580566406, 1580.4381103515625], "id": 20, "properties": {}, "order": 4}, {"mode": 0, "outputs": [{"name": "SOULX_MODEL", "links": [2, 5], "label": "SOULX_MODEL", "type": "SOULX_MODEL", "localized_name": "SOULX_MODEL"}], "size": [300, 154], "pos": [-41.506011962890625, 504.9253234863281], "widgets_values": ["SoulX-Podcast-1.7B-dialect", "hf", false, 482315190, "randomize"], "inputs": [{"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "llm_engine"}, "name": "llm_engine", "label": "llm_engine", "type": "COMBO", "localized_name": "llm_engine"}, {"widget": {"name": "fp16_flow"}, "name": "fp16_flow", "label": "fp16_flow", "type": "BOOLEAN", "localized_name": "fp16_flow"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 8, "type": "SoulXPodcastLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SoulXPodcastLoader"}, "order": 5}, {"mode": 0, "outputs": [{"name": "AUDIO", "li