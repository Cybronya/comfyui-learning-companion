ix": true, "audioUI": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "SaveAudio", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 20}, {"mode": 0, "outputs": [{"name": "string", "links": [98], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [454.1379699707031, 304.8202209472656], "pos": [840.2249755859375, -2825.58251953125], "widgets_values": ["旁白：午夜十二点，城市霓虹在落地窗外流淌。酒吧包厢里只开了一盏琥珀色壁灯，烟灰缸边缘搁着半支燃尽的细烟。林晚斜倚在丝绒沙发里，指尖轻轻敲着威士忌杯沿。陈砚坐在对面，领带松了，眼神却绷得笔直。\n林晚：项目书我看了三遍……陈总，你这估值，是拿我对你的旧情谊当杠杆撑起来的？\n旁白：她轻笑了一声，嗓音低哑，尾音微微上扬。\n陈砚：林总说笑了。数据都在附件里，没掺半点人情。如果你觉得高了，我们可以重新谈。\n旁白：他喉结动了动，目光始终避着她的唇。林晚慢悠悠啜了一口酒，指节在杯壁上轻轻一叩。\n林晚：重新谈？可我这个人啊，最讨厌反复。要么一次定局，要么……干脆别碰。就像当年，你走的时候，连句“再见”都没给全。\n旁白：陈砚手指猛地收紧，指节泛白。空气凝滞了几秒，只有冰块在杯中轻微碰撞的脆响。\n陈砚：……我以为你早忘了。\n旁白：林晚忽然倾身向前，灯光勾出她下颌的弧线，声音压得极低。\n林晚：忘？那你现在坐在这儿，是在赌我没忘，还是……希望我彻底忘了？\n旁白：她没等他回答，指尖轻轻推过一份文件。封面上印着烫金logo——正是他梦寐以求的那轮融资协议。随后她靠回沙发，嘴角噙着一抹若有似无的笑。\n林晚：签吧。条件照旧。不过这次，别再留半句话给我猜了……我年纪大了，懒得玩。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 93, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 5}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "reroutes": [{"linkIds": [], "pos": [-379.8370666503906, -3023.960205078125], "id": 1}, {"linkIds": [], "pos": [193.47015380859375, -3033.06787109375], "floating": {"slotType": "output"}, "id": 2, "parentId": 1}], "frontendVersion": "1.37.11", "VHS_latentpreview": false, "linkExtensions": [], "ds": {"offset": [-74.32340637332629, 3097.05322319331], "scale": 1.0610764609500025}}, "groups": [{"color": "#b58b2a", "font_size": 120, "flags": {}, "id": 2, "title": "Qwen3 TTS多角色配音-漫剧利器", "bounding": [-318.1731262207031, -3872.121826171875, 2667.8447265625, 171.38383