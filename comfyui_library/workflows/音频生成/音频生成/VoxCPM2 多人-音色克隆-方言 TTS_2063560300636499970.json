zed_name": "AUDIO"}], "size": [331, 152], "pos": [814, 286], "widgets_values": ["ComfyUI_00010_.mp3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 1, "type": "LoadAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.24.1", "widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 1}, {"mode": 4, "outputs": [{"name": "AUDIO", "links": [6], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "size": [316, 152], "pos": [814, 466], "widgets_values": ["ComfyUI_00015_.mp3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 2, "type": "LoadAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.24.1", "widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 2}, {"mode": 0, "outputs": [], "size": [270, 152], "pos": [1713.7799072265625, 261.2392272949219], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 3, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 3, "type": "SaveAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.24.1", "widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["RunningHub VoxCPM Multi-Speaker 节点参数说明\n\nmodel（VOXCPM_MODEL）：来自「加载模型」节点的 VoxCPM 模型\nscript（STRING）：多人对话脚本，用 [spk1]、[spk2] 等标签区分说话人\naudio_1 ~ audio_5（AUDIO）：各说话人参考音频，用于音色克隆（可选；audio_1 对应 spk1，以此类推）\ncontrol_1 ~ control_5（STRING）：各说话人语音/情绪控制指令（可选；control_1 对应 spk1，以此类推）\ncfg_value（FLOAT）：引导比例，越高越贴近控制指令（默认值：2.0）\ninference_steps（INT）：LocDiT 流匹配步数，越高质量越好但更慢（默认值：10）\nseed（INT）：随机种子，固定后可复现相同结果\nnormalize_text（BOOLEAN）：文本规范化（默认值：关闭）\ndenoise_reference（BOOLEAN）：通过 ZipEnhancer 对参考音频降噪（默认值：关闭）\nmax_len（INT）：生成期间的最大 token 长度（默认值：4096）\nretry_badcase（BOOLEAN）：输出质量较差时自动重试（默认值：开启）\n\n脚本格式示例：\n[spk1]你好，我是配音师。\n[spk2]你好，很高兴认识你。\n[spk1]那我们开始吧。\n\n使用方式：\n· 音色克隆：为 spkN 连接 audio_N 参考音频\n· 声音/情绪设计：在 control_N 填写描述，如「年轻女性，温柔自然，略带疲惫」\n· 可组合使用：参考音频定音色，控制指令调节情绪、语速、方言等\n\n台词专属音效标签（可写在 script 中）：\n[laughing] 笑声、[sigh] 叹气、[Uhm] 嗯…、[cough] 咳嗽\n[Question-ah] 疑问语气、[Surprise-wa] 惊讶「哇！」等"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [560, 620], "pos": [1710, 480], "id": 7, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"mode": 0, "outputs": [{"name": "text", "links": [4], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [404.28125, 409.90625], "pos": [761.5524291992188, 684.0577392578125], "widgets_values": ["[spk3]周末下午，客厅里只听见游戏音效和零食袋的窸窣声。\n[spk1]哎，你外卖盒子能不能别堆茶几上了，都快长蘑菇了。\n[spk2]等一下啊，马上打完了，真的马上收。\n[spk1]你上回也说马上，结果盒子放馊了还是我扔的。\n[spk3]她一边说一边把抱枕扔过去，精准砸中他后脑勺。\n[spk2]哎哟！收收收，这就去，顺便把垃圾袋换了行不？\n[spk1]行啊，那顺便把我那杯冰美式也带了，冰块都快化完了。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 5, "type": "CR Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8