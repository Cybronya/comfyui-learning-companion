ampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 51, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 19}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [121], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "size": [230, 60], "pos": [4340, -570], "widgets_values": [], "inputs": [{"name": "samples", "link": 106, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 137, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 53, "type": "VAEDecodeAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecodeAudio"}, "order": 20}, {"mode": 0, "outputs": [{"name": "AUDIO_ENCODER", "links": [114], "label": "AUDIO_ENCODER", "type": "AUDIO_ENCODER", "localized_name": "AUDIO_ENCODER"}], "size": [420, 80], "pos": [2040, -630], "widgets_values": ["sheetsage2_bf16.safetensors"], "inputs": [{"widget": {"name": "audio_encoder_name"}, "name": "audio_encoder_name", "label": "audio_encoder_name", "type": "COMBO", "localized_name": "audio_encoder_name"}], "flags": {}, "id": 56, "type": "AudioEncoderLoader", "properties": {"models": [{"directory_invalid": true, "name": "sheetsage2_bf16.safetensors", "directory": "audio_encoders", "url": "https://huggingface.co/Comfy-Org/YuE2/resolve/main/audio_encoders/sheetsage2_bf16.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "AudioEncoderLoader"}, "order": 0}, {"outputs": [], "color": "#222", "widgets_values": ["# YuE2: Music Cover\n\nCreate a new version of an existing song with YuE2.\n\nThis workflow uses **SheetSage2** to transcribe the melody from the reference audio into an editable ABC score, then uses YuE2 to regenerate the song with a new **Style** and **Lyrics**.\n\n## Input Asset\n\n- [yue2_reference_song.flac](https://raw.githubusercontent.com/Comfy-Org/workflow_templates/refs/heads/main/input/yue2_reference_song.flac)\n\n## Model Links\n\n- [Hugging Face:Comfy-Org/YuE2](https://huggingface.co/Comfy-Org/YuE2)\n- [ModelScope:Comfy-Org/YuE2](https://modelscope.cn/models/Comfy-Org/YuE2)\n\n**checkpoints**\n\n- [yue2_3b_int8_convrot.safetensors](https://huggingface.co/Comfy-Org/YuE2/resolve/main/checkpoints/yue2_3b_int8_convrot.safetensors)\n\n**audio_encoders**\n\n- [sheetsage2_bf16.safetensors](https://huggingface.co/Comfy-Org/YuE2/resolve/main/audio_encoders/sheetsage2_bf16.safetensors)\n\n\n## Model Storage Location\n\n```\n📂 ComfyUI/\n├── 📂 models/\n│   ├── 📂 checkpoints/\n│   │   └── yue2_3b_int8_convrot.safetensors\n│   └── 📂 audio_encoders/\n│       └── sheetsage2_bf16.safetensors\n```\n\n## How to Use\n\n[Subgraph](https://docs.comfy.org/interface/features/subgraph)\n\n1. Load a reference song in **Audio**.\n2. Describe the new musical direction in **Style**.\n3. Enter the lyrics you want to sing in **Lyrics**.\n4. Run the workflow to generate a new cover version.\n\nThe reference audio provides the melody, while YuE2 creates a new performance and arrangement based on your Style and Lyrics.\n\n## Writing the Style\n\nDescribe the target musical style clearly.\n\nUseful elements include:\n\n- **Genre:** jazz, pop, rock, folk, electronic\n- **Vocals:** warm male vocal, expressive female vocal, soft vocals\n- **Language:** English, Chinese, Japanese, etc.\n- **Tempo:** 90 BPM, slow, upbeat\n- **Instruments:** piano, guitar, bass, drums, strings, synths\n- **Mood:** intimate, energetic, nostalgic, cinematic\n\nExample:\n\n> English, soulful jazz-pop, expressive male vocal, relaxed 88 BPM, Rhodes piano, upright bass, brushed drums, warm saxophone, intimate late-night atmosphere\n\n## Writing Lyrics\n\nUse section tags such as:\n\n    [Verse]\n    Streetlights shimmer on the pavement\n    Midnight breathing soft and slow\n\n    [Chorus]\n    Stay with me until the morning\n    Let the city fade away\n\nYou can use:\n\n`[Verse]` · `[Chorus]` · `[Bridge]` · `[Outro]`\n\nFor better melody matching, keep the new lyrics reasonably close to the original phrasing and syllable count.\n\n## How the Cover Works\n\nThe workflow does not directly use the reference audio as YuE2 conditioning.\n\nInstead:\n\n    Reference Audio\n        ↓\n    SheetSage2\n        ↓\n    Melody ABC\n        ↓\n    YuE2 + Style + Lyrics\n        ↓\n    New Cover Audio\n\nSheetSage2 converts the source recording into a symbolic melody representation. YuE2 then uses that melody as the musical plan for the new cover.\n\n## Tips\n\n- Keep **Style** focused on the target sound, not the original sound.\n- Use **melody-only** planning for most cover tasks.\n- Changing the Style can create a very different arrangement while preserving the melody.\n- Lyrics can be changed, but similar phrasing and syllable counts usually fit the original melody better.\n- For a simple style-transfer test, keep the original lyrics and only change the Style.\n- For a stronger reinterpretation, change both the Style and Lyrics.\n\n## Learn More\n\n- [YuE2 Cover Guide](https://github.com/multimodal-art-projection/YuE/blob/main/docs/covers.md)\n- [YuE2 Music Skill](https://github.com/multimodal-art-projection/YuE/blob/main/skills/yue2-music/SKILL.md)\n- [Generation & Covers Reference](https://github.com/multimodal-art-projection/YuE/blob/main/skills/yue2-music/references/generation-and-covers.md)\n\n## Report Issue\n\nNote: Please update ComfyUI first ([guide](https://docs.comfy.org/installation/update_comfyui)) and prepare required models. Desktop/Cloud updates follow stable releases, so some nightly-supported models may not be available yet.\n\n- Cannot run / runtime errors: [ComfyUI/issues](https://github.com/comfyanonymous/ComfyUI/issues)\n- UI / frontend issues: [ComfyUI_frontend/issues](https://github.com/Comfy-Org/ComfyUI_frontend/issues)\n- Workflow issues: [workflow_templates/issues](https://github.com/Comfy-Org/workflow_templates/issues)\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#000", "size": [550, 1906.640625], "pos": [220, -260], "id": 46, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"mode": 0, "outputs": [{"name": "audio", "links": [], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [210, 82], "pos": [4628.888671875, -480], "widgets_values": ["audio/YuE2_cover", "flac"], "inputs": [{"name": "audio", "link": 121, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "format"}], "flags": {}, "id": 10, "type": "SaveAudioAdvanced", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudioAdvanced"}, "order": 21}, {"outputs": [{"name": "LATENT", "links": [104], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#323", "widgets_values": [120, 1], "inputs": [{"widget": {"name": "seconds"}, "name": "seconds", "link": 105, "label": "seconds", "type": "FLOAT", "localized_name": "seconds"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "type": "EmptyYuE2LatentAudio", "mode": 0, "bgcolor": "#535", "size": [230, 90], "pos": [3723.18896484375, -324.098876953125], "id": 52, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "EmptyYuE2LatentAudio"}, "order": 17}, {"mode": 0, "outputs": [{"shape": 6, "name": "abc", "links": [117], "label": "abc", "type": "STRING", "localized_name": "abc"}], "size": [230, 90]