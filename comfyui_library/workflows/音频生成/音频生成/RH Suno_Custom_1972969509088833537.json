idgets_values": ["## 主歌 1\n\n电台循环着热闹的流行说唱\n老旧蓝调 没人跟着节拍摇晃\n弯折的音符裹着尘封过往\n路人摇头 嫌它节奏太过漫长\n\n## 预副歌\n\n没有短视频里洗脑的段落\n没有强劲鼓点追赶着烟火\n蓝调还在诉说旧日的坎坷\n人群匆匆 不愿驻足去琢磨\n\n## 副歌\n\n榜单之上 蓝调不受欢迎\n沉重词句 慢慢归于寂静\n世人偏爱欢喜 不愿触碰心痛\n古老蓝调 留不住听众\n榜单之上 蓝调不受欢迎\n琴弦低泣 迷失在人海中\n世人偏爱欢喜 不愿触碰心痛\n古老蓝调 留不住听众\n\n## 主歌 2\n\n酒馆灯光暗 吉他低声呜咽\n寥寥几个客 静静守着长夜\n歌唱苦日子 离别和眼泪\n世人忙着刷屏 没时间体会\n\n## 桥段\n\n它是摇滚之源 是 R&B 根基\n我们熟悉的歌 都从这里而起\n可这深埋的根 难被人看清\n没人停下脚步 用心倾听\n\n## 尾奏\n\n老蓝调……\n如今少人听\n老蓝调……\n悄悄归于平静"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 8, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 15}, {"mode": 0, "outputs": [{"name": "IMAGE", "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [733.8435668945312, 626.813720703125], "pos": [-221.08509826660156, 198.2528839111328], "widgets_values": ["pasted/ba7f0ccee367b3ebc5cf6317fdb5fa6aa8d1f7f69d9dda3579e8e83846d87573.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 6, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 12}, {"mode": 0, "outputs": [{"name": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [367.5758361816406, 203.2281036376953], "pos": [1350, 890], "widgets_values": ["audio1/ComfyUI"], "inputs": [{"name": "audio", "link": 33, "label": "音频", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 11, "type": "Sa