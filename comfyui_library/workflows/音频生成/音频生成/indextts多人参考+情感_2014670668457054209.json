widget": {"name": "Low"}, "name": "Low", "label": "Low", "type": "FLOAT", "localized_name": "Low"}, {"widget": {"name": "Surprise"}, "name": "Surprise", "label": "Surprise", "type": "FLOAT", "localized_name": "Surprise"}, {"widget": {"name": "Neutral"}, "name": "Neutral", "label": "Neutral", "type": "FLOAT", "localized_name": "Neutral"}], "flags": {}, "id": 62, "type": "easy indexTTSEmotionVector", "properties": {"cnr_id": "comfyui-easy-indextts2", "ver": "da020b3d1ae4652ee31ffbdbb38a9323814db620", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "aux_id": "yolain/ComfyUI-Easy-IndexTTS2", "Node name for S&R": "easy indexTTSEmotionVector"}, "order": 9}, {"outputs": [], "color": "#432", "widgets_values": ["[徒儿] 师尊！师尊！好长时间没看到你，想死你啦！\n[师尊] 乖徒儿，怎么毛毛躁躁的。快来到为师怀里来。\n-0.5s-\n[徒儿] 师尊，我要吃糖葫芦！\n[师尊] 小馋猫，这就给你买哦！\n\n\n[宠溺少女]还不肯闭眼呀？那我可要使出绝招了——今晚允许你把我当抱枕哦。你睫毛在偷偷颤呢，是不是在等我的晚安吻？乖，先躺平啦…我要开始念咒语了：第一句是“我家小朋友全世界最帅”，第二句是“明天早餐给你煎心形鸡蛋”，晚安，我的大宝贝。\n\n[旁白]云雾缭绕的仙山之巅，一道娇俏的身影如乳燕投林般扑入那谪仙人的怀中，打破了此间的宁静。\n-1s-\n[徒儿开心]师尊！师尊！可想死我啦！您这次闭关，徒儿觉得山上的日头都走得慢了！\n-1s-\n[师傅温和]你呀，修为不见长，这毛毛躁躁的性子倒是一点没变。\n-2s-\n[徒儿活泼]师尊~我这些日子可乖了，那套剑法也练熟了。所以……我现在能不能吃一串山下王婆婆做的糖葫芦呀？就一串！\n-1s-\n[师傅宠溺]果然是个小馋猫，在这儿等着为师呢。罢了，今日破例，这就带你去买。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [522.966552734375, 523.5256958007812], "pos": [2376.888427734375, 1504.8203125], "id": 63, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 1}, {"mode": 0, "outputs": [{"name": "emotions", "links": [95], "label": "emotions", "type": "EASY_INDEXTTS_EMOTIONS", "localized_name": "emotions"}], "size": [258.3111267089844, 274], "pos": [1196.1822509765625, 1962.880615234375], "widgets_values": ["旁白", false, 0, 0, 0, 0, 0, 0, 0, 0], "inputs": [{"name": "reference_audio", "link": 94, "label": "reference_audio", "type": "AUDIO", "localized_name": "reference_audio"