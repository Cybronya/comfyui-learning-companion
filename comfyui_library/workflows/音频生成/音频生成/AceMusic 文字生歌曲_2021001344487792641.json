\n硬件与软件共舞飞扬\n是自动驾驶关键力量\n冲破迷雾迎接曙光\n驶向那未来的远方\n\n每一次加速每一次转向\n都凝聚智慧的光芒\n在这未知旅途上\n开启全新的辉煌\n\n（结尾）\n在时代浪潮中领航\n书写自动驾驶的诗行\n硬件软件携手闯荡\n拥抱那无尽的希望 "], "inputs": [{"widget": {"name": "lyrics"}, "name": "lyrics", "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}], "flags": {}, "id": 3, "type": "AceMusicLyricsInput", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AceMusicLyricsInput"}, "order": 0}, {"mode": 0, "outputs": [{"name": "model", "slot_index": 0, "links": [1], "label": "model", "type": "ACEMUSIC_MODEL", "localized_name": "model"}], "size": [320, 150], "pos": [397.7769470214844, -198.61729431152344], "widgets_values": ["cuda", false, false, false], "inputs": [{"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "cpu_offload"}, "shape": 7, "name": "cpu_offload", "label": "cpu_offload", "type": "BOOLEAN", "localized_name": "cpu_offload"}, {"widget": {"name": "torch_compile"}, "shape": 7, "name": "torch_compile", "label": "torch_compile", "type": "BOOLEAN", "localized_name": "torch_compile"}, {"widget": {"name": "overlapped_decode"}, "shape": 7, "name": "overlapped_decode", "label": "overlapped_decode", "type": "BOOLEAN", "localized_name": "overlapped_decode"}], "flags": {}, "id": 1, "type": "AceMusicModelLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AceMusicModelLoader"}, "order": 1}, {"mode": 0, "outputs": [{"name": "settings", "slot_index": 0, "links": [2], "label": "settings", "type": "ACEMUSIC_SETTINGS", "localized_name": "settings"}], "size": [320, 310], "pos": [416.45904541015625, 497.18035888671875], "widgets_values": [150, "ja", 120, "4/4", "", false, 27, 15, 1820295140, "randomize"], "inputs": [{"widget": {"name": "duration"}, "name": "duration", "label": "duration", "type": "FLOAT", "localized_name": "duration"}, {"widget": {"name": "vocal_language"}, "name": "vocal_language", "label": "vocal_language", "type": "COMBO", "lo