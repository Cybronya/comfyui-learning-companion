end/issues)\n- Workflow issues: [workflow_templates/issues](https://github.com/Comfy-Org/workflow_templates/issues)\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: Model Links", "mode": 0, "bgcolor": "#000", "size": [500, 1000], "pos": [2840, 300], "id": 117, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [301], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "size": [430, 200], "pos": [40, 300], "widgets_values": ["", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 150, "type": "LoadAudio", "title": "01 上传参考音频", "properties": {"cnr_id": "comfy-core", "widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 10}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "KKvideo_latentpreview": false, "ue_links": [], "KKvideo_latentpreviewrate": 0, "VHS_MetadataImage": true, "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [2989.4443960984554, 1070.833311416209], "scale": 0.45}}, "groups": [{"color": "#b58b2a", "font_size": 72, "flags": {}, "id": 1, "title": "pandy-minimaxH3-单音频-声音克隆", "bounding": [0, -10, 3380, 150]}, {"color": "#3f789e", "font_size": 28, "flags": {}, "id": 2, "title": "01 参考音频与台词", "bounding": [0, 210, 520, 1230]}, {"color": "#3f789e", "font_size": 28, "flags": {}, "id": 3, "title": "02 模型加载", "bounding": [580, 210, 600, 790]}, {"color": "#3f789e", "font_size": 28, "flags": {}, "id": 4, "title": "03 提示词与音频条件", "bounding": [1240, 210, 600, 1270]}, {"color": "#3f789e", "f