tar, Echoing drumbeat]  \n爱是孤勇，无需祈求，  \n我站在风口，为你守候。  \n黑夜深处，心仍炽热，  \n不被理解，也无怨无悔。"], "inputs": [{"shape": 7, "name": "anything", "link": 4, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"pinned": true}, "type": "easy showAnything", "mode": 0, "bgcolor": "#3f5159", "size": [374.7050476074219, 531.7227172851562], "pos": [-1261.8343505859375, 537.35498046875], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 8}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#2a363b", "widgets_values": ["Alternative Rock, Emotional Rock, Melancholic, Male Solo Vocals, Electric Guitar, Bass Guitar, Drums, Moderate Tempo"], "inputs": [{"shape": 7, "name": "anything", "link": 7, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"pinned": true}, "type": "easy showAnything", "mode": 0, "bgcolor": "#3f5159", "size": [330.3727111816406, 246.2672882080078], "pos": [-813.8410034179688, 531.0385131835938], "id": 11, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 7}, {"outputs": [{"name": "describe", "links": [7, 8], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#2a363b", "widgets_values": ["", "", "", "", "歌曲风格", 0.6, 1485442263, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "ref_image1", "label": "ref_image1", "type": "IMAGE", "localized_name": "ref_image1"}, {"shape": 7, "name": "ref_image2", "label": "ref_image2", "type": "IMAGE", "localized_name": "ref_image2"}, {"shape": 7, "name": "ref_image3", "label": "ref_image3", "type": "IMAGE", "localized_name": "ref_image3"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": 