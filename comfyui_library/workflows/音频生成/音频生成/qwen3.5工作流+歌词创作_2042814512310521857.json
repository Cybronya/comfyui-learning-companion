n[副歌]\n长相思 长相思 梦断天涯路\n望穿秋水 却不见归途的脚步\n长相思 长相思 泪湿青衫处\n这一场相思 熬白了少年的发\n\n[桥段]\n时光若能停驻 在初见的那刻\n是否就能 改写这无解的谜题\n可命运如戏 总爱在人最深处\n留下最痛的 遗憾和谜题\n\n[副歌]\n长相思 长相思 梦断天涯路\n望穿秋水 却不见归途的脚步\n长相思 长相思 泪湿青衫处\n这一场相思 熬白了少年的发\n\n[尾声]\n长相思... 长相思...\n风停了 月落了 人散了\n只剩这 一声叹息\n在岁月里 轻轻回荡\n长相思..."], "inputs": [{"name": "text", "link": 19, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 25, "type": "ShowText|pysssss", "title": "展示文本", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "1.2.5", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 5}, {"mode": 0, "outputs": [{"name": "llama_model", "links": [11], "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}], "size": [400.0130615234375, 280.4432067871094], "pos": [2384.164306640625, -30.568416595458984], "widgets_values": ["Qwen3.5-9B-Q8_0.gguf", "Qwen3.5-9B-mmproj-BF16.gguf", "Qwen3.5", 8192, -1, 0, 0], "inputs": [{"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "mmproj"}, "name": "mmproj", "label": "mmproj", "type": "COMBO", "localized_name": "mmproj"}, {"widget": {"name": "chat_handler"}, "name": "chat_handler", "label": "chat_handler", "type": "COMBO", "localized_name": "chat_handler"}, {"widget": {"name": "n_ctx"}, "name": "n_ctx", "label": "n_ctx", "type": "INT", "localized_name": "n_ctx"}, {"widget": {"name": "vram_limit"}, "name": "vram_limit", "label": "vram_limit", "type": "INT", "localized_name": "vram_limit"}, {"widget": {"name": "image_min_tokens"}, "name": "image_min_tokens", "label": "image_min_tokens", "type": "INT", "localized_name": "image_min_tokens"}, {"widget": {"name": "image_max_tokens"}, "name": "image_max_tokens", "label": "image_max_tokens", "type": "INT", "localized_name": "image_max_tokens"}], "flags": {}, "id": 12, "type": "llama_cpp_model_loader", "properties": {"ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "widget_ue_connectable": {}