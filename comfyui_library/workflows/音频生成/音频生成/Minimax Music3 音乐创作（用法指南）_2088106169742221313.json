"label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 51, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 48, "type": "VAEDecodeAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecodeAudio"}, "order": 12}, {"mode": 0, "outputs": [{"name": "output", "links": [67], "label": "output", "type": "*", "localized_name": "output"}], "size": [281.30926513671875, 110], "pos": [3808.321533203125, 320.3083801269531], "widgets_values": [false], "inputs": [{"name": "on_false", "link": 63, "label": "on_false", "type": "AUDIO", "localized_name": "on_false"}, {"name": "on_true", "link": 64, "label": "on_true", "type": "AUDIO", "localized_name": "on_true"}, {"widget": {"name": "switch"}, "name": "switch", "label": "switch", "type": "BOOLEAN", "localized_name": "switch"}], "flags": {}, "id": 51, "type": "ComfySwitchNode", "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {}, "Node name for S&R": "ComfySwitchNode"}, "order": 14}, {"mode": 0, "outputs": [{"name": "FLOAT", "links": [68], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "size": [270, 58], "pos": [621.718505859375, 0.033694688230752945], "widgets_values": [120], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "id": 53, "type": "PrimitiveFloat", "title": "目标时长（s）", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 6}, {"outputs": [], "color": "#222", "widgets_values": ["# MiniMax Music 3\n\n由 MiniMax 推出的音乐生成模型，可生成最长达 5 分钟、结构稳定且音质出色的完整歌曲。模型由两个关键输入驱动：**Caption**（结构化的音乐描述：风格、情绪、人声、编曲）与 **Lyrics**（带有 `[intro]`、`[verse]`、`[chorus]`、`[bridge]`、`[outro]` 等控制歌曲结构的标签）。\n\n### 参数说明\n\n| 参数 | 说明 |\n|---|---|\n| Caption | 音乐描述。建议分为三个部分撰写：全局元数据（Global Metadata）→ 人声细节（Vocal Details）→ 编曲（Arrangement）。描述越具体，生成结果越贴近预期。 |\n| Lyrics | 歌曲歌词 + 段落标签。结构标签是唯一能直接控制歌曲结构的指令；歌词文本本身仅用于传达氛围与情绪。 |\n| max_duration | 目标歌曲时长，单位为秒（默认 120 = 2 分钟；模型最高支持约 300 秒 / 5 分钟）。歌曲越长，消耗的时间和显存（VRAM）越多。 |\n| seed | 随机数种子。固定该值可复现相同的歌曲；更改该值可获得不同的演绎版本。 |\n| Model files | 模型文件：扩散模型（diffusion model） / 文本编码器（text encoder） / VAE。 |\n| Tiled decode | 切片解码。通过重叠切片的方式解码音频 VAE，能大幅降低显存占用 —— 非常适合显存较小的显卡生成长歌曲。生成速度会稍慢一些，且切片边缘有极小概率出现接缝；显存充足时建议关闭此功能以获取最高音质。 |\n\n### 提示词编写指南\n\n你可以在此处获取官方的 [Music Caption Rewriter Skill](https://github.com/MiniMax-AI/MiniMax-Music3)。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: MiniMax Music 3", "mode": 0, "bgcolor": "#000", "size": [520, 660], "pos": [48.53508758544922, -6.521585464477539], "id": 39, "properties": {"widget_ue_connectable": {}}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.48.7", "VHS_latentpreview": false, "ds": {"offset": [2245.7859677352712, 827.1388998960442], "scale": 0.45}}, "groups": [{"color": "#b06634", "font_size": 70, "flags": {}, "id": 1, "title": "B站：野生技能师", "bounding": [57.0909538269043, -203.24278259277344, 1780.7431640625, 96.66598510742188]}], "links": [[43, 43, 0, 42, 0, "CLIP"], [44, 42, 0, 45, 0, "CONDITIONING"], [45, 42, 1, 46, 0, "FLOAT"], [46, 41, 0, 47, 0, "MODEL"], [47, 42, 0, 47, 1, "CONDITIONING"], [48, 45, 0, 47, 2, "CONDITIONING"], [49, 46, 0, 47, 3, "LATENT"], [50, 47, 0, 48, 0, "LATENT"], [51, 44, 0, 48, 1, "VAE"], [55, 49, 0, 42, 3, "INT"], [56, 49, 0, 47, 4, "INT"], [61, 47, 0, 50, 0, "LATENT"], [62, 44, 0, 50, 1, "VAE"], [63, 48, 0, 51, 0, "AUDIO"], [64, 50, 0, 51, 1, "AUDIO"], [67, 51, 0, 35, 0, "AUDIO"], [68, 53, 0, 42, 4, "FLOAT"], [69, 54, 0, 42, 1, "STRING"], [70, 55, 0, 42, 2, "STRING"]], "id": "08882d3e-437d-43da-b498-083de04a60a6", "config": {}, "version": 0.4, "last_node_id": 55, "revision": 0}