9062], "widgets_values": ["【Verse 1】\n残月照孤城 旧雪落长亭\n青石阶前 谁抚断弦听\n一盏薄酒 温不热前尘\n灯影摇红 写尽几行命\n\n【Pre-Chorus】\n世事如棋 落子无声\n你我偏在 局中生\n\n【Chorus】\n我以长风入梦\n吹散万里浮名\n剑影未冷 心事先动\n一念已成终生\n你在红尘一笑\n乱我半世安宁\n若问情字多重\n山河作证\n\n【Verse 2】\n旧信泛黄 字迹还未平\n雁过无痕 却扰我心境\n江湖太远 人心太近\n回首已是 前世今生\n\n【Pre-Chorus】\n宿命如河 不问西东\n唯你逆流而行\n\n【Chorus】\n我以长风入梦\n吹散万里浮名\n剑影未冷 心事先动\n一念已成终生\n你在红尘一笑\n乱我半世安宁\n若问情字多重\n山河作证\n\n【Bridge】\n若此身 注定成空\n也愿为你 再入风中\n刀光剑影 皆成虚影\n不敌你 一眼回眸\n\n【Final Chorus】\n我以长风入梦\n换你一瞬天明\n纵然此生 无缘白首\n也不负这段情\n待到尘埃落定\n天地一片清明\n我把姓名写进\n你命中\n\n【Outro】\n风停 梦醒\n江湖只剩 你名\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "id": 9, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 3}, {"mode": 0, "outputs": [{"name": "audio_output", "links": [10], "label": "audio_output", "type": "AUDIO", "localized_name": "audio_output"}, {"name": "filepath", "label": "filepath", "type": "STRING", "localized_name": "filepath"}], "size": [400, 426], "pos": [-122.37776184082031, 246.16932678222656], "widgets_values": ["", "", "RL-oss-3B-20260123", "oss-20260123", 721580382663012, "randomize", 240, 50, 1, 1.5, true, "auto", false], "inputs": [{"widget": {"name": "lyrics"}, "name": "lyrics", "link": 8, "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "tags"}, "name": "tags", "link": 9, "label": "tags", "type": "STRING", "localized_name": "tags"}, {"widget": {"name": "version"}, "name": "version", "label": "version", "type": "COMBO", "localized_name": "version"}, {"widget": {"name": "codec_version"}, "name": "codec_version", "label": "codec_version", "type": "COMBO", "localized_name": "codec_version"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_audio_length_seconds"}, "name": "max_audio_length_seconds", "label": "max_audio_length_seconds",