——\n我的沉默，是比拒绝更锋利的答案。\n我的背影，是比告别更彻底的终结。", "20 岁痞哑音男声：桀骜嚣张，语气散漫却透着随时动手的暴戾", "自动", false, 2048, 0, "固定"], "inputs": [{"name": "模型", "link": 3, "label": "模型", "type": "QWEN3_TTS_MODEL", "localized_name": "模型"}, {"widget": {"name": "文本"}, "name": "文本", "label": "文本", "type": "STRING", "localized_name": "文本"}, {"widget": {"name": "提示词"}, "name": "提示词", "link": 22, "label": "提示词", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "语言"}, "shape": 7, "name": "语言", "label": "语言", "type": "COMBO", "localized_name": "语言"}, {"widget": {"name": "自动卸载模型"}, "shape": 7, "name": "自动卸载模型", "label": "自动卸载模型", "type": "BOOLEAN", "localized_name": "自动卸载模型"}, {"widget": {"name": "最大生成Token数"}, "shape": 7, "name": "最大生成Token数", "label": "最大生成Token数", "type": "INT", "localized_name": "最大生成Token数"}, {"widget": {"name": "随机种子"}, "shape": 7, "name": "随机种子", "label": "随机种子", "type": "INT", "localized_name": "随机种子"}, {"widget": {"name": "生成后控制"}, "shape": 7, "name": "生成后控制", "label": "生成后控制", "type": "COMBO", "localized_name": "生成后控制"}], "flags": {}, "type": "Qwen3TTSVoiceDesign", "mode": 0, "bgcolor": "#3f5159", "size": [406.5970764160156, 344.9990539550781], "pos": [1911.3988037109375, 720.4005126953125], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Qwen3TTSVoiceDesign"}, "order": 7}, {"outputs": [{"name": "selected_value", "links": [], "label": "值", "type": "*", "localized_name": "selected_value"}, {"name": "selected_label", "links": [22], "label": "标签", "type": "STRING", "localized_name": "selected_label"}, {"name": "selected_index", "links": [], "type": "INT", "localized_name": "selected_index"}], "color": "#322", "widgets_values": [1, false], "inputs": [{"shape": 7, "name": "input1", "link": 10, "label": "输入1", "type": "*", "localized_name": "input1"}, {"widget": {"name": "select"}, "name": "select", "type": "INT", "localized_name": "选择"}, {"widget": {"name": "sel_mode"}, "name": "sel_mode", "type": "BOOLEAN", "localized_name": "选择模式"}, {"name": 