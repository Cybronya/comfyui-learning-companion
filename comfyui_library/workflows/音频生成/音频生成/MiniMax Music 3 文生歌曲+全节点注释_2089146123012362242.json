": "seconds", "links": [66], "label": "seconds", "type": "FLOAT", "localized_name": "seconds"}], "color": "#3f384f", "widgets_values": ["主题是和过去的自己和解，经历挫折后学会继续向前。整体情绪从克制低落走向明亮坚定，适合女声演唱，画面感要有夜路、清晨、风、光这些意象。", "[Verse]\\n昨日的阴雨让\\n眼眶沉重\\n不安在脚下盘踞\\n直到夜色沉透\\n\\n[Pre-Chorus]\\n在这条夜路走太久\\n即使不如我所愿\\n我知道黑暗过后\\n\\n[Chorus]\\n有晨光洒在脸上\\n轻声对我讲\\n终将如愿以偿\\n终将如愿以偿\\n有晨光洒在脸上\\n轻声对我讲\\n终将如愿以偿\\n终将如愿以偿\\n\\n[Verse 2]\\n那段路也不算长\\n我又能熬过几场\\n熬过几场\\n\\n[Pre-Chorus]\\n即使还看不到尽头\\n心里有个微弱声\\n我会穿过这长夜\\n\\n[Chorus]\\n有晨光洒在脸上\\n轻声对我讲\\n终将如愿以偿\\n终将如愿以偿\\n有晨光洒在脸上\\n轻声对我讲\\n终将如愿以偿\\n终将如愿以偿", 145036952048352, "randomize", 240.00000000000006, 1.7, 50], "inputs": [{"name": "clip", "link": 64, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "caption"}, "name": "caption", "label": "caption", "type": "STRING", "localized_name": "caption"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_duration"}, "name": "max_duration", "label": "max_duration", "type": "FLOAT", "localized_name": "max_duration"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}], "flags": {"pinned": true, "collapsed": false}, "type": "MiniMaxMusic3TextEncode", "mode": 0, "bgcolor": "#6c6088", "size": [240, 750], "pos": [490, 0], "id": 45, "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {"seed": true}, "Node name for S&R": "MiniMaxMusic3TextEncode"}, "order": 13}, {"outputs": [{"name": "LATENT", "links": [71], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "color": "#3f384f", "widgets_values": [119443437327998, "randomize", 30, 1.7, "euler", "simple", 1], "inputs": [{"name": "model", "link": 67, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "positive", "link": 68, "label": "正面条件", "type": "CONDITIONING", "localized_name": "正面条件"}, {"name": "negative", "link": 69, "label": "负面条件", "type": "CONDITIONING", "localized_name": "负面条件"}, {"name": "latent_image", "link": 70, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "调度器"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {"pinned": true, "collapsed": false}, "type": "KSampler", "mode": 0, "bgcolor": "#6c6088", "size": [240, 270], "pos": [1470, 0], "id": 49, "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {"seed": true}, "Node name for S&R": "KSampler"}, "order": 16}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#45 MiniMaxMusic3TextEncode\n作用：接收音乐主题描述、歌词、随机种子、目标时长和生成策略，把文本编码成 MiniMax Music 3 的正向 CONDITIONING，并输出与歌词结构匹配的音频秒数供空 latent 对齐。\n参数：\n- caption：当前值=主题是和过去的自己和解，经历挫折后学会继续向前。整体情绪从克制低落走向明亮坚定，适合女声演唱，画面…；作用：描述歌曲主题、情绪、演唱方式和编曲意象；写得更具体会让生成的音乐更贴近这些风格线索；范围：文本；建议写清主题、情绪、音色、乐器或场景，长度受模型限制；默认：空字符串。\n- lyrics：当前值=[Verse]\\n昨日的阴雨让\\n眼眶沉重\\n不安在脚下盘踞\\n直到夜色沉透\\n\\n[Pre-Ch…；作用：填写模型要演唱的歌词；使用 `[Verse]`、`[Chorus]` 等段落标记可帮助模型组织主歌和副歌；范围：多行文本；建议按歌曲段落编排，长度受目标时长和模型限制；默认：空字符串。\n- seed：当前值=1016043705527901；作用：控制歌曲生成时的随机起点；固定数值可复现相近结果，改动数值会得到不同旋律、编曲和演唱细节；范围：非负整数，通常 0 到 2^63-1；默认：1（本工作流设定）。\n- control_after_generate：当前值=randomize；作用：决定一次运行结束后如何处理种子；`randomize` 会为下次运行换种子，`fixed` 保持当前种子以便复现；范围：节点提供的策略枚举，如 fixed、randomize、increment；默认：randomize（本工作流设定）。\n- max_duration：当前值=240.00000000000006；作用：设置歌曲允许的最长时长；调大可容纳更多歌词和段落，但会增加生成时间，实际输出时长仍由模型根据歌词结构决定；范围：正浮点秒数；常见从几十秒到数分钟，受模型版本限制；默认：240 秒（本工作流设定）。\n- cfg_scale：当前值=1.7；作用：控制生成结果遵从主题描述和歌词条件的力度；调大更严格贴合文字，调小会让旋律和编曲更自由；范围：非负浮点数；通常从 1.0 到 3.0 附近小步试调；默认：1.7（本工作流设定）。\n- top_k：当前值=50；作用：限制每一步音乐 token 采样时可选的高概率候选数量；调大增加旋律与编曲变化，调小更保守和稳定；范围：正整数；常用几十到数百，具体上限由模型实现决定；默认：50（本工作流设定）。\n- clip：当前值=来自 节点#54 CLIPLoader 的 `CLIP` 输出；作用：接收 CLIP 编码器对象，用于把提示词编码成条件向量；范围：CLIP 编码器对象（连线输入）；默认：由上游节点输出决定。\n邀请码：jq8lvwrk，领1000RH币"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 1000], "pos": [490, 798], "id": 58, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#44 UNETLoader\n作用：加载扩散主干模型（UNet），决定核心生成能力。\n参数：\n- unet_name：当前值=minimax_music3_dit_fp16.safetensors；作用：选择 UNet 模型文件；范围：模型下拉列表中的文件名；默认：系统默认 UNet。\n- weight_dtype：当前值=default；作用：模型权重精度类型；范围：fp16 / bf16 / fp8 等枚举；默认：默认精度。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 244], "pos": [0, 188], "id": 57, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#54 CLIPLoader\n作用：加载 CLIP 语义编码器，供文本/图像条件编码使用。\n参数：\n- clip_name：当前值=minimax_music3_text_encoder_pruned_int8_convrot.s…；作用：选择 CLIP 模型文件；范围：模型下拉列表中的文件名；默认：系统默认 CLIP。\n- type：当前值=minimax；作用：CLIP 工作模式；范围：插件定义的下拉枚举；默认：default。\n- device：当前值=default；作用：模型运行设备；范围：cpu / cuda / mps 等可用设备；默认：default。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 316], "pos": [0, 716], "id": 64, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#46 VAELoader\n作用：加载 VAE 编解码器，负责像素域与潜空间转换。\n参数：\n- vae_name：当前值=minimax_music3_dav.safetensors；作用：选择 VAE 文件；范围：VAE 文件列表中的文件名；默认：系统默认 VAE。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 190], "pos": [0, 1316], "id": 59, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#48 EmptyMiniMaxMusic3LatentAudio\n作用：根据目标音频时长和批次数创建 MiniMax Music 3 的空白音频 latent，作为采样器从噪声生成歌曲的初始时间轴容器。\n参数：\n- batch_size：当前值=1；作用：设置一次并行生成的歌曲数量；调大可同时得到更多候选，但会近似按比例增加显存占用和耗时；范围：正整数；通常为 1，受显存容量限制；默认：1（本工作流设定）。\n- seconds：当前值=来自 节点#45 MiniMaxMusic3TextEncode 的 `seconds` 输出；作用：设定空音频 latent 的目标时长；调大可容纳更长歌曲但会增加采样时间和显存，必须与文本编码节点输出的时长一致；范围：正浮点秒数；通常由 MiniMaxMusic3TextEncode 的 `seconds` 输出提供；默认：由上游 MiniMaxMusic3TextEncode 的 `seconds` 输出决定。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 406], "pos": [980, 188], "id": 61, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#47 ConditioningZeroOut\n作用：把条件向量清空成近似 0，等于给模型一段“空约束”，常用于关闭干扰或做空负面词。\n参数：\n- conditioning：当前值=来自 节点#45 MiniMaxMusic3TextEncode 的 `CONDITIONING`…；作用：接收条件向量并输出零化结果，相当于给模型一段空约束；范围：CONDITIONING 连线输入；默认：必须连接上游节点。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 226], "pos": [980, 878], "id": 60, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#49 KSampler\n作用：核心采样器：按步数/采样器/调度器将噪声迭代为目标 latent。\n参数：\n- seed：当前值=1；作用：随机种子，控制可复现性；范围：整数，常见 0 ~ 2^63-1；默认：0。\n- control_after_generate：当前值=randomize；作用：每次生成后对种子的处理策略；范围：固定/随机/递增等枚举值；默认：fixed。\n- steps：当前值=30；作用：采样步数，步数越高通常细节越充分；范围：整数，常见 1 ~ 150；默认：20。\n- cfg：当前值=1.7；作用：提示词引导强度；范围：浮点，常见 0.0 ~ 30.0；默认：7.0。\n- sampler_name：当前值=euler；作用：采样算法类型；范围：下拉枚举（如 euler / dpm / sa_solver）；默认：euler。\n- scheduler：当前值=simple；作用：噪声调度策略；范围：下拉枚举（normal / karras / beta 等）；默认：normal。\n- denoise：当前值=1；作用：去噪强度；1 表示完整重绘；范围：浮点 0.0 ~ 1.0；默认：1.0。\n- model：当前值=来自 节点#44 UNETLoader 的 `MODEL` 输出；作用：接收上游模型对象（具体是扩散模型、姿态模型或检测模型由该节点类型决定）；范围：模型对象（连线输入）；默认：由上游节点输出决定。\n- positive：当前值=来自 节点#45 MiniMaxMusic3TextEncode 的 `CONDITIONING`…；作用：接收正向条件向量，告诉模型“应该生成什么”；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。\n- negative：当前值=来自 节点#47 ConditioningZeroOut 的 `CONDITIONING` 输出；作用：接收负向条件向量，告诉模型“尽量避免什么”；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。\n- latent_image：当前值=来自 节点#48 EmptyMiniMaxMusic3LatentAudio 的 `LATENT`…；作用：接收起始 latent 画布或中间 latent 结果，作为采样输入底稿；范围：latent 数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 946], "pos": [1470, 318], "id": 62, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#50 VAEDecodeAudio\n作用：将音频 latent 通过对应 VAE 解码为可播放波形数据，输出供合成视频、试听或保存音频节点继续使用。\n参数：\n- samples：当前值=来自 节点#49 KSampler 的 `LATENT` 输出；作用：接收待处理 latent 样本（如待解码或待上采样的数据）；范围：latent 数据（连线输入）；默认：由上游节点输出决定。\n- vae：当前值=来自 节点#46 VAELoader 的 `VAE` 输出；作用：接收 VAE 对象，用于像素图像与 latent 之间转换；范围：VAE 对象（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 316], "pos": [1960, 188], "id": 63, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#55 CR Text\n作用：接收一段文本并原样输出，常用来传递提示词片段、保存前缀或其它字符串变量。\n参数：\n- text：当前值；\n作用：输入文本内容（正/负提示词）；范围：字符串，通常 0 ~ 4096 字符；默认：空字符串。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 190], "pos": [1960, 848], "id": 65, "properties": {"widget_ue_connectable": {}}, "order": 12}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#35 SaveAudioAdvanced\n作用：接收解码后的 AUDIO，按选择的音频格式写入输出目录；文件名前缀由统一文本节点控制，输出文件可直接下载或在后续音频节点中继续使用。\n参数：\n- format：当前值=flac；作用：选择写出的音频编码格式；`flac` 为无损格式、文件较大，改为有损格式可减小文件但会增加压缩损失；范围：节点提供的音频格式枚举，如 flac、wav、mp3；默认：flac（本工作流设定）。\n- audio：当前值=来自 节点#50 VAEDecodeAudio 的 `AUDIO` 输出；作用：接收上游音频数据；范围：AUDIO 类型数据（连线输入）；默认：由上游节点输出决定。\n- filename_prefix：当前值=来自 节点#55 CR Text 的 `text` 输出；作用：设置保存音频的文件名前缀；本流程由统一文本节点接管，便于按固定名称识别输出结果；范围：文件系统允许的字符串，可包含相对子目录；"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 406], "pos": [2450, 188], "id": 56, "properties": {"widget_ue_connectable": {}}, "order": 11}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "KKvideo_latentpreview": false, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-1532.5412878051595, 189.91872420524157], "scale": 1.2839025177495054}}, "groups": [], "links": [[64, 54, 0, 45, 0, "CLIP"], [65, 45, 0, 47, 0, "CONDITIONING"], [66, 45, 1, 48, 0, "FLOAT"], [67, 44, 0, 49, 0, "MODEL"], [68, 45, 0, 49, 1, "CONDITIONING"], [69, 47, 0, 49, 2, "CONDITIONING"], [70, 48, 0, 49, 3, "LATENT"], [71, 49, 0, 50, 0, "LATENT"], [72, 46, 0, 50, 1, "VAE"], [80, 50, 0, 35, 0, "AUDIO"]], "id": "08882d3e-437d-43da-b498-083de04a60a6", "config": {}, "version": 0.4, "last_node_id": 67, "revision": 0}