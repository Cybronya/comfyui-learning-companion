ext"}, {"widget": {"name": "emo_text"}, "shape": 7, "name": "emo_text", "label": "emo_text", "type": "STRING", "localized_name": "emo_text"}, {"widget": {"name": "use_random"}, "shape": 7, "name": "use_random", "label": "use_random", "type": "BOOLEAN", "localized_name": "use_random"}, {"widget": {"name": "emo_alpha_s2"}, "shape": 7, "name": "emo_alpha_s2", "label": "emo_alpha_s2", "type": "FLOAT", "localized_name": "emo_alpha_s2"}, {"widget": {"name": "emo_vector_s2"}, "shape": 7, "name": "emo_vector_s2", "label": "emo_vector_s2", "type": "STRING", "localized_name": "emo_vector_s2"}, {"widget": {"name": "use_emo_text_s2"}, "shape": 7, "name": "use_emo_text_s2", "label": "use_emo_text_s2", "type": "BOOLEAN", "localized_name": "use_emo_text_s2"}, {"widget": {"name": "emo_text_s2"}, "shape": 7, "name": "emo_text_s2", "label": "emo_text_s2", "type": "STRING", "localized_name": "emo_text_s2"}, {"widget": {"name": "use_random_s2"}, "shape": 7, "name": "use_random_s2", "label": "use_random_s2", "type": "BOOLEAN", "localized_name": "use_random_s2"}], "flags": {}, "type": "IndexTTS2Run", "mode": 0, "bgcolor": "#355", "size": [400, 630], "pos": [1162.8768310546875, 282.0557861328125], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "IndexTTS2Run"}, "order": 4}, {"outputs": [], "color": "#233", "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 4, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "type": "SaveAudio", "mode": 0, "bgcolor": "#355", "size": [448.6551513671875, 245.041015625], "pos": [1634.3194580078125, 291.3177490234375], "id": 5, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 5}, {"outputs": [{"name": "AUDIO", "links": [1], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "color": "#233", "widgets_values": ["d83a5c9a2cd03f51f003ed7e42860d63df25f48e2e80ccd1fddc4a651c516f4d.wav", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadAudio", "mode": 0, "bgcolor": "#355", "size": [374.06475830078125, 165.85691833496094], "pos": [680.2584838867188, 1026.39453125], "id": 2, "properties": {"cnr_id": "comfy-core", "ver": "0.3.29", "widget_ue_connectable": {}, "Node name for S&R": "LoadAudio", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 3}, {"outputs": [{"name": "prompt", "links": [3], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#233", "widgets_values": ["[S1] 听说《封神2》把殷郊做成“蓝精灵”了？\n[S2] 是啊，导演说他“内心纯净”，所以干脆发蓝光，省得打灯。\n\n[S2] 那《歌手》请“断眉”来踢馆，你信？\n[S1] 信！只要他别坐飞机，万一“断”的是航班，直播就变《迷失》。\n\n[S1] 汪峰又发歌了，标题叫《就这样了吗》？\n[S2] 子怡姐朋友圈秒回：是的，就这样了，别再艾特我。\n\n[S2] 刘畊宏直播跳《本草纲目》跳成“本草刚目”，你怎么看？\n[S1] 我躺着看，动作刚目到把我腰也闪了，他赔医保吗？\n\n[S1] 周杰伦演唱会票你抢到了？\n[S2] 没，我抢到了“正在排队”的截图，已设为手机壁纸，天天看。\n\n[S2] 听说《庆余年2》范闲胖了十斤？\n[S1] 剧情需要，内库钱多，吃自助餐不收券，理解一下。\n\n[S1] 赵露思新剧滤镜厚到能防弹？\n[S2] 导演原话：现代戏用5G，古偶得用5G滤镜，不然观众认不出。\n\n[S2] 王一博被拍到骑摩托去买奶茶？\n[S1] 正常操作，他要是开直升机去买，那才叫“博”爱无边界。\n\n[S1] 李宇春官宣新专辑叫《无价之姐2025》？\n[S2] 价格已出：数字专辑3元，听完觉得自己无价，性价比宇宙第一。\n\n[S2] 虞书欣说自己“夹子音是天生的”？\n[S1] 我信，我夹核桃也是天生的，一夹就碎，比她音域还宽。\n\n[S1] 网传《长相思2》相柳结局加戏，变成“相柳·重生之我在海底开民宿”？\n[S2] 片方回应：海底房价低，环保题材，响应国家碳中和。\n\n[S2] 黄子韬直播卖牙刷，说“刷出老板气质”？\n[S1] 我下单了，刷完牙直接对老板翻白眼，果然底气更足。\n\n[S1] 张艺谋要拍《三体》电影，选角刘浩存演叶文洁？\n[S2] 观众建议：把“存”字去掉，留“浩”就行，毕竟宇宙浩瀚。\n\n[S2] 金晨回应“鼻子能开门”的梗，说那是“解锁未来”？\n[S1] 我试了下，手机Face ID真开了，金晨牌钥匙，你值得拥有。\n\n[S1] 白鹿张凌赫被拍一起买婚房？\n[S2] 中介爆料：他俩砍价用《周生如故》原声台词，中介听完直接哭，便宜20万。\n\n[S2] 网传《乘风破浪》下一季请“电子榨菜”做嘉宾？\n[S1] 是那位3分钟一剪的UP主吗？舞台表演：30秒换9个机位，观众还没眨眼就下班。\n\n[S1] 贾乃亮的直播带货GMV破亿，他说“离不开家人的支持”？\n[S2] 李小璐隔空点赞：加油，把甜馨的抚养费再带出来一倍。\n\n[S2] 范丞丞被问最想合作的演员，他说“想和姐姐合作”？\n[S1] 范冰冰：先把我从《逃税者联盟》里捞出来再议。\n\n[S1] 沈腾新电影《独行月球2》改名叫《独行月球·之我在月球还房贷》？\n[S2] 开心麻花：科幻接地气，让观众知道，连月球都限购一套。\n\n[S2] 最后一条，微博之夜主办方说“今年不走红毯，改走元宇宙”？\n[S1] 懂了，明星穿高定皮肤，摔了也不疼，就是怕服务器崩成“黑屏花瓶”。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#355", "size": [398.57208251953125, 504.1507873535156], "pos": [649.3646240234375, 448.4364013671875], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"outputs": [{"name": "AUDIO", "links": [2], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "color": "#233", "widgets_values": ["d85ce432f418efef0e2267a0485197b2a0464d5c1bf2d4dd98cbb9896a69484c.MP3", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadAudio", "mode": 0, "bgcolor": "#355", "size": [247.86474609375, 136], "pos": [701.9397583007812, 245.84024047851562], "id": 3, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 1}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1350.2264721761044, 176.8178104987207], "scale": 0.4090909090909096}