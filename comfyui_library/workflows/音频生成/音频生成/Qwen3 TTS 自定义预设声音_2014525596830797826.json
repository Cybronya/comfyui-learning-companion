4886474609375], "pos": [-110, 1750], "widgets_values": ["窗边的茉莉开了，淡淡的香飘得满屋子都是，闻着心里都软软的。我刚温了杯蜂蜜柚子茶，放了两勺你爱吃的蜂蜜，你尝尝看甜不甜。\n傍晚的云好软好软，像棉花糖似的，我们去楼下散散步吧，踩着夕阳慢慢走，路边的小花应该也开得正好呢，不急的。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 93, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 12}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [490.3858642578125, 129.12567138671875], "pos": [-640, 1750], "widgets_values": ["女性，25-35 岁，标准普通话轻柔尾调，中低音温婉柔和，暖心处尾音轻坠带暖意，舒缓偏慢语速，轻柔偏低音量，温润治愈软女声，声线细腻绵柔有温度，咬字清晰轻柔不生硬，流水式自然衔接，日常温柔恬静，语调平缓柔和，温润不甜腻"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 85, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 13}, {"outputs": [{"name": "text", "links": [89], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["外面起风了，你出门记得多带件外套。刚给你泡了杯热奶茶，放了喜欢的珍珠，趁热喝。等会儿我们去湖边走走吧，这会儿夕阳该很漂亮了，晚风也舒服，慢慢逛，不急的。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor": "#355", "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 1940], "id": 92, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 14}, {"outputs": [{"name": "text", "links": [98], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["男性，25-35 岁，标准普通话温和尾调，中低音温润醇厚，暖心处尾音轻沉带安抚感，舒缓平稳语速，轻柔偏低音量，温润治愈男声，声线干净柔软有厚度，咬字清晰轻柔不生硬，溪流式自然衔接，日常温和恬静，语调平缓柔和，温柔不油腻"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor": "#355", "size": [491.42999267578125, 138.0587921142578], "pos": [-640, 1950], "id": 84, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 15}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 2140], "widgets_values": ["嘿！你搞快点噻！说好的去逛小吃街，你磨磨蹭蹭的干啥子嘛！那家冰粉加糍粑超好吃，去晚了队都排到街尾了！快走快走，莫等会儿又喊我帮你带，我才不得管你哦，再拖我可就自己先冲啦！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 91, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 16}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [490.3858642578125, 129.12567138671875], "pos": [-640, 2140], "widgets_values": ["女性，18-25 岁，地道方言清甜尾调，中高音明快灵动，俏皮处尾音轻翘带娇憨，轻快流畅语速，清亮适中音量，元气甜妹方言音，声线清甜透亮有活力，咬字带方言软糯感，跳脱式自然衔接，日常活泼俏皮，语调明快上扬，甜而不齁"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 80, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 17}, {"outputs": [{"name": "text", "links": [91], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["嘿哟！今儿个这天儿硬是安逸得板！我刚在巷口子买了支冰糕，咬一口凉飕飕甜咪咪的，简直巴适惨了！\n跟你说嘛，下午坝坝头有人约到打球，三缺一就差你一个了！搞快点收拾收拾，咱一块儿切耍，去晚了位置都莫得了，走了走了！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor": "#355", "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 2340], "id": 90, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 18}, {"outputs": [{"name": "text", "links": [100], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["男性,18-25岁,地道方言爽朗尾调,中高音清亮有活力,调侃处尾音轻拐带俏皮,轻快利落语速,清亮适中音量,元气少年方言音,声线干净爽朗有朝气,咬字带方言利落感,跳跃式自然衔接,日常阳光开朗,语调明快上扬,清爽不聒噪"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor": "#355", "size": [490.3858642578125, 129.12567138671875], "pos": [-640, 2350], "id": 82, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 19}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 2540], "widgets_values": ["嘿，哥们儿！今天这天气简直绝了，阳光晒得人浑身都舒坦！我刚路过楼下的便利店，买了瓶冰汽水，一口下去，爽到飞起！\n对了，下午公园有飞盘局，好多朋友都来，你要不要一起？咱们一块儿跑一跑、闹一闹，保证玩得超嗨！走啦走啦，别磨蹭了！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 89, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 20}, {"outputs": [{"name": "text", "links": [93], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["哇，今天天气也太好了吧！你看那边的花，开得好漂亮呀！我刚才路过街角的咖啡店，闻到好香的面包味儿，忍不住买了一个牛角包，咬一口酥酥的，超好吃！\n等下我们去公园散步好不好？听说那里有小猫咪，我想跟它们玩一会儿，你陪我一起去吧，走吧走吧！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor": "#355", "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 2740], "id": 88, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 21}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 2950], "widgets_values": [" 咳，这天儿可真是不赖！晒得人浑身暖烘烘的。搬个小马扎儿往院里一坐，泡上一壶热茶，听着外头的蝉鸣儿，别提多自在了。\n你瞅那墙头儿上的丝瓜藤，都爬到隔壁院儿去了，过不了几天就得结出嫩生生的丝瓜来。\n巷口那家卖烧饼的铺子，刚出炉的芝麻烧饼，香飘得老远，咬一口酥掉渣儿。得，别在这儿愣着了，揣上俩钢镚儿，买俩烧饼去，走着！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 87, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 22}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [490.3858642578125, 129.12567138671875], "pos": [-640, 2960], "widgets_values": ["男性，55-65 岁，标准普通话醇厚尾调，中低音粗粝沙哑，叮嘱处尾音轻沉带关切感，舒缓偏慢语速，温和偏低音量，沧桑沙哑叔音，声线沙哑有颗粒感带胸腔共鸣，咬字清晰带沉稳顿挫感，唠嗑式自然衔接，日常慈祥亲切，语调平缓厚重，朴实不拖沓"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 78, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 23}, {"outputs": [{"name": "text", "links": [95], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["哎哟喂，这天儿可真够舒坦的！溜溜达达逛这胡同儿，墙根儿底下的老槐树都发新芽儿了，枝桠子上还挂着俩鸟笼儿，大爷正眯着眼逗鸟儿呢。瞅见没，那头的小卖部儿还开着呢，小时候总攥着钢镚儿买糖豆儿，一毛钱能嘬半天儿。\n前头拐弯儿有个早点摊儿，豆腐脑儿配油条，再来碟儿小咸菜，那味儿绝了！得，今儿个就奔那儿了，走着您内！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor": "#355", "size": [489.2257080078125, 154.64886474609375], "pos": [-110, 3160], "id": 86, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 24}, {"outputs": [{"name": "text", "links": [104], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["男性，28-38 岁，地道北京话自然儿化音，中低音沉稳磁性，调侃尾音轻拐带痞气，从容适中语速，温和偏低音量，京腔痞帅晨起微哑，胸腔共鸣声线厚实有弹性，京味儿咬字清晰，唠嗑式流畅衔接，晨起松弛痞帅调侃，平缓慵懒语调，贫嘴不油腻"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 4, "bgcolor":