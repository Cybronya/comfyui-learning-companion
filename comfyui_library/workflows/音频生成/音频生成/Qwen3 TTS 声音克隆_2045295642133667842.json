ime", "type": "STRING", "localized_name": "end_time"}], "flags": {}, "id": 3, "type": "AudioCrop", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AudioCrop"}, "order": 3}, {"mode": 0, "outputs": [], "size": [270, 112], "pos": [1961.175537109375, 226.9156951904297], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 4, "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 2, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 7}, {"mode": 0, "outputs": [{"name": "text", "links": [9], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [429.6491394042969, 450.8773193359375], "pos": [1071.31396484375, 232.04736328125], "widgets_values": ["现在两根金条放在这儿，你告诉我，哪一根是高尚的，哪一根是龌龊的？谁能告诉我？没人能。它们都是一样的，都是金子。我信仰什么？我信仰生存主义。我劝你也早点信这个。现在这个世道，活着比什么都重要。只要能活着，只要能赚钱，什么主义都是狗屁。你看看那些嘴上喊着主义的人，哪个不是背地里捞钱捞得比谁都凶？\n这个世界上没有谁生来就是坏人，我也曾经是个满腔热血的青年，我也想凭着一身本事堂堂正正地站在阳光下。可现实给了我什么？是无尽的打压，是冰冷的规则，是出身决定一切的残酷。我拼了命地学习，拼了命地工作，可到头来，还是抵不过别人一句轻飘飘的关系。我不甘心，我不服气！我凭什么要被命运踩在脚下？我要胜天半子！哪怕这条路布满鲜血，哪怕最后粉身碎骨，我也要往上爬。你们可以骂我贪婪、骂我恶毒，可你们谁又真正懂过我？你们站在道德高地上指责我，不过是因为你们生来就拥有我穷尽一生都得不到的东西。这个世界本就不公，那我就用自己的方式，夺回属于我的一切。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 10, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 2}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-787.595004163039, -160.02022563554587], "scale": 1.1671841070450024}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Qwen3 TTS 声音克隆", "bounding": [464.1903381347656, 133.79505920410156, 1791.2825927734375, 763.6166992