{"last_link_id": 6, "nodes": [{"mode": 0, "outputs": [{"name": "AUDIO", "links": [6], "label": "音频", "type": "AUDIO", "localized_name": "音频"}], "size": [270, 136], "pos": [-235.5362548828125, 81.27415466308594], "widgets_values": ["807dac300db6e9ebf1eeca9f9f614691d5d41e511d891c34e638c69e6b463df0.MP3", null, ""], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 5, "type": "LoadAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 0}, {"mode": 0, "outputs": [], "size": [270, 112], "pos": [606.9136352539062, 121.52326965332031], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 1, "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 2, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 3}, {"mode": 0, "outputs": [{"name": "STRING", "links": [5], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 200], "pos": [-330.4668273925781, 288.9071044921875], "widgets_values": ["Speaker 1: 看《生万物》，最让我心绪久久不能平复的，是封大脚与宁绣绣的故事。那不是一场轰轰烈烈的浪漫，而是一段在泥土与风雨中生长的情感，如同麦苗，质朴却坚韧。\n\n宁绣绣，本该在家族的安排中安稳度日，却在命运的转折里，被推向陌生的土地。起初的不甘与抗拒，像是一朵离了根的花，在风中摇摆。而封大脚——一个与土地紧密相连的男人，他的背影里有厚重的黄土气息，也有不言而喻的担当。两人的相遇，像是不期而至的雨，打乱了旧有的轨迹，却悄然滋养了新的生机。\n\n在相依相伴的岁月里，宁绣绣学会了理解土地、守护乡亲，也终于学会了理解自己。她从依赖走向独立，从柔弱走向坚毅。封大脚则在宁绣绣的陪伴中，明白了自己不只是泥土的守望者，更是一个能撑起家庭与希望的男人。\n\n“寻你”，是他们在对方身上发现归属；“见己”，则是他们在彼此的映照中，照见了最真实的自己。\n\n这段爱情让我想到：真正的相遇，不是彼此成全于一时的浪漫，而是在日复一日的陪伴与守望中，让生命焕发新的力量。\n\n《生万物》用他们的故事告诉我们——爱情的意义，不在于改变世界，而在于你我之间那份深切的理解与坚守。\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "id": 3, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 1}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [1], "label": "AUDIO", "type": "AUDIO", "localized_name": "音频"}], "size": [400, 436], "pos": [141.40968322753906, 125.95088195800781], "widgets_values": ["VibeVoice-1.5B", "Speaker 1: Hello from ComfyUI!\nSpeaker 2: VibeVoice sounds amazing.", false, "flash_attention_2", 1.3, 10, 801437995552682, "randomize", true, 0.95, 0.95, 0, false], "inputs": [{"shape": 7, "name": "speaker_1_voice", "link": 6, "label": "speaker_1_voice", "type": "AUDIO", "localized_name": "speaker_1_voice"}, {"shape": 7, "name": "speaker_2_voice", "label": "speaker_2_voice", "type": "AUDIO", "localized_name": "speaker_2_voice"}, {"shape": 7, "name": "speaker_3_voice", "label": "speaker_3_voice", "type": "AUDIO", "localized_name": "speaker_3_voice"}, {"shape": 7, "name": "speaker_4_voice", "label": "speaker_4_voice", "type": "AUDIO", "localized_name": "speaker_4_voice"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "text"}, "name": "text", "link": 5, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "quantize_llm_4bit"}, "name": "quantize_llm_4bit", "label": "quantize_llm_4bit", "type": "BOOLEAN", "localized_name": "quantize_llm_4bit"}, {"widget": {"name": "attention_mode"}, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}, {"widget": {"name": "inference_steps"}, "name": "inference_steps", "label": "inference_steps", "type": "INT", "localiz