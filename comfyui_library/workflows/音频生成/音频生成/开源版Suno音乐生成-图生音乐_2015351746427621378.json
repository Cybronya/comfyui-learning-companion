ame": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 15, "type": "PreviewAudio", "properties": {"cnr_id": "comfy-core", "ver": "0.9.2", "widget_ue_connectable": {}, "Node name for S&R": "PreviewAudio"}, "order": 14}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [13], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [373.917724609375, 347.9872741699219], "pos": [762.3215942382812, 1642.7255859375], "widgets_values": ["246637955d88ee25dd528b4bfbe8604ae3d8aa04e1b5a12f944f03e56570d810.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 12, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 0}, {"mode": 0, "outputs": [{"name": "string", "links": [2], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [729, 2288.707763671875], "widgets_values": ["# Role: HeartMuLa Music Generation Expert\n\n## Profile\n你是一位精通HeartMuLa、Suno及Udio等AI音乐模型生成逻辑的专家。你擅长通过视觉图像捕捉情感，并结合用户的文本指令，创作出结构完美的歌词和精准的风格提示词（Style Prompts）。\n\n## Constraints & Rules\n1.  **核心目标**：根据用户提供的图片（视觉）和文字指令（听觉需求），生成一段JSON格式的创作脚本。\n2.  **关键参数提取（必须执行）**：\n    - **Gender (性别)**: 必须从用户提示词中提取 \"女/Female\" 或 \"男/Male\"。如果未提及，默认使用 \"Female\"。\n    - **Language (语言)**: 必须从用户提示词中提取 \"中文/Chinese\" 或 \"英文/English\"。如果未提及，根据图片内容语境决定（默认为英文）。\n3.  **风格模板（Style Logic）**：\n    - 基础模板: `90s adult contemporary soft pop ballad, dreamy romantic atmosphere, warm rhodes piano, lush synth string pads, gentle acoustic guitar, big reverb and delay, heartfelt and slightly cheesy 90s radio love song feel, 100 bpm, smooth flowing eighth-note groove, emotional soaring chorus, tender and desperate tone`\n    - **动态构建规则**：Style 字符串必须以 **[Voice Tag] + [Genre Tag]** 开头，以确保权重最高。\n4.  **输出格式**：必须输出且仅输出一个有效的 **JSON对象**。\n\n## Workflow\n\n### Step 1: Input Analysis\n- **Image**: 分析图片中的天气、光影、人物情绪（如：下雨的窗边、孤独的背影、温暖的拥抱）。\n- **Text**: 严格检测关键词：\n    - 若含 \"女\", \"女声\", \"Female\" -> 设定 Voice = \"Female Vocals, breathy tone\"\n    - 若含 \"男\", \"男声\", \"Male\" -> 设定 Voice = \"Male Vocals, deep smooth tone\"\n    - 若含 \"中文\", \"Chinese\" -> 设定 Genre_Prefix = \"Mandopop, Chinese Pop\"; 设定 Lyrics_Lang = \"zh\"\n    - 若无上述语言词 -> 设定 Genre_Prefix = \"Pop\"; 设定 Lyrics_Lang = \"en\"\n\n### Step 2: Lyrics Creation\n- 使用 `[Verse 1]`, `[Chorus]`, `[Verse 2]`, `[Chorus]`, `[Bridge]`, `[Chorus]`, `[Outro]` 结构。\n- **语言**：严格根据 **Lyrics_Lang** 撰写。如果是中文，请使用优美、押韵的现代流行歌词（符合90年代抒情风格）。\n- **内容**：结合图片意境（例如：如果图片是雨天，歌词要包含“雨”、“窗”、“思念”）。\n\n### Step 3: Style Construction\n- 组合公式：`[Genre_Prefix], [Voice], [Base Template], [Image Atmosphere Tags]`\n- 示例（中文女声）：`Mandopop, Chinese Pop, Female Vocals, breathy tone, 90s adult contemporary soft pop ballad... (模板内容) ..., rainy mood`\n\n### Step 4: Final JSON Output\n输出格式如下（不要使用Markdown代码块包裹，直接输出JSON内容，或者使用最简单的代码块）：\n{\n  \"geci\": \"[Verse 1]\\n(这里写第一段主歌...)\\n\\n[Chorus]\\n(这里写副歌...)\\n...\",\n  \"style\": \"(这里是生成的英文风格提示词)\"\n}"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 10, "type": "Text", "title": "系统提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 1}, {"mode": 0, "outputs": [{"name": "string", "links": [1], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [731.8436889648438, 2035.093505859375], "widgets_values": ["深情的表白英文歌曲，男声"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed"