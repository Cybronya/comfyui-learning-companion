{"last_link_id": 19, "nodes": [{"outputs": [{"name": "output", "type": "*", "localized_name": "output"}], "color": "#2a363b", "widgets_values": ["这是一个正处于变声期边缘的十二岁青少年男性，声带黏膜正经历着剧烈的生理重组。他的嗓音底色依然保留着孩童尚未褪去的清透头腔共鸣，但喉头肌肉的紧绷使得音色中被迫揉入了一丝粗糙的沙哑与极不稳定的摩擦感。他迫切渴望被当作真正的成年人对待，强作镇定的心理潜台词导致他发声时刻意压低喉位寻找胸腔支撑，咬字时唇齿音发力过猛，语速带着一种急于证明自己的急促与攻击性。由于肺活量与声带闭合能力的脱节，他在句子前半段往往爆发出虚张声势的饱满音量，而在句尾却因气流迅速枯竭暴露出不可控的细微气颤，甚至在情绪激动的重音上会出现短促尴尬的破音。这种伪装成熟却被青涩生理条件撕裂的发声状态，彻底出卖了他敏感、局促且极度倔强的灵魂。"], "inputs": [{"shape": 7, "name": "anything", "link": 9, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#3f5159", "size": [365.66632080078125, 216.44024658203125], "pos": [335.8399658203125, 1036.083984375], "id": 10, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 7}, {"outputs": [], "color": "#322", "widgets_values": ["", "角色音色提示词"], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 18, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "output_name"}, "name": "output_name", "label": "output_name", "type": "STRING", "localized_name": "output_name"}], "flags": {"collapsed": false}, "type": "ShellAgentPluginOutputText", "mode": 0, "bgcolor": "#533", "size": [351.9983215332031, 82], "pos": [345.73626708984375, 1307.3536376953125], "id": 21, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShellAgentPluginOutputText"}, "order": 9}, {"outputs": [], "color": "#322", "widgets_values": ["角色配音"], "inputs": [{"name": "audio", "link": 8, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "type": "SaveAudio", "mode": 0, "bgcolor": "#533", "size": [412.80987548828125, 124.8