播音腔\n[singing]  -歌唱/吟唱       [with strong accent]  -浓重口音\n\n表达：\n[moaning]  -呻吟                [panting]  -喘息/气喘\n[echo]  -带回声效果            [pitch up]  -音调升高\n[pitch down]  -音调降低\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#355", "size": [316.3758544921875, 494.8260803222656], "pos": [1676.5562744140625, 74.13557434082031], "id": 29, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}, {"outputs": [{"name": "text", "links": [63], "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "segments_alignment", "label": "segments_alignment", "type": "whisper_alignment", "localized_name": "segments_alignment"}, {"name": "words_alignment", "label": "words_alignment", "type": "whisper_alignment", "localized_name": "words_alignment"}], "color": "#223", "widgets_values": ["whisper-large-v3", "auto"], "inputs": [{"name": "audio", "link": 5, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "language"}, "shape": 7, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "type": "Apply Whisper", "mode": 0, "bgcolor": "#335", "size": [270, 146], "pos": [472.8510437011719, 62.13452911376953], "id": 6, "properties": {"cnr_id": "ComfyUI-Whisper", "ver": "c67c040559c013833dedb0737df14182dc5043cc", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "Apply Whisper"}, "order": 11}, {"outputs": [{"name": "text", "links": [64], "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "segments_alignment", "label": "segments_alignment", "type": "whisper_alignment", "localized_name":