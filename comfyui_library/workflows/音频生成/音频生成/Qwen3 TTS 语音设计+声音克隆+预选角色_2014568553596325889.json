ioUI": true}, "Node name for S&R": "SaveAudio"}, "order": 20}, {"outputs": [], "color": "#323", "widgets_values": ["## [Qwen3-TTS全家桶开源: 语音设计，克隆与生成！](https://qwen.ai/blog?id=qwen3tts-0115)\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Model links", "mode": 0, "bgcolor": "#535", "size": [360, 90], "pos": [460, 1180], "id": 42, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 3}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 140], "pos": [1370, 1370], "widgets_values": ["三月的天气万物拂苏秦川八百里绿柳成行是风景如画"], "inputs": [{"name": "text", "link": 16, "label": "文本", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "id": 21, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 21}, {"outputs": [], "color": "#c09430", "widgets_values": ["## 这里是把原语音转成文字做参考的节点，不行就节点删掉手动输入参考语音文字"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [300, 88], "pos": [1340, 1190], "id": 26, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}}, "order": 4}, {"outputs": [{"name": "text", "links": [34], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#257e25", "widgets_values": ["话说这江湖之上，卧虎藏龙，能人异士数不胜数。今儿个咱说的这位，姓周名桐，字伯龄，祖籍陕西凤翔府，那可是一身好武艺，掌中一杆亮银枪，耍起来神出鬼没，枪尖挑风，能落九天星斗，枪杆扫影，可挡万马千军。这一日，周桐途经山东郓城地界，行至一处山岗，忽听得林子里一声断喝：“此山是我开，此树是我栽，要从此处过，留下买路财！” 声如炸雷，震得树叶簌簌落。周桐勒住马缰，抬眼观瞧，只见林子里闯出七八条大汉，个个面生横肉，腰挎钢刀，为首的那黑汉，身高八尺，虎背熊腰，手使一柄开山斧，横眉立目，堵在路中。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 2, "bgcolor": "#174f17", "size": [460, 330], "pos": [910, 1660], "id": 25, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 5}, {"outputs": [{"name": "text", "links": [35], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#257d7e", "widgets_values": ["单田芳“云遮月” 的沙哑沧桑音色，扁而微嘶却透着浑厚劲道，还自然融入爽朗诙谐的东北口音，口语化特质鲜明；声音运用上节奏抑扬顿挫、快慢有致，能根据不同角色精准切换语气，武将豪迈、文人温润、少女娇俏，同时善用喉间口技、鼻腔发音辅助演绎，贯口字字清晰、停顿恰到好处，可借声音的高低轻重营造不同场景氛围，整体辨识度极强，兼具江湖气与接地气的独特质感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 2, "bgcolor": "#174e4f", "size": [460, 210], "pos": [910, 2070], "id": 24, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 6}, {"outputs": [{"name": "text", "links": [38], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#257e25", "widgets_values": ["中国有句古话，识时务者为俊杰，你的明白？\n土豆哪里挖，土豆地里挖，一挖一麻袋！八嘎！你的什么的干活？\n哟西，花姑娘！死啦死啦滴！你滴，皇军优待优待！"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 2, "bgcolor": "#174f17", "size": [460, 260], "pos": [920, 2460], "