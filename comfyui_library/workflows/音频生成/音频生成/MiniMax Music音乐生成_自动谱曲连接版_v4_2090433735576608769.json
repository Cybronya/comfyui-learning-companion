l / emotional / touching 等空形容。\n- 不输出歌词内容、标题、Markdown、代码块、解释说明。\n- 输出语言：英文。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 59, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 5}, {"mode": 0, "showAdvanced": true, "outputs": [{"name": "CONDITIONING", "links": [47, 44], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}, {"name": "seconds", "links": [45], "label": "seconds", "type": "FLOAT", "localized_name": "seconds"}], "size": [423.6206359863281, 387.63214111328125], "pos": [2744.94189453125, 208.01226806640625], "widgets_values": ["", "", 222, "fixed", 60, 1.7, 50], "inputs": [{"name": "clip", "link": 43, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "caption"}, "name": "caption", "link": 86, "label": "caption", "type": "STRING", "localized_name": "caption"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "link": 83, "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "seed"}, "name": "seed", "link": 55, "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_duration"}, "name": "max_duration", "link": 70, "label": "max_duration", "type": "FLOAT", "localized_name": "max_duration"}, {"widget": {"name": "cfg_scale"}, "name": "cfg_scale", "label": "cfg_scale", "type": "FLOAT", "localized_name": "cfg_scale"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}], "flags": {}, "id": 42, "type": "MiniMaxMusic3TextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {}, "Node name for S&R": "MiniMaxMusic3TextEncode"}, "order": 13}, {"outputs": [{"name": "response", "links": [83, 94], "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["google/gemini-3.