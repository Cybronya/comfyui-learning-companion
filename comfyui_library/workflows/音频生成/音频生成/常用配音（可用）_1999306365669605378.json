5527344, 442.932861328125], "pos": [765.7245483398438, 405.6016540527344], "widgets_values": ["a47a6fdd1bbf5c95e45d562cb99d900a5bc69fb2d7497768d243e7416382e4a7.wav", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 3, "type": "LoadAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 11}, {"mode": 0, "outputs": [{"name": "text", "links": [8], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [298.7720642089844, 378.6213073730469], "pos": [1153.88818359375, 651.1160278320312], "widgets_values": ["‌中铁十六局集团有限公司承建的侨城东路北延通道二标段一工区位于深圳市龙华区、南山区境内，全长3.474公里，区段内主体工程为3#隧道及宝鹏地下立交体隧道群，合同工期1891天。\n为满足隧道工程需要，区段内设钢构件加工厂一座，位于RK4+100约150米处，占地4800平方米。钢构件加工厂配有激光自动剪板线、六臂机器人钢拱架生产线、数控全自动网片焊接生产线及数控小导管生产线等先进设备，达到钢构件“数字化、智能化、标准化”智能建造标杆。\n1、光纤激光自动剪板系统：集成钢板智能分布算法，自动规划切割路径和顺序，实现从原料上料到型钢连接钢板成型全程自动化作业，整条生产线仅需1人操控即可。该生产线可自动完成0.5～50毫米钢板切割，八小时产量突破450块，效率与精度显著优于传统施工。\n2、金三立GSZS-220Ⅲ型隧道钢拱架智能生产系统：集成型钢智能冷弯成型、数控切割下料、拱架连接钢板激光自动寻边定位及四台机器人协同双面焊接技术，实现从型钢原料下料到钢拱架成型的全程自动化作业，整条生产线仅需1人操控即可，可节约大量劳动力。该生产线全面兼容“I14”至“I25b”（“工14”至“工25B”）型钢拱架及H型钢。单节型钢拱架加工仅7-8分钟，八小时产量达68节，可满足超多工作面施工需求。\n3、耿力GL-HW2300Z数控全自动网片焊接生产线：集盘圆钢筋自动调直网片智能焊接、数控切割技术于一身，实现从原料上料到成品下料全程自动化作业，整条生产线仅需1人操控即可。该生产线适用于10×10厘米至25×25厘米标准网格间距，最大加工宽度1.6米，焊接速度25-45排/分钟，八小时产量突破800片，可满足超多工作面与不同衬砌类型支护需求。\n4、耿力GLGSCX-50S数控小导管切割孔智能生产线：通过预设程序，实现自动上料、精准割孔、智能翻面及缩尖，整条生产线仅需1人即可全流程操控。该生产线可完成42～50毫米直径的小导管的割孔、缩尖一体化加工，单根导管生产周期50～79秒，八小时产量达400根，较传统工艺效率提升5倍，为隧道支护提供坚实保障。\n‌    同时，为确保钢构件质量，配置专业质检工程师，验收合格后方可出厂，为实体质量保驾护航。\n“责任重于能力、意志创造奇迹”，项目部将以智能建造技术为引领，以毫米级精度、零缺陷标准锻造行业示范工程，坚持高起点规划、高标准管控、高效率推进，全力冲刺国家优质工程，匠心筑造百年品质工程，为城市发展注入永恒动能！\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 6, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 12}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-754.5017147151053, -606.8496456649306], "scale": 1.1671841070450009}}, "groups": [], "links": [[5, 3, 0, 8, 0, "AUDIO"], [7, 9, 0, 8, 1, "INDEXTTS2_MODEL"], [8, 6, 0, 8, 2, "STRING"], [9, 8, 0, 1, 0, "AUDIO"], [10, 13, 0, 8, 14, "FLOAT"], [11, 15, 0, 8, 15, "FLOAT"], [12, 14, 0, 8, 16, "FLOAT"], [13, 16, 0, 8, 17, "FLOAT"], [14, 17, 0, 8, 18, "FLOAT"], [15, 18, 0, 8, 19, "FLOAT"], [16, 19, 0, 8, 20, "FLOAT"], [17, 20, 0, 8, 13, "STRING"], [19, 27, 0, 8, 6, "FLOAT"], [20, 28, 0, 8, 21, "FLOAT"]], "id": "a325ab52-b7cb-4f27-8fa1-2e58f89921ce", "config": {}, "version": 0.4, "last_node_id": 28, "revision": 0}