ectable": {}, "Node name for S&R": "HeartMuLa_Generate"}, "order": 5}, {"mode": 0, "outputs": [], "size": [270, 112], "pos": [-3284.9609375, -451.3191833496094], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 280, "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 134, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 6}, {"mode": 0, "outputs": [{"name": "text", "links": [279], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [342.982421875, 501.6747741699219], "pos": [-4593.32470703125, -466.5386962890625], "widgets_values": ["[Intro]\n残阳在废墟缝隙里生根\n风卷起尘埃 吻过旧伤痕\n我们靠在一起 听冰层裂缝的声音\n\n[Verse]\n那些年 挤在潮湿的地下室\n一碗热汤 交换过 彼此的 名字\n手心的茧 记录着 卑微的 坚持\n现实 像钝重的 剪刀 裁剪着 日志\n\n[Prechorus]\n脚下的路 泥泞得 没过 膝盖\n眼角的泪 滚烫过 那个 时代\n\n[Chorus]\n就算这 世界 给过 太多 痛处\n我们 依然在 废墟 种下 楠木\n爱是 伤口 结痂后 坚硬的 皮肤\n每步 维艰 却走得 义无反顾\n\n[Verse]\n你看那 墙角 斑驳的 霉斑\n也曾 见证过 彻夜 难眠的 辛酸\n把梦 揉碎 铺成 登顶的 阶砖\n既然 没退路 就把 软弱 都 烧断\n\n[Prechorus]\n寒蝉 鸣过 最后一季 凛冬\n远方 亮起 照进 命中的 霓虹\n\n[Chorus]\n哪怕这 命运 满是 刻薄 变数\n我们 依然在 逆风 寻找 归途\n爱是 寒夜 熹微里 点亮的 蜡烛\n照破 苍茫 却依旧 滚烫 如初\n\n[Bridge]\n那些 嘲笑声 终于 被甩在 山谷\n那些 苦涩味 酿成 最醇的 烈酒\n如果不曾 坠落 哪来 飞翔的 自由\n\n[Chorus]\n直到这 苦难 终被 岁月 宽恕\n我们 挺起胸 迎接 最终 胜负\n爱是 绝境 逢生时 爆发的 欢呼\n穿越 荒芜 去亲吻 满山 的红土\n\n[Outro]\n天快亮了 雾快散了\n你看 我们的 影子 重叠了\n走吧 去那 没去过的 远方 唱歌\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 129, "type": "CR Text", "title": "手动输入歌词，符合下边的这种格式", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}], "extra": {"links_added_by_ue": [], "0246.VERSION": [0, 0, 4], "reroutes": [{"linkIds": [], "pos": [-3398