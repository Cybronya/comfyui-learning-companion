，举手投足间自带威严与从容。\n性格特质：意志如钢，信念坚定，面对挑战从不退缩；胸怀家国，心系民族未来，将个人命运与国家兴衰紧密相连；严谨自律，言出必行，话语中充满责任感与历史担当；外冷内热，表面严肃，实则对后辈寄予厚望，甘为人梯。\n人生信条：“我们这一代人，不是为了站在光里，而是为了把路铺到光里。”", "1.7B", "auto", "bf16", "Chinese", 526555453414516, "randomize", 2048, 0.8, 20, 1, 1.05, "auto", false], "inputs": [{"shape": 7, "name": "config", "label": "config", "type": "TTS_CONFIG", "localized_name": "config"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "instruct"}, "name": "instruct", "label": "instruct", "type": "STRING", "localized_name": "instruct"}, {"widget": {"name": "model_choice"}, "name": "model_choice", "label": "model_choice", "type": "COMBO", "localized_name": "model_choice"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "precision"}, "name": "precision", "label": "precision", "type": "COMBO", "localized_name": "precision"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_new_tokens"}, "shape": 7, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "top_p"}, "shape": 7, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "top_k"}, "shape": 7, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "temperature"}, "shape": 7, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "repetition_penalty"}, "shape": 7, "name": "repetition_penalty", "label": "repetition_penalty", "type": "FLOAT", "localized_name": "repetition_penalty"}, {"widget": {"name": "attention"}, "shape": 7, "name": "attention