, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#593930", "size": [270, 106], "pos": [-1048.914306640625, 652.4230346679688], "id": 265, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 2}, {"outputs": [{"name": "output", "links": [397], "label": "output", "type": "*", "localized_name": "output"}], "color": "#432", "widgets_values": ["银辉仙子立于古刹石阶之上，长发如瀑垂落，头顶火焰纹饰冠冕镶嵌三颗幽蓝宝石，流苏轻垂，与颈间多层珠链相映生辉。她身着一袭银灰渐变长袍，外披薄纱流云披风，衣纹如水波荡漾，腰间束带缀有蓝宝石与银铃，随风轻摆。右手轻抬，似欲抚尘，左手垂落，姿态优雅从容。衣袂飘然，如仙气缭绕，脚下青石板路被花瓣轻覆，粉瓣如蝶纷飞，或飘于空中，或落于地面，营造出梦幻般的静谧氛围。\n\n前景以花瓣飘落为视觉焦点，花瓣呈半透明质感，边缘柔和，色彩由浅粉至淡紫渐变，部分花瓣聚焦于人物脚边，部分悬浮于半空，形成动态层次。中景为人物主体，占据画面中心，构图采用中心对称，人物正对观者，目光沉静而深邃，面部轮廓柔和，眉眼如画，唇色淡雅，肌肤泛着冷光，仿佛冰晶凝成，与银衣相得益彰。背景为深蓝古刹建筑，拱门高耸，石柱雕花繁复，两侧灯笼微光摇曳，远处隐约可见飞檐斗拱，整体色调偏冷，以深灰、靛蓝、银白为主，衬托出人物的神圣与超凡。\n\n光影处理极具戏剧性，主光源来自人物左上方，柔和光束穿透衣料，勾勒出金属光泽与丝绸质感，衣褶处形成明暗对比，增强立体感。背景则采用渐隐式虚化，仅保留建筑轮廓，使视觉焦点牢牢锁定于人物。整体氛围静谧神秘，兼具东方仙侠美学与现代数字渲染的精致感，仿佛置身于神话传说中的仙宫秘境，令人屏息凝神。\n\n提示词如下：\n一位银衣仙子立于古刹石阶，头戴火焰纹冠冕，冠冕嵌三颗蓝宝石，颈饰多层珠链，身披薄纱流云披风，衣纹如水波，腰带缀蓝宝石与银铃，右手轻抬，左手垂落，姿态优雅。背景为深蓝古刹建筑，拱门高耸，石柱雕花繁复，灯笼微光摇曳。前景花瓣飘落，半透明粉瓣纷飞，部分落于石阶，部分悬浮空中。光影柔和，主光源自左上方穿透衣料，勾勒金属光泽与丝绸质感，背景虚化，突出人物神圣感。整体氛围静谧神秘，如仙宫秘境，东方仙侠美学与现代渲染结合，视觉焦点集中于人物，构图中心对称，色彩冷调以银灰、靛蓝、淡粉为主，营造梦幻超凡之感。"], "inputs": [{"shape": 7, "name": "anything", "link": 395, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#653", "size": [323.5193176269531, 363.92364501953125], "pos": [-1802.68505859375, 449.392333984375], "id": 258, "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 9}, 