e6903eff274a50f8b5cd768f0f96baf37baea1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"string": true}, "Node name for S&R": "String Literal"}, "order": 20}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [10, 11, 48], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [270, 60], "pos": [3720, -850], "widgets_values": [], "inputs": [{"name": "samples", "link": 3, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 4, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 6, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 32}, {"mode": 0, "outputs": [{"name": "output", "type": "*", "localized_name": "output"}], "size": [210, 280], "pos": [3030, 60], "widgets_values": ["一位拥有尖耳朵的年轻精灵少女，面容精致甜美，眼神清澈深邃，皮肤白皙细腻。她穿着一套华丽夺目的银色亮片比基尼，上衣点缀着璀璨的水晶和珍珠，呈现出流光溢彩的质感；下身搭配着同款材质的镂空装饰裙摆，极具设计感与层次感，展现出曼妙的身材曲线。她腿部穿着洁白的过膝丝袜，边缘带有精致的蕾丝花边。场景设定在一个梦幻奇幻的洞穴之中，背景是如白练般倾泻而下的瀑布，水汽氤氲，光影交错。周围环绕着闪烁的晶体和发光的植物，营造出一种神秘且唯美的氛围。画面采用全景构图，视角平视，利用瀑布形成的垂直线条与洞穴结构构成引导线，焦点清晰地落在人物身上，背景带有柔和的景深虚化效果。自然光从洞穴上方洒下，与晶体反射出的点点微光交织，营造出明亮且充满魔幻色彩的光照环境。"], "inputs": [{"shape": 7, "name": "anything", "link": 5, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": true}, "id": 7, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 22}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [3], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [320, 720], "pos": [3690, -700], "widgets_val