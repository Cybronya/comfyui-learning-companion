ersion": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 15}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#233", "widgets_values": ["Work-Fisher"], "inputs": [{"name": "images", "link": 85, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#355", "size": [619.7988891601562, 790.659912109375], "pos": [3023.487548828125, 1128.0257568359375], "id": 58, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 21}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [450.5723876953125, 733.4381713867188], "pos": [2501.72265625, 271.03753662109375], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 41, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 27, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.16.3", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 16}, {"outputs": [{"name": "text", "links": [102], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["【场景背景】：一艘白色豪华游艇的尾甲板日光浴区。右侧是环绕式白色皮革沙发，靠垫蓬松柔软，表面有自然的压痕和褶皱。左侧是抛光柚木甲板，远处可见不锈钢护栏和游艇的流畅白色船体边缘。背景是一望无际的蔚蓝大海——海面平静，有细波反射着正午的阳光，如碎银一般。海平线水平横贯画面中部偏上，上方是明亮的蓝色天空，几朵蓬松的白云慵懒地悬浮着。整个场景通透、干净、充满负空间。\n\n【主体】：年轻东亚女性侧卧在白色沙发垫上——不是刻意摆拍，更接近于\"看书看到一半停下来喝香槟\"的松弛瞬间。她身着一条白色宽松亚麻连衣裙——中袖、V领但不过深、裙摆到小腿，亚麻材质带有自然微皱的纹理感。墨镜推到头顶，深棕色长发散落在白色靠垫上。右手握着一杯香槟——经典的郁金香形香槟杯，杯中金色酒液映着阳光，细密的气泡从杯底升腾。她的目光不是直视镜头，而是侧向大海方向——仿佛被海面上的某处吸引了注意力，表情放松，嘴角有极浅的笑意，不是对任何人笑，是对这个下午本身。\n\n【关键细节】：\n- 亚麻连衣裙：天然亚麻的纵横纤维纹理在近距离可见，白色在强光下略微偏暖（象牙白而非冷白）。领口和袖口有微小的自然褶皱。\n- 香槟杯：薄壁玻璃边缘，杯中气泡从杯底中心线升起，酒液呈淡金色。手指握住杯杆的姿态放松——没有\"端着\"的正式感。\n- 沙发皮革：白色皮革表面有细微的天然纹理和坐垫的压痕——非全新，而是被使用过的生活痕迹。\n- 大海：海面在远处有轻微的波纹纹理，反光形成不规则的菱形光斑。靠近船体处海水呈深蓝，远处因大气透视逐渐变浅。\n\n【构图光线】：9:16竖版，中景全身（头顶至小腿），略显俯视角——镜头略高于沙发平面，向下拍摄。人物位于画面左下侧，右侧和上方留给大海和天空。高调曝光——正午强烈日光从头顶偏右侧直射而下，画面整体明亮，阴影轻薄。沙发的白色皮革几乎与白衬衫融为一体，仅靠边缘的微弱阴影区隔。大海和天空构成了经典的三明治构图——甲板白沙（下）、深海蓝条带（中）、蓝天白云（上）。光线清澈、硬朗但不刺眼——白色沙发的反光为人物提供了下方的自然补光，削弱了正午光应有的眼窝深影。整体色彩方案：象牙白（裙子+沙发）+ 深海蓝（海面）+ 天蓝（天空）+ 淡金（香槟+阳光）。\n\n【氛围基调】：夏日海上的悠闲午后。不是炫耀——是真正的放松。有海风但不凌乱，有阳光但不灼人，有香槟但不派对。这是一个人的奢侈：时间、空间和什么都不必做的下午。\n\n【约束条件】：8K ultra-detailed，写实摄影质感。无性暗示——服装为日常度假连衣裙，覆盖完整。无水印，无logo，无文字。自然皮肤纹理，无磨皮无美颜。不出现其他人物。不出现智能手机或现代电子设备。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [775.4835815429688, 536.8350219726562], "pos": [540.811767578125, 470.8753356933594], "id": 49, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 8}, {"outputs": [{"name": "IMAGE", "links": [79, 80], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "#223", "widgets_values": ["lanczos", 0.5000000000000001, 1], "inputs": [{"name": "image", "link": 114, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "缩放方法"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "像素数量"}, {"widget": {"name": "resolution_steps"}