nnectable": {}, "Node name for S&R": "easy showAnything"}, "order": 6}, {"mode": 0, "outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "output"}], "size": [270, 90], "shape": 1, "pos": [-1030, -3780], "widgets_values": ["2216"], "inputs": [{"shape": 7, "name": "anything", "link": 58, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 48, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-workflow-encrypt", "ver": "1.0.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 8}, {"outputs": [{"name": "STRING", "links": [59, 60], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "shape": 1, "widgets_values": ["中近景偏七分身的人像摄影，采用竖幅构图与平视略微低机位的正面视角。主体位于画面中央，身体基本正对镜头，上半身轻微向自身左侧扭转，肩线形成不对称角度。头部略低，下巴轻收，脸部大部分隐藏在深色兜帽阴影中，只隐约露出鼻梁、嘴唇和下颌轮廓，双眼几乎被完全遮住，表情冷静、沉默，带强烈神秘感。左臂自然垂在身体一侧，手指放松；右侧身体从肩部、胸口、腰部一直到裙摆正在发生明显崩解，像被风吹散成烟雾、碎屑和细小颗粒。\n\n人物穿深紫黑色幻想风连帽服装，兜帽宽大而厚重，布料带细密纵向纹理和自然褶皱。上身为贴身短款胸衣式结构，胸口有交叠包裹与褶皱，腰腹大面积露出；手臂穿同色长手套，下身为低腰不对称长裙，裙摆自然垂落。服装整体材质介于丝绸、薄皮与柔软织物之间，表面偏哑光，但局部边缘带微弱反光。\n\n画面核心是人物右半边的大量的动态粒子化消散效果：从右肩、胸侧、腰部到胯部不断分解成紫灰色烟雾、透明碎片、微小晶体和尘埃颗粒，碎屑向画面右侧和右上方扩散，边缘呈卷曲流动状态。消散区域内部夹杂大量暖金色微光和火星般亮点，在深紫色烟尘中形成强烈冷暖对比。背景为低饱和灰绿色纯色空间，几乎没有具体环境元素。光线柔和但方向明确，人物左侧保持较深阴影，右侧消散区域被金色内发光轻轻照亮。整体画质细腻、暗部丰富，色调以紫黑、灰绿和暖金为主，呈现神秘、冷峻、带超现实数字艺术与暗黑幻想电影感的写实风格。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "提示词正文输入", "mode": 0, "bgcolor": "#353", "size": [520, 280], "pos": [-730, -4670], "id": 50, "properties": {"cnr_id": "comfy-core", "ver": "0.26.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 1}, {"outputs": [],