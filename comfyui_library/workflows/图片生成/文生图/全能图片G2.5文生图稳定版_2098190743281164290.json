{"last_link_id": 2, "nodes": [{"mode": 0, "outputs": [{"name": "text", "links": [1], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [419.0082702636719, 490.9090881347656], "pos": [316.4725646972656, 691.7767944335938], "widgets_values": ["一幅苍茫、空灵、水天相接的云墟水府天宫场景。主体为半浮于云海、半隐于云雾之下沧海之上的水云天宫，天际海天一线，薄雾笼罩远方。通透汉白玉长阶直通临海主殿露台，中景两名浅青长袍修士凭台眺望沧溟云海，人物仅占画面高度 1%，形体渺小，作为尺度参照。远景错落水榭浮阁、连绵云涛与隐约可见的海平面。建筑采用江南古风结合上古水神宫殿设计，青灰瓦顶，白墙木构，翡翠色檐角装饰，大量连廊水榭，建筑比人物高二十倍。低空大面积流动海雾。电影平缓机位，均衡对称构图。清晨柔和平射天光，漫射光铺满场景，海浪与云海反射柔光，阴影是淡蓝调。整体为高预算东方仙侠史诗电影 CG 定帧，写实三维环境，氛围空灵辽阔、温润静谧，充满海天合一的缥缈感。画面干净通透、无文字、无字幕。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 10, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [423.5368957519531, 551.3514404296875], "pos": [1317.9600830078125, 688.635498046875], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 2, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 11, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 2}, {"outputs": [{"name": "image", "links": [2], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "2k", "16:9", "auto", "auto", "png", false, 1469652856, "randomize"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"wid