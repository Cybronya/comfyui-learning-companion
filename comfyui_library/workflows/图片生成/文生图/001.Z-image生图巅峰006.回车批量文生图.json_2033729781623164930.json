e": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "type": "KSampler", "mode": 0, "bgcolor": "#355", "size": [250, 600], "pos": [-1440, -230], "id": 4, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "Node name for S&R": "KSampler"}, "order": 12}, {"outputs": [{"shape": 6, "name": "STRING", "links": [22], "label": "STRING", "type": "STRING", "localized_name": "STRING"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#233", "widgets_values": ["玄色暗纹长袍男子立于山巅松林前，束发金冠嵌墨玉，左额细小竖疤清晰可见，狭长丹凤眼凝视前方，右手中握黑檀剑鞘朱砂穗剑，玄色布靴稳踏地面；身旁素白衣裙女子半挽青丝插羊脂玉簪，柳叶眉轻扬，双手持淡青剑穗墨玉剑格双刃交叉而立，背景水墨泼洒山水如画，竹叶散落风中，云雾缭绕山腰，整体以张大千泼墨笔触勾廓、傅抱石写意衣袂，黑白灰主调唯朱砂红剑穗与墨玉点缀，构图稳定庄重，情绪静待爆发。\n水墨山水意境中，玄色暗纹长袍男侠立于崖边，束发金冠嵌墨玉，左额细小竖疤清晰可见；狭长丹凤眼凝神，薄唇紧抿，右臂持黑檀剑鞘配朱砂红穗之剑，剑格云纹隐现；玄色布靴贴地，足尖微悬似蓄力待发。身后山峦以张大千泼墨勾廓，傅抱石笔法渲染衣袂垂落动感，整体黑白灰调，唯朱砂剑穗与墨玉冠饰点睛。对面素白透纱女侠半挽青丝插羊脂玉簪，柳叶眉含笑未语，双手握淡青剑穗墨玉剑格之双剑，月白布靴束带收脚踝，纱裙隐约透出月白衣衫与淡青竹纹——整幅画作水墨晕染交融，光影柔和，构图对称而富有戏剧张力。\n玄色暗纹长袍男侠立于山巅碎石之上，袖口银线竹叶纹清晰可见，束发金冠嵌墨玉，左额细小竖疤如刀痕凝固，狭长丹凤眼沉静如渊，薄唇紧抿显肃杀之态；右手握黑檀木剑鞘朱砂剑穗，剑格云纹隐现，脚踏玄色布靴防滑纹路分明；身旁素白透纱女侠半挽青丝插羊脂玉簪，柳叶眉微扬樱桃唇含羞而坚，双手执淡青剑穗墨玉剑格双刃并举，月下竹影摇曳如画；整体以张大千泼墨勾廓、傅抱石写意衣袂，水墨晕染氤氲流转，唯朱砂剑穗与墨玉点睛，黑白灰基调配色纯净，远景山峦初露云霭，近景兰草低伏待风——此即战前对峙定格。\n玄色暗纹长袍男子立于云端之巅，袖口银线竹叶纹清晰可见，束发金冠嵌墨玉，左额细小竖疤如古画题跋般凝固；狭长丹凤眼沉静如渊，薄唇紧抿，右臂执黑檀剑鞘配朱砂剑穗，剑格云纹隐现，玄靴稳踏虚浮云台——张大千泼墨勾廓，傅抱石写意挥衣袂，水墨氤氲中唯余朱砂红与墨玉点睛；对面素白透纱女子半挽青丝插羊脂玉簪，柳叶眉轻扬，樱桃唇含笑未语，双手握淡青剑穗墨玉剑格，月白衣袂随风欲舞——同幅画卷两身影对峙，残月悬空作幕，云海旋涡初涌，二人皆以静态定势引出下一瞬风暴。\n水墨泼墨风全景构图，山巅孤峰之上，残月下云海翻涌，松枝如墨痕斜伸；男主角立于左侧崖边，玄色暗纹长袍随风轻扬，袖口银线竹叶纹清晰可见，束发金冠侧嵌墨玉，左额细小竖疤精准定位，狭长丹凤眼凝视前方，右手中握黑檀木剑鞘配朱砂红剑穗，剑格云纹隐现，脚踏玄色布靴防滑纹路分明；女主角居右侧悬空飞掠，素白透纱长裙缀淡青竹纹若隐若现，半挽青丝夹羊脂玉簪，柳叶眉微扬樱桃唇含笑未语，双手各执一把细长剑刃饰墨玉剑格与淡青剑穗，足蹬月白束带布靴；整幅画以张大千泼墨勾廓、傅抱石写意绘衣袂，水墨晕染营造流动空气感，唯留朱砂红与墨玉作唯一色彩锚点，黑白灰基调配出肃杀诗意。\n玄夜云海之巅，残月如钩悬于天幕，松林肃立不动。男主玄色暗纹长袍随风轻曳，袖口银线竹叶纹在月下泛幽光；束发金冠缀墨玉，左额竖疤清晰可见，狭长丹凤目凝神沉锋。右手紧握黑檀剑鞘配朱砂红穗，剑格云纹隐约流转。脚下玄色布靴踏稳山岩，防滑纹路分明。女主素白透纱长裙拂过膝畔，淡青竹纹若隐若现，半挽青丝夹羊脂玉簪，柳叶眉含柔情，樱桃唇似待语。双手持淡青剑穗墨玉剑格双刃并列，月白布靴束带端正。背景以张大千泼墨笔触勾廓，傅抱石写意挥洒衣袂，水墨晕染弥漫天地——唯余朱砂剑穗与墨玉点缀，在黑白灰世界中熠然成诗。", 0, 1000, true], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "start_index"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "max_rows"}], "flags": {"collapsed": false}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [340, 690], "pos": [-2780, -320], "id": 21, "properties": {"cnr_id": "comfyui-easy-use", "ver": "9947b8be70e17ceabafa4fa7f476b54626de4704", "ue_properties": {"widget_ue_connectable": {"start_index": true, "max_rows": true, "prompt": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"start_index": true, "max_rows": true, "prompt": true}, "Node name for S&R": "easy promptLine"}, "order": 5}, {"outputs": [{"name": "LATENT", "links": [6], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#232", "widgets_values": [832, 480, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "I