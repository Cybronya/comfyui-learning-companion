Describe only natural and architectural forms; keep every surface plain, and do NOT describe any writing, marking or decorated panel anywhere in the scene.\n5. The image must contain absolutely no letters, characters, numerals, symbols, hieroglyphs or writing-like marks of any kind anywhere. Keep every surface completely plain, blank and clean - no signage, no plaques, no banners with markings, no posters with writing, no engraving, no stamps and no seals.\n\n--- MY IDEA ---\na girl sitting in a cafe"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "title": "✍️ 你的想法（改最后一行）", "mode": 0, "bgcolor": "#335", "size": [470, 480], "pos": [40, 280], "id": 2, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 1}, {"outputs": [{"name": "generated_text", "links": [3], "label": "generated_text", "type": "STRING", "localized_name": "generated_text"}], "color": "#223", "widgets_values": ["", 2048, "on", 0.7, 64, 0.95, 0.05, 1.05, 0, 0, false, true], "inputs": [{"name": "clip", "link": 1, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"shape": 7, "name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 2, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "max_length"}, "name": "max_length", "label": "max_length", "type": "INT", "localized_name": "max_length"}, {"widget": {"name": "sampling_mode"}, "name": "sampling_mode", "label": "sampling_mode", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "Sampling Mode"}, {"widget": {"name": "sampling_mode.temperature"}, "name": "sampling_mode.temperature", "label": "s