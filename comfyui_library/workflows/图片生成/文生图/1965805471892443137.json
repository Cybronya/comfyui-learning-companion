韧暗色调的混合，将《绝命毒师》的激烈戏剧性与《绝命毒师》轻松的烹饪风格融为一体。\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [559.4214477539062, 205.19827270507812], "pos": [844, -197], "id": 26, "properties": {"widget_ue_connectable": {}, "text": ""}, "order": 4}, {"mode": 0, "outputs": [{"name": "MODEL", "slot_index": 0, "links": [38, 39], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [315, 82], "pos": [-31, 118], "widgets_values": ["flux1-dev.sft", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 12, "type": "UNETLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 5}, {"mode": 0, "outputs": [{"name": "CLIP", "slot_index": 0, "links": [10], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [315, 130], "pos": [-37, 268], "widgets_values": ["t5xxl_fp16.safetensors", "clip_l.safetensors", "flux", "default"], "inputs": [{"widget": {"name": "clip_name1"}, "name": "clip_name1", "label": "clip_name1", "type": "COMBO", "localized_name": "clip_name1"}, {"widget": {"name": "clip_name2"}, "name": "clip_name2", "label": "clip_name2", "type": "COMBO", "localized_name": "clip_name2"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 11, "type": "DualCLIPLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "DualCLIPLoader"}, "order": 6}], "extra": {"links_added_by_ue": [], "workspace_info": {"id": "MKagnnMwzEYtORZGnoBqn"}, "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [91.58641985210141, -8.8783589125