ype": "CONDITIONING", "localized_name": "条件"}, {"widget": {"name": "start"}, "name": "start", "label": "start", "type": "FLOAT", "localized_name": "开始"}, {"widget": {"name": "end"}, "name": "end", "label": "end", "type": "FLOAT", "localized_name": "结束"}], "flags": {}, "index": 2, "id": -1, "type": "ConditioningSetTimestepRange", "properties": {"cnr_id": "comfy-core", "ver": "0.3.76", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "rejects_ue_links": false, "Node name for S&R": "ConditioningSetTimestepRange"}, "order": 19}, {"outputs": [{"name": "CONDITIONING", "links": [], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["一位身材火辣的亚洲孕妇坐在略显陈旧、灰白色的水泥楼梯上，她身穿一件贴合身形的虎纹紧身连衣裙巨乳显得饱满又挺拔，肚子有明显怀孕的迹象——黑白相间的条纹如豹斑般凌厉而富有张力，她带着一个黑色的口罩；裙子剪裁极尽修身之能事，勾勒出流畅且充满力量感的身体曲线，黑色高跟尖头鞋在脚踝处微微翘起，漆面光滑反光，与腿部肌肤形成鲜明对比，眼神低垂却透着一丝迷离诱惑的气息。右手轻扶着木质栏杆（表面有轻微磨损痕迹），左手自然搭于膝边，姿态既慵懒又带点挑衅式的自信。\n\n整个场景置于室内楼梯间，墙面素净无饰，仅可见粗糙混凝土台阶边缘因岁月侵蚀留下的细微裂痕及污渍，阶梯呈缓坡式排列，光线从上方斜射入内空间，造成强烈的明暗分界：人物身上布满冷峻的阴影，同时其轮廓又被柔化的散射光照亮得清晰可辨。整体色调偏中性灰色系，唯有那件老虎图案服装以及黑底红口的高跟鞋构成视觉焦点色块，极具戏剧冲突意味。空气静谧无声，仿佛时间在此刻凝固成一幅“都市野性”主题的艺术写真——既有现代建筑结构带来的冰冷疏离感，又有模特所散发的人性魅惑与叛逆气息交织碰撞的独特氛围。画面构图采用对角线引导视线，强调了主体动态中的静态美，光影层次丰富却不失干净利落，是当代时尚摄影风格中最具冲击力的一种呈现方式。"], "inputs": [{"name": "clip", "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "index": 3, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [318.6094665527344, 116.08282470703125], "pos": [-628.6991577148438, -1700.870361328125], "id": -1, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "ta