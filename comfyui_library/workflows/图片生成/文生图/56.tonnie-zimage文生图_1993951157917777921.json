samples", "link": 51, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 45, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 8, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 10}, {"mode": 0, "outputs": [], "size": [140, 26], "pos": [146.46434020996094, -102.3582992553711], "inputs": [{"name": "images", "link": 75, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 39, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 12}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [4], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["在暮春时节那略带惆怅的氛围里，一位身着素色汉服的佳人独自伫立在幽谧的庭院之中。她的汉服是柔和的月白色，轻薄的衣料上绣着若有若无的淡粉色花瓣纹路，随着微风轻轻飘动，似是与空中飘落的花瓣融为一体。宽大的衣袖和飘逸的裙摆，尽显东方女子的温婉柔美。\n她一头乌黑如瀑的长发，仅用一根简约的玉簪轻轻挽起，几缕碎发垂落在她白皙如玉的脸颊旁，更添几分楚楚动人。她的脸上未施过多粉黛，却有着一种天然去雕饰的清新之美，眉如远黛，眼若秋波，此刻，她微微仰头，眼神中带着一丝淡淡的忧伤和落寞，凝视着天空中纷纷扬扬飘落的花瓣。\n天空中飘着细密的微雨，如牛毛，如细丝，轻轻地洒落在她的身上，打湿了她的发丝和衣衫，但她却浑然不觉，依旧静静地站在那里，仿佛与这天地融为一体。细雨中，一对燕子轻盈地飞过，它们身姿矫健，双翼轻展，时而低空掠过，时而高飞入云，在雨幕中划出一道道优美的弧线，叽叽喳喳的叫声，在这寂静的庭院里显得格外清脆悦耳。\n庭院中，几株桃树和杏树错落有致地分布着，此时，树上的花朵已经渐渐凋零，满地都是粉白相间的花瓣，像是给大地铺上了一层柔软的花毯。一阵微风吹过，更多的花瓣纷纷扬扬地飘落下来，如同下起了一场花瓣雨，纷纷洒洒，美不胜收。\n周围的回廊和亭台楼阁在细雨的笼罩下，显得更加古朴典雅，雨水顺着屋檐滴落下来，形成一道道晶莹的水帘。远处，传来隐隐约约的钟声，悠扬而空灵，为这宁静的画面增添了几分禅意。\n柔和的光线透过雨幕洒在佳人身上，勾勒出她纤细而柔美的身姿。景深较浅，超精细的纹理（汉服面料的轻柔质感、花瓣的细腻脉络、雨丝的晶莹剔透）、孤寂又唯美的情绪、淡雅清新的调色板（月白色汉服与粉白花瓣、淡绿色枝叶的搭配）、8k超高清、具有细腻绘画笔触的照片级真实感、古典诗意风格、--ar 16:9 --style raw --q 2"], "inputs": [{"name": "clip", "link": 43, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bg