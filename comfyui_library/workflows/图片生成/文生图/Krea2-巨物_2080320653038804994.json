values": [1920, 1080, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {"disabled": false}, "type": "EmptyLatentImage", "mode": 0, "bgcolor": "#353", "size": [399.1082458496094, 131.6579132080078], "pos": [-2768.01123046875, 1664.6929931640625], "id": 57, "properties": {"cnr_id": "comfy-core", "ver": "0.26.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"batch_size": true, "width": true, "height": true}, "Node name for S&R": "EmptyLatentImage", "ttNbgOverride": {"bgcolor": "#355", "groupcolor": "#8AA", "color": "#233"}}, "order": 13}, {"mode": 0, "outputs": [{"name": "output", "links": [135], "type": "*", "localized_name": "output"}], "size": [420, 540], "pos": [-1575.1627197265625, 2533.986328125], "widgets_values": ["Captured via a 24mm ultra-wide lens from an extreme low ground-level viewpoint with deep depth of field, the image is dominated by 90% of a colossal mecha titan's massive palm, a single limb stretching 5 kilometers in width that overflows the entire top and left frame edges while only revealing a terrifying fraction of its true scale. At the absolute center, standing on the palm's sole which measures over 300 meters in diameter, is a solitary human figure reduced to a mere 0.05% of the total visual mass, positioned on the exact same compressed focal plane to create an overwhelming semantic conflict between human fragility and industrial immensity. The palm surface features three distinct massive structural zones: the main arch, the central ridge, and the thumb section, all densely packed with repeating micro-scale mechanical units including riveted steel plates, hydraulic pistons, exposed copper wiring, and articulated finger segments where each joint is the size of a city block. The materials consist of weathered rough concrete, rusted corten steel, patinated bronze, and iridescent glazed tiles, scarred by centuries of combat with visible heat burns, oil leaks, and peeling armor plating. Bathed in harsh chiaroscuro lighting with volumetric rays piercing through a thick industrial smog, the scene uses a palette of cold greys, burnt oranges, and deep shadows, causing the titan to cast a shadow spanning thousands of kilometers across the distant horizon, stir up a kilometer-high dust storm around its base, and distort the sky above. 8k resolution, masterpiece, extremely detailed, UE5 render style, cinematic photorealism, physically believable materials, deep atmospheric perspective, crisp edges."], "inputs": [{"shape": 7, "name": "anything", "link": 134, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"disabled": false}, "id": 110, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "625efbfa2fc20c31797dfffcbb41a26b6d91ab7b", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 19}, {"mode": 0, "outputs": [{"shape": 6, "name": "文本", "links": [133], "label": "文本", "type": "STRING", "localized_name": "文本"}], "size": [360, 260], "pos": [-2745.162841796875, 2803.986328125], "widgets_values": ["Role｜角色\n\n你是一名顶级 AI 绘画提示词专家，精通摄影美学、构图比例、材质渲染、光学空间与巨物表现（Colossal Entities）。用户只需输入几个简单关键词，你必须静默扩写，最终只输出一段可直接用于 Krea 2 的纯英文提示词。\n\nCore Definition｜巨物核心定义\n\n在本提示词中，巨物可以是以下三种类型之一，由用户关键词决定：\n\n1. 建筑巨构：\n建筑物、建筑群或具有明确建筑空间与人类尺度功能单元的超级工程；\n\n2. 生物巨物：\n龙、怪兽、神兽、利维坦、泰坦、神祇化身、巨型海洋生物或其他幻想 / 神话 / 科幻生命体；\n\n3. 混合巨物：\n机械与生物质结合体、自然共生体（世界树、山岳巨龟、活体山脉）、半生物半建筑的存在。\n\n巨物可以是现实、幻想、科幻、古代、中式、宗教、自然共生或任何用户指定的类型。最终画面绝不能只是一张普通生物图、风景图、载具图或主体特写；「巨物」必须成为第一眼就无法忽视的核心主题。\n\n巨物感必须同时来自以下三个维度，缺少任何一个都必须重写：\n\n1. 宏观数据震撼\n\n必须根据题材给出夸张而具体的高度、宽度、长度、体长、翼展或覆盖面积，例如高 8,000–20,000 米、体长 50–500 公里、翼展横跨数百公里、覆盖数千平方公里。数字必须进入最终英文，用来明确物理体积，不能只写 colossal、massive、epic 等空泛形容词。\n\n2. 微观尺度堆叠\n\n巨物的表面与结构必须保持可辨认的人类尺度细节，按类型选择：\n\n建筑巨构：\n门窗、阳台、拱廊、斗拱、栏杆、楼梯、管道、舱口、检修平台、桥梁、廊道、塔楼、涡轮、闸门等真实建筑单元；\n\n生物巨物：\n鳞片、甲片、脊棘、鬃毛、关节、指爪、齿列、角、鳃裂、虹膜纹理、皮肤褶皱、羽片、骨节、触须等正常生物尺寸的解剖单元，例如 a single scale the size of a house, each dorsal spine a hundred-meter tower of bone；\n\n混合巨物：\n建筑单元与解剖单元交错共生，例如 windows embedded between ribs, bridges strung along vertebrae。\n\n3. 极端画幅占比与语义冲突\n\n必须明确写出巨物占据画面的具体比例，通常为 75%–95%。巨物必须从顶部以及至少一个侧边溢出画框；横向延展的巨物（长龙、利维坦、跨海桥、爬行巨兽）则必须从左右边缘和至少一个上下边缘溢出。只能看到其真实体量的一小部分，绝对禁止把巨物完整、孤立、居中地装进画面。\n\n同时必须保留约 10%–25% 的连续环境空间，用于显示天空、荒原、海面、云层、山脉、宇宙或用户指定环境，不能让巨物完全堵死画面。\n\n必须加入一个用户指定或题材自然适配的熟悉参照物，例如人、车辆、舰船、村落、道路、树木、飞鸟或普通建筑。参照物占比必须小于 0.1%，可以接近 0.03%–0.08%，但仍应保留可辨认的轮廓。它绝对不能位于前景或近景，必须明确处在 in the extreme far distance、at the distant base、on the exact same remote depth plane 或 on the same compressed focal plane，与巨物形成直接的语义冲突，彻底排除近大远小造成的虚假尺度。\n\nSemantic Fidelity｜关键词遵循\n\n用户输入中的主体、地点、时代、文化、色彩、材质、动作和相互关系都是不可更改的硬条件。\n\n用户明确指定巨物类型时，必须原样保留，不得替换成另一类型（例如用户说龙，就绝不能写成建筑；用户说神殿，就绝不能写成巨兽）。\n\n用户只提供地点、文化或氛围时，补充一种与这些关键词最匹配的巨物形式，但只补充一个核心巨物。\n\n用户指定中式古风、宗教、自然、晶体、生物共生或明亮风格时，不得自动工业化、黑暗化或添加钢铁基地。\n\n用户输入人物、车辆、舰船或动物，而没有明确称其为巨型主体时，将其作为极远处尺度参照物，不得拍成近景主角。\n\n生物巨物的动作、姿态、情绪若被用户指定（盘踞、腾空、沉睡、咆哮、掠过云层），必须原样保留并贯彻到构图与光影中。\n\n不得增加用户没有要求的战争、爆炸、舰队、城市、第二巨物或第二主角。\n\nSix-Part Prompt Structure｜六维成像结构\n\n最终英文必须将以下六个维度自然融合为一个流畅长段落，不能写成标签列表。\n\n1. Composition, Proportion and Semantic Conflict\n\n明确巨物占据画面的比例、位于哪一侧、从哪些边缘溢出，并说明只能看到其真实体量的一小部分。明确参照物小于 0.1%，位于极远处并与巨物处在相同远距离深度平面。使用 overwhelming physical mass、a terrifying fraction of its true scale、semantic conflict between human scale and overwhelming immensity 等可见尺度语言；生物巨物可附加 a single limb /wing/coil already dwarfs the entire visible landscape。\n\n2. Subject, Data and Physical Density\n\n明确巨物的形态类型和具体公里级数据。超大总体表面形成密集细节纹理。至少同时出现：一个压倒性的总体轮廓、三至五个巨型分区（建筑的功能分区 / 生物的头、颈、躯干、翼、肢节等巨型段落）、连续结构带或连续身体曲线，以及三至六类重复的人类尺度部件（建筑单元或解剖单元，按类型选择）。\n\n3. Photography Style and Lens Space\n\n只选择一种最能强化当前巨物体量的极端镜头方案：\n\n需要宏大纵深、内部深渊、垂直仰望或强汇聚线时：\n14–24mm ultra-wide angle lens、extreme long shot、very low or distant ground-level viewpoint、extremely deep depth of field。\n\n需要压扁纵深、制造无法绕开的巨墙、无边立面、无边躯体或超现实拼贴感时：\n400–800mm extreme super telephoto lens、eye-level、severe spatial compression、stripping away the Z-axis depth、flat surreal collage feel。\n\n需要展示跨越山脉、海岸或行星曲率的巨物时：\nhigh oblique aerial extreme long shot，并选择 50–150mm 镜头，让重复的结构模块、鳞甲或脊节沿地形不断缩小。\n\n不得同时使用互相矛盾的焦段和机位。镜头必须与巨物形态共同服务压迫感，而不是只追求华丽。\n\n4. Materials and Textures\n\n选择两至四种与用户题材及巨物类型一致的真实材质：\n\n建筑巨构使用 weathered rough concrete、rusted corten steel、patinated bronze、iridescent glazed tiles、crystalline stone 等；\n\n生物巨物使用 ancient cracked scales like weathered bronze、bone-white keratin spines、leathery wing membranes veined with light、glossy obsidian chitin、bioluminescent tissue、scarred hide bearing centuries of wounds 等；\n\n混合巨物按两类材质交错描述。\n\n必须描述风化、腐蚀、愈合疤痕、蜕皮残片、寄生藤壶、沉积、热损伤或时间痕迹，使巨大表面具有真实重量与生命 / 历史感。\n\n5. Lighting, Atmosphere and Color\n\n自由选择最适合当前主题的光线，不固定为阴暗工业风。可以使用清澈自然光、黄金时刻、强烈 chiaroscuro、神圣 volumetric rays、压抑阴天、沙暴、云海、生物荧光、工业烟尘或冰冷人造光。\n\n空气介质必须让巨物远端逐渐消失，并强化极远距离。\n\n色彩必须服从用户关键词和场景情绪，可以明亮、高饱和、神圣、清冷、黑暗、废土或梦幻，不得用固定调色覆盖用户设定。\n\n巨物必须对环境造成至少两种跨区域影响，例如遮蔽地平线、穿透多层云海、投下跨越山谷或城市的阴影、搅起公里级雾浪或浪墙、改变风沙或水流走向、压低云层、令呼吸在峡谷间形成风暴、使翼下海面凹陷、令海浪撞击其躯体或基座、扭曲星光。\n\n6. Rendering and Maximum Quality\n\n结尾必须使用与用户要求一致的高质量表达，默认包含 8k resolution、masterpiece、extremely detailed、UE5 render style、cinematic photorealism、physically believable materials、deep atmospheric perspective、crisp edges。\n\n质量词只能加强呈现，不能改变用户内容。\n\nOutput Order｜最终英文顺序\n\n按照以下顺序写成一段 190–280 个英文单词的连贯自然语言：\n\n镜头、机位和极远景关系；\n\n巨物主体、具体尺寸和画幅占比；\n\n从哪些边缘溢出以及只能看到冰山一角；\n\n小于 0.1% 的极远处参照物及相同深度平面；\n\n巨型分区与微观尺度细节堆叠；\n\n材质和时间 / 生命痕迹；\n\n光线、空气、色彩和至少两种环境反馈；\n\n8K、masterpiece、extremely detailed、UE5 render style 等最终质感。\n\nMandatory Audit｜输出前强制审计\n\n在内部逐项检查，任何一项不成立都必须重写：\n\n巨物是否明确属于建筑巨构、生物巨物或混合巨物之一，且与用户关键词类型一致？\n\n第一眼是否先读到无法看见全貌的巨物，而不是普通图像主体？\n\n是否包含具体而夸张的公里级物理数据？\n\n是否明确写出 75%–95% 的画幅占比并至少溢出两个边界？\n\n是否保留 10%–25% 连续环境空间？\n\n参照物是否小于 0.1%，位于极远处且与巨物处于同一远距离深度平面？\n\n微观细节是否与巨物类型匹配（建筑用建筑单元，生物用解剖单元），且服从结构和透视，而不是随机马赛克、噪点或散乱灯光？\n\n是否只使用一套匹配巨物形态的极端镜头方案？\n\n是否至少有两种跨区域环境反馈？\n\n是否完整保留用户的题材、文化、地点、颜色、材质、动作和关系？\n\n删除 epic、masterpiece 等质量词后，是否仍能仅凭尺寸、越框、细节堆叠和远景参照物认出巨物？\n\nFinal Constraint｜最终限制\n\n最终只输出一段纯英文提示词。禁止输出标题、引号、中文、解释、分析、多个版本、字数、参数说明、负面提示词或任何前后缀。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {"disabled": false}, "id": 112, "type": "MuyeTextEditOutput", "properties": {"ver": "0f123209759b2ce481a83e91cd5a2bb51cdc59a6", "widget_ue_connectable": {}, "aux_id": "muyexiuluo/ComfyUI_Muye", "Node name for S&R": "MuyeTextEditOutput"}, "order": 14}, {"outputs": [{"shape": 6, "name": "文本", "links": [132], "label": "文本", "type": "STRING", "localized_name": "文本"}], "color": "#232", "widgets_values": ["巨型机械巨人的手掌里站着一个人"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {"disabled": false}, "type": "MuyeTextEditOutput", "mode": 0, "bgcolor": "#353", "size": [375.53424072265625, 326.824462890625], "pos": [-2755.002685546875, 1849.75634765625], "id": 113, "properties": {"ver": "0f123209759b2ce481a83e91cd5a2bb51cdc59a6", "widget_ue_connectable": {}, "aux_id": "muyexiuluo/ComfyUI_Muye", "Node name for S&R": "MuyeTextEditOutput"}, "order": 15}, {"outputs": [], "color": "#432", "widgets_values": ["1. 巨型远古龙头，近距离，山谷\n\n2. 女剑士与巨型黑龙面对面\n\n3. 小女孩站在巨兽眼睛旁边\n\n4. 巨型机械巨人的手掌里站着一个人\n\n5. 巨龙的脚边停着一辆汽车\n\n6. 东方青龙盘绕整个山谷\n\n7. 巨型蓝鲸近距离游过镜头\n\n8. 巨型凤凰展开双翼飞过天空\n\n9. 巨型机械巨人站在城市中央\n\n10. 巨大神殿矗立在荒原\n\n11. 巨型古城沿着山脉延伸\n\n12. 巨型世界树生长在森林中\n\n13. 巨大神像低头看着镜头\n\n14. 巨型海蛇从海面升起\n\n15. 女战士站在巨兽肩膀上\n\n16. 一个人站在巨大冰川裂缝前\n\n17. 女孩站在海边，远处巨型蓝鲸浮出海面\n\n18. 巨大神兽行走在普通村庄旁边\n\n19. 东方青龙低空飞过城市\n\n20. 骑士站在巨大神像脚下"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [491.4054260253906, 364.21551513671875], "pos": [-3296.744873046875, 1836.32177734375], "id": 115, "properties": {"widget_ue_connectable": {}}, "order": 16}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "workspace_info": {"id": "oFQxe_PMSgvGB04KwCUyp"}, "KKvideo_latentpreview": false, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [2865.521148343458, -1196.799866512405], "scale": 0.7972024500000033}}, "groups": [{"color": "#A88", "font_size": 24, "flags": {}, "id": 1, "title": "模型加载", "bounding": [-2315.06005859375, 1596.2152099609375, 923.0818481445312, 754.0889282226562]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "采样", "bounding": [-1372.5098876953125, 1593.811767578125, 1007.3108520507812, 754.083984375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "结果区", "bounding": [-329.4927062988281, 1593.953369140625, 421.7675476074219, 761.407470703125]}, {"color": "#8A8", "font_size": 24, "flags": {}, "id": 4, "title": "参数录入", "bounding": [-2783.5859375, 1591.093017578125, 464.94866943359375, 762.48388671875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "SeedVR2放大", "bounding": [-1090.2049560546875, 2396.8984375, 2288.944091796875, 866.2579345703125]}, {"color": "#A88", "font_size": 24, "flags": {}, "id": 6, "title": "提示词扩写", "bounding": [-2773.275634765625, 2396.939453125, 1666.034423828125, 871.4168701171875]}], "links": [[71, 54, 0, 51, 0, "LATENT"], [72, 50, 0, 51, 1, "VAE"], [73, 55, 0, 53, 0, "CONDITIONING"], [76, 53, 0, 54, 2, "CONDITIONING"], [77, 57, 0, 54, 3, "LATENT"], [83, 55, 0, 54, 1, "CONDITIONING"], [111, 51, 0, 74, 0, "IMAGE"], [114, 82, 0, 54, 0, "MODEL"], [115, 49, 0, 82, 1, "CLIP"], [116, 82, 1, 55, 0, "CLIP"], [117, 51, 0, 83, 0, "*"], [120, 92, 0, 82, 0, "MODEL"], [121, 97, 0, 98, 0, "IMAGE"], [122, 95, 0, 98, 1, "SEEDVR2_DIT"], [123, 96, 0, 98, 2, "SEEDVR2_VAE"], [124, 100, 0, 98, 4, "INT"], [125, 97, 0, 101, 0, "IMAGE"], [126, 98, 0, 102, 0, "IMAGE"], [127, 98, 0, 103, 1, "IMAGE"], [128, 51, 0, 97, 0, "IMAGE"], [129, 51, 0, 103, 0, "IMAGE"], [130, 111, 0, 109, 0, "LLAMACPPMODEL"], [131, 108, 0, 109, 1, "LLAMACPPARAMS"], [132, 113, 0, 109, 5, "STRING"], [133, 112, 0, 109, 6, "STRING"], [134, 109, 0, 110, 0, "*"], [135, 110, 0, 55, 1, "STRING"]], "id": "163ec137-2b5c-4530-a8fb-acc942d50362", "config": {}, "version": 0.4, "last_node_id": 115, "revision": 0}