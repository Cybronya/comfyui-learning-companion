e": [420.32977294921875, 234.53121948242188], "pos": [1230.4820556640625, 562.0357666015625], "widgets_values": ["疯狂动物城角色，尼克狐与朱迪兔。尼克有着橙红色的毛发，身穿经典的绿色棕榈叶印花短袖衬衫，系着蓝红相间的条纹领带，下身穿着卡其色长裤，表情帅气坏笑。朱迪有着灰色的毛发和紫色的眼睛，长耳朵高高竖立，身穿深蓝色的ZPD警官制服背心，佩戴银色警徽，腰带装备齐全，神态甜美可爱。 两人并肩坐在一个巨大的、悬浮的“小红书”APP界面相框底部边缘。突破次元壁构图，角色的双腿悬空并伸出相框平面之外，尼克的一只手亲密地搂住朱迪的肩膀，另一只手握着智能手机大幅度伸出画面最前方，以45度角高举进行自拍（鱼眼透视感）。朱迪身体紧紧依偎着尼克，抬头看向镜头甜笑，展示甜蜜秀恩爱的瞬间。 画面核心是一个巨大的小红书风格社交媒体相框。UI界面还原小红书经典布局：左下角有滚动的文案标题，右侧竖排悬浮着“心形”、“五角星”、“评论气泡”和“转发箭头”图标。顶部显示用户名“尼克&朱迪”，带有热门标签话题（如#疯狂动物城 #CP日常）。 3D皮克斯动画电影风格，Unreal Engine 5渲染，8K超高清画质。毛发呈现纤维级细节，光线追踪技术，柔和的自拍补光灯效果打在两人脸上，背景是虚化的疯狂动物城多彩街景与梦幻光斑。色彩明亮鲜艳，高饱和度，强调社交媒体的网感与糖果色调，极具视觉冲击力"], "inputs": [{"name": "clip", "link": 8, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 6, "type": "CLIPTextEncode", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [5], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [270, 262], "pos": [1694.46630859375, 619.5890502929688], "widgets_values": [58772558980995, "randomize", 7, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 1, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 2, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 3, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 4, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "