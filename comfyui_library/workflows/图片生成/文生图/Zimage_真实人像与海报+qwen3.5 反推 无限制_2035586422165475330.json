le": {}, "Node name for S&R": "SaveImage"}, "order": 28}, {"outputs": [{"name": "text", "links": [93], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["夸张视角，非传统构图杂志封面，《LANDI MAGAZINE》2025 年 11 月1号，珠海美食节主题。画面中心是一位年轻女孩手持横琴蚝刺身拼盘的人物，、红色围裙（印 “2025 珠海美食节”），姿态自然。左侧是美食节白色帐篷摊位，摆斗门艾饼、唐家茶果、海味玻璃罐，挂橙色三角旗；右侧海蓝色（HEX#1E90FF）双层观光巴士动态模糊，穿画面右侧。背景是港珠澳大桥，蓝天白云。​顶部左上角浅灰（HEX#E0E0E0）“Style Food Culture Design Travel”（“Food” 蓝色加粗），右上角中灰（HEX#A0A0A0）“ 2025 ”“THE MAGAZINE FROM EUROSTAR”（旁加 “ZHUHAI FOOD FESTIVAL SPECIAL”），右角落半透浅蓝 “TASTY ZHUHAI”。底部三栏中灰文字（美食节攻略、非遗美食、骑行路线），人物下方蓝粗体 “ZHUHAI FOOD FESTIVAL 2025”、白小字 “2025/ 11 / 01 横琴会展中心”。​珠海午后漫射光，明暗反差 3:1，食物加细微反光。高级灰（75%-80%）、暖橙（8%-10%）、海蓝（7%-9%），版画肌理，写实带复古时尚，层次分明，动态生活化。​"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [373.86383056640625, 239.79339599609375], "pos": [-28.872638702392578, 198.9567413330078], "id": 33, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 10}, {"outputs": [{"name": "LATENT", "links": [29], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#232", "widgets_values": [1080, 1920, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "type": "EmptyLatentImage", "mode": 0, "bgcolor": "#353", "size": [357.4917297363281, 119.58077239990234], "pos": [-15.727097511291504, 476.5171203613281], "id": 21, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"