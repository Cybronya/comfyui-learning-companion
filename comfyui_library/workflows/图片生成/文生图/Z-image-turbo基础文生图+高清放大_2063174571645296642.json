ize": [140, 46], "pos": [2536.714599609375, 774.7763061523438], "widgets_values": [], "inputs": [{"name": "samples", "link": 8, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 9, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 8, "type": "VAEDecode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 10}, {"outputs": [{"name": "CONDITIONING", "links": [6, 100], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["主体：画面主体是一位清代装扮的女子的胸部以上侧面肖像。她身穿传统的深红色绸缎长袍，衣摆上绣有精细的金色花纹，展现出华丽而不失端庄的气质。女子的头发高高挽起，露出精致的发髻，几缕碎发轻柔地垂落在鬓边。她侧脸看向观众，眼神中流露出一丝温柔与哀愁，手中轻轻握着一把折扇，增添了几分古典雅致。主体占据画面约三分之二的位置，显得格外突出。\n\n场景：女子身处一座古典园林之中，四周环绕着青砖灰瓦的传统建筑。背景是一片葱郁的竹林，竹叶随风轻摇，投下斑驳的光影。远处可以看到假山和水池，水面平静如镜，倒映着蓝天白云。天空中飘着几朵淡黄色的云彩，营造出秋日的宁静氛围。\n\n光影：画面采用侧面光拍摄，光线从一侧洒落，形成鲜明的明暗对比，使得女子的脸庞和衣物上的纹理更加立体。暖色调的光线穿透竹林，形成柔和而有层次的光影效果，使整个画面充满了温暖而怀旧的气息。\n\n技术：画面采用照片写实风格，追求极致的真实感和细节表现。画面具有8K的高清画质，色彩丰富且细腻，光影过渡自然，景深效果明显，呈现出大师级摄影作品的质感和艺术魅力。"], "inputs": [{"name": "clip", "link": 4, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 86, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [2089.215087890625, 412.4654541015625], "id": 5, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 7}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [101], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [140, 26], "pos": [2287.831298828125, 660.2308959960938], "inputs": [{"name": "conditioning", "link": 100, "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "flags": {}, "id": 93, "type": "ConditioningZeroOut", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ConditioningZeroOut"}, "order": 8}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [104], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [305.1272888183594, 89.71086883544922], "pos": [1750.931640625, 288.17449951171875], "widgets_values": ["z_image_turbo_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "UNET名称"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 1, "type": "UNETLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [4], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [270, 106], "pos": [1772.28369140625, 438.5491027832031], "widgets_values": ["qwen_3_4b.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "id": 4, "type": "CLIPLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 4}, {"outputs": [{"name": "text", "links": [86], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#432", "widgets_values": ["整体结构与用途\n比例：竖版海报，适合在抖音、小红书等平台做推广视频封面 / 广告图。\n核心目的：宣传「Z-image-turbo」这款 AI 文生图工具，吸引用户使用。\n\n顶部标题栏\n玫红色背景条上写着：Z-image-turbo，搭配一个卡通潮酷女生图标，突出品牌名和核心卖点。 白色字体\n下方大字标题：基础文生图 黄色字体\n中间主体视觉\n核心是一张 AI 生成的东方少女：\n20岁东亚美少女,鹅蛋脸,温柔杏眼,浅棕自然美瞳,淡伪素颜妆,浅粉唇釉,黑长直发型,头发柔顺自然，米白色微透轻薄短袖,浅色小短裙,室内奶油风卧室,窗边柔光,午后自然光,手边一杯冰美式,慵懒坐姿,微笑神态,生活化抓拍,松弛感\n画质：高细节、高分辨率，发丝、妆容都很清晰。\n\n"], "inputs": [{"widget": {"name": "text"}, "name