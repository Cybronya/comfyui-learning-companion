7, "label": "Sigmas", "type": "SIGMAS", "localized_name": "西格玛"}, {"name": "latent_image", "link": 8, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}], "flags": {}, "id": 14, "type": "SamplerCustomAdvanced", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SamplerCustomAdvanced"}, "order": 16}, {"mode": 0, "outputs": [{"name": "VAE", "links": [10, 13], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [400, 150], "pos": [41.669578552246094, 810.6674194335938], "widgets_values": ["flux2-vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "id": 3, "type": "VAELoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 11}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [12], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [400, 200], "pos": [651.1089477539062, 432.42449951171875], "widgets_values": ["一位年轻的东亚女性，黑长直长发，自然站立在明亮的热带白沙滩上，赤脚，放松姿态，面向镜头微笑。她身穿浅米白色挂脖包臀长裙：上半身是薄纱蕾丝、胸口系蝴蝶结，下身修身长裙布满立体白色花卉刺绣，布料自然贴合腰臀腿部，裙摆垂到脚踝上方。黑色大框猫眼太阳镜推在额头上、架在头顶眉毛上方，镜腿挂在耳后，不遮挡眼睛；镜片为渐变深色，镜腿带一枚金色方形饰片。\n\n双眼自然平视镜头，两只瞳孔居中、看向同一方向，眼位对称，眼睑放松，虹膜瞳孔细节真实，双眼都有柔和一致的眼神光，保留原有眉毛、妆容、肤色、鼻子和脸型不变，照片级真实，皮肤纹理自然\n\n背景为热带沙滩：浅色细沙带浅浅脚印，远处海岸线一排棕榈树，右侧是橙色遮阳伞和沙滩躺椅，淡蓝天空飘着薄云，海平面平静。\n\n光影融合：柔和自然日光与海滩环境一致，皮肤受暖调侧光、上方冷色天空补光，脚下沙面有柔和接触阴影，所有阴影朝向与棕榈树影子一致，裙摆和小腿肚轻微沾有细沙，皮肤保留毛孔和自然光泽，面料织纹与刺绣立体感真实，透视统一、人体比例和肢体结构正确，远景带轻微空气薄雾，真实度假生活照，35mm镜头，f/4，自然调色，超写实，看不出AI痕迹。"], "inputs": [{"name": "clip", "link": 1, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 7, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 12}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [18], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [400, 200], "pos": [1125.4136962890625, 426.20343017578125], "widgets_values": ["卡通, 动漫, 漫画, 插画, 绘画, 3D渲染, CGI, 数字绘画, 塑料皮肤, 蜡像感皮肤, 过度磨皮, 面部油光, 假人感, 多余手指, 缺失手指, 手指粘连, 手部畸形, 脚部畸形, 多余肢体, 缺失肢体, 身体扭曲, 比例错误, 脖子过长, 人体结构错误, 墨镜悬浮, 墨镜戴在眼睛上, 墨镜遮住眼睛, 服装不符, 穿错衣服, 多余衣物, 光影不一致, 阴影方向错误, 人物没有影子, 生硬抠图边缘, 贴图感, 模糊, 低清, 水印, 文字, logo, 签名, 边框, 棕榈树畸形, 颜色过饱和, 光晕过强, 鱼眼畸变, 重复人物, 脸部崩坏, 双眼不对称\ncross-eyed, wall-eyed, mismatched gaze, wandering pupils, asymmetrical eyes, lazy eye, deformed eye, extra iris, uneven eyelids, staring"], "inputs": [{"name": "clip", "link": 19, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 35, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 13}], "extra": {"links_added_by_ue": [], "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "frontendVersion": "1.55.17", "ds": {"offset": [-473.56393665514685, -285.4214805233519], "scale": 1.1671841070450024}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "① 模型加载", "bounding": [10, 350, 470, 620]}, {"color": "#3e8e5a", "font_size": 24, "flags": {}, "id": 2, "title": "② 提示词与参考图", "bounding": [590, 350, 1034.779296875, 1617.080322265625]}, {"color": "#c07a3a", "font_size": 24, "flags": {}, "id": 3, "title": "③ 采样参数", "bounding": [1690, 350, 460, 1100]}, {"color": "#b0483f", "font_size": 24, "flags": {}, "id": 4, "title": "④ 采样执行", "bounding": [2250, 350, 460, 470]}, {"color": "#7a4fa0", "font_size": 24, "flags": {}, "id": 5, "title": "⑤ 输出", "bounding": [2770, 350, 660, 760]}], "links": [[1, 2, 0, 7, 0, "CLIP"], [2, 1, 0, 10, 0, "MODEL"], [4, 13, 0, 14, 0, "NOISE"], [5, 10, 0, 14, 1, "GUIDER"], [6, 11, 0, 14, 2, "SAMPLER"], [7, 12, 0, 14, 3, "SIGMAS"], [8, 9, 0, 14, 4, "LATENT"], [9, 14, 0, 15, 0, "LATENT"], [10, 3, 0, 15, 1, "VAE"], [11, 15, 0, 16,