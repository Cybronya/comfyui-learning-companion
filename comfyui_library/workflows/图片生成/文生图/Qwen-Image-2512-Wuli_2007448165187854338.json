htning-4steps-V1.0.safetensors", "directory": "loras", "url": "https://huggingface.co/lightx2v/Qwen-Image-Lightning/resolve/main/Qwen-Image-Lightning-4steps-V1.0.safetensors"}], "ver": "0.3.49", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "secondTabOffset": 80, "Node name for S&R": "LoraLoaderModelOnly", "tabWidth": 65, "secondTabWidth": 65, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "tabXOffset": 10}, "order": 8}, {"mode": 0, "outputs": [{"name": "STRING", "links": [3], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [480, 590], "pos": [475.1692199707031, 275.4296569824219], "widgets_values": ["核心故事： 一位曾完美无瑕的骑士，因诅咒而永世守护着被遗忘女王的陵墓，他的身躯正从内部被黑暗缓慢侵蚀。\n\n提示词：\n一张极具氛围感的暗黑奇幻概念艺术图，风格类似《黑暗之魂》但融合了巴洛克式的精致。画面描绘了一位单膝跪地的“白瓷骑士”，他的全身覆盖着完美无瑕、带有珍珠光泽的瓷质盔甲。然而，盔甲上布满了金缮（Kintsugi）修复般的金色裂纹，从这些裂纹深处，正缓缓渗出如石油般粘稠、有生命质感的黑色阴影触须。他身处一座被洪水淹没的哥特式大教堂内部，冰冷的月光透过破碎的玫瑰花窗，在没过脚踝的水面上投下斑驳的光影。他守护的是一座覆盖着白玫瑰与黑常春藤的石棺。骑士将巨大的双手剑插入地面作为支撑，水面倒映出他扭曲、不详的影子。采用电影感的低角度仰拍，光影呈现强烈的明暗对比（Chiaroscuro），空气中弥漫着肉眼可见的寒冷薄雾，重点渲染瓷器的光滑、阴影的粘稠、水的冰冷与玫瑰花瓣的柔软这四种截然不同的质感。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 15, "type": "PrimitiveStringMultiline", "title": "Prompt", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.5.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [83.8353789676704, -66.37197315855181], "scale": 0.620921323059155}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Model", "bounding": [14