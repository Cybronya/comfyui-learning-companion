反射出柔和的白色高光，手部则被自然的环境光补亮。整体色调为建筑模型的银灰色、玻璃幕墙的淡蓝色、绿地的鲜绿色、河道的深蓝色与手部的暖肤色交织，光影、比例反差与精致模型共同营造出一种童趣、精巧且充满掌控感的微缩城市视觉体验。宽幅构图强化了沙盘从左侧近景到右侧远景的横向全景感，以及真实手部与微缩建筑之间的尺度对比张力。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 107, "type": "PrimitiveStringMultiline", "title": "String (Multiline - Prompt)", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 9}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.42.11", "VHS_latentpreview": false, "ds": {"offset": [-247.34128994898686, 521.8132433313344], "scale": 1.8797616762370477}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "Text to Image", "bounding": [690.4856567382812, 496.85467529296875, 1986.4691162109375, 1077.9122314453125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Image Size", "bounding": [720.4856567382812, 1236.854736328125, 310, 290]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Prompt", "bounding": [1040.4857177734375, 546.8546752929688, 470, 670]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Model", "bounding": [710.4856567382812, 546.8546752929688, 320, 670]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "Prompt Enhancement", "bounding": [690.4856567382812, -423.14532470703125, 1450, 890]}, {"color": "#b58b2a", "font_size": 80, "flags": {}, "id": 7, "title": "👉用我的邀请码注册送1000RH币👉邀请码：3qo6