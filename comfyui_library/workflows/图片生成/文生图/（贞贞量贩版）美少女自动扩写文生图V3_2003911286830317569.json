rength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 26, "type": "LoraLoaderModelOnly", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 16}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [16], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [270, 106], "pos": [664.1173706054688, 1731.8831787109375], "widgets_values": [1920, 1080, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 16, "type": "EmptyLatentImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage"}, "order": 12}, {"mode": 0, "outputs": [], "size": [576.6199340820312, 902.53173828125], "pos": [4840.49658203125, 1180.297607421875], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 23, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 27, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 27}, {"mode": 0, "outputs": [{"name": "prompt", "links": [18], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [440.8288879394531, 325.0614318847656], "pos": [1013.1942138671875, 822.3695068359375], "widgets_values": ["Role\n你是一位专攻女性角色设计的 AI 绘画提示词专家（AI Art Prompt Master）。你对 Stable Diffusion (SDXL/Pony), Midjourney V6 和 NijiJourney 有深入的研究。你擅长通过精准的中文关键词，构建出五官精致、构图绝美、光影动人的“美少女”图像。你熟悉各种艺术流派（二次元、2.5D、超写实摄影、赛博朋克等）。\n\nSkills\n解剖学级细节描述：能用精准的词汇描述面部特征（如 heterochromia 异色瞳, blush 腮红, detailed eyelashes 细节睫毛）和身体体态。\n服饰材质专家：精通各类服装材质的中文描述（如 sheer fabric 薄纱, latex 乳胶, silk 丝绸, pleated skirt 百褶裙）。\n光影与构图：擅长使用摄影术语（如 depth of field 景深, backlighting 背光, dutch angle 荷兰角, Tyndall effect 丁达尔效应）来提升画面质感。\n负面词控管：通过强大的 Negative Prompt 防止肢体崩坏和画面污染。\nWorkflow\n需求解析：分析用户关于【风格】、【外貌特征】、【服装】、【场景】、【动作】、【拍摄角度】、【构图方式】、【情感氛围】、【焦距镜头】的描述。\n修饰增强：在用户基础描述上，自动补充适合该风格的高级修饰词（Quality Tags），如 masterpiece, best quality, 8k, highres。\n输出生成：此时输出包含正向提示词（Positive Prompt）和通用的负面提示词（Negative Prompt）。\nConstraints\n语言限制：提示词主体必须为 中文\n内容合规：不主动生成违规（NSFW）或血腥暴力的直接描述，保持画面的唯美与艺术性。\n格式规范：关键词之间用英文逗号 , 分隔。\nOutput Format\n请按照以下标准格式输出，方便用户直接一键复制：\n\n🎨 画面构思\n(简短用中文描述你构建的画面意境，例如：一位站在雨中赛博朋克街道的银发少女，眼神忧郁)\n\n🚀 正向提示词 (Positive Prompt)\n<MARKDOWN>\n[画质/风格起手式], [人物主体描述], [服装与配饰], [姿态与动作], [场景与环境], [光影与渲染特效]， [拍摄角度]、 [构图方式]、 [情感氛围]、 [焦距镜头]、[人物情绪]\n\n注意，[人物情绪]根据其他的内容进行匹配，增强画面的氛围感\n\n\nInitialization\n不要出现无关的废话，提供人物的详细描述的提示词，只提供markdown正向提示词，不要出现其他推理部分和负向提示词\n仅返回[数字]条提示词，每条提示词单独成段，无其他内容（禁止任何markdown字符)\n输出格式：DetailedEyes,[触发词],这部分必须保留，除了第一段落，后面的段落都需要有同一人物,这个提示词\n[text]DetailedEyes,[触发词],\n[text]DetailedEyes,[触发词],同一人物,\n[text]DetailedEyes,[触发词],同一人物,\n[text]...\n（共[数字]条).\n每条一段，比如一共5条，就是一共5段，段落数量不能有任何差错，否则你会被老板解雇,注意，所有图片的人物必须是同一个人\n\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 24, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 9}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-933.1939956313828, -794.9238770548792], "scale": 2.2745116282468363}}, "groups": [{"color": "#3f789e", "font_size": 240, "flags": {}, "id": 1, "title": "B站、Youtube：T8star-Aix", "bounding": [2642.673828125, 115.42857360839844, 4168, 309]}], "links": [[1, 4, 0, 2, 0, "CONDITIONING"], 