nnectable": {}, "version": "7.5.2"}, "secondTabOffset": 80, "Node name for S&R": "CLIPLoader", "tabWidth": 65, "secondTabWidth": 65, "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "secondTabText": "Send Back", "enableTabs": false, "tabXOffset": 10}, "order": 19}, {"outputs": [{"name": "VAE", "links": [64], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "color": "#432", "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "type": "VAELoader", "mode": 0, "bgcolor": "#653", "size": [440, 58], "pos": [-627.130126953125, 556.2281494140625], "id": 1, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"directory_invalid": true, "name": "ae.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/vae/ae.safetensors"}], "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "secondTabOffset": 80, "Node name for S&R": "VAELoader", "tabWidth": 65, "secondTabWidth": 65, "widget_ue_connectable": {"vae_name": true}, "secondTabText": "Send Back", "enableTabs": false, "tabXOffset": 10}, "order": 20}, {"outputs": [], "color": "#323", "widgets_values": ["4. 这个工作流的具体作用\n第一阶段：用 Z-image 快速生成 “樱花树下女孩” 的整体构图和氛围。\n第二阶段：用 UV20/Reality 模型在这个基础上，强化皮肤质感、服饰细节、光影层次，让画面更写实、更有质感。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#535", "size": [566.3015747070312, 199.13233947753906], "pos": [2704.281494140625, 849.838623046875], "id": 68, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}}, "order": 21}, {"outputs": [], "color": "#322", "widgets_values": ["z_image_bf16 偏向快速推理、轻量化，对负面提示词更不敏感，省略后影响更小。\nZIT - Remix Reality v20 偏向写实人像，适当加负面提示词能减少面部崩坏、肢体畸形。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#533", "size": [345.529541015625, 109.65279388427734], "pos": [917.2551879882812, 702.2332153320312], "id": 84, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}}, "order": 22}, {"outputs": [], "color": "#323", "widgets_values": ["1. 工作流结构拆解\n可以看到：\n模型区：加载了两个不同的主模型\nZly_image_bf16.safetensors（Z-image）\nZIZIT - Remix Reality v20.safetensors（UV20/Reality）\n采样区：两个独立的高级采样器（K 采样器）\n第一步：使用 Z-image 模型，采样步数少（12 步），只做前 3 步\n第二步：使用 UV20 模型，采样步数多（10000 步），从第 1 步开始"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#535", "size": [566.3015747070312, 199.13233947753906], "pos": [861.62109375, 864.2244873046875], "id": 65, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}}, "order": 23}, {"outputs": [], "color": "#323", "widgets_values": ["2. 双采样的核心逻辑\n第一阶段（打稿 / 构图）\n用 Z-image 这类擅长快速构图的模型，在少量步数内（如前 3 步）完成整体构图、人物姿态和场景布局。\n特点：速度快，能快速锁定画面大方向，但细节粗糙。\n第二阶段（精修 / 细节）\n把第一阶段生成的潜空间（Latent）传给第二个采样器，用 UV20/Reality 这类细节表现力强的模型继续采样。\n特点：在已有构图基础上，补充纹理、光影、材质等细节，提升画质。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#535", "size": [590.7888793945312, 204.69760131835938], "pos": [1444.5028076171875, 859.9103393554688], "id": 66, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}}, "order": 24}, {"outputs": [], "color": "#323", "widgets_values": ["3. 为什么要这么做？\n解决单一模型的局限：有的模型擅长构图，有的擅长细节，双采样可以 “扬长避短”。\n提升可控性：先定好大框架，再精细打磨，避免一步到位时构图和细节互相干扰。\n优化显存与速度：第一阶段用轻量模型快速出图，第二阶段再用重模型精修，比全程用重模型更省资源。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#535", "size": [566.3015747070312, 199.13233947753906], "pos": [2083.57421875, 858.1112060546875], "id": 67, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}}, "order": 25}, {"outputs": [{"name": "CONDITIONING", "links": [72], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["一位年轻亚洲女孩站在公园小径上，拥有齐刘海黑直长发，头发光滑顺直分成双马尾，用细发绳轻轻束起，发尾自然垂落到肩部，脸型为柔和瓜子脸，大眼睛水汪汪带有双层眼睑，睫毛浓密上翘，鼻子小巧挺直，嘴唇粉嫩微翘，露出温柔甜美的微笑，脸颊微微泛红，皮肤白皙细腻无瑕疵，颈部修长优雅，身材苗条匀称，肩膀自然下垂，双臂微微弯曲自然下垂，手臂线条柔和，手掌放松自然握持肩部位置。\n\n她穿着浅粉色宽松风衣外套，袖口宽大蓬松延伸到手腕以下，衣领为白色翻领衬衫，衬衫领口整齐扣紧，风衣前襟微敞露出内搭白色衬衫，风衣下摆宽松及膝，右手提着一个米色编织草编手提包，包身粗糙编织纹理自然垂挂在身体右侧，左手自然下垂，整体姿态轻松站立，身体微微前倾，头部正面对镜头轻微侧转，膝盖微曲，双腿并拢站立，脚部穿着浅色鞋子，鞋面简洁光滑，整体动态感柔和闲适，展现出可爱日常的少女风范。\n\n背景为户外公园小径，地面为灰色水泥铺就的平直步道，两侧排列白色金属护栏，护栏后是干燥冬季树木，树干粗壮弯曲枝叶稀疏泛黄，左侧远处一棵巨大乔木高耸入云，树冠茂密层层叠叠，右侧远处可见红色拱形桥梁横跨上方，桥身铁锈斑驳结构清晰，桥下有细密金属网状围栏，远方天空湛蓝渐变到浅灰色云层，氛围宁静温暖的午后时光，空间布局中女孩居中前景，小径向远方延伸，树木和桥梁位于中后景形成纵深感。\n\n画面采用高度写实摄影风格，色彩基调以粉嫩柔和的浅粉白灰为主，粉色衣物与蓝色天空形成温柔对比，整体氛围清新可爱充满少女气息，光线从左侧上方自然洒落，形成柔和侧光，脸部高光细腻自然，阴影柔软过渡无硬边，树木边缘光晕温暖扩散，材质质感真实细致，皮肤表面光滑带有细微绒毛纹理，风衣棉质布料柔软垂坠形成自然褶皱层层叠加，草编包表面粗糙纤维清晰可见，手臂皮肤紧致富有弹性，头发丝缕分明反光自然。\n\n构图为中景居中对称构图，相机采用50mm标准镜头，f/2.8光圈浅景深，焦点精准锁定女孩面部和上半身，背景轻微虚化增强主体突出感，画面细节极致锐利，纹理密度高保真还原，每一缕头发、每一道布料褶皱、每一片树叶脉络皆清晰可见，整体高质量专业摄影级别，色彩饱和度适中自然过渡，光影层次丰富立体感强。"], "inputs": [{"name": "clip", "link": 67, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [506.8186950683594, 396.9236755371094], "pos": [841.6768188476562, 24.602893829345703], "id": 5, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 29}, {"outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["一位威严持重的唐代男性丞相，身着紫色章服，宽袖博带，腰系金玉带，头戴进贤冠，面容方正沉稳，目光深邃，立于太极殿丹陛之上，身后是朱红宫墙与飞檐斗拱，晨光透过殿门洒在他的朝服上，衣料暗纹与玉带光泽清晰可见，整体气质庄重肃穆，兼具文人风骨与宰辅威仪，写实人像，8K，超精细，电影感光影。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [-255.48513793945312, 1215.415283203125], "id": 69, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 26}, {"outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#323", "widgets_values": ["一位年轻亚洲女性正面站立于明亮艺术工作室中，她拥有精致的瓜子脸庞，皮肤白皙光滑细腻无瑕疵，带有自然红润光泽，大大的杏仁形双眼眸子清澈明亮，眼睫毛浓密卷翘上扬，眼角微微上挑呈现温柔魅力，细长的柳叶眉自然舒展，鼻梁高挺小巧精致，鼻翼柔和对称，樱桃小嘴粉嫩饱满微微上扬形成甜美微笑，露出一排整齐洁白的牙齿，黑色的齐刘海直发顺滑浓密覆盖额头，长直发披散至肩部自然微卷层层分明，刘海两侧自然垂落耳边形成空气刘海效果，整体发丝富有光泽丝滑不打结。\n\n她身穿浅粉色泡泡袖短袖上衣，衣料棉质柔软光滑表面平整细腻，领口处宽大白色蕾丝花边层层叠加立体蓬松，袖口同样饰以白色蕾丝褶皱层层卷曲富有弹性，衣身正面平滑贴合胸部曲线自然微隆起，下摆自然垂落至腰部微微外翻，右手腕佩戴粉色宽布手环表面光滑柔软边缘微卷，脖子上挂一条细金链项链坠饰为金黄色水滴形宝石晶莹剔透多面反射光芒，双手自然下垂于身体两侧，手臂微微弯曲肘关节自然放松，手掌张开手指细长匀称指甲修剪整齐无涂层，身体整体姿态轻松站立，双腿并拢膝盖微曲脚踝稳定支撑，头部正对前方微微前倾眼神直视镜头传递亲切活泼动态感，肩膀自然放松胸部微微前挺腰部纤细收紧臀部圆润上翘形成完美S形曲线。\n\n背景为温暖舒适的室内艺术工作室，左侧墙壁贴满多彩手绘插画包括抽象几何图案鲜艳红黄蓝绿调色板，卡通人物头像大眼睛夸张表情线条流畅，绿色植物叶片茂密藤蔓缠绕自然垂挂，右侧墙上悬挂多幅彩色画作抽象花卉图案层层晕染富有质感，木质相框边缘雕花精致表面光滑，墙角摆放红色小麋鹿玩偶毛绒柔软四肢匀称耳朵竖立，绿色盆栽叶片宽大翠绿茎秆粗壮容器陶瓷白釉光泽，书桌表面木纹清晰堆放彩色马克杯杯身印卡通图案把手弧形舒适，白色窗帘轻纱半透明自然褶皱随风微动，窗户外透入自然日光柔和温暖，地面铺设浅色木地板纹理细密光滑反射柔光，整体空间布局紧凑富有艺术气息层次分明前后景深自然过渡。\n\n画面采用写实摄影风格，色彩基调温暖明亮以粉色橙黄色调为主导，浅粉色衣物与彩色画作形成柔和互补，整体氛围轻松可爱富有生活气息，光影效果自然窗光从左侧上方倾泻形成柔和侧光，高光区集中在脸颊鼻梁项链上呈现丝滑渐变过渡，阴影柔软自然分布于颈部下巴轮廓处增强立体感，色温温暖偏黄营造舒适亲和力，构图居中特写主体占画面2/3空间，背景元素环绕填充不杂乱，相机模拟50mm标准镜头f/2.8光圈浅景深效果，主体对焦极致锐利细节丰富，皮肤毛孔纹理清晰可见，蕾丝花边纤维丝线分明立体，画作颜料笔触粗细不均真实，手发丝缕光泽反射自然，材质质感高度还原棉布柔软垂坠感蕾丝透明蓬松度金饰金属冷峻光泽，纹理密度高皮肤细腻多层渐变毛发根根分明衣褶自然折痕深刻，画面整体高清精细无噪点无畸变无水印，摄影级品质锐度完美捕捉每一个像素细节。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#535", "size": [458.55645751953125, 616.2022705078125], "pos": [1149.363525390625, 1180.0516357421875], "id": 85, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 27}, {"outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#323", "widgets_values": ["一位年轻亚洲女性，拥有精致的瓜子脸型，细长的柳叶眉，大而圆润的杏仁眼，眼眸深邃水润闪烁自然光芒，高挺的鼻梁，樱桃小嘴微微上扬形成甜美微笑，脸颊光滑粉嫩带有自然红晕，齐刘海直发刘海整齐覆盖额头，长直黑发顺滑垂落至胸前，发丝细腻光泽自然分层飘逸，头上戴着鲜艳大红色缎面蝴蝶结发卡，蝴蝶结两翼宽大对称边缘微卷富有立体感，颈部佩戴细银链细项链坠落小巧心形吊坠，穿着oversize红色毛衣，毛衣采用粗针织纹理表面蓬松柔软，领口高领包裹颈部，衣领处有三颗黑色圆形塑料纽扣垂直排列，袖口宽松下垂自然卷边，长袖覆盖至手腕以下，整体毛衣宽松合身突出肩部线条，双手自然前伸掌心向上手指微张弯曲成可爱抓握状，指甲修剪整齐无涂色，姿势为上身微微前倾头部轻抬眼神直视前方传达活泼俏皮氛围，身体站立姿态放松双肩自然下沉腰部挺直双腿并拢隐于衣摆后方，场景置于室内白色推拉衣柜前，衣柜双门半开露出内部整洁衣物堆叠，柜门表面光滑哑光白色无纹理，左侧墙壁深灰色哑光漆面平整无装饰，右侧悬挂金色流苏装饰串珠状排列层层垂坠闪烁微光，地面浅木纹地板反射柔和光线，整体构图居中特写上半身人物占比画面80%，背景元素清晰可见空间感强，前方自然柔和主光源从左侧45度角照射形成脸部右侧高光轮廓左侧柔和阴影过渡自然，眼部高光点亮瞳孔毛衣表面纤维反射细腻光泽，色彩基调温暖鲜亮以红色为主调搭配白色灰色辅助，黑发对比鲜明，画面采用写实摄影风格高饱和度自然滤镜无畸变，相机模拟Canon EOS 5D Mark IV全画幅传感器，85mm定焦镜头f/1.8大光圈浅景深前景人物极致锐利对焦背景微虚化保持细节可见，纹理密度极高皮肤毛孔细腻可见毛衣针织线条分明发丝根根分明，材质质感真实柔软毛衣纤维蓬松有弹性发丝丝滑不打结银链金属冷光反射，整体氛围甜美可爱温暖亲切，画面细节丰富层次分明构图平衡对称无水印无无关元素，超高分辨率8K品质锐度完美光影自然流畅动态捕捉精准。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#535", "size": [446.8722229003906, 430.00128173828125], "pos": [1643.45556640625, 1174.0687255859375], "id": 86, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 28}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links":