e_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 1}, {"mode": 0, "outputs": [{"name": "describe", "links": [3742, 9203], "label": "describe", "type": "STRING", "localized_name": "describe"}], "size": [395.853271484375, 553.7460327148438], "pos": [1490.7532958984375, -634.7929077148438], "widgets_values": ["", "", "", "【输入方式】：参考图 + 文本描述  \n【延展目标】：基于上一张图的画面风格、人物外形、光影氛围、镜头语言，生成下一张分镜图，使得剧情延续\n\n保持人物外观一致  \n色调光影与参考图统一  \n背景元素延续，不突变  \n构图具备电影感（景别 / 光影 / 空间层次）\n\n镜头类型（特写 / 中景 / 远景 / 俯拍 / 跟拍 / 环绕 / 侧移 / 拉远）  \n镜头运动节奏（慢推 / 快切 / 手持感）  \n\n人物发色、身形不变  \n服饰延续衔接，不跳变  \n动作表情是上一个镜头的自然推进  \n背景环境连续递进\n\n高清画面  \n电影级光影  \n真实材质  \n无噪点无畸变  \n可作为下一张分镜生成基础\n\n输出时以Next Scene:开头，后面马上接文字。每一段文字是连续的，没有特殊符号，没有多余的解释，每一段文字100字左右，直接输出内容", "这是一个古装美女仙侠电影，参考图片，帮我写8个接下来的分镜", 0.6, 396, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "link": 9977, "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 3921, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 95, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 18}, {"outputs": [{"shape": 6, "name": "STRING", "links": [3063, 3064], "label": "字符串", "type": "STRING", "localized_name": "字符串"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#233", "widgets_values": ["Next Scene: 左手举至胸前，比出 “中指”\nNext Scene: 单腿站立（右腿支撑），左腿向后弯曲抬起，双手向后轻触左脚脚踝，裸足，身体形成优美的弧线，融入柔美感\nNext Scene: 面对大桥栏杆，双手张开平贴在栏杆上，身体微微倾斜，头部靠近手臂，眼神透过手臂间隙看向镜头，为画面增添故事感\nNext Scene: 面朝镜头，坐于大桥地面上，裸足，双腿伸直并拢，身体向后仰、以手掌支撑地面，头部微微后仰，展现背部线条，与街头地面、环境形成互动\nNext Scene: 动态迈步，裸足，左腿向前迈出，身体略微向侧前方倾斜，手臂自然摆动，盘发因走动带起轻微弧度，捕捉 “行走中” 的潮流瞬间\nNext Scene: 侧身倚靠桥头栏杆，裸足，左腿伸直、右腿弯曲，左臂搭在栏杆上，手腕的手镯随动作轻晃，慵懒又具时尚范儿。\nNext Scene: 保持半蹲姿态，双手撑在膝盖上，头部抬起，眼神坚定直视镜头，裸足稳稳扎根地面，融合力量感与性感。\nNext Scene: 背对镜头，双手抬至脑后整理盘发，腰部轻轻扭转，露背旗袍的线条充分展现。\nNext Scene: 单膝微微屈膝、身体前倾，右手抓握旗袍裙摆，左手自然垂落，头部转向身体侧面，仿佛即将迈步，带出动感张力。\nNext Scene: 站立于上海滩的夜景前，身体侧身，左手掀起旗袍露出臀部，右手轻搭栏杆，头部微侧，眼神慵懒凝视镜头。", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "link": 3744, "label": "提示词", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "type": "INT", "localized_name": "最大行数"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [236.76014709472656, 359.7953796386719], "pos": [1245.0291748046875, -964.9381713867188], "id": 76, "properties": {"cnr_id": "comfyui-easy-use", "ver": "8ecc929cd41cf0f7ef6fcc45d4bbc5729c6f287f", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"start_index": true, "max_rows": true, "prompt": true}, "Node name for S&R": "easy promptLine"}, "order": 23}, {"outputs": [{"name": "CONDITIONING", "links": [75], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#223", "widgets_values": [""], "inputs": [{"name": "clip", "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image1", "lin