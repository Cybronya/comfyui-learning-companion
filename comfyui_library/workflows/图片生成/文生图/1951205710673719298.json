": 0, "bgcolor": "#653", "size": [520, 390], "pos": [-1322.3780517578125, 411.4619140625], "id": 43, "properties": {}, "order": 4}, {"mode": 4, "outputs": [{"name": "MODEL", "links": [], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [381.7544250488281, 87.32166290283203], "pos": [-320, 150], "widgets_values": ["flux1-krea-dev.safetensors", "fp8_e4m3fn_fast"], "inputs": [], "flags": {}, "id": 38, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.40", "Node name for S&R": "UNETLoader"}, "order": 5}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [75], "label": "MODEL", "type": "MODEL", "localized_name": "模型"}], "size": [412.1375427246094, 221.2474822998047], "pos": [-770.160888671875, 151.1385040283203], "widgets_values": ["svdq-int4_r32-flux.1-krea-dev.safetensors", 0, "nunchaku-fp16", "auto", 0, "bfloat16", "enabled"], "inputs": [], "flags": {}, "id": 56, "type": "NunchakuFluxDiTLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "NunchakuFluxDiTLoader"}, "order": 6}, {"mode": 0, "outputs": [{"name": "STRING", "links": [72], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [274.9069519042969, 158.53268432617188], "pos": [100.92940521240234, 174.73138427734375], "widgets_values": ["中国女子，在一间现代化且宽敞明亮的健身房里，地面铺着深灰色的防滑橡胶地砖，墙壁上挂着几面巨大的镜子，反射出室内的景象，增加了空间的开阔感。四周摆放着各种健身器材，跑步机有节奏地运转着，哑铃架上整齐排列着不同重量的哑铃。\n\n一位美女正在健身房的角落做俯卧撑。她身着一套紧身的健身运动装，上衣是一件亮粉色的运动背心，采用弹性十足的莱卡面料，完美贴合身体曲线，凸显出她健美的身材。背心上有黑色的线条装饰，勾勒出独特的图案，增添了几分时尚感。下身搭配一条黑色的运动短裤，短裤边缘有粉色的包边，与上衣相互呼应。短裤的长度恰到好处，展现出她修长而紧实的大腿。她脚蹬一双白色的运动鞋，鞋面上有粉色的线条点缀，鞋底的减震设计让她在运动中更加舒适。\n\n美女留着一头利落的马尾辫，随着她的动作有节奏地摆动。额前几缕碎发被汗水浸湿，贴在皮肤上，更显运动的活力。她头上戴着一个黑色的运动束发带，既能固定头发，又能防止汗水流入眼睛。耳朵上戴着一对小巧的银色圆环耳环，在灯光下闪烁着微光。手腕上戴着一只智能运动手环，随时记录她的运动数据。\n\n特写美女的面部，她的眼睛明亮而坚定，双眸犹如深邃的湖水，透露出专注与执着，此时正紧紧盯着前方的地面，专注于自己的动作。眉毛微微皱起，彰显出她在运动中的认真与投入。高挺的鼻梁让面部更具立体感，嘴唇微微张开，均匀地喘着气，嘴角带着一丝自信的微笑，似乎在享受运动带来的挑战。她的皮肤呈现出健康的小麦色，泛着细密的汗珠，在健身房明亮的灯光下散发着迷人的光泽，凸显出她充满活力的肌肤质感。\n\n此刻，美女双手撑地，与肩同宽，手臂微微弯曲，身体保持一条直线，从侧面看，她的背部、臀部和腿部形成一条优美的弧线。她正在缓缓下压身体，每一个动作都充满力量感，展现出坚韧的毅力。画面采用对角线构图，从画面左下角美女的手部延伸至右上角她的脚部，以低视角拍摄，突出美女的力量感和身材的修长，营造出积极向上的健身氛围。\n\n景深方面，将焦点聚焦在美女身上，使她清晰锐利，前景的部分地面和背景的健身器材适度虚化，引导观者的视线集中在美女身上，突出主体。光线来源于健身房顶部均匀分布的白色灯光，灯光均匀地洒在美女身上，没有明显的阴影，全方位展现她的身体线条和动作细节，营造出明亮、充满活力的情感氛围，彰显出她在健身房中积极锻炼、追求健康与美的精神风貌。整个健身房的环境与做俯卧撑的美女相结合，共同构成一幅充满活力与动感的画面。"], "inputs": [], "flags": {}, "id": 53, "type": "Text Multiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.25.2", "VHS_latentpreview": false, "ds": {"offset": [595.4955255440445, -49.72099688068127], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "文生图", "bounding": [-330, 80, 1380.292724609375, 884.9708862304688]}, {"color": "#3f789e", "font_size": 120, "flags": {}, "id": 4, "title": "欢迎关注【破狼】公众号", "bounding": [-362.5667724609375, -183.0753631591797, 1391.3287353515625, 224.29611206054688]}], "links": [[9, 8, 0, 9, 0, "IMAGE"], [52, 31, 0, 8, 0, "LATENT"], [58, 39, 0, 8, 1, "VAE"], [63, 42, 0, 31, 2, "CONDITIONING"], [64, 40, 0, 45, 0, "CLIP"], [65, 45, 0, 31, 1, "CONDITIONING"], [66, 45, 0, 42, 0, "CONDITIONING"], [71, 52, 4, 31, 3, "LATENT"], [72, 53, 0, 54, 0, "STRING"], [73, 54, 0, 55, 0, "*"], [74, 54, 0, 45, 1, "STRING"], [75, 56, 0, 31, 0, "MODEL"]], "id": "908d0bfb-e192-4627-9b57-147496e6e2dd", "config": {}, "version": 0.4, "last_node_id": 56, "revision": 0}