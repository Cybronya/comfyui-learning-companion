: "CONDITIONING", "links": [], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [334.91693115234375, 321.3169860839844], "pos": [1476.20556640625, -20.117279052734375], "widgets_values": ["右侧是身着华丽唐代服饰的女子，红袍配金纹、绿飘带，头戴精致凤冠，缀流苏等配饰，尽显古典优雅，似关联 “长安” 的唐代背景。\n荔枝：前景是颗巨型荔枝，外壳红且带金色纹理，部分剥开露出莹白果肉，夸张化呈现，成为视觉焦点，呼应 “荔枝” 主题 。\n背景：有云朵元素，增添飘逸、古典氛围，丰富画面层次。\n色彩搭配\n主色调为红、金、绿、青，红色（人物服饰、荔枝外壳 ）热烈，金色（文字、服饰纹样、荔枝纹理 ）华贵，绿色（飘带、背景底色 ）、青色（云朵 ）清新，冷暖色调交织，既显古典韵味，又具视觉冲击力。\n文字样式和排版\n文字内容：“长安的荔枝”，点明主题。\n样式：字体为金色书法体，笔画有粗细变化、飞白效果，具传统艺术感。\n排版：居于画面左侧上方，竖排布局，与右侧人物、下方荔枝形成平衡，突出主题，强化国风意境 。 整体通过元素、色彩、文字融合，营造出古典且富有故事感的国风氛围，关联《长安的荔枝》的历史文化语境。"], "inputs": [{"name": "clip", "link": 18, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 16, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 9}, {"mode": 4, "outputs": [], "size": [330.7999267578125, 455.5999755859375], "pos": [1480.37939453125, 370.30548095703125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 20, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 17, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 18}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [6, 7, 12, 15, 18, 21, 24, 27], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [270, 106], "pos": [24.816631317138672, 132.58680725097656], "widgets_values": ["qwen_2.5_vl_7b_fp8_scaled.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape