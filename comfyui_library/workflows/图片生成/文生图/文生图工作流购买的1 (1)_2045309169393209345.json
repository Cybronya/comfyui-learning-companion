], "color": "#222", "widgets_values": ["8K超高清，极致写实真人人像，电影级柔和画质，索尼A7M4拍摄，f/1.8大光圈，零噪点，超高细节完整还原，竖版9:16构图，发丝纹理、布料纹路清晰细腻\n人物：自然站立年轻东亚甜妹，身形瘦小单薄，极致纤瘦骨架，窄肩薄背，纤细蚂蚁腰，纤细匀称漫画细腿，腿部线条纤细不粗壮，完美小头身比，小巧精致巴掌小脸；柔和精致原生五官，清淡伪素颜淡妆，通透冷白皮，柔光磨皮+通透自然美白效果，肌肤细腻水润自带柔光光泽，干净柔和眼神光，清甜温柔表情\n发型：深棕黑色柔顺双马尾长发，发丝蓬松顺滑富有光泽，发丝根根分明，双马尾自然垂落在肩前，轻薄碎刘海修饰脸颊\n穿搭：米白底藏青色横条纹修身V领吊带背心，胸前印有黑色蕾丝蝴蝶结印花，紧身收腰贴合身形；深色水洗牛仔短裤，裤脚翻卷毛边细节完整，衣物褶皱自然贴合身体；脖颈佩戴细链银色小星星吊坠项链；顶部柔和白色顶光垂直洒落，完整覆盖照射在整件上衣，衣身清晰显现灯光光斑、柔和反光，光线重点提亮衣服面料\n背景：夜晚居家室内场景，整体环境微暗低亮度，左侧纯白色哑光墙面，右侧浅卡其色木门搭配黑色细门框，浅灰色哑光瓷砖地面，完整保留原图背景结构，环境干净简约，整体氛围感高级柔和\n光影灯光：夜间微弱低亮度环境光，全屋氛围静谧温柔，弱侧柔光轻轻勾勒发丝与肩颈轮廓，顶部定点柔和白灯集中打在衣服表面，布料上灯光照射痕迹清晰可见，均匀柔光提亮人物皮肤，光影层次细腻有对比；温柔奶油低饱和氛围感滤镜，夜晚居家治愈氛围感拉满，环境微暗不漆黑，无大面积死黑阴影、无高光过曝，局部灯光突出衣身质感，整体氛围温柔高级\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#000", "size": [449.843017578125, 590.9181518554688], "pos": [1151.9957275390625, 197.5783233642578], "id": 45, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 5}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [889.7494303385415, 603.8514895968967], "scale": 0.45}}, "groups": [{"color": "#ffffff", "font_size": 35, "flags": {}, "id": 1, "title": "Z-文生图", "bounding": [1126.69775390625, 100.16514587402344, 1124.096923828125, 962.9568481445312]}], "links": [[85, 57, 0, 51, 0, "LATENT"], [86, 53, 0, 51, 1, "VAE"], [87, 56, 0, 57, 0, "MODEL"], [88, 58, 0, 57, 1, "CONDITIONING"], [89, 54, 0, 57, 2, "CONDITIONING"], [90, 52, 0, 54, 0, "CLIP"], [91, 55