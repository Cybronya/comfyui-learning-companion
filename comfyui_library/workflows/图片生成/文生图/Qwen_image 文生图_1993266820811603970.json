nnectable": {"replace1": true, "find3": true, "find1": true, "replace3": true, "find2": true, "replace2": true}, "Node name for S&R": "CR Text Replace"}, "order": 14}, {"mode": 0, "outputs": [{"name": "prompt", "links": [21], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [300, 290], "pos": [-140, 610], "widgets_values": ["简单描述：【tip】\n\n您是一位创意提示工程师。请根据上面面给出的简单描述，为 AI 图像生成扩写出一条随机、高质量、自然流畅的【language】提示。\n\n高质量提示的公式为：\n\n风格/艺术形式 + 景别 + 主题 + 视觉元素的分层描述（构图、色彩和色调、光照、纹理和材质） + 环境 + 氛围 + 细节 + 质量要求。\n\n请确保每次生成的提示都独一无二、各不相同，涵盖多种风格（例如：水彩、赛博朋克、超现实主义、动漫、照片写实主义）、景别（例如：特写、近景、中景、远景、全景、广角等）、主题和环境。避免在不同版本中重复使用相同的风格或主题。\n\n您的回复必须包含一条完整、简洁的提示，可直接用于 Stable Diffusion 或 Midjourney，无需对话式文本、解释或额外格式。\n\n示例输出：\n\n1. 水彩画，全景，宁静的荷塘，锦鲤游弋，柔和的粉彩色调，清晨的阳光轻柔，水面泛起细腻的涟漪，绿意盎然，氛围静谧，细节精致，博物馆级别的艺术作品。\n\n2. 赛博朋克数字艺术，特写，一位未来武士置身于霓虹闪烁的城市，充满活力的蓝粉色调，湿漉漉的街道反射着光芒，动感的构图，高科技盔甲细节，强烈的氛围，照片级写实品质。\n\n3. 超现实主义，远景，一座漂浮的岛屿，繁花似锦，梦幻般的天空旋转，柔和的光芒，流畅的有机纹理，神秘的氛围，超精细的细节，屡获殊荣的艺术作品。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 25, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "prompt", "links": [28], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [300, 108], "pos": [-140, 440], "widgets_values": ["中文"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 27, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ce