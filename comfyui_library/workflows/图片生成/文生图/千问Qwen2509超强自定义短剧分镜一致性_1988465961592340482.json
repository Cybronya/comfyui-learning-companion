比20%）。风沙加剧（速度0.8cm/s），色彩青灰60%+暖黄10%+朱红10%+冷黑20%。\nNext Scene: 【风格：中国水墨写实风】特写，图1的日记本（破旧，页面泛黄），写着“爹娘，我好想你们”，字迹被泪水晕开（晕开面积2cm²）。手指冻红（指节肿大0.3cm）。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "Text Multiline", "mode": 0, "bgcolor": "#355", "size": [297.4143371582031, 367.9878234863281], "pos": [-920.5905151367188, 316.057861328125], "id": 141, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 6}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [12069, 12070, 12071, 12072, 12073, 12074, 12075], "VHS_MetadataImage": true, "ue_links": [{"controller": 111, "upstream": "110", "downstream_slot": 1, "downstream": 60, "upstream_slot": 0, "type": "VAE"}, {"controller": 111, "upstream": "107", "downstream_slot": 0, "downstream": 68, "upstream_slot": 0, "type": "CLIP"}, {"controller": 111, "upstream": "110", "downstream_slot": 1, "downstream": 68, "upstream_slot": 0, "type": "VAE"}, {"controller": 111, "upstream": "107", "downstream_slot": 0, "downstream": 61, "upstream_slot": 0, "type": "CLIP"}, {"controller": 111, "upstream": "110", "downstream_slot": 1, "downstream": 61, "upstream_slot": 0, "type": "VAE"}, {"controller": 111, "upstream": "110", "downstream_slot": 1, "downstream": 69, "upstream_slot": 0, "type": "VAE"}, {"controller": 111, "upstream": "109", "downstream_slot": 0, "downstream": 56, "upstream_slot": 0, "type": "MODEL"}], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [774.5382631945604, 1046.7763733776833], "scale": 0.45000000000000046}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "主程序", "bounding": [-1330.1143798828125, -428.30682373046875, 5173.24853515625, 1511.7418212890625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "参考文本", "bounding": [-268.3087158203125, 481.338195