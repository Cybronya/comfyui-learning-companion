ocalized_name": "latent_image"}, {"widget": {"name": "add_noise"}, "name": "add_noise", "label": "add_noise", "type": "COMBO", "localized_name": "add_noise"}, {"widget": {"name": "noise_seed"}, "name": "noise_seed", "label": "noise_seed", "type": "INT", "localized_name": "noise_seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "start_at_step"}, "name": "start_at_step", "label": "start_at_step", "type": "INT", "localized_name": "start_at_step"}, {"widget": {"name": "end_at_step"}, "name": "end_at_step", "label": "end_at_step", "type": "INT", "localized_name": "end_at_step"}, {"widget": {"name": "return_with_leftover_noise"}, "name": "return_with_leftover_noise", "label": "return_with_leftover_noise", "type": "COMBO", "localized_name": "return_with_leftover_noise"}], "flags": {}, "id": 84, "type": "KSamplerAdvanced", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSamplerAdvanced"}, "order": 32}, {"outputs": [{"name": "prompt", "links": [105], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#432", "widgets_values": ["画面中是一位身穿传统和服的女性，坐在日式庭院的木制廊檐下，身体微微前倾，低头凝视着手中一片枯叶。她身着浅色底、蓝白花卉图案的和服，衣料质感细腻，褶皱自然，袖口宽大，腰间系有深色织带。发髻低挽，用一根细长的木质发簪固定，几缕碎发垂落于额前与耳侧，增添柔美气息。她的妆容淡雅，唇色为柔和的珊瑚红，眼神专注而内敛。\n\n背景是典型的日式枯山水庭院：白色细砂铺地，被精心耙出同心圆状的波纹线条，象征水面涟漪；数块大小不一的灰色岩石错落分布，表面粗糙，部分覆盖青苔，营造出静谧禅意。远处隐约可见石墙与绿植，环境幽静深远。\n\n人物位于画面右侧，左侧留有大量负空间，构图采用三分法，突出主体的同时保留了空间感。光线柔和，似为阴天或清晨散射光，从左上方照射，使人物面部轮廓清晰，阴影过渡自然。整体色调偏冷，以灰、蓝、白为主，点缀少量暖色（如唇色与枯叶），形成视觉平衡。\n\n拍摄视角略高，使用中焦镜头（约85mm），景深适中，主体清晰，背景虚化但细节仍可辨识。木质门框占据画面右边缘，形成天然框架，增强画面纵深感。人物姿态优雅，右手轻触胸口，左手持叶轻点沙面，动作细腻含蓄，体现东方美学中的“静”与“思”。\n\n艺术风格融合写实与诗意，强调氛围营造与情感表达，具有电影级质感。场景细节丰富，包括和服上的花纹、发簪的纹理、砂石的颗粒感等均清晰可见。整体呈现出一种宁静、沉思的禅意意境。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#653", "size": [453.8080749511719, 318.9709777832031], "pos": [1364.91064453125, 1026.393798828125], "id": 76, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 11}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-887.9846483070534, -1126.439925556033], "scale": 0.6588450000000037}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Group", "bounding": [2168.61474609375, 869.5238037109375, 1294.45068359375, 714.9285278320312]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "ZIT图生图提升写实质感", "bounding": [1371.1973876953125, 1682.6492919921875, 2292.7099609375, 876.5524291992188]}], "links": [[1, 2, 0, 1, 0, "LATENT"], [2, 6, 2, 1, 1, "VAE"], [3, 12, 0, 2, 0, "MODEL"], [4, 9, 0, 2, 1, "CONDITIONING"], [5, 10, 0, 2, 2, "CONDITIONING"], [6, 11, 0, 2, 3, "LATENT"], [7, 1, 0, 3, 0, "IMAGE"], [9, 6, 0, 7, 0, "MODEL"], [10, 6, 1, 9, 0, "CLIP"], [11, 8, 0, 9, 1, "STRING"], [12, 9, 0, 10, 0, "CONDITIONING"], [13, 13, 0, 12, 0, "MODEL"], [17, 17, 0, 18, 1, "STRING"], [23, 7, 0, 24, 0, "MODEL"], [67, 24, 0, 55, 0, "MODEL"], [68, 55, 0, 13, 0, "MODEL"], [105, 76, 0, 18, 0, "STRING"], [107, 18, 0, 8, 0, "STRING"], [108, 77, 0, 79, 0, "CLIP"], [109, 77, 0, 81, 0, "CLIP"], 