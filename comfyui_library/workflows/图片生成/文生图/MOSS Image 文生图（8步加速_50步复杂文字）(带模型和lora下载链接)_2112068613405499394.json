血管保健人群；黄色警示项：慎用：糖尿病患者控量，肾功能异常者咨询后食用，过敏体质先少量尝试。第二行第二张卡片标题食用注意，绿色对勾项：蓝莓含鞣酸不宜过量食用，含糖较高糖尿病患者控制份量；黄色警示项：肾功能异常者注意摄入，过敏体质先少量尝试。第二行第三张卡片标题嘌呤含量，文字 12 毫克 / 100 克，绿色标签低嘌呤食物，下方进度条，文字痛风患者日常可选。第二行第四张卡片标题冷知识，对勾条目：蓝莓被称为浆果之王，原产于北美和东亚温带地区，深蓝紫色来自花青素含量，底部搭配简约线稿小插图。整体干净通透，玻璃拟态 UI，文字清晰可读，科普信息图，无多余水印。"], "inputs": [{"name": "clip", "link": 108, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "提示词", "mode": 4, "bgcolor": "#353", "size": [561.6029052734375, 404.6081237792969], "pos": [348.72674560546875, 2750.77001953125], "id": 96, "properties": {"cnr_id": "comfy-core", "ver": "0.41.0", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 19}, {"mode": 4, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [], "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [403.5174255371094, 681.1757202148438], "pos": [1231.8448486328125, 2740.955810546875], "widgets_values": [], "inputs": [{"name": "images", "link": 124, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 109, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 27}, {"outputs": [{"name": "CLIP", "links": [108, 117], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#332922", "widgets_values": ["qwen3.5_9b_bf16.safetensors", "moss_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}],