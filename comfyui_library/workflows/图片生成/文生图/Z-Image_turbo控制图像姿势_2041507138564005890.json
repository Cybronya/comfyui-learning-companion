突显个性与叛逆气质。她姿态优雅，姿态俏皮而富有表现力。"], "inputs": [{"name": "clip", "link": 43, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 45, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 6}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [75], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "POSE_KEYPOINT", "label": "姿态关键点", "type": "POSE_KEYPOINT", "localized_name": "POSE_KEYPOINT"}], "size": [299.591796875, 222], "pos": [-987.1170654296875, 1604.6982421875], "widgets_values": ["enable", "enable", "enable", 1280, "yolox_l.onnx", "dw-ll_ucoco_384_bs5.torchscript.pt", "enable"], "inputs": [{"name": "image", "link": 100, "label": "图像", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "detect_hand"}, "shape": 7, "name": "detect_hand", "type": "COMBO", "localized_name": "检测手部"}, {"widget": {"name": "detect_body"}, "shape": 7, "name": "detect_body", "type": "COMBO", "localized_name": "检测身体"}, {"widget": {"name": "detect_face"}, "shape": 7, "name": "detect_face", "type": "COMBO", "localized_name": "检测面部"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "type": "INT", "localized_name": "分辨率"}, {"widget": {"name": "bbox_detector"}, "shape": 7, "name": "bbox_detector", "type": "COMBO", "localized_name": "BBox检测"}, {"widget": {"name": "pose_estimator"}, "shape": 7, "name": "pose_estimator", "type": "COMBO", "localized_name": "姿态预估"}, {"widget": {"name": "scale_stick_for_xinsr_cn"}, "shape": 7, "name": "scale_stick_for_xinsr_cn", "type": "COMBO", "localized_name": "scale_stick_for_xinsr_cn"}], "flags": {}, "id": 73, "type": "DWPreprocessor", "properties": 