e": 4, "outputs": [{"shape": 6, "name": "文本", "links": [263], "label": "文本", "type": "STRING", "localized_name": "文本"}], "size": [337.39373779296875, 331.7796325683594], "pos": [8187.6943359375, 4344.9765625], "widgets_values": ["请作为一名顶尖的视觉艺术分析师，对这张图像进行全方位的‘深度扫描’。请直接输出一段结构清晰、词汇丰富的中文描述，包含以下维度：\n\n视觉中心（The Focus）：明确指出画面最吸引注意力的主体（人、物、建筑或自然元素），详细描述其轮廓、色彩、材质纹理（如：金属的冷硬、织物的柔软、皮肤的纹理）及当前状态。\n\n空间层次（Layering）：由近及远分析。描述前景的遮挡或引导物、中景的主体关系、以及背景的环境细节（地理位置、天气、室内陈设等）。\n\n光影演化（Lighting & Tone）：分析光源的类型（自然光、人造光、全局光照）、光线投射的角度、阴影的浓淡，以及画面整体的色彩倾向（低保和、胶片感、冷暖对比）。\n\n构图与器材语言（Cinematography）：说明画面的构图方式（如：极简、对称、对角线）、拍摄视角（仰视、平视、微距），并模拟专业器材或日常设备的成像特征（如：大光圈虚化、手机随手拍的真实感、长曝光的轨迹）。\n\n氛围与情绪（Mood）：总结画面传递出的整体感受（如：静谧、喧嚣、孤独、怀旧、赛博朋克感）。\n\n风格类型：描述这张图片的风格（例如：写实摄影、国画、油画、卡通、3D效果图、插画等）。\n\n要求： 语言风格专业且富有感染力，严禁出现‘图中显示’、‘这张图片’等冗余废话，字数控制在 500-800 字。不要描述水印及无关符号。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {}, "id": 142, "type": "MuyeTextEditOutput", "title": "通用", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MuyeTextEditOutput"}, "order": 6}, {"mode": 0, "outputs": [{"shape": 3, "name": "image_urls", "label": "image_urls", "dir": 4, "type": "STRING"}], "size": [469.13372802734375, 625.4588012695312], "pos": [9333.5576171875, 4851.1728515625], "widgets_values": [[{"name": "A", "selected": true, "url": "/view?filename=rgthree.compare._temp_gugvh_00003_sbgnr_1775991914.jpg&type=temp&subfolder=&rand=0.927110429584913&Rh-Comfy-Auth=eyJ1c2VySWQiOiI3MWE4M2RjMTliYTk2YmIzZWY2YTBhYzA4ZTQ0MjY2OCIsInNpZ25FeHBpcmUiOjE3NzY1OTYzOTg4MTcsInRzIjoxNzc1OTkxNTk4ODE3LCJzaWduIjoiMGI3NmNlMDViMjBlZTZmODVjYzJjMzUyMjBmYzQ0NzgifQ==&Rh-Identify=71a83dc19ba96bb3ef6a0ac08e442668"}, {"name": "B", "selected": true, "url": "/view?filename=rgthree.compare._temp_gugvh_00004_cgjhd_1775991916.jpg&type=temp&subfolder=&rand=0.6019749849009506&Rh-Comfy-Auth=eyJ1c2VySWQiOiI3MWE4M2RjMTliYTk2YmIzZWY2YTBhYzA4ZTQ0MjY2OCIsInNpZ25FeHBpcmUiOjE3NzY1OTYzOTg4MTc