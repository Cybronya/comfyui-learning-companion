name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#653", "size": [373.3251953125, 106], "pos": [4814.3955078125, 2738.041015625], "id": 381, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 18}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [610], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 82], "pos": [5363.80419921875, 2283.103515625], "widgets_values": ["Krea2Mivt4tStyle_c1-st8000.safetensors", 1], "inputs": [{"name": "model", "link": 608, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 396, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.33.1", "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 28}, {"outputs": [{"name": "positive", "links": [586], "label": "positive", "type": "STRING", "localized_name": "positive"}], "color": "#232", "widgets_values": ["{\n  \"整体风格\": \"ENDER LILIES, Quietus of the Knights, 2D cel-shaded, low saturation, low brightness, gothic dark-fantasy, chiaroscuro lighting, multi-layered hand-painted background, black white gray palette with red accent, somber melancholic beauty, detailed delicate character art, subtle refined expressions, animated-movie quality. 核心画风为终焉的莉莉ENDER LILIES独立游戏签名美术风格——2D赛璐璐手绘、非3D、非真人、非写实、非Helltaker式flat平涂、非厚涂。全画面以低饱和低明度为基调，主色为纯黑#000000、灰白#C0C0C0、深灰#404040三色为主轴，色彩即使出现也被洗褪为dull hue灰调，仅在关键视觉锚点使用正红#FF0000或暗金#806020做极小面积点缀。光影为chiaroscuro明暗对比法——强光源与深暗部直接对撞，多层手绘阴影过渡而非渐变喷枪，暗部不死黑而保留低明度冷灰层次。人物为2D赛璐璐精细手绘——五官精致而非卡通简化，眼眸有高光与虹膜层次细节，手指为完整指节不简化，表情细腻内敛而非夸张幅度，肢体动作有重量感与呼吸感。背景为多层手绘精细绘画——石墙砖纹、器物质感、空气微粒均有刻画，不大量留白而是营造沉浸式氛围深度。整体基调为哥特暗黑哀美——即使喜剧场景也蒙上一层忧郁滤镜，暗黑王在厨房笨手笨脚的反差喜感被渲染为一种孤独而温柔的荒诞。禁止：3D CGI、3D建模渲染、真人/写实/photorealistic、Helltaker式flat平涂无渐变、cartoon-simplified anatomy、2指节简化手指、夸张幅度表情、极简几何背景大量留白、diagonal hatching排线阴影、望月けい风格、volumetric god-rays、rim light。\",\n  \"角色档案\": [\n    \"尼布甲尼撒，男性，苍白肤色以2D赛璐璐低饱和冷白渲染带微微青灰底色，黑色中长碎层蓬松短发以精细线条勾勒发丝走向与分层质感，浅灰绿瞳孔以赛璐璐多层渲染——虹膜有放射状纹理高光为细小冷光点而非卡通大圆斑，五官轮廓精致清冷鼻梁挺直嘴唇薄削，头戴金色多尖刺哥特尖塔王冠为王冠暗金#806020色调与画面冷灰基调形成唯一暖色焦点——王冠金质有金属质感细节刻画，黑色紧身胸甲胸口铸金色十字纹章与繁复金丝细工以低饱和暗金渲染，多层金色链饰挂垂胸前链节有金属反光，肩覆巨大不对称黑色尖刺翼状肩甲两侧向上弯曲多枚尖锐黑刺——肩甲有铁质暗光与磨损纹理刻画——此肩甲在厨房中是不断碰倒东西的物理源头，金色纹饰布满肩甲内侧连接处，腰系宽黑皮带正中一枚金色骷髅头扣饰——骷髅头有骨骼质感细节——此扣饰差点掉进汤里，金色链饰从腰带垂坠，腰下挂金色纹饰尖角坠饰前摆，双臂黑色分段臂甲配金色肩肘前臂纹饰，黑色手套护指镶金边指节甲手指为完整指节不简化，腿部黑色紧身裤甲，膝盖金色火焰纹状护膝，小腿黑色甲靴金色饰边，脚蹬黑色中跟金边扣带皮靴，身后披及膝至小腿的破边黑色斗篷多条尖角撕裂残片——斗篷布料有垂坠与破边细节刻画\",\n    \"蒂妮·切尔克，女性，中暖肤色以2D赛璐璐低饱和暖白渲染带微微粉灰底色，深棕近黑长直发垂过腰际以赛璐璐多层色阶渲染——发丝有光泽走向与发梢渐深层次而非flat色块，前发编织法式麻花辫冠从耳到耳横跨头顶——辫纹有编织细节刻画，琥珀棕色眼眸以赛璐璐多层渲染——虹膜有琥珀色深浅渐变层次高光为柔和内光而非卡通大圆斑，五官精致柔美鼻梁小巧嘴唇自然——表情细腻内敛可从微微无奈到嘴角轻颤到温柔浅笑而非夸张幅度，身穿乳白色心形领口紧身胸衣公主线收身连衣短裙A字短裙摆至大腿中以低饱和cream色阶渲染——布料有褶皱垂坠质感而非flat色块，裙摆前侧尖角花瓣状下摆，双臂乳白色长手套从上臂至手腕贴肤无饰手指为完整指节不简化，脚穿乳白色平底芭蕾浅口鞋，头侧乳白色缎带蝴蝶结两枚位于耳后辫冠末端处——缎带有丝绸光泽渲染，腰左侧垂一条深红细绳腰坠饰末端系一枚金色小圆扣饰——此深红腰绳为画面正红#FF0000极小面积点缀\"\n  ],\n  \"音色档案\": [\n    \"尼布甲尼撒，低沉醇厚男声，音色如旧铜钟闷响，语速极慢带古老腔调，尾字常低沉消散，语气底色笨拙而认真\",\n    \"蒂妮·切尔克，清亮柔和少女声，音色如薄瓷轻碰，语速平稳不急不缓，尾字微微上扬，语气底色无奈而宠溺\"\n  ],\n  \"道具档案\": [\n    \"黑铁菜刀，黑色金属宽刃菜刀，刀身以2D赛璐璐渲染铁质暗光与刃口冷光反光，刀柄为深褐色木质有木纹质感刻画，整体比正常菜刀略大对比尼布甲尼撒的臂甲显得笨重不趁手\",\n    \"白瓷汤锅，白瓷圆腹宽口汤锅，锅壁以低饱和乳白渲染瓷质温润光泽，两侧各一个黑色圆环把手有铁质暗光，锅口冒出热气以多层半透明灰白渲染升腾飘散而非简单曲线，整体置于黑色铁架上铁架有锈迹斑驳质感\"\n  ],\n  \"场景档案\": [\n    \"古堡石墙厨房，ENDER LILIES风格多层手绘哥特暗黑室内场景。光源为东侧高窗透入的chiaroscuro光柱——冷白光柱穿过石窗在空气中形成可见的光尘浮游层，光柱外为深沉暗灰阴影区有低明度冷灰层次。地面深灰石板以多层手绘渲染——石板缝隙与磨损纹理有刻画，石板面有冷光反光。四围石墙以多层手绘渲染——砖石砌缝与水渍侵蚀痕迹有细节刻画，墙面在光柱外沉入深暗灰。核心地标为中央一张黑色铁架长操作台——铁架有金属暗光与锈蚀斑点质感，台面木板上散落几颗深红色番茄与暗绿色蔬菜——果蔬有质感与光泽细节刻画而非简化色块。操作台旁立一座黑色铁架炉灶上面架着白瓷汤锅。远景墙角有一排老旧木柜——柜面有岁月斑驳痕迹。背景不大量留白而是以多层暗灰层次营造沉浸式哥特厨房氛围深度，远处暗影中有模糊的钩架与厨具轮廓暗示空间纵深\"\n  ],\n  \"分镜序列\": [\n    {\n      \"编号\": 1,\n      \"类型\": \"文戏：15秒\",\n      \"标题\": \"古堡石墙厨房-国王进厨房\",\n      \"时间段\": [\n        \"极缓推大全景构图。ENDER LILIES风格2D赛璐璐低饱和暗黑哥特场景：东侧高窗透入chiaroscuro冷白光柱穿过石窗在空气中形成可见的光尘浮游层，光柱外为深沉暗灰阴影区有低明度冷灰层次。深灰石板地面多层手绘渲染石板缝隙与磨损纹理有冷光反光。四围石墙多层手绘渲染砖石砌缝与水渍侵蚀痕迹，墙面在光柱外沉入深暗灰。中央黑色铁架长操作台有金属暗光与锈蚀斑点质感，台面上散落几颗深红色番茄与暗绿色蔬菜有质感与光泽细节。操作台旁黑色铁架炉灶上架着白瓷汤锅低饱和乳白渲染瓷质温润光泽锅口冒热气以多层半透明灰白渲染升腾飘散。蒂妮·切尔克站在操作台前，深棕近黑长直发以赛璐璐多层色阶渲染发丝有光泽走向，前发法式麻花辫冠有编织细节刻画，琥珀棕色眼眸以赛璐璐多层渲染虹膜有琥珀色深浅渐变层次正专注看着台上的蔬菜——眼神柔和内敛而非夸张大眼，乳白色连衣短裙以低饱和cream色阶渲染布料有褶皱垂坠质感，双手乳白色长手套正在将深红番茄摆到台面上手指为完整指节，腰左侧深红细绳腰坠饰金色小圆扣饰垂于裙侧为画面正红#FF0000极小面积点缀。画面边缘尼布甲尼撒从侧面走入厨房，黑色中长碎层蓬松短发以精细线条勾勒发丝走向与分层质感，金色多尖刺哥特尖塔王冠以低饱和暗金#806020渲染与画面冷灰基调形成暖色焦点，浅灰绿瞳孔以赛璐璐多层渲染虹膜有放射状纹理望着蒂妮·切尔克的背影，巨大不对称黑色尖刺翼状肩甲有铁质暗光与磨损纹理刻画尖锐黑刺几乎刮到门框两侧——这是即将引发混乱的视觉暗示。尼布甲尼撒低沉醇厚地开口：<d>[Chinese]蒂妮·切尔克，我来帮忙。</d>说完后浅灰绿瞳孔微微柔和嘴角极轻上扬——细腻内敛的认真表情而非夸张幅度。\",\n        \"At 00:08.000 焦点转移至中近景双人过肩构图自尼布甲尼撒肩后拍摄。蒂妮·切尔克闻声回头，琥珀棕色眼眸微微睁大——赛璐璐渲染的虹膜高光闪烁表现惊讶但幅度内敛克制，嘴唇微张为自然的惊讶弧度而非夸张大O，乳白色缎带蝴蝶结因转头而轻晃缎带有丝绸光泽渲染。蒂妮·切尔克视线从尼布甲尼撒脸部缓缓下移到巨大不对称黑色尖刺翼状肩甲上又移回脸部，琥珀棕色眼眸微微眯起——眼尾收紧表现无奈但细腻内敛克制。蒂妮·切尔克清亮柔和地开口：<d>[Chinese]尼布甲尼撒……你确定？</d>说完后嘴角微微抽搐——极力克制的微妙表情，深棕近黑长直发以赛璐璐多层色阶微微摆动。尼布甲尼撒浅灰绿瞳孔微微坚定，用力点头，金色多尖刺哥特尖塔王冠随点头而微颤金属暗光闪动，破边黑色斗篷尖角残片随动作翻飞布料有垂坠与破边细节刻画。\"\n      ],\n      \"环境音\": \"环境音以古堡厨房空间声底为主，石墙回声略空旷带冷感，白瓷汤锅汤水冒泡的咕嘟咕嘟声持续铺底，尼布甲尼撒黑色中跟金边扣带皮靴踏石板的沉稳低步声带回声，肩甲黑刺轻刮门框石面的一声极轻嘎吱。\",\n      \"BGM\": \"低音量安静而略带忧郁的氛围音乐，以柔和钢琴单音缓弹为主，偶尔穿插极轻的弦乐长音铺底，节奏极慢，在尼布甲尼撒说「我来帮忙」时钢琴多加一个微微上扬的暖音——在冷调底色中闪过一丝温柔，收尾以一个延音渐弱在石墙回声中消散。\"\n    },\n    {\n      \"编号\": 2,\n      \"类型\": \"文戏：15秒\",\n      \"标题\": \"古堡石墙厨房-切菜灾难\",\n      \"时间段\": [\n        \"手持微晃中景跟拍构图。ENDER LILIES风格2D赛璐璐低饱和暗黑哥特：尼布甲尼撒站在黑色铁架长操作台前，黑色分段臂甲的双手笨拙地握着黑铁菜刀——黑铁菜刀刀身以赛璐璐渲染铁质暗光与刃口冷光反光在尼布甲尼撒的黑色臂甲衬托下显得极不趁手，手指为完整指节握刀柄姿势僵硬。尼布甲尼撒浅灰绿瞳孔以赛璐璐多层渲染极度专注——虹膜放射纹理清晰眉头微蹙但五官精致清冷所以表情显得笨拙认真而非呆萌卡通，金色多尖刺哥特尖塔王冠微微前倾暗金色调。尼布甲尼撒右手举黑铁菜刀向台上一颗深红色番茄砍下，刀身偏了四十五度砍在台面上发出一声闷响，深红番茄被刀背弹飞滚落台边——番茄滚落有质感与运动细节。与此同时巨大不对称黑色尖刺翼状肩甲的最外侧一枚尖锐黑刺随挥刀动作横向扫过操作台，将台上一颗暗绿色蔬菜和另一颗深红番茄扫飞出画面——扫飞时果蔬在空中翻转有光泽细节。尼布甲尼撒低沉醇厚地低喝：<d>[Chinese]……嗯。</d>说完后浅灰绿瞳孔微微茫然——虹膜高光微微涣散嘴角极轻下弯表现困惑但内敛克制。蒂妮·切尔克站在操作台另一侧，琥珀棕色眼眸微微眯起眼尾收紧——嘴角紧紧抿住极力憋笑肩膀微微颤抖——细腻克制的无奈表情，乳白色长手套双手捂住嘴巴手指为完整指节。蒂妮·切尔克清亮柔和地憋着笑开口：<d>[Chinese]尼布甲尼撒……刀要握稳。</d>说完后终于没忍住嘴角微微裂开一个温柔的笑——弧度自然内敛而非夸张wide grin，乳白色缎带蝴蝶结随之轻颤缎带有丝绸光泽。\",\n        \"At 00:08.000 近景特写构图拍操作台面。台面上深红番茄已被切成不规则的两大块，切面以低饱和红渲染有果肉质感细节，旁边黑铁菜刀刀身斜插在台面上刀柄朝天——尼布甲尼撒的黑色手套完整指节手指还握着刀柄没松。一只暗绿色蔬菜被切成碎渣散落台面有断面质感细节。巨大不对称黑色尖刺翼状肩甲的黑刺在画面上方边缘入镜有铁质暗光，暗示它才是罪魁祸首。蒂妮·切尔克的乳白色长手套从画面边缘伸入，完整指节手指轻轻将黑铁菜刀刀柄从尼布甲尼撒手中接过来——两双手在刀柄上短暂重叠，黑色手套镶金边指节甲与乳白色长手套在chiaroscuro光影下形成深沉黑白对比有手套布料与金属质感细节。蒂妮·切尔克清亮柔和地开口：<d>[Chinese]尼布甲尼撒，让我来切吧。</d>说完后琥珀棕色眼眸弯起温柔弧度嘴角上扬幅度自然。尼布甲尼撒浅灰绿瞳孔微微失落——虹膜高光黯淡了一瞬嘴角极淡地向下弯了一度表现淡淡的受挫感。\"\n      ],\n      \"环境音\": \"黑铁菜刀砍操作台面的闷响一声咚带石墙回声，深红番茄弹飞滚落台边的轻噗通声，肩甲黑刺扫飞蔬菜的呼啦一声，尼布甲尼撒低喝的极短鼻音，蒂妮·切尔克憋笑时极轻的鼻腔呼哧声，刀柄交接时金属与手套布料摩擦的极轻沙沙声。\",\n      \"BGM\": \"低音量安静而略带荒诞底色的氛围音乐延续，钢琴单音在番茄弹飞时加一个微微下行的不协和音——似忧伤似滑稽的暧昧听感，在蒂妮·切尔克憋笑时弦乐长音微微震颤，在刀柄交接时钢琴回归柔和缓弹，收尾以延音渐弱。\"\n    },\n    {\n      \"编号\": 3,\n      \"类型\": \"文戏：15秒\",\n      \"标题\": \"古堡石墙厨房-骷髅扣差点入汤\",\n      \"时间段\": [\n        \"微移中景双人构图。ENDER LILIES风格2D赛璐璐低饱和暗黑哥特：黑色铁架炉灶上白瓷汤锅低饱和乳白渲染锅口冒热气以多层半透明灰白渲染升腾飘散，尼布甲尼撒站在炉灶前低头看汤锅——浅灰绿瞳孔以赛璐璐多层渲染专注，金色多尖刺哥特尖塔王冠微微前倾暗金色调，黑色紧身胸甲胸口金色十字纹章以低饱和暗金渲染。尼布甲尼撒右手拿一把深褐色长柄木勺伸进白瓷汤锅搅动木勺有木纹质感，动作幅度过大导致汤水险些溅出——汤水以低饱和红橙色渲染有液体光泽，巨大不对称黑色尖刺翼状肩甲向前倾斜铁质暗光闪动，腰系宽黑皮带正中金色骷髅头扣饰——金色骷髅头扣饰有骨骼质感细节因弯腰前倾而向前晃荡，以低饱和暗金渲染的骷髅头扣饰悬在白瓷汤锅锅口正上方摇摇欲坠。蒂妮·切尔克站在尼布甲尼撒身侧，琥珀棕色眼眸骤然睁大——赛璐璐渲染虹膜高光骤亮瞳孔收缩表现惊恐但幅度内敛克制而非夸张大O，乳白色长手套双手猛地伸出手指为完整指节，一把抓住金色骷髅头扣饰下方的金色链饰——链饰以低饱和暗金线条渲染有金属反光，将金色骷髅头扣饰从锅口正上方拉回安全位置。蒂妮·切尔克清亮柔和但略带紧张地快速开口：<d>[Chinese]尼布甲尼撒！你的扣子要掉进汤里了！</d>说完后琥珀棕色眼眸微微眯起眼尾收紧——嘴角紧紧抿住表现无奈与后怕但内敛克制，乳白色缎带蝴蝶结因猛抓动作而剧烈颤动缎带有丝绸光泽。\",\n        \"At 00:08.000 近景单人构图拍尼布甲尼撒。尼布甲尼撒低头看着自己腰间金色骷髅头扣饰——扣饰已被蒂妮·切尔克拉回原位以低饱和暗金渲染有骨骼质感，金色链饰垂坠静止有金属反光。尼布甲尼撒浅灰绿瞳孔以赛璐璐多层渲染茫然——缓缓眨了一下虹膜高光微微涣散，嘴角微微下弯表现心虚——五官精致清冷下的笨拙愧疚感而非卡通呆萌。尼布甲尼撒右手仍握着深褐色长柄木勺悬在白瓷汤锅上方木勺有木纹质感，木勺上滴下一滴低饱和红橙色汤汁落回锅中——液滴有下坠与溅落质感细节。尼布甲尼撒低沉醇厚地极小声开口：<d>[Chinese]……抱歉，蒂妮·切尔克。</d>说完后浅灰绿瞳孔移向蒂妮·切尔克方向——虹膜高光柔和微微下垂表现心虚与讨好。蒂妮·切尔克闻言琥珀棕色眼眸从眯起缓缓恢复自然，嘴角从紧抿变为微微上扬——弧度温柔内敛的释然，乳白色长手套用手背轻轻拍了一下尼布甲尼撒黑色分段臂甲——两色在chiaroscuro光影下形成深沉黑白对比有手套布料与臂甲金属质感细节。\"\n      ],\n      \"环境音\": \"白瓷汤锅汤水冒泡的咕嘟声持续带石墙回声，木勺搅汤的水声哗啦，金色骷髅头扣饰晃荡时金属极轻叮当声，蒂妮·切尔克猛抓金色链饰时金属链节拉紧的嘎吱声，汤汁滴落回锅中的极轻噗通声，尼布甲尼撒极小声道歉的气声，手套拍臂甲的极轻啪一声。\",\n      \"BGM\": \"低音量紧张转释然的氛围音乐，钢琴单音在骷髅扣摇摇欲坠时急促低音两声如心跳加速，在蒂妮·切尔克抓住链饰时一个清亮高音化解紧张，在尼布甲尼撒道歉时钢琴降至低音区单音缓拨带一丝哀感，在蒂妮·切尔克原谅时回归中音区柔和温暖，收尾以延音渐弱在石墙回声中消散。\"\n    },\n    {\n      \"编号\": 4,\n      \"类型\": \"文戏：15秒\",\n      \"标题\": \"古堡石墙厨房-并肩尝汤\",\n      \"时间段\": [\n        \"极缓推中景双人构图。ENDER LILIES风格2D赛璐璐低饱和暗黑哥特：黑色铁架长操作台上已摆好两只乳白色粗陶碗以低饱和渲染陶质温润光泽，碗中盛着低饱和红橙色汤水有液体光泽，旁边深红番茄已被整齐切好摆在深褐色砧板上——显然是蒂妮·切尔克切的砧板有木纹质感。尼布甲尼撒与蒂妮·切尔克并肩坐在操作台边的黑色高脚凳上——凳子以赛璐璐渲染有铁质暗光与锈蚀斑点。尼布甲尼撒黑色中长碎层蓬松短发以精细线条勾勒发丝走向与分层质感，金色多尖刺哥特尖塔王冠微微歪斜——暗示刚才的忙碌中碰歪了暗金色调金属暗光，浅灰绿瞳孔以赛璐璐多层渲染期待又忐忑——虹膜高光微微闪烁，黑色手套完整指节手指端着乳白色粗陶碗，巨大不对称黑色尖刺翼状肩甲的尖刺在并肩距离下几乎蹭到蒂妮·切尔克的肩——蒂妮·切尔克微微向另一侧倾斜避让乳白色连衣短裙以低饱和cream色阶渲染布料有褶皱质感。蒂妮·切尔克端起乳白色粗陶碗啜了一口，琥珀棕色眼眸微微睁大——赛璐璐渲染虹膜高光骤亮表现惊喜但幅度内敛克制，嘴角微微上扬自然弧度的温柔笑意——而非夸张wide grin，乳白色缎带蝴蝶结因表情变化而轻颤缎带有丝绸光泽。蒂妮·切尔克清亮柔和地惊喜开口：<d>[Chinese]尼布甲尼撒！很好喝！</d>说完后琥珀棕色眼眸弯起温柔弧度嘴角上扬幅度自然。尼布甲尼撒闻言浅灰绿瞳孔微微睁大——赛璐璐渲染虹膜高光柔和闪动表现惊喜但内敛克制，嘴角从微微下弯缓缓上扬为淡淡的腼腆笑意，金色多尖刺哥特尖塔王冠微微正了正金属暗光闪动。\",\n        \"At 00:07.000 焦点转移至近景双人侧脸构图。尼布甲尼撒端起乳白色粗陶碗小心翼翼地啜了一口——黑色手套完整指节手指端碗姿势略笨拙，浅灰绿瞳孔以赛璐璐多层渲染沉思——然后缓缓点头，嘴角微微上扬淡淡的满足。尼布甲尼撒低沉醇厚地极轻开口：<d>[Chinese]……确实不错，蒂妮·切尔克。</d>说完后浅灰绿瞳孔从碗中移向蒂妮·切尔克侧脸——虹膜高光柔和微微下垂表现温柔。蒂妮·切尔克闻言琥珀棕色眼眸从碗移向尼布甲尼撒侧脸——嘴角微微上扬自然温柔弧度，两人在chiaroscuro冷白光柱下并肩坐着端碗喝汤的侧影——在低饱和冷灰背景与暗金王冠微光中形成深沉而温柔的哥特暗黑日常构图。极缓推至空镜构图，操作台上两只乳白色粗陶碗并排放着陶质温润光泽，旁边深红番茄与深褐砧板与冷白光柱构成ENDER LILIES式低饱和暗黑静物画——在冷灰调中透出一丝生活气息与孤独温暖，白瓷汤锅在炉灶上热气以多层半透明灰白渲染最后袅袅一缕后消散在石墙暗影中。\"\n      ],\n      \"环境音\": \"两人啜汤的极轻吸溜声，粗陶碗碰操作台面的极轻瓷木声，尼布甲尼撒微微正王冠时金属极轻一声叮，白瓷汤锅热气最后袅袅一缕消散的无声，古堡厨房石墙回声的空间底噪缓缓归于安静。\",\n      \"BGM\": \"低音量安静而温暖的收束氛围音乐，钢琴回归柔和缓弹中音区，在蒂妮·切尔克说「很好喝」时加一个微微明亮的上扬和弦——在冷调底色中绽放一丝暖意，在尼布甲尼撒说「确实不错」时回归单音缓拨带满足与安宁，收尾以一个柔和和弦延音在空镜低饱和静物画中渐弱至无声——余韵在石墙回声中缓缓消散。\"\n    }\n  ]\n}"], "inputs": [{"widget": {"name": "positive"}, "name": "positive", "label": "positive", "type": "STRING", "localized_name": "positive"}], "flags": {"pinned": true}, "type": "easy positive", "title": "分镜总提示词", "mode": 0, "bgcolor": "#353", "size": [507, 513], "pos": [7275.71533203125, 2528.22998046875], "id": 379, "properties": {"cnr_id": "comfyui-easy-use", "ver": "4de1ab3b66e48da916b6f263bacd001df53a2720", "widget_ue_connectable": {"positive": true}, "Node name for S&R": "easy positive"}, "order": 19}, {"outputs": [{"name": "MODEL", "links": [608], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#223", "widgets_values": ["Krea2-Turbo-bf16_2.5D半写实.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLoader", "mode": 0, "bgcolor": "#335", "size": [383.953125, 107.59375], "pos": [4809.61328125, 2544.9658203125], "id": 383, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 20}], "extra": {"links_added_by_ue": [], "anomalous_hashes": {"394_Wan21_T2V_14B_lightx2v_cfg_step_distill_lora_rank32.safetensors": {"size": 316822496, "hash": ""}}, "0246.VERSION": [0, 0, 4], "VHS_latentpreview": false, "ds": {"offset": [-6428.17155674942, -2412.561672714286], "scale": 1.1671841070450135}, "VHS_KeepIntermediate": true, "xzgGroups": {}, "ue_links": [], "VHS_MetadataImage": true, "pixaroma