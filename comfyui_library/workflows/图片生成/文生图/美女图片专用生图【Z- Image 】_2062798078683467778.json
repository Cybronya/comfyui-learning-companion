洁的短语。\n风格：画面描述要具体且富有美感，避免空洞的词汇。\n格式：请直接输出补全后的完整提示词，无需多言。除了提示词以外不要输出任何内容。", "Hello", 0.6, 2139649184, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "ref_image1", "label": "ref_image1", "type": "IMAGE", "localized_name": "ref_image1"}, {"shape": 7, "name": "ref_image2", "label": "ref_image2", "type": "IMAGE", "localized_name": "ref_image2"}, {"shape": 7, "name": "ref_image3", "label": "ref_image3", "type": "IMAGE", "localized_name": "ref_image3"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 304, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_LLMAPI_NODE", "mode": 0, "bgcolor": "#335", "size": [443.5634765625, 396], "pos": [-264.2725830078125, 3710.79296875], "id": 208, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 7}, {"outputs": [{"name": "MODEL", "links": [292], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#223", "widgets_values": ["red-zimage15AIO.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "u