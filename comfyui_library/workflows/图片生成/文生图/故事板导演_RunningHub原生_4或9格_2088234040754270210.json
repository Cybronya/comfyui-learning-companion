uts": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [420, 250], "pos": [1040, 260], "widgets_values": [], "inputs": [{"name": "source", "link": 14, "label": "source", "type": "*", "localized_name": "source"}], "flags": {}, "id": 15, "type": "PreviewAny", "title": "对应的逐格生图提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 18}, {"outputs": [{"name": "file_path", "links": [], "label": "file_path", "type": "STRING", "localized_name": "file_path"}], "color": "#3c3c3c", "widgets_values": ["storyboards/storyboard_plan", true, true, "utf-8"], "inputs": [{"shape": 7, "name": "any", "link": 15, "label": "any", "type": "*", "localized_name": "any"}, {"widget": {"name": "filename"}, "name": "filename", "label": "filename", "type": "STRING", "localized_name": "filename"}, {"widget": {"name": "auto_increment"}, "name": "auto_increment", "label": "auto_increment", "type": "BOOLEAN", "localized_name": "auto_increment"}, {"widget": {"name": "save_output"}, "name": "save_output", "label": "save_output", "type": "BOOLEAN", "localized_name": "save_output"}, {"widget": {"name": "encode"}, "name": "encode", "label": "encode", "type": "COMBO", "localized_name": "encode"}], "flags": {}, "type": "1hew_SaveTxt", "title": "保存完整分镜 JSON / 提示词", "mode": 0, "bgcolor": "#555555", "size": [390, 230], "pos": [1040, 590], "id": 16, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "1hew_SaveTxt", "_comfy1hewPreviewText": "[\n  {\n    \"label\": \"MASTER\",\n    \"kind\": \"contact_sheet\",\n    \"prompt\": \"A single contact sheet image containing exactly 4 panels in a strict 2x2 grid, top row P01 P02, bottom row P03 P04. All panels are exactly equal width and height, with perfectly straight boundaries, razor-sharp row and column alignment, no outer margins, only extremely thin uniform dividing lines. Each panel is an independent 16:9 cinematic film frame. No titles, subtitles, speech bubbles, panel numbers, watermarks, collage overlaps, broken frames, or extra windows. The entire sheet must maintain the same character face, hairstyle, outfit, and scene structure continuously across all panels. Reference character: young East Asian female, oval face, light brown eyes, calm and slightly weary expression, high nose bridge, light pink lips, shoulder-length light brown hair parted 3:7, natural straight fall. She wears a white point-collar shirt under a dark navy single-breasted tailored blazer with matching navy trousers, dark pointed-toe heels, slender and upright posture. Scene: a semi-open abandoned train station platform and rain shelter extending into the night, with a weathered bench, wet concrete floor, rusty metal supports, rails stretching into the distance, and distant buildings/lamps. Cinematic realism, restrained blue-orange color palette, heavy rain night with cold blue ambient light, orange distant lights, wet floor reflections, high contrast, film noir atmosphere. [P01] Wide establishing shot: the protagonist walks into the abandoned station shelter from the right, seen from a low angle, rain pouring, cold blue light, wet platform reflecting faint orange glow from far end, the old bench visible in midground, rails receding into darkness. [P02] Medium shot: protagonist crouches beside the bench, her hand reaching under it to pull out an old yellowish envelope, rain streaks in background, rim light from distant orange source, shallow depth of field on the envelope. [P03] Close-up over the shoulder: she reads the letter, her face lit by paper reflections, expression turning from tired to surprised, faint tears, letter text blurred but aged, rain visible on shelter glass. [P04] Wide shot from behind her: she turns her head sharply to the left, the letter lowered, in the deep background a single station lamp flickers on, glowing orange, cutting through the rain, her silhouette tense, the lamp creates a mystery hook.\"\n  },\n  {\n    \"label\": \"P01\",\n    \"kind\": \"panel\",\n    \"beat_zh\": \"建立：雨夜，主角走进废弃车站避雨，环境与氛围展示。\",\n    \"camera\": \"低角度中远景，轨道从右向左延伸，主角位于画面右下三分之一，向左侧深处走去。\",\n    \"continuity\": \"深蓝西装、浅棕发清晰可见；废弃车站长椅在画面中远处；雨丝与地面积水反光呈现冷蓝调，远处有微弱暖橙光点。\",\n    \"prompt\": \"[P01] Low angle wide shot, a young East Asian woman in a dark navy tailored suit and white shirt walks into an abandoned train station shelter from the right foreground, stepping carefully on wet concrete. She is seen from a low perspective, her figure small against the vast decaying structure. Heavy rain falls diagonally, creating cold blue atmosphere. The platform extends into the distance with rusty columns and a weathered wooden bench visible in the midground. Rails lead into darkness. Distant faint orange lamp glow reflects on the wet floor. Cinematic realism, 16:9, no text.\"\n  },\n  {\n    \"label\": \"P02\",\n    \"kind\": \"panel\",\n    \"beat_zh\": \"推进：主角在长椅下发现一封旧信，伸手取出。\",\n    \"camera\": \"中景，低角度，主角蹲在长椅旁，手伸入椅下，焦点落在信封上。\",\n    \"continuity\": \"服装与发型一致；长椅位置与上一镜轴线对应；灯光方向维持远处暖橙侧光，地面积水反光。\",\n    \"prompt\": \"[P02] Medium shot, the woman crouches beside the weathered bench under the shelter. Her right hand reaches beneath the bench, pulling out a damp, yellowed envelope. Rain streaks on the shelter glass behind her. A distant orange light casts a rim glow on her shoulder and the envelope. The envelope is slightly curled, vintage. Shallow depth of field, focus on the envelope. Her expression is curious. Cold blue shadows, cinematic lighting, 16:9.\"\n  },\n  {\n    \"label\": \"P03\",\n    \"kind\": \"panel\",\n    \"beat_zh\": \"转折：读信，表情从疲惫转为震惊，意识到信是写给自己的。\",\n    \"camera\": \"过肩特写，焦点在信纸，主角侧脸占据画面左侧，信纸在右侧，雨水模糊背景。\",\n    \"continuity\": \"同场景，光向一致；信纸泛黄，字迹模糊但可见；主角衬衫领口与西装外套细节保留。\",\n    \"prompt\": \"[P03] Over-the-shoulder close-up, the woman holds the letter open. The camera focuses on the aged paper, her face visible in profile on the left. Her expression shifts from tired to shock, eyes widening, slight tears welling. The letter shows faint handwritten ink, somewhat blurred by moisture. Soft warm light from the letter reflects onto her face. Raindrops on the shelter glass behind create a blurry backdrop. Cold blue and warm orange contrast. She still wears the white shirt collar under navy blazer. 16:9, cinematic.\"\n  },\n  {\n    \"label\": \"P04\",\n    \"kind\": \"panel\",\n    \"beat_zh\": \"结局钩子：读完后，远处一盏本不该亮的灯突然亮起，主角惊愕回头。\",\n    \"camera\": \"中远景，从主角背后拍摄，她转头望向左侧远处，画面深处一盏孤灯亮起，橙色光晕刺破雨幕。\",\n    \"continuity\": \"主角西装、发型一致，长椅旁的信纸还在手中；灯的位置符合之前场景的远处灯柱；雨继续下，地面反光呼应。\",\n    \"prompt\": \"[P04] Wide shot from behind the woman, she stands near the bench, having just finished reading the letter. She turns her head sharply to the left, her silhouette tense. The letter is lowered in her hand. In the deep background, far beyond the platform, a single station lamp on a tall pillar suddenly glows orange, cutting through the rain. The lamp was previously dark, now it illuminates the wet rails and mist. Her posture conveys surprise and apprehension. Rain continues, cold blue dominates, the orange lamp creates a dramatic hook. No text, pure cinematic composition, 16:9.\"\n  }\n]"}, "order": 16}, {"outputs": [{"name": "image", "links": [19, 20, 21, 22], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "links": [], "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "links": [], "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#4f2247", "widgets_values": ["", "2k", "16:9", false, 377699890, "randomize"], "inputs": [{"name": "image1", "link": 16, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 17, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name