{值} | 把建筑颜色改为深蓝色 |\n| **改动作** | 让{角色}从{动作1}变为{动作2} | 让坐着的女生变为站着 |\n| **改视角** | 调整为{视角}运镜 | 调整为无人机俯视角运镜 |\n| **改台词** | 让{角色}说{台词} | 让角色用日语说“sore wa nan daro?!” |\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [551.0473022460938, 734.3204956054688], "pos": [-849.626953125, -582.8256225585938], "id": 27, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"mode": 0, "outputs": [{"name": "VIDEO", "links": [10], "label": "VIDEO", "type": "VIDEO", "localized_name": "视频"}], "size": [378.080078125, 789.2001342773438], "pos": [-192.31199645996094, 12.109526634216309], "widgets_values": ["2257845928bf2fbd719df2674b656d14eb3b97f9450a587c1ffd67a0167d3ed0.mp4", true, "", "image"], "inputs": [{"widget": {"name": "file"}, "name": "file", "label": "file", "type": "COMBO", "localized_name": "文件"}, {"widget": {"name": "keep_audio"}, "name": "keep_audio", "label": "keep_audio", "type": "BOOLEAN", "localized_name": "keep_audio"}, {"widget": {"name": "trim_time"}, "name": "trim_time", "label": "trim_time", "type": "STRING", "localized_name": "trim_time"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择要上传的文件"}], "flags": {}, "id": 5, "type": "LoadVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadVideo"}, "order": 2}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}], "size": [595.3658447265625, 1062.8804931640625], "pos": [1303.26416015625, -272.6661071777344], "widgets_values": ["video/ComfyUI", "auto", "auto"], "inputs": [{"name": "video", "link": 8, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name"