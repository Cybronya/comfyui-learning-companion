BO", "localized_name": "宽高比"}, {"widget": {"name": "swap_dimensions"}, "name": "swap_dimensions", "type": "COMBO", "localized_name": "切换宽高"}, {"widget": {"name": "upscale_factor"}, "name": "upscale_factor", "type": "FLOAT", "localized_name": "upscale_factor"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {}, "id": 25, "type": "CR SDXL Aspect Ratio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR SDXL Aspect Ratio"}, "order": 4}, {"mode": 0, "outputs": [{"name": "output", "links": [17], "type": "*", "localized_name": "output"}], "size": [308.7183532714844, 183.52589416503906], "pos": [-150.51695251464844, 7.82107400894165], "widgets_values": ["设计一张以写实风格为主的沙发新品上市商业海报，整体构图采用3:4比例，核心视觉以一套沙发为主体，摆放在一个简约现代风格的客厅场景中，视角为45度，展现沙发的线条与细节质感。沙发的颜色选择多样化，可通过排列不同色块或小样布料的方式在画面上附加展示，增强“多色可选”的信息传达。背景以柔和的浅灰色或米白色为主，营造干净、舒适的居家氛围，搭配绿植点缀，增加空间的自然感与生活气息。色彩方案以中性色为主，辅以绿植的生机绿和沙发的多样色调形成层次对比，整体和谐统一。\n\n字体选择现代简约风格，标题“新品上市”使用大号无衬线字体，字形饱满，放置在画面上部居中位置，采用深灰或深蓝色，强调稳重与品质感；次要信息如“多色可选”采用较小字号，搭配轻薄字体，灵活安排在沙发侧下方，字体颜色柔和，与背景和主体形成呼应。其他必要信息（如品牌Logo、促销信息等）可放置在画面底部，采用对齐布局，保持整体画面干净有序。\n\n沙发的细节如材质纹理和缝线处理通过光影表现，增强质感。设计元素中可加入柔和的光晕效果，模拟自然光从窗外洒入，增加画面的温馨感。整体画面布局紧凑，主体突出，绿植与背景进行适当虚化处理，突出沙发的核心地位，同时传递简约舒适的生活方式。"], "inputs": [{"shape": 7, "name": "anything", "link": 27, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": false}, "id": 26, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 11}, {"mode": 0, "outputs": [{"name": "STRING", "links": [24], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [300.4430236816406, 175.0053253173828], "pos": [-145.47128295898438, 260.99163818359375], "widgets_values": ["一套沙发在客厅，旁边有绿植，45度视角 ，新品上市，多色可选，3:4 的比例"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 27, "type": "Text Multiline", "properties": {"widget_ue