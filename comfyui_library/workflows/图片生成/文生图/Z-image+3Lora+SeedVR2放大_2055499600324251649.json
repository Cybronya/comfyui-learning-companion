alized_name": "IMAGE"}, {"name": "width", "links": [], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#223", "widgets_values": [512, 512, "lanczos", "stretch", "always", 8], "inputs": [{"name": "image", "link": 36, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "width"}, "name": "width", "link": 11, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 12, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "interpolation"}, "name": "interpolation", "label": "interpolation", "type": "COMBO", "localized_name": "interpolation"}, {"widget": {"name": "method"}, "name": "method", "label": "method", "type": "COMBO", "localized_name": "method"}, {"widget": {"name": "condition"}, "name": "condition", "label": "condition", "type": "COMBO", "localized_name": "condition"}, {"widget": {"name": "multiple_of"}, "name": "multiple_of", "label": "multiple_of", "type": "INT", "localized_name": "multiple_of"}], "flags": {}, "type": "ImageResize+", "mode": 0, "bgcolor": "#335", "size": [210, 218], "pos": [2612.87744140625, 319.018798828125], "id": 7, "properties": {"cnr_id": "comfyui_essentials", "ver": "1.1.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {"width": true, "height": true}, "Node name for S&R": "ImageResize+"}, "order": 28}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [27], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [283.1101379394531, 151.16993713378906], "pos": [1250.265380859375, 270.5419616699219], "widgets_values": ["anime-style illustration,\n{\n\"subject\": {\n\"name\": \"女剑客\",\n\"description\": \"一位身姿曼妙、气质空灵的女剑客。她拥有如瀑的长发，发间点缀着精致的金色发饰，面容温婉恬静，眼神柔和地凝视着观者，瞳孔呈现出璀璨的淡金色光芒，仿佛蕴含着星辰与流水的秘密。\"\n}\n,\n\"composition\": {\n\"perspective\": \"大透视（Low-angle shot with slight Dutch angle）：采用低角度仰拍并带有轻微倾斜的动态构图，极大地增强了角色的威严感与视觉冲击力，使人物显得更加高大挺拔。前景的剑刃或飘带形成强烈的视觉引导线，将视线聚焦于角色的面部。\"\n}\n,\n\"lighting\": {\n\"primary_lighting\": \"电影级光照（Cinematic Lighting）：采用经典的三点布光法，主光源来自侧上方，勾勒出角色柔和的轮廓；辅光用于填充阴影，保持细节清晰；逆光（Rim Light）则从背后打来，将角色的发丝和衣摆边缘染上明亮的银白色光辉，营造出神圣而飘逸的氛围。\",\n\"secondary_lighting\": \"环境光反射：周围飞溅的水珠与流动的风带反射出冷色调的蓝光，为角色面部和服装的暗部增添细腻的冷色反光，增强画面的层次感。\"\n}\n,\n\"style\": {\n\"art_style\": \"二次元动漫风格（Anime Style）：结合崩坏星穹铁道（Honkai: Star Rail）的高品质美术标准，线条细腻流畅，色彩饱和度适中，光影处理极具戏剧性。\",\n\"technical_quality\": \"顶级游戏美术插图（Top-tier game art illustration），8K超高清分辨率（Ultra-high resolution），细节丰富，画质精良，无瑕疵。\"\n}\n,\n\"clothing\": {\n\"main_outfit\": \"改良式古风战袍：采用黑、白、灰三色为主调的素雅配色，融合现代剪裁与东方元素。内层为修身的高开叉黑色紧身衣，勾勒出优美的身体曲线；外层是宽大的半透明白色薄纱披风，材质轻盈如羽，随风飘舞，形成复杂的动态褶皱。\",\n\"accessories\": \"配饰：腰间系有精致的金色腰饰和流苏，发间插着金色的步摇与发簪，耳垂上坠着流线型的金质耳环。长筒袜上绣有暗纹，脚踩黑色高跟战靴，整体造型既优雅又充满力量感。\"\n}\n,\n\"environment\": {\n\"background_elements\": \"水墨幻境：背景由流动的水墨构成，巨大的鲲鹏神兽在云雾中若隐若现，其形态如水墨晕染般虚幻缥缈，仿佛是从画卷中苏醒的古老图腾。\",\n\"atmosphere\": \"水与风的元素：画面中充满了动态的水流、飞溅的水滴以及无形的风带，它们围绕着角色旋转，形成漩涡状的视觉中心，增强了画面的动感与奇幻色彩。\"\n}\n,\n\"mood\": {\n\"emotional_tone\": \"温柔而威严（Gentle yet Majestic）：角色的表情温柔婉约，但挥剑的姿态却充满了力量感，展现出一种刚柔并济的独特气质。整体氛围静谧中蕴含着爆发力，梦幻而唯美。\"\n}\n,\n\"suggestive_elements\": {\n\"implied_narrative\": \"一位守护着古老神兽秘密的女剑客，在风暴的中心挥剑起舞，她的温柔是力量的一部分，而非软弱。\"\n}\n}"], "inputs": [{"name": "clip", "link": 31, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 79, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 24, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 20}, {"outputs": [{"name": "describe", "links": [85], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#2a363b", "shape": 1, "widgets_values": ["GLM-4.6V", 1215599609, "randomize", "你是高级美术总监，具备专业时尚顶尖的游戏美术审美，细致仔细观察你获得的图像，基于“设计案”与“对标物”的方向，输出z image格式的提示词。\n修改意见采用严谨的结构确保信息完整且无歧义，通过高度文学化、专业化的语法和词汇来精确控制画面的艺术风格、情感张力及细节品质。提示词的维度包括但不限于：画面主体/构图与视角/服装与配饰/材质与纹理表现/光影设计/环境与背景/情绪与氛围等。"], "inputs": [{"shape": 7, "name": "image1", "link": 76, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 83, "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "RH_Captioner_Pro", "mode": 0, "bgcolor": "#3f5159", "size": [321.5733642578125, 347.9904479980469], "pos": [903.1712646484375, -461.3154602050781], "id": 60, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Captioner_Pro"}, "order": 15}, {"mode": 0, "outputs": [{"name": "text", "links": [83], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [270, 82], "pos": [590.1279907226562, -175.57598876953125], "widgets_values": ["", ""], "inputs": [{"widget": {"name": "text1"}, "name": "text1", "link": 81, "label": "text1", "type": "STRING", "localized_name": "text1"}, {"widget": {"name": "text2"}, "name": "text2", "link": 82, "label": "text2", "type": "STRING", "localized_name": "text2"}], "flags": {}, "id": 66, "type": "TextCombinerTwo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextCombinerTwo"}, "order": 12}, {"mode": 0, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [510.1741943359375, 142.01223754882812], "pos": [708.6710205078125, 63.84892654418945], "widgets_values": ["masterpiece,best quality,ultra-detailed,anime style, character illustration, vibrant colors,soft shading, game character artwork,high-resolution,z image 正向提示词（设计案+对标物）\n\n设计案方向:\n- 画面主体: 东方高幻想女祭司/女将形象；黑色长发高束半盘，金雕步摇与流苏坠饰；白金紧身胸甲与黑金束腰，孔雀绿/蓝绿色宝石为核心视觉锚点；双臂金饰护臂与薄纱披肩随风扬起。\n- 构图与视角: 半身近景三分之二构图，略仰视三分侧面；主体置于黄金分割点，发丝与飘带形成S形动势；浅景深，背景虚化；画面右后侧高光轮廓勾勒肩颈与胸甲的体积。\n- 服装与配饰: 象牙白珠光胸甲+金色新巴洛克卷草金工，黑色束腰镶嵌红金描边；宝石为椭圆切割与水滴切割，金托爪镶；发冠、耳饰、臂环同系宝石与流苏串珠，点缀珐琅纹与细密金铆钉；肩部半透明纱袖外翻金边刺绣。\n- 材质与纹理表现: 抛光金属（镜面高光+微细擦痕）、珠光漆涂胸甲（细砂闪粉）、黑缎面束腰（低频丝织纹理）、半透雪纱（边缘刺绣与微微起皱）、宝石内含天然絮丝与折射火彩；肌肤具SSS与微汗膜高光，锁骨与肩头有柔和菲涅耳反射与茸毛高光。\n- 光影设计: 暖金色落日主光（约4500K）侧后打出强轮廓光，冷中性辅光（约5200K）轻抬面部与胸甲细节；金饰高亮镜面闪点，宝石出现切面光带；体积光与尘粒漂浮形成神圣氛围；轻微镜头辉光与六边形散景；电影级对比度与柔和暗角。\n- 环境与背景: 宫廷室内，远景木格窗与金漆壁面虚化，体积光从侧后穿入；微量金粉与花瓣尘屑悬浮；背景以暖棕金为主，服务主体金白与孔雀绿配色。\n- 情绪与氛围: 庄雅、神圣、克制的权威感；发丝与飘带的流动制造仪式感与风的低语；整体华贵而不喧哗。\n- 色彩与配比: 主色象牙白+古金；副色黑与深橙红描边；点睛色孔雀绿/蓝绿宝石（小面积高饱和）；胶片级金青对比色调，轻微胶片颗粒。\n- 相机与镜头: 85mm人像定焦，f/1.8，微距对焦胸甲与锁骨区域；浅景深+干净前景发丝叠影；轻微侧向运动虚化以增强动势。\n- 技术实现: 3D写实PBR，8K贴图与多层细分；Substance Painter金属粗糙度分区；XGen/GS 头发分束梳理与卡片混合；Marvelous Designer布料动态；UE5/RTGI/RT反射，ACEScg/Filmic色彩管理；精细皮肤微法线（毛孔/茸毛/微汗）与各向异性高光。\n\n对标物参考:\n- 画面质感/光影: UE5 电影级宣传海报、香槟金夕照氛围的时尚珠宝硬广、Vogue美妆棚拍光比。\n- 造型与金工: 新中式宫廷+新巴洛克金雕语汇，高级珠宝感（宝格丽式宝石体量与金托结构）。\n- 游戏美术标杆: 顶级国风高幻想角色CG宣传海报级标准（写实PBR+珠宝级金工呈现）。\n\n最终正向提示词:\n- 主体: 东方高幻想女祭司/女将，黑长发高束，金雕发冠与流苏耳坠，白金胸甲+黑金束腰，孔雀绿宝石点缀；半透明纱袖飘带随风\n- 构图与视角: 半身近景，略仰视三分侧面，黄金分割构图，S形动势发丝与飘带，浅景深，背景虚化\n- 服装与配饰: 象牙白珠光装甲、卷草金工描绘、红金细描边、臂环与胸坠统一宝石语言、珐琅微纹\n- 材质与纹理: 抛光金+微细刮痕、珠光漆胸甲细闪、黑缎低频织纹、雪纱半透绉感、宝石折射火彩与内含物、肌肤SSS+茸毛高光+微汗膜\n- 光影: 落日暖金主光侧后轮廓、冷中性辅光抬细节、体积光与尘粒漂浮、镜头辉光、六边形散景、轻暗角、金属高光闪点\n- 环境与背景: 宫廷室内木格窗与金漆壁面虚化，暖棕金色调，体积光斜入，漂浮金粉\n- 情绪与氛围: 庄雅神圣、克制华丽、仪式感风动\n- 色彩: 白/金为主，黑与深橙红为辅，孔雀绿高饱和点睛，金青对比胶片调\n- 相机: 85mm, f/1.8, 近景对焦胸甲与锁骨区域，轻微运动虚化与干净前景发丝叠影\n- 技术: 3D写实，PBR 8K，UE5 RTGI/RT反射，ACEScg，Substance材质分区，XGen头发与Marvelous布料，高级照片感，电影级品质"], "inputs": [{"name": "text", "link": 80, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 64, "type": "ShowText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText"}, "order": 21}, {"mode": 0, "outputs": [{"name": "text", "links": [79, 80], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [270, 82], "pos": [949.5361328125, -62.92485809326172], "widgets_values": ["", ""], "inputs": [{"widget": {"name": "text1"}, "name": "text1", "link": 84, "label": "text1", "type": "STRING", "localized_name": "text1"}, {"widget": {"name": "text2"}, "name": "text2", "link": 85, "label": "text2", "type": "STRING", "localized_name": "text2"}], "flags": {}, "id": 62, "type": "TextCombinerTwo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextCombinerTwo"}, "order": 18}, {"mode": 0, "outputs": [{"name": "string", "links": [84], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [406.8181457519531, 95.05939483642578], "pos": [902.0906372070312, -618.9880981445312], "widgets_values": ["masterpiece,best quality,ultra-detailed,anime style, character illustration, vibrant colors,soft shading, game character artwork,high-resolution,"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 61, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 5}, {"mode":