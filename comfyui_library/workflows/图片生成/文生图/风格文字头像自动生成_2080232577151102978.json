name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#9c6353", "shape": 2, "widgets_values": [], "inputs": [{"name": "anything", "link": 104, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy cleanGpuUsed", "mode": 0, "bgcolor": "#593930", "size": [256.5007629394531, 26], "pos": [8717.328125, 1761.4239501953125], "id": 76, "properties": {"cnr_id": "comfyui-easy-use", "ver": "e900c2ca9c0d90b0896881910ca7f3f02d88ebd8", "widget_ue_connectable": {}, "Node name for S&R": "easy cleanGpuUsed"}, "order": 16}, {"outputs": [{"name": "text", "links": [130], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#3eafd4", "widgets_values": ["钟"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#2a9bc0", "size": [396.375244140625, 485.4502868652344], "pos": [6592.498046875, 1172.3427734375], "id": 90, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "describe", "links": [131], "label": "describe", "type": "STRING", "localized_name": "describe"}], "size": [404.112548828125, 991.549560546875], "pos": [7409.43994140625, 1157.0946044921875], "widgets_values": ["", "", "", "# 角色定位\n你是专精中文姓氏艺术字设计的提示词工程师，精通即梦（Jimeng）、Banana等文生图平台的生成逻辑，擅长基于单个姓氏汉字输出结构标准、画面感强、出图率高的艺术字长提示词。你精通光影美学、材质表现、摄影参数与构图规则，能稳定生成不同风格的高质量文生图指令。\n\n# 核心任务\n接收用户输入的单个姓氏汉字，单次生成1款完整的高质量姓氏艺术字提示词。若用户明确指定风格，则严格匹配对应风格；若用户未指定风格，则从下方风格池中随机选取1种进行创作。单段提示词控制在200-300字，必须覆盖材质工艺、造型气质、前景装饰、背景氛围、光影布光、镜头参数、色调体系全要素。\n\n可选风格池：\n1. 国风经典类（水墨、陶瓷、岩彩、篆刻、织锦、玉雕等）\n2. 复古怀旧类（胶片、铜版画、老报纸、做旧金属、复古印刷等）\n3. 治愈软萌类（毛绒、奶油、花瓣、轻黏土、棉花糖等）\n4. 现代轻奢类（磨砂金属、雾面玻璃、实木、皮革、珐琅等）\n5. 科技赛博类（霓虹机甲、像素电子、液态金属、全息投影等）\n6. 硬核自然类（岩石、冰川、火山岩、户外肌理、自然结晶等）\n\n# 强制执行工作流\n步骤1：确认核心主体\n提取用户输入的姓氏单字，将其作为画面唯一核心视觉主体，所有视觉元素均围绕字体本身设计，不添加任何谐音梗、副标题及额外文字内容。\n\n步骤2：匹配单款风格\n根据用户指定或随机选取的风格方向，确定对应的材质、色调、氛围核心特征，保证风格统一、辨识度高。\n\n步骤3：模板填充生成\n将「目标姓氏字、风格专属元素」填入标准化模板，生成完整提示词。语序严格遵循文生图权重逻辑：核心主体在前，细节描述在后，全程使用正向肯定表述，不出现否定词。\n\n步骤4：单段连贯输出\n直接输出完整的提示词正文，无需分点、无需编号标题，语句流畅自然，要素完整。\n\n# 提示词标准化模板结构\n## 固定模块（每款必须保留，不可随意修改）\n- 核心主体：居中艺术字「目标姓氏字」占据画面65%\n- 镜头框架：默认使用100mm微距镜头，f/4光圈，字心核心纹理处精准对焦，前景微粒自然虚化；国风/复古类可替换为50mm标准镜头，f/5.6光圈\n- 画质收尾：8K超高清分辨率，XX主题海报级品质\n\n## 可变模块（按风格差异化设计）\n1. 材质工艺：字体的核心材质、表面肌理、细节纹路、工艺特征\n2. 造型气质：字体的弧度特征、笔画形态、整体气场、视觉感受\n3. 前景元素：字体周围飘散的微粒、雾效、装饰碎片，配合浅景深强化纵深感\n4. 背景设定：渐变底色、底层暗纹、整体环境氛围\n5. 光影布光：布光角度、主光类型、轮廓光颜色、明暗反差强度\n6. 色调体系：3个核心主色调，统一风格色彩调性\n\n# 输出规范\n1. 单段提示词严格控制在200-300字，要素齐全，语句流畅，无冗余重复表述\n2. 严格保留「居中占比65%」的固定设定，适配平台字体生成逻辑\n3. 所有描述均为正向肯定表述，不使用否定词，符合文生图平台的关键词权重规则\n4. 描述聚焦字体本身的视觉表现，不添加任何梗词、副标题及无关文字内容", "Hello", 0.6, 523594335, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "ref_image1", "label": "ref_image1", "type": "IMAGE", "localized_name": "ref_image1"}, {"shape": 7, "name": "ref_image2", "label": "ref_image2", "type": "IMAGE", "localized_name": "ref_image2"}, {"shape": 7, "name": "ref_image3", "label": "ref_image3", "type": "IMAGE", "localized_name": "ref_image3"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 130, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "tempera