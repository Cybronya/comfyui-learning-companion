ized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 4, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 22}, {"outputs": [], "color": "#2384ae", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 21, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#124459", "size": [1433.9019775390625, 1064.4598388671875], "pos": [-1016.7832641601562, -351.8740539550781], "id": 20, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 26}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [404.1869812011719, 778.5795288085938], "pos": [-1435.5880126953125, -64.416259765625], "widgets_values": ["一张超写实的特写肖像，描绘了一位面对风暴的年迈渔夫。雨滴划过他饱经风霜的脸庞，积聚在诉说着海洋故事的深深皱纹里。他穿着一件质感鲜明的亮黄色雨衣，与背景中动荡海洋的深沉忧郁的蓝色和灰色形成对比。他的眼神锐利如钢，反射出一生的坚韧。光线充满戏剧性，一道闪电照亮了他的侧脸，突出了皮肤的粗糙质感和胡须上的水珠。电影级8k分辨率。", "一幅新海诚风格的高质量动漫插画。一位充满活力的粉发高中女生站在黄金时段的火车站台上。她撑着一把透明雨伞，捕捉着夕阳温暖的橙色和紫色色调。樱花花瓣在空中飘落，与镜头光斑效果混合。背景是细节丰富、连绵不断的城市景观，电线和远处的摩天大楼在充满活力的天空下形成剪影。氛围怀旧而感性，拥有极其细腻的光影和云层渲染。", "一个坚毅的赛博朋克场景，描绘了一位半机械修理工在霓虹灯照耀的小巷里修理未来的悬浮摩托。修理工有一只带有外露线路和液压装置的机械手臂，手里拿着一把发光的等离子扳手。小巷潮湿且反光，映照着上方悬挂的日语汉字粉色和蓝色霓虹灯招牌。蒸汽从地面的通风口升起。悬浮摩托虽然时尚但已有磨损，划痕和污垢增添了真实感。整体风格具有电影感、黑暗且细节丰富，强调高科技机械与城市衰败之间的对比。", "黑暗奇幻概念艺术。一位身穿破旧银甲的孤独骑士站在破碎的悬崖边缘，俯瞰着巨大的、充满迷雾的深渊。从迷雾中浮现出一只由阴影和黑曜石组成的巨大的远古巨龙，它的眼睛闪烁着威胁的猩红光芒。骑士手持一把发出微弱神圣蓝光的剑，这是场景中唯一的希望之源。环境哥特式且荒凉，有扭曲的枯树和锯齿状的岩石。情绪是不祥且史诗般的，用厚重的阴影和戏剧性的比例描绘。", "一幅异想天开的3D渲染图，风格类似于高预算动画电影（如皮克斯或迪士尼）。一只毛茸茸的圆润仓鼠戴着微小的厨师帽，在一个建在挖空南瓜里的微型厨房里搅拌一锅汤。厨房温暖舒适，由烛光照亮。汤锅是用橡子壳做的。豌豆和胡萝卜片等蔬菜在仓鼠旁边显得过大。质感柔软且触感极佳，仓鼠的皮毛和南瓜果肉上有次表面散射效果。光线温暖、诱人且神奇。", "一个超现实的梦幻景观，以水晶和紫水晶构成的浮空岛屿为特色。瀑布从岛屿倾泻而下，落入下方的云海中，但水流在落下时变成了成群的蓝色蝴蝶。天空是柔和的粉色、淡紫色和柔和的青色的渐变，可以看到两个月亮——一个巨大且有陨石坑，另一个小而光滑。在前景中，一个透明的玻璃楼梯盘旋上升，通向最大的岛屿。风格空灵、流畅且富有想象力，唤起一种惊奇和宁静的感觉。", "一张复古的1980年代合成波美学照片。一辆德罗宁跑车沿着网格线的公路驶向一个巨大的落日，落日带有复古的渐变条纹。棕榈树排列在路边，但它们是由霓虹紫色线框构成的。天空是深邃的星空虚空。图像具有轻微的VHS颗粒效果和色差，以增强复古感。颜色以电光蓝、热粉色和夕阳橙为主。", "一张在黑暗、长满苔藓的森林中发光的生物发光蘑菇簇的微距摄影照片。蘑菇从菌盖下发出柔和、空灵的蓝光。一只带有金色壳的微小精致蜗牛正慢慢爬上最大蘑菇的茎。周围苔藓上的露珠反射着蓝光，在背景中营造出闪闪发光的散景效果。景深非常浅，使蜗牛和蘑菇保持清晰，同时将黑暗的森林背景模糊成神秘的形状。", "一幅色彩丰富、质感强烈的油画，描绘了黄昏时分繁忙的维多利亚时代街道场景。煤气灯在鹅卵石街道上投下温暖的黄色光芒，倒映在水坑中。马车和戴着高顶礼帽、穿着长裙的人们在雾中穿梭。笔触清晰且富有表现力，让人联想到印象派，捕捉运动和氛围而非完美的照片写实主义。调色板使用深棕色、雾灰色和温暖的赭石色。", "一张宁静的现代禅宗客厅建筑摄影照片。房间设有落地玻璃墙，可望见雨中的竹园。室内设计极简主义，配有低矮的米色家具、天然木条墙和抛光混凝土地板。一套陶瓷茶具放在再生木咖啡桌上，茶杯冒着热气。光线柔和漫射，来自外面的阴天，营造出一种平静、冥想的氛围。"], "inputs": [{"shape": 7, "name": "anything", "link": 55, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 61, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 17}, {"mode": 0, "outputs": [{"name": "INT", "links": [60], "label": "INT", "type": "INT", "localized_name": "INT"}], "size": [389.59930419921875, 64.67835235595703], "pos": [-1427.04296875, -190.3697052001953], "widgets_values": [1280], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "id": 63, "type": "ImpactInt", "properties": {"cnr_id": "comfyui-impact-pack", "ver": "705698faf242851881abd7d1e1774baa3cf47136", "widget_ue_connectable": {}, "Node name for S&R": "ImpactInt"}, "order": 0}, {"mode": 0, "outputs": [{"name": "INT", "links": [59], "label": "INT", "type": "INT", "localized_name": "INT"}], "size": [387.40045166015625, 86.33625793457031], "pos": [-1429.95654296875, -327.1026306152344], "widgets_values": [720], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", 