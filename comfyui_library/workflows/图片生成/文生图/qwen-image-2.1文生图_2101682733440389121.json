positive"}, {"name": "negative", "links": [687], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent", "links": [], "label": "latent", "type": "LATENT", "localized_name": "latent"}], "size": [530, 680], "pos": [742.98974609375, 2456.70166015625], "widgets_values": ["masterpiece, best quality, hyper-realistic photo, 8k, UHD，一位披肩长发的年轻女子端坐于中式古建屋顶，她身着素雅的白绢上襦配朱砂色的交窬裙，宽大的衣袖随风轻摆，一条极长的绛红色宫绦从腰间垂落，蜿蜒盘曲在青黑色的瓦片之上。春寒料峭，残雪初融，天气却格外晴朗，橙黄色的夕照从画面右上方温柔洒落，为她周身勾勒出一圈明亮的金色轮廓，发丝在逆光中纤毫毕现，泛着琥珀色的光晕。\n\n她微微侧首回望镜头，唇角含着一抹恬淡的微笑，眼神温婉而略带思索。中景构图以50mm焦距捕捉，深景深让前景的深色屋瓦与一枝探出的粉色海棠清晰可见，中景是女子娴静的坐姿与波光粼粼的河面，背景则是一座苍古朴拙的石拱桥横跨两岸，桥身倒映在如镜的水面上。河对岸薄雾氤氲，隐约可见积雪覆盖的草丛与几间茅舍的轮廓，近处两叶扁舟随波轻荡，极远处丘陵起伏，天地空旷悠远。\n\n光线是这场视觉盛宴的主角，夕阳的暖光为主调，在水面折射出碎金般的光芒，与人物阴影处的深蓝冷调形成细腻对比。空气中有微尘浮动，被斜照染成金粉，屋顶的瓦片带着岁月风化的斑驳纹理，女子的衣裙褶皱自然垂顺，绢料透着柔光，红色裙裾如花瓣般铺展。整幅画面宁静祥和，光影层次丰富而柔和，每一处细节都充盈着诗意的美感，从青瓦的质感、水波的涟漪到远山的轮廓，无不精致入微，仿佛能听见微风拂过发梢的细微声响，感受到春日黄昏的温暖与淡淡忧思。", "", 1024], "inputs": [{"name": "clip", "link": 681, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "negative_prompt"}, "name": "negative_prompt", "label": "negative_prompt", "type": "STRING", "localized_name": "negative_prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "INT", "localized_name": "resolution"}], "flags": {}, "id": 469, "type": "TextEncodeQwenImage21", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImage21"}, "order": 7}, {"mode": 0, "outputs": [{"name": "images", "links": [], "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [469.3750305175781, 715.7373657226562], "pos": [1886.549072265625, 2552.93408203