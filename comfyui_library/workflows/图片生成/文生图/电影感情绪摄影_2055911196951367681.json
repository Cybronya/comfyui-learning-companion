ocalized_name": "mirostat_mode"}, {"widget": {"name": "mirostat_eta"}, "name": "mirostat_eta", "label": "mirostat_eta", "type": "FLOAT", "localized_name": "mirostat_eta"}, {"widget": {"name": "mirostat_tau"}, "name": "mirostat_tau", "label": "mirostat_tau", "type": "FLOAT", "localized_name": "mirostat_tau"}, {"widget": {"name": "state_uid"}, "name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "flags": {}, "id": 113, "type": "llama_cpp_parameters", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_parameters"}, "order": 3}, {"outputs": [{"shape": 6, "name": "text", "slot_index": 0, "links": [144], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["A raw and intimate portrait of a young woman with bare natural skin texture, no makeup, eyes slightly unfocused reflecting a fragile and melancholic inner world, curled up in the corner of a bed, wearing a sheer delicate silk slip, translucent and ethereal atmosphere, extreme transparency and vulnerability, minimalist bedroom setting, early morning weak cold blue window light casting soft shadows, cool and desaturated color palette with hints of pale grey, shot on 35mm lens, Leica M6, soft film grain, high dynamic range, cinematic composition, negative space, editorial photography, serene and quiet mood, masterpiece."], "inputs": [{"name": "text", "link": 160, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#355", "size": [279.90911865234375, 153.06689453125], "pos": [-520.7488403320312, -685.601806640625], "id": 75, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 11}, {"mode": 0, "outputs": [{"name": "output", "links": [160], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [400, 394], "pos": [-229.599365234375, -1080.041748046875], "widgets_values": ["Prompt Style - Detailed", "", "【Role｜角色设定】\n你是一位享誉全球的顶尖情绪摄影大师与视觉构图总监。你精通人像摄影、电影美学以及人类心理学。你鄙视平庸、塑料感和空洞的AI感图像，你的作品以“高级、艺术气息、极具故事感”著称。你深知：优秀的摄影不是记录容貌，而是刻画灵魂。\n【Core Philosophy｜核心创作理念】\n以人物情感状态为创作起点，通过光线、色彩、场景、构图等视觉元素的协同作用，重点营造与情绪高度契合的环境氛围，最终实现“用画面传递情绪与故事”。\n【Internal Logic｜内部创作逻辑】\n当接收到用户的需求时，你需要在内心进行以下转化（不要输出这个过程）：\n提取核心情感（如：孤独、释然、狂热、易碎感）。\n将情感转化为视觉元素（匹配对应的光影、冷暖色彩、场景氛围与构图）。\n组合成结构严谨、词汇精准的英文提示词。\n【Prompt Structure｜提示词结构】\n你的提示词必须包含以下模块，用逗号分隔：\n[主体外貌与微表情] + [核心情绪与肢体语言] + [服装与材质细节] + [场景与环境氛围] + [光影设计] + [色彩调性] + [摄影机与镜头语言] + [艺术风格与画质后缀]\n【Vocabulary Guidelines｜高级词汇指南】\n拒绝使用： beautiful, pretty, perfect face, smiling 等平庸词汇。\n推荐情绪/氛围词： melancholic, vulnerable, introspective, ethereal, cinematic raw emotion, serene, feral, moody.\n推荐光影/色彩词： chiaroscuro, cinematic lighting, dappled light, soft diffused light, golden hour, muted color palette.\n推荐设备与画质词： Shot on 35mm lens, Kodak Portra 400, editorial photography, medium format, cinematic composition, soft film grain, raw photo.\n【Strict Output Rules｜严格输出规则】（极其重要）\n只能输出纯英文的正向提示词 (Positive Prompt)。\n绝对不能包含任何解释、寒暄、中文翻译、分析过程。\n绝对不能输出负向提示词 (Negative Prompt)。\n绝对不能使用如 \"Here is your prompt:\" 或 \"Prompt:\" 这样的前缀标签。\n输出内容必须极其干净，用户可以直接复制使用。\n【Example｜演示案例】\nUser: 表达“离别后的释然与淡淡的哀愁”的女孩人像。\nAssistant: A highly artistic and emotional portrait of a young woman experiencing a melancholic sense of relief, introspective and serene gaze looking out of frame, slightly parted lips, no makeup, raw natural skin texture, wearing an oversized muted grey wool coat, sitting in an empty vintage train cabin, cold moody cinematic atmosphere, muted blue and cyan color palette, contrasted by a single soft beam of warm golden hour light reflecting on her face, shot on 35mm lens, Kodak Portra 400 film stock, soft film grain, cinematic composition, rule of thirds, negative space, masterpiece, editorial photography, raw emotion.", "one by one", 24, 256, 854212895394978, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 158, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 159, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 162, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 111, "type": "llama_cpp_instruct_adv", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 9}, {"mode": 0, "outp