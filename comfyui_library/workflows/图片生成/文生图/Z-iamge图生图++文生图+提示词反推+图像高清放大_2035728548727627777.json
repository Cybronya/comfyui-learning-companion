引导。光影柔和，主光源自左前方打来，勾勒出人物轮廓与服饰纹理，面部光影过渡细腻，鼻梁与唇角微光，增强立体感。整体氛围静谧唯美，如月下仙子独舞，兼具古典东方美学与现代光影艺术，画面层次丰富，虚实相生，充满诗意与神秘感。提示词：一位身着粉色珍珠金线汉服的年轻女子，发髻高挽饰以莲花发簪与流苏珍珠，长发飘逸，衣袂轻盈，侧身回眸，眉目如画，唇色如桃花，背景深紫朦胧，如夜幕星尘，光影柔和，构图中近景特写，氛围静谧唯美，古典东方美学与现代光影艺术结合，如月下仙子独舞，充满诗意与神秘感。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#335", "size": [420.4696044921875, 620.29345703125], "pos": [-1353.2047119140625, 314.2238464355469], "id": 53, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 8}, {"outputs": [{"name": "value", "links": [87], "label": "值", "type": "*", "localized_name": "value"}], "color": "#233", "widgets_values": [0], "inputs": [{"shape": 7, "name": "value0", "link": 110, "label": "值0", "type": "*", "localized_name": "value0"}, {"shape": 7, "name": "value1", "link": 88, "label": "值1", "type": "*", "localized_name": "value1"}, {"widget": {"name": "index"}, "name": "index", "link": 126, "label": "index", "type": "INT", "localized_name": "编号"}, {"name": "value2", "label": "value2", "type": "*"}, {"name": "value3", "label": "value3", "type": "*"}, {"name": "value4", "label": "value4", "type": "*"}, {"name": "value5", "type": "*"}, {"name": "value6", "type": "*"}, {"name": "value7", "type": "*"}, {"name": "value8", "type": "*"}, {"name": "value9", "type": "*"}, {"name": "value10", "type": "*"}, {"name": "value11", "type": "*"}, {"name": "value12", "type": "*"}, {"name": "value13", "type": "*"}, {"name": "value14", "type": "*"}, {"name": "value15", "type": "*"}, {"name": "value16", "type": "*"}, {"name": "value17", "type": "*"}, {"name": "value18", "type": "*"}], "flags": {}, "type": "easy anythingIndexSwitch", "mode": 0, "bgcolor": "#355