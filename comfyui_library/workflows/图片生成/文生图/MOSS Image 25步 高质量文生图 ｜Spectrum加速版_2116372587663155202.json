e": "weight_dtype"}, "name": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "type": "UNETLoader", "mode": 0, "bgcolor": "#335", "size": [299.28960256437074, 82], "pos": [5831.070728359886, 2629.592600839504], "id": 28, "properties": {"cnr_id": "comfy-core", "ver": "0.41.0", "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 3, "widgets_values_named": {"weight_dtype": "default", "unet_name": "Moss-dirtyMoss_int8_convrot.safetensors"}}, {"outputs": [{"name": "CLIP", "links": [30, 31], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#223", "widgets_values": ["qwen3.5_9b_bf16.safetensors", "moss_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#335", "size": [298.9998816083622, 108.8391118864356], "pos": [5831.070728359886, 2770.8119111576575], "id": 29, "properties": {"cnr_id": "comfy-core", "ver": "0.41.0", "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 4, "widgets_values_named": {"clip_name": "qwen3.5_9b_bf16.safetensors", "type": "moss_image", "device": "default"}}, {"outputs": [{"name": "STRING", "links": [85], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#3a873a", "widgets_values": ["9:16 竖画幅，低角度仰拍，清新治愈春日花海少女写真，85mm 定焦人像镜头，f1.4 超大光圈，极致奶油浅景深，焦点精准锁定少女面部，焦内清晰锐利，前景与远景柔和虚化。年轻东亚少女，蓬松慵懒深棕色大波浪长卷发，许多细碎发丝随风轻轻扬起，清透元气淡妆，淡淡的蜜桃腮红，柔和红润唇色，皮肤白皙通透，保留细腻自然的皮肤肌理，不过度磨皮。少女抬头，目光轻柔望向斜上方，神情松弛又带着淡淡的憧憬，灵动温柔。身着纯白色镂空蕾丝吊带连衣裙，裙身带有精致小孔纹理，轻盈飘逸；双手轻轻捧起一束橙黄色小野花，手指姿态轻柔自然。光影为午后温柔侧逆光，阳光从人物斜后方洒落，勾勒出一圈通透耀眼的金色发丝轮廓光，面部依靠柔和环境漫射光补亮，光影过渡顺滑柔和，没有生硬阴影，画面笼罩一层淡淡的柔光光晕，暖金色阳光和清冷蓝天色调相互平衡。前景是环绕画面四周的成片橙黄色小野花，全部做重度虚化散景，朦胧柔和，形成天然画框，营造强烈空间纵深感。背景是澄澈干净的浅淡蓝色晴空，点缀几缕轻薄舒展的白色软云，空旷简洁，没有多余杂物。画面上半部分留出大面积蓝天留白，构图轻盈舒展，呼吸感十足，生活化抓拍感，写实商业人像摄影，8K 高清画质，色彩干净明亮，清新明媚的春日氛围，柔和梦幻柔光质感，韩系治愈风，无夸张调色，没有文字、水印、图标和多余杂物。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "提示词", "mode": 0, "bgcolor": "#267326", "size": [397.83058905786925, 229.7816362233674], "pos": [5402.03861358481, 2629.592600839504], "id": 76, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.16.3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"value": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 5, "widgets_values_named": {"value": "9:16 竖画幅，低角度仰拍，清新治愈春日花海少女写真，85mm 定焦人像镜头，f1.4 超大光圈，极致奶油浅景深，焦点精准锁定少女面部，焦内清晰锐利，前景与远景柔和虚化。年轻东亚少女，蓬松慵懒深棕色大波浪长卷发，许多细碎发丝随风轻轻扬起，清透元气淡妆，淡淡的蜜桃腮红，柔和红润唇色，皮肤白皙通透，保留细腻自然的皮肤肌理，不过度磨皮。少女抬头，目光轻柔望向斜上方，神情松弛又带着淡淡的憧憬，灵动温柔。身着纯白色镂空蕾丝吊带连衣裙，裙身带有精致小孔纹理，轻盈飘逸；双手轻轻捧起一束橙黄色小野花，手指姿态轻柔自然。光影为午后温柔侧逆光，阳光从人物斜后方洒落，勾勒出一圈通透耀眼的金色发丝轮廓光，面部依靠柔和环境漫射光补亮，光影过渡顺滑柔和，没有生硬阴影，画面笼罩一层淡淡的柔光光晕，暖金色阳光和清冷蓝天色调相互平衡。前景是环绕画面四周的成片橙黄色小野花，全部做重度虚化散景，朦胧柔和，形成天然画框，营造强烈空间纵深感。背景是澄澈干净的浅淡蓝色晴空，点缀几缕轻薄舒展的白色软云，空旷简洁，没有多余杂物。画面上半部分留出大面积蓝天留白，构图轻盈舒展，呼吸感十足，生活化抓拍感，写实商业人像摄影，8K 高清画质，色彩干净明亮，清新明媚的春日氛围，柔和梦幻柔光质感，韩系治愈风，无夸张调色，没有文字、水印、图标和多余杂物。"}}, {"mode": 0, "outputs": [{"name": "output", "links": [], "label": "输出", "type": "*", "localized_name": "output"}], "bgcolor": "#335", "size": [218.13180855270184, 27.065164731217465], "color": "#223", "pos": [7001.387729700722, 2732.2950743597385], "inputs": [{"name": "anything", "link": 439, "label": "输入任何", "type": "*", "localized_name": "输入任何"}], "flags": {"collapsed": false}, "id": 92, "type": "easy cleanGpuUsed", "properties": {"ver": "b0b47ca1372117fce575d