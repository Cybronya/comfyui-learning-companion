akers with dark soles visible from behind. Across all panels, the lighting is soft, even, and shadow-minimized, with neutral color grading, crisp edges, and a polished model-sheet presentation suitable for character design, casting reference, or fashion documentation. There is no dialogue or speech in this image."], "inputs": [{"shape": 7, "name": "anything", "link": 710, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#335", "size": [538.0350341796875, 344.864501953125], "pos": [1261.2593994140625, 3069.078369140625], "id": 484, "properties": {"cnr_id": "comfyui-easy-use", "ver": "d9c2072a2de5f51ef9898ec50ccd4dda82e16126", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 13}, {"outputs": [{"name": "LATENT", "links": [686], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#223", "widgets_values": [1024, 1024, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 688, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 689, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "type": "EmptyLatentImage", "mode": 0, "bgcolor": "#335", "size": [210, 106], "pos": [1002.5826416015625, 2702.8466796875], "id": 474, "properties": {"cnr_id": "comfy-core", "ver": "0.36.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"width": true, "height": true}, "Node name for S&R": "EmptyLatentImage", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#