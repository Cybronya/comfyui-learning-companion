eoupscaler", "ver": "2.5.14", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"color_correction": true, "batch_size": true, "seed": true, "uniform_batch_size": true, "enable_debug": true, "latent_noise_scale": true, "prepend_frames": true, "offload_device": true, "temporal_overlap": true, "input_noise_scale": true, "resolution": true, "max_resolution": true}, "Node name for S&R": "SeedVR2VideoUpscaler"}, "order": 26}, {"outputs": [{"name": "text", "links": [41], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["夸张视角，非传统构图杂志封面，《LANDI MAGAZINE》2025 年 11 月1号，珠海美食节主题。画面中心是一位年轻女孩手持横琴蚝刺身拼盘的人物，、红色围裙（印 “2025 珠海美食节”），姿态自然。左侧是美食节白色帐篷摊位，摆斗门艾饼、唐家茶果、海味玻璃罐，挂橙色三角旗；右侧海蓝色（HEX#1E90FF）双层观光巴士动态模糊，穿画面右侧。背景是港珠澳大桥，蓝天白云。​顶部左上角浅灰（HEX#E0E0E0）“Style Food Culture Design Travel”（“Food” 蓝色加粗），右上角中灰（HEX#A0A0A0）“ 2025 ”“THE MAGAZINE FROM EUROSTAR”（旁加 “ZHUHAI FOOD FESTIVAL SPECIAL”），右角落半透浅蓝 “TASTY ZHUHAI”。底部三栏中灰文字（美食节攻略、非遗美食、骑行路线），人物下方蓝粗体 “ZHUHAI FOOD FESTIVAL 2025”、白小字 “2025/ 11 / 01 横琴会展中心”。​珠海午后漫射光，明暗反差 3:1，食物加细微反光。高级灰（75%-80%）、暖橙（8%-10%）、海蓝（7%-9%），版画肌理，写实带复古时尚，层次分明，动态生活化。​"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [373.86383056640625, 239.79339599609375], "pos": [-59.475582122802734, 328.2518615722656], "id": 33, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "size": [304.3381652832031, 131.81813049316406], "pos": [-454.5268249511719, 219.2722625732422], "inputs": [], "flags": {}, "id": 53, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "s