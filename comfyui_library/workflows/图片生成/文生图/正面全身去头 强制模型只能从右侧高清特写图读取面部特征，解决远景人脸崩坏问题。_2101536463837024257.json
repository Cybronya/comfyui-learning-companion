 "#2d5a27", "widgets_values": ["75effaf9bce3bc09f4136166e75ec27958ca4c3a10a5483e5e4e22da2640cca7.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {"collapsed": false}, "type": "LoadImage", "mode": 0, "bgcolor": "#4a8f3f", "size": [437.0756530761719, 664.9334106445312], "pos": [110.03876495361328, 64.29649353027344], "id": 21, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 9}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [270, 314], "pos": [605.1589965820312, 115.21198272705078], "widgets_values": ["1044f7d106355ec2d87c266b673aeef4002148636314073f1d631867f7d65b3b.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 3, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [22], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [270, 314.0000305175781], "pos": [612.4288330078125, 482.68109130859375], "widgets_values": ["ab404e10ad28e8d63056c51843c48dd10eeac98367afc54a6909ed44bcb3958c.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 7, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"outputs": [{"name": "prompt", "links": [21], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#322", "widgets_values": ["生成一套人物三视图角色表（Character Sheet）：正面全身、背面全身、脸部特写，整体构图与取景参考图1，人物替换为图2中的人物与服装。\n\n【参考图分工——严格锁定】\n- 图1（脸部特写）：唯一面部信息来源；特写视图的构图、角度、取景与光影风格以图1为准。\n- 图2（正面全身，无头）：正面视图的人物体型、姿态、发型、服装版型与配色来源；此图头部已做无头处理，模型不得从该图推断任何面部特征。\n- 图3（背面全身）：背面视图的服装结构、细节、背部头部轮廓与整体造型来源。\n\n【面部硬约束（无头技巧）】\n- 正面全身视图：头部区域无头处理，不生成面部细节，不生成模糊小脸。\n- 背面全身视图：保留完整背部头部细节——后脑勺轮廓、头发背面、发际线走向、颈部背面，发色发型与特写视图一致；但不得出现正面五官，不得转头露脸。\n- 面部特征只允许出现在脸部特写视图中，且必须严格还原图1：同一张脸、同一五官、同一发型，跨视图不得漂移。\n- 禁止从任何全身视图抓取、推断、补画或脑补面部特征。\n人物资产布局提示词（优化版）横向16:9人物资产布局。画面左侧约占48%，并排放置两幅站立全身视图；右侧约占52%，只放置一幅正面胸像。不设置标题区、人物信息区、文字、标签、分隔线、边框、logo或水印。\n左侧第一幅：严格正面的无头全身视图，从颈部附近干净截断至双脚脚底；允许保留一小段自然颈部，但不得出现下巴、脸、耳朵、头皮或头发。身体正对镜头，双肩水平，双臂自然下垂，完整展示服装正面结构、双手、双腿和鞋子。\n左侧第二幅：包含完整头部和发型的严格180度背面全身视图，不得成为侧后方或三分之四背面。身体背对镜头，双肩水平，双臂自然下垂，完整展示服装背面结构、双手、双腿和鞋子。\n左侧正面与背面必须使用同一个身体模型、同一个真实身体尺寸和完全相同的镜头缩放。双脚底、脚踝、膝盖、裆部、腰线、手腕、肘部和肩线逐项水平对齐；肩宽、胯宽、躯干长度、腿长、手臂长度、站姿宽度、鞋子大小和底部留白完全一致。背面头部从对齐后的肩线上方自然延伸，头顶应高于无头正面的颈部截口；不得为了放入完整头部而缩小背面人物，也不得强求两幅视图的可见外框总高度相同。\n右侧只放置一幅胸部以上的严格正面人物肖像。人物身体与脸部完全正对镜头，左右肩膀等高，胸骨、颈部、下巴、鼻梁和画面中轴处于同一条垂直线上，双眼处于同一水平线，左右耳朵透视基本对称。头部保持自然竖直，不歪头、不低头、不仰头、不侧转；身体不倾斜、不斜肩、不扭转。完整保留发顶及头部左右两侧的发型轮廓，下边缘停在胸部，不出现腰部或腰带。不得出现侧脸、三分之四脸、第二张头像或其他附加视图。\n三个视图必须属于同一个人物，身份、身体比例、发型、服装结构、材质、颜色、纹样、配件和鞋子保持一致。背景为干净的浅中性灰色无缝影棚背景，以自然留白区分左右区域，不绘制面板网格、地面线、脚下投影或展示台。全图统一使用正前方大面积中性影棚柔光和轻微正面补光，禁止顶光、头顶集中高光、轮廓光、彩色染光、环境光效、暗角和电影化调色。\n【一致性要求】\n- 三视图必须为同一人物：体型、发型（含背部头发形态）、服装版型、配色、图案、饰品跨视图一致。\n- 服装以图2、图3为准，不得篡改版型、颜色、图案与材质。\n\n【负面约束】\n模糊脸，脸部崩坏，多张不同的脸，面部特征漂移，脸型改变，五官错位，从全身图推断出的脸，远景小脸，背面视图露正脸，转头露脸，头部缺失，后脑勺缺失，头发变形，服装变形，图案错乱，配色改变，肢体畸形，额外肢体，透视错误，风格不统一。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#533", "size": [400, 200], "pos": [958.2979736328125, 163.29501342773438], "id": 18, "properties": {"cnr_id": "comfyroll", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 12}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [-178.32124625587562, 76.66338717781134], "scale": 0.45000000000000023}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "gpt-image-2.5 （默认生成比例9:16，默认画质4K）请在节点23选择自定义的比例和分辨率，", "bounding": [595.1589965820312, 41.61200714111328, 1147.3095703125, 1140.9864501953125]}], "links": [[21, 18, 0, 23, 11, "STRING"], [22, 7, 0, 23, 0, "IMAGE"], [23, 8, 0, 23, 1, "IMAGE"], [24, 23, 0, 4, 0, "IMAGE"]], "id": "0e640800-744f-4f90-9eb9-0abbdd2ef13b", "config": {}, "version": 0.4, "last_node_id": 24, "revision": 0}