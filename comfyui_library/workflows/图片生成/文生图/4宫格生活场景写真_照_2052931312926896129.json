n      \"location\": \"明亮咖啡角\",\n      \"environment\": \"圆形白色大理石桌，藤椅，可俯瞰街道的大窗户。\",\n      \"pose\": \"坐在桌旁，边吃边笑，手里拿着叉子。\",\n      \"action\": \"吃牛油果吐司。\",\n      \"props\": [\n        \"盘子里的牛油果吐司\",\n        \"玻璃杯里的紫色冰沙\",\n        \"叉子\",\n        \"Assouline 书\"\n      ]\n    }\n  ]\n}"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 3, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 1}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-86.51351632224532, -43.474196658301196], "scale": 1.771561000000001}}, "groups": [], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 3, 0, 1, 10, "STRING"], [3, 1, 0, 4, 0, "IMAGE"]], "id": "9c3a3860-f4de-4cd4-b069-4294fc2048be", "config": {}, "version": 0.4, "last_node_id": 4, "revision": 0}