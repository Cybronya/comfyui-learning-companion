，勾勒出她清晰的面部轮廓，与远处虚化的车灯光斑形成冷暖对比。整体色调为冷调的蓝灰与雨夜湿地的深黑，点缀着远处暖黄的微光，光影、雨水与空旷街道共同营造出一种孤独、疲惫且漫长的等待氛围。宽幅构图强化了人物在空旷雨夜中的渺小感以及向黑暗深处延伸的无尽街道所带来的疏离感。\n\n\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 107, "type": "PrimitiveStringMultiline", "title": "String (Multiline - Prompt)", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.42.11", "VHS_latentpreview": false, "ds": {"offset": [-392.9068550447665, 988.4937709203932], "scale": 0.658845000000005}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "Text to Image", "bounding": [690.4856567382812, 496.85467529296875, 1450, 1060]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Image Size", "bounding": [720.4856567382812, 1236.854736328125, 310, 290]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Prompt", "bounding": [1040.4857177734375, 546.8546752929688, 470, 670]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Model", "bounding": [710.4856567382812, 546.8546752929688, 320, 670]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "Prompt Enhancement", "bounding": [690.4856567382812, -423.14532470703125, 1450, 890]}, {"color": "#b58b2a", "font_size": 80, "flags": {}, "id": 7, "title": "👉用我的邀请码注册送1000RH币👉邀请码：3qo65owt", "bounding": [684.0599365234375, -771.57275