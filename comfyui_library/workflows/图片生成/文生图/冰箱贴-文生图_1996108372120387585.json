"type": "CONDITIONING", "localized_name": "条件"}], "size": [333.0157470703125, 442.97467041015625], "pos": [-1209.1072998046875, -92.06330108642578], "widgets_values": ["一个冰箱贴，这是一枚以洪崖洞为主题的金属徽章。主体呈五角星形状，边缘有金色装饰。画面中心是洪崖洞，建筑细节精致，呈现出红与金的配色。周围，左侧是李子坝轻轨站(穿楼轻轨)建筑群，右侧还能看到解放碑；下方有河流，河上有游船，岸边点缀着绿色的树木。天空中有几朵白色的云朵，还散布着一些金色的小圆点，像是星星。徽章底部有一条米色的丝带，上面用深棕色的字体写着 “chongqing”。整个徽章设计风格精致，色彩搭配和谐，突出了洪崖洞的著名地标，充满了艺术感和城市特色。背景为纯白色，使得徽章的细节更加清晰突出。"], "inputs": [{"name": "clip", "link": 4, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 6, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 7}], "extra": {"links_added_by_ue": [], "0246.VERSION": [0, 0, 4], "IV2Z_MetadataImage": true, "IV2Z_KeepIntermediate": true, "VHS_latentpreview": false, "ds": {"offset": [511.428459445935, 344.1880048921801], "scale": 0.7972024500000005}, "VHS_KeepIntermediate": true, "IV2Z_latentpreview": false, "ue_links": [], "VHS_MetadataImage": true, "IV2Z_latentpreviewrate": 0, "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0"}, "groups": [{"color": "#b58b2a", "font_size": 24, "flags": {}, "id": 1, "title": "主程序", "bounding": [-561.8013916015625, -169.14373779296875, 1997.6956787109375, 573.7908325195312]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "出图区", "bounding": [-1224.2481689453125, -169.1201629638672, 632.0601196289062, 580.1389770507812]}, {"color": "#b58b2a", "font_size": 24, "flags": {}, "id": 3, "title": "保存图像", "bounding": [1480.9583740234375, -188.98040771484375, 541.4036865234375, 601.8248291015625]}], "links": [[2, 1, 0, 4, 0, "MODEL"], [3, 6, 0, 5, 1, "CONDITIONING"], [4, 2, 0, 6, 0, "CLIP"], [5, 7, 0, 5, 2, "CONDITIONING"], [6, 6, 0, 7, 0, "CONDITIONING"], [7, 8, 0, 5, 3, "LATENT"], [8, 5, 0, 9, 0, "LATENT"], [10, 3, 0, 9, 1, "VAE"], [14, 4, 0, 5, 0, "MODEL"], [16, 4, 0, 