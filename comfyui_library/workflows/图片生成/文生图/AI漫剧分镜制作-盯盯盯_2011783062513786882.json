露，天边泛鱼肚白\t晨曦呈暖调淡金色，心灯光芒与晨曦交融，灵力气流透明带淡青色，人物面部光影柔和，神情自然\n9\t远景\t青云宗望月台与远山\t青禾：站立望月台，手持心灯，望向远方；远山轮廓、初升朝阳的霞光\t清晨，朝阳初升\t霞光呈橙红渐变，远山层次清晰，心灯光芒在晨光中柔和不突兀，人物剪影与霞光和谐，画面开阔\n\n\n"], "inputs": [], "flags": {}, "id": 17, "type": "PrimitiveNode", "properties": {"widget_ue_connectable": {}, "Run widget replace on values": false}, "order": 10}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [19], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [270, 314.0000305175781], "pos": [-469.4467468261719, 792.6962890625], "widgets_values": ["97732a1a3a0dbc9e0128abbb10e5456d8d59d15f95d0c0af1997f8b74493f8b2.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 11, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 4}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [831.3128051757812, 745.4354858398438], "pos": [528.5003662109375, -53.289039611816406], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 21, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {"collapsed": false}, "id": 18, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 12}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "frontendVersion": "1.35.9", "ds": {"offset": [-185.06250849178429, -63.35790331579895], "scale": 1.7088742511245907}}, "grou