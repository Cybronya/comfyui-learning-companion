 "pos": [166.38462829589844, -773.0383911132812], "widgets_values": ["**主题：边关摆烂指南**\n\n视觉主体：一位身穿明光铠甲的古代边将，头戴战盔歪斜，慵懒地瘫靠在烽火台垛口上，一手举着酒壶，一手比\"OK\"手势，表情享受闭眼微笑，身后狼烟袅袅升起却无人理会。背景为大漠孤烟、残阳如血、城墙绵延，远处敌军骑兵隐约可见。\n\n风格：国潮工笔重彩+现代漫画夸张表情，色彩以赭石、朱砂、鎏金为主调，狼烟用流动水墨晕染，整体画面有敦煌壁画的厚重肌理感，人物面部带Q版幽默感。\n\n文字：主标题\"边关摆烂指南\"（粗犷毛笔飞白体，朱砂红），副标语\"烽火连天，我先躺了\"（小篆风格，金色描边），角落盖一方红色闲章\"躺赢\"。\n\n构图：竖版，人物居中偏下，上方留白给狼烟与天空，文字横排于顶部。"], "inputs": [{"shape": 7, "name": "anything", "link": 107, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 48, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 18}, {"outputs": [{"name": "MODEL", "links": [82], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#223", "widgets_values": ["qwen_image_2.1_int8_convrot.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLoader", "mode": 0, "bgcolor": "#335", "size": [492.41094970703125, 89.23526000976562], "pos": [1976.1531982421875, -1060.754638671875], "id": 50, "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen_image_2.1_int8_convrot.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"}], "ver": "0.36.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 1}, {"outputs": [{"name": "positive", "links": [83], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"