ze": [210, 106], "pos": [1315.24560546875, 549.6607666015625], "widgets_values": [1080, 1920, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 3, "type": "EmptyLatentImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage", "ttNbgOverride": {"bgcolor": "#000", "groupcolor": "#444", "color": "#222"}}, "order": 1}, {"mode": 0, "outputs": [{"name": "STRING", "links": [3], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [508.8561096191406, 359.272216796875], "pos": [720.0771484375, 593.4801025390625], "widgets_values": ["一眼万年，3d厚涂，鬼刀，冷白皮，厚涂，眼尾细长，桃花眼，发丝细腻刻画，正脸五官特写，精致无比的东方面容，建模脸，颜值控，视线对准镜头，人物直视镜头，披着凌乱的浅棕色长发，被风吹乱的发丝挡在脸前，凌乱感，真人比例，精致的妆容，伪素颜妆，陶瓷般光滑的皮肤，小巧玲珑，白皙柔嫩的皮肤，小巧的漂亮鼻子，长长的睫毛，精致的柳叶眉，皮肤高光，薄薄的唇瓣，微张的嘴唇，透明唇釉泛着晶莹的光泽，浅粉色晕染自然溢出唇线，柔和的光影呈现立体的唇纹反光，用微距镜头捕捉唇部表面透明薄膜质感，背景虚化，梦幻空间，空灵感，立体感，清冷感，柔焦，自然唇纹间泛着细腻的湿润光泽，绝美光影，斑驳的光照，宿命感，情绪化的眼神，直视镜头，盯着镜头，表情抓拍，高饱和度，超高清，"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 11, "type": "Text Multiline", "properties": {"cnr_id": "was-ns", "ver": "f86447721c18758d7b3b6ae5769f52344a3d764a", "widget_ue_connectable": {"text": true}, "Node name for S&R": "Text Multiline", "ttNbgOverride": {"bgcolor": "#000", "groupcolor": "#444", "color": "#222"}}, "order": 2}, {"mode": 0, "outputs": [{"name": "output", "links": [15], "label": "output", "type": "*", "localized_name": "output"}], "size": [301.81817626953125, 88], "pos": [1489.88134765625, 1147.397216796875], "widgets_values": ["柔光下，一位年轻女性的特写肖像，肌肤如凝脂般细腻光滑，泛着自然的水光光泽，仿佛刚沐浴晨露。她拥有深邃的棕色眼眸，睫毛纤长卷翘，眼妆轻盈自然，粉嫩的腮红与唇色相映成趣，唇釉透亮，微微张开的唇形流露一丝慵懒的温柔。几缕发丝轻拂额前，随风微动，发丝边缘泛着微光，与脸颊的光晕交融，营造出流动的柔美感。她的目光直视镜头，眼神清澈而专注，带有一丝静谧的沉思，仿佛在与观者进行无声的对话。\n\n构图采用中心对称式特写，聚焦于面部，从鼻尖到下巴的线条流畅优美，鼻梁挺拔，唇角微扬，表情宁静而富有感染力。背景为柔和的浅灰白渐变，无任何干扰元素，使主体更加突出。前景中，发丝与光影交织，形成自然的层次感，增强画面的纵深。中景部分，面部轮廓清晰，光影过渡细腻，高光在鼻梁与颧骨处形成柔和的光斑，暗部则自然过渡，无生硬阴影。背景虚化处理，仅保留极淡的色调，不干扰主体的视觉焦点。\n\n视觉引导从发丝的流动感自然过渡至面部中心，最终聚焦于双眼，引导观者的情感投射。整体光影氛围柔和、清透、梦幻，带有清晨或午后柔和自然光的质感，仿佛置身于静谧的室内或微风拂面的户外。画面色彩以暖粉与浅棕为主，色调统一，营造出温暖、温柔、略带梦幻的氛围，既具艺术感，又贴近日常拍摄的自然质感，无过度修饰，却充满生命力与细腻的情感表达。整个画面如一幅静谧的水彩画，温柔、细腻、充满呼吸感，令人沉醉。"], "inputs": [{"shape": 7, "name": "anything", "link": 14, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 12, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "11794f7d718dc38dded09e677817add796ce0234", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything", "ttNbgOverride": {"bgcolor": "#000", "groupcolor": "#444", "color": "#222"}}, "order": 9}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [18], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [303.6494445800781, 237.7431640625], "pos": [1488.37353515625, 1298.4788818359375], "inputs": [{"name": "text", "link": 15, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 13, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss", "ttNbgOverride": {"bgcolor": "#000", "groupcolor": "#444", "color": "#222"}}, "order": 11}, {"mode": 0, "outputs": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [210, 78], "pos": [1538.187255859375, 1648.9168701171875], "widgets_values": [" "], "inputs": [{"shape": 7, "name": "string1", "link": 17, "label": "string1", "type": "STRING", "localized_name": "string1"}, {"shape": 7, "name": "string2", "link": 18, "label": "string2", "type": "STRI