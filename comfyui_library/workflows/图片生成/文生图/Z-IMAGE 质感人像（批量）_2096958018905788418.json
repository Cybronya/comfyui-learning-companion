和晶莹感汁水丰富，顺着荔枝被咬掉的边缘有汁水飞溅和滴落，荔枝纹理边缘由清晰渐变模糊空间，层层叠叠。整体色调优雅雅致，背景为纯红色渐变，荔枝肉透过光形成强烈对比，极致的构图，极致的光和影，宁静，营造出静谧悠远的氛围。艺术文字“一口回味”和整体和谐的融为一体，空灵、梦幻、大面积留白，大师作品。获奖作品，大师级配色，大师级排版，高细节，高级感，超高清，布局协调。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 70, "type": "Text Multiline", "properties": {"cnr_id": "was-node-suite-comfyui", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "Text Multiline"}, "order": 9}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [133, 134, 135, 136], "VHS_MetadataImage": true, "ue_links": [{"controller": 103, "upstream": "3", "downstream_slot": 1, "downstream": 8, "upstream_slot": 0, "type": "VAE"}, {"controller": 103, "upstream": "101", "downstream_slot": 0, "downstream": 76, "upstream_slot": 0, "type": "CLIP"}, {"controller": 103, "upstream": "101", "downstream_slot": 0, "downstream": 77, "upstream_slot": 0, "type": "CLIP"}, {"controller": 103, "upstream": "100", "downstream_slot": 0, "downstream": 104, "upstream_slot": 0, "type": "MODEL"}], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.30.6", "VHS_latentpreview": false, "ds": {"offset": [1809.2731899692694, 880.8070176448463], "scale": 0.45000000000000123}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Group", "bounding": [-1122.8458251953125, -778.2568969726562, 1821.8525390625, 818.4111328125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "提示词输入", "bounding": [-1121.9373779296875, 89.58578491210938, 1041.4742431640625, 633.310791015625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "输出", "bounding": [-38.686744689941406, 92.13793182373047, 739.951416015625, 628.3019