": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 6}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [14], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [427.3684387207031, 391.57904052734375], "pos": [689.5863647460938, 333.3426818847656], "widgets_values": ["画面为人物腰腹半身特写，略微侧俯视角，画面裁切范围为人物从头顶下半段至大腿上段，仅保留躯干、单侧手臂与下装局部。光源为室内顶部漫射柔光，光线均匀打在人物皮肤与衣物上，腹部肌肉线条处形成柔和浅阴影，无强烈高光区域。场景为简约居家卧室，背景墙面是平整纯白色，人物身后铺着一大块蓬松粉色毛绒毯子，毯子褶皱纹理清晰可见。主体为一名年轻女性，浅棕褐色短卷发，发尾凌乱蓬松，仅露出下半张脸部，嘴唇上穿有多枚银色唇钉；肤色白皙透亮，腹部肌肉线条清晰，拥有明显马甲线，腹部皮肤干净仅有零星淡褐色小点；上身穿着黑色工字款运动背心，背心为透气针织面料，胸口左侧印有小型白色流线型品牌标识；颈部佩戴黑色细绳项链，绳身垂落一颗黑色椭圆形哑光吊坠；下装是灰绿色细横条纹三角内裤，内裤腰头设有三层加宽橄榄绿色包边；她的左臂自然垂落在身体侧面，上臂、小臂分布多颗细小褐色痣，小臂中间位置有一道细长浅淡白色疤痕；身体微微向画面左侧扭转，腹部正面朝向镜头，肩膀微微抬起，形成舒展的侧身体态。整体色彩以黑色背心、灰白条纹内裤作为主色调，背景粉色毛绒毯、橄榄绿腰头作为辅色，冷暖色调柔和平衡。"], "inputs": [{"name": "clip", "link": 11, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 14, "type": "CLIPTextEncode", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}, {"mode": 0, "outputs": [{"name": "zip_filename", "label": "zip_filename", "type": "STRING", "localized_name": "zip_filename"}], "size": [287.109375, 106], "pos": [1842.1600341796875, 274.8721923828125], "widgets_values": ["ComfyUI", "PNG", ""], "inputs": [{"name": "images or video_path", "link": 23, "label": "images or video_path", "type": "*", "localized_name": "images or video_path"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "image_format"}, "name": "image_format", "label": "image_format", "type": "COMBO", "localized_name": "image_format"}, {"widget": {"name": "password