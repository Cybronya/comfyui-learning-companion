格锁定】8K超高清，照片级真实感，极致写实；低饱和度自然暖调，白平衡准确偏暖，无夸张滤镜，真实还原所有材质的原生色彩与暖光下的质感；细腻的金属拉丝纹理，通透自然的镜面暖调反射质感，天然石材纹理，服装面料纹理，皮肤真实肌理，鞋款、配饰的材质细节，所有元素质感100%真实还原，纹理清晰锐利；苹果手机原相机直出原生质感，轻微自然的数码颗粒感，无过度磨皮、无过度美颜、无腿部液化拉长的失真感，画面整体干净通透，暖调氛围自然舒适，细节完整无缺失，人物头身比例自然协调。画面要有玻璃质感", 1285563875, "randomize", "auto", "2k", "Third-party", false], "inputs": [{"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "link": 102, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 101, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 100, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "link": 105, "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}, {"widget": {"name": "skip