roperties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 15}, {"outputs": [], "color": "#432", "widgets_values": ["# Z-imege+Z-Engineer V4+光影lora 简介\nZ-Engineer V4 是 Tongyi-MAI/Z-Image-Turbo 文本编码器的完全微调版本（非 LoRA），专为理解 AI 图像生成工作流的细微差别训练。\n核心优势\n拓展概念：可将 “雨中的悲伤机器人” 转化为具有色像差、浅景深和忧郁色调的电影感狂热梦境。\n技术精准：能区分 85mm 人像镜头与 24mm 广角镜头并恰当使用；对伦勃朗光、分体光、体积雾等灯光效果有专业判断。\n风格一致性：以富有创造力的声音写作，避免机械感的 “超写实、8K、artstation 流行能量” 等模板化表达。\n\n配合fdpo 光影 lora 光影强度：建议0.5-0.65\n\n让原本就很强的z-image速度更快，语义理解更加精准专业，光影更好！"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [896.3768310546875, 289.8968811035156], "pos": [1044.7421875, -522.84228515625], "id": 26, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"mode": 0, "outputs": [{"name": "prompt", "links": [8], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [530.2445678710938, 150.50711059570312], "pos": [1384.7772216796875, -94.72775268554688], "widgets_values": ["充满自然清幽与文雅诗意的意境。画面以细腻的笔触和淡雅的色彩，展现了竹景之美，具有强烈的艺术感染力。画面中一个淡淡翠绿白色素衣交领古装竹林仙子，优雅飘逸，仙女发型发饰，手持笛子，正在吹笛子，观者可以从中领略到中国传统绘画的韵味，感受到对自然之美的欣赏和对高雅生活情趣的追求，体现了绘画在传达文化情感和营造意境方面的价值。油画写实风格暗黑郎世宁"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 11, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-1224.7757903333559, 297.60424586180125], "scale": 2.06773784386075}}, "groups": [{"color": "#3f789e", "font_size": 48, "flags": {"pinned": true}, "id": 2, "title": "分辨率选择器", "bounding": [1021.7796630859375, -216.6329803466797, 335.1896667480469, 303.06365966796875]}, {"color": "#3f789e", "font_size": 48, "flags": {"pinned": true}, "id": 3, "title": "文生图提示