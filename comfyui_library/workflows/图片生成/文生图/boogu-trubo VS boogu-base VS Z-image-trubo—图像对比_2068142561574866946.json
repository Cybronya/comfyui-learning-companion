摆绣淡青色仙鹤暗纹，腰间系玉扣流苏，手持通透白玉长剑，立于云端仙山，周身环绕淡淡仙气白雾，细碎金色灵光点漂浮周身，侧脸线条柔和锋利，气质疏离纯净，空灵出尘，广角仙山远景，国风仙侠摄影，细腻发丝肌理，低饱和清雅水墨色调\n\n胶片质感日常人像场景，温柔漫射柔光，街角治愈系小咖啡馆，原木桌椅、暖黄吊灯，玻璃桌面放咖啡与书本，窗外街道行人虚化，绿植盆栽点缀窗台，暖棕低饱和色调，安静闲适氛围感，45° 平视构图，柔和明暗层次\n\n\n\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 40, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 9}, {"mode": 0, "outputs": [{"name": "INT", "links": [44, 46, 48], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [142.29908752441406, 1443.738525390625], "widgets_values": [900], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "id": 38, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 10}, {"mode": 0, "outputs": [{"name": "INT", "links": [45, 47, 49], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [143.62612915039062, 1579.6468505859375], "widgets_values": [1280], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 39, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 11}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [882.2413940429688, 1090.2412109375], "pos": [3053.91650390625, 544.1718139648438], "widgets_values": [], "inputs": [{"name": "images", "link": 34, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 34, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 38}, {"mode": 0, "outputs": [{"name": "prompt", "links": [41, 42, 43], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "type": "STRING", "localized_name": "show_he