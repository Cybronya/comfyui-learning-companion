image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 119, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}], "flags": {}, "id": 122, "type": "RH_Nano_Banana2_Gemini31Flash", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Gemini31Flash"}, "order": 23}, {"mode": 4, "outputs": [{"name": "string", "links": [119], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [479.45068359375, 686.4707641601562], "pos": [1860.1900634765625, 4338.85595703125], "widgets_values": ["9宫格画面，格子里的画幅为横屏16：9画幅。参考图1中的人物，根据以下分镜表内容，生成竖屏画幅为16：9的竖屏9宫格画面，每个小画面画幅也是16：9，且小格画面之间没有间隙，画面中不出现字幕。中国演员，\n\n镜号\n预估时长\n景别/运镜\n画面描述\n对白/旁白\n01\n4s\n极近景/固定\n前景雨丝虚焦，背景三色灯光晕染雨幕。升格拍摄，雨丝下坠极慢。画面以红白蓝三色主导，冷暖交替。\n无\n02\n5s\n脸部特写/固定\n浅景深。画面先虚，男人的脸从虚焦走进景深，逐渐清晰。雨水挂在脸上，眼神空洞，光从侧面打来，半张脸在阴影里。\n无\n03\n4s\n远景/俯拍固定\n俯角，理发店门口。男人是画面里唯一移动的元素，走进理发店，门关上。字幕\"情丝\"出现在画面右下角，随门关上淡出。\n无\n04\n2s\n主观镜头/固定\n男人主观视角。理发师从室内抬起头，直视镜头，眼神职业而平静。室内暖黄光源，与室外冷色形成对比。\n理发师：剪头发？\n05\n4s\n中景→镜中特写/固定\n男人在椅子上坐下，围布被披上。镜头从中景缓慢推近，落在镜子里男人的脸。他看着自己，眼神漂移。\n男人：剪吧。\n06\n\n3s\n近景/固定\n理发师的手与剪刀在画面中心。第一下，第二下，第三下——剪刀断裂，半截坠地。镜头在剪刀落地瞬间短暂抖动。\n无\n07\n5s\n镜中双人/固定\n镜子构图。理发师低头看地上的剪刀，抬头，与镜中男人对视。两人都在镜子里。理发师弯腰捡起剪刀，翻看断口。\n理发师：好好的怎么就断了……\n08\n3s\n镜中男人特写/固定\n男人在镜子里，视线从断剪刀移回自己脸上。表情没有变化，但眼神更深了。\n男人：是啊，好好的怎么就断了……\n09\n2s\n近景/固定\n理发师把断剪刀放到台面，转身走向里间。布帘被掀起，落下。画面里只剩男人的背影和镜子。\n理发师：没事，我去找把新的。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 116, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 16}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "OPT_CONNECTION", "type": "*"}], "size": [357.9144287109375, 346.6986999511719], "pos": [1105.34716796875, 2121.42333984375], "inputs": [], "flags": {}, "id": 9, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "", "showNav": true, "toggleRestriction": "default"}, "order": 17}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [61], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [1548.9683837890625, 2530.6796875], "widgets_values": ["f305c5fcfaed6d034ae172a7b6c9bd65b76f8b39f9e0ee843c00c7cb4ca8141d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 63, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 18}, {"mode": 0, "outputs": [{"name": "image", "links": [62], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [1120.405517578125, 733.