b5cd768f0f96baf37baea1", "widget_ue_connectable": {}, "Node name for S&R": "String Literal"}, "order": 5}, {"mode": 4, "outputs": [{"shape": 6, "name": "prompt", "links": [55], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"shape": 6, "name": "body_text", "label": "body_text", "type": "STRING", "localized_name": "body_text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [332.046875, 587.5], "pos": [-1964.8583984375, -485.98406982421875], "widgets_values": ["", "一张超写实的特写肖像，描绘了一位面对风暴的年迈渔夫。雨滴划过他饱经风霜的脸庞，积聚在诉说着海洋故事的深深皱纹里。他穿着一件质感鲜明的亮黄色雨衣，与背景中动荡海洋的深沉忧郁的蓝色和灰色形成对比。他的眼神锐利如钢，反射出一生的坚韧。光线充满戏剧性，一道闪电照亮了他的侧脸，突出了皮肤的粗糙质感和胡须上的水珠。电影级8k分辨率。\n一幅新海诚风格的高质量动漫插画。一位充满活力的粉发高中女生站在黄金时段的火车站台上。她撑着一把透明雨伞，捕捉着夕阳温暖的橙色和紫色色调。樱花花瓣在空中飘落，与镜头光斑效果混合。背景是细节丰富、连绵不断的城市景观，电线和远处的摩天大楼在充满活力的天空下形成剪影。氛围怀旧而感性，拥有极其细腻的光影和云层渲染。\n一个坚毅的赛博朋克场景，描绘了一位半机械修理工在霓虹灯照耀的小巷里修理未来的悬浮摩托。修理工有一只带有外露线路和液压装置的机械手臂，手里拿着一把发光的等离子扳手。小巷潮湿且反光，映照着上方悬挂的日语汉字粉色和蓝色霓虹灯招牌。蒸汽从地面的通风口升起。悬浮摩托虽然时尚但已有磨损，划痕和污垢增添了真实感。整体风格具有电影感、黑暗且细节丰富，强调高科技机械与城市衰败之间的对比。\n黑暗奇幻概念艺术。一位身穿破旧银甲的孤独骑士站在破碎的悬崖边缘，俯瞰着巨大的、充满迷雾的深渊。从迷雾中浮现出一只由阴影和黑曜石组成的巨大的远古巨龙，它的眼睛闪烁着威胁的猩红光芒。骑士手持一把发出微弱神圣蓝光的剑，这是场景中唯一的希望之源。环境哥特式且荒凉，有扭曲的枯树和锯齿状的岩石。情绪是不祥且史诗般的，用厚重的阴影和戏剧性的比例描绘。\n一幅异想天开的3D渲染图，风格类似于高预算动画电影（如皮克斯或迪士尼）。一只毛茸茸的圆润仓鼠戴着微小的厨师帽，在一个建在挖空南瓜里的微型厨房里搅拌一锅汤。厨房温暖舒适，由烛光照亮。汤锅是用橡子壳做的。豌豆和胡萝卜片等蔬菜在仓鼠旁边显得过大。质感柔软且触感极佳，仓鼠的皮毛和南瓜果肉上有次表面散射效果。光线温暖、诱人且神奇。\n一个超现实的梦幻景观，以水晶和紫水晶构成的浮空岛屿为特色。瀑布从岛屿倾泻而下，落入下方的云海中，但水流在落下时变成了成群的蓝色蝴蝶。天空是柔和的粉色、淡紫色和柔和的青色的渐变，可以看到两个月亮——一个巨大且有陨石坑，另一个小而光滑。在前景中，一个透明的玻璃楼梯盘旋上升，通向最大的岛屿。风格空灵、流畅且富有想象力，唤起一种惊奇和宁静的感觉。\n一张复古的1980年代合成波美学照片。一辆德罗宁跑车沿着网格线的公路驶向一个巨大的落日，落日带有复古的渐变条纹。棕榈树排列在路边，但它们是由霓虹紫色线框构成的。天空是深邃的星空虚空。图像具有轻微的VHS颗粒效果和色差，以增强复古感。颜色以电光蓝、热粉色和夕阳橙为主。\n一张在黑暗、长满苔藓的森林中发光的生物发光蘑菇簇的微距摄影照片。蘑菇从菌盖下发出柔和、空灵的蓝光。一只带有金色壳的微小精致蜗牛正慢慢爬上最大蘑菇的茎。周围苔藓上的露珠反射着蓝光，在背景中营造出闪闪发光的散景效果。景深非常浅，使蜗牛和蘑菇保持清晰，同时将黑暗的森林背景模糊成神秘的形状。\n一幅色彩丰富、质感强烈的油画，描绘了黄昏时分繁忙的维多利亚时代街道场景。煤气灯在鹅卵石街道上投下温暖的黄色光芒，倒映在水坑中。马车和戴着高顶礼帽、穿着长裙的人们在雾中穿梭。笔触清晰且富有表现力，让人联想到印象派，捕捉运动和氛围而非完美的照片写实主义。调色板使用深棕色、雾灰色和温暖的赭石色。\n一张宁静的现代禅宗客厅建筑摄影照片。房间设有落地玻璃墙，可望见雨中的竹园。室内设计极简主义，配有低矮的米色家具、天然木条墙和抛光混凝土地板。一套陶瓷茶具放在再生木咖啡桌上，茶杯冒着热气。光线柔和漫射，来自外面的阴天，营造出一种平静、冥想的氛围。", "", 0, 1000], "inputs": [{"widget": {"name": "prepend_text"}, "name": "prepend_text", "label": "prepend_text", "type": "STRING", "localized_name": "prepend_text"}, {"widget": {"name": "multiline_text"}, "name": "multiline_text", "link": 57, "label": "multiline_text", "type": "STRING", "localized_name": "multiline_text"}, {"widget": {"name": "append_text"}, "name": "append_text", "label": "append_text", "type": "STRING", "localized_name": "append_text"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "start_index"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "max_rows"}], "flags": {}, "id": 60, "type": "CR Prompt List", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt List"}, "order": 9}, {"mode": 4, "outputs": [{"name": "output", "links": [110], "label": "output", "type": "*", "localized_name": "output"}], "size": [402.046875, 406.421875], "pos": [-1598.122314453125, -486.364013671875], "widgets_values": ["专业高清写真级画质，8K分辨率，皮肤质感细腻，背景衬托人物肤色白皙，侧逆光突出人物发丝的光泽感。场景设定在公园的枫树下（枫树叶是红色的，飘落几片），一位20多岁的中国美女自拍。她穿着红色针织毛衣，毛衣质地厚实，搭配黑色紧身裤，脚踩黑色短靴，头发扎成马尾辫，发尾微微卷曲，戴着红色针织帽。配饰是银色耳钉，形状是枫叶，脖子上戴着一条红色围巾，围巾质地是羊毛的，十分保暖。手持红色智能手机，手机壳是硅胶材质，颜色是红色，印着枫叶图案，手机挂着红色毛绒挂饰。自拍角度为轻微仰拍，她站在枫树下，右手举着手机，左手轻轻接住一片飘落的枫叶，身体微微侧对镜头，头微偏，嘴角带着甜美的笑容，眼睛看向镜头，整体画面温暖甜美，尽显可人气质。"], "inputs": [{"shape": 7, "name": "anything", "link": 55, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 61, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 12}, {"mode": 0, "outputs": [{"name": "文本输出", "links": [109], "label": "文本输出", "type": "STRING", "localized_name": "文本输出"}], "size": [481.6855773925781, 572.2732543945312], "pos": [-2097.43359375, 274.8638916015625], "widgets_values": ["Huihui-Qwen3-VL-8B-Instruct-Abliterated", "None (FP16)", "提示词风格 - 极致详细", "你是一位专业的AI图像生成提示词工程师。请详细描述这张图像主体、前景、中景、背景、构图、视觉引导、光影氛围等细节并创作出具有深度、氛围和艺术感或日常业余设备拍摄的图像提示词。\n\n要求：若熟悉图片中人物（如名人、电影角色、动画人物等），请直接使用其本名，中文提示词，不用出现对图像水印的描述，不要出现无关的文字和符号，不需要总结，限制在800字以内", 1024, 0.6, 0.9, 1, 1.2, 16, "auto", true, 1], "inputs": [{"shape": 7, "name": "🖼️ 图像1", "link": 108, "label": "🖼️ 图像1", "type": "IMAGE", "localized_name": "🖼️ 图像1"}, {"shape": 7, "name": "🖼️ 图像2", "label": "🖼️ 图像2", "type": "IMAGE", "localized_name": "🖼️ 图像2"}, {"shape": 7, "name": "🖼️ 图像3", "label": "🖼️ 图像3", "type": "IMAGE", "localized_name": "🖼️ 图像3"}, {"shape": 7, "name": "🖼️ 图像4", "label": "🖼️ 图像4", "type": "IMAGE", "localized_name": "🖼️ 图像4"}, {"shape": 7, "name": "🎥 视频", "label": "🎥 视频", "type": "IMAGE", "localized_name": "🎥 视频"}, {"widget": {"name": "🤖 模型选择"}, "name": "🤖 模型选择", "label": "🤖 模型选择", "type": "COMBO", "localized_name": "🤖 模型选择"}, {"widget": {"name": "⚙️ 量化级别"}, "name": "⚙️ 量化级别", "label": "⚙️ 量化级别", "type": "COMBO", "localized_name": "⚙️ 量化级别"}, {"widget": {"name": "💭 预设提示词"}, "name": "💭 预设提示词", "label": "💭 预设提示词", "type": "COMBO", "localized_name": "💭 预设提示词"}, {"widget": {"name": "✏️ 自定义提示词"}, "name": "✏️ 自定义提示词", "label": "✏️ 自定义提示词", "type": "STRING", "localized_name": "✏️ 自定义提示词"}, {"widget": {"name": "🔢 最大令牌数"}, "name": "🔢 最大令牌数", "label": "🔢 最大令牌数", "type": "INT", "localized_name": "🔢 最大令牌数"}, {"widget": {"name": "🌡️ 采样温度"}, "name": "🌡️ 采样温度", "label": "🌡️ 采样温度", "type": "FLOAT", "localized_name": "🌡️ 采样温度"}, {"widget": {"name": "🎯 核采样参数"}, "name": "🎯 核采样参数", "label": "🎯 核采样参数", "type": "FLOAT", "localized_name": "🎯 核采样参数"}, {"widget": {"name": "🔍 束搜索数量"}, "name": "🔍 束搜索数量", "label": "🔍 束搜索数量", "type": "INT", "localized_name": "🔍 束搜索数量"}, {"widget": {"name": "🚫 重复惩罚"}, "name": "🚫 重复惩罚", "label": "🚫 重复惩罚", "type": "FLOAT", "localized_name": "🚫 重复惩罚"}, {"widget": {"name": "🎬 视频帧数"}, "name": "🎬 视频帧数", "label": "🎬 视频帧数", "type": "INT", "localized_name": "🎬 视频帧数"}, {"widget": {"name": "💻 设备选择"}, "name": "💻 设备选择", "label": "💻 设备选择", "type": "COMBO", "localized_name": "💻 设备选择"}, {"widget": {"name": "🔄 保持模型加载"}, "name": "🔄 保持模型加载", "label": "🔄 保持模型加载", "type": "BOOLEAN", "localized_name": "🔄 保持模型加载"}, {"widget": {"name": "🎲 随机种子"}, "name": "🎲 随机种子", "label": "🎲 随机种子", "type": "INT", "localized_name": "🎲 随机种子"}], "flags": {}, "id": 86, "type": "Qwen3VL_Advanced", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Qwen3VL_Advanced"}, "order": 11}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [111], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [413.26324462890625, 235.82167053222656], "pos": [-1567.030029296875, 279.8428649902344], "widgets_values": ["湿发垂落肩背，黑丝般长发贴着肌肤微卷，在暖光下泛着柔润光泽；她身披一件极简白色裹胸内衣，边缘自然褶皱随体态起伏，与黑色细带丁字裤形成冷暖对比——那透明网纱材质轻盈勾勒臀线轮廓，仿佛晨露凝于肌理之上，每一寸曲线都隐含呼吸般的律动。画面聚焦于女性背部及侧腰至大腿根部的S型弧度，脊椎线条流畅延伸向后翘起的饱满臀峰，皮肤因湿润而透亮，隐约可见汗珠折射光线形成的星点高光。\n\n前景为低角度仰拍视角，镜头贴近地面捕捉足踝未入镜处留白空间，强化身体比例纵深；中景是腰部以下到膝盖上端区域被柔和焦外虚化处理，使观者视线集中于核心躯干美感；背景则是一片朦胧浅棕墙面与床单纹理交织而成的模糊色块，仅以轻微噪点暗示室内环境而非刻意营造场景叙事。\n\n整体采用竖幅构图，占据画布三分之二以上的垂直空间强调纵向延展性，同时通过双臂交叉环抱颈部的姿态制造动态平衡——左手轻抚颈项、右手搭于右肩胛骨间隙的动作既具私密性感又保留一丝防备姿态，暗喻内心复杂情绪张力。光源来自左上方斜射进来的漫反射窗光，均匀铺洒在裸露肌肤表面却不产生生硬阴影，而是让肌肉凹陷与脂肪堆积过渡得极为细腻真实；局部有几缕逆光穿透发梢形成飞羽状剪影效果，赋予画面静谧诗意气质。\n\n色彩调校偏温饱和度偏低，主色调由肤色米黄、乳白衣物以及深邃炭灰构成三元配比系统，辅以少量铜金色反光点缀增加层次丰富度。整幅作品散发出“午后浴室沐浴后慵懒回眸”的生活美学气息，既有专业摄影棚级质感亦不失手机随手抓拍的真实温度——像一位刚从温泉池起身的女人站在镜子前整理衣衫时偶然转身的一瞬定格，空气中还弥漫着皂香与水汽混合的气息，让人忍不住想象下一秒她的唇角将扬起怎样温柔笑意。"], "inputs": [{"name": "text", "link": 109, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 76, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "943e5cc7526c601600150867a80a02ab008415e7", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 13}, {"mode": 0, "outputs": [{"name": "LATENT", "link