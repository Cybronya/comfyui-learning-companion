"order": 21}, {"mode": 0, "outputs": [{"name": "*", "links": [31], "label": "*", "type": "*", "localized_name": "*"}], "size": [270, 78], "pos": [1574.8316650390625, 1095.9727783203125], "widgets_values": [["70", 0]], "inputs": [{"name": "on_true", "link": 13, "label": "on_true", "type": "*", "localized_name": "on_true"}, {"name": "on_false", "link": 14, "label": "on_false", "type": "*", "localized_name": "on_false"}, {"widget": {"name": "boolean"}, "name": "boolean", "link": 15, "label": "boolean", "type": "BOOLEAN", "localized_name": "boolean"}], "flags": {}, "id": 12, "type": "easy ifElse", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy ifElse"}, "order": 15}, {"outputs": [{"name": "STRING", "links": [12, 14], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#323", "widgets_values": ["这是一张新年祝贺的宣传海报，主题为“马年来财”。海报背景为浅米色，带有隐约的传统花纹装饰，剪纸效果，整体设计充满中国传统文化元素和节日氛围。主要红色和黄色作为主色调，象征喜庆、好运和繁荣。\n\n1. **顶部文字**：\n   - 红色大字“GOOD LUCK”，是英文祝福“好运”的意思。\n   - 正下方有中文字体“马上来财”，字体具有浓厚的书法韵味。\n\n2. **图案**：\n   - 一匹红色剪影的奔跑骏马占据画面中央，剪纸特效，扁平风格，象征马年的到来和活力四射的寓意。\n   - 马身下方有飞扬的金色线条，增添动感，给人一种奔腾的气势。\n   - 周围点缀有传统烟花图案，象征节庆气氛。\n\n3. **其他文字**：\n   - 左侧：“HAPPY NEW YEAR”（新年快乐）和一个红色印章样的“新年”字样。\n   - 底部：“恭喜发财”。\n   - 再下面是小字：“春节快乐，顺顺利利，万事如意”，表达了美好的新年祝福。\n   - 底部还附有联系方式，例如：“大洋图文总部 18620590571 联系地址：高普路83号”\n\n该海报整体布局简洁大方，充满过年的喜庆氛围，充分体现了节日的热闹与祝福的美好寓意。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "TextInput_", "mode": 0, "bgcolor": "#535", "size": [439.8091735839844, 317.073486328125], "pos": [765.7193603515625, 1098.5020751953125], "id": 10, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInput_"}, "order": 3}, {"outputs": [{"name": "describe", "links": [10], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#232", "widgets_values": ["请提供此图像的详细描述。如果图片中有您熟悉的人物，如名人、电影人物或动画人物，请直接使用他们的名字。描述应尽可能详细，结果用中文输出，把图像有文字的都要识别出来，但不应超过500字。"], "inputs": [{"name": "ref_image", "link": 34, "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "RH_Captioner", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [1082.1962890625, 424.2492370605469], "id": 7, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Captioner"}, "order": 10}, {"outputs": [{"name": "output", "links": [13], "label": "output", "type": "*", "localized_name": "output"}], "color": "#232", "widgets_values": ["这是一张新年祝福主题的图片，整体色调以红色和米色为主，呈现喜庆热闹的氛围。画面上方写有大大的黑体红字“GOOD LUCK”和汉字“马上发财”，汉字“新”和“年”分别位于“马上发财”的两侧，显得层次分明。背景中带有若隐若现的纹饰，增添了传统风格。\n\n中央位置是一匹红色的奔马，其线条流畅，姿态充满动感，表达了祥瑞祝福的寓意，是整幅设计的核心元素。\n\n左侧中部区域写有英文“Happy New Year”以及一个红底金字的矩形框，框内写着“新年”二字。右下方以及左上方还点缀着烟花图案，进一步烘托节日气氛。\n\n图片下方写着“Happy New Year”，两侧分别有一个红色的“吉”字，象征吉祥和如意。最底部还有致辞文字“愿新春以后，吉吉利利，百事都如意”，表达新年的美好愿望。下方还包含一个联系人信息部分，包括“1234 5678” 的电话号码和“联系热线”、“具体地址具体地址具体地址”等信息，此外还有一个虚拟的网址“http://www.xxxx.com”。\n\n整张图片设计简约但充满节日气息，结合传统与现代元素，传递了浓浓的新春祝福。"], "inputs": [{"shape": 7, "name": "anything", "link": 10, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#353", "size": [408.60845947265625, 256.3675842285156], "pos": [1068.1915283203125, 676.9713134765625], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 13}, {"mode": 0, "outputs": [{"name": "output", "links": [33, 34, 35], "label": "output", "type": "*", "localized_name": "output"}], "size": [157.38925170898438, 26], "pos": [792.8465576171875, 434.1671142578125], "widgets_values": [], "inputs": [{"name": "anything", "link": 36, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 26, "type": "easy cleanGpuUsed", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy cleanGpuUsed"}, "order":