项目吊饰（足球、篮球造型），角落设置体育主题休闲区，摆放印有球队徽章的靠垫与小型运动器材模型，整体氛围充满运动活力与彩票门店的专业感。画面核心是一位气质亮眼的美女，身着露肩黑色抹胸（面料贴身，勾勒流畅胸线，肩颈处肌肤细腻）与高腰白色短裙（裙长及大腿中部，侧边有隐形开叉设计，增添灵动性），她站姿优雅，一手轻扶彩票柜台，一手自然垂落，裙摆随轻微动作微微扬起，眼神明亮带笑，既展现出青春活力，又与体育彩票店的运动氛围完美契合，光线均匀照亮人物与店内场景，色彩明快鲜活，细节（如彩票海报内容、终端机按键、服饰纹理）清晰可见。"], "inputs": [{"name": "clip", "link": 74, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [466.9026794433594, 464.06201171875], "pos": [364.91229248046875, 36.166648864746094], "id": 6, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 11}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [135], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [290.4728698730469, 82], "pos": [84.10929107666016, -306.2397766113281], "widgets_values": ["Kook_千问写实_Kook_Qwen_V1稳定版.safetensors", 0.8000000000000002], "inputs": [{"name": "model", "link": 211, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 76, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 21}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [165], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [300, 262], "pos": [850, 120], "widgets_values": [762672470980282, "randomize", 30, 4, "euler", "simple", 1], "inputs": [{"name": "model", "link":