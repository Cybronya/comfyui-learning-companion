ode": 0, "outputs": [{"name": "string", "links": [922], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [-648.906982421875, 1867.036865234375], "widgets_values": ["一幅**教育漫画风格**的信息图，展示新生儿奶粉冲泡流程。背景采用浅米色复古纸张纹理。图片顶部中央是醒目的浅粉色标题：**新生儿奶粉冲泡流程**，标题下方配有较小的中文副标题：**新手爸妈必看标准步骤**。主体部分由六个步骤模块组成，模块间以浅粉色虚线箭头连接，整体按上下两排排列，形成Z型视觉指引。\n左上角第一步：绘制干净的新生儿奶瓶、奶粉罐、量杯与温水壶，旁边标注水温提示，模块下方标注：**第一步：准备器具与温水**\n中上第二步：绘制手持奶粉勺，从密封奶粉罐中舀取适量奶粉，旁边配有奶粉勺刮平器，下方标注：**第二步：舀取定量奶粉**\n右上第三步：描绘将舀取的奶粉缓缓倒入装有温水的奶瓶中，奶粉轻微洒落的细节，下方标注：**第三步：倒入奶粉**\n左下第四步：展示加盖后的奶瓶，用手轻轻摇晃（避免剧烈摇晃），瓶内出现轻微奶液漩涡，下方标注：**第四步：摇晃溶解**\n中下第五步：呈现手腕内侧测试奶液温度的画面，旁边配有温度提示图标，下方标注：**第五步：测试奶温**\n右下第六步：绘制装有温热奶液的奶瓶，旁侧摆放婴幼儿模型，下方标注：**第六步：准备喂食**\n图片四角以手绘奶瓶、奶粉勺、小脚印与星星装饰。整体配色为浅粉、暖棕、米白、浅黄与淡蓝，线条精致，布局清晰，贴合新生儿温馨治愈调性，步骤直观易懂，适配新手爸妈学习使用。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 431, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 3}, {"mode": 0, "outputs": [{"name": "INT", "links": [926], "label": "INT", "type": "INT", "localized_name": "INT"}], "size": [270, 82], "pos": [-968.29541015625, 2116.59423828125], "widgets_values": [1920, "fixed"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "id": 435, "type": "PrimitiveInt", "title": "宽", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveInt"}, "order": 4}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [907], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [270, 106], "pos": [-536.4386596679688, 2121.317138671875], "widgets_values": [1920, 1080, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 926, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 927, "label": "height", "type": "INT", "localized_name": "he