uler_ancestral"], "inputs": [{"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}], "flags": {}, "id": 8, "type": "KSamplerSelect", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.8.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "KSamplerSelect", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 1}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [15, 18], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [430, 420], "pos": [13000, 80], "widgets_values": ["{\n    \"high_level_description\": \"高级深色主调的朦胧美学写真，平拍视角，一位粉白晕染短发的超高颜值美少女，斜刘海下粉面桃腮，眸含秋水。她手伸向镜头，修长指甲引人注目，面颊爱心、眉间眼角花钿与精致的小猪图案面饰增添妖冶又慵懒的华丽感。人造光营造柔和氛围，低对比影调与lomo效果赋予画面似真似幻的空灵质感，8K超高清，细节精致，皮肤冷白哑光，如梦如幻。\",\n    \"style_description\": {\n        \"aesthetics\": \"高级深色主调的华丽朦胧美学，妖冶慵懒的气质，光的美学与氛围感至上，柔软肉色与深色背景的碰撞，似真似幻的lomo风格，Glam（华丽）、Glitter（闪耀）、Groovy（悠扬）兼具，梦幻空灵，质感晶莹剔透。\",\n        \"lighting\": \"人造光柔和地包裹人物，光氛围浓郁，低对比影调避免强烈阴影，光线在肌肤上形成细腻的哑光质感，亮部集中在面部、手部与饰品上，背景沉入暗部，整体光影摇曳，如幻如真。\",\n        \"photo\": \"平拍，多视角融合的构图，手部伸向镜头形成互动感，中心略偏，背景虚化模糊，8K超高清画质，极致细节，照片真实感强烈，综合网络爆款逻辑。\",\n        \"medium\": \"digital photography, soft focus, lomography effect, skin texture enhancement, 8K ultra HD, fine art portrait\"\n    },\n    \"color_palette\": [\n        \"#F8E0D0\",\n        \"#E6B8A8\",\n        \"#C08070\",\n        \"#1A1A1A\",\n        \"#2D2D2D\",\n        \"#D4AFA0\"\n    ],\n    \"compositional_deconstruction\": {\n        \"background\": \"深色模糊背景，隐隐有光晕流转，可能是暗色幕布或虚化的室内空间，没有任何清晰物体，低对比的灰黑渐变衬托出人物的白皙肌肤和闪亮面饰。\",\n        \"elements\": [\n            {\n                \"type\": \"obj\",\n                \"desc\": \"主体人物：一位绝美少女，身材饱满，着深色细吊带或抹胸服饰，露出光滑的香肩与锁骨，冷白皮呈现哑光质感，皮肤细节真实，骨相优越。她微微侧身，一只手臂前伸，手掌展开，手指修长，做着伸向镜头的动作，指甲修剪精致，带有光泽，仿佛要触碰观者。\"\n            },\n            {\n                \"type\": \"obj\",\n                \"desc\": \"面部妆容与神态：粉面桃腮，眸含秋水，眼神迷离而勾人。嘴角噙着一抹淡笑，妖冶又慵懒。眉间点缀金色或红色花钿，眼角也贴着细小亮钻或彩绘花钿，左侧脸颊有一颗小巧的爱心面饰，右侧脸颊或鼻梁则画着精致的小猪图案面饰，俏皮又华丽。整体妆感清透，突出五官立体感。\"\n            },\n            {\n                \"type\": \"obj\",\n                \"desc\": \"发型：粉白晕染的短碎发，柔顺而有空气感，斜刘海遮住部分额头，发丝在光照下呈现淡淡的粉色调，边缘晕染自然，与肤色融合。\"\n            },\n            {\n                \"type\": \"obj\",\n                \"desc\": \"光影与质感：画面带有轻微的lomo效果，暗角自然，光影柔和，皮肤质感细腻晶莹，犹如水晶般剔透，冷白皮在低对比影调中泛着哑光，面部的爱心、花钿和猪纹在微光下闪闪发光，增添梦幻感。\"\n            }\n        ]\n    }\n}"], "inputs": [{"name": "clip", "link": 7, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 100, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 4, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.8.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 24}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [540, 520], "pos": [11540, 470], "widgets_values": [], "inputs": [{"name": "text", "link": 34, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 31, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "609f3afaa74b2f88ef9ce8d939626065e3247469", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 22}