type": "GlobalSeed //Inspire", "properties": {"cnr_id": "comfyui-inspire-pack", "ver": "1aef2c57e35078b6017697df9cf30ad595d93826", "widget_ue_connectable": {"mode": true, "action": true, "last_seed": true, "value": true}, "Node name for S&R": "GlobalSeed //Inspire"}, "order": 6}, {"mode": 0, "outputs": [], "size": [452.1966857910156, 672.0988159179688], "pos": [1244.3359375, -1967.07666015625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 110, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 60, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "SaveImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"mode": 0, "outputs": [{"name": "SIMPLE_PROMPT_LIST", "label": "提示词列表(简易)", "type": "SIMPLE_PROMPT_LIST", "localized_name": "SIMPLE_PROMPT_LIST"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [391.63507080078125, 708.1370239257812], "pos": [-835.0643920898438, -2010.718505859375], "widgets_values": ["使用C4D进行3D建模渲染，制作一张双11购物节电商海报。画面中心展示一只可爱的狗狗，旁边摆放着高品质的狗粮。狗狗的毛发细腻逼真，眼神中透露出对美食的期待。狗粮颗粒饱满，色彩鲜艳，仿佛散发着诱人的香气。背景是一个温馨的家庭客厅场景，有柔软的地毯、舒适的沙发和窗外洒进的阳光，营造出一种温暖、舒适的氛围。海报上方用醒目的立体大标题呈现“双11狂欢 预售即将开启”，下方标题栏“跨店满300减40”。整体画面色彩明亮、饱和度高，展现出温馨与关爱的氛围。 \n", "设计一下“钉哥联盟牛肉汤”的包装，上面有立体雕塑的碗", "设计一下“钉哥联盟牛肉汤”的门头，要求有立体雕塑的碗，正面展示", "3D 渲染，微缩风格，主体为巨大的良渚玉琮创意抽象造型建筑，良渚玉琮建筑，搭配雕刻的黑色幼圆体红色文字 “钉哥联盟牛肉面” 字体logo，字体logo下方横排印制雕刻的黑色幼圆体白色小字“品质第一 坚守本心”。建筑为两层结构，一层为自动门入口，自动门门头挂有横版红色雕刻文字“钉哥联盟”，门前设有中国风设计 红色遮阳伞和便捷点单区，顾客来往不息；二层设有全落地玻璃窗和现代感阳台，人们在高脚椅上小憩或边工作边品茶饮。远处高楼背景为新疆大巴扎建筑，近处街景环绕着餐馆、红白相间的路虎揽胜、快节奏人群，整体气氛高效、有序、现代，二楼围栏外立面体现主题定位雕刻文字“钉哥联盟”。高级感，32k超高清，要求有立体雕塑的碗", "该图像是九个可爱3D卡通熊猫角色的集合，每个熊猫都表现出不同的面部表情与动作，并伴有中文文字。熊猫角色以 3x3 网格排列，Q版风格，大圆头，胖乎乎的身体，光滑材质，柔和打光，高质量渲染\n\n左上：熊猫双臂交叉，表情严肃且带有愤怒感。中文文字呈“生气啦”（意思是“我很生气！”）。\n\n顶部中间：熊猫双手高高举起，露出灿烂的笑容。中文文字呈“好开心！”（意思是“非常快乐！”）。\n\n右上：熊猫侧躺在地上，表情惊讶，仿佛突然被吓到。中文文字呈“吓一跳”（意思是“被吓到了”）。\n\n中左：熊猫双手叉腰，闭着眼睛大笑。中文文字呈“哈哈哈”（意思是“非常开心地笑”）。\n\n中间：熊猫一只手托着下巴，露出沉思的表情。中文文字呈“思考人生”（意思是“陷入沉思”）。\n\n右中间：熊猫打着哈欠并伸懒腰，表情困倦。中文文字呈“太困”（意思是“非常想睡觉”）。\n\n左下：熊猫竖起一只大拇指，表情自信而中立。中文文字呈“赞”（意思是“好”或“棒极了”）。\n\n底部中间：熊猫双手捂住脸颊，脸上泛红，露出害羞的表情。中文文字呈“别看我”（意思是“我很害羞”）。\n\n右下：熊猫伸出一只手指向前方，表情坚定。中文文字呈“冲啊！”（意思是“向前冲！”）。"], "inputs": [{"shape": 7, "name": "simple_prompt_list", "label": "提示词列表(简易)", "type": "SIMPLE_PROMPT_LIST", "localized_name": "simple_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "提示词_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "提示词_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "提示词_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "提示词_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "提示词_5"}], "flags": {}, "id": 106, "type": "CR Simple Prompt List", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"prompt_3": true, "prompt_4": true, "prompt_5": true, "prompt_1": true, "prompt_2": true}, "Node name for S&R": "CR Simple Prompt List"}, "order": 7}, {"mode": 0, "outputs": [{"name": "SIMPLE_PROMPT_LIST", "label": "提示词列表(简易)", "type": "SIMPLE_PROMPT_LIST", "localized_name": "SIMPLE_PROMPT_LIST"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [417.6545715332031, 710.221923828125], "pos": [-1276.59130859375, -2012.851318359375], "widgets_values": ["童话插画风格，一只巨大的可爱猫咪和一个女孩在森林小路上行走，猫咪趴在花丛中，表情温柔可爱，女孩穿着复古连衣裙，背着小挎包，场景周围盛开着五彩缤纷的花朵，远处有木屋和松树林，天空晴朗有云彩，整体画面色彩丰富，氛围温暖梦幻，细腻的线条，绘本插画风格。", "极简现代 Logo，中文文字“钉哥联盟”位于底部，图形在上方以几何形状或抽象图标表现多人团结与协作，兼具科技感与未来感。主色调蓝色与银白色，线条圆润流畅，比例协调，字体稳重且有创意，整体设计具有辨识度和美学感，清晰简洁，背景纯色，正面展示，适合作为社群标志和品牌 Logo。", "电影海报，海报大标题“钉哥联盟”，金属字体，京都建筑，对称构图，打扮成忍者的小人在最前面，飞檐走壁，蓝色眼睛，宏大的场景，后面一堆忍者的背影，高清分辨率，强烈对比度", "\n电影海报设计，破碎的镜片，每一个镜片都是一张长相不同的模糊人脸，前景中央一个无脸的黑影半身特写，雾感，写意，诡异；电影标题“我是谁”竖着居于海报正中央，海报最上方写着“12.6 正式上映”。\n梦境，多重曝光，光影艺术，斑驳光影，明暗对比，杰作，获奖作品，极致构图，电影光线。", "电影名称文字艺术毛笔古风字体写上“长安的荔枝”字体相对居中，左上角黑色小字写着“钉哥联盟出品”一颗剥开的新鲜荔枝，背景是一副多条线路的古地图，地图上很小一辆马车、一匹倒下的马，船和散落的腐坏的荔枝，仰视角度，4k高清，大师作品，电影海报，极简构图，摄影，超高质量，超精细"], "inputs": [{"shape": 7, "name": "simple_prompt_list", "label": "提示词列表(简易)", "type": "SIMPLE_PROMPT_LIST", "localized_name": "simple_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "提示词_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "提示词_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "提示词_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "提示词_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "提示词_5"}], "flags": {}, "id": 105, "type": "CR Simple Prompt List", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"prompt_3": true, "prompt_4": true, "prompt_5": true, "prompt_1": true, "prompt_2": true}, "Node name for S&R": "CR Simple Prompt List"}, "order": 8}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [107], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [384.07171630859375, 106], "pos": [389.0536193847656, -1396.9486083984375], "widgets_values": [1328, 1328, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT