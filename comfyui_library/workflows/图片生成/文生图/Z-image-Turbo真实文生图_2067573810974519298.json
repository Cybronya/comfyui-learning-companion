阳图腾。人物双手全部插在裤袋中，肩膀向后舒展，腰腹向前顶出，身体后仰，站姿张扬随性。画面主色调为纯白背景，浅白金与粉紫头发、深紫色纹身、淡紫服饰构成统一紫白配色，高对比度简约干净，街头朋克叛逆氛围突出。"], "inputs": [{"name": "clip", "link": 37, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [2095.96923828125, 377.2071533203125], "id": 5, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [12], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [270, 106], "pos": [1702.85986328125, 673.6408081054688], "widgets_values": [1152, 1536, 2], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 11, "type": "EmptySD3LatentImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "EmptySD3LatentImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [16], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 58], "pos": [2172.69580078125, 181.59063720703125], "widgets_values": [3.0000000000000004], "inputs": [{"name": "model", "link": 36, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "shift"}, "name": "shift", "label": "shift", "type": "FLOAT", "localized_name": "shift"}], "flags": {}, "id": 3, "type": "ModelSamplingAuraFlow", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ModelSamplingAuraFlow"}, "order": 6}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": 