", "links": [22], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [376.2010498046875, 276], "pos": [821.3261108398438, -677.6443481445312], "widgets_values": ["Qwen3-VL-4B-Instruct", "8-bit (Balanced)", "Describe this image in detail.", "请提供此图像的详细描述。要详细描述图片风格，质感，光影构图等信息，越详细越好。如果是海报类图片要详细描述图片构图光影以及所有展现的文字。也要表现出文字大小占比，如果图片中有您熟悉的人物，如名人、电影人物或动画人物，请直接使用他们的名字。描述应尽可能详细，结果用中文输出，不要带任何解释和说明性文字，直接出图片描述，但不应超过800字。所有输出结果都要以最明确的描述，不要带解释和说明性以及总结性的副标题文字！", 1024, true, 993405311363495, "randomize"], "inputs": [{"shape": 7, "name": "image", "link": 21, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 19, "type": "AILab_QwenVL", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 7}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [29], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [341.3272705078125, 157.65859985351562], "pos": [865.141357421875, -129.44334411621094], "widgets_values": ["画面中央矗立着一棵巨大而奇幻的生命之树，其枝干盘曲如龙蛇般向天延伸，树皮纹理细腻流动，泛着青绿与蓝紫交织的光晕；树枝间密布细小星点般的发光粒子，在夜空中闪烁飘舞，仿佛星辰坠入林梢。树根部分蜿蜒舒展于地面之上，如同液态能量流涌动，散发柔和黄绿色光芒，照亮四周荒野。\n\n背景天空呈深邃墨绿渐变至亮翠绿，云雾缭绕中透射微弱星光，营造神秘缥缈氛围。远景是一座宏伟城堡群落轮廓隐约可见，尖塔高耸，窗棂灯火通明，散落金黄色光斑如萤火虫飞舞其间。近景是一片草甸，杂生枯木残桩点缀左右两侧边缘，地表覆盖茂盛草丛，夹杂橙红花簇在暗影里微微发亮。\n\n前景三人剪影并排站立，面向巨树方向：左侧男性身披铠甲，右手握剑柄垂于腰侧，肩部有护甲装饰；中间女性长裙曳地，双手紧牵两端之人，衣摆随风轻扬；右侧男性同样持械背负弓箭，身形挺拔略显粗犷。三者手拉着手形成亲密弧线，姿态坚定却充满希望感，身影被身后强光源勾勒得清晰分明。\n\n整幅画作采用梦幻写实主义渲染技法，色彩饱和度极高且层次丰富——从幽冥黑到荧光绿再到暖金色过渡自然流畅，材质表现上树叶似薄纱半透明，树皮呈现湿润光泽，金属装备反射冷冽光辉。光线主要来自大树内部自发光及远方城池灯光，主光源由下至上倾泻而出，造成强烈逆光效果，并在角色身上投下浓重阴影强化立体空间纵深。\n\n构图遵循中心对称法则，巨型古树占据视觉主导地位，三层结构递进式引导视线：先聚焦脚下草地→再上升至树木主体→最终延展至远处城市景观，制造宏大叙事张力。无任何文本元素出现，纯视觉表达完整统一。整体意境融合童话史诗气质与魔幻现实主义笔触，细节繁复却不失简洁节奏美感，极具沉浸体验感染力。"], "inputs": [{"name": "text", "link": 22, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "id": 21, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 8}, {"mode": 0, "outputs": [{"name": "image", "links": [19, 28], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 194], "pos": [1734.88916015625, 11.889570236206055], "widgets_values": ["seedvr2_ema_3b_fp8_e4m3fn.safetensors", 1148236002, "randomize", 1920, 5], "inputs": [{"name": "images", "link": 18, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "block_swap_config", "label": "block_swap_config", "type": "block_swap_config", "localized_name": "block_swap_config"}, {"shape": 7, "name": "extra_args", "label": "extra_args", "type": "extra_args", "localized_name": "extra_args"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "new_resolution"}, "name": "new_resolution", "label": "new_resolution", "type": "INT", "loc