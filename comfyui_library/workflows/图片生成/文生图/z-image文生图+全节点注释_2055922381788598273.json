, "type": "IMAGE", "localized_name": "IMAGE"}], "color": "#3f384f", "widgets_values": [], "inputs": [{"name": "samples", "link": 7, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 8, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {"collapsed": false}, "type": "VAEDecode", "mode": 0, "bgcolor": "#6c6088", "size": [240, 140], "pos": [1670.4000244140625, 0], "id": 8, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 23}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#1 UNETLoader\n作用：加载扩散主干模型（UNet），决定核心生成能力。\n参数：\n- unet_name：当前值=z_image_turbo_nvfp4.safetensors；作用：选择 UNet 模型文件；范围：模型下拉列表中的文件名；默认：系统默认 UNet。\n- weight_dtype：当前值=default；作用：模型权重精度类型；范围：fp16 / bf16 / fp8 等枚举；默认：默认精度。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 226], "pos": [0, 188], "id": 26, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#2 CLIPLoader\n作用：加载 CLIP 语义编码器，供文本/图像条件编码使用。\n参数：\n- clip_name：当前值=qwen_3_4b.safetensors；作用：选择 CLIP 模型文件；范围：模型下拉列表中的文件名；默认：系统默认 CLIP。\n- type：当前值=lumina2；作用：CLIP 工作模式；范围：插件定义的下拉枚举；默认：default。\n- device：当前值=default；作用：模型运行设备；范围：cpu / cuda / mps 等可用设备；默认：default。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 280], "pos": [0, 1136], "id": 27, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#3 VAELoader\n作用：加载 VAE 编解码器，负责像素域与潜空间转换。\n参数：\n- vae_name：当前值=z_image_turbo-vae.safetensors；作用：选择 VAE 文件；范围：VAE 文件列表中的文件名；默认：系统默认 VAE。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 172], "pos": [0, 3044], "id": 28, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#4 KSampler\n作用：核心采样器：按步数/采样器/调度器将噪声迭代为目标 latent。\n参数：\n- seed：当前值=480019060755589；作用：随机种子，控制可复现性；范围：整数，常见 0 ~ 2^63-1；默认：0。\n- control_after_generate：当前值=randomize；作用：每次生成后对种子的处理策略；范围：固定/随机/递增等枚举值；默认：fixed。\n- steps：当前值=9；作用：采样步数，步数越高通常细节越充分；范围：整数，常见 1 ~ 150；默认：20。\n- cfg：当前值=1；作用：提示词引导强度；范围：浮点，常见 0.0 ~ 30.0；默认：7.0。\n- sampler_name：当前值=euler；作用：采样算法类型；范围：下拉枚举（如 euler / dpm / sa_solver）；默认：euler。\n- scheduler：当前值=simple；作用：噪声调度策略；范围：下拉枚举（normal / karras / beta 等）；默认：normal。\n- denoise：当前值=1；作用：去噪强度；1 表示完整重绘；范围：浮点 0.0 ~ 1.0；默认：1.0。\n- model：当前值=来自 节点#1 UNETLoader 的 `MODEL` 输出；作用：接收上游模型对象（具体是扩散模型、姿态模型或检测模型由该节点类型决定）；范围：模型对象（连线输入）；默认：由上游节点输出决定。\n- positive：当前值=来自 节点#5 CLIPTextEncode 的 `CONDITIONING` 输出；作用：接收正向条件向量，告诉模型“应该生成什么”；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。\n- negative：当前值=来自 节点#6 ConditioningZeroOut 的 `CONDITIONING` 输出；作用：接收负向条件向量，告诉模型“尽量避免什么”；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。\n- latent_image：当前值=来自 节点#7 EmptyLatentImage 的 `LATENT` 输出；作用：接收起始 latent 画布或中间 latent 结果，作为采样输入底稿；范围：latent 数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 910], "pos": [1252.800048828125, 323], "id": 29, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#5 CLIPTextEncode\n作用：将文本编码为条件向量（常用于负面词或补充条件）。\n参数：\n- text：当前值=；作用：输入文本内容（正/负提示词）；范围：字符串，通常 0 ~ 4096 字符；默认：空字符串。\n- clip：当前值=来自 节点#2 CLIPLoader 的 `CLIP` 输出；作用：接收 CLIP 编码器对象，用于把提示词编码成条件向量；范围：CLIP 编码器对象（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 244], "pos": [417.6000061035156, 188], "id": 30, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#6 ConditioningZeroOut\n作用：把条件输入置空/弱化，减少条件干扰。\n参数：\n- conditioning：当前值=来自 节点#5 CLIPTextEncode 的 `CONDITIONING` 输出；作用：接收上游 `conditioning` 连线输入；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 190], "pos": [835.2000122070312, 188], "id": 31, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#7 EmptyLatentImage\n作用：创建空白 latent 画布，相当于先定好画布尺寸。\n参数：\n- width：当前值=720；作用：控制输出尺寸与清晰度；改大更清晰但更耗时、更占显存；范围：整数或预设分辨率档位（常见 256 ~ 4096）；默认：1024（常见）。\n- height：当前值=1280；作用：控制输出尺寸与清晰度；改大更清晰但更耗时、更占显存；范围：整数或预设分辨率档位（常见 256 ~ 4096）；默认：1024（常见）。\n- batch_size：当前值=1；作用：一次生成的图片数量；范围：整数，常见 1 ~ 16；默认：1。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 298], "pos": [0, 2462], "id": 32, "properties": {"widget_ue_connectable": {}}, "order": 11}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#8 VAEDecode\n作用：将采样 latent 解码为可视图像。\n参数：\n- samples：当前值=来自 节点#4 KSampler 的 `LATENT` 输出；作用：接收待处理 latent 样本（如待解码或待上采样的数据）；范围：latent 数据（连线输入）；默认：由上游节点输出决定。\n- vae：当前值=来自 节点#3 VAELoader 的 `VAE` 输出；作用：接收 VAE 对象，用于像素图像与 latent 之间转换；范围：VAE 对象（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 262], "pos": [1670.4000244140625, 188], "id": 33, "properties": {"widget_ue_connectable": {}}, "order": 12}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#20 SaveImage\n作用：保存图像到输出目录并生成文件名前缀。\n参数：\n- filename_prefix：当前值=邀请码：jq8lvwrk，领1000RH币；作用：输出文件名前缀；范围：字符串（文件系统合法字符）；默认：ComfyUI。\n- images：当前值=来自 节点#25 ImageUpscaleWithModel 的 `IMAGE` 输出；作用：接收图像序列输入（可是一张图或多帧批次）；范围：图像数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 244], "pos": [2505.60009765625, 990], "id": 34, "properties": {"widget_ue_connectable": {}}, "order": 13}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#24 UpscaleModelLoader\n作用：加载模型或资源，给后面的节点提供输入。\n参数：\n- model_name：当前值=RealESRGAN_x2.pth；作用：选择具体模型文件（如放大模型/检测模型）；范围：模型文件下拉列表；默认：当前节点默认模型。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 154], "pos": [0, 698], "id": 36, "properties": {"widget_ue_connectable": {}}, "order": 14}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#25 ImageUpscaleWithModel\n作用：接收输入图像与超分模型，对画面进行放大并重建细节，输出更高清的图像结果。\n参数：\n- upscale_model：当前值=来自 节点#24 UpscaleModelLoader 的 `UPSCALE_MODEL` 输出；作用：接收 latent 上采样模型，用于提升 latent 分辨率；范围：UPSCALE_MODEL 类型数据（连线输入）；默认：由上游节点输出决定。\n- image：当前值=来自 节点#8 VAEDecode 的 `IMAGE` 输出；作用：接收上游图像数据；范围：图像数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 298], "pos": [2088, 188], "id": 37, "properties": {"widget_ue_connectable": {}}, "order": 15}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [2973.1748046875, 4142.5], "pos": [-3075.032958984375, 0], "widgets_values": ["5ea7b6dddd00c759948ac5990f2255e6d9464063ed0de5d84e6a4cd840029a69.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {"collapsed": false}, "id": 38, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 16}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [2973.1748046875, 4142.5], "pos": [-3075.032958984375, -4236.435546875], "widgets_values": ["f6980cf20581e1671f71246f264eb81905f4af0ddd81b43c3d74630b82ce0b0f.jpeg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {"collapsed": false}, "id": 39, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 17}, {"outputs": [{"name": "text", "links": [22], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#3f384f", "widgets_values": ["A flash snapshot taken in a small, crowded Japanese izakaya, filled with handwritten menus, old posters, and wooden textures. The lighting is from a direct on-camera flash, producing bright highlights, harsh shadows, and a slightly grainy texture that enhances the candid feeling.\n\nThe main subject is a young woman sitting on a wooden bar stool, turning her body slightly and looking back over her shoulder toward the camera. She wears a white button-up shirt and a short high-waisted checkered skirt, revealing her legs and adding to the youthful, casual tone of the scene.\n\nHer face is softly lit by the flash — cheeks vividly blushed, red lips glossy, and eyes meeting the lens with a subtle, playful yet intimate expression. The smile is gentle but suggestive, carrying a slight sense of awareness and warmth. Her posture and gaze create a delicate tension between confidence and softness.\n\nThe background is dim and crowded with older patrons in dark clothes, contrasting with her bright presence. The composition is tight and spontaneous, typical of 90s Japanese disposable camera photography — high flash contrast, slight blur, and natural imperfection.\n\nThe overall mood is nostalgic, warm, and faintly ambiguous — capturing a moment that feels real, close, and emotionally charged, like a personal memory illuminated by flash rather than a staged portrait.\n这是一张在狭小拥挤的日式居酒屋里用闪光灯拍摄的照片，屋里摆满了手写菜单、老海报和木质纹理。光线来自机顶闪光灯的直射，营造出明亮的高光、刺眼的阴影和略带颗粒感的纹理，增强了照片的自然感。\n画面主体是一位年轻女子坐在酒吧木凳上，微微侧身，目光越过肩膀，望向镜头。她身穿白色纽扣衬衫和高腰格纹短裙，露出双腿，为画面增添了一抹青春随意的气息。\n闪光灯柔和地照亮了她的脸庞——双颊绯红，红唇闪耀光泽，目光与镜头交汇，眼神微妙、俏皮却又充满亲密感。她的笑容温柔却又充满暗示，透着一丝警觉与温暖。她的姿态和目光在自信与柔和之间营造出一种微妙的张力。\n背景昏暗，挤满了身着深色衣服的老年顾客，与她明亮的身影形成鲜明对比。构图紧凑自然，是90年代日本一次性相机摄影的典型特征——高闪光对比度、轻微的模糊和自然的瑕疵。\n整体氛围怀旧、温暖，略带一丝暧昧——捕捉真实、亲近、充满情感的瞬间，就像闪光灯照亮的个人记忆，而不是摆拍的肖像。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "CR Text", "mode": 0, "bgcolor": "#6c6088", "size": [240, 446], "pos": [0, 1512], "id": 21, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 18}, {"outputs": [], "color": "#555060", "widgets_values": ["节点#21 CR Text\n作用：接收或创建一段文本并原样输出，常作为提示词模板/变量中转给后续文本处理节点。\n参数：\n- text：当前值=...；作用：输入文本内容（正/负提示词）；范围：字符串，通常 0 ~ 4096 字符；默认：空字符串。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#928aa6", "size": [240, 172], "pos": [0, 2006], "id": 35, "properties": {"widget_ue_connectable": {}}, "order": 19}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [2363.5764355102674, 640.8194618022939], "scale": 0.23092115320381856}}, "groups": [{"color": "#3f789e", "font_size": 300, "flags": {}, "id": 1, "title": "🔽邀请码：jq8lvwrk", "bounding": [-3075.032958984375, -4708.02001953125, 2973.1748046875, 421.0096130371094]}], "links": [[1, 1, 0, 4, 0, "MODEL"], [2, 2, 0, 5, 0, "CLIP"], [3, 5, 0, 4, 1, "CONDITIONING"], [4, 5, 0, 6, 0, "CONDITIONING"], [5, 6, 0, 4, 2, "CONDITIONING"], [6, 7, 0, 4, 3, "LATENT"], [7, 4, 0, 8, 0, "LATENT"], [8, 3, 0, 8, 1, "VAE"], [22, 21, 0, 5, 1, "STRING"], [26, 24, 0, 25, 0, "UPSCALE_MODEL"], [27, 8, 0, 25, 1, "IMAGE"], [28, 25, 0, 20, 0, "IMAGE"]], "id": "cff3c9b6-230e-4a46-a631-034aab0083f8", "config": {}, "version": 0.4, "last_node_id": 39, "r