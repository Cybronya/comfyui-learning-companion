的精交织，仿若从唐代仕女嬉春图中走出的角色 —— 既有着中式美学的撞色诗意，又藏着闲居时的松弛温柔，每一处细节都浸着清丽的仙韵，氛围感治愈而精致。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#009e3d", "size": [505.148193359375, 375.2469787597656], "pos": [-1233.8310546875, 2487.774658203125], "id": 497, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 4}, {"outputs": [{"name": "MODEL", "links": [776], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#432", "widgets_values": ["QI2.1-xiaohongshu-style-lora.safetensors", 0.10000000000000002], "inputs": [{"name": "model", "link": 775, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#653", "size": [394.3876647949219, 82], "pos": [-608.6354370117188, 2868.63330078125], "id": 502, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 10}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [783], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [-1233.8310546875, 3654.391845703125], "widgets_values": ["example.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 505, "type": "LoadImage", "title": "RH_Load", "properties": {"widget_