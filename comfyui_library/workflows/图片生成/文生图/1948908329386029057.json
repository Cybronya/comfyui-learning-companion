\n  “text”： “无”，\n  “关键字”： [\n    \"16:9\",\n    “星巴克”，\n    “咖啡仪式”，\n    “温暖审美”，\n    “动态装配”，\n    “自然光”，\n    “黄金时段”，\n    “感官”，\n    “无文本”，\n    “温馨的气氛”\n  ]\n}"], "inputs": [], "flags": {}, "id": 40, "type": "Text Multiline", "properties": {"cnr_id": "was-node-suite-comfyui", "ver": "1cd8d304eda256c412b8589ce1f00be3c61cf9ec", "Node name for S&R": "Text Multiline"}, "order": 8}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.19.9", "VHS_latentpreview": false, "ds": {"offset": [-442.74521094782136, -214.7517877737129], "scale": 0.964614964500003}}, "groups": [], "links": [[18, 11, 0, 16, 0, "WANTEXTENCODER"], [19, 42, 0, 22, 1, "BLOCKSWAPARGS"], [21, 22, 0, 27, 0, "WANVIDEOMODEL"], [22, 16, 0, 27, 1, "WANVIDEOTEXTEMBEDS"], [23, 68, 0, 27, 2, "WANVIDIMAGE_EMBEDS"], [24, 66, 0, 27, 8, "SLGARGS"], [25, 21, 0, 28, 0, "WANVAE"], [26, 27, 0, 28, 1, "LATENT"], [28, 39, 0, 71, 2, "INT"], [29, 72, 0, 71, 0, "GIMMVIF_MODEL"], [30, 28, 0, 71, 1, "IMAGE"], [33, 71, 0, 48, 0, "IMAGE"], [37, 40, 0, 83, 0, "STRING"], [38, 83, 0, 16, 2, "STRING"], [39, 77, 0, 22, 2, "WANVIDLORA"], [40, 84, 0, 85, 0, "INT,FLOAT,IMAGE,LATENT"], [41, 85, 0, 87, 0, "INT"], [42, 87, 0, 68, 2, "INT"], [43, 39, 0, 27, 17, "INT"]], "id": "00000000-0000-0000-0000-000000000000", "config": {}, "version": 0.4, "last_node_id": 87, "revision": 0}