weight_dtype"}, "name": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 62, "type": "UNETLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 2}, {"outputs": [{"name": "CONDITIONING", "links": [36, 41], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["一位约28岁、神情温和却目光坚定的现代女性，留着自然蓬松的齐肩短发，眉眼间透着沉静力量，她侧身坐在一张木质扶手椅上，单手轻托腮边（不遮嘴），身体微微前倾倚在桌沿，但头部正对镜头，眼神温柔而笃定地直视观众。场景是一个清晨的窗边书房，窗外是朦胧的薄雾与初升的暖金色阳光，室内有散落的书本、一杯热茶与未合上的笔记本，背景虚化中隐约可见绿植与木质书架。她穿着米白色针织开衫搭配浅灰阔腿裤，皮肤细腻有光泽，面部光影柔和自然，鼻翼与唇角细节清晰。85mm人像摄影，大光圈虚化背景，极致写实，电影级柔光与氛围感布光，适合对口型视频。"], "inputs": [{"name": "clip", "link": 44, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 69, "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [410, 370], "pos": [449.85577392578125, 303.6226806640625], "id": 45, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 12}, {"mode": 0, "outputs": [{"name": "text", "links": [63], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [420.6891174316406, 407.14910888671875], "pos": [-1601.5654296875, 123.10655975341797], "widgets_values": ["你是一位电影视觉导演。你的任务是根据“口播文案”，为文生图模型 Z-image 生成一段极具生命力的摄影提示词。你将创造一个外形贴切、坐姿自然、且完全符合对口型规格的虚拟人物。\nTask Logic:\n文案语义建模（决定人物与气质）：\n分析文案，自主设定人物（性别、年龄、发型、眼神）。\n江湖流：眼神凌厉，皮肤有质感。\n商务流：神态从容，着装考究。\n治愈流：神情温和，目光深邃。\n灵动坐姿与构图（核心优化）：\n自然坐姿多样化：禁止机械的“正襟危坐”。根据场景随机切换坐姿：放松地靠在椅背上、双臂自然交叉、身体略微前倾支在桌面上、单手托腮（不遮挡嘴部）、或者侧身坐但头扭向正面。\n视角锁死：无论身体如何摆动，头部必须正对镜头（Frontal view），目光直视观众（Eye contact）。\n构图：中近景（Chest-up），确保人物从头到胸部完整，且位于画面核心，方便后期口型剪辑。\n场景自主衍生（禁止照搬）。\n摄影规格：\n极致写实摄影（Ultra-realistic），细腻皮肤纹理，85mm人像焦段，大光圈虚化背景。\nOutput Rules:\n仅输出中文提示词，严禁任何前缀说明。\n格式：[人物形象描述] + [具体的自然坐姿与视线要求] + [衍生场景与背景细节] + [服装与电影级光影] + [写实摄影技术参数]。\n演示效果：\n用户输入文案：\n“整天对着那个巴掌大的屏幕瞎划拉……全看你能不能把主动权从那段烂代码手里抢回来。”\nZ-image 系统提示词输出（坐姿灵动版）：\n“一位约32岁左右、神色坚毅、留着干净寸头的现代男性，他正随意地靠坐在一张皮质办公椅上，身体略微倾斜，但头颈保持正对镜头，眼神犀利地直视前方。场景是一个深夜的工业风工作室，身后有模糊的计算机屏幕光与巨大的冷色调落地窗。他穿着一件质感的深蓝色立领夹克，面部受光均匀且富有层次感，皮肤毛孔细节清晰。85mm人像摄影，大光圈背景深邃虚化，极致写实，适合对口型视频。”"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 58, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}, {"mode": 0, "outputs": [{"name": "STRING", "links": [65], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 402], "pos": [-1114.3369140625, 281.6549377441406], "widgets_values": ["", "", "Qwen3-VL-8B-Instruct-FP8", "none", false, 0.7, 2048, 200704, 1003520, 670, "randomize", "flash_attention_2"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "link": 63, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "text2"}, "name": "text2", "link": 62, "label": "text2", "type": "STRING", "localized_name": "text2"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temper