lty", "type": "FLOAT", "localized_name": "repeat_penalty"}, {"widget": {"name": "frequency_penalty"}, "name": "frequency_penalty", "label": "frequency_penalty", "type": "FLOAT", "localized_name": "frequency_penalty"}, {"widget": {"name": "present_penalty"}, "name": "present_penalty", "label": "present_penalty", "type": "FLOAT", "localized_name": "present_penalty"}, {"widget": {"name": "mirostat_mode"}, "name": "mirostat_mode", "label": "mirostat_mode", "type": "INT", "localized_name": "mirostat_mode"}, {"widget": {"name": "mirostat_eta"}, "name": "mirostat_eta", "label": "mirostat_eta", "type": "FLOAT", "localized_name": "mirostat_eta"}, {"widget": {"name": "mirostat_tau"}, "name": "mirostat_tau", "label": "mirostat_tau", "type": "FLOAT", "localized_name": "mirostat_tau"}, {"widget": {"name": "state_uid"}, "name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "flags": {"collapsed": true}, "id": 74, "type": "llama_cpp_parameters", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_parameters"}, "order": 1}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "字符串", "type": "STRING", "localized_name": "text"}], "size": [374.4841003417969, 285.0100402832031], "pos": [8320.14453125, -222.42625427246094], "widgets_values": [], "inputs": [{"name": "text", "link": 103, "label": "文本", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 22, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "609f3afaa74b2f88ef9ce8d939626065e3247469", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 13}, {"mode": 0, "outputs": [{"name": "output", "links": [103, 104], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [336.4854431152344, 420.7950134277344], "pos": [7959.0615234375, -352.3146667480469], "widgets_values": ["Prompt Style - Detailed", "5秒，镜头缓慢拉远", "# Krea 2 巨构提示词扩写规则\n\n用户输入中文关键词、自然语言或参考图后，直接输出一段 80–140 词的纯英文自然语言图像 Prompt。只输出 Prompt。\n\n先锁定用户输入的主角。它可以是建筑、巨兽、有机体、机器、自然地貌、天体或任何其他对象；整张图的巨大主体始终是它本身。题材、文化、时代和材料只改变这个主角的外形与气质，画面内其余元素都从这个主角派生。\n\n当输入只给出宽泛主体类型，先在内部收束为一个完整、可见、前后一致的主形，再设计镜头：生物先确定身体构型与体表，有机体先确定生长组织，机器先确定工作结构，自然体先确定地质或气象过程。这个主形贯穿前景和远景，文化词只参与它的形态、材料与环境。\n\n把画面设计成一个单帧的空间关系，而不是物件清单。先选一个最适合主角的地貌级关系：它压在环境上方、沿地平线延伸、从地面或云海中出现、横跨峡谷或水面、以自身的开口／肢体／缝隙框住远景，或让风、云、潮、雾沿它流动。整张图只保留这一个关系。\n\n巨构依靠一个连续、简单、可一眼读出的主形成立。镜头看见主形的一段近景证据，同时看见同一主形向远方、云层或画外延续。让主体的一部分被画框、云雾、地平线或阴影截断，使它的完整尺度留在画外。小建筑、道具与装饰只附着在这一主形上，用于说明其材料、功能或尺度。\n\n根据主角自身选择一个可识别的局部：建筑的屋面、门洞、台基或立面；生物的背脊、肢体、翼或甲壳；有机体的根、膜、孔洞或纤维；机器的舱段、梁架、轨道或关节；自然与天体的地层、浪面、环带或光幕。该局部必须和远处的巨大延续属于同一个主角。\n\n放入一个符合环境的小比例锚点。用户没有指定锚点时，优先从人、动物、树、船或飞行器中选择；用户已经给出文明设施或建筑环境时，再从普通建筑与聚落中选择。锚点贴近主角、位于其下方或被它遮挡，用于证明尺度，并保持为比例参照。\n\n文化身份进入主形的轮廓、结构与材料：中式要在巨构本身读出中式结构，北欧要在巨构本身读出北欧构造，其他题材同理。主角属于生物、有机体、机器或自然体时，文化身份落实在它自身的解剖、生长、装配、地貌、表面与环境中。纹样、雕刻、符文、管线、鳞片和植被只丰富已成立的主形。用户未指定材料时，表面从主角本身和所处环境的风化痕迹中取材。\n\n每张只安排一个光线事件：斜光擦过边缘、云隙照亮局部、风暴揭开一段、内部泄出光，或月光落在水／冰上。保留足够的天空、云海、水面、荒原或暗部，让巨大的主形与小锚点形成安静而明确的尺度关系。\n\n英文 Prompt 依次写：观看位置与镜头；主角的连续主形和唯一空间关系；近景局部与远处延续；比例锚点；文化／材料身份；光线和环境；用户指定的视觉媒介。每句话只写最终画面中能看见的内容。\n", "one by one", 24, 256, 874988699582553, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 102, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 101, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label":