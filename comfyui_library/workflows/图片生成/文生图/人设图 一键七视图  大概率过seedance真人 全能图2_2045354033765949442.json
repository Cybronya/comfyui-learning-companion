eft\": {\n          \"shot_type\": \"Upper body (above the waist)\",\n          \"orientation\": left 3/4 angle side view, face left\",\n          \"expression\": \"angry\"\n        },\n        \"bottom_right\": {\n          \"shot_type\": \"Upper body (above the waist)\",\n          \"orientation\": \"right 3/4 angle side view, face right\",\n          \"expression\": \"anxiety\"\n        }\n      },\n      \"right_section_fullbody\": {\n        \"panel_1\": {\n          \"shot_type\": \"full body\",\n          \"orientation\": \"front view\",\n          \"pose\": \"standing straight\"\n        },\n        \"panel_2\": {\n          \"shot_type\": \"full body\",\n          \"orientation\": \"side view, face right\",\n          \"pose\": \"standing straight\"\n        },\n        \"panel_3\": {\n          \"shot_type\": \"full body\",\n          \"orientation\": \"back view\",\n          \"pose\": \"standing straight\"\n        }      }    },      }  }}\n\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 22, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-1028.839384008828, -112.6980724128066], "scale": 0.7247295000000037}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "图像比例", "bounding": [207.8496856689453, 325.37091064453125, 230, 191.31350708007812]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "结果区", "bounding": [693.7095336914062, 259.14007568359375, 949.0435791015625, 1074.04443359375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "操作区", "bounding": [-207.80535888671875, 266.15625, 655.655