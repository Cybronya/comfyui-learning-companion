": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention_mode"}, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}], "flags": {}, "type": "AILab_QwenVL", "mode": 0, "bgcolor": "#374539", "size": [340, 300], "pos": [-1476.021728515625, 95.39144134521484], "id": 145, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 14}, {"mode": 0, "outputs": [{"name": "STRING", "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [619.098388671875, 449.1776428222656], "pos": [-1505.0206298828125, 538.6488037109375], "widgets_values": [], "inputs": [{"name": "source", "link": 333, "label": "source", "type": "*", "localized_name": "source"}], "flags": {}, "id": 146, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 17}, {"mode": 0, "outputs": [{"name": "text", "links": [329, 332], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [457.67669677734375, 638.6464233398438], "pos": [-2050.322998046875, 126.27823638916016], "widgets_values": ["生成水下摄影提示词。仅输出提示词，200字内。\n\n典型的**中文写实生态摄影出图提示词**，有清晰的模块化结构。我来拆解并生成模板。\n\n---\n\n## 提示词结构分析\n\n10张提示词全部遵循 **7层嵌套结构**，从宏观到微观、从静态到动态、从客观到氛围，层层递进：\n\n| 层级 | 名称 | 功能 | 出现率 |\n|------|------|------|--------|\n| 1 | 视角与风格定义 | 定拍摄视角+风格类型+景别 | 10/10 |\n| 2 | 色调与光影 | 定主色+辅色+光影质感+氛围词 | 10/10 |\n| 3 | 构图与背景 | 定视觉重心/构图法+背景内容 | 10/10 |\n| 4 | 主体细写（左/中） | 核心元素：形态+颜色+纹理+质感 | 10/10 |\n| 5 | 次要元素（右/下） | 配角元素：形态+颜色+与主体关系 | 10/10 |\n| 6 | 动态微细节 | 光斑/气泡/悬浮物/波纹/生物动态 | 9/10 |\n| 7 | 氛围收束 | 用一个氛围关键词做情感定调 | 10/10 |\n\n---\n\n## 通用模板\n\n```\n这是一张采用【视角】拍摄的【风格类型】摄影作品，属于【景别】构图，\n整体色调以【主色调】为主，搭配【辅助色①】【辅助色②】，\n光影【光影特征】，营造出【氛围词①】的【场景类型】氛围，\n【构图方式】，背景是【背景内容】。\n画面【位置①】是【主体内容】，\n【主体形态特征描写——形态/颜色/纹理/质感/细节变化】，\n画面【位置②】是【次要元素内容】，\n【次要元素形态特征描写——形态/颜色/与主体关系/自然痕迹】，\n【动态细节——光线折射/悬浮颗粒/气泡/波纹/生物动态】，\n整体营造出【氛围词②】的【场景定性】。\n```\n\n---\n\n## 各模块填词参考库\n\n### 【视角】\n| 选项 | 适用场景 |\n|------|----------|\n| 超低平视、接近地面的视角 | 强调地面质感、苔藓、落叶 |\n| 平视视角 | 水下、室内、中性场景 |\n| 平视偏低视角 | 有纵深感的通道、洞穴 |\n| 微俯视角 | 俯瞰桌面、水底全景 |\n| 仰视视角 | 树冠、天空、建筑 |\n\n### 【风格类型】\n| 选项 | 适用场景 |\n|------|----------|\n| 写实风格自然摄影 | 户外生态、植物、景观 |\n| 写实水下摄影 | 水下生态、水族造景 |\n| 写实微距摄影 | 昆虫、花蕊、纹理细节 |\n| 写实风光摄影 | 山川、湖泊、全景 |\n| 电影级纪实摄影 | 带叙事感的场景 |\n\n### 【景别】\n| 选项 | 说明 |\n|------|------|\n| 近景构图 | 强调细节质感，背景虚化 |\n| 中景构图 | 兼顾主体与环境 |\n| 中近景构图 | 主体突出+少量环境 |\n| 远景构图 | 强调空间与氛围 |\n| 特写构图 | 极度细节，纹理为主 |\n\n### 【色调】\n| 主色调 | 辅助色搭配 | 氛围倾向 |\n|--------|------------|----------|\n| 翠绿色 | 深棕、枯黄 | 生机+枯败并存 |\n| 墨绿/幽蓝 | 暖棕、橙红 | 神秘、深邃 |\n| 蓝绿色 | 银灰、浅白 | 通透、洁净 |\n| 暖褐色 | 清透湖绿 | 温润、自然 |\n| 灰褐色 | 鲜亮翠绿 | 对比强烈、聚焦 |\n\n### 【光影特征】\n| 选项 | 效果 |\n|------|------|\n| 柔和且充满氛围感 | 整体柔光，无硬阴影 |\n| 柔和的漫射光 | 阴天/水下均匀光 |\n| 层次分明 | 有明确的明暗分区 |\n| 偏暗，仅靠局部光源 | 聚焦式照明，戏剧感 |\n| 从上方穿透下来 | 上亮下暗，自然光感 |\n\n### 【氛围词】\n| 单词 | 方向 |\n|------|------|\n| 静谧 | 安静沉浸 |\n| 幽深 | 空间深邃 |\n| 充满生机 | 生命活力 |\n| 原始野趣 | 未被人工干预 |\n| 奇幻朦胧 | 超现实感 |\n| 神秘 | 未知探索感 |\n\n### 【构图方式】\n| 选项 | 说明 |\n|------|------|\n| 以【元素】为视觉重心 | 单一焦点 |\n| 呈现纵向延伸的纵深感 | 通道、隧道 |\n| 铺满【元素】 | 满画面无留白 |\n| 框架构图：前景形成天然取景框 | 前景遮挡引导视线 |\n| 左右分区构图 | 对比/对称 |\n\n### 【动态细节】\n| 类型 | 写法示例 |\n|------|----------|\n| 光线折射 | 水面上能看到晃动的波纹与光线折射形成的亮绿色光斑 |\n| 悬浮颗粒 | 细小的悬浮颗粒在水中缓缓飘动 |\n| 气泡 | 多颗大小不一的白色气泡从水底向上漂浮 |\n| 生物动态 | 几只深色的小水栖生物零星穿梭在植被间 |\n| 植物动态 | 细长水草呈现出轻微晃动的动态感 |\n| 水面倒影 | 水面折射出的模糊光影/模糊的水面倒影 |\n\n---\n\n## 实战模板（3种场景）\n\n### 模板A · 水下生态（原图主类型）\n\n```\n这是一张采用【平视视角】拍摄的【写实水下摄影】作品，属于【中景构图】，\n整体色调以【深浅不一的绿色】为主，夹杂着【棕褐色调】，\n光线透过上方的水面形成【柔和的漫射光】，营造出【静谧自然】的水下氛围，\n背景是【带有水面波纹反光的澄澈水体】。\n画面【前景/下部】是【主体植物群落】，\n【植物的茎干颜色、叶片形态、叶片颜色渐变、边缘状态、自然痕迹】，\n画面【中后/左侧】是【枯木/岩石/次要植物】，\n【枯木的表面质感、颜色、被植物遮挡关系，或岩石的苔藓附着】，\n【水面上能看到晃动的波纹与光线折射的光斑/悬浮颗粒在水中缓缓飘动/气泡上升】，\n整体营造出【静谧且充满自然野趣】的【水下生态环境】。\n```\n\n# \n \n---\n\n## 一句话生成公式\n\n如果不想逐层填，用这个速写公式也能保持结构：\n\n> **【视角】+【风格】+【景别】，【主色+辅色+光影】，【构图重心+背景】。【主体：形态+色+纹理+质感】。【次元素：形态+色+关系】。【动态细节】。整体营造【氛围】的【场景定性】。**\n\n示例：\n\n> 平视写实水下中景，深绿棕褐柔光漫射，视觉重心为前景沉水植物。植物细长棕黄茎干配深绿细碎叶片，部分叶尖嫩绿。左侧斜伸枯木表面粗糙被叶遮挡，底部散落灰褐色石块附深色苔藓。水面波纹折射亮绿光斑，气泡从水底缓缓上升。整体营造静谧野趣的水下原生生态。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 142, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 8}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "groupNodes": {}, "ds": {"offset": [-926.5756296520633, 33.24371096158353], "scale": 2.06773784386079}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "提取服装为产品图-2511-鲤鱼-qq-872627646", "bounding": [-765.369140625, -353.5970458984375, 2200.845458984375, 648.3347778320312]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Group", "bounding": [796.8634033203125, 762.2344970703125, 2054.7734375, 707.657470703125]}], "links": [[12, 10, 0, 8, 1, "VAE"], [171, 64, 0, 65, 0, "MODEL"], [175, 65, 0, 8, 0, "LATENT"], [177, 67, 0, 64, 0, "MODEL"], [235, 93, 0, 67, 0, "MODEL"], [284, 12, 0, 114, 0, "MODEL"], [286, 111, 0, 65, 2, "CONDITIONING"], [300, 115, 0, 65, 3, "LATENT"], [306, 132, 0, 128, 0, "MODEL"], [307, 126, 0, 129, 0, "CLIP"], [308, 128, 0, 130, 0, "MODEL"], [309, 133, 0, 130, 1, "CONDITIONING"], [310, 129, 0, 130, 2, "CONDITIONING"], [311, 131, 0, 130, 3, "LATENT"], [312, 136, 0, 131, 0, "IMAGE"], [313, 127, 0, 131, 1, "VAE"], [314, 135, 0, 132, 0, "MODEL"], [315, 126, 0, 133, 0, "CLIP"], [316, 130, 0, 134, 0, "LATENT"], [317, 127, 0, 134, 1, "VAE"], [318, 134, 0, 137, 0, "IMAGE"], [319, 8, 0, 136, 0, "IMAGE"], [320, 8, 0, 138, 0, "IMAGE"], [321, 8, 0, 139, 0, "*"], [325, 114, 0, 93, 0, "MODEL"], [326, 61, 0, 141, 0, "CLIP"], [327, 141, 0, 65, 1, "CONDITIONING"], [328, 141, 0, 111, 0, "CONDITIONING"], [329, 142, 0, 143, 11, "STRING"], [332, 142, 0, 145, 