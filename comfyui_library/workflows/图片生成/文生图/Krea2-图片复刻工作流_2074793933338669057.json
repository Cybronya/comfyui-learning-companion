thing"}], "flags": {"disabled": false}, "id": 379, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "625efbfa2fc20c31797dfffcbb41a26b6d91ab7b", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 15}, {"mode": 0, "outputs": [{"name": "output", "links": [402, 404], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [430, 540], "pos": [8731.07421875, 575.34814453125], "widgets_values": ["Normal - Describe", "", "", "one by one", 24, 256, 721147222564319, "randomize", true, false], "inputs": [{"name": "llama_model", "link": 398, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 399, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 403, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "link": 401, "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}