: "LATENT", "links": [6], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [695.5194702148438, 739.7294921875], "widgets_values": [1088, 1920, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {}, "id": 6, "type": "EmptySD3LatentImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "EmptySD3LatentImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [2], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [400, 200], "pos": [120.07421875, 447.6766052246094], "widgets_values": ["【主体与人物特征】\n一位年轻的亚洲女性，面部特写，皮肤白皙细腻，妆容精致，眼妆明显，佩戴灰色美瞳，眼神直视镜头，表情冷静略带酷感。她留着酒红色（深红棕色）的长直发，带有空气感的齐刘海。\n【动作与手部细节】\n右手抬起，拇指和食指轻轻捏着一张白色的麻将牌，牌面上写着绿色的“發”字。手指修长，做了非常长的透明尖头美甲，指甲上带有闪粉和亮片装饰，显得十分时尚。\n【服饰与配饰】\n身穿白色吊带上衣（仅露出肩颈部分），佩戴金色的圈状耳环，脖子上戴着一条细银链，吊坠是一个立体的小五角星。\n【环境与前景元素】\n背景为深棕色/褐色的纯色纹理背景，光线较暗，突出人物主体。图片的最下方前景处，横向排列着一排（共七张）麻将牌，从左至右依次清晰可见：“東”（黑色字）、“南”（黑色字）、“西”（黑色字）、“北”（黑色字）、“中”（红色字）、“發”（绿色字），最右侧还有一张背面的麻将牌。\n【光影与摄影风格】\n影棚正面柔光照明（Soft studio lighting），光线均匀地打在脸上，营造出通透的肤质，没有强烈的阴影。构图为中心构图，景别为近景/胸像。整体风格具有写实摄影的质感，带有一丝复古胶片或拍立得（Polaroid）的颗粒感和色调，高清晰度，8k分辨率。"], "inputs": [{"name": "clip", "link": 4, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 3, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [7], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 262], "pos": [1143.1102294921875, 394.35003662109375], "widgets_values": [741291752588729, "randomize", 8, 1.7, "res_multistep", "simple", 1], "inpu