"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["半身特写，一位高挑丰满、面容昳丽的唐代女子，她身着一袭朱红色抹胸襦裙，外披如烟似雾的绛红薄纱，酥胸半掩，腰肢纤细，身姿曼妙优雅。她朱唇微启，含羞带笑，眼眸温柔望着镜头，眼波流转间似有万种风情，浓密卷翘的睫毛在眼睑投下扇形阴影。背景是虚化成光斑的暖红色灯笼，散发出朦胧的节日光晕。一束柔和的电影级侧顶光，如流水般自上而下照亮她的脸庞与精致的锁骨，在肌肤上晕染出柔和的渐变光晕，另一侧脸颊隐入淡淡的阴影中，勾勒出立体的轮廓。肤质呈现出真实细腻的皮肤纹理与绒毛质感，眼神清澈明亮，倒映出点点的光源。电影级人像，极致写实，8k分辨率，细节丰富，营造出温柔旖旎的氛围。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#353", "size": [384.5694580078125, 173.9302520751953], "pos": [1232.5181884765625, 309.3696594238281], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 8}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#432", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 22, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#653", "size": [1352.5296630859375, 1153.87255859375], "pos": [1151.1409912109375, 597.6516723632812], "id": 12, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 14}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-696.4380911845459, 91.48340412051634], "scale": 0.7972024500000041}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "放大", "bounding": [2732.3984375, -85.31575775146484, 731.2501831054688, 680.99169921875]}], "links": [[4, 5, 0, 3, 1, "BITDANCE_LATENT"], [6, 1, 2, 3, 0, "BITDANCE_VAE"], [8, 1, 1, 2, 0, "BITDANCE_TEXT_ENCODER"], [10, 1, 0, 5, 0, "BITDANCE_MODEL"], [11, 2, 0, 5, 2, "BITDANC