_values": ["这是一张特写实摄影风格肖像照， 极简展现了一位慵懒慵懒的美女，衣服上写着显眼的大字“Z-Image 文生图 ”她坐在电竞椅上，背景中散落着几张略显模糊的零食。她拥有一头飘逸的粉色长卷发，蓬松的发梢精心编织着许多小巧精致的发辫，为画面增添了丰富而真实的细节。她戴着一副粉色猫耳游戏耳机，耳机上写着\"极简\"两个字。靠近唇边的麦克风杆清晰可见，做工精细。她的皮肤白皙冷色调，光滑如瓷，与肌肤形成鲜明对比，宛如仙境。她身着时尚前卫的“甜美酷炫”服饰，灵感源自韩国INS风格的审美，面料纹理清晰可见，配饰上的亮点也巧妙地融入其中。这张照片捕捉到了轻松而又时尚的游戏沉浸感，凸显了她独特的视觉魅力和摄影渲染的高保真度。上面大号标题写着“SeedVR2 放大”。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 30, "type": "Text", "properties": {"ver": "495f9773dd3651a366ebac664fc4b0f301e9b1b3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "aux_id": "TFL-TFL/ComfyUI_Text_Translation", "Node name for S&R": "Text"}, "order": 12}, {"mode": 0, "outputs": [{"name": "image", "links": [88, 91, 93], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [312.0601501464844, 195], "pos": [-1263.2659912109375, -48.0828857421875], "widgets_values": ["seedvr2_ema_3b-Q3_K_M.gguf", 495103223, "randomize", 1072, 1], "inputs": [{"name": "images", "link": 44, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "block_swap_config", "link": 45, "label": "block_swap_config", "type": "block_swap_config", "localized_name": "block_swap_config"}, {"shape": 7, "name": "extra_args", "link": 46, "label": "extra_args", "type": "extra_args", "localized_name": "extra_args"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "new_resolution"}, "name": "new_resolution", "label": "new_resolution", "type": "INT", "localized_name": "new_resolution"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 40, "type": "SeedVR