33251953125, 308.644775390625], "pos": [1964.611328125, 709.9218139648438], "widgets_values": [66026099103798, "randomize", 8, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 312, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 309, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 310, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 173, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 110, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "KSampler", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 16}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [309], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["高空俯视连绵山脉，从最近的山脊到最远的水平线，所有山坡均被未经破坏的原始森林完全覆盖。植被呈现自然演替的多样性：山谷底部为深绿色热带雨林，向上过渡为翠绿阔叶林，山脊附近点缀浅绿竹林与暗色针叶林，树冠层紧密无缝隙，形成一块随着山势起伏的巨大绿色绒毯。\n\n光线来自左侧后方，太阳位于地平线上方约25度，属于清晨黄金时段末尾。阳光以低角度斜射，在山坡上拉出细长的几何阴影，树冠的凹凸起伏通过明暗对比清晰可辨。部分区域有薄云飘过，产生柔和的漫射光斑，避免画面过于生硬。空气中存在轻微的大气雾霭，使远处山峰呈现出自然的蓝灰色调，符合雷利散射原理。\n\n拍摄参数：使用富士GFX100 II中画幅机身，搭配GF 23mm f/4 R LM WR超广角镜头，焦距等效全画幅18mm。光圈f/8以实现最佳衍射极限与景深平衡，快门速度1/125秒，ISO 100。镜头前加装偏振镜消除树叶反光，增强绿色饱和度而不失自然。机位悬停于海拔600米，采用无人机搭载，三轴云台确保绝对水平。\n\n后期处理模仿柯达Ektar 100胶片风格：色彩饱和度略高于中性但不过火，红色通道略微偏移以增加暖意，绿色通道保留真实感。轻微增加中间对比度，高光与阴影各压缩5%以避免死白死黑。添加极细微的胶片颗粒（强度2%，大小0.5像素）以消除数码平滑感。保留完整的镜头暗角（约0.5EV）以增强中心引导力。\n\n细节层面：每一棵树的树冠轮廓分明，不同树种之间的叶片纹理、枝干走向均可辨识。部分山坡上可见野生动物踩出的小径（非人为痕迹），一条未受污染的溪流在山谷中反射天空光。没有任何人造物——房屋、道路、电线、烟雾、飞机轨迹。\n\n整体观感：仿佛国家地理杂志的封面作品，令人屏息的自然之美，绝对真实可信。"], "inputs": [{"name": "clip", "link": 164, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [432.5005187988281, 181.6929168701172], "pos": [643.67529296875, 858.2557373046875], "id": 111, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}, {"mode": 0, "outputs": [{"name": "CLIP", "slot_index": 0, "links": [164, 165], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [330, 110], "pos": [209.6045684814453, 852.9782104492188], "widgets_values": ["qwen_2.5_vl_7b_fp8_scaled.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 104, "type": "CLIPLoader", "properties": {