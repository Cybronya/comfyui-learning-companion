形轮廓辨识度高，视觉冲击力强，风格优雅高级。"], "inputs": [{"widget": {"name": "Text"}, "name": "Text", "label": "Text", "type": "STRING", "localized_name": "Text"}], "flags": {}, "type": "DF_Text_Box", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [455.5971984863281, 477.42303466796875], "pos": [310, 0], "id": 488, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "DF_Text_Box"}, "order": 6}, {"outputs": [{"name": "generated_text", "links": [710, 739], "label": "generated_text", "type": "STRING", "localized_name": "generated_text"}], "color": "#232", "widgets_values": ["", 1024, "on", 0.7, 64, 0.95, 0.05, 1.05, 666, 0, false, false, "auto"], "inputs": [{"name": "clip", "link": 703, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"shape": 7, "name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 737, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "max_length"}, "name": "max_length", "label": "max_length", "type": "INT", "localized_name": "max_length"}, {"widget": {"name": "sampling_mode"}, "name": "sampling_mode", "label": "sampling_mode", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "Sampling Mode"}, {"widget": {"name": "sampling_mode.temperature"}, "name": "sampling_mode.temperature", "label": "sampling_mode.temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "sampling_mode.top_k"}, "name": "sampling_mode.top_k", "label": "sampling_mode.top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "sampling_mode.top_p"}, "name": "sampling_mode.top_p", "label": "sampling_mode.top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "sampling_mode.min_p"}, "name": "sampling_mode.min_p", "