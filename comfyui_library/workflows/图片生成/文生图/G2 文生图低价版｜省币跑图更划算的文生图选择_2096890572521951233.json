{"last_link_id": 43, "nodes": [{"outputs": [{"name": "image", "links": [1], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#323", "widgets_values": ["杰作，极具东方韵味的绝世美女超写实肖像，身材纤细且空灵，中国仙侠幻想的化身，高级时尚电影感。\n细腻的皮肤，白里透红的自然通透感，富有生机的健康肤色，半透明陶瓷肌，深邃且动人的眼神交流，打破第四面墙，目光深邃地直视镜头。\n精致飘逸的丝绸汉服长袍，基调为银色与淡蓝色，但层叠的半透明面料中透出丰富的色彩层次，精美的多色刺绣细节，传统的华丽玉石发饰，闪烁的丝绸质感。\n雄伟的迷雾山脉背景，霜雪覆盖的山峰，冷冽且空灵的氛围，浓雾，亚零度气温的视觉线索，宏大的电影比例。\n动态透视，她裸露的手优雅地伸向相机，手指几乎触及镜头，深景深，极致的前景虚化，亲密的互动感。\n\n成群闪烁的银色灵蝶（中心点缀着温暖的琥珀色光芒），漂浮的带有微弱暖色调中心的水晶花瓣，波光粼粼的白色微粒中夹杂着梦幻的金色火花，魔法光辉，超凡脱俗的气场。\n\n电影感冷色调照明，整体呈现冷色调氛围，但伴有细腻的暖色点缀对比，8k 分辨率，光线追踪，次表面散射（SSS）效果展现皮肤质感，眼睛焦点锐利，柔和的弥散月光，专业色彩分级。", "16:9", false, 487171292, "randomize", "4k"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 3, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}], "flags": {}, "type": "RH_RhartImageG2TextToImage", "mode": 0, "bgcolor": "#535", "size": [450.9155578613281, 377.1516418457031], "pos": [874.8400268554688, 0], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2TextToImage"}, "order": 9}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRI