-563.5065307617188], "widgets_values": ["d04214bfe9825c1c240013d3e03082046b36a62af8cf4f751f9bb1b92eb6a8bc.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 95, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}, {"mode": 0, "outputs": [], "size": [417.4571838378906, 337.40869140625], "pos": [-949.9642333984375, 480.1161193847656], "widgets_values": [], "inputs": [{"name": "source", "link": 13, "label": "source", "type": "*", "localized_name": "源"}], "flags": {}, "id": 15, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 42}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [4], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314.0000305175781], "pos": [-478.71173095703125, 965.3984985351562], "widgets_values": ["242a22a30169115f37fbf8dc11de37dda9b185537c2831126f9ca83f2474418b.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 2, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"mode": 0, "outputs": [{"shape": 6, "name": "文本", "links": [101], "label": "文本", "type": "STRING", "localized_name": "文本"}], "size": [400.74072265625, 498.0096740722656], "pos": [-156.3561553955078, 782.7080688476562], "widgets_values": ["其中皇上的参考图为参考图1，小雷的参考图为参考图2，汽车的参考图为参考图3。 请根据以下镜头脚本绘制6宫格分镜图，每张分镜图的比例一样。工复古纸张，中式工笔画，手绘线稿风格，不要生成字幕。\n \n\n\n| 镜头编号 | 画面内容（人物、环境、动作细节） | 运镜方式 | 景别 | 情绪氛围 | 时长估算 |\n| :--- | :--- | :--- | :--- | :--- | :--- |\n| **01** | **【环境与出场】**<br>唐代宫殿白玉阶前，一辆亮黄色的跑车（参考图3：SU7 Ultra）伴随烟尘急停在青砖地面上。车头两条龙形拉花极为醒目。背景两侧，四名穿铠甲的唐朝禁军双手端起长戟，身体后仰，呈现防备姿态。 | **摇摄+急停**<br>镜头跟随跑车从右向左快速摇摄，跑车刹停时镜头急停。 | 全景 | 紧张/突兀 | 3秒 |\n| **02** | **【主角亮相】**<br>跑车车门推开。一只穿着黑色现代皮鞋的脚踏上古代青砖。随后，小雷（参考图2：身穿深蓝色西装，打领带，发型利落）迈出车厢，站直身体，右手单手扣上西装外套的中间一颗纽扣，左手自然下垂，面带微笑看向画面右侧（画外）。 | **向上推镜头**<br>从皮鞋触地开始，镜头沿人物身体匀速上推，定格在小雷微笑的面部。 | 中景 | 自信/从容 | 4秒 |\n| **03** | **【献礼互动】**<br>画面左侧为小雷，右侧台阶上方站着皇上（参考图1：头戴十二旒冕冠，身穿黄色双龙腾云袍）。小雷身体微躬，右手五指并拢，掌心朝上，向停在两人中间的黄色跑车做出“请看”的引导手势。皇上双手交叠拢在宽大袖口中，目光俯视看向跑车。 | **移镜头**<br>镜头从两人侧面平行缓慢平移，展现人物身高差与空间位置关系。 | 中远景 | 庄重/跨时空 | 4秒 |\n| **04** | **【皇帝探查】**<br>皇上弯下腰，脸部凑近跑车引擎盖。他头顶冕冠边缘的彩色珠串自然垂下，几乎贴到车漆。他伸出右手，用食指指腹小心翼翼地顺着车前盖上“SU7 Ultra”车牌上方的龙形拉花纹路滑动触摸。 | **微推**<br>镜头缓慢向皇上触摸车身的手指和面部推进。 | 特写 | 好奇/专注 | 3秒 |\n| **05** | **【科技震撼】**<br>小雷在画面边缘单手按下黑色车钥匙。跑车前大灯瞬间亮起高光，车门发出“咔哒”解锁声。皇上受惊，身体猛地向后仰去，双手瞬间抓住腰间的玉带，眼睛瞪大，下巴的长须被动作带得飞起。 | **拉镜头**<br>伴随车灯亮起，镜头快速后拉，展现皇上后退的肢体反应。 | 近景 | 惊愕/戏剧性 | 3秒 |\n| **06** | **【圆满结局】**<br>皇上端坐在跑车驾驶座上，双手紧紧握住方向盘，头顶的冕冠微微抵着车顶。皇上面部呈现大笑的表情（参考图1右上角大笑表情）。小雷站在降下的车窗外，左手插在西裤口袋里，右手对着驾驶座上的皇上竖起大拇指。 | **固定镜头**<br>机位固定在车窗侧斜方，画面平稳，留出人物表情展示时间。 | 中景 | 欢乐/融洽 | 4秒 |\n\n---\n### 【画师绘制Tips（附加建议）】\n1.  **材质对比**：在“复古纸张/工笔画”的统一风格下，小雷的西装强调笔挺的直线条，皇上的龙袍使用繁复的曲线白描，跑车的金属反光可用高光留白来体现，增强视觉冲击力。\n2.  **元素扣题**：一定要在第4镜清晰画出参考图3中的“车头龙形拉花”，这是将现代汽车与古代皇帝建立合理联系（龙图腾）的核心视觉锚点。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {}, "id": 67, "type": "MuyeTextEditOutput", "title": "系统提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MuyeTextEditOutput"}, "order": 12}, {"mode": 0, "outputs": [{"name": "video", "links": [99], "label": "video", "type": "VIDEO", "localized_name": "video"}, {"name": "video_url", "links": [], "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "response", "links": [], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "pid", "label": "pid", "type": "SORA_P