, 180.6060791015625], "pos": [-4268.24462890625, 1280.755615234375], "id": 943, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 6}, {"mode": 0, "outputs": [{"name": "text", "links": [1551], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [429.6101379394531, 290.1177978515625], "pos": [-4268.859375, 693.9960327148438], "widgets_values": ["主体为以复古中国古代符纸为原型,米黄色底色,外围有繁复绿纹边框,\n穿着古代服装的拟人化猫咪,威风凛凛,威武壮观,\n夸张的线条,夸张的姿态,写实水墨风,\n手持方天画戟,头戴黑色细长凤翅紫金冠，身穿锁子黄金甲,藕丝步云履，\n前卫,艺术,非常规构图,冲击力,\n张力,情绪,释放,创新,写实术,非常规构图,冲击力,张力,情绪,释影,写实水墨电影感。\n中央用粗犷黑笔类似篆体写着“吕布飞猫”,\n顶部和底部有重复英文'Flying Cat Wealthy Every Day\",中间‘CAT LUCK',\n两侧竖排英文'LEAP INTOFORTUNE',\n周遭簇拥竖排小字,底部有英文'Toward a better tomorrow'\n与金色篆刻印章的画面,国潮中国符第场景,\n复古花纹、书法狂草、篆刻印章与英文标语碰撞修饰,\n纸张边缘粗糙磨损,纸张纹理,红色印章突出清晰"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 942, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "workspace_info": {"id": "5_2X6MKs8Ov5j605T5qA3"}, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "VHS_latentpreview": false, "frontendVersion": "1.23.0", "node_versions": {"was-node-suite-comfyui": "3ed45af34a14551dc28cb3127235cc7197d4633f", "ComfyUI_UltimateSDUpscale": "ff3fdfeee03de46d4462211cffd165d27155e858", "comfyui-mixlab-nodes": "b2bb1876def6330fccf1e03cc69d2166cae7bedb", "ComfyUI-Qwen": "1642b9d7d6e57f5bc562b25c99f705d218925b4d", "ComfyUI_Custom_Nodes_AlekPet": "42d420b8854d4cf4aeed3408c10365ffc36b07d8", "comfy-core": "0.3.14", "ComfyUI_essentials": "33ff89fd354d8ec3ab6affb605a79a931b445d99", "ComfyUI-Custom-Scri