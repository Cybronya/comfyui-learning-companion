最高可以设为4K，也就是800万像素\n\n## 模型放置路径\n\n```\n📂 ComfyUI/\n├── 📂 models/\n│   ├── 📂 diffusion_models/\n│   │   └── krea2_turbo_fp8_scaled.safetensors\n│   └── 📂 clip/\n│   │  └── qwen3vl_8b_fp8_scaled.safetensors\n│   └── 📂 vae/\n│       └── qwen_image_vae.safetensors\n│   └── 📂 lora/\n│       └── krea2_warmpastel.safetensors\n```\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "模型下载", "mode": 0, "bgcolor": "#000", "size": [740, 710], "pos": [-3760, -190], "id": 81, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}}, "order": 4}, {"outputs": [{"name": "width", "links": [82], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [83], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#232", "widgets_values": ["2:3 (Portrait Photo)", 1.2000000000000002, 8], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {"collapsed": false}, "type": "ResolutionSelector", "title": "分辨率选择", "mode": 0, "bgcolor": "#353", "size": [390, 130], "pos": [-2970, 90], "id": 74, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.23.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.6"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ResolutionSelector", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 5}, {"mode": 4, "outputs": [{"name": "llama_model", "links": [121], "label": "llama_model", "type": "LLAMACPPMODEL", "localized_na