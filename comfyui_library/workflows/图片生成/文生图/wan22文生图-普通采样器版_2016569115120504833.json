ed_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "groupNodes": {"提示词生成": {"external": [[2, 0, "STRING"]], "nodes": [{"outputs": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "widgets_values": ["【简单描述】：“XXX”\n根据上面的【简单描述】润色并扩写，形成画面的描述，生成符合以下【结构公式】的、用于AI文生图的详细提示词。要求画面中包含以上关键词体现的内容或元素，用自然语言描述并输出，语言要生动，输出语言为中文，可以补充画面的细节及场景元素，输出文字在300字以内。\n【结构公式】：\n【主体描述】+【场景描述】+【光影描述】+【技术渲染】。\n【主体描述】：\n要求根据【简单描述】补充、润色并扩写，详细描述画面主体的主要特征及摄影镜头的，如镜头距离，主体占画面的比例位置，人物相貌，服装特征，饰品特征，使用的道具，动态动作的描述及其他特征细节。\n【场景描述】：\n要求根据【简单描述】补充、润色并扩写，详细描述画面场景主要特征，如空间类型，环境类型，室内还是室外，天气，时间，环境物品景物，空间细节等。\n【光影描述】：\n要求根据【简单描述】补充、润色并扩写，详细描述画面光影主要特征，如柔和光线，强光，阴影，丁达尔，逆光，画面色调，暖光或冷光等。\n【技术渲染】：\n要求根据【简单描述】补充画面生成的技术要求，无特别提示词要求下默认风格为照片写实风格，补充画面生成的风格及质量提示词：如8K,最高质量，大师摄影，景深等。\n输出时参考以下【实例】输出：\n【实例】\n画面中心是一位身穿民国旗袍的中国女孩的半身肖像，展现出她的优雅身姿和曼妙曲线。她身穿淡绿色旗袍剪裁合体，线条流畅，展现出她修长的身材和优美的曲线。她的头发简单地挽成一个发髻，几缕碎发轻轻垂落在额前，增添了几分柔美。女孩一只手拿着书另一只手优雅地拖住脸颊，看向窗外。\n\n女孩深处一个中式古典的书房中，精美的雕花窗外雨水淅沥，，散发出湿润的气息。窗外是绿意盎然庭院美景，远处可见几株古树在雨中摇曳。\n画面呈现出阴郁的冷色调，光线透过雨帘洒落，形成柔和而富有层次的光影效果。阴影部分略显深沉，但并不压抑，反而增添了画面的深度和立体感。整个画面笼罩在一种淡淡的忧郁氛围中，仿佛在讲述一段古老而凄美的故事。\n\n画面采用写实风格，追求极致的细节表现和真实的质感。画面具有8K的高清画质，细节清晰细腻，色彩真实而富有层次感。整体风格如同大师级摄影作品，展现出极高的艺术表现力和视觉冲击力。\n\n\n\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "index": 0, "type": "Text Multiline", "title": "提示词生成", "mode": 4, "size": [340.09844970703125, 331.7489013671875], "pos": [-1096.152099609375, 7.4292378425598145], "id": -1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 26}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "widgets_values": ["XXX", ""], "inputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "find"}, "name": "find", "label": "find", "type": "STRING", "localized_name": "find"}, {"widget": {"name": "replace"}, "name": "replace",