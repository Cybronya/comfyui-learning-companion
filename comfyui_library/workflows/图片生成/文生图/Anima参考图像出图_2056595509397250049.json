": 7, "name": "string3", "label": "string3", "type": "STRING", "localized_name": "string3"}, {"widget": {"name": "string4"}, "shape": 7, "name": "string4", "link": 9, "label": "string4", "type": "STRING", "localized_name": "string4"}, {"widget": {"name": "string5"}, "shape": 7, "name": "string5", "label": "string5", "type": "STRING", "localized_name": "string5"}, {"widget": {"name": "auto_add_commas"}, "shape": 7, "name": "auto_add_commas", "label": "auto_add_commas", "type": "COMBO", "localized_name": "auto_add_commas"}, {"widget": {"name": "remove_newlines"}, "shape": 7, "name": "remove_newlines", "label": "remove_newlines", "type": "COMBO", "localized_name": "remove_newlines"}], "flags": {}, "id": 5, "type": "PIP_StringConcatenation", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PIP_StringConcatenation"}, "order": 11}, {"mode": 0, "outputs": [{"name": "string", "links": [33], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [270, 58], "pos": [1181.4163818359375, -105.4461441040039], "widgets_values": ["@chigusa_minori,"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 28, "type": "easy string", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy string"}, "order": 6}, {"mode": 0, "outputs": [{"name": "string", "links": [32], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [552.7317504882812, 59.713523864746094], "pos": [1179.5264892578125, -213.07772827148438], "widgets_values": ["year 2025, newest, normal quality, score_8, score_9, highres, safe, "], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 27, "type": "easy string", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy string"}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["## Workflows\n\n- 目标: 从视觉特征中提取关键指纹，并在【Artist Database】中检索出最匹配的 1-3 位画师标签。\n- 步骤 1: 解析输入图像或描述中的笔触形态、上色逻辑及氛围基调，提取核心风格指纹。\n- 步骤 2: 将提取的风格指纹与【Artist Database】中的艺术家档案进行多维度的相似度计算与比对。\n- 步骤 3: 筛选出匹配度最高的前 1-3 位画师，并转换为标准标签格式（如 `@name`）。\n- 预期结果: 直接输出一行标准格式的画师标签，不包含任何分析过程或解释性文字。\n\nArtist Database (扩展画师库)\n以下画师经测试在 Anima/Pony 架构下表现优异，已按风格细分：\nA. Clean / Moe / Slice of Life (清新/萌系/日常)\n适用：JK制服、日常互动、明亮色彩、高光皮肤、可爱画风\n@kantoku: (监督) 格子控，色彩极度清新，光影通透，高光细腻，适合校园题材。\n@anmi: 像果冻一样的透明质感，线条极其柔软，富有动感的可爱姿态。\n@hiten: 温柔的日常光影，极其细腻的头发描绘，知性美，高精度插画。\n@coffee_kizoku: (珈琲贵族) 经典的日系画风，擅长描绘黑长直、女仆装，光影正统。\n@40hara: (嫌弃脸作者) 色彩鲜艳且日常，擅长猫耳娘和生活化场景。\n@shiratamaco: (白玉) 极度软萌，Q弹的脸颊，类似麻薯的质感，治愈系。\n@tiv: 唯美的情感流露，色彩柔和，擅长描绘少女的细腻情绪和微风感。\n@misaki_kurehito: (深崎暮人) 《路人女主》画师，高饱和度，高光油亮，极具质感的丝袜与衣物折痕。\n@tsunako: (海王星系列) 极其精致的萌系五官，发饰繁复，色彩鲜亮，典型二次元美少女。\n@fly_co: 极其细腻的背景与人物融合，色彩清新淡雅，很有空气感。\n@cogecha: 擅长描绘现代时尚少女，色彩活泼，线条轻快。\nB. Scenery / Background / Atmospheric (大场景/背景/氛围)\n适用：人小景大、魔法场景、宏大构图、壁纸级画面\n@arsenixc: 背景狂魔，极致的城市与自然细节，新海诚风格，空气感强。\n@fuzichoco: (藤原) 色彩极度华丽，传统和服与奇幻建筑结合，广角，细节爆炸，高饱和彩虹色。\n@mocha: 广阔的蓝天与云海，超大广角，宁静的空气感，适合天空场景。\n@yuumei: 极具情感张力的环境光，半写实风格，故事感强，光影戏剧化，赛博与自然结合。\n@demizu_posuka: 《约定的梦幻岛》画师，极度复杂的构图，鱼眼镜头，机械与奇幻结合。\n@rella: 梦幻般的光影，擅长初音未来，光粒子效果，透明感与色彩斑斓。\n@makoto_shinkai: (新海诚) 极致的天空、云层、光晕，电影级的高清晰度背景。\n@rolua: 极度细腻的光影渲染，画面带有忧郁或梦幻的电影质感，细节丰富。\n@imperial_boy: (帝国少年) 极其复杂的城市建筑结构，蒸汽朋克，细节密度极高。\nC. Painterly / Semi-Realism / Epic (厚涂/半写实/史诗)\n适用：奇幻战斗、油画质感、成熟女性、电影级光影、游戏CG\n@wlop: 史诗感，强烈的侧光，金属质感，骑士与公主，模糊背景突出人物。\n@guweiz: 暗调，冷酷女性，电影镜头感，高对比度，擅长雨天和夜景。\n@swav: 现代战术风，块面感强，时尚与军事结合，几何感，干练。\n@krenz: (K大) 极强的透视与块面概括，色彩扎实，学院派光影，动态感强。\n@shal.e: 极度精致的半写实面部，破碎感，赛博/奇幻风格，眼神迷离，类似BJD娃娃。\n@ask: 古典主义，花卉纹理，柔和的油画感，优雅，平面设计感。\n@nixeu: 极度精致的玩偶感面部，发光的皮肤质感，华丽的金属与饰品细节（Anima 强效）。\n@artgerm: 美漫封面级半写实，极致的人体结构，极其干净的厚涂风格。\n@sakimichan: 欧美3D质感厚涂，极其夸张的身材比例，高光油腻感，强烈的动态。\n@ghostblade: (鬼刀风格，通常关联WLOP) 但可作为独立风格词，强调沧桑与华丽并存。\n@koda_kazuma: 《尼尔》系列概念设计，史诗般的废墟感，灰阶丰富，厚重。\nD. Pop / Stylized / High Voltage (潮流/设计感/高饱和)\n适用：时尚穿搭、视觉冲击、色彩爆炸、专辑封面\n@mika_pikazo: 极高饱和度，色彩对撞，活力四射，几何图形装饰，VTuber 辉夜月设计者。\n@lam: 极具攻击性的帅气，瞳孔特写，强烈的对比色，棱角分明。\n@redjuice: 金属质感，科技光效，赛博朋克，精细的机械设定，Guilty Crown 风格。\n@yoneyama_mai: (米山舞) 霓虹光效，动态模糊，极高的细节密度，现代潮流，商业插画，线条极其锋利。\n@tarou2: 运动感，结实的身体线条，透视夸张，美式日系融合，扳机社风格。\n@vofan: \"光之魔术师\"，独特的色彩光影，鲜艳且带有透明感，物语系列风格。\n@acky_bright: 黑白线稿为主，通过局部高饱和上色，极为复杂的涂鸦/漫画风格。\n@kuroboshi_kouhaku: (黑星红白) 极其干净的线条，淡雅的水彩感上色，FGO/奇诺之旅画师。\nE. Dark / Sci-Fi / Melancholy (暗黑/科幻/忧郁)\n适用：机械、赛博朋克、冷淡风、孤独感、废土\n@neco: 机械义肢，冷灰色调，战术装备，高冷少女，无机质感，重兵装型女高中生。\n@ogipote: 颓废感，生活中的小确丧，凌乱的线条，独特的情绪氛围。\n@mashiro_kta: 混沌，暗黑，素描/涂鸦质感，极具张力，崩坏感。\n@tokyo_genso: (东京幻想) 描绘被植物覆盖的废弃现代都市，末世感与宁静感并存。\n@huke: 粗颗粒纹理，标志性的黑眼圈与发光眼，Black Rock Shooter 风格，阴郁厚重。\n@abara: (类似二瓶勉) 极繁复的建筑结构，黑白高对比，生物机械恐怖感。\n@wataboku: 数码故障艺术结合日系校服，忧郁，独特的纹理质感。\nF. Game Art / Concept Design (游戏美术/概念设计)\n适用：角色立绘、复杂服装设计、RPG风格\n@hyung-tae_kim: (金亨泰) 《剑灵/妮姬》画师，极其强调大腿与盆骨的肉感，油亮的皮肤，独特的解剖结构。\n@so-bin: 《Overlord》画师，笔触狂野的厚涂，暗黑奇幻，强烈的色彩光晕。\n@akihiko_yoshida: (吉田明彦) 《尼尔/FF14》画师，淡雅的铅笔素描质感，古典且精致。\n@lack: 极高的完成度，色彩鲜艳且扎实，FGO/TCG卡牌风格，光影极其标准。\n@magota: 极其华丽的背景与人物互动，色彩浓郁，幻想童话风格。\nG. Retro / 90s Aesthetic (复古/90年代风)\n适用：赛璐璐风格、怀旧动画、蒸汽波\n@haruhiko_mikimoto: (美树本晴彦) 80/90年代经典风格，柔和的线条，复古的瞳孔画法，超时空要塞风。\n@yoshiyuki_sadamoto: (贞本义行) 《EVA》画师，极简而有力的线条，经典的90年代人设风格。\n@rumiko_takahashi: (高桥留美子) 经典复古漫改风，独特的五官比例。\nH. Western Digital / Comic (西式数码/美漫)\n适用：Anima 模型因包含 LAION-POP 数据，对此类风格兼容性较好\n@rossdraws: 极其鲜艳的色彩，高光强烈的半写实风格，迪士尼与日系结合。\n@samdoesarts: 独特的卡通半写实，标志性的高光点，柔和的数码笔触。\n@ilya_kuvshinov: 极简的色彩，电影感的打光，现代时尚女性，眼神极具穿透力。"], "inputs": [], "flags": {}, "type": "Note", "title": "Qwen3.5 0..8 提示词参考", "mode": 4, "bgcolor": "#653", "size": [492.13140869140625, 624.0725708007812], "pos": [377.4198303222656, -710.8837280273438], "id": 32, "properties": {"widget_ue_connectable": {}}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1601.40335422092, 1452.1807759602864], "scale": 0.45}}, "groups": [], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 3, 0, 1, 1, "FL2MODEL"], [7, 6, 0, 7, 0, "MODEL"], [8, 8, 0, 7, 1, "CONDITIONING"], [9, 1, 2, 5, 3, "STRING"], [10, 5, 0, 4, 0, "*"], [11, 4, 0, 8, 1, "STRING"], [12, 9, 0, 8, 0, "CLIP"], [13, 9, 0, 10, 0, "CLIP"], [14, 10, 0, 7, 2, "CONDITIONING"], [16, 12, 0, 7, 3, "LATENT"], [17, 7, 0, 13, 0, "LATENT"], [18, 14, 0, 13, 1, "VAE"], [20, 13, 0, 16, 0, "IMAGE"], [32, 27, 0, 5, 0, "STRING"], [33, 28, 0, 5, 1, "STRING"]], "id": "53e92ed8-e206-4dd1-ab6f-8cd3cf40823b", "config": {}, "version": 0.4, "last_node_id": 32, "revision": 0}