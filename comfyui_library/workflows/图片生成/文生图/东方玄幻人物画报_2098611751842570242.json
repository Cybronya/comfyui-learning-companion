dgets_values": [1075182545889289, "randomize", 8, 1, "res_2s", "bong_tangent", 1], "inputs": [{"name": "model", "link": 99, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 100, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 111, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 207, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "link": 119, "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 69, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "ver": "0.13.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "Node name for S&R": "KSampler"}, "order": 16}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [26, 100, 187], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["画面风格\n摄影级东方玄幻人物画报，一位材质真实、五官可信的成年中国荷花仙子悬浮于深色非物理虚空。人物真实，空间超现实；华丽极繁的服饰与冠饰精密堆叠，整体情绪宁静、疏离、含蓄，带梦境般的非现实秩序感。\n\n核心元素\n人物身份为荷花仙子；核心发光物是一枚半开的粉白荷苞，悬停于她掌心上方；前景巨物是一片从画面下侧切入的半透明巨型荷瓣，遮挡衣袍下摆；肩后大型元素是一枝偏离画面中心的银色莲蓬枝影；主题母题为荷花的瓣、脉络、莲蓬、藕丝与冷香。\n\n具体内容\n她是一位年轻成年中国女性仙灵，真实东方五官，瓷白肌肤带自然血色和细微纹理，古典黑发挽成高髻，冠饰以银、珍珠与淡金为主，轮廓清晰，不堆叠过多材质。汉服为华丽多层，内层珍珠白丝绸，外层青瓷色薄纱与深玉绿刺绣，纹样取荷瓣脉络、藕丝与莲蓬孔洞。她的主要动作是侧身回望，一只手以指尖轻触悬停的荷苞，另一只手安静拢起一侧衣袖，视线落在荷苞上，情绪为宁静专注。\n\n玄幻空间\n深色非物理虚空，无可见地面、无物理地板、无基座、无真实地平线。远处只有少量悬浮的冷香粒子、暗色雾团和渐远的莲影。现实荷塘被完全排除，不出现水面、泥沼、真实花园或植物图鉴感。衣袍末端被前景巨荷瓣遮挡，其余部分消融进黑暗、薄雾与粒子。\n\n构图与尺度\n9:16 竖幅，人物占画面约三分之二，面部位于中上部，半身至七分身构图。前景巨荷瓣接近躯干大小，从下侧切入并遮挡下摆；中景为人物、荷苞与指尖互动；背景为肩后银色莲蓬枝影、远处薄雾与少量主题粒子。人物、前景巨荷瓣与肩后莲蓬枝影形成不对称三角关系，面部周围和视线方向保留深色空间。\n\n动态设计\n只有一个主要动作：侧身回望并以指尖轻触荷苞。统一气流从左下向右上，袖摆、飘带、发丝、薄雾和粒子都沿同一方向轻微运动。人物动作幅度低，环境动势承担画面的流动感。\n\n光影效果\n主光来自掌心荷苞，明确照亮面部、互动指尖和衣袍内褶。反侧用青瓷色环境光塑形，轮廓光为克制的暖银，分离发丝、肩线、冠饰与刺绣。只有荷苞和少量粒子强烈发光，前景巨荷瓣与肩后莲蓬枝影大部分区域保持深暗、厚重、雕塑感。\n\n色彩基调\n主色为珍珠白、青瓷色、深玉绿、银色、近黑；强调色为柔粉。珍珠白用于内层衣料，青瓷色用于外袍，深玉绿用于暗部刺绣，银色用于冷光边缘与冠饰，近黑承担虚空与暗部，柔粉只用于核心荷苞发光。\n\n相机参数与画质\n9:16 竖幅，85mm 中长焦人像感，半身至七分身，浅景深但保留前中后层次。真实东方五官，真实皮肤，精细丝绸与宝石纹理，分层电影光，高对比，摄影级完成度。不堆叠 8K、HDR、超锐化、微距毛孔等互相争抢的词。\n\n负向约束\n无可见地面，无物理地板，无基座，无真实地平线，无站立落地感，无僵硬正面摆拍，无对称托举，无畸形手指，无重复肢体，无多人，无动漫脸，无游戏 CG 感，无文字，无水印，无真实荷塘，无可见水面，无植物图鉴感。"], "inputs": [{"name": "clip", "link": 200, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [610, 330], "pos": [-7828.00439453125, 459.5577087402344], "id": 30, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 12}, {"outputs": [{"name": "MODEL", "links": [202], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}, {"name": "CLIP", "links": [200, 201], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}, {"name": "VAE"