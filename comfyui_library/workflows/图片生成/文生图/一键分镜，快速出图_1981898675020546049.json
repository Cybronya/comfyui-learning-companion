ene: 手持感镜头，镜头轻微晃动，跟随小马的步伐，展现它小心翼翼地靠近河边，画面充满真实感，背景中的鸟鸣和流水声增强沉浸感。", "Next Scene: 特写镜头，聚焦小马的脚，踩在河边的石头上，水面溅起轻微的波纹，石头的颜色和质感清晰可见，展现自然的细腻与真实。", "Next Scene: 侧移镜头，从河流沿岸移动拍摄，小马的身影逐渐进入画面，河水的流动声与树叶的沙沙声交织，画面充满动态感与空间层次。"], "inputs": [{"shape": 7, "name": "anything", "link": 3064, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#353", "size": [367.10552978515625, 682], "pos": [-635.5446166992188, 204.1346435546875], "id": 99, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 18}, {"outputs": [], "color": "#223", "widgets_values": [], "inputs": [{"name": "images", "link": 9614, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {"collapsed": false}, "type": "PreviewImage", "mode": 0, "bgcolor": "#335", "size": [1198.3079833984375, 725.3043823242188], "pos": [581.0311889648438, -159.46942138671875], "id": 134, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 22}, {"outputs": [{"name": "IMAGE", "links": [2000, 2636], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#232", "widgets_values": ["0830bf5e73d30566108f206ae4ac75aa52cd66804f9e560046f0ad9911f8fb14.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#353", "size": [345.7674865722656, 583.1331176757812], "pos": [-2136.239501953125, -161.74200439453125], "id": 74, "properties": {"cnr_id": "comfy-core", "ver": "0.3.64", "ue_properties": {"widget_ue_connectable": {"image": true, "upload": true}, "version": "7.0.1"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 4}, {"outputs": [], "colo