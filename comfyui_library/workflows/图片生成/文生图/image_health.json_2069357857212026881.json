se"}], "size": [426.3872985839844, 412], "pos": [2191.2421875, 751.9895629882812], "widgets_values": ["", 358244390, "fixed", "9:16", "2k", false, "Third-party"], "inputs": [{"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 5, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "link": 7, "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}], "flags": {}, "id": 6, "type": "RH_Nano_Banana2_Gemini31Flash", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Gemini31Flash"}, "order": 6}, {"mode": 0, "outputs": [{"name": "text", "links": [4], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [423.0274963378906, 606.4130249023438], "pos": [1707.00390625, 715.3969116210938], "widgets_values": ["一张竖版健康管理信息图，健康作息计划表模板，清新专业医疗风格，整体为天蓝色到浅蓝白色的柔和渐变背景，干净通透，无纹理，无水印，无logo。主色天蓝+白+浅绿，边上是圆角卡片，层次分三区，中文清晰可读，无水印。整体的设计高级，简约，有层次。\n\n【严格固定三区比例，不可改变】\n顶部区域占画面高度10%：\n- 上半部分居中：超大号白色粗黑体主标题文字「[主标题]」\n- 下半部分：一个白色超大圆角矩形卡片，左侧黑色文字\"异常状态：\"，右侧横向排列4个等大的浅橙色圆角标签，标签内白色文字依次为[异常状态1]、[异常状态2]、[异常状态3]、[异常状态4]\n\n中部区域占画面高度75%：\n- 一个更大的白色超大圆角矩形卡片，内部竖向等距排列5个步骤模块\n- 每个步骤统一结构：左侧浅绿色圆角插画框（自动生成对应食物/动作扁平化插画）+ 右侧蓝色圆形数字序号 + 如有时间添加（蓝色粗体时间标题），如没有时间则不添加（蓝色粗体时间标题） + 黑色粗体内容 + 浅灰色小字说明\n- 每个步骤下方居中：蓝色向下虚线箭头，连接下一个步骤\n\n底部区域占画面高度15%：\n- 浅蓝色圆角矩形提示栏，内部居中两行文字：上方黑色粗体\"按顺序完成今日计划\"，下方浅灰色\"展开查看每餐详细做法与克数\"\n- 右下角：圆头圆脑蓝色卡通吉祥物，胸口带白色爱心\n\n\n【限制内容】\n禁止出现：[主标题][异常状态列表][全天健康规划]这几个字。文字内容禁止模糊、乱码"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 4, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-553.4945254984859, -350.6816172206983], "scale": 0.7972024500000009}}, "groups": [], "links": [[1, 2, 0, 1, 0, "STRING"], [2, 5, 0, 1, 1, "STRING"], [3, 3, 0, 1, 2, "STRING"], [4, 4, 0, 1, 3, "STRING"], [5, 1, 0, 6, 10, "STRING"], [6, 6, 0, 7, 0, "IMAGE"], [7, 8, 0, 6, 12, "COMBO"]], "id": "fddf82f3-0175-4eaa-91be-e6413c997203", "config": {}, "version": 0.4, "last_node_id": 9, "revision": 0}