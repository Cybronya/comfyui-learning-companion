844, 82], "color": "rgba(38, 73, 116, 0.7)", "pos": [3750, 740], "widgets_values": [true, true], "inputs": [{"name": "anything", "link": 229, "label": "anything", "type": "*", "localized_name": "anything"}, {"widget": {"name": "purge_cache"}, "name": "purge_cache", "label": "purge_cache", "type": "BOOLEAN", "localized_name": "purge_cache"}, {"widget": {"name": "purge_models"}, "name": "purge_models", "label": "purge_models", "type": "BOOLEAN", "localized_name": "purge_models"}], "flags": {}, "id": 139, "type": "LayerUtility: PurgeVRAM V2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: PurgeVRAM V2"}, "order": 46}, {"outputs": [{"name": "*", "links": [160], "type": "*"}], "color": "#223", "widgets_values": ["Noise IMAGE"], "inputs": [], "flags": {"collapsed": true}, "type": "easy getNode", "title": "⬅️Noise IMAGE", "mode": 0, "size": [210, 60], "pos": [760, 1240], "id": 113, "properties": {"widget_ue_connectable": {}}, "order": 24}, {"outputs": [{"name": "text", "links": [245], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["8K潮流时尚海报，60mm定焦，f/1.8大光圈，高对比光影，胶片颗粒+高街质感；\n主体：22岁年轻亚洲女性，上半身特写（肩颈至胸口），冷白皮，立体轮廓，眼神酷拽直视镜头，哑光雾面正红唇，野生眉+细闪大地色眼影，眼尾贴银色细钻；\n发型：高颅顶柔顺黑长直（发尾微内扣，发丝服帖带冷光光泽，额前少量碎发）；\n穿搭：黑色丝绒V领吊带（领口镶细银边），外搭黑色oversize廓形西装（垫肩挺拔，袖口不对称剪裁），颈间叠戴粗链条+珍珠吊坠项链，耳饰为银色夸张几何耳坠；\n背景：极简暗黑背景，左侧投射玫红色霓虹光带，右侧点缀不规则金属反光片，底部少量烟雾，构图聚焦上半身，留白简洁；\n后期：高饱和色彩，暗部压暗，衣物纹理锐化，皮肤保留轻微颗粒感，边缘加淡红色发光描边；\n核心词：潮流时尚海报，年轻亚洲女性上半身，黑长直发型，高街穿搭，霓虹光影，高级质感"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [470, 360], "pos": [320, 520], "id": 118, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 25}, {"mode": 0, "outputs": [{"name": "dit", "links": [157], "label": "dit", "type": "SEEDVR2_DIT", "localized_na