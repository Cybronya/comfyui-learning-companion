text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 7, "type": "CLIPTextEncode", "title": "负面提示词", "properties": {"cnr_id": "comfy-core", "ver": "0.3.23", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "MODEL", "slot_index": 0, "links": [310], "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "CLIP", "slot_index": 1, "links": [308, 309], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}, {"name": "VAE", "slot_index": 2, "links": [311], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [494.20477294921875, 112.2174072265625], "pos": [-379.15203857421875, 179.550537109375], "widgets_values": ["WAI_NSFW-illustrious-SDXL_v14.safetensors"], "inputs": [{"widget": {"name": "ckpt_name"}, "name": "ckpt_name", "type": "COMBO", "localized_name": "Checkpoint名称"}], "flags": {}, "id": 4, "type": "CheckpointLoaderSimple", "properties": {"cnr_id": "comfy-core", "ver": "0.3.23", "widget_ue_connectable": {"ckpt_name": true}, "Node name for S&R": "CheckpointLoaderSimple"}, "order": 1}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [287], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [430, 300], "pos": [220.80007934570312, 164.46881103515625], "widgets_values": ["masterpiece, best quality,\ngenshin_impact, amber (genshin impact), \nstanding, half body, heart hands gesture,\nwhite background"], "inputs": [{"name": "clip", "link": 308, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 6, "type": "CLIPTextEncode", "title": "正面提示词", "properties": {"cnr_id": "comfy-core", "ver": "0.3.23", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 3}, {"outputs": [], "color": "#432", "widgets_values": ["《comfyUI极简入门课程》——我才是摸鱼仙人\n\n\n  点击运行按钮，如果一切顺利，你将看到一个来自原神中的角色安柏对着你做出比心的手势\n\n  那么我们来解释一下刚才发生了什么。我们运行了一个ComfyUI工作流，这个工作流是由一些节点和他们之间的连线组成的，工作流按照连线的顺序依次向后执行。这是个极好的面向新手入门的工作流，你将会看到4个区域，分别对应了AI绘画的4个基本步骤：\n  1.模型加载\n  2.设置生图条件\n  3.采样生成\n  4.将潜空间解码为图像\n\n  在模型加载区中我们加载了一个叫做“WAI-NSFW-illustrious-SDXL_v14”的Checkpoint模型，它是一个光辉系列的模型，关于模型类型的知识我们在另一个教程中介绍。现在你只需要知道这是一个非常擅长二次元领域的模型，能直接用提示词画出许多常见二次元角色就行。\n  \n  加载完成后我们在条件设置区设置了三个重要生成条件，分别是正面提示词，负面提示词，和要生成图片的尺寸大小。正面提示词就是你想要生成画面的描述，这里采用了4段式的描述：第一行是质量词，代表我们希望画面以何种质量展示。第二行是要生成的主体内容，第三行是动作和行为描述，最后一行是关于环境背景等次要信息的补充。负面提示词则是不希望出现在画面的内容。需要注意的是，提示词都是由英文组成的，写中文对于大多数模型来说是无法识别的（当然现在一些国产模型已经能很好支持了）\n\n  这些条件进入第三步采样区，它负责实际计算模型应该如何根据输入条件输出结果，我只放了一个节点K采样器，它有随机种子，运行后操作，步数，CFG,采样器，调度器，降噪幅度。我们可以把它比喻为一个画师，前面加载的模型是它已经学会的绘画技巧，条件是甲方提出的要求，采样则是他如何运用这些技巧满足需求的阶段。随机种子可以理解为它画这幅画时候的灵感，不同灵感决定了如何从一片虚空中生成有意义的画面，运行后操作就是这个种子如何变化，步数是用多少步计算完成这幅画，CFG可以理解为画面遵从提示词的程度，CFG越高则画师对提示词的限制越遵守，但是副作用是给他自由发挥的余地越小，这里我们采用一个经验范围5-7之间，采样器和调度器是他采用何种技法来完成这幅画，降噪幅度是指他将一片虚空（其实是潜空间噪声）变为有意义的画面的程度，1.0说明这个幅度是100%.\n\n\n  最后它计算的结果是人类无法识别的潜空间结果，需要使用vae解码器来将它解码成图像，vae模型已经包含在checkpoint模型中，所以这里直接用它来解码，也可以加载独立的vae模型。解码输出的结果就是一张我们看到的图片。\n\n\n  现在你已经学会了用ComfyUI工作流进行文生图了，编写提示词画出你的作品吧。AI只是工具，伟大的作品由你创作。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [471.173095703125, 600.8075561523438], "pos": [-909.1126708984375, 103.98805236816406], "id": 89, "properties": {}, "order": 2}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "frontendVersion": "1.18.9", "groupNodes": {}, "ds": {"offset": [1332.477095820961, -95.78275832559987], "scale": 1.1671841070450037}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "1.模型加载区", "bounding": [-402.96868896484375, 76.25438690185547, 567.7059326171875, 809.2325439453125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "2.条件设置区", "bounding": [207.785888671875, 73.2923812866211, 447.45062255859375, 883.2814331054688]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "3.采样区", "bounding