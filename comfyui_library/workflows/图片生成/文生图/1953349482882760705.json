{"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 5}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [46], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["夕阳西下，金色的余晖洒在喧嚣的街道上，为来往的行人镀上一层温暖的色彩。路边，一个年轻的女大学生支起简陋的馄饨摊，热气腾腾的锅灶旁，她熟练地包着馄饨，动作麻利却略显生涩。她的眼神坚定而平静，偶尔抬头望向匆匆的路人，嘴角带着一丝自嘲又释然的笑意。\n摊前的地上立着一块略显粗糙的木牌，上面写着：大学诚可贵，馄饨价不高，为了填肚子，面子也可抛。\n路过的行人有的驻足观望，有的低声议论，而大学生只是专注地煮着馄饨，仿佛外界的目光与她无关。夕阳的柔光映照在她的侧脸上，勾勒出一幅现实与理想交织的画面——生活不易，但她依然在努力前行。"], "inputs": [{"name": "clip", "link": 74, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [422.84503173828125, 164.31304931640625], "pos": [376.9809875488281, 186], "id": 6, "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 8}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.4", "VHS_latentpreview": false, "ds": {"offset": [140.22666272952466, 210.13412019554949], "scale": 0.7972024500000015}}, "groups": [], "links": [[46, 6, 0, 3, 1, "CONDITIONING"], [52, 7, 0, 3, 2, "CONDITIONING"], [74, 38, 0, 6, 0, "CLIP"], [75, 38, 0, 7, 0, "CLIP"], [76, 39, 0, 8, 1, "VAE"], [110, 8, 0, 60, 0, "IMAGE"], [125, 66, 0, 3, 0, "MODEL"], [128, 3, 0, 8, 0, "LATENT"], [129, 69, 0, 70, 0, "INT"], [130, 69, 1, 70, 1, "INT"], [131, 70, 0, 3, 3, "LATENT"], [132, 37, 0, 71, 0, "MODEL"], [133, 71, 0, 66, 0, "MODEL"]], "id": "91f6bbe2-ed41-4fd6-bac7-71d5b5864ecb", "config": {}, "version": 0.4, "last_node_id": 71, "revision": 0}