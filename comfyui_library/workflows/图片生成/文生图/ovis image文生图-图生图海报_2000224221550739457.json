name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 10, "type": "AILab_QwenVL", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 6}, {"outputs": [{"name": "CONDITIONING", "links": [1, 6], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["Poster Content Description\nA sleek, modern electric rice cooker rendered in high-definition 3D, situated on a polished dark granite countertop. The rice cooker features a matte black and stainless steel finish. The lid is slightly open, releasing a swirl of realistic, warm steam, revealing fluffy, perfectly cooked white jasmine rice inside. Beside the appliance, a simple white ceramic bowl filled with rice and a wooden serving spoon are neatly arranged to suggest a ready-to-serve meal.\nAesthetic Style Optimization\nThe visual style combines appetizing food photography with high-impact \"Black Friday\" promotional aesthetics. The background is a deep, moody charcoal or abstract black void to emphasize the product. The lighting is dramatic and high-contrast, with a spotlight on the rice cooker to make the metallic parts gleam and the white rice pop. The color palette is dominated by black, dark grey, and vibrant red accents to create a sense of urgency and excitement associated with a major sale.\nPoster Text\nBLACK FRIDAY SPECIAL\nPremium Smart Rice Cooker\n50% OFF\n$39\nText Style and Position\nThe text \"BLACK FRIDAY SPECIAL\" uses a massive, bold, industrial sans-serif font in bright white, positioned at the very top of the poster. The price \"$39\" and discount \"50% OFF\" are displayed in an aggressive, heavy weight font in urgent neon red; these are placed prominently in the lower-left quadrant or overlapping the corner of the product image to draw immediate attention. The product name appears in a smaller, elegant silver font just below the main headline.\nLayout\nThe composition features the rice cooker as the central hero object, slightly offset to the right to allow room for the large promotional text on the left. The steam rising from the cooker creates a vertical leading line that draws the eye upward toward the headline. The layout utilizes the dark background as negative space to ensure the red and white text remains highly legible and visually striking, creating a balanced hierarchy between the product and the offer."], "inputs": [{"name": "clip", "link": 9, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [326.3636474609375, 227.72727966308594], "pos": [864.650146484375, 362.3695373535156], "id": 9, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-239.8436576657341, 193.48632600917097], "scale": 0.8264462809917354}}, "groups": [{"color": "#A88", "font_size": 24, "flags": {}, "id": 1, "title": "尺寸设置", "bounding": [524.765625, 828.9054565429688, 290.931396484375, 200.15567016601562]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "ovis文生图-图生图", "bounding": [514.765625, 288.76953125, 1002.0612182617188, 750.2915649414062]}], "links": [[1, 9, 0, 4, 0, "CONDITIONING"], [2, 7, 0, 5, 0, "LATENT"], [3, 3, 0, 5, 1, "VAE"], [4, 5, 0, 6, 0, "IMAGE"], [5, 1, 0, 7, 0, "MODEL"], [6, 9, 0, 7, 1, "CONDITIONING"], [7, 4, 0, 7, 2, "CONDITIONING"], [8, 8, 0, 7, 3, "LATENT"], [9, 2, 0, 9, 0, "CLIP"], [10, 11, 0, 10, 0, "IMAGE"]], "id": "0c74ea7f-bead-43a8-8e1e-80426a0953e1", "config": {}, "version": 0.4, "last_node_id": 11, "revision": 0}