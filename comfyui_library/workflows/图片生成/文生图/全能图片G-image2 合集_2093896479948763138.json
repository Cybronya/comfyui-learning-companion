abel": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314], "pos": [1756.29296875, 1546.714111328125], "widgets_values": ["pasted/a0f00750a1e2f3d3910d3f52192d1f10dc521c020927f6a2d00983fcc79d7b67.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {"disabled": false}, "id": 25, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 6}, {"mode": 4, "outputs": [{"name": "image", "links": [18], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [351.31451416015625, 480.46197509765625], "pos": [4464.994140625, 1963.830322265625], "widgets_values": [50], "inputs": [{"name": "image", "link": 17, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "INT", "localized_name": "quality"}], "flags": {"collapsed": true, "disabled": false}, "id": 29, "type": "KOOK_ImageCompression", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KOOK_ImageCompression"}, "order": 23}, {"outputs": [{"name": "prompt", "links": [], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["16:9 横幅，人眼高度的平视镜头、略偏画面右下方远处、28mm 广角矩形构图、深景深，\n主导构图为一尊倒悬巨塔自星河深处垂落、塔尖指向画面左下方悬浮打坐的渺小人物的垂直断裂事件。\n\n画面右下近景是一柄巨剑的剑柄与半截剑身斜插入一团暗云，只露局部并向右切出画框，作为进入此境的巨型门槛。\n中景偏左是一条极薄的横向云带横贯画面左右出画，一名虚构成年男子盘坐悬浮于云带之上，\n全背影约 15 度斜后方视角，人物仅占画面高度 1%，周身保留约二十倍身长的纯净空域。\n他穿素白单层长袍垂裹盘腿，一条薄纱披帛自肩后向左后方缓缓扬起，发丝与所有衣摆服从同一风向（自塔向人再向左后方），身体稳定。\n\n统治主体是倒悬剑冢塔：成千上万柄倒悬古剑层层咬合成塔身，保留塔的收分轮廓、越近塔尖越窄，\n塔体最宽处被裁切在画面上缘之外、只垂下约三分之二塔身；外层单柄巨剑剑柄宽约五至八个成人身高，\n塔身正面一道纵向剑缝开口约二十倍成人身高，幽蓝剑光自缝中自下而上泄出，形成光脉。\n塔身中下部横穿一层低位云海，云海之下另悬三四座残破小剑冢，高低错落、明暗递减，更远处数缕断剑悬浮如尘。\n画面上方是斜贯的深空银河带与一枚被剑气削去一角的大月，构成终极纵深。\n\n主光源为塔尖泄出的冷白剑光、自下而上照亮人物轮廓与云带边缘；环境光为高位星空幽蓝漫射；\n全画唯一暖色是人物肩头一缕极淡金线绣纹与发梢受光边缘，占比不超过 3%；\n65% 以上画面为深蓝、墨紫、冷白，靠明度与冷暖建立通透感，色彩干净分离。\n整体氛围极度空灵、寂静、辽远，呼吸空间由星空、云隙、剑光与虚空构成且全部携带内容。\n\n不要栏杆或任何边缘围栏，不要正面人物肖像，不要灰雾蒙版或浑浊灰调，\n不要霓虹色、不要全局橙金滤镜，不要镜头光晕，不要塔体完整出现在画面内，\n不要多余文字、水印或边框。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {"disabled": false}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#353", "size": [488.14996337890625, 298.68121337890625], "pos": [6346.0927734375, 2853.1298828125], "id": 30, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 7}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314], "pos": [2855.919921875, 2582.942138671875], "widgets_values": ["pasted/1615c293ed5ae469c44a2e222163738df39fb04b87efe66d96790433fb6e6cd2.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {"disabled": false}, "id": 31, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 8}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314], "pos": [2492.9013671875, 2481.984375], "widgets_values": ["9a060b3946d7946592c7f823c988c7416c033530b7c78d2eeda2bacf7a39ff57.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {"disabled": false}, "id": 32, "type": "LoadImage", "pro