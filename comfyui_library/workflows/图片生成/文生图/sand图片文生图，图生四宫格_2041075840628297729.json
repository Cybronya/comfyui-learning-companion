io", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "id": 73, "type": "RH_Nano_Banana2_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 10}, {"mode": 2, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [599.0833740234375, 597.5299072265625], "pos": [1615.8492431640625, 508.5543212890625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 91, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 4, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 12}, {"mode": 2, "outputs": [{"name": "image", "links": [91], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [447.7109680175781, 584.295166015625], "pos": [924.1307373046875, 516.7960815429688], "widgets_values": ["生成一张专业级超高清电影质感的角色阵容横版长卷图，横版16:9或更宽的比例，纯白色无缝背景，柔和的影棚灯光从左上方均匀照亮，所有角色面向正前方，从左至右依次排列成一排，构图紧凑而有节奏感，无任何场景元素。\n\n【整体排列顺序（从左到右）】\n太阳花（悬浮）—绿胡子爷爷 — 小猴子 — 小兔子 — 小熊猫 — 小鸟 — 小象 — 小狐狸 — 小刺猬 — （中央留微小间隙）— 鼻涕嘟噜 — 掐掐它 — 呼啦啦 — 灰溜溜 — 邋遢遢 — 小屁屁（蹲于右侧末端）\n\n【详细角色描述·从左至右】\n\n1. 最左侧：太阳花——一朵完美无瑕的金色太阳花悬浮于半空，高度与爷爷头部齐平。花瓣层层叠叠半透明如流光溢彩的琉璃，花蕊是一枚精致的小铃铛形状，内部有一团温暖的金色光芒在缓缓旋转，散发柔和的金色光晕向四周晕染，神圣而明亮。\n\n2. 绿胡子爷爷——紧挨太阳花右侧站立。七十岁左右老者，面容慈祥，布满岁月皱纹，眼睛闪烁着智慧与温暖的光芒。蓄一把浓密蓬松的绿色长胡须垂至胸口，胡须在柔和光线中泛着健康的光泽。身穿洗得发白的灰绿色旧袍子，腰间系一枚闪闪发光的银铃，银铃表面有精细花纹，正散发温润的银色微光。右手自然垂落，左手轻轻搭在身侧小象的鼻子上。身高作为整排角色的参照中心。\n\n3. 小猴子——紧挨爷爷右侧。棕黄色毛发蓬松柔顺，眼神机灵有神，嘴角带一丝俏皮的笑意，尾巴在身后俏皮地卷起一个小圈。胸前挂一枚小小的金色铃铛，散发温暖金光。身高约到爷爷腰部。\n\n4. 小兔子——紧挨小猴子右侧。纯白色皮毛柔软蓬松，像一团雪白的云朵，长长的耳朵一只竖起一只微微垂着，红宝石般的眼睛里满是温柔与信赖。胸前同样挂一枚金色小铃铛。体型略小于小猴子。\n\n5. 小熊猫——紧挨小兔子右侧。圆滚滚的橘褐色身体像一颗毛茸茸的球，黑色的四肢、黑色的耳朵与白色的面部花纹形成可爱的对比。憨厚的脸上带着满足的微笑，胸前金铃铛随着呼吸轻轻起伏。体型与兔子相近但更圆。\n\n6. 小鸟——停在小熊猫的头顶上。蓝绿色的羽毛闪烁着金属般的光泽，小巧玲珑，胸前的袖珍金铃铛在光线下格外精致。歪着小脑袋，黑豆般的眼睛明亮有神。\n\n7. 小象——紧挨小熊猫右侧（爷爷左手搭在它鼻子上）。灰色庞大身躯坚实可靠，皮肤有细腻的褶皱纹理，长鼻子温柔地卷曲着延伸向爷爷的方向，大耳朵轻轻扇动。胸前宽厚的胸膛上挂一枚金铃铛，在巨大身躯上显得小巧珍贵。眼神温和憨厚。身高仅次于爷爷。\n\n8. 小狐狸——紧挨小象右侧。橘红色的皮毛鲜艳如火，蓬松的大尾巴优雅地卷在身侧，尾巴尖是白色的。尖耳竖起，眼神聪慧而略带一丝狡黠，嘴角带着自信的微笑。胸前金铃铛闪闪发光。体型比兔子略大。\n\n9. 小刺猬——紧挨小狐狸右侧。小小的身体圆滚滚的，背上的刺微微收起呈现柔软的姿态以防扎到同伴，露出浅色的柔软腹毛。黑亮的眼睛从刺间露出来，充满信赖地看向前方。胸前的金铃铛藏在腹毛间若隐若现，闪烁微光。体型最小。\n\n（中央留出约半个角色的微小间隙，作为正义与反派阵营的视觉分隔）\n\n10. 鼻涕嘟噜——间隙右侧第一个。肥胖臃肿到畸形地步的老女巫，身体像一座颤巍巍的肉山，层层叠叠的赘肉从一件破烂不堪、污秽暗淡的彩色袍子里挤出来。皮肤是病态的灰绿色，表面覆盖一层滑腻的黏液在光下反光。歪戴尖顶破旧巫师帽，五官挤在满脸横肉中，小眼睛深陷在肥肉褶皱里，闪烁着浑浊的黄绿色凶光，正警惕而怨毒地斜睨着左侧。鼻子又扁又宽，下方挂着一条长长的、浓稠的绿色鼻涕，一直垂到下巴，表面有恶心的气泡。一只肥手握着一枚暗紫色的黑魔铃举在胸前，黑魔铃表面有暗红色血管状纹路在缓缓蠕动，散发着不祥的暗紫色微光。身高与爷爷相近但横向臃肿得多。\n\n11. 掐掐它——紧挨鼻涕嘟噜右侧。身体细长扭曲像一根枯藤，灰绿色皮肤布满疣子。两只不对称的眼睛闪烁着谄媚又残忍的光芒，嘴角歪斜带着恶意的讪笑。十根尖利的黑指甲在胸前微微屈伸，仿佛随时准备掐住什么。破烂黑袍挂在身上。身高约到鼻涕嘟噜肩膀。\n\n12. 呼啦啦——紧挨掐掐它右侧。沙土色的粗糙皮肤像砂纸，扁平的脸上带着风沙侵蚀的痕迹，两腮微微鼓起仿佛随时准备吹出沙尘。眼神呆滞中带着一股蛮横。破烂袍子边缘沾满干涸的泥浆和沙粒。体型比掐掐它略壮实。\n\n13. 灰溜溜——紧挨呼啦啦右侧。身体细长干瘦，皮肤是暗淡的灰绿色覆盖着干涸的泥巴痕迹，像一条脱水的鱼。湿漉漉的袍子仿佛永远干不了，散发着一股腐败水藻的视觉暗示。眼神畏缩自卑，肩膀内收，仿佛随时准备挨骂。身高与呼啦啦相近但更瘦。\n\n14. 邋遢遢——紧挨灰溜溜右侧。肮脏到极点的身体，散发着肉眼可见的淡淡臭气波纹（用细微的灰绿色扭曲空气线表示）。破烂袍子上挂着不明黏液和污渍，双手污黑，手指正不安地互相抠着。眼神浑浊，嘴角带着愚蠢的傻笑。体型矮胖。\n\n15. 小屁屁——蹲在最右侧末端的地面上。一只脸盆大小的巨型黑色毒蜘蛛，全身覆盖粗糙的黑色刚毛，八条毛茸茸的长腿弯曲撑地，八只血红色的眼睛在黑色身体上发出幽幽的红光，正忌惮而凶狠地盯着左侧的金色铃铛光芒。螯肢缓缓蠕动，毒牙尖端渗出黏稠的毒液滴落。身体微微后缩，呈现一种既凶狠又畏惧的姿态。\n\n【全局统一细节】\n- 所有正义阵营角色（爷爷及七只小动物）胸前均佩戴一枚金色小铃铛，每枚铃铛都有细微的太阳花花纹，散发着温暖而统一的柔和金色微光。\n- 所有角色的眼神方向基本一致（面向前方或微微侧向观众），但鼻涕嘟噜和小巫们的目光带着明显的敌意和斜睨感。\n- 纯白色背景，无任何地面、阴影（或仅保留极淡的接触投影以稳定角色站位）、无任何环境元素。\n- 光线为柔和的专业影棚灯光，从左上角均匀照亮所有角色，确保正义阵营沐浴在温暖光线下，反派阵营则因自身肤色和光线角度呈现更阴冷的质感，但整体光照统一。\n\n【风格与质量】\n电影级现实主义风格与轻微童话美学的融合，所有角色的皮毛、羽毛、皮肤、布料、金属等材质极度精细真实。画面构图从左至右富有节奏感——从太阳花的明亮金色开始，过渡到爷爷和动物们的温暖色彩，再经过微小间隙，进入反派阵营的灰绿、暗紫和黑色系。整体既有角色阵容的史诗感，又保留童话的辨识度与温度。\n\n电影级质量标签：cinematic realism，hyperdetailed character design，soft studio lighting，pure white seamless background，epic character lineup composition，8k，no subtitles，no watermark，no text overlay，no timecode，no signature。\n\n负面约束：no background scenery，no trees，no grass，no sky，no floor line，no cartoon style，no flat illustration，no anime，no distorted anatomy，no extra limbs，no text，no logo。", 1196647524, "randomize", "16:9", "2k", "Third-party", false], "inputs": [{"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspe