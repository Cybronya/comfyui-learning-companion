 "FLOAT", "localized_name": "降噪"}], "flags": {}, "id": 9, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 9}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [10], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [140, 46], "pos": [919.3603515625, 444.45672607421875], "widgets_values": [], "inputs": [{"name": "samples", "link": 9, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 11, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 11, "type": "VAEDecode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 10}, {"outputs": [{"name": "CONDITIONING", "links": [7], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#332922", "widgets_values": ["模糊的、分辨率低"], "inputs": [{"name": "clip", "link": 8, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "link": 13, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "TextEncodeQwenImageEditPlus", "mode": 0, "bgcolor": "#593930", "size": [400, 200], "pos": [447.27850341796875, 538.0699462890625], "id": 10, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEditPlus"}, "order": 5}, {"outputs": [{"name": "text", "links": [12], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["【AI绘画提示词】  \n**主题（Subject）：** 一位年轻东方女性身着粉色古风汉服内衣造型，在古典卧榻上自拍微笑。发髻高盘配以樱花与珍珠花钿头饰；妆容精致柔美，眼影粉嫩带珠光，唇色水润微红，脸颊泛自然腮红。\n\n**构图（Composition）：** 高角度俯视特写镜头，人物居画面中心偏右，头部微微仰起凝视镜头，手臂轻抬呈“V”字姿势展示服饰细节。背景为中式雕花木床及浅绿/淡粉织锦被褥，营造纵深感和复古氛围。\n\n**光影（Lighting & Atmosphere）:** 柔和暖调自然光源从左上方斜射入室，形成细腻明暗过渡——面部受光均匀明亮，肩颈处有轻微阴影增强立体感；衣物褶皱透出柔和光泽，整体光线如晨曦般温婉朦胧。\n\n**艺术风格（Style）:** 现代唯美国风摄影+CG渲染质感 —— 融合《洛神赋》式仙气美学与中国古代仕女画像笔触，辅以当代时尚美妆元素；强调肌肤通透肌理、丝绸面料垂坠纹理与珠宝晶莹反光效果。\n\n**视觉表现力强化项（Enhancements）:**\n- 细节刻画优先级极高：发丝每一缕飘动清晰可见，花瓣装饰随发型排列错落有序；\n- 衣物材质真实呈现：薄纱层叠透明度渐变明显，内衬蕾丝边沿勾勒曲线优美；\n- 手部姿态优雅放松但具引导性，指尖略显湿润暗示刚沐浴或环境潮湿；\n- 周围景深虚化处理突出主角焦点，后方木质结构保留部分几何线条增添空间层次。\n\n**图像质量参数（Image Quality Parameters）:** \n分辨率建议 4K (3840x2160) 或更高；色彩饱和度适中偏暖色调；锐利度设为75%，保持皮肤毛孔细微纹理不糊；噪点控制低至几乎无干扰颗粒；边缘锐化适度避免过度生硬切割。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [434.9239501953125, 18.63918685913086], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [469.44744873046875, 503.2456970214844], "pos": [1331.676025390625, -19.894357681274414], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 10, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 12, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 11}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [558.044694688585, 694.9381758371989], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "模型", "bounding": [75.689453125, 62.79114532470703, 299.4197082519531, 694.47900390625]}, {"color": "#3f789e", "f