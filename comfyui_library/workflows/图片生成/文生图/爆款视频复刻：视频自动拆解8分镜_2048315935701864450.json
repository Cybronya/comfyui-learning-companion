，必须是**一段完整的文字（Single Paragraph）**。\n- 必须包含用户的台词（台词部分必须输出中文，例如：用标准普通话说：你们好呀，Fisher的小伙伴们）。\n-The character says,前必须加[用标准普通话说] ", "", 0.6, 492730559, "randomize"], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "link": 6, "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "link": 109, "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 8, "type": "RH_LLMAPI_Pro_Node", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_Pro_Node"}, "order": 9}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [95], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [412.117431640625, 99.93473815917969], "pos": [5045.72412109375, -1341.174804687