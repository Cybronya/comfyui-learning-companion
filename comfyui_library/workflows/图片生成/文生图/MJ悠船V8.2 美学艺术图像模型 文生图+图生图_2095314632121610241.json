alize", "label": "personalize", "type": "STRING", "localized_name": "personalize"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {"pinned": true}, "type": "RH_YouchuanTextToImageV82Fast", "mode": 0, "bgcolor": "#355", "size": [390, 590], "pos": [350, 640], "id": 2, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_YouchuanTextToImageV82Fast"}, "order": 12}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [439.64910888671875, 70.13159942626953], "color": "#fff0", "pos": [330, 1230], "inputs": [], "flags": {"pinned": true, "allow_interaction": true}, "id": 15, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#1B4669", "borderRadius": 20, "textAlign": "center", "widget_ue_connectable": {}, "fontSize": 36, "backgroundAlpha": 0, "lineHeight": 1.4, "text": "设置参数", "stroke": true, "fontColor": "#37ff00"}, "order": 6}, {"mode": 0, "outputs": [{"shape": 6, "name": "*", "label": "*", "type": "*", "localized_name": "*"}], "size": [270, 106], "pos": [780, 1280], "widgets_values": ["always", 0.6000000000000001, "notify.mp3"], "inputs": [{"name": "any", "link": 7, "label": "any", "type": "*", "localized_name": "any"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"name": "volume"}, "name": "volume", "label": "volume", "type": "FLOAT", "localized_name": "volume"}, {"widget": {"name": "file"}, "name": "file", "label": "file", "type": "STRING", "localized_name": "file"}], "flags": {"pinned": true, "collapsed": true}, "id": 20, "type": "PlaySound|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PlaySound|pysssss"}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["#### 核心基础参数\n\n**hd**：高清2K模式。1.5倍收费。\n\n**chaos**：稳定性（创意发散度），默认 0，范围 0-100。0：结果稳定，每次生成差别小；数值越大，初始构图随机性越强，脑洞越大，画面差异更大。\n\n**quality**：渲染质量。默认4。\n\n**stylize**：风格化强度。默认 100，范围 0-1000。数值越高画面越艺术化，越低越贴近提示词原意。工业产品图建议 `--s 50-200`；故障艺术或超现实风格可拉高至 `--s 300-600`。\n\n**weird**：怪异度。默认 0，范围 0-3000。拉高后产生超现实、猎奇、抽象奇异画面。工业设计或常规创作建议 0-250，灵感探索时可尝试 100 左右。\n\n**seed+Control_after_generate**：随机种。ComfyUI传统参数。\n\n**raw**：写实模式。默认开启true，减少 AI 的自动美化和过度计算，保留更多原始噪点和纹理，让画面更真实，适合商业级产品图和写实人像场景。关闭则会加上MJ 自带美化滤镜。\n\n**iw**：主参考图权重。参考图对画面的影响力，默认1；数值越大越服从参考图内容。\n\n**sw**：风格参考权重。风格参考图的画风强度，默认 100，范围 0-100。数值越大越贴合风格参考图的画风。\n\n**SV**：MJ版本。保持默认6。\n\n**tile**：平铺。默认关闭false。开启true可生成无缝四方连续贴图纹理，适用于贴图素材生成。\n\n**draft**：草稿模式。默认关闭false。开启true可快速低质量草稿出图。\n\n**exp**：细节增强参数。默认0，范围 0-100。提升光影和材质层次，商用效果图推荐 `--exp 10` 或更高。\n\n**personalize**：不填。\n\n**aspectRatio**：选择宽高比。\n\n**skip_error**：跳过错误。保持默认false即可。"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "title": "参数说明", "mode": 0, "bgcolor": "#653", "size": [390, 590], "pos": [770, 640], "id": 10, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [{"name": "text", "links": [6], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#322", "widgets_values": [""], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "JjkText", "mode": 0, "bgcolor": "#533", "size": [410, 420], "pos": [-100, 810], "id": 18, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 8}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [424.2078857421875, 87.04145812988281], "color": "#fff0", "pos": [1430, -30], "inputs": [], "flags": {"pinned": true, "allow_interaction": true}, "id": 21, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#1B4669", "borderRadius": 20, "textAlign": "center", "widget_ue_connectable": {}, "fontSize": 36, "backgroundAlpha": 0, "lineHeight": 1.4, "text": "保存JPG（默认无水印）", "stroke": true, "fontColor": "#37ff00"}, "order": 9}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [479.8262023925781, 85.05503845214844], "color": "#fff0", "pos": [2420, -30], "inputs": [], "flags": {"pinned": true, "allow_interaction": true}, "id": 22, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#1B4669", "borderRadius": 20, "textAlign": "center", "widget_ue_connectable": {}, "fontSize": 36, "backgroundAlpha": 0, "lineHeight": 1.4, "text": "保存PNG（会员无水印）", "stroke": true, "fontColor": "#37ff00"}, "order": 10}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [960, 1140], "pos": [2200, 90], "widgets_values": ["MJ"], "inputs": [{"name": "images", "link": 9, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {"pinned": true}, "id": 24, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 15}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [890, 1140], "pos": [1240, 90], "widgets_values": [], "inputs": [{"name": "images", "link": 8, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {"pinned": true}, "id": 23, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 14}, {"outputs": [{"name": "text", "links": [5], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["9:16竖屏，超写实真人东方古风电影人像，盛夏幽静的中式竹林溪谷，一名明确成年的年轻东亚女性坐在溪水旁天然灰色岩石上，正在用双手轻轻整理一只青灰色陶瓷盆中的新鲜绿色荷叶和透明冰块。\n\n人物约22–26岁，身材纤细修长，肩颈线条柔美自然，小巧精致鹅蛋脸，脸型窄而流畅，下颌线柔和清晰，白皙偏冷的自然肤色，保留细腻真实皮肤纹理与轻微毛孔，不使用塑料磨皮。\n\n五官精致清冷，深棕黑色杏仁眼，双眼清澈水润，细长自然眉毛，鼻梁纤细挺直，鼻尖小巧，嘴唇自然饱满，裸杏粉色唇妆，极淡东方裸妆，眼妆克制，没有浓重眼线，整体气质清冷、安静、温柔，带一点古典疏离感。\n\n黑色长发采用松散而精致的古风高盘发，头顶自然蓬松，后脑形成层次丰富的盘发结构，使用细小银白色花枝发簪固定，禁止大型华丽头冠。额前中分，脸颊两侧垂落多缕细长黑色碎发，其中一缕自然经过脸颊，耳侧与颈侧留有少量湿润感碎发，真实独立发丝清晰可见。\n\n人物穿浅雾青色、灰蓝色与象牙白结合的宋制/汉服风格长裙。\n\n内层为浅青灰色抹胸或吊带式古装内衫，胸前有极细腻白色刺绣与小型系带；腰部采用同色浅青灰束腰，腰线纤细；外层覆盖一件极轻薄、半透明的象牙白真丝纱衣，大袖设计，袖口宽大垂落，布料具有真实蚕丝、欧根纱和薄绢质感。\n\n外层纱衣在逆光区域明显半透明，可以看到内层浅青衣物的轮廓，但整体端庄自然。\n\n\n\n使用85mm电影人像镜头，F1.8–F2.2，人物中近景构图，镜头高度略高于人物胸部，轻微俯拍，真实光学浅景深。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [410, 600], "pos": [-100.8625717163086, 87.14912414550781], "id": 16, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 11}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [692.9832537460325, 183.64350057679735], "scale": 0.6588450000000011}}, "groups": [], "links": [[1, 4, 0, 2, 0, "IMAGE"], [2, 6, 0, 2, 1, "IMAGE"], [5, 16, 0, 2, 3, "STRING"], [6, 18, 0, 2, 5, "STRING"], [7, 2, 0, 20, 0, "*"], [8, 2, 0, 23, 0, "IMAGE"], [9, 2, 0, 24, 0, "IMAGE"]], "id": "3abec3ca-dd02-4fec-9414-3f8c15bb32ab", "config": {}, "version": 0.4, "last_node_id": 24, "revision": 0}