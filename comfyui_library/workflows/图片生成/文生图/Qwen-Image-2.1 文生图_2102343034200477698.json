adows. The striking background is a vivid mixed-media graphic collage, composed of flat vibrant lime green planes, stark black and white overlapping circles, segmented semi-circles with bold zebra striping, dense micro-halftone dot matrices, and vector topographic contour lines. The clash between monochromatic disruptive camo elements on her clothing and the saturated, retro-futuristic pop-art backdrop creates an intense visual dissonance, emphasizing sharp silhouettes, paper cut-out edges, dynamic compositional balance, and clean graphic novel textures. Absolutely no text, no typography, no letters, no words, no numbers, no logos, no watermark, no captions, pure imagery only.", "", 1024], "inputs": [{"name": "clip", "link": 673, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "negative_prompt"}, "name": "negative_prompt", "label": "negative_prompt", "type": "STRING", "localized_name": "negative_prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "INT", "localized_name": "resolution"}], "flags": {}, "id": 482, "type": "TextEncodeQwenImage21", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImage21"}, "order": 8}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [692], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [510, 90], "pos": [1465.956298828125, 2272.27685546875], "widgets_values": ["qwen_image_2.1_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "w