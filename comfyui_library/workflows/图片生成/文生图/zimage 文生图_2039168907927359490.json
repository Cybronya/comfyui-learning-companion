estricted": 0, "input_regex": "seed|种子", "version": "7.7", "group_restricted": 0, "title_regex_invert": false, "apply_to_unrepeated": 0, "widget_ue_connectable": {}, "output_not_broadcasting": {}, "group_regex_invert": false, "input_ue_unconnectable": {}, "repeated_type_rule": 0, "seed_inputs": true, "input_regex_invert": false}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "Seed Everywhere", "ue_convert": true}, "order": 3}, {"mode": 4, "outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "output"}], "size": [210, 1026], "pos": [-1620, 200], "widgets_values": ["第11组 孔雀蓝植绒纸基底，暗纹为青铜夔龙纹连续暗刻；“缘颂”篆书烫古铜金+局部凹凸浮雕，龙首环绕字形；公司名以微雕烫金隐于夔龙鳞片间隙；“500ML/52度”采用哑光UV微凸仿青铜铭文；盒脊压凹凸云雷纹边框，触手生温，古韵天成。", "第12组 月白蓝宣纸肌理特种纸，底纹暗藏《双沟酒谱》古籍竖排文字水印；“缘颂”瘦金体烫银（非金创新），压凹工艺形成纸张撕裂感；小字信息以朱砂红印章式烫金嵌于页脚；酒精度用宣纸纹理UV凸起；整体如古籍善本，文脉绵长。", "第13组 钢蓝金属拉丝纸，底纹暗纹双沟古窖池剖面线稿；“缘颂”无衬线字体烫哑光铂金，窖池轮廓压凹凸浮雕；公司名沿窖池阶梯烫微金；“52度”用镜面UV模拟酒液晶莹；侧边暗纹蒸馏器简笔画，工业美学与传统酿造对话。", "第14组 石青蓝蜡染风格纸，底纹暗纹扎染冰裂纹+靛蓝晕染肌理；“缘颂”行书烫靛蓝金（蓝调金），字迹边缘仿蜡防白纹；小字信息烫银藏于冰裂纹隙；净含量用蜡染滴落状UV凸起；民族工艺与白酒文化诗意交融。", "第15组 黛蓝丝绸暗纹纸，底纹暗藏“酒”字篆书万字不到头连续纹；“缘颂”楷书烫暖金配万字边框浮雕；公司名烫金微字嵌于万字中心；“500ML\"用丝绸褶皱UV增强触感；盒角包烫金回纹铜扣，吉祥寓意满载。", "第16组 雾霭蓝磨砂纸，底纹暗纹双沟老街青石板路拓印纹理；“缘颂”隶书烫古铜金，石板凹凸肌理压印字下；小字信息如石刻微雕烫金；酒精度用青苔绿哑光UV点缀；盒面局部植绒模拟青苔，地域记忆鲜活可触。", "第17组 靛蓝扎染渐变纸，底纹暗纹酒旗+酒幡剪影连续暗纹；“缘颂”书法烫金，酒旗飘动轨迹压凹凸；公司名沿旗杆烫微金；“52度”用酒液滴落状透明UV凸起；侧边暗纹古酒肆窗棂，市井酒香扑面而来。", "第18组 月影蓝珠光纸，底纹暗纹桂花+满月剪影水印；“缘颂”行书烫月光银，桂花轮廓烫银浮雕；小字信息藏于月影暗处微烫金；净含量用夜光UV（暗处泛柔黄光）；盒盖内衬暗纹嫦娥捧酒图，中秋礼赠意境满分。", "第19组 松烟蓝宣纸再造纸，底纹暗纹《酒经》古籍残卷文字暗纹；“缘颂”章草烫金，纸张纤维压凹凸肌理；公司名以藏书章形式烫朱砂红金；“500ML\"用宣纸破损边缘UV；整体如出土文献，历史厚重感扑面。", "第20组 深空蓝星砂纸（含细闪），底纹暗纹北斗七星连线+双沟星宿图；“缘颂”现代字体烫铂金，星轨压凹凸导流视线；小字信息沿星轨烫微银；酒精度用陨石坑状磨砂UV；盒扣处嵌烫金“缘”字篆印，宇宙级礼遇气场。"], "inputs": [{"shape": 7, "name": "anything", "link": 137, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 103, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "7c470c67d6df44498e52c902173c1ac77cd5bdfd", "ue_properties": {"widget_ue_connectable": {},