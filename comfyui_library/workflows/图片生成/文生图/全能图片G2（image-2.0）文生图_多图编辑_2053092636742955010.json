产品发布 Slides、超干净的瑞士网格布局、克制的单色调配色方案（仅含一处微妙的蓝色点缀），以及融合了演示文稿设计的逼真渲染效果。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 17, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"outputs": [{"name": "image", "links": [21], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "16:9", true, 392186504, "randomize", "2k"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 22, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}], "flags": {}, "type": "RH_RhartImageG2TextToImage", "mode": 0, "bgcolor": "#653", "size": [400, 248], "pos": [974.896728515625, -249.15951538085938], "id": 16, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2TextToImage"}, "order": 7}, {"outputs": [{"name": "image", "links": [20], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING