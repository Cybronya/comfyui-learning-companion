h_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}, {"widget": {"name": "custom_width"}, "shape": 7, "name": "custom_width", "label": "custom_width", "type": "INT", "localized_name": "custom_width"}, {"widget": {"name": "custom_height"}, "shape": 7, "name": "custom_height", "label": "custom_height", "type": "INT", "localized_name": "custom_height"}], "flags": {}, "id": 12, "type": "QwenImageLatentAspectRatio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "QwenImageLatentAspectRatio"}, "order": 3}, {"mode": 0, "outputs": [{"shape": 6, "name": "文本", "links": [14], "label": "文本", "type": "STRING", "localized_name": "文本"}], "size": [350.4132080078125, 183.4710693359375], "pos": [-149.515380859375, 66.08926391601562], "widgets_values": ["主体\n\n一位身材纤细的年轻女生，盘起松散的丸子头，几缕碎发自然垂落。她穿着一件奶油色短款旗袍元素上衣，布料带有浅褐色细碎纹理，袖口是柔软的毛绒边。下身是深咖色的垂坠感阔腿裤，材质微微光泽。脚穿白色厚底绒面拖鞋。\n\n动作与姿态\n\n女生侧身站立，对镜自拍，手机遮住大部分面部。左手自然下垂，右手举手机贴近脸部。整体姿态放松随性，身体略微前倾。\n\n环境与光影\n\n室内拍摄，柔和漫反射光从正前方与上方轻柔照亮，没有直射光源、无灯具映出。背景是一面浅灰色墙面，右侧有一扇黑色拱形门，左侧是复古黑色木柜，柜上放着米色干花与香薰。地面是浅木纹人字拼地板。整体氛围清新、干净、简约。\n\n风格与特效细节\n\n高清写实风，肤质细腻，布料材质真实，光影干净柔和，不过曝，不出现光源或灯。画面比例全身竖构图，时尚博主镜面自拍风格，整体色调柔和冷白感，视觉清爽自然，无过度锐化。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {}, "id": 11, "type": "MuyeTextEditOutput", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MuyeTextEditOutput"}, "order": 4}, {"mode": 0, "outputs": [], "size": [416.725341796875, 630.5768432617188], "pos": [2082.005859375, 117.54812622070312], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 10, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 10, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "S