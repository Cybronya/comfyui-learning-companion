人同时后退，目光再次交汇，胜负仍未分晓。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "Text Multiline", "mode": 0, "bgcolor": "#353", "size": [377.6755065917969, 616.4658813476562], "pos": [1718.509033203125, 601.9537963867188], "id": 20, "properties": {"cnr_id": "was-ns", "ver": "3.0.1", "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 3}, {"outputs": [{"name": "IMAGE", "slot_index": 0, "links": [10, 66], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "#322", "widgets_values": [], "inputs": [{"name": "samples", "link": 5, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 28, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {"collapsed": false}, "type": "VAEDecode", "mode": 0, "bgcolor": "#533", "size": [307.55517578125, 95.79912567138672], "pos": [2097.000732421875, 1818.9427490234375], "id": 7, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "VAEDecode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [17], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [423.2880554199219, 600.0029296875], "pos": [1222.8258056640625, 590.6093139648438], "widgets_values": ["pasted/a2e3ec6f4c8fb782cd8ee0d431ca7f4ab45e73f93ca8fa3ac869177a62a8ba02.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"