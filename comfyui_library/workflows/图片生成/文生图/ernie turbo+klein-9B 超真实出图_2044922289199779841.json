": [-1499.7886962890625, 608.9720458984375], "widgets_values": ["<s>[SYSTEM_PROMPT]你是一个专业的文生图 Prompt 增强助手。你将收到用户的简短图片描述及目标生成分辨率，请据此扩写为一段内容丰富、细节充分的视觉描述，以帮助文生图模型生成高质量的图片。仅输出增强后的描述，不要包含任何解释或前缀。[/SYSTEM_PROMPT][INST]{\"prompt\": \"{prompt}\"}[/INST]", "{prompt}", ""], "inputs": [{"widget": {"name": "string"}, "name": "string", "label": "string", "type": "STRING", "localized_name": "string"}, {"widget": {"name": "find"}, "name": "find", "label": "find", "type": "STRING", "localized_name": "find"}, {"widget": {"name": "replace"}, "name": "replace", "link": 121, "label": "replace", "type": "STRING", "localized_name": "replace"}], "flags": {"collapsed": true}, "id": 97, "type": "StringReplace", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"string": true, "find": true, "replace": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "StringReplace", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 14}, {"mode": 0, "outputs": [{"name": "STRING", "links": [121, 124], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [400, 200], "pos": [-1732.1688232421875, 484.18670654296875], "widgets_values": ["A raw, high-contrast cinematic film portrait of a young woman standing on a rain-slicked city rooftop at deep night, looking directly into the camera with an intense, defiant gaze. The composition is an extreme close-up, tightly framing her eyes and face. Her short dark hair is plastered to her face and forehead by heavy rain. Her skin texture is hyper-detailed, drenched with rain droplets catching the sharp, harsh glare of urban artificial light. A cold, piercing cyan neon light illuminates one side of her face, contrasting sharply with a gritty, deep magenta reflection from the city streets on the other side. She wears a dark, wet leather jacket with visible water beads and texture. The background is a completely blurred (heavy bokeh), abstract mosaic of streaking vehicle lights, distant high-rises, and chaotic electric signs, bleeding into a dark, industrial noir atmosphere. The overall aesthetic is raw, grainy, and industrial, featuring heavy film grain, deep shadows with crushed blacks, and intense, saturated color contrasts of deep blues, cyans, and harsh magentas. The atmosphere is turbulent and powerful. 8K, realistic analog film photo, natural film grain, rough texture."], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 98, "type": "PrimitiveStringMultiline", "title": "String (Multiline - Prompt)", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"value": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 11}, {"mode": 0, "outputs": [{"name": "BOOLEAN", "links": [126], "label": "BOOLEAN", "type": "BOOLEAN", "localized_name": "BOOLEAN"}], "size": [270, 80], "pos": [-1833.079345703125, 874.6842041015625], "widgets_values": [true], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "BOOLEAN", "localized_name": "value"}], "flags": {}, "id": 100, "type": "PrimitiveBoolean", "title": "Enable prompt enhancement?", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"value": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveBoolean", "tabWidth": 65, "secondTabWidth": 65, "ta