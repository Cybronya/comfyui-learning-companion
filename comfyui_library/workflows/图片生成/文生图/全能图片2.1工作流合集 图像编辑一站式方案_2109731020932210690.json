nk": 12, "label": "image_a", "dir": 3, "type": "IMAGE"}, {"name": "image_b", "link": 40, "label": "image_b", "dir": 3, "type": "IMAGE"}], "flags": {}, "type": "Image Comparer (rgthree)", "mode": 0, "bgcolor": "#535", "size": [560.087890625, 396.1810607910156], "pos": [1560.6761474609375, 1382.982421875], "id": 12, "properties": {"comparer_mode": "Slide", "widget_ue_connectable": {}}, "order": 23}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#232", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 38, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "type": "SaveImage", "mode": 4, "bgcolor": "#353", "size": [696.23193359375, 669.3570556640625], "pos": [3074.57763671875, 0], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 16}, {"outputs": [{"name": "image", "links": [38], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#323", "widgets_values": ["创建一张 9:16 的高端实验性时尚编辑海报，标题为 **“ALTER EGO”**，主题为“第二自我——身份重构”，副标题为 **“THE ART OF BECOMING”**。\n\n**主体人物：** 一位具有鲜明骨相、高颧骨、锐利下颌线和深邃眼神的年轻成年女性时尚模特。黑色湿发自然向后梳理，局部发丝贴合额头与脸颊，保留真实的毛孔、细微雀斑、皮肤纹理与自然光泽。人物以冷静、疏离、自信、略带挑衅的神情直视镜头，姿态具有雕塑般的张力。\n\n服装以参考图为准，具有不对称肩部廓形、硬朗裁剪、极简金属细节和夸张肩线。搭配一枚极简银色雕塑感耳饰。整体风格融合暗黑高级时装、先锋实验时尚与现代主义艺术指导。\n\n**摄影风格：** 高对比黑白时尚肖像摄影，以冷调银灰色阶呈现。使用精确的侧向硬光塑造面部骨骼，额头、鼻梁、颧骨、嘴唇和肩部具有清晰光影层次。背景为哑光冷白与深黑的结构性空间。保留真实摄影颗粒和丰富的暗部细节，呈现高级独立时尚杂志的质感。\n\n**核心编辑机制：** 以超大文字遮罩为主要视觉语言，结合不等比人像面板、重复局部裁剪和边缘张力。将模特面部拆分为三组不同宽度的摄影区域：一组占据主要视觉空间的正面面部特写，一组极窄的眼睛与鼻梁局部裁剪，一组经过放大的嘴唇、手部或肩部片段。不同裁剪保持同一人物的五官连续性，但在比例、位置和深度上制造受控错位。\n\n**主标题排版：** 使用极粗、极度紧凑的现代无衬线字体，将 “ALTER EGO” 作为贯穿画面的超大建筑性文字结构。部分字母延伸到画布之外，部分字形遮挡人像，部分字形被摄影内容填充。允许模特眼睛、湿发及肩部跨越字体边界，形成复杂、精确的前后景关系。标题不是悬浮在画面上的普通文字，而是参与裁剪人物和组织空间的视觉主体。\n\n**强调色：** 仅使用一种高饱和钴蓝色（#1646FF）。在画面右侧或中上部设置不规则的大面积钴蓝色纵向区域，使其与黑白人物发生交错遮挡。部分字体使用钴蓝色实色填充，部分细小编辑文字以冷白色置于蓝色区域之上。蓝色必须发挥构图分割、空间连接和视觉引导作用，而不是作为装饰。\n\n**信息层级：** 主标题 “ALTER EGO” 占据最强视觉权重。副标题 “THE ART OF BECOMING” 采用精致、高对比的衬线字体，放置于上方留白或中部结构交界处。将 “FORM / IDENTITY / RECONSTRUCTION” 作为次级编辑标签，使用细小的大写无衬线字体。加入编辑宣言 “IDENTITY IS NOT FIXED. IT IS FORMED, FRACTURED, AND REIMAGINED.”，集中排布在左下方或蓝色结构区域。画面侧边加入竖排文字 “AN EXPERIMENT IN SELF-PERCEPTION”，以精细的字距强化视觉秩序。\n\n**微型编辑文案：** 在局部区域设置整齐排列的英文文字：“BEYOND THE SURFACE, A NEW LANGUAGE OF SELF EMERGES. BETWEEN STRUCTURE AND INSTINCT, IDENTITY BECOMES AN ACT OF CREATION.” 文案应具有真实的杂志排版逻辑、精确的左对齐和克制的行距，形成两至三个清晰的信息岛。\n\n**整体构图：** 强烈不对称、高密度视觉中心、极端的字体与人物尺度反差。人物主脸部位于画面中上部偏左区域，面部裁剪局部延伸到画布外；钴蓝色块纵向穿插于右侧，超大标题横向切入人物摄影，形成具有空间深度的多层结构。保留少量干净的冷白负空间，使整体虽复杂却保持高级的视觉节奏。\n\n**视觉目标：** 作品应具有高级实验性独立时尚杂志、前卫编辑摄影、瑞士国际主义排版与当代艺术指导的融合特征。缩略图下首先识别出一张具有强烈情绪的大型人脸、一个极具冲击力的巨型英文标题，以及一个鲜明的钴蓝色结构；近距离观察时能够欣赏精密的人像切割、字体遮罩、局部重复摄影、边缘细节和高级编辑信息层级。\n\n**避免：** 普通居中杂志封面、简单照片加文字的平面布局、规则九宫格、人物五官失真、塑料感磨皮、随机装饰符号、多种强调色、过度复杂的背景、无意义的英文乱码、条形码、期号、品牌 Logo、水印、伪 UI 元素、廉价赛博朋克效果和过度数字故障风格。\n\n最终呈现为一张精致、激进、具有强烈艺术指导感和国际时尚编辑美学的 9:16 竖版艺术海报。", "2k", "9:16", false, 1468149032, "randomize"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN"