16, 179], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [373.78155517578125, 58], "pos": [1926.2330322265625, 2265.7021484375], "widgets_values": ["qwen_image_2.1_vae_bf16.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 4, "type": "VAELoader", "properties": {"models": [{"directory_invalid": true, "name": "qwen_image_2.1_vae_bf16.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 2}, {"mode": 0, "outputs": [{"name": "image_urls", "links": [], "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [649.490234375, 665.4661865234375], "pos": [3231.1630859375, 1951.4464111328125], "widgets_values": [], "inputs": [{"name": "images", "link": 19, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 12, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 16}, {"outputs": [{"name": "STRING", "links": [30], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#346434", "widgets_values": ["font,这是一张《无畏契约（VALORANT）》游戏皮肤套装的横版宣传海报，整体采用黑色、荧光绿与暗红色搭配，风格阴森、凌厉，带有明显的东方鬼怪与“般若面具”元素。\n\n## 一、画面内容\n\n### 1. 中央武器\n画面正中央斜向放置着一把经过华丽装饰的长枪，枪身从左下方向右上方延伸，几乎贯穿整个画面。\n\n- 枪身主体为黑色和深灰色。\n- 外部包覆红色、金色以及荧光绿色的装饰线条。\n- 枪托附近有弯曲的红色结构，边缘带金色描边。\n- 握把、机匣和枪管周围缠绕着类似藤蔓、绳索或鬼气的绿色能量。\n- 枪身中段带有一个绿色鬼面状装饰，纹路类似传统般若面具。\n- 枪管细长，顶部有白色或银色高光，周围环绕数个绿色圆环。\n- 整把武器带有非常强烈的妖异、武士与东方恶鬼风格。\n\n### 2. 背景图案\n枪械背后是一团向四周扩散的荧光绿色烟雾和火焰状能量。\n\n- 中心较暗，隐约形成一张巨大鬼脸或般若面具的轮廓。\n- 两侧绿色光焰向外延伸，形似眼睛、眉毛、翅膀或鬼怪张开的面部结构。\n- 绿色烟雾呈现出飘动、扭曲和燃烧的效果。\n- 背景上半部分以深黑色和墨绿色为主，下半部分逐渐过渡到暗红、棕红色，营造出地狱火焰般的气氛。\n\n### 3. 底部般若面具\n画面下方中央露出一个立体的红色恶鬼面具或武士鬼面。\n\n- 面具主体呈红色，嘴部大张，露出白色獠牙。\n- 嘴边或下颌位置有白色毛发、胡须状装饰。\n- 头部周围带有绿色烟气和装甲结构。\n- 面具后方及两侧堆叠着其他武器、刀具或机械装饰，但因画面裁切，只能看到局部。\n- 面具上方盘旋着一圈绿色能量，像从鬼面中释放出的魂魄或烟雾。\n\n## 二、主要文字内容\n\n### 左上角品牌标识\n左上角是绿色的《无畏契约》游戏标志：\n\n> **无畏契约**\n\n文字下方有较小的英文：\n\n> **VALORANT**\n\n左侧配有《无畏契约》的几何形标志，整体使用荧光绿色。\n\n### 顶部中央标题\n画面上方中央有两个巨大的红色汉字：\n\n> **般若**\n\n字体厚重、方正，带有切割感和游戏视觉风格。文字下方还有两个很小的绿色装饰字，但由于尺寸较小、清晰度有限，无法完全准确辨认。\n\n### 背景巨型文字\n画面左右两侧分别铺设了大面积绿色书法式文字，组合起来应为：\n\n> **般若假面**\n\n- 左侧为“般若”。\n- 右侧为“假面”。\n- 字体粗犷、变形明显，并与绿色烟雾融合，部分笔画被枪械及光效遮挡。\n\n### 底部宣传语\n画面底部中央有一行清晰的白色文字：\n\n> **般若假面套装 现已上线**\n\n下方还隐约可见一行较小的英文品牌字样：\n\n> **VALORANT**\n\n## 三、其他装饰文字与元素\n\n- 画面左右边缘均有竖排的小型英文字样，较清晰的部分可辨认为：\n  > **RIOT GAMES**\n- 四角和边缘分布着多个小型荧光绿色方块，类似界面定位点或科技感装饰。\n- 海报使用轻微的颗粒、噪点与模糊光晕效果，让画面带有电影海报和游戏宣传片截图般的质感。\n\n## 四、整体视觉风格\n\n整张海报以“般若鬼面”为核心主题，将传统东方恶鬼、武士面具与现代枪械设计融合。荧光绿色代表鬼火或灵魂能量，红色则强化血腥、愤怒和危险感。中央枪械是绝对视觉焦点，背景的巨大文字、鬼脸轮廓与底部般若面具共同营造出邪异、凶猛且极具压迫感的游戏皮肤宣传氛围。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [397.0281066894531, 211.88841247558594], "pos": [1934.626953125, 2392.339599609375], "id": 20, "properties": {"widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline", "dxosApiNodeId": "19"}, "order": 3}, {"mode": 0, "outputs": [{"shape": 3, "name": "images", "links": [], "label": "images", "dir": 4, "type": "IMAGE"}, {"shape": 3, "name": "images", "label": "images", "dir": 4, "type": "IMAGE"}], "size": [579.8516845703125, 641.98193359375], "pos": [3916.833984375, 1963.3292236328125], "widgets_values": [[{"name": "A", "selected": true, "url": "/view?filename=rgthree.compare._temp_lgpiv_00001_gvjos_1792249321.jpg&type=temp&size=3375.08&width=1920&height=1088&label=Normal&score=0&auditDecision=PASS&auditRequestId=2026101723020135E2F0A5B08C6BDA4FA8&cos_url=https%3A%2F%2Frh-comfyui01.tos-cn-beijing.vol