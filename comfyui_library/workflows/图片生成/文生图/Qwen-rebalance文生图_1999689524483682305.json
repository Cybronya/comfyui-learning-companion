{"last_link_id": 548, "nodes": [{"mode": 0, "outputs": [{"name": "MODEL", "links": [543], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [470.0359802246094, 82], "pos": [2759.325439453125, 594.671875], "widgets_values": ["Qwen-Image-Lightning-8steps-V2.0-r32.safetensors", 1], "inputs": [{"name": "model", "link": 476, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 45, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 6}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [476], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [407.8977966308594, 82], "pos": [2759.325439453125, 433.2840576171875], "widgets_values": ["QwenRebalanceV10_v10.safetensors", "fp8_e4m3fn"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 70, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.59", "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 0}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [7, 510], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["{\n  \"subject\": \"一位漂亮的17岁中国女孩，留着黑色齐肩短发，刘海自然垂落，眼神清澈明亮，直视镜头，脸颊泛着淡淡的粉红腮红，唇色柔和自然，表情宁静而略带羞涩；她身穿白色圆领T恤，外搭深蓝色连帽卫衣，右手轻轻托着一枝盛开的粉色樱花，花朵娇嫩，花瓣细腻，花蕊微黄，部分花苞含苞待放。\",\n  \"foreground\": \"前景为人物手部与樱花枝的特写，花瓣边缘清晰可见，轻微反光，手指自然弯曲，指甲修剪整齐，皮肤质感细腻，增强画面真实感与季节氛围。\",\n  \"midground\": \"主体位于画面中央，身体略微前倾，背景为模糊的红砖墙与绿叶枝条，阳光透过树叶洒下，形成柔和光斑，营造出温暖、静谧的春日氛围。\",\n  \"background\": \"背景为虚化的红砖墙与茂密的绿叶，隐约可见远处建筑轮廓，整体环境暗示这是一个城市中的庭院或校园角落，充满生活气息与自然美感。\",\n  \"composition\": \"采用中近景镜头（等效焦距约85mm），浅景深虚化背景，突出人物面部与手中的樱花；构图为三分法布局，人物位于右侧三分之一处，左侧留白展现绿叶与光线，引导视线从樱花到面部，形成自然流动的视觉路径。\",\n  \"visual_guidance\": \"观众视线首先被手中娇嫩的樱花吸引，随后沿花瓣线条滑向手部与手指，再由手臂延伸至面部，最终聚焦于她清澈的眼神与微笑，形成从物体到人物的情感闭环，强化春日诗意与温柔情绪。\",\n  \"color_tone\": \"整体为柔和粉彩系色调（soft pastel palette），以粉红、浅绿、灰蓝为主，点缀皮肤的自然粉调与樱花的亮粉，营造清新、宁静、充满生命力的视觉氛围。\",\n  \"lighting_mood\": \"采用柔和自然光照明，光源来自斜上方，模拟春日午后漫射光效，面部受光均匀，皮肤质感通透细腻，发丝边缘产生轻微光晕，营造梦幻、治愈、富有故事感的光影氛围。\",\n  \"caption\": \"在一片春意盎然的庭院中，一位漂亮的17岁中国女孩身着白色T恤与深蓝色连帽卫衣，手持一枝盛开的粉色樱花，发丝随风轻扬，眼神清澈望向镜头；背景是模糊的红砖墙与绿叶枝条，阳光透过树叶洒下，整个画面洋溢着宁静、温柔与春日诗意——杰作，顶级品质，超精细细节，锐利焦点，鲜艳色彩，高饱和度，高对比度，电影级打光，柔和自然光，清晰肌肤纹理，明亮日光，胶片颗粒，8K分辨率，HDR技术。\"\n}"], "inputs": [{"name": "clip", "link": 16, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 546, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [257.36376953125, 88], "pos": [3157.941650390625, 871.1044311523438], "id": 14, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [511], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [197.712890625, 26], "pos": [3555.9619140625, 924.0101928710938], "widgets_values": [], "inputs": [{"name": "conditioning", "link": 7, "label": "conditioning", "type": "CONDITIONING", "localized_name": "condi