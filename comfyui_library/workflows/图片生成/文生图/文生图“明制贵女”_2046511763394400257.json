NING", "localized_name": "条件"}], "size": [400, 200], "pos": [1080.015380859375, 2844.15966796875], "widgets_values": ["【主体融合】：将输入的La Mer精粹水瓶身完美融入场景，保持瓶身透亮，金属瓶盖反射环境光泽。\n【环境】：置身于静谧而深邃的深海世界。产品悬浮（或立于）一块有着细腻纹理的深色海底礁石之上，周围环绕着螺旋上升的金色修护气泡和液态的水流特效，仿佛精华正在被释放。背景隐约可见巨大的深海巨藻剪影，随水流缓缓摆动，强调品牌的核心成分。\n【构图】：产品居中构图，视觉焦点集中。画面留出顶部1/3的空间，展现透下来的光线，同时也为电商文案预留位置。\n【光影】：丁达尔效应（耶酥光）。一束神圣的阳光穿透深蓝色的海水从上方投射在瓶身上，在海底地面形成漂亮的水波纹焦散（Caustics），瓶身边缘泛着一圈高贵的金色轮廓光。\n【色彩】：高级的祖母绿与深海蓝渐变，点缀着香槟金色的光点，整体色调幽静、奢华、通透。\n【材质】：极致的水体质感，晶莹剔透的气泡，礁石的粗砺感与玻璃瓶身的顺滑感形成对比。\n【风格】：国际一线护肤品TVC广告截图，8K分辨率，商业摄影，光影层次丰富，极具修护感。"], "inputs": [{"name": "clip", "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "index": 4, "id": -1, "type": "TextEncodeQwenImageEdit", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEdit"}, "order": 13}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "size": [400, 200], "pos": [1080.015380859375, 3089.15966796875], "widgets_values": ["色调艳丽，过曝，静态，细节模糊不清，风格，作品，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，杂乱的背景，三条腿，"], "inputs": [{"name": "clip", "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "index": 5, "id": -1, "type": "TextEncodeQwenImageEdit", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEdit"},