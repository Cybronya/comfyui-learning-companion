er": 10}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [27], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["“创建双11电商盛典场景设计，采用**粉蓝黄渐变的流体背景**，风格童趣立体。画面元素包括： - 左侧粉紫渐变圆形区域，标注“11.11 巅峰盛典”，搭配**卡通滑板（彩色渐变）**、**拟人星星（蓝白配色带眼睛）**、**粉色小怪兽装饰**； - 右侧有巨型立体“11”字（粉蓝渐变），旁边是**蓝白购物篮插画（内装礼物盒、购物袋，标有“SALE”）**； - 上方漂浮**粉色心形气球（标注“双11 火力全开”）**、**金色手提包**、**粉色相机**、**蓝色T恤**等商品插画； - 红色丝带标注“全场满800送400 满额抽大奖”，整体散落金币、彩带装饰。 所有元素采用**马卡龙粉、蓝、黄高饱和渐变色彩**，融入拟人化星星、小怪兽、立体数字等童趣元素，文字层级分明（活动主题、满赠信息），营造双11巅峰盛典的狂欢购物场景，视觉上充满立体感与设计感，细节丰富（商品插画的样式、流体背景的层次）且主题明确，能有效吸引消费者关注双11电商活动。”"], "inputs": [{"name": "clip", "link": 31, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 63, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [340, 330], "pos": [1230, 330], "id": 24, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 12}, {"outputs": [{"name": "LATENT", "slot_index": 0, "links": [23], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#232", "widgets_values": [596863859370003, "randomize", 8, 1, "res_2s", "bong_tangent", 1], "inputs": [{"name": "model", "link": 26, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 27, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 28, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 29, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT"