"label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "#223322", "shape": 1, "widgets_values": ["None", "nearest-exact", 1, 300, 120, 48, 48, 0, 0], "inputs": [{"name": "base_image", "link": 145, "label": "基础图像", "type": "IMAGE", "localized_name": "base_image"}, {"name": "overlay_image", "link": 146, "label": "覆盖图像", "type": "IMAGE", "localized_name": "overlay_image"}, {"shape": 7, "name": "optional_mask", "link": 140, "label": "遮罩(可选)", "type": "MASK", "localized_name": "optional_mask"}], "flags": {}, "type": "Image Overlay", "mode": 0, "bgcolor": "#335533", "size": {"0": 270, "1": 290}, "pos": {"0": 1700.35546875, "1": -40.38232421875}, "id": 191, "properties": {"hasSecondTab": false, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "tabWidth": 65, "secondTabWidth": 65, "Node name for S&R": "Image Overlay", "tabXOffset": 10}, "order": 13}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [59, 62], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["产品摄影，一杯栀子绿奶茶，背景结合国风插画山水，栀子花，夏日的氛围，清新的颜色搭配，高级，海报排版，超高清，超细节，主标题 “栀子妍绿”（搭配英文 “GARDENIA”），小副标题 “免费喝奶茶”；顶部左上角留白；右侧描述风味：文字边框装饰“奶香浓郁 / 栀子芬芳 / 绿茶鲜爽”；底部标注 艺术装饰“0 植脂末、0 反式脂肪酸”“非氢化基底乳，味道自然鲜灵”，突出健康属性；标价 “¥16”，杯身印 “MORE CHEERS 江南制茶”“茶韵”；文字分散在四周（标题居上、价格居左、卖点居右），主体杯装饮品居中，整体层次分明，视觉焦点集中。\n\n\n"], "inputs": [{"name": "clip", "link": 135, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": {"0": 367.6183166503906, "1": 401.0059814453125}, "pos": {"0": 1239.0640869140625, "1": 821.9277954101562}, "id": 43, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "tabWidth": 65, "secondTabWidth": 65, "Node name for S&R": "CLIPTextEncode", "tabXOffset": 10}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "groupNodes": {"输入中文图像描述词": {"external": [[1, 0, "CONDITIONING"]], "nodes": [{"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "widgets_values": ["Chinese", "English", "青石滩被溪水浸得发亮，两个孩子像浸在薄荷水里的糖块，凝在溪边的晨光里。​\n扎羊角辫的小姑娘蹲在浅水区，裤脚卷到膝盖，露出的小腿沾着细碎的光斑。她的右手悬在水面上，指尖离溪水还有半寸，指缝间夹着片银杏叶，叶尖正对着水底一块淡红色的鹅卵石。左手撑在身后的青石上，石面的青苔印在手腕内侧，像块潮湿的翡翠。​\n穿背带裤的小男孩半跪在溪岸的蒲公英丛里，一只脚踩在溪水里，溅起的水珠还挂在脚踝的汗毛上，像串透明的珍珠。他的身体前倾，双手捧着个豁口的粗瓷碗，碗里盛着半汪水，水面浮着片梧桐叶，叶边停着只豆娘，翅膀蓝得发脆。​\n溪水在他们脚边打着旋儿，把岸边的细沙淘成弯弯的弧线。水底的卵石看得分明，有块像小鱼的灰石头，正对着小姑娘的鞋尖。远处的芦苇丛垂着几缕银丝，被风凝在半空，连蜻蜓都停在草叶上，翅膀的纹路清晰得能数出脉络。​\n阳光斜斜地切下来，在他们发梢镀上金边，两个小小的影子叠在溪水里，随着波纹轻轻晃，却始终没散开。"], "inputs": [], "flags": {}, "index": 0, "type": "LibLibTranslate", "title": "写入生成图像描述词", "mode": 0, "size": {"0": 273.3069763183594, "1": 220.0701904296875}, "pos": {"0": 1510, "1": 910}, "id": -1, "properties": {"hasSecondTab": false, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "tabWidth": 65, "secondTabWidth": 65, "Node name for S&R": "LibLibTranslate", "tabXOffset": 10}, "order": 6}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": {"0": 280, "1": 200}, "pos": {"0": 1509.9998779296875, "1": 1173.595703125}, "widgets_values": [""], "inputs": [{"name": "clip", "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING"}], "flags": {"collapsed": false}, "index": 1, "id": -1, "type": "CLIPTextEncode", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.3.45", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "tabWidth": 65, "secondTabWidth": 65, "Node name for S&R": "CLIPTextEncode", "tabXOffset": 10}, "order": 8}], "links": [[null, 0, 1, 0, 2, "CLIP"], [0, 0, 1, 1, 