皆为黑长直发，齐刘海修饰脸型，皮肤白皙，五官精致清秀，脸颊泛着自然红晕。她们头戴同款白色蕾丝花边发带，发带上点缀着粉色小花装饰，增添少女感。左侧女孩身穿白色荷叶边短袖衬衫，外搭粉色雏菊碎花围裙，裙摆与领口饰有精致蕾丝花边；右侧女孩穿着白色短袖衬衫，搭配浅灰底橙色波点雏菊图案围裙，腰间系着橙色缎带蝴蝶结，裙摆同样有蕾丝花边装饰。两人围裙均为A字短款设计，露出纤细腰身。背景为现代简约厨房，左侧橱柜上摆放着白色陶瓷罐、玻璃瓶与编织篮，墙上贴有法文烘焙食谱海报；右侧可见不锈钢水槽、银色水龙头与一盆绿植盆栽，窗台自然光充足。整体画面呈现奶油风日系小清新风格，色调柔和温馨，细节丰富，充满生活气息与少女甜美氛围。画面带有轻微胶片颗粒质感，增强真实感与电影感。"], "inputs": [{"name": "clip", "link": 2, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 5, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-584.4331469687579, 575.6764396121986], "scale": 1.0610764609500012}}, "groups": [], "links": [[1, 1, 0, 4, 0, "MODEL"], [2, 2, 0, 5, 0, "CLIP"], [3, 5, 0, 4, 1, "CONDITIONING"], [4, 5, 0, 6, 0, "CONDITIONING"], [5, 6, 0, 4, 2, "CONDITIONING"], [7, 4, 0, 8, 0, "LATENT"], [8, 3, 0, 8, 1, "VAE"], [10, 8, 0, 10, 0, "IMAGE"], [43, 29, 0, 4, 3, "LATENT"]], "id": "07fd3352-11ca-4df8-bebb-45432c155e4d", "config": {}, "version": 0.4, "last_node_id": 29, "revision": 0}