size": [315.975830078125, 154.68362426757812], "pos": [1137.3863525390625, 177.1297149658203], "widgets_values": ["8K 超写实照片级画质，极致真实，光线追踪，电影级光影，皮肤、发丝、布料纹理细腻逼真。\n一男一女两位古风武侠高手，并排站立、正面面向镜头，站姿沉稳，眼神锐利有气场。\n左侧女子：身着轻盈飘逸的薄款丝绸汉服，面料轻薄如蝉翼，自带柔滑高光与垂坠感，透光性强，随风微动，青瓷色淡雅高级；面戴同色系半透明面纱，眉眼精致清冷，头戴银质珍珠发饰，黑发柔顺自然，气质空灵又英气。\n右侧男子：面部轮廓硬朗深邃，颧骨带轻微红色擦伤，身穿黑色古风长袍，搭配深灰色皮革护腕，黑色发冠束发，手持带鞘长剑，身形挺拔，气场冷峻强大。\n背景是薄雾中的古代水乡石拱桥，潮湿反光青石板地面，暖橙色灯笼点缀，低饱和度青灰色冷调光影，大光圈 f/1.8 浅景深，整体画面写实、高级、氛围感拉满。"], "inputs": [{"name": "clip", "link": 2, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 71, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 5, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 12}, {"mode": 0, "outputs": [{"name": "INT", "links": [12], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [348.96038818359375, 58], "pos": [468.8004150390625, 317.9142761230469], "widgets_values": [1080], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 14, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [556.3636474609375, 647.272705078125], "pos": [2368.064208984375, 162.93167114257812], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 75, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 10, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 19}, {"mode": 0, "outputs": [], "bgcolor": "#353", "size": [160, 80], "color": "#232", "pos": [553.577575683