{"last_link_id": 6, "nodes": [{"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [842.9021606445312, 967.79541015625], "pos": [1431.2373046875, 535.2322387695312], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 6, "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 6, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 2}, {"outputs": [{"name": "image", "links": [6], "type": "IMAGE", "localized_name": "image"}, {"name": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", 2160, 3840, "disabled", 1, "4k", false, 1665786994, "randomize"], "inputs": [{"shape": 7, "name": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 5, "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "shape": 7, "name": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "shape": 7, "name": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "sequentialImageGeneration"}, "shape": 7, "name": "sequentialImageGeneration", "type": "COMBO", "localized_name": "sequentialImageGeneration"}, {"widget": {"name": "maxImages"}, "shape": 7, "name": "maxImages", "type": "INT", "localized_name": "maxImages"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_SeedreamV45TextToImage", "mode": 0, "bgcolor": "#653", "size": [400, 320], "pos": [900.7826538085938, 606.9791259765625], "id": 11, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_SeedreamV45TextToImage"}, "order": 1}, {"mode": 0, "outputs": [{"name": "text", "links": [5], "type": "STRING", "localized_name": "text"}], "size": [537.3652954101562, 772.1193237304688], "pos": [125.8701400756836, 639.6029663085938], "widgets_values": ["单张画布，严格3×3网格排列，9幅独立天宫仙界画面整齐排布，格子之间带有细浅白色分割线，画面无任何文字、数字，水印。单图9:16\n\n东海之外的浮空仙城，连绵群山被云海吞没，几座巨大的岛屿悬浮在高空，岛屿上有古老宫殿、灵塔、石阶、桥梁和仙树，远处是辽阔海面与破晓云层，金色晨光从云海缝隙洒下，瀑布从浮空岛边缘坠入云雾，仙鹤从画面远处飞过，少量仙人白袍行走于石阶与桥廊之间，场景宏大辽阔，空间层次深，云雾翻涌，建筑结构严谨，中式古风仙侠，电影级构图，细腻光影，高清细节，宏大远景，梦幻而庄严\n\n9格分镜（从上至下，从左到右）：\n1. 东海之外，辽阔云海之上，几座浮空仙岛缓缓浮现，金色晨光穿透云层，远处隐约可见古老仙城轮廓\n\n2. 巨大的浮空岛边缘有瀑布垂落，瀑布坠入云海深处，岛上宫殿与灵塔层层叠叠，仙气缭绕\n\n3. 一座长长的玉石桥连接两座浮空岛，桥栏雕刻精美，几位白袍仙人缓步走过，云海在脚下翻涌\n\n4. 近景视角，古旧石阶通向仙城大门，石门上有神秘纹路，云雾从门缝与台阶边缘散开，画面庄严神秘\n\n5. 仙城内部的空中回廊，木质廊桥连接不同宫殿，红色幡旗随风轻摆，远处云海与山峰层层展开\n\n6. 浮空岛边缘的观景台，一位白袍仙人站在栏杆前眺望东海云海，远处仙鹤掠过，晨光照亮衣摆\n\n7. 云海之上的巨大灵塔，塔身由石材与青铜结构组成，塔檐悬挂铃铛，云雾环绕塔身，气势恢宏\n\n8. 两座浮空岛之间形成天然云桥，桥下瀑布与云雾交织，仙树生长在崖边，画面开阔而梦幻\n\n9. 夕阳西下，云海被染成金橙色，浮空仙城静静悬浮在天际，宫殿灯火微亮，仙鹤飞向远处山峰"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 5, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [17.208560280674874, -479.00956652863647], "scale": 1.061076460950005}}, "groups": [], "links": [[5, 5, 0, 11, 1, "STRING"], [6, 11, 0, 6, 0, "IMAGE"]], "id": "66a25580-1786-479a-8145-f143cd8c2e64", "config": {}, "version": 0.4, "last_node_id": 12, "revision": 0}