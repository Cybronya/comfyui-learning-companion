"INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "type": "KSampler", "mode": 0, "bgcolor": "#653", "size": [315, 474], "pos": [396.2797546386719, -731.5283813476562], "id": 136, "properties": {"cnr_id": "comfy-core", "ver": "0.3.40", "ue_properties": {"widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "Node name for S&R": "KSampler"}, "order": 18}, {"outputs": [{"name": "CONDITIONING", "links": [146, 152], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#323", "widgets_values": ["一张具有浓厚日系电影感的雨天街拍照片。场景是一条城市居民街巷，白天阴雨天气，地面被雨水打湿形成反光，街道两侧有老式住宅建筑、绿植、盆栽、电线杆、交通标志和树木，整体环境安静又充满生活气息。\n\n采用第一人称牵手视角拍摄，像是在雨中被一个女孩拉着奔跑。画面前景出现摄影者的手，被女孩牵引向前，女孩的手臂从画面底部延伸到她的身体和脸部，形成强烈的空间纵深感。女孩正在向前奔跑或快速行走，回头看向镜头，露出开心灿烂的笑容，情绪自然、青春、充满感染力，像电影中的一个偶然瞬间。\n\n女孩是一位年轻亚洲女性，黑色长直发，被雨水打湿，湿润的发丝贴在额头和脸颊附近。皮肤带有雨水后的自然湿润反光，在近距离闪光灯照射下显得细腻通透。她穿着浅蓝白色改良中式风格短袖上衣，带有盘扣和旗袍元素，搭配蓝色百褶短裙，衣服因为雨水微微湿透，能看到真实的布料纹理和褶皱。\n\n摄影风格模拟日本青春电影和复古胶片摄影。使用24-35mm广角镜头，近距离手持跟拍视角，略微低机位，轻微倾斜构图，营造奔跑中的动态感。人物脸部保持清晰，但前景手部、手臂和部分湿发带有轻微运动模糊，让画面具有速度感和沉浸感。\n\n光线为阴雨天柔和自然光，同时加入手机闪光灯或机顶闪光灯效果。女孩脸部和皮肤有明显高光，背景保持较暗，形成主体突出效果。阴影柔和，整体反差较低。\n\n色彩采用低饱和冷色调，以青灰色、深绿色、蓝色和黑色为主，搭配湿润路面的红褐色反射和女孩浅蓝色服装。整体呈现轻微褪色、青绿色调、复古CCD相机和胶片扫描质感。\n\n后期加入细腻胶片颗粒、轻微噪点、漏光效果、低反差、高级日系胶片调色，以及90年代CCD数码相机拍摄的怀旧质感。画面氛围应该像一张偶然捕捉到的青春记忆照片：雨天、街道、喜欢的人牵着你奔跑，轻松、浪漫、自由、充满故事感。\n\n高质量真实摄影效果，不要插画感，不要CG感，不要过度磨皮，保持真实人物皮肤、真实雨水和自然环境细节。"], "inputs": [{"name": "clip", "link": 144, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#535", "size": [330, 210], "pos": [-64.52268981933594, -673.819580078125], "id": 134, "properties": {"cnr_id": "comfy-core", "ver": "0.3.47", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 16}, {"outputs": [], "color": "#432", "widgets_values": ["lora的触发词和推荐的强度\nkrea2_coolblue  teal watercolor illustration style  0.8\n蓝绿色水彩插画风格\n\nkrea2_darkbrush  monochrome ink wash style 1.0\n单色水墨风格\n\nkrea2_plasmoid ethereal shimmering light style 0.8\n空灵闪烁的光影风格\n\nkrea2_warmpastel muted minimalist sketch style 0.8\n简约素雅的素描风格"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [288.9053649902344, 218.32974243164062], "pos": [-1310.4072265625, -750.6895751953125], "id": 147, "properties": {"widget_ue_connectable": {}}, "order": 15}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.25.3", "VHS_latentpreview": false, "ds": {"offset": [3441.5100996229385, 1645.0802595350478], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 11, "title": "官方LORA", "bounding": [-1335.916015625, -912.113525390625, 750.2433471679688, 610.0211181640625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 12, "title": "Krea2-Turbo文生图工作流", "bounding": [-538.973876953125, -910.30029296875, 1951.820678