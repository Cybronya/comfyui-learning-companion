": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 1, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "VAE", "links": [8], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [270, 58], "pos": [173.00413513183594, -8.744938850402832], "widgets_values": ["z_image_turbo-vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 3, "type": "VAELoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 4}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [3, 4], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [320.9736633300781, 127.182861328125], "pos": [501.5013122558594, -285.9884338378906], "widgets_values": ["这是一张高分辨率的照片，照片中呈现的是一位二十岁的东亚女性。她撑着一把桐油纸伞，缓步穿行于湿润的青砖巷弄之中，雨珠沿着伞缘连成一串透明的珠帘，营造出柔和而静谧的氛围。  \n\n该女性具有标准的瓜子脸型，面部轮廓清晰流畅，伞沿投下的阴影将面部划分为明暗两个区域，增强了画面的层次感与光影对比。她拥有一双杏核眼型的眼睛，目光透过雨帘望向远方，眼神中流露出一丝沉静与思索，睫毛上挂满晶莹的水珠，如晨露般清透。鼻梁纤细而秀气，与整体五官比例协调。嘴唇呈自然的花瓣状，微微张开，呼出的白气在冷空气中清晰可见，唇珠因湿润而显得更加饱满，进一步强化了雨天氛围的细腻表达。整体神情柔和而略带疏离，展现出雨天特有的朦胧诗意，仿佛与外界的喧嚣隔绝，沉浸在自己的世界之中。  \n\n她的深棕色长发自然披散于肩头，发丝间点缀着一枚水晶材质的发箍，增添了一丝精致感。雨滴顺着下颌线条滑落，强化了画面的动态细节与真实感。身着一件灰紫色坑条针织连衣裙，外搭同色系斗篷式雨衣，整体造型兼具功能性与审美性。一手提着藤编篮，篮中盛放着新鲜采摘的莲蓬，为画面增添了一抹生活气息与自然意趣。  \n\n背景为典型的江南老街，青砖铺地，屋檐滴水，街道被雨水浸润得泛着光泽，营造出湿润而宁静的地域氛围。整张照片通过人物姿态、服饰与环境的协调搭配，巧妙地融合了传统与现代的视觉元素，捕捉并呈现了雨中独行所蕴含的静谧美学，传达出一种内敛而富有诗意的生活态度。\n真实摄影,镜头美学,电影质感,高级感,大师级作品,细节清晰，8K，"], "inputs": [{"name": "clip", "link": 2, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 65, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 5, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"text": true}, "version": "7.0.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 7}, {"mode": 0, "outputs": [{"name": "STRING", "links": [64], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [580.1236572265625, 586.1644287109375], "pos": [-753.3076782226562, -349.0108337402344], "widgets_values": ["（大师之作，最佳品质，超精细，摄影棚拍摄，正面视角），一位25岁的中国女孩站在极简的深色时装秀T台中央正从容走来，拥有一张纯真又撩人的初恋脸，柔和的鹅蛋脸型，勾人心魄的小鹿眼带着清澈迷离的水汽直直凝视镜头，鼻梁精致，饱满的果冻唇微张，乌黑蓬松的微卷长发披散肩头，身材曲线玲珑有致，腿部纤细修长，肌肤白皙透亮如瓷；她身穿一袭极具设计感的改良式黑色贴身连体衣，正面采用深V镂空设计延伸至腰腹，展现曼妙曲线，高腰剪裁与两侧大腿根部的高开叉在步伐间极致凸显腿长，带有细腻光泽的弹力面料如第二层肌肤般紧贴包裹全身；背景是极简深色T台，一道强烈的聚光灯光束从正上方打下，在她周身形成明亮光晕，聚焦所有视线，画面干净富有冲击力；她神态从容中带着一丝羞涩与大胆，嘴角含着一抹若有若无的笑意，4K高清，皮肤与面料质感极度真实"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 70, "type": "Text Multiline", "properties": {"cnr_id": "was-node-suite-comfyui", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "ue_properties": {"widget_ue_connectable": {"text": true}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 5}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.30.6", "VHS_latentpreview": false, "ds": {"offset": [739.5975391404451, 527.3071656728132], "scale": 1.0610764609500032}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "模型加载", "bounding": [163.00413513183594, -391.5727233886719, 295.67193603515625, 450.8277893066406]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 8, "title": "Group", "bounding": [474.6846923828125, -395.4842224121094, 9