色调为深蓝紫渐变，辅以青、橙、粉、绿多彩霓虹点缀，明暗对比强烈，光影层次丰富，电影级氛围感；\n8K 超清分辨率，商业海报级质感，细节细腻丰富，居中对称构图，上下分层布局，自然景深效果，高级科技商务氛围"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "输入提示词", "mode": 4, "bgcolor": "#024b02", "size": [310, 330], "pos": [266.7030029296875, 2624.52490234375], "id": 126, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 14}, {"outputs": [{"name": "STRING", "links": [115], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#165f16", "widgets_values": ["时尚女子海报，镜头语言，画面给人很强的故事感。散焦。多重曝光，艺术美学，颗粒弥散，视觉摄影，空间感高级，黑白红主色调戏剧性灯光，时尚艺术，概念艺术，极具艺术的现代海报设计的排版和构图形式，大师海报作品。右下角极小的灰色细笔签名“FENGSHIJUE”+红印章。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "输入提示词", "mode": 0, "bgcolor": "#024b02", "size": [322.2758483886719, 565.3818359375], "pos": [599.64501953125, 3347.102294921875], "id": 60, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 15}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [236.2838106562474, -2707.771861540271], "scale": 0.5445000000000227}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "boogu单图编辑", "bounding": [242.4962921142578, 3264.5341796875, 2088.860595703125, 663.3216552734375]}, {"color": "#