r": "#232", "widgets_values": ["外貌：她有着一头蓬松的银灰色长卷发，发丝柔亮，点缀着两只精致的蓝紫色蝴蝶发饰。五官精致，眼眸是通透的蓝紫色渐变，眼尾带着红晕，唇色粉润，气质清冷又柔和。\n穿着：她身着浅灰色蕾丝吊带睡衣，外搭一件宽松的浅灰拼淡紫外套，半敞着露出肩颈线条，整体穿搭慵懒又不失甜美。\n姿态：她双腿优雅地交叠，怀里抱着一只毛茸茸的紫色小熊玩偶，一只手搭在玩偶上，另一只手自然垂在沙发边缘，姿态放松又带着一丝娇俏。\n环境氛围\n室内布置：背景是一间充满温馨感的阳光房。窗边的木质台面上摆放着几盆生机盎然的绿植，暖黄色的阳光透过薄纱窗帘洒入，让整个空间明亮又柔和。\n背景元素：右侧是一个摆满书籍的深色木质书架，增添了文艺气息；左侧小圆桌上放着一杯紫色饮品，右下角还有一道小小的彩虹光晕，为画面增添了梦幻感。\n整体画面融合了细腻的笔触、柔和的色彩与温暖的光影，营造出一种慵懒、治愈又充满少女心的氛围。"], "inputs": [{"name": "clip", "link": 909, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [697.4228515625, 422.952392578125], "pos": [-1744.2298583984375, -519.310791015625], "id": 187, "properties": {"cnr_id": "comfy-core", "ver": "0.3.67", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 9}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [868.8339233398438, 1221.9730224609375], "pos": [-943.52490234375, -1219.5792236328125], "widgets_values": [], "inputs": [{"name": "images", "link": 902, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 506, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 17}, {"outputs": [{"name": "IMAGE", "links": [601], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "color": "#323", "widgets_values": ["lanczos", 0.5000000000000001], "inputs": [{"name": "image", "link": 797, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": 