el": "unet_name", "type": "COMBO", "localized_name": "UNET名称"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 5, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.26.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 1}, {"outputs": [{"name": "STRING", "links": [12077, 12078], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#233", "widgets_values": ["这是一幅中景镜头，聚焦于一位身着新中式旗袍的中国白肤大胸女性，她以袅娜姿态倚靠在园林亭台的美人靠上，背景为朦胧的竹林与一池残荷，整体构图采用三分法，人物位于画面左侧，右侧留白融入水墨般的远景，引导观众目光自然聚焦于人物与旗袍的东方曲线。光线柔和且富有层次，来自斜上方的薄暮天光，巧妙勾勒出旗袍开衩与腿部轮廓，同时在织锦面料与珍珠耳坠处形成温润高光，营造出含蓄而妩媚的氛围。拍摄角度为平视略带俯角，使人物姿态既显矜持又具欲拒还迎的张力。\n女性身形纤细修长，如瀑青丝以一根玉簪松松挽起，几缕青丝垂落于雪白颈侧，妆容精致，眼尾以朱砂红微微上挑，唇色为复古正红，面带似笑非笑的弧度，头部微微侧倾，目光轻盈斜睨镜头，流露出风情与清冷并存的神韵。她身着一件极具东方韵味的墨绿色丝绒旗袍，内衣轮廓隐约可见，材质为具有光泽感的真丝丝绒与暗纹织锦，层层叠叠的盘扣与斜襟从领口蜿蜒至腰侧，形成不对称的斜线设计，裙摆开衩处饰以黑色蕾丝镶边，形成墨绿与玄黑的撞色视觉冲击。旗袍为立领无袖款式，凸显修长脖颈与圆润肩线。她脚踩一双黑色缎面绣花鞋，鞋尖缀以米粒珍珠，与整体造型相得益彰。背景中，美人靠旁放置一柄油纸伞与半卷泛黄书册，为画面增添江南烟雨气息，同时与青绿色调背景形成和谐过渡。整体风格含蓄、妩媚，充满东方古典美学，细节丰富而富有表现力。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "Text Multiline", "mode": 0, "bgcolor": "#355", "size": [440.07977294921875, 175.75518798828125], "pos": [-665.3748779296875, 2563.249755859375], "id": 177, "properties": {"cnr_id": "was-ns", "ver": "3.0.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 11}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#653", "size": [372.7581481933594, 130], "color": "#432", "pos": [-546.1962890625, 2933.136962890625], "inputs": [], "flags": {}, "id": 61, "type": "Fast Groups Bypasser (rgthree)", "pro