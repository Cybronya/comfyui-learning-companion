桌，桌上散乱地放着几本打开的笔记本和一支笔，地板是浅色木地板，上面铺着一块灰色地毯。整个场景是室内拍摄，镜头采用平视角度，从侧面稍偏前方拍摄，画面构图自然，留白适中。闪光灯从正前方直闪，光线强烈，使人物面部和手机屏幕反光明显，皮肤质感细腻，衣料纹理清晰，金属拉链和玻璃灯罩反射出冷调高光。整体色调偏暖，以灰、白、蓝为主，辅以木质棕色和暖黄灯光，营造出一种轻松、真实、生活化的氛围。"], "inputs": [{"widget": {"name": "request"}, "name": "request", "link": 102, "label": "request", "type": "STRING", "localized_name": "request"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "output_mode"}, "name": "output_mode", "label": "output_mode", "type": "COMBO", "localized_name": "output_mode"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "width"}, "name": "width", "link": 104, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 105, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "context_size"}, "name": "context_size", "label": "context_size", "type": "INT", "localized_name": "context_size"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "timeout_seconds"}, "name": "timeout_seconds", "label": "timeout_seconds", "type": "INT", "localized_name": "timeout_seconds"}, {"widget": {"name": "previous_prompt"}, "shape": 7, "name": "previous_prompt", "label": "previous_prompt", "type": "STRING", "localized_name": "previous_prompt"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE"}], "flags": {}, "id": 58, "type": "MOSSP