"bgcolor": "#355", "size": [376.2910461425781, 413.18585205078125], "pos": [-768.9027709960938, 11.339816093444824], "id": 216, "properties": {"cnr_id": "comfy-core", "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 9}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [366.876220703125, 578.8721923828125], "pos": [-876.4449462890625, -398.9422912597656], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 6857, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {"pinned": true}, "id": 133, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 28}, {"outputs": [{"name": "text", "links": [6782], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#332922", "widgets_values": ["一位18岁年轻的可爱幼态日本东亚女性，深夜的厨房场景，侧身站立，身体轮廓在昏暗光线下显现。她的头发是薄薄的深黑色，在侧光下呈现出微妙的蓝黑色调，发丝表面带有细腻的自然光泽。头顶及后脑勺的头发被随意、松散地挽起，形成一个低而凌乱的半扎发/发髻，几缕发丝从发髻中挣脱出来，垂落在颈后和耳后。大部分头发自然垂落在肩前和胸前，长度及胸，发尾带有轻微的自然波浪卷，略带毛躁的S形弧度。额前有轻薄的空气刘海，自然地向一侧偏分，几缕碎发贴在脸颊和太阳穴。她穿着一件oversize的纯白色宽松T恤，黑色系带内裤，右手轻轻撩起T恤下摆露出马甲线腰腹，左手拿着利乐包饮品用吸管饮用，她略低头，但眼珠看向镜头，微微害羞，露齿歪头微笑，生活抓拍。低照度电影布光，远处是暗调隐隐约约看到的日式现代公寓厨房，强烈的明暗对比。日系复古胶片摄影风格，黑暗的环境，闪光灯效果，柯达Portra 400胶片颗粒感，高噪点，低饱和度色调，暗角效果。浅景深，焦点集中在人物侧脸，背景模糊。氛围慵懒、松弛、私密、略带疏离感，褪色胶片质感，8K，写实摄影，不要有肢体错误。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true, "collapsed": false}, "type": "CR Text", "mode": 0, "bgcolor": "#593930