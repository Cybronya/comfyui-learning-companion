: 0, "outputs": [{"name": "output", "links": [17], "type": "*", "localized_name": "output"}], "size": [322.1369323730469, 354.72467041015625], "pos": [3093.463623046875, 1507.5445556640625], "widgets_values": ["这是一张充满活力、色彩鲜明的街头时尚照片，采用低角度仰拍，突出了人物的动感和城市背景的宏伟。\n\n**主体人物：**\n- 一位年轻女性站在城市街道中央，姿态充满动感，左腿抬起，仿佛正在跳跃或摆出街舞姿势。\n- 她有着蓬松的黑色卷发，戴着一副时尚的粉红色太阳镜，遮住了眼睛，增添了一丝酷感。\n- 她身穿一件鲜艳的橙色短款T恤，露出腰部，搭配一条亮粉色的宽松运动裤，裤脚有松紧带设计。\n- 她脚上穿着一双引人注目的荧光黄绿色Nike Air Force 1运动鞋，鞋侧的Swoosh标志是亮粉色，与裤子颜色呼应，鞋底厚实，极具视觉冲击力。\n\n**背景与环境：**\n- 背景是典型的现代都市景观，可以看到高耸的摩天大楼，其中一座带有尖顶的建筑（很可能是纽约的世贸中心一号楼）在蓝天中格外醒目。\n- 天空湛蓝无云，阳光明媚，光线充足，使得整个画面色彩饱和度极高。\n- 画面左上角可以看到一个黄色的交通信号灯箱和一个黑色的路牌，路牌上有白色箭头和文字（似乎是“ONE WAY”），进一步强化了城市街道的场景。\n- 街道上还有几辆汽车，包括一辆蓝色的出租车，暗示这是一个繁忙的交通路口。\n\n**整体风格与氛围：**\n- 整张照片充满了青春、活力、时尚和街头文化的气息。\n- 高饱和度的色彩搭配（橙、粉、荧光绿）与蓝天形成强烈对比，视觉效果非常抓人眼球。\n- 低角度的拍摄方式不仅突出了人物的高大和自信，也增强了画面的戏剧性和冲击力。\n- 人物的动态姿势和城市背景的静态建筑形成对比，营造出一种动感与秩序并存的都市氛围。\n\n总而言之，这是一张精心构图、色彩大胆、充满现代感和时尚气息的街头摄影佳作。"], "inputs": [{"shape": 7, "name": "anything", "link": 16, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 23, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 13}, {"mode": 0, "outputs": [], "size": [270, 270], "pos": [3057.077392578125, 1972.6943359375], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 5, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 11, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 17}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-2021.0434112185685, -1526.906158518038], "scale": 0.8769226950000045}}, "groups": [], "links": [[4, 9, 0, 10, 0, "CLIP"], [5, 12, 0, 11, 0, "IMAGE"], [6, 18, 0, 12, 0, "LATENT"], [7, 13, 0, 12, 1, "VAE"], [8, 16, 0, 15, 0, "MODEL"], 