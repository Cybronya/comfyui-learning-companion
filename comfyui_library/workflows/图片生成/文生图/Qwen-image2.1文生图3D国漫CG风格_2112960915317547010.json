e": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "调度器"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {}, "id": 88, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "ue_properties": {"widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "Node name for S&R": "KSampler"}, "order": 11}, {"outputs": [{"name": "MODEL", "links": [263], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#223", "widgets_values": ["3D国漫CG风格Qwen2.1_3000.safetensors", 0.5], "inputs": [{"name": "model", "link": 256, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#335", "size": [366.29730224609375, 82], "pos": [259.43927001953125, -1633.619873046875], "id": 198, "properties": {"cnr_id": "comfy-core", "ver": "0.39.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 7}, {"outputs": [{"name": "positive", "links": [101], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "links": [102], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent", "label": "latent", "type": "LATENT", "localized_name": "latent"}], "color": "#232", "widgets_values": ["3DGMCG，画面风格：3D国漫CG动画电影风格，色彩明快清新，采用高饱和度的夏日色调，三维体积感强，材质细腻柔和，具有强烈的国漫唯美氛围与二次元审美气质。光影处理自然明亮，采用影视级3D渲染、PBR材质、柔和全局光照与真实反射折射，整体呈现清新治愈的视觉体验。\n核心元素：浅亚麻金色长发的3D国漫CG少女角色，头戴装饰向日葵的草编遮阳帽，身着淡樱粉色洛丽塔风格连衣裙，双脚站立在清澈水面上，背景为蓝天白云下的浅灰色钢架拱桥与湖畔远景，前景点缀向日葵与雏菊花丛，空中有白色蝴蝶翩飞，右侧放置一台复古胶片相机。整体构图层次分明，前景花丛、中景人物、远景桥梁与天空形成纵深空间感。\n具体内容：少女拥有及腰的浅亚麻金色长发，发丝精细建模、随风飘扬，发梢带有自然波浪卷曲，几缕发丝轻拂脸颊。她头戴圆形草编帽，帽檐装饰有盛开的向日葵花朵和绿色叶片，草编纹理清晰。身穿淡樱粉色无袖连衣裙，裙身布满精致的白色蕾丝花边和荷叶边装饰，布料柔软、立体建模细腻；腰间系有宽大的奶油黄色丝带蝴蝶结，蝴蝶结中央点缀一朵向日葵。裙摆呈多层蛋糕裙样式，轻盈蓬松。腿部为自然光腿造型，不再穿长袜；脚蹬白色圆头玛丽珍鞋，鞋面带有小巧蝴蝶结装饰，鞋身浸在水中并带有湿润材质表现。她正面站立、身体微微前倾，双脚自然分开站立于浅水中，右手自然叉腰，手肘向外撑开；左手抬至脸侧，比出剪刀手（V字手势），手指纤细。脚边水中有清晰倒影，水面泛起细小涟漪，右侧漂浮着一台白色复古相机，相机具有金属与塑料材质细节。背景是一座浅灰色钢架拱桥横跨湖面，桥体呈金属桁架质感，远处点缀绿树、低矮白色建筑与缓坡绿地。天空湛蓝，点缀着蓬松的白色云朵。画面右下角有黄色菱形行人过街标志和黑白双向箭头路牌。多只白色蝴蝶在空中翩翩起舞。\n动作姿势：少女呈正面站立、身体微微前倾的俏皮姿态，双脚自然分开、稳稳站在清澈浅水中，水面没过脚踝，重心均匀落在双腿上，脚下泛起细小涟漪。右手自然叉腰，手肘向外撑开，姿态自信轻松；左手抬至脸侧，做出剪刀手（V字手势），手掌朝向观众。头部微微歪向一侧，视线看向镜头，表情甜美俏皮。浅亚麻金色长发与裙摆随微风自然摆动，发丝和裙摆呈现动态感。整体姿态灵动、活泼又不失优雅。\n技术参数：采用垂直构图，人物位于画面中心位置，视角为平视略偏仰视。光线为自然日光，光源来自正上方略偏左，形成明亮柔和的正面光照效果，人物面部和服装受光均匀，阴影柔和。水面反射天空蓝色，带有波光粼粼的高光点缀。使用大光圈虚化背景，前景花朵和远景桥梁形成景深层次。色彩以蓝色、淡樱粉色、黄色、白色与浅亚麻金色为主色调，营造出夏日晴朗的清新氛围。采用3D国漫CG影视级渲染，高精度模型，PBR材质，全局光照，环境光遮蔽，次表面散射，透明折射，体积光，水面实时反射，画面清晰度极高，细节丰富，色彩饱和度高但不失自然。", "", 1024], "inputs": [{"name": "clip", "link": 100, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "typ