ght_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLoader", "mode": 0, "bgcolor": "#3f5159", "size": [360, 90], "pos": [5325.4140625, 103.15991973876953], "id": 246, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"name": "ideogram4_fp8_scaled.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Ideogram-4/resolve/main/diffusion_models/ideogram4_fp8_scaled.safetensors"}], "ver": "0.8.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "secondTabOffset": 80, "Node name for S&R": "UNETLoader", "tabWidth": 65, "secondTabWidth": 65, "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "secondTabText": "Send Back", "enableTabs": false, "tabXOffset": 10}, "order": 3}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [353], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["{\n\"high_level_description\": \"A glossy vertical street-fashion poster of a red-haired young woman crouching in a bright city canyon, layered with oversized red typography, white motion streaks, and a saturated blue-sky editorial layout.\",\n\"style_description\": {\n\"aesthetics\": \"High-energy fashion poster and digital magazine-cover visual with an extreme low-angle hero composition, oversized display typography behind and over the subject, dense editorial microtext blocks, and glossy social-media cover art finish. The design relies on scale contrast between the crouching figure, towering buildings, huge red headline text, and sweeping foreground script.\",\n\"lighting\": \"Hard midday sunlight from the upper right creates bright highlights on the red hair, white outfit, and boots, while soft fill keeps the face readable. White horizontal light streaks cross the foreground as graphic glow overlays, with mild bloom around the typography and high-contrast red accents against the blue sky.\",\n\"medium\": \"Poster design\",\n\"art_style\": \"Hybrid fashion-poster construction with semi-realistic AI editorial character rendering, glossy skin and fabric surfaces, exaggerated low-angle lens distortion, urban lifestyle photography composition, bold sans-serif headline typography, cursive neon-script overlays, and clean magazine-style information hierarchy.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#FF5A3D\",\n\"#D91918\",\n\"#F5F5F0\",\n\"#D7D8DA\",\n\"#AEB6C0\",\n\"#1FA9F2\",\n\"#69C9FF\",\n\"#B8E7FF\",\n\"#F7C27A\",\n\"#9A6B4C\",\n\"#2F3338\"\n]\n},\n\"compositional_deconstruction\": {\n\"background\": \"A bright modern city street seen from a very low angle, with tall buildings leaning inward on both sides, overhead cables, blue sky, scattered clouds, sidewalk signage, and small distant pedestrians. The background forms a vertical urban canyon that frames the central crouching figure and supports the poster's upward perspective.\",\n\"elements\": [\n{\n\"type\": \"obj\",\n\"bbox\": [\n140,\n220,\n890,\n820\n],\n\"desc\": \"Red-haired young woman crouching in the center foreground, wearing an all-white futuristic streetwear set with a high-collar jacket, loose white pants, and white boots. Her calm upward-facing expression, wind-swept hair, and large bent knee create the main hero silhouette.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#F4F1EA\",\n\"#D7D9DE\",\n\"#B9C0C8\",\n\"#9A5A43\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n65,\n120,\n245,\n875\n],\n\"text\": \"RUBY\",\n\"desc\": \"Huge bold uppercase sans-serif headline placed behind the figure, bright red, tightly tracked, occupying the upper third and partially obscured by the subject's head and hair.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#E71918\",\n\"#FFFFFF\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n120,\n245,\n245,\n750\n],\n\"text\": \"Red Hair\",\n\"desc\": \"Large white cursive script crossing over the red headline and the subject's hair, glowing slightly like a handwritten neon signature across the upper-center area.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#FFEDEC\",\n\"#FFB8B8\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n305,\n705,\n430,\n970\n],\n\"text\": \"Red Hair Girl\",\n\"desc\": \"Right-side editorial title block with bold red sans-serif heading and stacked small white uppercase copy beneath it, aligned like magazine feature text over the subject's bent knee and sky area.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#FFFFFF\",\n\"#E7EEF5\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n520,\n15,\n850,\n980\n],\n\"text\": \"Pretty\",\n\"desc\": \"Oversized red cursive script sweeping across the lower half of the poster, extremely large, decorative, semi-transparent in places, wrapping around the boots and foreground leg.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#F21A18\",\n\"#FF6A58\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n690,\n120,\n990,\n430\n],\n\"desc\": \"Large white boot and lower leg in the left foreground, exaggerated by low-angle perspective, with glossy highlights, rounded sole, and slight motion softness, anchoring the subject close to the viewer.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#E8E8E4\",\n\"#C9CDD1\",\n\"#9EA5AB\",\n\"#C98D62\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n610,\n690,\n1000,\n1000\n],\n\"desc\": \"Oversized white foreground leg and boot shape on the lower right, cropped heavily by the poster edge and blurred by glow streaks, adding depth and aggressive street-fashion scale.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#E2E4E7\",\n\"#BCC3CC\",\n\"#8E969E\",\n\"#FF4A35\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n0,\n0,\n995,\n1000\n],\n\"desc\": \"Composition function region: multiple white horizontal motion streaks and soft flare bands crossing the poster from left to right, partially covering the figure, typography, and buildings to create speed and glossy graphic energy.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#F3FAFF\",\n\"#DDF5FF\",\n\"#B8E7FF\",\n\"#FFB7A8\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n760,\n720,\n820,\n970\n],\n\"text\": \"@khantstudio24\",\n\"desc\": \"Small white social handle set near the lower right over the red script and pale clothing, using a clean bold sans-serif style for social-media branding.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#E8EDF2\",\n\"#CCD3DA\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n910,\n25,\n985,\n230\n],\n\"desc\": \"Small rating-label-style graphic block in the bottom left corner, white outline and dense microtext on a gray translucent base, functioning as a music-poster authenticity detail.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#D6D6D0\",\n\"#777D82\",\n\"#3D4145\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n905,\n780,\n980,\n970\n],\n\"desc\": \"Small barcode-like graphic panel in the bottom right corner, white diagonal bars inside a thin rectangular frame, acting as a decorative poster-system footer element.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#D8DDE2\",\n\"#9EA6AD\",\n\"#50565C\"\n]\n}\n]\n}\n}\n"], "inputs": [{"name": "clip", "link": 390, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [430, 420], "pos": [5816.609375, -26.85102653503418], "id": 209, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.8.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 10}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [352], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["{\n\"high_level_description\": \"A glossy vertical street-fashion poster of a red-haired young woman crouching in a bright city canyon, layered with oversized red typography, white motion streaks, and a saturated blue-sky editorial layout.\",\n\"style_description\": {\n\"aesthetics\": \"High-energy fashion poster and digital magazine-cover visual with an extreme low-angle hero composition, oversized display typography behind and over the subject, dense editorial microtext blocks, and glossy social-media cover art finish. The design relies on scale contrast between the crouching figure, towering buildings, huge red headline text, and sweeping foreground script.\",\n\"lighting\": \"Hard midday sunlight from the upper right creates bright highlights on the red hair, white outfit, and boots, while soft fill keeps the face readable. White horizontal light streaks cross the foreground as graphic glow overlays, with mild bloom around the typography and high-contrast red accents against the blue sky.\",\n\"medium\": \"Poster design\",\n\"art_style\": \"Hybrid fashion-poster construction with semi-realistic AI editorial character rendering, glossy skin and fabric surfaces, exaggerated low-angle lens distortion, urban lifestyle photography composition, bold sans-serif headline typography, cursive neon-script overlays, and clean magazine-style information hierarchy.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#FF5A3D\",\n\"#D91918\",\n\"#F5F5F0\",\n\"#D7D8DA\",\n\"#AEB6C0\",\n\"#1FA9F2\",\n\"#69C9FF\",\n\"#B8E7FF\",\n\"#F7C27A\",\n\"#9A6B4C\",\n\"#2F3338\"\n]\n},\n\"compositional_deconstruction\": {\n\"background\": \"A bright modern city street seen from a very low angle, with tall buildings leaning inward on both sides, overhead cables, blue sky, scattered clouds, sidewalk signage, and small distant pedestrians. The background forms a vertical urban canyon that frames the central crouching figure and supports the poster's upward perspective.\",\n\"elements\": [\n{\n\"type\": \"obj\",\n\"bbox\": [\n140,\n220,\n890,\n820\n],\n\"desc\": \"Red-haired young woman crouching in the center foreground, wearing an all-white futuristic streetwear set with a high-collar jacket, loose white pants, and white boots. Her calm upward-facing expression, wind-swept hair, and large bent knee create the main hero silhouette.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#F4F1EA\",\n\"#D7D9DE\",\n\"#B9C0C8\",\n\"#9A5A43\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n65,\n120,\n245,\n875\n],\n\"text\": \"RUBY\",\n\"desc\": \"Huge bold uppercase sans-serif headline placed behind the figure, bright red, tightly tracked, occupying the upper third and partially obscured by the subject's head and hair.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#E71918\",\n\"#FFFFFF\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n120,\n245,\n245,\n750\n],\n\"text\": \"Red Hair\",\n\"desc\": \"Large white cursive script crossing over the red headline and the subject's hair, glowing slightly like a handwritten neon signature across the upper-center area.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#FFEDEC\",\n\"#FFB8B8\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n305,\n705,\n430,\n970\n],\n\"text\": \"Red Hair Girl\",\n\"desc\": \"Right-side editorial title block with bold red sans-serif heading and stacked small white uppercase copy beneath it, aligned like magazine feature text over the subject's bent knee and sky area.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#FFFFFF\",\n\"#E7EEF5\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n520,\n15,\n850,\n980\n],\n\"text\": \"Pretty\",\n\"desc\": \"Oversized red cursive script sweeping across the lower half of the poster, extremely large, decorative, semi-transparent in places, wrapping around the boots and foreground leg.\",\n\"color_palette\": [\n\"#FF2A24\",\n\"#F21A18\",\n\"#FF6A58\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n690,\n120,\n990,\n430\n],\n\"desc\": \"Large white boot and lower leg in the left foreground, exaggerated by low-angle perspective, with glossy highlights, rounded sole, and slight motion softness, anchoring the subject close to the viewer.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#E8E8E4\",\n\"#C9CDD1\",\n\"#9EA5AB\",\n\"#C98D62\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n610,\n690,\n1000,\n1000\n],\n\"desc\": \"Oversized white foreground leg and boot shape on the lower right, cropped heavily by the poster edge and blurred by glow streaks, adding depth and aggressive street-fashion scale.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#E2E4E7\",\n\"#BCC3CC\",\n\"#8E969E\",\n\"#FF4A35\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n0,\n0,\n995,\n1000\n],\n\"desc\": \"Composition function region: multiple white horizontal motion streaks and soft flare bands crossing the poster from left to right, partially covering the figure, typography, and buildings to create speed and glossy graphic energy.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#F3FAFF\",\n\"#DDF5FF\",\n\"#B8E7FF\",\n\"#FFB7A8\"\n]\n},\n{\n\"type\": \"text\",\n\"bbox\": [\n760,\n720,\n820,\n970\n],\n\"text\": \"@khantstudio24\",\n\"desc\": \"Small white social handle set near the lower right over the red script and pale clothing, using a clean bold sans-serif style for social-media branding.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#E8EDF2\",\n\"#CCD3DA\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n910,\n25,\n985,\n230\n],\n\"desc\": \"Small rating-label-style graphic block in the bottom left corner, white outline and dense microtext on a gray translucent base, functioning as a music-poster authenticity detail.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#D6D6D0\",\n\"#777D82\",\n\"#3D4145\"\n]\n},\n{\n\"type\": \"obj\",\n\"bbox\": [\n905,\n780,\n980,\n970\n],\n\"desc\": \"Small barcode-like graphic panel in the bottom right corner, white diagonal bars inside a thin rectangular frame, acting as a decorative poster-system footer element.\",\n\"color_palette\": [\n\"#FFFFFF\",\n\"#D8DDE2\",\n\"#9EA6AD\",\n\"#50565C\"\n]\n}\n]\n}\n}\n"], "inputs": [{"name