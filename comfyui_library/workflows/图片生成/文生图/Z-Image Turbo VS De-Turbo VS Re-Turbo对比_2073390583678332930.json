table": {}, "Node name for S&R": "UNETLoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [755.8180541992188, 749.3988647460938], "pos": [3990.517822265625, 2478.15771484375], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 46, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 36, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 24}, {"outputs": [{"shape": 6, "name": "STRING", "links": [3, 36, 53], "label": "字符串", "type": "STRING", "localized_name": "字符串"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#233", "widgets_values": ["一位左手拿红色雨伞、右手拿蓝色咖啡杯的女性站在街头，金色短发、绿色瞳孔，身穿黄色风衣。背景是一条被雨水打湿的老旧石板路，呈现现实主义摄影风格，光线柔和。\n夜晚的城市天台，前景是一张摆着三本书和一杯橙色果汁 的桌子，远处能看到霓虹灯反射在玻璃幕墙上。画面必须呈现俯拍视角与电影级色彩分级。\n以立体派风格绘制的静物画：一只绿色梨子、一块蓝色陶瓷盘、一张折叠的报纸被拆解成几何形状并重新组合，光影硬朗、结构碎片化。\n在森林空地上，一只白色狐狸安静地趴在黑色狼的背上，两只动物都注视着画面右侧。背景带有薄雾，整体气氛宁静。采用自然纪录片级别写实风格。\n一辆未来感十足的银色摩托车，车身侧面印有明显的数字“2077”。摩托停在蓝色灯带照亮的地面上，画面带有冷色科幻光影。\n一名跳芭蕾的女孩仅用右脚尖着地，左腿高高抬起，双臂呈 圆形“上五位” 姿势。背景是极简灰色摄影棚，灯光从 左前方 45 度 打来。\n一束由 纯黄色向日葵、纯白百合、纯紫玫瑰 组成的花束，放在完全黑色背景 前。要求三种颜色互不污染，呈现 清晰边缘与高饱和度。\n在雪地里，一棵樱花树正满开粉色花朵，旁边是一只戴着草帽的北极熊坐在木凳上看书。画面整体柔和、童话风格。\n一只 蓝色机械昆虫的特写镜头，能清晰看到透明翅膀上的微型电路纹路、六条金属腿的关节齿轮。背景虚化，采用微距摄影 质感。\n一名芭蕾舞者在舞台中央，仅用左脚尖支撑身体，右腿向后抬到与地面平行，双臂向两侧水平伸展。背景简洁，灯光自上方打下。\n一名女性坐在木椅上，右脚搭在左膝上，左手放在大腿外侧，右手拿着一本书。姿势自然、比例准确，采用写实风格。\n一名男子在公路上奔跑，拍摄瞬间为 右腿向前迈出、左腿向后伸直、右臂后摆、左臂前摆的标准跑步动作。背景为运动摄影风格。\n一位角色在草地上 单膝跪地（左膝跪地、右脚撑地），上半身 前倾约 30°，双手握住一把剑的剑柄，剑尖插在地面。阳光从侧面照射。\n画面中是一名表演者做出 “双手十指交叉举在胸前” 的动作，头部微微侧向右边。要求手指清晰、数量正确、比例自然。\n一名体操运动员正在做 前横叉（左右腿完全向两侧打开至 180 度），上身保持挺直，双手自然放在腿上。采用体育摄影风格。\n一名武术表演者在空中做 腾空旋踢，右腿高高踢起，左腿弯曲收在身体下方，双臂张开保持平衡。背景带轻微运动模糊但主体清晰。\n从 俯视角度 拍摄一个人在瑜伽垫上做 下犬式：双手双脚撑地，臀部抬高成倒 V 形，脊椎保持直线。要求角度正确、四肢比例无错乱。\n两个人在做击掌动作：左侧人物的右手与右侧人物的左手在画面中央相碰,两人都微微前倾,双臂伸直但不过度紧绷,背景为户外阳光场景，光影自然。", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "最大行数"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [488.8871765136719, 521.5496215820312], "pos": [1586.955322265625, 1027.197998046875], "id": 18, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptLine"}, "order": 4}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [270, 270], "pos": [6231.65771484375, 1513.40283203125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 63, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 48, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 26}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [755.8180541992188, 749.3988647460938], "pos": [4004.40625, 1642.1051025390625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 34, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 27, "type": "SaveImage", "properties": {"widget_ue_c