properties": {"horizontal": false, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "showOutputText": false}, "order": 30}, {"mode": 4, "outputs": [{"name": "output", "links": [931], "label": "output", "type": "*", "localized_name": "output"}], "size": [140, 26], "pos": [-190, 270], "widgets_values": [], "inputs": [{"name": "anything", "link": 930, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 528, "type": "easy clearCacheAll", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy clearCacheAll"}, "order": 33}, {"outputs": [{"name": "output", "links": [935], "label": "output", "type": "*", "localized_name": "output"}], "color": "#332922", "widgets_values": ["{\n  \"shot\": {\n    \"composition\": \"中景，48mm 焦距（等效于 48mm 镜头），使用 OPPO Find X6 Pro 拍摄，浅景深，焦点精确对焦在女性面部和蛋糕蜡烛上，背景挂毯被虚化以突出主体。\",\n    \"camera_motion\": \"静态拍摄，相机保持完全稳定，无任何运镜，以捕捉宁静、神圣的瞬间。\"\n  },\n  \"subject\": {\n    \"description\": \"BJDHXQ3，一位 25 岁的东亚女性，面容清秀柔和，皮肤白皙细腻，双目紧闭，嘴角含着温柔的微笑，神情宁静而充满期待。她拥有一头柔顺的黑色齐肩短发，发丝垂落在肩头，发质顺滑有光泽。她的体型苗条纤细，姿态端庄优雅。\",\n    \"wardrobe\": \"身穿一件质地柔软的米白色针织开衫，内搭一件浅色带有星点图案的吊带裙，整体着装风格简约而温馨。\"\n  },\n  \"scene\": {\n    \"location\": \"室内家居环境，可能是客厅或餐厅，布置温馨舒适。\",\n    \"time_of_day\": \"黄昏或傍晚，室内光线温暖柔和。\",\n    \"environment\": \"背景中悬挂着一块巨大的红蓝相间、带有复杂几何与花卉图案的波斯风格挂毯，纹理精致、色彩浓郁。她坐在一张带有米色编织纹理的桌前，桌面整洁。地面可见部分地毯，图案与背景挂毯呼应，营造出浓郁的异域文化氛围。\"\n  },\n  \"visual_details\": {\n    \"action\": \"BJDHXQ3 双手合十置于胸前，双眼轻闭，面带微笑，正虔诚地许愿或享受生日时刻的宁静美好。\",\n    \"props\": \"面前摆放着一个精致的生日蛋糕，蛋糕呈圆柱形，表面覆盖着浅米色奶油，装饰有奶油裱花、几颗绿色植物（可能是薄荷叶）和几颗黄绿色的水果（如小葡萄）。蛋糕上插着一根点燃的蓝色火焰蜡烛，火焰温暖跳跃。\",\n    \"action_sequence\": [\n      {\n        \"action\": \"BJDHXQ3 静静闭眼，双手合十，微微微笑，凝视蛋糕上的烛光，仿佛在心中许下愿望。\",\n        \"description\": \"画面聚焦于她平静的面部表情和烛光在她脸上的微弱反射。\"\n      },\n      {\n        \"action\": \"镜头保持静态，画面稳定，光线柔和地照亮她的脸庞和手部。\",\n        \"description\": \"烛光成为画面中唯一的动态光源，为整体增添温暖和仪式感。\"\n      }\n    ]\n  },\n  \"cinematography\": {\n    \"lighting\": \"主光源为柔和的暖色室内灯光，来自画面右上方，营造温暖、安宁的氛围。烛光作为补充光源，提供局部高光和氛围感，火焰在她脸颊和手部投下细腻的光影。\",\n    \"tone\": \"温馨、宁静、充满仪式感、梦幻般柔和，带有生活美学的诗意与祝福感。\"\n  }\n}"], "inputs": [{"shape": 7, "name": "anything", "link": 931, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 4, "bgcolor": "#593930", "size": [381.6622314453125, 361.70947265625], "pos": [10, 190], "id": 531, "properties": {"cnr_id": "comfyui-easy-use", "ver": "499ed4eafc3ad9d0f26e2cad40219a9e0d613fe5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 35}, {"outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "output"}], "color": "#323", "widgets_values": [], "inputs": [{"name": "anything", "link": 935, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy cleanGpuUsed", "mode": 4, "bgcolor": "#535", "size": [219.25538635253906, 26], "pos": [470, 310], "id": 534, "properties": {"cnr_id": "comfyui-easy-use", "ver": "499ed4eafc3ad9d0f26e2cad40219a9e0d613fe5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy cleanGpuUsed"}, "order": 37}, {"outputs": [{"name": "IMAGE", "links": [933], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#233", "widgets_values": ["SeedVR2 修复_00025_.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "up