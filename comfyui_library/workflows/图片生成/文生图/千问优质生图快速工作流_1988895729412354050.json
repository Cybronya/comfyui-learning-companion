[526.0740356445312, 286.543212890625], "pos": [719.1348266601562, -135.26800537109375], "widgets_values": ["这是一张现代浴室的照片，拍摄角度略低，强调了由百叶窗形成的水平线条。构图遵循三分法则，洗手池和镜子占据了上三分之一的位置。洗手池采用流线型矩形设计，台面为灰色，上面摆放着两个棕色液体皂液器。洗手池下方，一条叠得整整齐齐的白色毛巾放在一个白色柜子上。背景中，右侧是一个玻璃淋浴间，左侧是一扇装有水平百叶窗的窗户，为整个场景投下条纹状的阴影。景深适中，前景和背景都清晰可见。光线柔和，营造出一种平静而简约的氛围\n"], "inputs": [{"name": "clip", "link": 25, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 23, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"mode": 4, "outputs": [{"name": "MODEL", "links": [46], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [252.5318145751953, 82], "pos": [698.2733154296875, -293.4044494628906], "widgets_values": ["Qwen-Image-胶片摄影电影镜头.safetensors", 0.6], "inputs": [{"name": "model", "link": 41, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 31, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {"lora_name": true, "strength_model": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 8}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.26.11", "VHS_latentpreview": true, "groupNodes": {}, "ds": {"offset": [-224.55406971087467, 384.77971225876433], "