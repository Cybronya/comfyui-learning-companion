[1979.4012451171875, 486.90008544921875], "widgets_values": ["这是一座治愈感满满的微缩景观童话巧克力工厂，整体以鲜艳的暖色系为主调，全方位营造出软糯香甜、温馨治愈的梦幻氛围，所有建筑与设备结构都自带清甜质感。澄澈丝滑的巧克力液体河流缓缓环绕整个生产车间，浓稠温润的质感氛围感十足；复古的糖霜烟囱源源不断升腾起蓬松柔软的棉花糖蒸汽，轻飘飘萦绕在工厂上空，治愈又可爱。通透透亮的专属管道纵横交错，源源不断输送着缤纷圆润的糖果，一颗颗晶莹饱满、色彩鲜亮。整洁规整的自动化流水线上，各式造型精致的巧克力糖果整齐有序排列，造型可爱多样、质感醇厚诱人。厂房外墙整体覆盖着细腻酥脆的饼干纹理，肌理清晰、质感十足，氛围感拉满。匀速运转的传送带平稳运送着层层裹满绵密糖衣的香脆果仁，甜糯质感扑面而来。柔和的马卡龙色系灯光温柔铺满整个厂区，冷暖适配的光线烘托出满满的童话治愈感。\n车间内有数名造型软糯可爱的迷你工人，整体穿搭与工厂甜系风格完美适配，毫无违和感。简约工装，搭配小巧可爱的帽子，袖口与领口点缀细碎糖霜纹路，软萌精致。他们分工明确、动作轻柔娴熟，有的俯身细心整理流水线上的成品巧克力，轻轻摆正糖果位置、规整摆放造型；有的驻足管道旁，轻柔检查彩色糖豆的输送状态，微调设备参数，保障生产顺畅；还有的站在传送带侧边，细致分拣、清点裹糖果仁，细心剔除瑕疵原料。工人们动作轻柔舒缓、模样乖巧灵动，与软糯香甜的工厂环境完美相融，让整座微缩工厂既有井然有序的生产质感，又保留了可爱治愈的童话氛围感，整体画面鲜活生动、温馨治愈。"], "inputs": [{"name": "clip", "link": 5, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 9, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-902.9096236978105, -304.9407424993825], "scale": 0.8769226950000005}}, "groups": [], "links": [[2, 1, 0, 6, 0, "MODEL"], [3, 6, 0, 7, 0, "MODEL"], [4, 7, 0, 8, 0, "MODEL"], [5, 2, 0, 9, 0, "CLIP"], [6, 9, 0, 8, 1, "CONDITIONING"], [7, 9, 0, 10, 0, "CONDITIONING"], [8, 10, 0, 8, 2, "CONDITIONING"], [9, 11, 0, 8, 3, "LATENT"], [10, 8, 0, 13, 0, "LATENT"], [11, 3, 0, 13, 1, "VAE"], [12, 13, 0, 14, 0, "IMAGE"]], "id": "23a4c0ae-7abf-496a-b096-f91dc6b27e26", "config": {}, "version": 0.4, "last_node_id": 14, "revision": 0}