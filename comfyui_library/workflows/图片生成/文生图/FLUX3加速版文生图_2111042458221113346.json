真体裁。棕褐色长卷发，身披轻盈通透的欧根纱古风长裙，周身淡淡通体发光。精致全身构图，人物肢体舒展灵动，神情温婉缥缈。身侧环绕花灯与飘逸红绸，红绸随风舒展流动，墨色淡染背景，留白写意。水墨晕染质感，虚实相生，线条流畅大气，意识流氛围感，光影柔和朦胧，细节精美，东方诗意，高级构图。"], "inputs": [{"name": "clip", "link": 1, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 7, "type": "CLIPTextEncode", "title": "文生图提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "frontendVersion": "1.55.17", "ds": {"offset": [-169.05213352105767, 41.35753129669092], "scale": 1.4122927695244518}}, "groups": [], "links": [[1, 2, 0, 7, 0, "CLIP"], [2, 1, 0, 10, 0, "MODEL"], [3, 7, 0, 10, 1, "CONDITIONING"], [4, 13, 0, 14, 0, "NOISE"], [5, 10, 0, 14, 1, "GUIDER"], [6, 11, 0, 14, 2, "SAMPLER"], [7, 12, 0, 14, 3, "SIGMAS"], [8, 9, 0, 14, 4, "LATENT"], [9, 14, 0, 15, 0, "LATENT"], [10, 3, 0, 15, 1, "VAE"], [11, 15, 0, 16, 0, "IMAGE"]], "id": "36b2faff-1328-4d40-aee9-ac09d680e55d", "config": {}, "version": 0.4, "last_node_id": 17, "revision": 0}