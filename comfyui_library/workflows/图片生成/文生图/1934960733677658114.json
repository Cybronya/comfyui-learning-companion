window, shadow, border, house, plant, bush; \n\n## 要求\n1. 描述要详细、准确，充分展现都市背景图的情节和氛围。\n2. 语言生动、有趣，富有表现力。\n3. 输出一定是英文！！！！\n4. 输出不要出现人物！！！！\n\n\n## 限制\n1. 描述总长度不超过 350 个单词。\n2. 仅围绕用户提供的提示词进行描述，不添加无关内容。"], "inputs": [], "flags": {}, "id": 191, "type": "PrimitiveStringMultiline", "properties": {"Node name for S&R": "PrimitiveStringMultiline"}, "order": 8}, {"outputs": [{"name": "LATENT", "slot_index": 0, "links": [271], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "color": "#223", "widgets_values": [], "inputs": [{"name": "pixels", "link": 270, "label": "图像", "type": "IMAGE", "localized_name": "像素"}, {"name": "vae", "link": 290, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "type": "VAEEncode", "mode": 0, "bgcolor": "#335", "size": [303.52349853515625, 62.150394439697266], "pos": [362.6811828613281, 460.8436279296875], "id": 175, "properties": {"Node name for S&R": "VAEEncode"}, "order": 26}, {"mode": 0, "outputs": [{"name": "STRING", "links": [299], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [320.2431335449219, 256.0790100097656], "pos": [-1291.1009521484375, 1371.5869140625], "widgets_values": ["This is a scene from urban anime in the 1980s and 1990s, High quality images"], "inputs": [], "flags": {}, "id": 194, "type": "PrimitiveStringMultiline", "properties": {"Node name for S&R": "PrimitiveStringMultiline"}, "order": 9}, {"outputs": [], "color": "#322", "shape": 1, "widgets_values": [""], "inputs": [{"name": "images", "link": 240, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#533", "size": [709.4168090820312, 471.9714050292969], "pos": [242.94627380371094, 649.4306030273438], "id": 162, "properties": {"Node name for S&R": "PreviewImage"}, "order": 22}, {"outputs": [{"shape": 3, "name": "MODEL", "slot_index": 0, "links": [115, 281], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#322", "shape": 1, "wid