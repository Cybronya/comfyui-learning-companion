localized_name": "multiline"}, {"widget": {"name": "dotall"}, "name": "dotall", "label": "dotall", "type": "BOOLEAN", "localized_name": "dotall"}, {"widget": {"name": "group_index"}, "name": "group_index", "label": "group_index", "type": "INT", "localized_name": "group_index"}], "flags": {"collapsed": true}, "type": "RegexExtract", "title": "风格提取", "mode": 0, "bgcolor": "#353", "size": [225, 262.8511657714844], "pos": [4012.20556640625, 2644.406005859375], "id": 383, "properties": {"widget_ue_connectable": {"mode": true, "regex_pattern": true, "string": true, "case_insensitive": true, "multiline": true, "group_index": true, "dotall": true}, "Node name for S&R": "RegexExtract"}, "order": 29}, {"mode": 0, "outputs": [{"name": "*", "links": [], "label": "*", "type": "*"}], "size": [210, 50], "pos": [3717.4033203125, 3370.529541015625], "widgets_values": ["编号索引"], "inputs": [{"name": "*", "link": 566, "label": "*", "type": "*"}], "flags": {"collapsed": true}, "id": 359, "type": "SetNode", "title": "Set_编号索引", "properties": {"previousName": "编号索引", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.6"}, "widget_ue_connectable": {}, "aux_id": "SetNode", "Node name for S&R": "SetNode"}, "order": 32}, {"mode": 0, "outputs": [{"name": "输出", "links": [566], "label": "输出", "type": "*", "localized_name": "输出"}], "size": [210, 58], "pos": [3574.448974609375, 3370.042724609375], "widgets_values": ["string"], "inputs": [{"name": "*", "link": 565, "label": "*", "type": "*", "localized_name": "*"}, {"widget": {"name": "格式类型"}, "name": "格式类型", "label": "格式类型", "type": "COMBO", "localized_name": "格式类型"}], "flags": {"collapsed": true}, "id": 358, "type": "YUAN_TXTConvertAny", "properties": {"widget_ue_connectable": {"格式类型": true}, "Node name for S&R": "YUAN_TXTConvertAny"}, "order": 27}, {"outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["3D CG动漫武侠电影质感\n荒山雨夜中的破败山神庙。庙顶大面积塌陷成豁口，灰白雨光斜泻而下、雨线如万箭倾落；湿滑青石板地面缝隙积满雨水、映天光如碎镜；四围斑驳土墙半塌露出生土，庙门只余歪斜门框、粗木门柱与半截门槛；一根粗大乌黑横梁悬架于坍口边缘摇摇欲坠，满地碎瓦与积洼；庙外远景是雨雾吞没的荒山道与黑林轮廓。\n"], "inputs": [{"name": "text", "link": 596, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#353", "size": [511.1463928222656, 441.2669372558594], "pos": [3906.10595703125, 2998.3564453125], "id": 392, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 39}, {"outputs": [{"name": "positive", "links": [583], "label": "positive", "type": "STRING", "localized_name": "positive"}], "color": "#232", "widgets_values": ["{\n  \"整体风格\": \"3D CG动漫武侠电影质感，暴雨夜戏冷青灰色调，剑光银白与血色暗红点缀，快慢镜相济、动静反差强烈，冷峻凌厉的东方暴力美学。\",\n  \"角色档案\": [\n    \"沈惊鸿，男，二十六七岁，玄黑长发高束马尾、额前碎发沾雨、眉目冷峻，玄青色窄袖劲装束玄色腰带，黑色软底快靴。配装：腰后斜挂鲨皮鞘寒钢窄刃长剑，寒钢锻打、三尺窄刃、鲨鱼皮鞘白铜剑镡，右手随时可及。\",\n    \"朴刀客，男，虬髯浓密、灰布头巾缠头、臂膀粗壮，褐色粗布短打、缠绑腿、麻底布鞋。配装：双手持厚背宽刃朴刀，宽背厚脊、木柄缠旧麻绳。\",\n    \"铁蒺藜手，男，瘦削猴腮、细眼凹陷、鬓发贴面，靛蓝夜行紧身衣、黑布绑腿软靴。配装：右袖口皮质暗袋藏破空铁蒺藜数十枚，四角尖芒乌黑发亮、破空激射带哨音。\",\n    \"铁枪手，男，国字脸、浓眉压眼、颈缠灰布带，土黄色号坎、腕缚皮护腕、草绳束腰布鞋，无随身兵器。\",\n    \"枯瘦老者，男，鹤发束铁簪、颧骨高耸、眼窝深陷，灰布长袍袖口磨破、指节枯瘦如竹，黑布鞋。配装：十指指缝间缠绕锁魂银丝数十根，细若蛛丝、银白发亮、可发可收。\"\n  ],\n  \"音色档案\": [\n    \"沈惊鸿，冷峻克制的青年男声，音色清冽偏哑，吐字极简、语速平缓，每字收着力道，底色是雨夜般的冷静笃定。\",\n    \"朴刀客，粗嘎大嗓门，市井匪气浓重，语速急躁爱吼，底色蛮横。\",\n    \"铁蒺藜手，细尖嗓音、气声偏多，语速快而碎，透着阴狠算计。\",\n    \"铁枪手，闷雷般沙哑嗓，语速猛、字字砸地，喊杀时嘶吼劈裂。\",\n    \"枯瘦老者，苍老枯涩的沙哑嗓，气息绵长、语速极慢，阴鸷倨傲、字缝里带寒意。\"\n  ],\n  \"道具档案\": [\n    \"铁杆红缨长枪，丈余纯铁枪杆乌黑遍布磨痕，菱形枪头寒光凛冽，枪颈系一簇被雨打湿贴杆的暗红缨穗。\",\n    \"鹿角柄备用短刀，一尺余长短，鹿角柄磨得油亮，窄直刀刃带崩口，铁镡锈斑斑驳、柄尾缠旧麻绳。\"\n  ],\n  \"场景档案\": [\n    \"荒山雨夜中的破败山神庙。庙顶大面积塌陷成豁口，灰白雨光斜泻而下、雨线如万箭倾落；湿滑青石板地面缝隙积满雨水、映天光如碎镜；四围斑驳土墙半塌露出生土，庙门只余歪斜门框、粗木门柱与半截门槛；一根粗大乌黑横梁悬架于坍口边缘摇摇欲坠，满地碎瓦与积洼；庙外远景是雨雾吞没的荒山道与黑林轮廓。\"\n  ],\n  \"分镜序列\": [\n    {\n      \"编号\": 1,\n      \"类型\": \"武戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-万箭雨落三袭齐至\",\n      \"时间段\": [\n        \"一个高机位俯冲推拉大全景镜头框住暴雨夜的荒山雨夜破败山神庙，雨线如万箭倾落砸穿庙顶豁口、在瓦面溅起白雾，庙门只剩歪斜门框与半截门槛，沈惊鸿玄青色身影踏过门槛积水步入庙内，腰后鲨皮鞘寒钢窄刃长剑随步伐轻晃，檐水成帘在他身后垂落，万点雨声砸瓦的密集闷响铺满声场。\",\n        \"the camera cuts to 低机位急推中近景，灰白雨光勾出沈惊鸿冷峻侧脸轮廓，雨珠沿玄黑马尾发梢滑坠下颌，他瞳孔骤缩、视线连扫庙内左、右、前三处暗影，右手虎口悄然反扣剑柄、指节压紧鲨皮鞘口。\",\n        \"the shot changes to 快速横移全景揭示，庙内三名袭击者同时暴起——左侧朴刀客怒喝抡起厚背宽刃朴刀横斩沈惊鸿腰际、刀风撕开雨帘，右侧铁蒺藜手右袖疾抖、两枚破空铁蒺藜撕裂雨幕直钉他咽喉，正面铁枪手踏碎青石突进、铁杆红缨长枪如毒龙出洞直取心口，三道寒光同时劈至。\",\n        \"the camera cuts to 360度高速环绕加侧切特写(Arc Shot)，三道寒光绞杀合拢，沈惊鸿足尖一点、整个人倒仰折成弓形，厚背宽刃朴刀贴着鼻尖削过、斩断几缕额发，两枚破空铁蒺藜擦着发顶掠飞，雨水被三股兵锋搅成粉碎水雾。\",\n        \"the shot transitions to 命中定点特写，两枚破空铁蒺藜去势不减，「夺夺」两声钉入沈惊鸿身后粗木门柱，尖芒没入寸余、木屑混雨水炸开，柱身震颤、檐水簌簌滑落。\",\n        \"the camera cuts to 急推侧切中近景，铁杆红缨长枪枪尖透雨刺至心口前三寸，沈惊鸿左手两指闪电般一夹、指节扣死乌黑枪杆，枪身骤停、暗红缨穗狂甩，雨水沿枪杆激射成线，枪尖寒光在他指前寸许剧烈震颤。\",\n        \"the shot changes to 快速推近剧烈震动，沈惊鸿右手反拔腰后鲨皮鞘寒钢窄刃长剑，「锵」一声龙吟出鞘，白虹剑光撕开雨雾，剑身映着灰白天光泛起银亮水痕。\",\n        \"the camera cuts to 贴地动态跟随(Tracking Shot)，沈惊鸿剑脊贴着铁杆红缨长枪枪身顺势一滑，火星沿乌黑枪杆迸溅成线，剑锋直削向铁枪手十指，水雾被剑气压出一条真空沟。\",\n        \"the shot transitions to 手持微晃近景，剑光掠过铁枪手十指，虎口崩裂、血珠混雨飞溅，他闷哼撒手弃枪、连人带退势后仰，铁杆红缨长枪斜倒向积水。\",\n        \"the camera cuts to 中景快切，沈惊鸿顺势五指扣住坠落枪尾一挑，整杆铁杆红缨长枪离地旋起、暗红缨穗甩出血色圆环，携满幅雨点横砸向左侧朴刀客，破空撕响。\",\n        \"the shot changes to 命中定点余波慢镜，朴刀客举厚背宽刃朴刀仓促格挡，「铛」一声金铁爆鸣炸开，双臂弯震、虎口迸裂渗血，蹬蹬连退五步、靴底踏碎青石边缘积水，枪杆余势未衰撞落在地弹跳两下。\",\n        \"the camera cuts to 中全景收束，沈惊鸿拄剑立于门柱内雨柱之间，雨水顺剑尖连成银线滴落，朴刀客拄刀撑住摇摇欲坠，铁蒺藜手与铁枪手分踞两翼蓄势再扑，杀气在雨声里绷紧未散。\"\n      ],\n      \"环境音\": \"暴雨砸瓦与檐水成帘的密集声底，三件兵器同时破空的撕裂声，剑刃出鞘龙吟、剑脊滑枪杆的金属锐响与火星迸溅声，枪杆砸落的金铁爆鸣，夹杂沈惊鸿短促的发力吐息。\",\n      \"BGM\": \"快节奏武侠战斗配乐，密集堂鼓与琵琶轮指层层推进，弦乐急攀，在三袭齐至的瞬间鼓点炸开，收于一声剑鸣。\"\n    },\n    {\n      \"编号\": 2,\n      \"类型\": \"武戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-碎砖封目落雁三剑\",\n      \"时间段\": [\n        \"一个低机位贴地中全景镜头框住连退五步的朴刀客，他后背撞上斑驳土墙、厚背宽刃朴刀拄地撑身、溅起一柱积水，腰间鹿角柄备用短刀被震脱手甩落积洼；沈惊鸿踏水前掠不给喘息，衣摆剪开雨幕、靴底踏碎倒影。\",\n        \"the camera cuts to 道具微观特写，沈惊鸿足尖一挑，青石缝里一块碎砖腾空旋起，砖上青苔与雨水甩落成弧。\",\n        \"the shot changes to 急推中近景，沈惊鸿右掌托住碎砖一送、内力灌注，「轰」然闷响中碎砖半空炸成齑粉，粉尘激射成锥形弹幕扑向朴刀客面门，雨点打在粉雾上噼啪炸响。\",\n        \"the camera cuts to 命中定点近景，粉雾锥轰中朴刀客面门，皮肉绽裂、血水混灰浆迸溅，他仰面栽退、后脑磕上土墙，厚背宽刃朴刀当啷脱手，整个人血肉模糊滑坐墙根、抽搐难起。\",\n        \"the shot transitions to 快速横移中景，右侧铁蒺藜手惊觉疾退、右袖连甩，三枚破空铁蒺藜近距封锁沈惊鸿面门胸前三点，寒芒撕开雨帘。\",\n        \"the camera cuts to 急推中近景，沈惊鸿腕花连转，鲨皮鞘寒钢窄刃长剑闪出三朵剑花，「铮铮铮」将三枚破空铁蒺藜尽数磕飞钉入土墙没至尾芒，剑势不停、斜削下盘——「落雁七式」第一剑削膝。\",\n        \"the shot changes to 侧切特写，铁蒺藜手撤腿侧闪半步，剑光仍贴胫骨掠过、裤裂血线，他闷哼矮身反扑、指爪直抠沈惊鸿持剑手腕。\",\n        \"the camera cuts to 360度高速环绕加侧切特写(Arc Shot)，沈惊鸿手腕一沉一翻，第二剑逆势上撩断腕，「咔」脆响，铁蒺藜手右腕筋断爪垂、反扑之势自溃，身体失衡前倾。\",\n        \"the shot transitions to 命中定点决胜慢镜，第三剑透肩，剑尖自锁骨下透出背肌半寸，血珠沿剑身滑落混入雨水，雨珠悬停、剑光未敛。\",\n        \"the camera cuts to 中景，沈惊鸿抽剑撤步，铁蒺藜手惨叫倒地翻滚、压碎一片碎瓦，积水被暗红血色晕开。\",\n        \"the shot changes to 全景扫视，朴刀客血肉模糊瘫坐墙根、铁蒺藜手抱腕哀嚎侧卧，庙内雨柱如帘；庙门阴影里铁枪手狞笑弯腰，从积洼中拔出鹿角柄备用短刀、反握在手。\",\n        \"the camera cuts to 中近景收束，铁枪手嘶吼扑来、短刀劈风直落，沈惊鸿侧身让过、刀锋贴肋削断一缕衣带，两人错身而立，雨珠在二人之间悬而未落，下一击将发未发。\"\n      ],\n      \"环境音\": \"砖块炸裂成粉的爆响、粉雾扑面的钝击声，剑花磕飞铁蒺藜的连环脆响，筋断骨裂的闷响与惨叫，雨水与血滴入积洼的滴答声。\",\n      \"BGM\": \"急促鼓点与琵琶扫弦交替，节奏密不透风，落雁三剑连击处加入镲片炸响，随惨叫倒地骤然抽空，只余雨声。\"\n    },\n    {\n      \"编号\": 3,\n      \"类型\": \"武戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-碎岳断墙灰影坠顶\",\n      \"时间段\": [\n        \"一个手持跟拍中全景镜头框住回身再扑的铁枪手，他反握鹿角柄备用短刀连劈颈肩三刀、刀刀撕风，沈惊鸿游步闪避、靴底踏水步步生澜，刀锋次次擦衣而过。\",\n        \"the camera cuts to 侧切中近景，短刀第三次斜劈至半，沈惊鸿侧身让过空门，反手倒握鲨皮鞘寒钢窄刃长剑、以剑柄铁镡回撞铁枪手太阳穴。\",\n        \"the shot changes to 命中定点特写，剑柄铁镡重重磕上太阳穴，皮肉凹陷、青紫瞬间鼓起，铁枪手眼白上翻、横里踉跄，鹿角柄备用短刀挥空走偏。\",\n        \"the camera cuts to 急推胸腹中近景，沈惊鸿左掌同时拍出、掌心贴上前胸布料，「碎岳劲」透体而入，布料向后炸裂成蝶、雨珠倒飞。\",\n        \"the shot transitions to 高速环绕全景，内劲在铁枪手胸腔炸开，他双脚离地倒飞丈许、四肢僵直，鹿角柄备用短刀脱手旋飞，雨幕被冲开一条真空走廊，尘水两分。\",\n        \"the camera cuts to 命中定点决胜慢镜，铁枪手背部轰然撞塌半面土墙，生土墙体砸落如瀑、尘雨交混，他嵌进墙洞缓缓滑落、再无声息。\",\n        \"the shot changes to 空镜中景余波，塌墙尘雾缓缓沉降，雨水灌进墙洞冲刷浮土，鹿角柄备用短刀斜插积洼、刀柄犹自轻颤。\",\n        \"the camera cuts to 中近景，沈惊鸿还剑入鞘、「咔」轻响，指腹摩挲鲨皮鞘面，抬眼扫过瘫坐的朴刀客与哀嚎的铁蒺藜手，胸口微伏，一滴檐水顺鞘滴落。\",\n        \"the shot transitions to 仰拍特写骤变，头顶庙顶乌黑横梁毫无征兆「咔啦」炸裂，椽木崩断、碎木瓦片裹雨水倾泻而下。\",\n        \"the camera cuts to 快速拉远大全景，一道灰影裹挟碎木自庙顶豁口坠落、灰袍鼓荡如鹫，双掌挟风雷之势当头拍向沈惊鸿天灵。\",\n        \"the shot changes to 剧烈震动贴地仰拍，沈惊鸿仰身疾退、后背几乎贴地，青石地面在眼前倒掠成虚影，老者双掌拍空、掌风轰然掠过他胸前，气浪掀飞满地碎瓦。\",\n        \"the camera cuts to 命中定点特写，掌风过处沈惊鸿胸前衣襟尽数碎裂成蝶飘飞、露出的内衬猎猎作响，他倒退路径的青石地面上两枚深陷掌印正冒碎石尘。\",\n        \"the shot changes to 中近景收束，灰影落地无声，枯瘦老者佝身而立、鹤发铁簪映着雨光，十指如钩缓缓抬起，指缝间锁魂银丝在灰白天光下泛起冷芒，雨水滴过他周身竟似绕行。\"\n      ],\n      \"环境音\": \"短刀劈风的呼啸、剑柄击颞的闷响，碎岳劲透体的低频轰鸣，土墙轰塌的崩落声与尘水交混声，横梁炸裂、椽木崩断的脆响，灰影坠地的破空声与掌风爆鸣。\",\n      \"BGM\": \"低音唢呐与战鼓对撞，杀气凝重，碎岳劲命中时全奏推至顶点，随土墙轰塌骤收一拍，灰影坠顶处再起一声重鼓。\"\n    },\n    {\n      \"编号\": 4,\n      \"类型\": \"武戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-千丝锁魂死网缠剑\",\n      \"时间段\": [\n        \"一个低机位中全景镜头框住佝身而立的枯瘦老者，他十指一抖，数十根锁魂银丝离指激射、化作十道银亮流光，自上下左右斜角十个方位绞向沈惊鸿周身大穴，雨珠被丝线切分为二。\",\n        \"the camera cuts to 急推中近景，沈惊鸿鲨皮鞘寒钢窄刃长剑横扫、低喝「破」字诀，剑气凝成白刃光弧外放，「铮铮铮」连响，三根锁魂银丝应声而断、断丝蜷曲坠地如枯发。\",\n        \"the shot changes to 道具微观特写，余下七根锁魂银丝诡变换位、如活蛇绕开剑气光弧，「唰」地缠上鲨皮鞘寒钢窄刃长剑剑身，一匝、两匝、三匝勒紧，丝线嵌进血槽。\",\n        \"the camera cuts to 双人对峙中景，枯瘦老者五指猛然一收，锁魂银丝骤然绷紧铮鸣，沈惊鸿握剑手臂被拽得前倾、靴底在湿滑青石上犁出两道水痕，整具身体连人带剑被拖拽滑向老者。\",\n        \"the shot transitions to 极速推拉特写，拖拽途中沈惊鸿剑锋顺势回削一带，一线剑光掠过老者右手小指、快得雨珠未及溅落、无人察觉；五指随即松开，鲨皮鞘寒钢窄刃长剑脱手、被银丝吊在半空打转，他借拖拽之势反向弹步欺进。\",\n        \"the camera cuts to 360度高速环绕加侧切特写(Arc Shot)，两人相距不过三尺，数十根锁魂银丝在二人之间上下穿飞、绷成一张死亡之网，银丝交错将雨幕分割成千百格。\",\n        \"the shot changes to 手持微晃近景，沈惊鸿双掌翻飞以赤手接丝、内力灌注指尖、指节泛白，一根锁魂银丝缠上左腕，他拇指一弹、「弹指神通」脆响震开银丝。\",\n        \"the camera cuts to 侧切特写，又一缕锁魂银丝割向咽喉，他二指并拢一夹一振、丝线震颤崩飞，几根发丝被削断飘落。\",\n        \"the shot transitions to 快速推近，枯瘦老者十指连弹、银丝攻势如织机穿梭，十指对十指，每一次指尖交击都迸出细微金属颤音，雨珠在丝网间被切碎成雾。\",\n        \"the camera cuts to 明暗交界过肩双人，老者眼窝阴影里眸光狠戾，骤然收紧十指，死亡之网猛然向内收缩、勒向沈惊鸿周身。\",\n        \"the shot changes to 中近景，沈惊鸿双臂交叠撑住收拢的丝网边缘，银丝勒进小臂衣料、割裂渗血，他低喝发力、浑身筋骨上绷，丝网收缩之势被生生顶停。\",\n        \"the camera cuts to 特写收束，两人隔着绷紧的银丝网对视，雨光下数十根锁魂银丝震颤如琴弦、嗡鸣未绝，老者指节缓缓回收蓄势，半空被吊着的鲨皮鞘寒钢窄刃长剑犹自打转，杀机再起。\"\n      ],\n      \"环境音\": \"银丝破空的细锐哨音、丝线绞缠剑身的铮鸣，弹指神通的脆响，丝网震颤的金属颤音层层叠加，雨声被切成碎响。\",\n      \"BGM\": \"悬紧的弦乐颤音与古琴煞音铺底，银丝铮鸣采样融入节拍，弃剑一瞬弦乐骤停半拍，死亡之网对峙时低音持续轰鸣。\"\n    },\n    {\n      \"编号\": 5,\n      \"类型\": \"武戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-拳膝对轰白虹掷剑\",\n      \"时间段\": [\n        \"一个快速推近中全景镜头框住变招的枯瘦老者，他十指一收，数十根锁魂银丝尽数缩回、层层缠绕双臂如银鳞护甲，半空吊着的鲨皮鞘寒钢窄刃长剑「当啷」坠入积洼，他双拳一握、骨节爆响如炒豆。\",\n        \"the camera cuts to 侧冲跟拍中景，老者欺身直进，双拳直捣连环、拳风沉厚掀开雨帘，每一拳都带着「嗡」的低鸣、震得地面积水泛起涟漪。\",\n        \"the shot changes to 游走大全景，沈惊鸿身法展开「游身步」，步幅碎小、身形飘忽，左闪、右滑、后撤、斜绕，七拳连环擦着发梢衣角轰过，青石地面被拳风砸出点点浅坑。\",\n        \"the camera cuts to 主观急推特写，第八拳直捣面门、避无可避，拳锋充满画面、嗡鸣震耳。\",\n        \"the shot transitions to 命中定点中近景，沈惊鸿提膝硬撞，膝骨与拳锋正面相撞，「咔嚓」脆响炸开，冲击气环荡开周身雨雾。\",\n        \"the camera cuts to 双人分退全景，二人同时倒退，老者蹬蹬蹬倒滑数步、灰袍翻卷，沈惊鸿借退势滑出丈余、靴底犁开积水。\",\n        \"the shot changes to 贴地特写，沈惊鸿退势未尽、脚尖一勾一卷，坠在积洼中的鲨皮鞘寒钢窄刃长剑翻起，剑柄落回掌心、五指扣紧。\",\n        \"the camera cuts to 急推中近景，沈惊鸿反手一掷，长剑脱手化作一道白虹、撕开雨幕，直取枯瘦老者面门。\",\n        \"the shot changes to 侧切特写，老者头颅急侧，剑锋贴颊掠过、削断一绺鹤发，他右手一翻、袖间锁魂银丝弹出一缕缠住飞掠的剑身一带——长剑被扯偏斜飞，「夺」地钉入庙顶乌黑横梁、剑柄没入寸余颤鸣不止。\",\n        \"the shot transitions to 极速推拉中景，银丝缠剑一带的刹那，沈惊鸿已欺身而到、灰袍残影与他擦身交错，他不要剑了，右掌蓄满十成内力、五指并拢如刀、掌缘泛起白气。\",\n        \"the camera cuts to 命中定点决胜慢镜，一记手刀劈落，正中老者扯线的右手手腕，腕骨应声而折、皮肉凹陷错位，锁魂银丝自指间脱手散落。\",\n        \"the shot changes to 低角度仰拍收束，沈惊鸿杀招未尽、左肘已顶向老者肋下，右膝同步提起撞向小腹，老者折腕的右臂甩向身侧、袍袖翻卷，两道杀招将触未触、雨珠凝在半空。\"\n      ],\n      \"环境音\": \"拳风嗡鸣沉厚如闷雷、连拳破空声，膝骨与拳锋相撞的咔嚓脆响，长剑掷出的撕裂声与钉入横梁的夺响，腕骨折断的脆响与银丝散落的簌簌声。\",\n      \"BGM\": \"拳拳到肉的战鼓重拍与低音号角交织，掷剑白虹处弦乐瞬间拉满，腕骨断裂脆响与音乐同频骤停。\"\n    },\n    {\n      \"编号\": 6,\n      \"类型\": \"武戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-肘膝连杀双掌轰顶\",\n      \"时间段\": [\n        \"一个贴身高速跟拍中近景镜头框住杀招连绵的沈惊鸿，左肘顶入枯瘦老者肋下、肋骨闷响错裂，老者身形一歪、折腕的右臂仍抡向沈惊鸿面门。\",\n        \"the camera cuts to 侧切中近景，沈惊鸿俯身让过抡臂、右膝同时撞上老者小腹，闷响沉厚，老者上身折成虾形、涎水混血甩出，反扑之力被生生撞散。\",\n        \"the shot changes to 手持微晃特写，老者左手死死抠住沈惊鸿左肩、欲拖他同倒，指爪抠裂布料，锁魂银丝残缕自袖口滑垂。\",\n        \"the camera cuts to 急推仰拍，沈惊鸿右臂猛振挣脱指爪、气浪鼓荡碎衣，双掌高举过顶、掌心相对蓄势，周身雨雾被内力逼成一圈白环。\",\n        \"the shot changes to 明暗交界近景，老者眼窝里凶光暴起，拼尽残力以头槌撞向沈惊鸿前胸，灰发甩起、铁簪映寒光。\",\n        \"the shot transitions to 命中定点决胜慢镜，沈惊鸿沉腰坐马、双掌自头槊两侧合落轰顶天灵，「轰」然爆鸣炸满全庙，气浪自二人脚下环形炸开、掀飞满地碎瓦与银丝残缕，雨幕被冲得倒卷。\",\n        \"the camera cuts to 低角度仰拍，枯瘦老者双膝砸地、青石碎裂如蛛网蔓延开去，裂纹里渗出积水，灰袍尘埃簌簌而落。\",\n        \"the shot changes to 特写，老者口中溢血、血线沿下颌滴落青石晕开，他仍死死盯着沈惊鸿、眼窝深处的眸光不肯熄灭。\",\n        \"the camera cuts to 中全景余波，气浪缓缓平息、雨水重新落满全庙，沈惊鸿立在跪伏的老者身前、碎裂衣襟贴着起伏的胸口，满地碎瓦间银丝残光点点。\",\n        \"the camera cuts to 中近景收束，沈惊鸿垂眼看了老者一瞬、转身踏过积洼，走向庙顶乌黑横梁下钉着的鲨皮鞘寒钢窄刃长剑。\"\n      ],\n      \"环境音\": \"贴身短打的闷响连环，肋骨错裂与膝撞腹的沉响，指爪抠裂布料的锐响，双掌合击天灵的轰然爆鸣，青石碎裂蔓延的脆响与血滴入洼声。\",\n      \"BGM\": \"全奏堆叠的决胜配乐，鼓、号、弦层层压顶，双掌合击天灵的轰鸣与配乐同时在最高点炸开，随后一切骤静，只余雨声与血滴。\"\n    },\n    {\n      \"编号\": 7,\n      \"类型\": \"文戏：15秒\",\n      \"标题\": \"荒山雨夜破败山神庙-少了一根线\",\n      \"时间段\": [\n        \"中近景跟随，灰白雨光自庙顶豁口斜泻，沈惊鸿踏过满地碎瓦走到乌黑横梁下方，抬手握住钉入梁木的鲨皮鞘寒钢窄刃长剑剑柄、腕上青筋微隆，缓缓拔出，「咯」的一声木屑轻响，剑身出梁的刹那，积在剑刃上的雨水顺着剑身淌落成线、滴碎在青石上。\",\n        \"At 00:04.000 焦点转移至中景，沈惊鸿提剑转身、雨水沿剑尖连缀滴落，他望向跪伏在蛛网裂纹中央的枯瘦老者，碎裂的衣襟贴着起伏的胸口，视线平静无波。\",\n        \"At 00:07.500 近景，枯瘦老者口角血痕未干、双膝陷在碎裂青石间，仍死死仰视沈惊鸿，眼窝阴影里眸光阴鸷未散，沈惊鸿淡淡道：<d>[Chinese]你的「千丝锁魂手」——少了一根线。</d>说完后他垂下眼帘，指尖在剑柄上轻轻一收。\",\n        \"At 00:11.000 特写，枯瘦老者瞳孔骤然收缩成针尖，视线猛地坠向自己右手——小指齐根而断、断口平滑如镜、血珠将凝未凝；闪回插入：弃剑之前那一瞬，一线剑光贴着他的右手小指掠过、快得雨珠未及溅落。\",\n        \"At 00:13.000 中全景，老者瞳孔里的光一寸寸熄灭，向后直挺挺倒去、后脑砸上碎裂青石一声闷响、再未动弹，雨水落满他睁着的眼，沈惊鸿立在原地未动，剑尖雨水滴落成串。\"\n      ],\n      \"环境音\": \"环境音很轻，以破庙雨声与檐水滴落为主，贴合拔剑的木屑轻响、剑身雨水淌落滴碎声与老者倒地的闷响，质感写实，音量始终低于台词。\",\n      \"BGM\": \"低音量苍凉古琴独奏，泛音清冷、节奏极缓，在台词落下后渐弱收于雨声，只余一根弦的余韵。\"\n    },\n    {\n      \"编号\": 8,\n      \"类型\": \"文戏：10秒\",\n      \"标题\": \"荒山雨夜破败山神庙-雨幕吞没\",\n      \"时间段\": [\n        \"中近景，灰白雨光里，沈惊鸿还剑入鞘、「咔」的一声轻响被雨声半掩，指腹在鲨皮鞘面上停了一瞬。\",\n        \"At 00:03.000 跟随全景，他踏过满地碎瓦、断裂银丝与血水积洼，玄青背影一步一步走向庙门，碎裂的衣襟后摆随步伐轻摆，雨水在他肩头连成水线。\",\n        \"At 00:06.500 大全景，庙内死寂，跪伏的枯瘦老者、瘫坐墙根的朴刀客、侧卧的铁蒺藜手与塌开的土墙洞尽收一框，尘埃与血色在积水中缓缓洇开，沈惊鸿的身影已步出门外雨幕。\",\n        \"At 00:08.500 空镜收束，镜头缓缓推向庙门外，只有倾盆雨幕吞没荒山道与远去的玄青背影，雨声重新淹没一切。\"\n      ],\n      \"环境音\": \"环境音很轻，以倾盆雨声为主体，还剑入鞘轻响、踏碎瓦的碎响与水洼脚步声依次点缀，质感写实，全段无台词。\",\n      \"BGM\": \"低音量箫声独奏，音色空远微哑，节奏散板渐稀，随背影没入雨幕后彻底淡出，只留雨声。\"\n    }\n  ]\n}\n"], "inputs": [{"widget": {"name": "positive"}, "name": "positive", "label": "positive", "type": "STRING", "localized_name": "positive"}], "flags": {"pinned": true}, "type": "easy positive", "title": "分镜总提示词", "mode": 0, "bgcolor": "#353", "