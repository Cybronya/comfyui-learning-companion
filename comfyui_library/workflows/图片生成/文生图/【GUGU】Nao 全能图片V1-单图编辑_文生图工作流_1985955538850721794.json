性的阴影，并给整个场景披上一层温暖、空灵的光辉。下方是广阔而平静的海洋，延伸至地平线，点缀着几艘船只，而翻腾的薄雾云团则依附在周围雄伟的悬崖峭壁和山谷之间。整个场景弥漫着深刻的成就感、团结和令人振奋的自由气氛。超广角镜头、电影感、史诗级风光、冒险摄影、高细节、戏剧性背光、体积光、镜头光晕、单反相机画质、无可见面孔，只有剪影。", 610, "randomize", "auto"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "advanced_options"}, "shape": 7, "name": "advanced_options", "label": "advanced_options", "type": "COMBO", "localized_name": "advanced_options"}], "flags": {}, "id": 4, "type": "RH_Translator", "title": "提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Translator"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image", "links": [8], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [347, 326], "pos": [1061.116943359375, 372.169921875], "widgets_values": ["", 834441960, "randomize", "16:9"], "inputs": [{"shape": 7, "name": "images", "link": 3, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 4, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}], "flags": {}, "id": 1, "type": "RH_Nano_Banana_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&