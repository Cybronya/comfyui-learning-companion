 {"widget": {"name": "n_ctx"}, "name": "n_ctx", "label": "n_ctx", "type": "INT", "localized_name": "n_ctx"}, {"widget": {"name": "vram_limit"}, "name": "vram_limit", "label": "vram_limit", "type": "INT", "localized_name": "vram_limit"}, {"widget": {"name": "image_min_tokens"}, "name": "image_min_tokens", "label": "image_min_tokens", "type": "INT", "localized_name": "image_min_tokens"}, {"widget": {"name": "image_max_tokens"}, "name": "image_max_tokens", "label": "image_max_tokens", "type": "INT", "localized_name": "image_max_tokens"}], "flags": {"collapsed": false}, "id": 162, "type": "llama_cpp_model_loader", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"image_min_tokens": true, "vram_limit": true, "mmproj": true, "model": true, "n_ctx": true, "chat_handler": true, "image_max_tokens": true}, "aux_id": "lihaoyun6/ComfyUI-llama-cpp_vlm", "Node name for S&R": "llama_cpp_model_loader"}, "order": 7}, {"outputs": [{"name": "STRING", "links": [238], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#323", "widgets_values": ["角色设定\n你是一名专业的文生图提示词优化专家，专门为中文用户服务。你的任务是将用户简短、模糊的中文描述，转化为详细、精确且富有画面感的中文提示词，并确保其能够被文生图模型准确理解。\n\n核心任务\n将用户输入的“基础描述”转化为“优质中文提示词”。\n\n优化流程与规范\n1. 理解与分析\n识别核心要素：明确用户描述中的主体、动作、场景。\n\n判断风格倾向：分析用户潜在需求（如写实、动漫、国风、科幻等）。\n\n捕捉情绪氛围：理解画面需要传递的情绪（如宁静、震撼、欢乐、神秘）。\n\n2. 结构化扩展\n你将按照以下固定结构对提示词进行层层细化：\n\n【画面质量与类型】 + 【核心主体】 + 【场景与环境】 + 【艺术风格】 + 【构图与光影】 + 【色彩与氛围】\n\n每个部分的扩展原则如下：\n\n【画面质量与类型】：自动补充如“最高质量”、“8K分辨率”、“电影质感”、“细节丰富”、“照片级真实感”或“大师级绘画”等标签。\n\n【核心主体】：对人物、生物或主要物体的外观、神态、服饰、材质、动作进行具体描述。\n\n【场景与环境】：详细刻画背景、时间、天气、空间、道具等环境细节。\n\n【艺术风格】：指定如“赛博朋克”、“水墨丹青”、“吉卜力动画”、“蒸汽波”、“北欧极简”等具体风格。\n\n【构图与光影】：设计“全景”、“特写”、“黄金分割”等构图，以及“戏剧性灯光”、“柔光”、“逆光”等光影效果。\n\n【色彩与氛围】：定义“浓郁配色”、“柔和色调”、“冰冷科技感”、“温暖治愈”等色彩和整体氛围。\n\n3. 输出格式\n只需输出最终完整提示词，可直接粘贴给AI绘图工具使用的提示词部分。\n\n提供基础信息如下："], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {"collapsed": true}, "type": "PrimitiveStringMultiline", "title": "简短提示词强化", "mode": 0, "bgcolor": "#535", "size": [404.7121887207031, 314.0351257324219], "pos": [-663.82373046875, 819.9608764648438], "id": 157, "properties": {"cnr_id": "comfy-core", "ver": "0.24.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 8}, {"outputs": [{"name": "MODEL", "links": [202], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#233", "widgets_values": ["realism_engine_krea2_v1.safetensors", 1], "inputs": [{"name": "model", "link": 201, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#355", "size": [443.7908020019531, 106], "pos": [-1260.19921875, 1269.87646484375], "id": 131, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 11}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [244], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [210, 46], "pos": [185.668701171875, 941.873291015625], "widgets_values": [], "inputs": [{"name": "samples", "link": 180, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 188, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {"c