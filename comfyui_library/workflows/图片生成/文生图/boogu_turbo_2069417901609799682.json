ze": [400, 200], "pos": [1624.3271484375, 4941.41943359375], "widgets_values": ["Image of a red panda holding a sign that says \"BOOGU!\""], "inputs": [{"name": "clip", "link": 11, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 69, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 11, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"outputs": [{"name": "text", "links": [69], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["室内日常氛围感人像。固定人物：年轻亚洲男模，约24-28岁，人物气质参考张凌赫类型，清俊高挑、干净温润、带一点清冷贵气。脸型修长偏小，轮廓干净，下颌线清晰但不粗硬；眉眼深邃清澈，双眼皮明显，眼型偏长，眼神温柔安静但有距离感；鼻梁高挺自然，嘴唇线条清晰，五官精致立体。皮肤冷白细腻，真实自然，不要塑料感。发型为深棕色或棕黑色凌乱微卷短发，发丝蓬松，有空气感和层次感。整体年轻男演员感，清冷温柔，低调高级，不要欧美硬汉感，不要网红整容脸，不要过度女性化。\n\n人物坐在室内餐桌旁，穿黑色衣物，动作偏日常抓拍：身体微微前倾，轻松自然地看向镜头，表情带一点俏皮的微笑，像聊天间隙被顺手拍到。一只手随意拿着一个小酒杯，另一只手自然搭在桌边或轻扶桌面。桌上摆放着装有液体的容器以及几个杯子，呈现生活化餐桌场景。\n\n镜头位于餐桌对面，距离人物约1.2到1.5米，35mm镜头，机位略低于人物眼睛一点，上半身构图。背景是有时尚设计感的木质纹理墙面，整体空间低调奢华但不过分张扬。环境偏暗，人物面部有柔和重点打光，明暗对比突出人物，氛围静谧、亲近、有生活感。不要过度摆拍，不要影棚硬照感，不要背景杂乱。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [436.65045166015625, 420.94964599609375], "pos": [923.0756225585938, 5367.12158203125], "id": 35, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [67], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [270, 526], "pos": [2182.001953125, 4918.62353515625], "widgets_values": [1042498428801787, "randomize", 4, 1, "lcm", "sgm_uniform", 1], "inputs": [{"name": "model", "link": 63, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 64, "label": "positive", "type": "CONDITIONING", "localized_name": "p