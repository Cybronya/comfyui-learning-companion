笑意，呈现自然放松的动态感，整体风格为简约韩系通勤风，兼具日常休闲感与精致设计感，画面质感高级通透，符合时尚街拍调性\n"], "inputs": [{"name": "clip", "link": 180, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 47, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.45", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [98], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 130], "pos": [1254.356689453125, 642.58447265625], "widgets_values": [896, 1600, 1, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 183, "label": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "link": 184, "label": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "length"}, "name": "length", "label": "length", "type": "INT", "localized_name": "长度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "批量大小"}], "flags": {}, "id": 68, "type": "EmptyHunyuanLatentVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.3.34", "widget_ue_connectable": {}, "Node name for S&R": "EmptyHunyuanLatentVideo"}, "order": 5}, {"mode": 0, "outputs": [{"name": "INT", "links": [183], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [893.3709106445312, 642.147705078125], "widgets_values": [900], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 115, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 1}, {"mode": 0, "outputs": [{"name": "INT", "links": [184], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [893.32373046875, 776.58447265625], 