lized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "type": "KSampler", "mode": 0, "bgcolor": "#535", "size": [315, 474], "pos": [1174.7535400390625, 684.6546020507812], "id": 44, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.64", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "KSampler", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"outputs": [{"name": "CONDITIONING", "links": [40], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["一幅高精度、具有强烈时尚感的商业人像摄影作品，采用特写镜头（Close-up Shot），聚焦于两位年轻女性与一只金毛幼犬的亲密互动瞬间。\n\n**光影 (Lighting):**\n- 采用专业的影棚布光，主光源为从左前方45度角打来的柔和漫射光，均匀而明亮，完美照亮了人物的面部轮廓、皮肤质感和狗狗的毛发。\n- 在人物右侧和背景上形成了柔和的阴影，增强了画面的立体感和层次感，但没有生硬的明暗分界，营造出温暖、舒适的氛围。\n- 光线在金毛犬蓬松的毛发上形成细腻的高光，使其看起来柔软而富有光泽，同时保留了毛发的自然纹理。\n- 整体色调明亮、干净，以暖白色为主，突出了人物的健康肤色和场景的温馨感。\n\n**构图 (Composition):**\n- 采用紧凑的中心构图，三位主体（两位女性和一只狗）紧密地依偎在一起，占据了画面的绝大部分空间，强化了“亲密无间”的主题。\n- 两位女性的脸颊相贴，目光或直视镜头或温柔地看向对方，形成了强烈的视觉焦点和情感连接。\n- 金毛犬被夹在两人中间，头部微微抬起，眼神温顺，成为画面的视觉中心和情感纽带。\n- 背景为纯净的浅灰色或米白色，没有任何杂物或干扰元素，确保观众的注意力完全集中在主体身上。\n\n**景别 (Shot Size):**\n- 特写镜头（Close-up），从人物胸部以上到头顶，完整展现了人物的表情、妆容、配饰以及狗狗的可爱神态。\n- 这种景别能够最大限度地捕捉到人物细微的表情变化和情感流露，让观众感受到她们之间的深厚情谊。\n\n**主体 (Subject):**\n- **左侧女性**：一位面容清秀的年轻女性，身穿一件简约的白色抹胸上衣，露出优美的肩颈线条。她戴着一副夸张的橙色大框太阳镜，嘴角带着灿烂的笑容，显得活泼、俏皮且充满活力。\n- **右侧女性**：另一位年轻的东亚女性，身穿一件带有鲜艳花卉刺绣图案的黑色旗袍式连衣裙，妆容精致，尤其是眼妆和唇妆，显得优雅、成熟而有气场。她的表情沉静而温柔，与左侧女性的活泼形成有趣的对比。\n- **金毛犬**：一只可爱的金毛幼犬，毛发蓬松柔软，眼神温顺，被两位女性温柔地环抱在怀中，是整个画面的核心和情感载体。\n\n**环境 (Environment):**\n- 环境极简，仅为一个纯色的摄影棚背景墙，颜色为浅灰或米白，没有任何装饰物或杂物。\n- 这种极简的环境设计是为了突出主体，避免任何视觉干扰，让观众的视线完全集中在人物和狗狗的互动上。\n\n**摄影风格 (Photography Style):**\n- 风格为高端时尚杂志人像摄影，追求超高清细节和电影般的质感。\n- 模拟使用中画幅相机和大光圈定焦镜头拍摄，背景有轻微的虚化，但人物和狗狗的细节依然保持清晰锐利。\n- 后期调色以高饱和度、高对比度为主，突出服装和配饰的色彩，同时保持皮肤的自然质感，不过度磨皮。\n\n**整体氛围 (Atmosphere):**\n- 整体氛围是温馨、愉悦、充满爱意和时尚感的。两位女性的不同风格（活泼与优雅）与狗狗的可爱形成了一种奇妙的和谐，传递出一种跨越物种的友谊和陪伴的美好。"], "inputs": [{"name": "clip", "link": 43, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [410, 370], "pos": [0, 0], "id": 45, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 12}, {"outputs": [{"name": "CLIP", "links": [43, 71], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#323", "widgets_values": ["qwen_3_4b.safetensors", "lumina2", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#535", "size": [389.6735534667969, 106], "pos": [395.4064025878906, 684.6546020507812], "id": 39, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"directory_invalid": true, "name": "qwen_3_4b.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/text_encoders/qwen_3_4b.safetensors"}], "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPLoader", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 3}, {"outputs": [{"name": "CONDITIONING", "links": [72], "label": "CONDITIONING", "type": "CO