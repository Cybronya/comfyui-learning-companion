e": "STRING", "localized_name": "text"}], "flags": {}, "id": 20, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 3}, {"mode": 0, "outputs": [{"name": "output", "links": [21], "type": "*", "localized_name": "output"}], "size": [369.082275390625, 256.7684631347656], "pos": [973.51611328125, -333.5204772949219], "widgets_values": ["主题完善与扩写如下：\n\n主题：写实风格，一位东方面孔女性，容貌秀丽端庄，五官精致柔和，肌肤如玉，气质典雅高贵。她身材匀称修长，体态婀娜，胸部微微露出上半部，呈现出含蓄而富有东方韵味的美感，既不失古典含蓄之美，又彰显女性柔美曲线。身着一袭华丽精致的明代制式汉服，衣料以织金云锦制成，主色调为朱红与黛青，绣有凤凰穿牡丹、祥云缭绕等吉祥纹样，衣袂飘逸，层次分明，尽显皇家气韵。头戴点翠嵌宝凤冠，金丝缠绕，珠玉垂帘，凤鸟展翅欲飞，映衬其高贵身份。右手轻执一把苏绣面绢面纸扇，扇面绘有西湖春晓图，笔触细腻，意境悠远；左手轻提裙裾，姿态优雅从容。脚穿一双绣工繁复的翘头汉鞋，鞋面以金线绣出莲花纹，鞋尖微翘，典雅古朴。\n\n她静立于春日清晨的西湖岸边，身后是薄雾轻笼的湖面，断桥若隐若现，垂柳依依，桃花纷飞，远处雷峰塔影影绰绰，倒映水中。晨光微曦，金色霞光洒在湖面与她的衣裙之上，泛起淡淡光晕，仿佛置身于一幅流动的古典画卷。微风拂过，发丝与裙角轻扬，纸扇微启，似欲轻吟一曲江南小调。整体画面融合东方美学与写实技法，光影细腻，细节逼真，营造出如梦似幻的诗意氛围，既展现中华传统服饰之美，又传达出古典女性温婉、自信与从容的精神气质。"], "inputs": [{"shape": 7, "name": "anything", "link": 27, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 16, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 7}, {"mode": 0, "outputs": [{"name": "image", "links": [33], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 418], "pos": [1158.8592529296875, 154.96261596679688], "widgets_values": ["tiny", 2, true, true, true, 256, 24, false, 2, 3, 11, 915769731781244, "randomize", "cuda", "bf16", "sparse_sage_attention"], "inputs": [{"name": "frames", "link": 32, "label": "frames", "type": "IMAGE", "localized_name": "frames"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"name": "scale"}, "name": "scale", "label": "scale", "type": "INT", "localized_name": "scale"}, {"widget": {"name": "color_fix"}, "name": "color_fix", "label": "color_fix", "type": "BOOLEAN", "localized_name": "color_fix"}, {"widget": {"name": "tiled_vae"}, "name": "