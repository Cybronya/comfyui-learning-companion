me": "strength_model"}, "name": "strength_model", "label": "模型强度", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {"collapsed": true}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#335", "size": [297.3392028808594, 82], "pos": [1190, 5030], "id": 94, "properties": {"cnr_id": "comfy-core", "ver": "0.26.0", "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 18}, {"outputs": [{"name": "text", "links": [86, 149], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["主体：一台胡桃木色水阻划船机，实木框架结构，透明圆柱形水箱内装蓝色水体，黑色防滑坐垫配金属滑轨，黑色人体工学握把，前端搭载倾斜式高清显示屏，机身侧面印有白色品牌标识，整体呈现高端木质健身器材质感\n场景：场景是豪宅级别的大平层私密空间，画面右侧是一面胡桃木纹饰面装饰墙，木纹自然深浅交错，远处是一整面落地全景玻璃窗，窗外是雾气缭绕的原始森林景观，高大松树与冷杉在薄雾中若隐若现，深灰色哑光地面，深灰色哑光平顶天花板，远处靠窗位置摆放两张黑色单人皮质沙发与小型边几，窗边立一棵造型黑松盆景，整体空间极简大气，静谧私密\n镜头：等效 35mm 广角镜头，偏低角度轻微仰拍，左前侧 45° 视角，f/4 光圈，中等景深，产品主体锐利清晰，背景环境柔和虚化但细节可辨，垂直透视矫正，商业产品摄影镜头语言，空间纵深感强\n构图：竖幅大空间场景，极简构图，产品位于画面中下偏左视觉重心，上方与右侧留白充足，前景水箱、中景划船机主体、背景落地窗与森林形成三层空间层次，高级感家居氛围\n光影：主光源来自左侧落地窗的漫射自然光，雾气柔化后的柔和天光均匀洒入室内，木质表面呈现细腻光泽，地面与墙面形成自然反弹光，室内整体偏暗调，产品受光充分立体，暗部层次丰富，无强烈硬阴影，天花板有微弱环境顶光\n色调：低饱和暗棕灰调，深胡桃木棕为主基底，深炭灰哑光天花板与暗调空间，冷灰蓝色调的窗外森林雾气，暖棕木质与冷灰环境形成冷暖对冲，莫兰迪低灰度色彩，哑光质感，暗调轻奢，电影感柔化色阶，柔和漫反射光影，无高饱和艳色，水箱蓝色水体为微量冷色点缀"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [480, 5300], "id": 48, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 10}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-1491.7642227834779, -5260.32517718982], "scale": 1.7088742511246031}}, "groups": [{"color": "#8A8", "font_size": 24, "fl