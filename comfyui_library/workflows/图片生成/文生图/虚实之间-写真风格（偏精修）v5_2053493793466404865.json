_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 10}, {"outputs": [{"name": "CONDITIONING", "links": [94, 99], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["这是一幅中景特写镜头，采用平视角度拍摄。\n\n一位身材苗条、皮肤白皙，胸部超级巨大的年轻东亚女性站立在波光粼粼的湖水前，身体微微向右侧倾斜，头部略微向左侧转动，目光柔和地望向左侧远方。她留着一头深色盘发，几缕轻盈的刘海自然地垂落在脸颊两侧，右耳后佩戴着一串长长的淡橙色花朵发饰，如瀑布般垂落在肩膀上。她的妆容精致而清淡，带有淡淡的粉色眼影和腮红，双唇微启，神情平静而略带一丝忧郁。\n\n画面整体采用温暖、柔和的自然色调，带有复古的暖金色滤镜。\n\n夕阳的金色逆光从右后方洒下，为女子的轮廓、发丝以及右侧手臂镀上一层耀眼的金色轮廓光，而她的面部则处于柔和的阴影与微弱的反射光中，光影过渡细腻。拍摄采用平视角度，焦距较浅，使背景中的湖水和远处的白色建筑呈现出梦幻的虚化效果。构图上采用三分法，将女子置于画面中央偏左的位置，左上角延伸出的绿色树叶在光影下呈现出半透明的嫩绿色，为画面增添了生机与层次感。\n\n她身穿一件米金色复古抹胸紧身胸衣，面料呈现出精美的提花暗纹质感，边缘点缀着精致的褶边，胸前系有一根米白色丝带。她的颈部佩戴着一双层白色珍珠项链，耳垂上缀有一颗小巧的珍珠耳环。整套穿搭展现出优雅、古典而浪漫的维多利亚风格。"], "inputs": [{"name": "clip", "link": 275, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [456.7753601074219, 435.0620422363281], "pos": [996.181396484375, 145.46385192871094], "id": 67, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 9}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [102, 478], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [204.134765625, 26], "pos": [1181.