-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 3}, {"outputs": [{"name": "LATENT", "links": [5], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "color": "#232", "widgets_values": [1280, 736, 5], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "type": "EmptyMiniMaxH3LatentAV", "mode": 0, "bgcolor": "#353", "size": [397.261474609375, 106], "pos": [-5607.462890625, -2365.242431640625], "id": 16, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "EmptyMiniMaxH3LatentAV"}, "order": 4}, {"outputs": [{"name": "CONDITIONING", "links": [19, 20], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#323", "widgets_values": ["生成一张横版16:9的经典奇幻海盗寻宝探险地图，完整地图平铺展示，正上方俯视视角。画面是一张年代久远的泛黄羊皮纸，具有自然卷曲的边缘、轻微烧焦痕迹、折叠纹路、褪色墨迹和手工绘制质感。地图必须像一件真实可用的寻宝道具，而不是普通风景画或电影海报。\n\n地图中央是一座被深色海洋环绕的神秘岛屿，岛屿轮廓复杂清晰，包含海岸、沙滩、森林、河流、山脉、峡谷、沼泽、遗迹、洞穴和火山。所有区域采用精致的古典钢笔线稿与棕褐色水彩绘制，局部使用暗红色标记路线，细节丰富但版面清楚易读。\n\n路线从岛屿左下角的“启航港”开始。这里绘有木质码头、一艘小帆船、酒桶和破旧灯塔。红色虚线从启航港出发，依次经过以下地点：\n\n1. “迷雾森林”：位于岛屿左侧，大量扭曲古树、浓雾和乌鸦形成危险氛围。\n2. “断剑峡谷”：位于岛屿中央偏下，两侧是陡峭岩壁，峡谷入口插着一把断裂巨剑。\n3. “沉睡神庙”：位于岛屿中央，绘有被藤蔓覆盖的古代石门、残破石柱和神秘太阳图腾。\n4. “龙骨洞穴”：位于岛屿右侧，洞口形似巨龙头骨，周围散落巨大骨骼与岩石。\n5. “赤焰火山”：位于岛屿右上方，火山口冒出少量烟雾，附近地面布满裂缝。\n\n红色虚线路线必须连续、清晰且没有断裂，从“启航港”按顺序经过全部地标，最终抵达赤焰火山后方的一处隐秘山谷。终点使用醒目的暗红色“X”标记，并在旁边绘制半埋在泥土中的古老宝箱、金币、宝石和一把金色钥匙。终点旁清晰标注“宝藏”。\n\n海洋区域加入古代航海装饰：左上角绘制一艘遭遇风暴的破帆船，右下角绘制一只从海面伸出触手的巨大海怪，海岸附近绘制暗礁、沉船和鲸鱼剪影。地图左下方加入精致的八方向航海罗盘，右下方加入简单比例尺。地图边缘使用绳结、船锚、骷髅、羽毛笔和火漆印章作为少量装饰，不遮挡主体地图。\n\n地图顶部中央以清晰、端正、古老探险风格的中文标题写出：“失落之岛寻宝图”。\n\n地图中只出现以下中文文字，并确保文字完整、清楚、方向正确、不得错写或重复：\n“失落之岛寻宝图”\n“启航港”\n“迷雾森林”\n“断剑峡谷”\n“沉睡神庙”\n“龙骨洞穴”\n“赤焰火山”\n“宝藏”\n\n整体美术风格：高级奇幻概念设计、古典航海制图、精细钢笔线稿、棕褐色水彩、真实羊皮纸纹理、手绘地形符号、丰富微小细节、清晰空间层级、电影道具级质感。暖棕色、深褐色、暗红色和少量墨绿色配色，四周略暗、中心区域清晰明亮。\n\n严格要求：保持横版完整地图构图，整张羊皮纸必须完整出现在画面中；路线必须从左下角连续通向右上角；所有地标必须彼此独立且容易识别；宝藏终点只能有一个；不要生成人物肖像，不要生成现代建筑，不要生成现代电子界面，不要生成卫星地图，不要生成三维游戏场景，不要生成电影海报，不要出现英文、乱码、多余文字、水印、边框裁切或重复地标。"], "inputs": [{"name": "clip", "link": 18, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#535", "size": [514.3638305664062, 224.21192932128906], "pos": [-5063.2919921875, -2799.024658203125], "id": 12, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 10}, {"outputs": [{"name": "SAMPLER", "links": [3], "label": "采样器", "type": "SAMPLER", "localized_name": "采样器"}], "color": "#232", "widgets_values": ["euler"], "inputs": [{"widget": {"name": "sampler_name"}, "name": "sampler_name", "type": "COMBO", "localized_name": "采样器"}], "flags": {}, "type": "KSamplerSelect", "mode": 0, "bgcolor": "#353", "size": [210, 60], "pos": [-4364.08935546875, -2667.08349609375], "id": 19, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "KSamplerSelect"}, "order": 5}, {"outputs": [{"name": "SIGMAS", "links": [4], "label": "Sigmas", "type": "SIGMAS", "localized_name": "Sigmas"}], "color": "#232", "widgets_values": ["simple", 16, 1], "inputs": [{"name": "model", "link": 21, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "scheduler"