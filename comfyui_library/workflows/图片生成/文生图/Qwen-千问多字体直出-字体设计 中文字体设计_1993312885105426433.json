lized_name": "剪枝类型"}], "flags": {}, "id": 23, "type": "UNETLoader", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "UNETLoader", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 1}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [33, 34], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [338.83563232421875, 268.421142578125], "pos": [-1217.4462890625, 1013.406494140625], "widgets_values": ["这是一幅彩色设计风格的文字图片，背景为全黑色，突显鲜艳的渐变色文字和设计元素。字体大小、颜色和样式各异，充满活力和动感。\n\n主要文字内容分为中文和英文两部分：\n\n1. **“GO!”**  \n   - 位于图片的首行，字体较大且醒目，采用黄色和粉色的渐变效果，带有立体效果。\n   - 右侧有一个小“®”符号，表明可能涉及商标相关内容。\n\n2. **“LOGO”**  \n   - 紧挨着“GO!”的右上方，字体较小，颜色是白色，简单直白。\n\n3. **“就是现在”**  \n   - 中文文字，字体较大且设计感强，颜色渐变从黄色到粉色，文字表现具有手写风格，周围伴有飞溅状的彩色笔触（红色、黄色、粉色、绿色等），营造一种热情奔放的氛围。\n\n4. **“LET’S GO! Right Now”**  \n   - 英文部分在图片的底部，字体颜色较淡但同样以渐变呈现，从蓝色到紫色。\n   - 英文内容与上方中文内容相呼应，进一步强调行动的时间点“现在”。\n\n图片整体色彩鲜明，设计充满能量。文字周围点缀着各种彩色线条和元素，比如闪电形状、弧线等，使整个画面更加生动且富有动感。这幅图片通常给人一种积极向上、鼓励行动的感觉，可能用于宣传活动或者品牌推广。"], "inputs": [{"name": "clip", "link": 32, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 25, "type": "CLIPTextEncode", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 4}, {"mode": 0, "outputs": [{"name": "width", "label": "宽度", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "高度", "type": "INT", "localized_name": "height"}, {"name": "upscale_factor", "label": "放大系数", "type": "FLOAT", "localized_name": "upscale_factor"}, {"name": "batch_size", "label": "批次大小", "type": "INT", "localized_name": "batch_size"}, {"name": "empty_latent", "links": [35],