黑色的亮面塑料椅，带金属支架，椅面有明显高光反射，像候车椅一样对称分布，增强空间层次；前景地面散落数本杂志和白色印刷纸张，右下角纸页有局部黑色英文，左下角杂志封面露出人物照片，营造随性拍摄现场感；整体风格是时尚大片、杂志封面、Y2K运动甜酷美学、干净高对比、红蓝撞色极强、锐利清晰、商业摄影质感、略低机位全身构图、50mm左右自然透视、细节丰富、不要多余人物、不要背景杂物过多、不要文字乱码、不要手部畸形、不要服装结构错误。 \n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "String (Multiline - Prompt)", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [-682.2077026367188, -636.7348022460938], "id": 99, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 9}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.42.10", "VHS_latentpreview": false, "ds": {"offset": [1402.836318125883, 830.1098270991033], "scale": 1.0610764609500056}}, "groups": [{"color": "#8A8", "font_size": 24, "flags": {}, "id": 2, "title": "Group", "bounding": [-1264.2470703125, -735.6192626953125, 992.0393676757812, 653.5999755859375]}], "links": [[102, 93, 0, 92, 0, "LATENT"], [103, 96, 0, 92, 1, "VAE"], [104, 91, 0, 93, 0, "MODEL"], [105, 94, 0, 93, 1, "CONDITIONING"], [106, 90, 0, 93, 3, "LATENT"], [107, 95, 0, 94, 0, "CLIP"], [114, 94, 0, 97, 0, "CONDITIONING"], [115, 97, 0, 93, 2, "CONDITIONING"], [116, 99, 0, 98, 2, "STRING"], [117, 103, 0, 100, 0, "CLIP"], [118, 107, 0, 100, 2, "STRING"], [119, 99, 0, 102, 0, "STRING"], [120, 100, 0, 102, 1, "STRING"], [121, 101, 0, 102, 2, "BOOLEAN"], [122, 98, 0, 106, 0, "STRING"], [123, 104, 0, 106, 2, "STRING"], [124, 106, 0, 107