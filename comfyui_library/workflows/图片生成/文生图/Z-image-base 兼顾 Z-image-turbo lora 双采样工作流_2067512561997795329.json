: 17}, {"mode": 0, "outputs": [{"name": "string", "links": [74], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [474.0371398925781, 282.8038635253906], "pos": [2227.030029296875, 441.6473388671875], "widgets_values": ["主体人物\n1 位年轻东亚清纯高颜值女生，乌黑柔顺长直发，精致鹅蛋脸，柔和清透原生妆容，自然灵动的大眼睛，温柔直视镜头，嘴角带浅浅微笑，五官精致立体，皮肤白皙细腻，纤细苗条身材，紧致小蛮腰，修长笔直双腿，身形匀称有曲线感。\n穿搭细节\n红白条纹短款曼联球衣（露腰露脐剪裁），白色运动超短裤，纯白色过膝长筒丝袜，白色厚底老爹休闲运动鞋，球衣带有曼联队徽与阿迪达斯三条杠经典设计。\n场景环境\n复古清吧室内场景，深色实木吧台，吧台后方多层酒柜摆满各式威士忌、洋酒玻璃瓶，吧台上摆放高脚红酒杯、透明玻璃杯，右上角亮着粉色霓虹发光「BAR」英文字母灯牌，昏暗复古工业风酒吧环境，深色墙面与深色水泥地面。\n光影画质与摄影参数\n专业商业人像摄影，电影氛围感光影，局部暖调轮廓光，暗调低光环境，人物面部柔和补光，明暗对比强烈，氛围感逆光，背景轻微虚化浅景深；8K 超高清，RAW 原图，索尼 A7M4 相机拍摄，50mm f1.4 大光圈镜头，超高细节，皮肤质感真实细腻，发丝根根分明，高清锐化，色彩浓郁高级，写实真人照片质感，极致写实，超高分辨率，色彩饱和度适中，夜景人像氛围感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 46, "type": "Text", "properties": {"hasSecondTab": false, "ver": "495f9773dd3651a366ebac664fc4b0f301e9b1b3", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "aux_id": "TFL-TFL/ComfyUI_Text_Translation", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "Text", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [66], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}, {"name": "CLIP", "links": [67], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [446.61761474609375, 246], "pos": [3202.090576171875, 929.0415649414062], "widgets_values": ["Z-Image-Fun-Lora-Distill-8-Steps-2603.safetensors", 1.0000000000000002, "Tifa-DIFA001Z_20.safetensors", 1.0000000000000002, "None", 1, "None", 1], "inputs": [{"name": "model", "link": 65, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "clip", "link": 64, "label": "clip", "type": "CLIP", "localized_name"