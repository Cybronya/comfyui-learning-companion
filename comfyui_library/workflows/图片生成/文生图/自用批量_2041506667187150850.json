写 + [面部/情绪描写] + [服装材质] + [人物位置描述] + [符合角色设定的背景描述] + [画质风格描述]。\\n\"\n    \"5. 格式要求：输出一段完整连贯的英文段落，总字数 250 字以内，严禁使用中括号或圆括号。每个提示词独立成段。\\n\"\n    \"6. 视觉风格：确保针对移动端优化的图形化背景。\"\n)"], "inputs": [{"shape": 7, "name": "image1", "link": 11, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 10, "type": "RH_Captioner_Pro", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Captioner_Pro"}, "order": 1}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [11], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [515.5120239257812, 667.8544921875], "pos": [748.4308471679688, 273.584716796875], "widgets_values": ["cdad2616a46d659200ede8c2491a65445edae4142cb1b3899e6d5c19c2e221ad.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "im