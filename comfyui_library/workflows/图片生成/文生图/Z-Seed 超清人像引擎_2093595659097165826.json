来，穿透清澈的池水，在她脸颊下方投下摇曳的水波纹光影，水面反射的碎光像星星一样跳跃在她的锁骨和肩膀上。她的头发在水中散开如黑色的丝绸，发丝随水波轻轻浮动。她微微仰头看向镜头，睫毛上挂着细小的水珠，嘴角带着一丝慵懒的笑意，神情松弛而惬意。极简干净的构图，高调光线，水面高光与阴影过渡柔和。50mm镜头拍摄，f/1.8，背景为虚化的池底马赛克瓷砖与摇曳的水光，蓝绿色与白色交织的液态模糊。高分辨率，8k，杰作，照片级真实，明亮通透的美感，柯达Portra 400胶片风格，细腻胶片颗粒，清新水色调，夏日慵懒的诗意。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [266.1783447265625, 419.3640441894531], "pos": [98.13729858398438, -141.13726806640625], "id": 106, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "image", "links": [155, 203], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [324.30352783203125, 422.87982177734375], "pos": [2033.935791015625, -708.23828125], "widgets_values": [717, "fixed", 1024, 4000, 5, false, "lab", 0, 0, 0, 0, "cpu", false], "inputs": [{"name": "image", "link": 165, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "dit", "link": 152, "label": "dit", "type": "SEEDVR2_DIT", "localized_name": "dit"}, {"name": "vae", "link": 153, "label": "vae", "type": "SEEDVR2_VAE", "localized_name": "vae"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "name": "resolution", "link": 173, "label": "resolution", "type": "INT", "localized_name": "resolution"}, {"widget": {"name": "max_resolution"}, "name": "max_resolution", "label": "max_resolution", "type": "INT", "localized_name": "max_resolution"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}, {