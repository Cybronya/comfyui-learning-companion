青灰绿，低饱和却层次丰盈，空气里仿佛弥漫着花粉般的朦胧光雾，宛如从古画中走出的灵韵之境。", "新中式仙侠美学写真，近景俯拍一位身着素雅纱质汉服的美女，发丝如墨瀑般垂落，细腻卷曲，在微风中轻扬。她侧脸被林间斜射的晨光温柔包裹，高光柔和，肤若凝脂，眼眸低垂若有所思。背景是在一个亭子中，亭子下是池塘，里面开着荷花，整体影调偏青灰绿", "新中式仙侠美学写真，空中俯拍远景，一位身着素雅纱质汉服的美女，发丝如墨瀑般垂落，在微风中轻扬。整体影调偏青灰绿，她躺着，手上拿着青梅酒在喝酒的姿态，在池塘中的小舟上喝酒，周围是荷花", "新中式仙侠美学写真，古代的房屋，在室内的场景，中景镜头，有一盆枯萎的花在视觉的中心在桌子上放着，背景是房屋的窗户，中心对称构图", "新中式仙侠美学写真一位的少女（身着素雅纱质汉服的美女，发丝如墨瀑般垂落，细腻卷曲，整体偏青灰色调）静静地坐在一位男子（身着黑色汉服的帅哥）身旁。这位少女有着白皙如雪的肌肤，看起来极其美丽。她身着流畅的青色素雅纱质汉服，与男子形成鲜明对比，男子一只手拿着发光的宝石，另一只手抱着紧握着他的少女。背景是在一个中式的房间里，朴素的房间，女子和男子共同在欣赏手上的玉器"], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "列表（可选）", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [435.81268310546875, 600.1346435546875], "pos": [801.5039672851562, 506.2147521972656], "id": 27, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptList"}, "order": 4}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-676.3646834627772, -226.47554877968832], "scale": 1.1671841070450024}}, "groups": [], "links": [[1, 7, 0, 2, 0, "CLIP"], [3, 1, 0, 6, 0, "MODEL"], [4, 2, 0, 6, 1, "CONDITIONING"], [6, 2, 0, 8, 0, "CONDITIONING"], [7, 8, 0, 6, 2, "CONDITIONING"], [9, 6, 0, 10, 0, "LATENT"],