tputs": [{"name": "text", "links": [3, 15, 38], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [490, 390], "pos": [7251.4326171875, 2279.9736328125], "widgets_values": ["这是一张以主观视角为核心的自拍式中景特写画面，捕捉了一位年轻女性在室内镜前展示身着改良旗袍的优雅身姿。\n\n主体位于画面中央偏右的位置，呈侧面站立姿态，身体微微向左侧扭转以突显S型曲线。她右手持手机遮面自拍，左手轻抚右侧腰腹，头部微微上扬，下巴微收，展现出自信而妩媚的神态。她留着一头乌黑的短发，两侧扎着精致的小发髻，发髻上点缀着深红色的蝴蝶结发饰，发丝柔顺地垂落在脸颊旁。妆容精致，皮肤白皙透亮。\n\n画面主体被一层带有冷调与复古质感的滤镜覆盖，使得黑色的丝绸旗袍在灰暗的背景下显得尤为深沉与高级。旗袍面料呈现出丝滑的光泽，上面布满了暗红色的繁复花卉提花图案，剪裁极度修身，紧紧包裹着女性的丰满上围与纤细腰肢，裙摆右侧开叉较高，露出了修长白皙的大腿，丝袜质感细腻。\n\n灯光效果呈现为柔和的漫反射，光源似乎来自人物右前方，在旗袍的肩部和背部勾勒出细腻的高光，同时在她左侧的锁骨与腹部形成柔和的阴影，增强了身体的立体感。拍摄角度为平视镜头，视线与镜中倒影齐平。构图上采用了经典的三分构图法，人物占据了画面的视觉重心，左侧的深灰色门框形成了强烈的垂直引导线，增加了画面的纵深感。背景是一面素雅的浅灰色墙壁，左侧一扇深灰色的房门紧闭，门把手线条简洁，上方贴着一张带有黑色剪影图案的贴纸，右下角隐约可见堆叠的杂物，背景处理得相对清晰，与主体共同营造出一种生活化且静谧的氛围。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 32, "type": "CR Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 10}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.44.19", "VHS_latentpreview": false, "ds": {"offset": [-8055.60449248101, -1215.464971488912], "scale": 0.8769226950000008}}, "groups": [], "links": [[1, 30, 0, 2, 0, "MODEL"], [2, 8, 0, 3, 0, "CLIP"], [3, 32, 0, 3, 1, "STRING"], [4, 9, 0, 4, 0, "CLIP"], [5, 2, 0, 5, 0, "MODEL"], [6, 3, 0, 5, 1, "CONDITIONING"], [7, 22, 0, 5, 2, "CONDITIONING"], [8, 17, 0, 5, 3, "LATENT"], [9, 26, 0, 5, 6, "INT"], [10, 25, 0, 5, 10, "INT"], [11, 9, 0, 6, 0, "CLIP"], [13, 5, 0, 7, 0, "LATENT"], [