inks": [69], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [366.95684814453125, 201.18008422851562], "pos": [2842.781982421875, 702.0830688476562], "widgets_values": ["alariko，视点位于赤道洋面上的一座巨型人工浮岛城市。画面的视觉中心是一根直径数百米、通体漆黑的碳纳米管缆绳，它像一根神针一样刺破苍穹，直插云霄，缆绳表面没有任何反光，只有几道笔直的航空警示激光束沿着缆绳向上无限延伸； 围绕缆绳基座的是三座呈三角形分布的巨型锚定塔，塔身由高强度的白色石墨烯复合材料浇筑，表面布满了像电路板一样的应力感应纹路，实时显示着缆绳的张力数据； 在缆绳的外侧，数个巨大的环形“攀爬者”货运舱正在缓缓上升，它们的底部喷射出微弱的姿态调整气流，金属外壳上印着醒目的航空航天局标志；基座周围的港口区极度繁忙，海面上停泊着几十艘全自动化的集装箱货轮， 城市的空中交通被严格分层，低空是密集的个人飞行载具流，它们沿着虚拟航道排队飞行，每一辆载具的尾部都拖着淡蓝色的离子推进余晖； 在画面的近景处，一个位于高塔边缘的空中管制平台上，几名身穿外骨骼辅助装甲的工作人员正在检修一台巨大的信号发射雷达，雷达的抛物面天线正在缓慢旋转，折射出金属特有的冷冽光泽。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 20, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 15}, {"outputs": [{"name": "prompt", "links": [70], "label": "提示词", "type": "STRING", "localized_name": "prompt"}], "color": "#233", "widgets_values": [""], "inputs": [{"shape": 7, "name": "prompt1", "link": 68, "label": "提示词1", "type": "STRING", "localized_name": "prompt1"}, {"shape": 7, "name": "prompt2", "link": 69, "label": "提示词2", "type": "STRING", "localized_name": "prompt2"}, {"widget": {"name": "separator"}, "shape": 7, "name": "separator", "type": "STRING", "localized_name": "间隔符"}], "flags": {"collapsed": true}, "type": "easy promptConcat", "mode": 0, "bgcolor": "#355", "size": [270, 78], "pos": [3123.113037109375, 713.749755859375], "id": 63, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptConcat"}, "order": 18}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-2338.834413667849, -311.3229343472443], "scale": 1.1671841070450042}}, "groups": [{"color": "#3f789e", "font_size": 240, "flags": {}, "id": 1, "t