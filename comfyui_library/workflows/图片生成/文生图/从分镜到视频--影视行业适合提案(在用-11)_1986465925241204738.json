mperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 1, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1, 4, 7], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314.0000305175781], "pos": [-233.150634765625, 1082.5560302734375], "widgets_values": ["e186cfe21872da85d40f59db83f021f79a67f2290cceb95f75cdc6f485589b83.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 2, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"mode": 2, "outputs": [{"name": "text", "links": [2], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [271.3069763183594, 339.31524658203125], "widgets_values": ["根据参考图生赤橙·月度养生盲盒的广告分镜 12格分镜图。\n\n【镜头1：痛点暴击】（0-3秒）  \n画面：财富经理深夜加班，桌上堆满未送出的月饼券、咖啡卡，像在清点过期库存。  \n客户接过礼品，面无表情，转身就把卡塞进抽屉角落，落灰。  \n\n**画外音**（冷峻、直戳心窝）：  \n“你每年花几十万做客户维护——结果呢？客户连你是谁都不记得。”  \n\n**字幕**：  \n传统维护=烧钱买遗忘  \n\n---\n\n【镜头2：赤橙登场】（3-9秒）  \n画面切换：清晨，一位高净值客户拆开一个精致礼盒——  \n一月，是艾草养生枕，附一句：“您体质偏寒，适合温养安神。”  \n八月，是长夏健脾茶饮，卡片写着：“湿气重时节，脾胃最需呵护。”  \n\n镜头推进：AI健康建议卡上，赫然印着**“根据您的体检报告与节气定制”**。  \n礼盒底部，银行LOGO低调浮现，高级感拉满。  \n\n**画外音**（节奏加快，带点狠劲）：  \n“别人送卡，我们送关心。  \n不是礼品，是每月一次的‘被惦记’。”  \n\n**字幕**：  \n赤橙·月度养生盲盒  \n12次精准触达，胜过1次豪礼轰炸  \n\n---\n\n【镜头3：效果说话】（9-12秒）  \n画面：客户主动打电话给理财经理：“你们那个养生茶不错，顺便……我有笔资金想重新配置。”  \n\n屏幕闪现数据：  \n✅ 客户满意度 ↑30%  \n✅ 理财咨询量 ↑45%  \n\n**画外音**（笃定）：  \n“不是我们多会搞关系——  \n是客户，终于愿意为你停留三秒。”  \n\n---\n\n【镜头4：限时上车】（12-15秒）  \n画面：合同页面特写，“90天效果对赌”加粗高亮——  \n“不满意？分文不收。”  \n银行专属优惠码：**CHICANG2025**  \n\n**画外音**（压低嗓音，像在透露秘密）：  \n“别再用礼品卡感动自己了。  \n现在申请，先享后付，见效再买单。”  \n\n**定版字幕**（黑底金字，铿锵有力）：  \n**赤橙——让客户记住你的，不是礼，是用心**"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 3, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}, {"mode": 2, "outputs": [{"name": "output", "type": "*", "localized_name": "output"}], "size": [394.75872802734375, 435.5741882324219], "pos": [1499.013427734375, 328.8745422363281], "widgets_values": ["### 第一部分：创意内容描述 (Creative Content Brief)\n\n| 标题 | 内容 |\n| :--- | :--- |\n| **项目名称** | 赤橙·月度养生盲盒广告分镜 |\n| **分镜总格数** | 12格 (3x4布局) |\n| **总体风格** | 黑白、高对比度、手绘线稿 |\n\n---\n\n**【分镜图内容列表 (Shot List)】**\n\n| 编号 | 画面描述 (Visual/Action) | 镜头/景别 (Shot Type) | 旁白/对话/文字 (Narration/Text) |\n| :--- | :--- | :--- | :--- |\n| 1 | 深夜办公室，财富经理伏案加班，桌上堆满杂乱的月饼券、咖啡卡，旁边有过期库存的盒子。经理神情疲惫。 | 全景 (Wide Shot) | “你每年花几十万做客户维护——结果呢？” |\n| 2 | 客户接过礼品卡，面无表情，随手塞进抽屉，镜头拉近，卡片被遗忘在角落落满灰尘。 | 中特写 (Medium Close-up) | “客户连你是谁都不记得。” |\n| 3 | 清晨阳光洒进房间，一位高净值客户拆开一个精致礼盒，镜头聚焦礼盒内的艾草养生枕和卡片上的文字。 | 中景 (Medium Shot) | “您体质偏寒，适合温养安神。” |\n| 4 | 长夏健脾茶饮特写，手拿卡片，文字清晰可见“湿气重时节，脾胃最需呵护。” | 特写 (Close-up) | |\n| 5 | 镜头推进，AI健康建议卡上印着“根据您的体检报告与节气定制”，礼盒底部浮现银行LOGO，画面高级感满满。 | 中景 (Medium Shot) | “别人送卡，我们送关心。” |\n| 6 | 客户微笑着放下养生盲盒，镜头切换到桌上的银行LOGO，简约大气。 | 近景 (Close-up) | “不是礼品，是每月一次的‘被惦记’。” |\n| 7 | 客户主动拨打电话，画面展现客户与理财经理对话，客户脸上带着满意的微笑。 | 中景 (Medium Shot) | “你们那个养生茶不错……” |\n| 8 | 理财经理办公室内，电脑屏幕显示客户满意度与理财咨询量数据上涨的图表。 | 特写 (Close-up) | “✅ 客户满意度 ↑30%” |\n| 9 | 数据图表切换，显示“✅ 理财咨询量 ↑45%”，旁边附带银行LOGO。 | 特写 (Close-up) | |\n| 10 | 合同页面特写，“90天效果对赌”字样加粗高亮，镜头拉近展示细节。 | 特写 (Close-up) | “不满意？分文不收。” |\n| 11 | 银行专属优惠码“CHICANG2025”特写，画面简洁有力。 | 特写 (Close-up) | |\n| 12 | 黑底金字字幕定版：“赤橙——让客户记住你的，不是礼，是用心。” | 全屏字幕 | **“赤橙——让客户记住你的，不是礼，是用心”** |\n\n---\n\n### 第二部分：生成的黑白分镜图 (Generated Storyboard)\n\n**【提示生成指令 (Prompt for Image Generation)】**：\n\nCreate a 12-panel storyboard in black-and-white ink sketch style, high contrast, and dynamic comic-like line art. The layout is 3 rows x 4 columns. Each panel should depict the following scenes:\n\n1. Panel 1: A dimly lit office at night, featuring a wealth manager sitting at a cluttered desk with stacks of mooncake vouchers and coffee cards. The manager looks exhausted.\n2. Panel 2: A customer receives a gift card, expressionless, placing the card into a drawer corner covered in dust.\n3. Panel 3: Morning sunlight streams into a room. A high-value client opens a refined gift box containing a mugwort wellness pillow with a note reading, \"Your constitution is cold, suitable for warming and calming.\"\n4. Panel 4: Close-up of a summer spleen-nourishing tea with a card that reads, \"During the humid season, the spleen and stomach need care the most.\"\n5. Panel 5: Zoom in on an AI health suggestion card saying, \"Customized based on your medical report and seasonal changes.\" The bank logo subtly appears at the bottom of the box.\n6. Panel 6: The client smiles while placing the wellness box on a table. The bank logo is visible in the background, exuding sophistication.\n7. Panel 7: The client actively calls the wealth manager, smiling during their conversation.\n8. Panel 8: The manager's computer screen displays a graph showing a 30% increase in customer satisfaction.\n9. Panel 9: The graph transitions to show a 45% increase in financial consultations, alongside the bank logo.\n10. Panel 10: A close-up of a contract page highlights the bolded text \"90-day performance guarantee.\"\n11. Panel 11: A zoomed-in view of the bank-exclusive promo code \"CHICANG2025.\"\n12. Panel 12: Final panel: Black background with gold lettering stating, \"赤橙——让客户记住你的，不是礼，是用心.\""], "inputs": [{"shape": 7, "name": "anything", "link": 3, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 4, "type": 