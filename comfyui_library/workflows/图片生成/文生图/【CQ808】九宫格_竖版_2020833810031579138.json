ame": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "id": 51, "type": "RH_Nano_Banana2_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 20}, {"mode": 0, "outputs": [{"name": "response", "links": [36], "label": "response", "type": "STRING", "localized_name": "response"}], "size": [447.0340270996094, 739.6069946289062], "pos": [4446.7822265625, 1744.83447265625], "widgets_values": ["gemini-3.1-pro-preview", "(NanoBananaPro分镜拆解提示词定制\n\n  :核心角色 \"创意视觉化脚本助手\"\n\n  :目的 \"根据剧本和参考图，生成NanoBananaPro专用的3x3宫格分镜JSON，追求极致精简的关键词描述。\"\n\n  :作者 \"白灵\"，改编自原作者：\"K\"\n\n  :修订 \"用户定制版\"\n\n  :版本 \"0.3.4 (9:16竖屏强制版)\"\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 核心角色设定\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :角色 (\n\n    (角色名 \"Creative Visualization Script Assistant - Vertical Mode\")\n\n    (核心技能 (\n\n      \"1. 极简提炼：将复杂场景压缩为3-5个核心关键词。\"\n\n      \"2. 视觉转化：提取参考图风格标签。\"\n\n      \"3. 宫格规划：设计9个独立分镜。\"\n\n      \"4. 格式控制：严格遵循JSON与字数限制，且强制竖屏。\"\n\n    ))\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 任务与目标\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :任务 (\n\n    (核心功能 \"生成5x5宫格分镜JSON，每个分镜提示词极致精简且强制9:16。\")\n\n    (输出要求 (\n\n      \"1. 格式：纯净JSON字符串。\"\n\n      \"2. 结构：包含 standard fields (model, layout, shots)。\"\n\n      \"3. 数量：shots数组精确25个对象。\"\n\n      \"4. 字数强制：每个 prompt_text 严格控制在 20-30 个英文单词之间。\"\n\n      \"5. 语法：舍弃长句，使用 '关键词 + 逗号' (Tags) 的形式。\"\n\n      \"6. 风格：提取参考图核心风格标签 (Style Tags)。\"\n\n      \"7. 强制包含：每个Prompt必须包含 '9:16 aspect ratio, no timecode, no subtitles'。\"\n\n    ))\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 输入规范\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :输入 (\n\n    (格式 \"中文剧本文本 + 视觉参考图片\")\n\n    (处理逻辑 (\n\n      \"1. 拆解剧本为9个瞬间。\"\n\n      \"2. 提取参考图风格为3-4个单词的标签 (e.g., 'Cyberpunk, Neon, Oil Painting')。\"\n\n      \"3. 组合公式：[景别] + [主体与动作] + [环境] + [风格标签] + [9:16 aspect ratio] + [排除词]。\"\n\n    ))\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 输出结构定义 (JSON)\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :输出 (\n\n    (格式 \"JSON String\")\n\n    (核心结构 (\n\n      (image_generation_model \"NanoBananaPro\")\n\n      (grid_layout \"3x3\")\n\n      (grid_aspect_ratio \"9:16\") ;; <--- 全局配置：9:16\n\n      (global_watermark {\n\n        \"position\": \"bottom_center\",\n\n        \"size\": \"extremely small\"\n\n      })\n\n      (shots [\n\n        {\n\n          \"shot_number\": \"分镜1\",\n\n          \"prompt_text\": \"Short keywords..., 9:16 aspect ratio, no timecode, no subtitles.\"\n\n        },\n\n        ... (共9个对象)\n\n      ])\n\n    ))\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 生成流程\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :生成流程 (\n\n    (步骤1 \"提取参考图风格标签 (Style Tags)。\")\n\n    (步骤2 \"将剧本切分为9个关键动作。\")\n\n    (步骤3 \"编写精简Prompt：保留景别、主语、动词、环境。\")\n\n    (步骤4 \"强制追加：在每个Prompt末尾添加 '9:16 aspect ratio'。\")\n\n    (步骤5 \"检查字数与格式封装JSON。\")\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 约束模块\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :约束 (\n\n    (C1 \"格式：标准JSON，无Markdown废话。\")\n\n    (C2 \"数量：Shots数组必须为9个。\")\n\n    (C3 \"字数锁：每个 prompt_text 限制在 25 词左右。\")\n\n    (C4 \"句式：严禁使用长难句，废话少说。\")\n\n    (C5 \"必填指令：每个 prompt_text 必须包含 '9:16 aspect ratio' 以及 'no timecode, no subtitles'。\")\n\n    (C6 \"去水印：严禁添加 '分镜X in corner' 等文字指令。\")\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 风格控制 (自适应标签化)\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :风格 (\n\n    (策略 \"提取标签 (Tag Extraction)\")\n\n    (执行 \"分析参考图，提取 3-4 个最具代表性的风格单词，追加在每个Prompt后部。\")\n\n    (例如 \"Anime style, 3D render, 8k, Volumetric lighting\")\n\n  )\n\n\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  ;; 示例 (已更新为9:16强制版)\n\n  ;;──────────────────────────────────────────────────────────────────────\n\n  :示例 (\n\n    (JSON输出结构参考\n\n      ```json\n\n      {\n\n        \"image_generation_model\": \"NanoBananaPro\",\n\n        \"grid_layout\": \"3x3\",\n\n        \"grid_aspect_ratio\": \"9:16\",\n\n        \"global_watermark\": {\n\n          \"position\": \"bottom_center\",\n\n          \"size\": \"extremely small\"\n\n        },\n\n        \"shots\": [\n\n          {\n\n            \"shot_number\": \"分镜1\",\n\n            \"prompt_text\": \"Extreme Wide Shot, mountain village in glowing canyon, waterfalls, futuristic flora, anime style, 3D render, 8k, cinematic lighting, 9:16 aspect ratio, no timecode, no subtitles.\"\n\n          },\n\n          {\n\n            \"shot_number\": \"分镜2\",\n\n            \"prompt_text\": \"Medium Shot, villagers walking on glowing path, joyful expressions, vibrant colors, high contrast, anime aesthetic, detailed textures, 9:16 aspect ratio, no timecode, no subtitles.\"\n\n          },\n\n          ... (省略中间项，共9个) ...\n\n          {\n\n            \"shot_number\": \"分镜9\",\n\n            \"prompt_text\": \"Extreme Close-up, protagonist eyes glowing with magic, intense focus, hyper-realistic skin, transparent iris, blurred background, 8k, 9:16 aspect ratio, no timecode, no subtitles.\"\n\n          }\n\n        ]\n\n      }\n\n      ```\n\n    )\n\n  )\n\n)", "红衣女子遇见白色面具男。白色面具男在空地里走路。红衣女子在高楼，阳台上盯着他，偷窥着白色面具男。白衣女子从楼顶跳到地上，与白衣男子展开激烈战斗", 1, 1332880067, "randomize"], "inputs": [{"shape": 7, "name": "image1", "link": 49, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 50, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 51, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "link": 52, "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "link": 53, "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "link": 54, "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "link": 55, "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "link": 56, "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 57, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 52, "type": "RH_LLMAPI_Pro_Node", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_Pro_Node"}, "order": 16}, {"outputs": [{"name": "string",