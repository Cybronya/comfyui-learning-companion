ompt": true, "force_offload": true, "device": true}, "input_ue_unconnectable": {}, "version": "7.6.2"}, "widget_ue_connectable": {}, "Node name for S&R": "BitDanceTextEncodeCached"}, "order": 7}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [20], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [226.65687561035156, 498.9738464355469], "pos": [-1204.9276123046875, 37.797813415527344], "widgets_values": ["最高质量 8K 分辨率 电影质感 细节丰富 照片级真实感  \n巨型机械怪兽矗立于荒芜星球表面，金属外壳布满锈迹与能量纹路，关节处喷射蓝紫色离子火焰，双臂装备重型炮管与激光切割器；头部为半球形装甲头盔，嵌有发光红瞳与神经接口阵列，张开巨口吐出高压电弧；身侧悬浮着残破战舰碎片与废弃无人机群，在风暴中翻滚坠落；脚下地面裂痕纵横，岩浆从地底涌出形成熔岩河；远处可见巨大环状轨道站与漂浮城市废墟；天空呈现深紫渐变至暗橙星云，雷暴交加，闪电劈裂天幕；全画采用硬核科幻视觉语言——冷峻工业美学+霓虹故障特效，强调压迫感与未来毁灭之美；构图以中心偏左黄金分割点聚焦主怪兽，仰拍视角强化体型威压，强对比高动态范围光照突显金属反光与爆炸火光，色彩运用浓烈钴蓝、猩红、铬金三原色主导，辅以灰烬棕与夜空黑制造沉郁末世氛围。"], "inputs": [{"name": "text", "link": 18, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 16, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 6}, {"outputs": [{"name": "resolution", "links": [11], "label": "resolution", "type": "BITDANCE_RESOLUTION", "localized_name": "resolution"}, {"name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"name": "label", "label": "label", "type": "STRING", "localized_name": "label"}], "color": "#232", "widgets_values": ["896x1152"], "inputs": [{"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}], "flags": {}, "type": "BitDanceResolution", "title": "选择分辨率", "mode": 0, "bgcolor": "#353", "size": [312.99407958984375, 118], "pos": [-1956.586181640625, 416.5802307128906], "id": 6, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue