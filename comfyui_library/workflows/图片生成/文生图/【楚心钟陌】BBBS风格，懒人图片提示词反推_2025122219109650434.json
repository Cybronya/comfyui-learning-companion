：**\n\n该图像通过细腻的人物刻画、柔和的色彩搭配与富有表现力的姿态，塑造了一位银发紫眸、身着黑色蕾丝内衣、面带羞红与汗珠、眼神迷离的动漫少女形象。她正以略带羞涩与动情的姿态回望，周围飘浮的粉色爱心强化了浪漫氛围，整体画面极具吸引力与情感张力，非常适合用于动漫场景设定或角色设计参考。"], "inputs": [{"name": "text", "link": 468, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 254, "type": "TextPreview", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextPreview"}, "order": 22}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [364.25606689995584, 179.06508053385338], "scale": 0.3719008264462812}}, "groups": [], "links": [[446, 233, 0, 231, 0, "INT"], [447, 234, 0, 231, 1, "INT"], [448, 235, 0, 233, 0, "*"], [449, 236, 0, 234, 0, "*"], [450, 237, 0, 238, 0, "MODEL"], [451, 229, 0, 239, 0, "*"], [452, 239, 0, 240, 0, "CLIP"], [453, 255, 0, 240, 1, "STRING"], [454, 239, 0, 241, 0, "CLIP"], [455, 244, 0, 242, 0, "LATENT"], [456, 232, 0, 242, 1, "VAE"], [457, 242, 0, 243, 0, "IMAGE"], [458, 245, 0, 244, 0, "MODEL"], [459, 240, 0, 244, 1, "CONDITIONING"], [460, 241, 0, 244, 2, "CONDITIONING"], [461, 231, 0, 244, 3, "LATENT"], [462, 238, 0, 245, 0, "MODEL"], [463, 250, 0, 247, 0, "*"], [464, 247, 0, 248, 0, "*"], [465, 246, 0, 250, 0, "LLAMACPPMODEL"], [466, 251, 0, 250, 2, "IMAGE"], [467, 256, 0, 251, 0, "*"], [468, 248, 0, 254, 0, "STRING"], [469, 253, 0, 255, 0, "STRING"], [470, 254, 0, 255, 1, "STRING"], [471, 242, 0, 257, 0, "IMAGE"]], "id": "0c534a58-34c6-4379-bf9f-410368d2a5b6", "config": {}, "version": 0.4, "last_node_id": 257, "revision": 0}