TIONING", "localized_name": "positive"}, {"name": "negative", "link": 40, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 78, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 19, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "ver": "0.3.40", "widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 11}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [78], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [295.0877380371094, 108.7874984741211], "pos": [949.6385498046875, 471.43804931640625], "widgets_values": [1024, 1024, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 83, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 84, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 28, "type": "EmptyLatentImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.40", "widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage"}, "order": 10}, {"outputs": [], "color": "#432", "widgets_values": ["# ANIMA 模型使用指南\n\n## Danbooru 风格/艺术家 [https://safebooru.donmai.us/](https://safebooru.donmai.us/)\n\n## 一、 生成设置\n* **分辨率支持**：支持分辨率为 **512² 至 1536²** 像素。\n* **步数建议**：**30–50** 步。\n* **CFG 值**：建议为 **4–5**。\n* **采样器推荐**：\n    * **er_sde**：中性风格、平涂色彩、锐利线条。通常将其作为合理默认选项。\n    * **euler_a**：线条更柔和、更细。有时会呈现轻微的 2.5D 效果。与其他采样器相比，可适当提高 CFG 值而不会导致图像过曝。\n    * **dpmpp_2m_sde_gpu**：风格类似于 er_sde，但能产生更多样化且更具“创意”的结果。根据提示词的不同，有时可能会过于夸张。\n* **纹理增强**：若追求更写实或更具绘画感的效果，可使用 **beta57 调度器**（ComfyUI RES4LYF 自定义节点包），它更强调低噪声时间步，有助于生成更好的纹理。\n\n## 二、 提示词编写规范\n\n### 1. 基础格式\n* **标签格式**：请使用小写，并用**空格**代替下划线。只有评分标签（score tags）使用下划线。\n* **词库参考**：当某个标签在 Danbooru 与 Gelbooru 之间存在差异时，请优先使用 **Gelbooru** 版本。\n* **权重控制**：提示词加权有效，但所需权重通常高于 SDXL 模型常用值。例如：`(chibi:2)`。\n\n### 2. 推荐前缀与负向词\n* **推荐正向前缀**：`masterpiece, best quality, score_7, safe, `\n* **推荐负向提示**：`worst quality, low quality, score_1, score_2, score_3, artist name`\n\n### 3. 标签顺序\n> **顺序建议**：[质量/元信息/年份/安全标签] [1girl/1boy/1other 等] [角色] [作品系列] [艺术家] [通用标签]\n> *注：每个标签类别内部，标签顺序可任意排列。*\n\n## 三、 分类标签详解\n\n### 1. 质量标签\n模型支持以下两种评分系统（可单独使用、同时使用或都不用）：\n* **人工评分**：`masterpiece`, `best quality`, `good quality`, `normal quality`, `low quality`, `worst quality`\n* **PonyV7 审美模型**：`score_9`, `score_8`, ..., `score_1`\n\n### 2. 元信息与安全标签\n* **年份**：`year 2025`, `year 2024`, ...\n* **时期**：`newest`, `recent`, `mid`, `early`, `old`\n* **元信息**：`highres`, `absurdres`, `anime screenshot`, `jpeg artifacts`, `official art` 等。\n* **安全分级**：`safe`, `sensitive`, `nsfw`, `explicit`\n\n### 3. 艺术家标签\n* **语法要求**：艺术家名称前**必须**加 `@`。例如：`@big chungus`。如果不加，效果会非常微弱。\n\n## 四、 自然语言提示技巧\n\n* **大小写规范**：对角色名和作品名遵循标准英文大小写规则。\n* **详细程度**：如果使用纯自然语言，描述越详细越好。建议至少写两句话，过于简短的提示可能导致意外结果。\n* **混合编写**：可以任意顺序混合使用标签（tags）和自然语言。\n* **角色逻辑**：当提示涉及多个角色时，建议**先命名角色，再描述其基本外貌**。\n    * *示例*：\"《葬送的芙莉莲》中的费伦的数字艺术作品，拥有长长的紫色头发和紫色眼睛，身穿黑色外套...\"\n\n## 五、 数据集标签 (Dataset Tags)\n针对非动漫数据集，须在提示词**最开头**添加数据集标签并**换行**：\n\n* **ye-pop (LAION-POP)**：\n    ```\n    ye-pop\n    [作品标题 (可选)]\n    [详细描述文本]\n    ```\n* **deviantart**：\n    ```\n    deviantart\n    [作品标题 (可选)]\n    [详细描述文本]\n    ```\n\n## 六、 完整标签示例\n`year 2025, newest, normal quality, score_5, highres, safe, 1girl, oomuro sakurako, yuru yuri, @nnn yryr, smile, brown hair, hat, solo, fur-trimmed gloves, open mouth, long hair, gift box, fang, skirt, red gloves, blunt bangs, gloves, one eye closed, shirt, brown eyes, santa costume, red hat, skin fang, twitter username, white background, holding bag, fur trim, simple background, brown skirt, bag, gift bag, looking at viewer, santa hat, ;d, red shirt, box, gift, fur-trimmed headwear, holding, red capelet, holding box, capelet`"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [1187.134033203125, 1228.2520751953125], "pos": [-1706.3431396484375, 148.1315155029297], "id": 49, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [645.9285278320312, 600.4260864257812], "pos": [1550.865478515625, 150.85720825195312], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 85, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 50, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 13}, {"mode": 0, "outputs": [{"name": "INT", "links": [84], "label": "INT", "type": "INT", "localized_name": "INT"}], "size": [400.161376953125, 58], "pos": [-471.59344482421875, 526.4220581054688], "widgets_values": [1024], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "id": 48, "type": "Int", "title": "高", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "ord