肩带交叉勾勒优雅锁骨与肩线。高清时尚摄影风格，侧面柔暖光影凸显肌肤细腻光泽与饰品璀璨反射，背景浅灰朦胧，眼神自信魅惑，整体珠宝艺术细节逼真生动。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "自己写提示词", "mode": 0, "bgcolor": "#353", "size": [510, 290], "pos": [-380, 230], "id": 14, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 4}, {"outputs": [{"name": "MODEL", "links": [320, 323], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#233", "widgets_values": ["z_image_turbo_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLoader", "mode": 0, "bgcolor": "#355", "size": [300, 90], "pos": [180, 230], "id": 21, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 5}, {"outputs": [{"name": "CLIP", "links": [12, 290], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#233", "widgets_values": ["qwen_3_4b.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label":