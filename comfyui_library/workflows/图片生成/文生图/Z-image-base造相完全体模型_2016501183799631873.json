59375, 488.8209533691406], "widgets_values": ["1.  一幅细节极致丰富的数字奇幻艺术作品，刻画一位气质绝尘的空灵女性，拥有如凝脂般细腻的冷白色肌肤，浅紫色长卷发如星云般蓬松卷曲，发间点缀着由星蓝宝石与白金打造的星链状饰品，缠绕成精致的发冠。她的眼眸是通透的紫罗兰色，目光悠远又魅惑，仿佛藏着宇宙深处的秘密。身着以淡紫色与银白色为主的菱格纹铠甲，铠甲缝隙镶嵌着细碎的星钻，胸口与腰侧嵌有散发着淡紫色荧光的星核宝石，贴合身形的铠甲完美勾勒出她玲珑有致的曲线。额头佩戴着一枚星芒状白金额饰，中央镶嵌一颗硕大的矢车菊蓝宝石，耳畔垂着同款星链耳坠。背景是模糊的宇宙深空暗调渐变，四周漂浮着闪烁的星尘与淡紫色微光粒子，营造出神秘又浪漫的氛围。铠甲质感光滑莹润且泛着冷光，星链饰品与粒子轻盈空灵。整体风格为超写实奇幻风，聚焦于繁复细节与空灵绝尘的美学，画面传递出星之女神独有的强大、绝美与疏离感，堪称奇幻角色插画的标杆。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 12, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [19], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "width", "label": "宽度", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "高度", "type": "INT", "localized_name": "height"}], "size": [270, 170], "pos": [1572.76123046875, 704.277587890625], "widgets_values": ["768x1344 (0.57)", 1, 0, 0], "inputs": [{"widget": {"name": "resolution"}, "name": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "type": "INT", "localized_name": "batch_size"}, {"widget": {"name": "width_override"}, "name": "width_override", "type": "INT", "localized_name": "width_override"}, {"widget": {"name": "height_override"}, "name": "height_override", "type": "INT", "localized_name": "height_override"}], "flags": {}, "id": 16, "type": "SDXLEmptyLatentSizePicker+", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SDXLEmptyLatentSizePicker+"}, "order": 4}, {"outputs": [{"name": "CONDITIONING", "links": [7], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#322", "widgets_values": ["泛黄，发绿，模糊，低分辨率，低质量图像，扭曲的肢体，诡异的外观，丑陋，AI感，噪点，网格感，JPEG压缩条纹，异常的肢体，水印，乱码，意义不明的字符，欧洲人"], "inputs": [{"name": "clip", "link": 5, "label": "CLIP", "type": "CLIP", "local