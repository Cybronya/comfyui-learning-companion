ts": [{"name": "width", "links": [285], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [286], "label": "height", "type": "INT", "localized_name": "height"}], "widgets_values": ["9:16 (Portrait Widescreen)", 0.5, 32], "inputs": [{"shape": 7, "name": "preview", "label": "preview", "type": "RESOLUTION_PREVIEW", "localized_name": "preview"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "title": "一采分辨率（尺寸）", "mode": 0, "size": [677.2000122070312, 137.20001220703125], "pos": [-3094.436279296875, 5165.5966796875], "id": 115, "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"aspect_ratio": true, "megapixels": true, "multiple": true}, "Node name for S&R": "ResolutionSelector"}, "order": 12}, {"outputs": [{"name": "text", "links": [312], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#4b5563", "widgets_values": ["subject_definitions:\nimage_4：1 (5).png，绿色对勾和白色万唯 Logo，作为绿色视觉锚点。\nimage_5：1 (6).png，白底绿色 Logo和品牌文字，作为最终定格。\nimagined_learning_universe：漂浮在空中的教室、书本、试卷、黑板、学生和老师，具有真实光影与轻微幻想感。\nimagined_puzzle_tiles：由书页、几何图形、绿色玻璃和白色纸张组成的拼图模块。\n\nsummary:\n制作一条 10 秒、9:16 竖屏、华丽幻想游戏 PV 风格宣传片。画面从真实课堂快速进入“知识宇宙”，使用大量拼图、分屏、镜面转场、环绕运镜、穿越镜头和快速缩放。节奏非常快，画面持续变化。\n\nretention_analysis:\n只使用 image_4 和 image_5 作为 Logo 参考，其他画面全部联想生成。保留绿色、白色和清爽教育气质。片尾准确显示“万唯研究中考24年”，原有 Logo 文字必须清晰。\n\ndetailed_description:\n0.0-0.9s：image_4 的绿色对勾以极近景出现，摄影机沿对勾表面高速滑行，绿色材质突然裂解成数十块透明拼图。\n\n0.9-2.0s：拼图在空中重新组合成漂浮教室，老师在中央快速板书，学生座位像棋盘一样向远处延伸，镜头从老师肩后穿越到教室前方。\n\n2.0-3.0s：老师写下的几何线条变成发光道路，学生沿道路奔向不同知识模块。画面拆成左右分屏：左侧老师讲题，右侧学生解题。\n\n3.0-4.1s：左右分屏再次拆成六块旋转卡片，每张卡片展示试卷、笔尖、翻页、眼神、黑板和几何图形，卡片在镜头前快速交错。\n\n4.1-5.2s：摄影机穿过其中一张试卷，进入由书本搭建的立体迷宫。书页像墙壁一样翻动，镜头快速升高后俯冲。\n\n5.2-6.4s：迷宫突然折叠成 3×3 拼图，九个格子同步显示老师、学生、书本、笔记和知识图形，随后九格同时向中央压缩。\n\n6.4-7.6s：所有拼图块形成一条绿色旋转风暴，摄影机沿风暴中心连续旋转两圈，最后冲出一片纯白空间。\n\n7.6-8.6s：白空间中出现 image_4 的绿色对勾，周围碎片像卫星一样环绕，镜头快速拉远。\n\n8.6-10.0s：对勾折叠成 image_5 的 Logo 终版，准确叠加“万唯研究中考24年”和原有“中考教辅全国引领者”，最后 1 秒稳定停留。\n\noverall_soundscape:\n粉笔声、书页翻动声、玻璃拼图碰撞声、空间穿越声、快速旋转 whoosh、能量风暴声、Logo 定格提示音。无对白。\n\nnon_diegetic_music:\n华丽、未来感、史诗游戏 PV 音乐，强电子鼓、合成器、弦乐和低频冲击结合，约 150 BPM。中段持续上升，片尾在 Logo 出现时突然变得简洁有力。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "rgba(21, 23, 27, 0.96)", "size": [786.011474609375, 1403.25146484375], "pos": [-3928.968994140625, 4040.600341796875], "id": 144, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 13}, {"mode": 0, "outputs": [{"name": "positive", "links": [337], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "av_latent", "links": [338], "label": "av_latent", "type": "LATENT", "localized_name": "av_latent"}, {"name": "audio", "links": [], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [560, 434], "pos": [-4927.73779296875, 4045.98095703125], "widgets_values": ["omni_reference", "match", "match", "", 1344, 10, false, "{\"_ui\":{\"video_count\":0,\"audio_count\":0,\"image_count\":5},\"ref_image_1\":{\"path\":\"minimax_h3_unified/52443065a3a65c8b17a355923982b2ae92d8a1b7071e42fc9d69693c63582efc.png\",\"name\":\"1 (