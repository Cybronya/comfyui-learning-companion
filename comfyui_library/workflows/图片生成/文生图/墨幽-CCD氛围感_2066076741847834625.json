ze": [820, 300], "pos": [820, -2050], "widgets_values": ["一位20岁左右的年轻亚洲女性，赤脚站立于连绵起伏的金黄色沙漠沙丘之上，中景全身构图，正面平视拍摄。她乌黑长发编成一条粗长侧辫垂于右肩，发间编入细小装饰。头戴金色镂空花纹额饰头冠，搭配白色薄纱头纱，头纱边缘有金色刺绣纹样。身穿浅灰色蕾丝吊带短上衣，精致刺绣花纹点缀胸前，下摆蕾丝花边露出纤细腰肢和平坦小腹；下身搭配浅灰色飘逸长裙，高腰设计，腰部系有金色刺绣宽腰带并打成蝴蝶结，裙身垂坠轻盈。脖颈佩戴多层金色项链，中央吊坠为绿色宝石，腰间垂坠金色链条装饰，双臂佩戴金色宽手镯。双手向两侧平展，手指轻捏头纱边缘将白色薄纱向两侧拉开展开，如舞蹈般优雅，头纱与裙摆随风飘动。双腿并拢站立于沙丘上， barefoot赤脚，重心稳定，头部正面朝向镜头，表情温婉宁静，眼神柔和。背景是辽阔沙漠，连绵起伏的沙丘纹理清晰，上方是纯净淡蓝色无云天空。自然日光柔和明亮，人物面部受光均匀，皮肤白皙通透，整体色调温暖清新，专业旅拍写真质感，西域异域风情，仙气飘逸，8K超清细节。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 100, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "image", "links": [20301], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"name": "original_size", "label": "original_size", "type": "BOX", "localized_name": "original_size"}, {"name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "height", "type": "INT", "localized_name": "height"}], "size": [303.6851501464844, 425.7364501953125], "color": "rgba(38, 73, 116, 0.7)", "pos": [200, -980], "widgets_values": ["original", 1, 1, "fill", "lanczos", "None", "longest", 1960, "#000000"], "inputs": [{"shape": 7, "name": "image", "link": 20300, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "proportional_width"}, "name": "proportional_width", "label": "proportional_width", "type": "INT", "localized_name": "proportional_width"}, {"widget": {"name": "proportional_height"}, "name": "proportional_height", "label": "proportional_h