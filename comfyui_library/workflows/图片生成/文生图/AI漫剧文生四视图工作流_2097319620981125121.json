tputs": [{"name": "text", "links": [56], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#1a7e2e", "widgets_values": ["高精度 3D 半写实国漫风格，一位温婉典雅的盛唐古典美人，约 20 岁，肤如凝脂，柳叶眉，丹凤眼，额间一点朱红花钿，神情温婉淡然、从容端庄。乌黑长发盘成典雅唐代高髻，发丝柔顺有光泽，鬓角垂落两缕碎发。内搭藕荷色薄纱大袖衫，衣身绣金色牡丹与祥云暗纹；外披翡翠绿渐变丝绸披帛，长及脚踝；下穿石榴红渐变齐胸曳地长裙，裙摆绣金色缠枝莲纹；腰系月白色织金腰封，坠玉环绶带。头戴鎏金镶宝花钗、斜插垂珠流苏步摇，发间点缀点翠蝴蝶簪与白玉簪；耳戴金镶玉坠珠耳坠；颈间佩戴多层珍珠璎珞项圈，正中坠和田白玉；腕戴翡翠镯与金累丝手镯；脚穿浅金色云头翘头绣花鞋，鞋面绣缠枝莲纹、缀小珍珠。整体盛唐古典风，藕荷、石榴红、翡翠绿、月白、鎏金色配色，温婉大气。\n\n纯白色背景，纯底无渐变、无杂色、无投影背景墙，人物脚下仅有轻微接触阴影。画面左侧约占三分之一，为同一位女性的大幅正脸与上半身大头特写，正脸端正直视镜头，完整展示温婉五官、朱红花钿、高髻钗环、耳坠及大袖衫披帛领口细节；右侧依次并列展示同一人物的正面全身、标准侧面全身和背面全身，三个人物从头到鞋完整入镜。四个视图脸型、五官、肤色、发型、服装、配饰和鞋子完全一致。正面一手持绢面团扇一手自然下垂，侧面自然端庄站立，背面清晰呈现发髻与披帛、曳地长裙背部结构，鞋子完整入镜。柔和面部主光、暖白侧逆轮廓光、体积光、发丝光和金属反光，85MM 人像镜头，F/2.0 浅景深，电影级商业影棚布光，OCTANE 渲染，超精细材质，真实丝绸纱质、金线刺绣、珍珠点翠、织金腰封与绣花鞋质感，细腻陶瓷皮肤质感，8K 高清，干净精致。避免灰色背景、渐变背景、有色背景墙、真人感、毛孔、油腻皮肤、肌肉感、大头娃娃比例失调、短腿、廉价塑料面料、人物不一致、肢体错误、裁切鞋子、文字、标识与水印。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#066a1a", "size": [480.5088195800781, 192.5877227783203], "pos": [-42.404457092285156, 4676.7490234375], "id": 40, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 5}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.51.9", "VHS_latentpreview": false, "ds": {"offset": [90.91685552743851, -4641.380038833386], "scale": 2.2745116282468327}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "出图尺寸", "bounding"