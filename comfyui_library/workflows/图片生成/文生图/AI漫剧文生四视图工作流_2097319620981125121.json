y alertness.\n\nStudio lighting is hard and theatrical, casting crisp shadows. The composition is symmetrical, iconic, and poster-like — punk rock goddess of war meets American mythology. Hyperrealistic, high-fashion photography, 8k, sharp detail, magazine cover quality."], "inputs": [{"name": "clip", "link": 44, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 56, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [464.6577453613281, 88], "pos": [568.7564086914062, 5297.5126953125], "id": 58, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 8}, {"mode": 0, "outputs": [{"name": "VAE", "links": [48], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [450, 120], "pos": [562.193359375, 5433.07373046875], "widgets_values": ["qwen_image_vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 61, "type": "VAELoader", "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen_image_vae.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/Krea-2/resolve/main/vae/qwen_image_vae.safetensors"}], "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [53], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [204.134765625, 26], "pos": [1057.15673828125, 4980.91552734375], "widgets_values": [], "inp