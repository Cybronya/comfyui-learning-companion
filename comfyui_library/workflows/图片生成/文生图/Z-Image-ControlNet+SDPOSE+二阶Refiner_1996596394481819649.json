跟随镜头、复合运镜或环绕运镜，但必须与画面结构合乎逻辑且不夸张。此外，当图像具有明显风格特征时可描述风格化效果，如毛毡风格、3D 卡通、像素风、水彩画、二次元、木偶动画、3D 游戏或移轴摄影、延时拍摄等特效镜头。整体输出需保持自然语言叙述，不使用列表，不提出问题，不添加图像外虚构信息，整体内容必须连贯、简洁、具备稳定的电影镜头感。", "Qwen3-VL-4B-Instruct", "none", false, 0.7, 512, 125440, 334768, 683, "randomize", "eager"], "inputs": [{"shape": 7, "name": "source_path", "link": 45, "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "min_pixels"}, "name": "min_pixels", "label": "min_pixels", "type": "INT", "localized_name": "min_pixels"}, {"widget": {"name": "max_pixels"}, "name": "max_pixels", "label": "max_pixels", "type": "INT", "localized_name": "max_pixels"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention"}, "name": "attention", "label": "attention", "type": "COMBO", "localized_name": "attention"}], "flags": {}, "id": 31, "type": "Qwen3_VQA", "properties": {"ver": "b2008e9378bb040f04e422bebd08f5d8abc8a060", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable":