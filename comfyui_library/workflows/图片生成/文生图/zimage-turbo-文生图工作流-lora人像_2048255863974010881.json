r": 5}, {"mode": 4, "outputs": [{"name": "MODEL", "links": [69], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}, {"name": "CLIP", "links": [70], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [301.0665283203125, 126], "pos": [-135.0929412841797, 940.08154296875], "widgets_values": ["zimage-weiwei-v1_000001000.safetensors", 0.95, 1], "inputs": [{"name": "model", "link": 67, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "clip", "link": 68, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}, {"widget": {"name": "strength_clip"}, "name": "strength_clip", "label": "strength_clip", "type": "FLOAT", "localized_name": "strength_clip"}], "flags": {}, "id": 44, "type": "LoraLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.21.0", "ue_properties": {"widget_ue_connectable": {"lora_name": true, "strength_model": true, "strength_clip": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"lora_name": true, "strength_model": true, "strength_clip": true}, "Node name for S&R": "LoraLoader"}, "order": 6}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [19, 24], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [404.480712890625, 469.347412109375], "pos": [-534.50048828125, 405.6663818359375], "widgets_values": ["薇薇，构图与视角：标准半身像，人物居中偏右，取景自腰腹以上。85mm人像镜头，光圈f/1.4，背景完全虚化为暖灰色无影调。人物身体略向左旋，右肩微耸，头颈向右回正，形成一段含蓄的S形曲线。眼神从微垂的眼睑下向上透出，视线略高于镜头。构图留出左侧大面积负空间，适合16:9宽屏壁纸的呼吸感留白。\n\n人物特征：五官为盛唐审美下的鹅蛋脸，骨肉匀停，下颌弧线柔和如月。眼型是微微上挑的含露目，瞳色保留古典的深黑，只在虹膜边缘透一圈极细的琥珀光。发型为初唐半翻髻，发髻偏松，被刻意打散了几缕——一绺从耳后滑落，搭在锁骨上；另一绺黏在微微汗湿的颈侧，暗示刚从午睡中醒来的慵懒。\n\n妆容与皮肤质感：冷白皮呈现冰瓷般的微凉通透，保留极细腻的毛孔纹理以增强真实呼吸感。微汗的分布在太阳穴、鼻梁与锁骨窝——不是流淌的汗，而是那种将出未出的薄汗，在皮肤上覆盖一层极细的丝绒光泽。妆容为“古典清透妆”：底妆薄如无物，仅以米粉调出冷调白皙；眉毛是远山黛，眉尾淡出如烟；眼妆几乎是裸的，只在睫毛根部轻点一条极细的眼线，眼尾略挑；胭脂是褪色的蔷薇色，从眼下淡淡晕开；唇妆是咬唇妆的古法源头——檀色点于唇心，向外渐淡，边缘用手指晕开，呈现刚被亲吻过的血色。\n\n服饰与配饰：服饰为唐制齐胸襦裙，但作了极简化处理。上襦是一件极薄的素白轻罗，质地比蝉翼更透，肩部微微滑落，露出冷白皮上的锁骨与肩头转折。轻罗的经纬线在光下若隐若现，衣缘是极细的手工卷边，略有褶皱的痕迹。裙头束于胸上，是单层素绉纱，呈极淡的藕荷色，系带松松地打了一个结，带尾垂落在画面下方。无任何金玉饰品，只在发髻间插一支素银簪子，簪头是一粒未经雕琢的淡水珍珠。\n\n光线与色调：采用窗边自然光的模拟布光。主光源来自画面左侧，是一道柔和的漫射光，如透过宣纸窗格的午后日光，在右颊投出极淡的阴影；暗部用反光板轻微补光，保留肩颈下的细节。色调为“暖瓷白”——底色是冷白，但被一层极薄的暖光包裹，呈现出冷中透暖的矛盾美感。整体去饱和，仅保留肌肤的象牙白、轻罗的素白与嘴唇上那一点檀色的暖。\n\n质感与后期风格：追求“未完成”的古典肖像画质感。后期处理中保留皮肤的细腻纹理与轻罗的织物质感，但在高光处叠加0.2%的柔光晕，模拟古典绢本工笔的温润感。最终画面：她不像被拍摄的模特，更像一幅正在呼吸的唐代仕女图——衣带将落未落，眼神将醒未醒，所有关于诱惑的叙事，都藏在那一截微汗的锁骨、那一片透肉的轻罗、与那一抹被晕开的檀色唇痕里。"], "inputs": [{"name": "clip", "link": 70, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 28, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [549.6953735351562, 543.644287109375], "pos": [239.61180114746094, 511.67626953125], "widgets_values": ["zt文生图"], "inputs": [{"name": "images", "link": 65, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {"collapsed": false}, "id": 40, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.21.1", "ue_properties": {"wid