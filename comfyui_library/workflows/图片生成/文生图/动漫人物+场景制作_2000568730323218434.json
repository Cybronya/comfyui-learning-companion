de": 0, "outputs": [{"name": "STRING", "links": [176, 177], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 220], "pos": [406.8255615234375, -218.24302673339844], "widgets_values": ["", "", ",", ""], "inputs": [{"widget": {"name": "text1"}, "name": "text1", "link": 174, "label": "text1", "type": "STRING", "localized_name": "text1"}, {"widget": {"name": "text2"}, "name": "text2", "link": 175, "label": "text2", "type": "STRING", "localized_name": "text2"}, {"widget": {"name": "separator"}, "name": "separator", "label": "separator", "type": "STRING", "localized_name": "separator"}, {"widget": {"name": "text3"}, "shape": 7, "name": "text3", "label": "text3", "type": "STRING", "localized_name": "text3"}], "flags": {"collapsed": true}, "id": 152, "type": "ConcatTextOfUtils", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ConcatTextOfUtils"}, "order": 14}, {"mode": 0, "outputs": [{"name": "STRING", "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [334.1333923339844, 205.93634033203125], "pos": [615.3658447265625, -352.5892333984375], "widgets_values": ["in the style of FeiGiap,There is an abandoned tea pavilion on the mountainside. Half of the thatched roof has collapsed. A few strings of dry wind chimes hang under the remaining eaves, making a dry clanking sound in the wind. Several moldy bamboo mats were spread on the floor of the pavilion, and the edges had been soaked black by rain, revealing broken bamboo fibers.\nIn the center of the pavilion stood a black wooden pillar with a half-extinguished red candle stuck on it. The flames swayed violently in the draft, reflecting the color of blood on the pillar and the water on the ground. Wherever the candlelight reached, a few crooked blue bricks could be seen, and a few pale wild mushrooms emerged from the cracks in the bricks.\nThe drizzle outside the pavilion was like silk, dripping along the broken thatch, forming a jagged water curtain under the eaves of the pavilion. The mountains in the distance are like ink, gradually blending into one in the dusk. There were several broken clay pots piled up in a corner of the pavilion. The pots were covered with cobwebs, and the mouths of the pots were covered with thick dust. Occasionally, small flying insects were hovering around the edge of the candlelight.\nBehind the pavilion pillar is a mottled wooden sign. The writing on it has long been blurred, and only the radical of the word \"tea\" can be vaguely discerned. In the shadow under the wooden sign, a thin wild cat curled up, its eyes glowing green in the darkness, watching vigilantly at the only source of warmth in this rainy night.", [false, true]], "inputs": [{"name": "text", "link": 177, "label": "文本", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 145, "type": "PreviewTextNode", "properties": {"cnr_id": "comfyui_custom_nodes_alekpet", "ver": "1.0.73", "widget_ue_connectable": {}, "Node name for S&R": "PreviewTextNode"}, "order": 16}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [7], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [247.1887969970703, 287.2257385253906], "pos": [1023.1309204101562, 4.899736404418945], "widgets_values": [416256710983058, "randomize", 30, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 150, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "positive", "link": 138, "label": "正面条件", "type": "CONDITIONING", "localized_name": "正面条件"}, {"name": "negative", "link": 6, "label": "负面条件", "type": "CONDITIONING", "localized_name": "负面条件"}, {"name": "latent_image", "link": 173, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "type": "FLOAT", "localized_name": "CF