深空蓝的柔和渐变。极简主义风格，法式冷感，先锋酷飒，杂志级商业摄影。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "Text", "mode": 0, "bgcolor": "#353", "size": [552.1694946289062, 512.1600952148438], "pos": [666.4193115234375, 480.6542663574219], "id": 89, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 10}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-413.17284893952836, -146.6316698403634], "scale": 0.9646149645000006}}, "groups": [{"color": "#3f789e", "font_size": 35, "flags": {}, "id": 3, "title": "1SeedVR 2.5 高清放大 4K", "bounding": [550.8311157226562, 2514.34912109375, 3913.203369140625, 1767.1414794921875]}, {"color": "#3f789e", "font_size": 50, "flags": {}, "id": 4, "title": "Z-Image 超广角低角度摄影", "bounding": [547.0545043945312, 1446.463623046875, 2257.525146484375, 968.877197265625]}, {"color": "#b06634", "font_size": 60, "flags": {}, "id": 5, "title": "填写提示词，设置图像宽高", "bounding": [550.8770751953125, 313.3204650878906, 816.3506469726562, 1068.2412109375]}, {"color": "#b06634", "font_size": 60, "flags": {}, "id": 7, "title": "SeedVR 放大开关", "bounding": [6.165219783782959, 2518.367431640625, 522.621337890625, 297.05621337890625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 8, "title": "设置放大尺寸", "bounding": [588.853271484375, 2805.749755859375, 377.1465759277344, 252.90586853027344]}, {"color": "#b06634", "font_size": 60, "flags": {}, "id": 9, "title": "结果输出", "bounding": [1432.1207275390625, 313.4332275390625, 896.144287109375, 1069.058837890625]}], "links": [[22, 12, 0, 16, 0, "CLIP"], [23, 22, 0, 17, 0, "LATENT"], [24, 11, 0, 17, 1, "VAE"], [26, 14, 0, 22, 0, "MODEL"], [27, 24, 0, 22, 1, "CONDITIONING"], [28, 16, 0, 22, 2, "CONDI