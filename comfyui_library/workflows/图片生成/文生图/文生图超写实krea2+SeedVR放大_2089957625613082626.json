name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "id": 258, "type": "ResolutionSelector", "properties": {"cnr_id": "comfy-core", "ver": "0.26.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"aspect_ratio": true, "megapixels": true, "multiple": true}, "Node name for S&R": "ResolutionSelector"}, "order": 8}, {"mode": 0, "outputs": [{"name": "resized", "links": [454, 456], "label": "resized", "type": "*", "localized_name": "resized"}], "size": [210, 106], "pos": [5290.146484375, 440.1566467285156], "widgets_values": ["scale by multiplier", 2.0000000000000004, "lanczos"], "inputs": [{"name": "input", "link": 525, "label": "input", "type": "IMAGE,MASK", "localized_name": "input"}, {"widget": {"name": "resize_type"}, "name": "resize_type", "label": "resize_type", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "resize_type"}, {"widget": {"name": "resize_type.multiplier"}, "name": "resize_type.multiplier", "label": "resize_type.multiplier", "type": "FLOAT", "localized_name": "multiplier"}, {"widget": {"name": "scale_method"}, "name": "scale_method", "label": "scale_method", "type": "COMBO", "localized_name": "scale_method"}], "flags": {}, "id": 297, "type": "ResizeImageMaskNode", "properties": {"cnr_id": "comfy-core", "ver": "0.27.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"resize_type": true, "resize_type.multiplier": true, "scale_method": true}, "Node name for S&R": "ResizeImageMaskNode"}, "order": 10}, {"mode": 0, "outputs": [{"name": "output", "links": [], "type": "*", "localized_name": "output"}], "size": [258.8814697265625, 202.8877410888672], "pos": [5715.3359375, -278.0494689941406], "widgets_values": ["日常生活抓拍照片，昏暗热闹的夜店舞池，一位身材曼妙的美女正沉浸在音乐中随性起舞，长发因动作而凌乱飞扬，面部表情陶醉，眼神迷离，双臂自然舒展摆动，身体呈现动态曲线，身着贴合身形的深色或亮片舞衣，布料随动作产生褶皱。中景构图，接近平视的观察角度，人物占据画面主体，背景中模糊的彩色灯光、旋转光斑和隐约的人群轮廓营造出热闹氛围。现场混合光在人物面部形成明暗对比，彩色射灯在皮肤和衣物上留下高光，动态范围有限，画面边缘因手持晃动产生轻微运动模糊，暗部带有数字噪点，呈现出真实的夜生活瞬间。"], "inputs": [{"shape": 7, "name": "anything", "link": 542, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 286, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "595e0738a9e3f8d0d9c4d875461b2d2c9e7559c7", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 15}, {"mode": 0, "outputs": [{"name": "output", "links": [542, 543], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [353.2275695800781, 394], "pos": [5277.3203125, -609.4241943359375], "widgets_values": ["Normal - Describe", "", "# Role\n\n你是一位专门优化自然真实、日常抓拍风格图像提示词的专家。\n\n你的任务是接收用户输入的简短画面描述，在准确保留人物、服装、动作、地点、时间、景别和画面比例的基础上，将其扩写成一段可以直接用于图像生成的正向提示词。\n\n最终画面应呈现普通人在真实生活环境中被自然记录下来的状态：人物动作放松，环境具有可信的使用痕迹，构图略带随意感，光线符合现场条件，画面保留轻微数字噪点、轻微动态模糊、自动曝光和有限动态范围。\n\n只输出优化后的提示词正文。\n\n# Core Style\n\n扩写结果以以下视觉方向为基础：\n\n日常生活抓拍\n自然真实的人物状态\n普通拍摄距离\n接近24至28毫米等效焦段的自然广角透视\n接近平视的观察角度\n手持构图的轻微偏差\n人物与环境之间真实的空间关系\n自动对焦与自动曝光\n有限动态范围\n生活化直出色彩\n轻微数字噪点\n符合动作状态的轻微运动模糊\n自然皮肤纹理\n真实衣料褶皱\n适量环境细节\n\n真实感主要来自人物状态、生活环境、现场光线和普通成像特征，而不是华丽的摄影修饰。\n\n# Information Priority\n\n扩写时按照以下顺序处理信息：\n\n1. 用户明确描述的人物、服装、动作、道具和地点\n2. 用户明确指定的比例、景别、视角和时间\n3. 人物正在发生的核心行为\n4. 人物与环境之间的互动关系\n5. 现场光线、构图和成像状态\n6. 少量用于建立空间的环境细节\n\n用户已经明确的信息保持不变。\n\n用户未描述的部分，只进行符合场景的克制补充。\n\n# Language\n\n用户输入中文时输出中文。\n\n用户输入英文时输出英文。\n\n最终只输出一种语言，不进行中英文对照。\n\n# Subject Preservation\n\n完整保留用户输入中的：\n\n人物数量\n性别与年龄层\n人物身份\n外貌特征\n发型\n服装\n动作\n表情\n道具\n时间\n地点\n天气\n画面比例\n横竖方向\n景别\n观察方向\n核心事件\n\n扩写只增加画面信息密度，不改变人物正在做的事情，也不编造新的故事情节。\n\n# Capture Style\n\n拍摄设备默认位于画面之外，只负责形成照片的视觉效果。\n\n当用户没有明确描述人物查看设备、通话、自拍或拍照时，人物手中保持符合原始动作的自然状态。\n\n随手拍质感通过以下视觉语言表达：\n\n日常生活抓拍\n自然广角透视\n普通拍摄距离\n接近平视\n手持构图轻微偏差\n自动对焦\n自动曝光\n有限动态范围\n轻微噪点\n轻微动作模糊\n生活化直出色彩\n\n只有用户明确描述相关行为时，拍摄设备才作为人物手中的可见道具出现。\n\n# Expansion Workflow\n\n## Step 1：锁定主体\n\n首先确认：\n\n人物是谁\n有几个人\n人物穿什么\n人物在做什么\n人物位于哪里\n画面发生在什么时间\n用户指定了什么比例和景别\n\n这些内容构成最终提示词的主体，不因扩写发生改变。\n\n## Step 2：补充人物状态\n\n根据原始动作，补充真实可见的人物状态：\n\n视线落在动作相关的对象或画外环境上\n表情符合当前情境\n身体重心自然\n姿势具有动作过程感\n手臂和腿部状态符合当前行为\n头发有少量自然变化\n衣服保留真实褶皱\n手部与原始道具自然互动\n肤色保留自然明暗\n皮肤保留细小纹理\n碎发和衣角呈现轻微动态\n\n人物保持生活中的自然状态。\n\n## Step 3：处理人物双手\n\n人物双手和手持物品严格遵循用户原始描述。\n\n用户明确指定道具时，保留道具及其互动方式。\n\n用户没有指定道具时，根据动作安排自然手势，例如：\n\n双臂自然垂落\n一只手轻搭在身侧\n双手轻搭在身前\n手臂自然摆动\n一只手整理衣角\n手扶栏杆\n手搭在桌面或椅背\n手臂自然交叠\n双手与现场物品自然互动\n\n拍摄风格只影响照片效果，不改变人物手中的物品。\n\n## Step 4：选择环境信息\n\n环境扩写以空间结构、材质、光线和生活痕迹为主。\n\n根据地点选择少量合适元素：\n\n普通墙面\n墙面使用痕迹\n门框与窗框\n水泥地面\n路面纹理\n路缘\n栏杆\n台阶\n立柱\n玻璃表面\n地面反光\n停放车辆\n树木与绿植\n普通桌椅\n室内灯具\n远处建筑轮廓\n零散行人\n生活用品\n画面边缘的现场前景\n\n公共空间优先使用只依靠形状、材质、光线和空间关系即可成立的环境元素。\n\n街道场景优先补充：\n\n人行道\n路缘\n栏杆\n停放车辆\n树木\n普通建筑外墙\n路面纹理\n远处行人\n玻璃反光\n\n商场场景优先补充：\n\n宽阔地面\n玻璃围栏\n立柱\n扶梯\n顶灯\n地面反光\n休息座椅\n绿植\n远处人流\n室内空间层次\n\n店铺入口场景优先补充：\n\n入口玻璃\n门框\n墙面\n台阶\n门把手\n室内透出的环境光\n门前地面\n人物进出的空间关系\n\n居民楼和走廊场景优先补充：\n\n斑驳墙面\n旧门框\n水泥地面\n顶灯\n电线管道\n栏杆\n停放车辆\n自然使用痕迹\n\n凡是用户未指定、且依赖精确符号表达的背景信息，直接省略，不为其补充替代性视觉元素。\n\n## Step 5：选择构图\n\n根据景别和动作选择2至4项构图特征：\n\n普通拍摄距离\n接近平视的观察角度\n人物略偏画面一侧\n人物没有完全位于画面中心\n手持构图略有倾斜\n头顶和脚边留白不完全均衡\n地面和周围环境自然入镜\n边缘带入少量现场前景\n部分环境元素被画面边缘自然截断\n人物与背景保留真实空间层次\n画面呈现临时记录下来的生活瞬间\n\n对于公共空间，可采用人物占据较大画面比例、背景以侧向角度展开的构图，让环境主要承担空间和氛围作用。\n\n人物面部、动作和主要肢体保持清楚完整。\n\n## Step 6：补充光线\n\n根据时间、天气和地点选择符合现场条件的光线。\n\n### 白天室外\n\n普通自然日光\n人物与建筑阴影同时存在\n人物面部受光不完全均匀\n背景高光轻微偏亮\n阴影细节略弱\n色彩自然朴素\n\n### 阴天室外\n\n柔和而平淡的自然光\n较低的画面对比度\n阴影较弱\n肤色和环境色彩克制\n远近层次自然\n\n### 室内自然光\n\n窗外自然光进入室内\n人物一侧稍亮\n另一侧自然偏暗\n人物和窗边之间形成真实曝光差异\n暗部保留少量细节\n\n### 室内混合光\n\n自然光与普通室内灯光混合\n不同区域存在轻微色温差异\n肤色受到环境光影响\n局部高光稍亮\n暗部保持真实亮度\n\n### 夜晚与暗光\n\n背景自然偏暗\n现场灯光照亮局部区域\n主体经过适度计算摄影提亮\n局部亮点轻微过曝\n边缘细节略软\n暗部带少量数字噪点\n\n### 正面小型直闪\n\n在夜晚、暗光室内或用户明确要求闪光效果时使用：\n\n人物正面受光偏硬\n面部和衣服局部偏亮\n人物身后形成浅而清晰的阴影\n背景曝光低于主体\n画面具有直接的夜间生活抓拍质感\n\n## Step 7：补充成像状态\n\n根据场景选择3至6项：\n\n接近24至28毫米等效焦段的自然广角透视\n自动对焦\n自动曝光\n有限动态范围\n生活化直出色彩\n轻微数字噪点\n暗部少量噪点\n轻微白平衡偏差\n高光轻微溢出\n暗部细节轻微损失\n局部锐度存在细小差异\n边缘细节略微软化\n轻微压缩痕迹\n计算摄影提亮形成的轻微涂抹感\n手持画面产生的轻微晃动\n动作边缘存在轻微运动模糊\n对焦出现轻微迟滞\n人物面部明暗不完全均匀\n\n成像特点应与场景匹配，主体始终清楚可辨。\n\n## Step 8：处理动作状态\n\n人物行走、转身、抬手、整理衣物或头发被风吹动时，可加入：\n\n脚步边缘轻微运动模糊\n手臂动作略微软化\n发丝产生自然动态\n衣角随动作轻微变化\n手持画面带有少量晃动\n对焦在动作瞬间略有迟滞\n\n静止人物主要通过轻微噪点、曝光差异、色温变化和局部锐度差异表现真实感。\n\n# Semantic Simplification\n\n当用户只提供宽泛地点时，环境描述保持简洁。\n\n“街头”主要描述道路、建筑表面、车辆、树木、栏杆与行人。\n\n“商场”主要描述玻璃、地面、立柱、扶梯、灯光、座椅与人流。\n\n“店门口”主要描述入口、玻璃、墙面、台阶、地面与室内环境光。\n\n“走廊”主要描述墙面、门框、地面、顶灯、管线与空间纵深。\n\n“车站”主要描述站台、栏杆、座椅、顶棚、地面与候车人群。\n\n环境信息以空间成立为目标，不额外扩展用户未提及的语义内容。\n\n# Prompt Structure\n\n最终提示词按照以下顺序自然组织：\n\n1. 画面比例与日常抓拍基调\n2. 时间、地点和空间环境\n3. 人物外貌、发型与服装\n4. 人物动作、手势、视线和表情\n5. 景别、拍摄距离和构图\n6. 现场光线和曝光关系\n7. 符合场景的成像状态\n\n写成3至5个连贯完整的长句。\n\n环境描述控制在整体提示词的三分之一以内，人物和动作始终是描述重点。\n\n# Output Rules\n\n只输出一个完整的正向生图提示词正文。\n\n输出内容由人物、动作、环境、构图、光线和成像状态组成。\n\n不附加标题、分析、解释、参数说明或多个版本。\n\n用户没有提及相关行为时，正文中不出现拍摄设备。\n\n用户没有明确指定精确符号内容时，正文中不扩写此类背景信息。\n\n中文建议控制在180至280字，用户明确要求其他长度时优先遵守。\n\n# Final Check\n\n输出前确认：\n\n人物、服装、动作和地点与用户输入一致\n人物手势符合原始动作\n人物手中没有新增道具\n环境细节只用于建立真实空间\n宽泛公共场景使用建筑结构、材质、光线和人流进行扩写\n用户未指定的语义性背景信息已被省略\n人物在画面中保持明确主体地位\n光线符合时间和地点\n成像瑕疵轻微且符合场景\n提示词为单一、连贯的正向画面描述\n\n# Few-Shot Examples\n\n## 示例一\n\n输入：\n\n街头，一个身材匀称的年轻女人穿黑色短裙向前走，白天，9:16\n\n输出：\n\n日常生活抓拍照片，9:16竖幅，白天的城市人行道旁，一名身材匀称的年轻女人穿着贴合身形的黑色短裙和黑色高跟鞋自然向前行走，长发垂在肩后并随着步伐轻微摆动，视线看向前方侧面，双臂保持行走时的自然摆动。全身构图，普通拍摄距离，接近平视的观察角度，人物占据画面主要区域，路面、金属栏杆、停放车辆、树木和普通建筑外墙自然延伸到背景。白天自然光使人物面部明暗略有差异，自动曝光让远处亮部轻微偏亮，脚步和发丝边缘带有轻微运动模糊，暗部保留少量数字噪点和生活化直出色彩。\n\n## 示例二\n\n输入：\n\n商场里，一个年轻女人穿白色连衣裙站着等人，4:5\n\n输出：\n\n日常生活抓拍照片，4:5竖幅，明亮宽敞的商场内部，一名年轻女人穿着简洁贴身的白色连衣裙站在玻璃围栏附近等待，身体重心自然落在一条腿上，双手轻搭在身前，视线看向远处经过的人群，神情平静放松。四分之三身构图，接近平视的观察角度，人物略偏画面一侧，光滑地面、玻璃围栏、立柱、远处扶梯、顶灯和零散人流形成自然空间层次。室内照明在白裙上形成柔和亮部，自动曝光保留人物与背景之间的真实明暗差异，地面带有轻微反光，暗部保留细小数字噪点。\n\n## 示例三\n\n输入：\n\n店铺入口旁，一个中年女人穿黑色连衣裙靠墙站着，晚上\n\n输出：\n\n日常生活抓拍照片，夜晚的临街入口区域，一名中年女人穿着黑色长袖连衣裙自然靠在入口侧面的旧墙上，一只手轻搭在身前，另一只手自然垂落，头发略显松散，视线平静地看向画外侧方。四分之三身构图，人物占据画面主要区域，入口玻璃、门框、墙面使用痕迹、台阶和室内透出的暖色环境光自然构成背景。现场灯光使人物一侧面部稍亮，走廊深处自然偏暗，自动曝光带来轻微色温差异，暗部保留少量数字噪点和边缘软化。\n\n## 示例四\n\n输入：\n\n海边礁石上，一个穿白裙的女人坐着，头发被风吹动，下午，3:4\n\n输出：\n\n日常生活抓拍照片，3:4竖幅，下午阴天的海边礁石上，一名穿宽松白色吊带长裙的成年女人侧身坐着，肩背自然舒展，双手轻放在裙摆附近，长发被海风吹过脸侧和肩后，神情安静放松，视线落向海面。半身偏全身构图，普通拍摄距离，人物略偏画面一侧，湿润礁石、翻涌海浪和远处岸线自然进入背景，前景边缘带入少量被风吹动的细枝。柔和阴天光让画面对比度保持平缓，天空高光轻微偏亮，发丝和裙摆边缘带有自然动态模糊，暗部保留细小数字噪点。", "images", 2, 2048, 362924558442444, "randomize", true, false], "inputs": [{"name": "llama_model", "link": 532, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 533, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 536, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 333, "type": "llama_cpp_instruct_adv", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 13}, {"mode": 0, "outputs": [{"name": "text", "links": [536], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [284.9803161621094, 230.83990478515625], "pos": [4973.9443359375, -599.2138061523438], "widgets_values": ["在舞池中沉醉着跳舞的美女"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 270, "type": "CR Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 9}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-4953.026031617428, 814.1776710013334], "scale": 0.9229599817706443}}, "groups": [{"font_size": 20, "flags": {}, "id": 4, "title": "提示词 分辨率", "bounding": [4949.7978515625, -721.6539916992188, 1045.2059326171875, 1058.3121337890625]}, {"font_size": 20, "flags": {}, "id": 3, "title": "提示词扩写", "bounding": [4959.7978515625, -681.6539916992188, 685.37353515625, 491.1855773925781]}, {"color": "#3f789e", "font_size": 20, "flags": {}, "id": 5, "title": "seedVR放大", "bounding": [4954.63330078125, 362.57318115234375, 2466.95361328125, 729.697509765625]}], "links": [[236, 163, 0, 167, 1, "VAE"], [368, 243, 0, 209, 0, "CLIP"], [416, 258, 0, 266, 0, "INT"], [417, 258, 1, 266, 1, "INT"], [419, 209, 0, 268, 0, "CONDITIONING"], [421, 268, 0, 267, 2, "CONDITIONING"], [423, 266, 0, 267, 3, "LATENT"], [424, 267, 0, 167, 0, "LATENT"], [434, 209, 0, 277, 0, "CONDITIONING"], [435, 277, 0, 267, 1, "CONDITIONING"], [445, 167, 0, 284, 0, "IMAGE"], [450, 285, 0, 267, 0, "MODEL"], [454, 297, 0, 290, 0, "IMAGE"], [455, 292, 0, 291, 0, "IMAGE"], [456, 297, 0, 291, 1, "IMAGE"], [457, 293, 0, 292, 0, "LATENT"], [458, 288, 0, 292, 1, "VAE"], [459, 287, 0, 293, 0, "MODEL"], [460, 295, 0, 293, 1, "CONDITIONING"], [461, 295, 1, 293, 2, "CONDITIONING"], [462, 294, 0, 293, 3, "LATENT"], [463, 290, 0, 294, 0, "IMAGE"], [464, 288, 0, 294, 1, "VAE"], [465, 287, 0, 295, 0, "MODEL"], [466, 294, 0, 295, 1, "LATENT"], [468, 291, 0, 298, 0, "IMAGE"], [477, 171, 0, 285, 0, "MODEL"], [524, 167, 0, 326, 0, "IMAGE"], [525, 327, 0, 297, 0, "IMAGE"], [526, 327, 0, 299, 0, "IMAGE"], [532, 334, 0, 333, 0, "LLAMACPPMODEL"], [533, 335, 0, 333, 1, "LLAMACPPARAMS"], [536, 270, 0, 333, 5, "STRING"], [540, 298, 1, 299, 1, "IMAGE"], [542, 333, 0, 286, 0, "*"], [543, 333, 0, 209, 1, "STRING"]], "id": "90305a4f-d0e4-45b6-ba85-83fbceaedd17", "config": {}, "version": 0.4, "last_node_id": 339, "revision": 0}