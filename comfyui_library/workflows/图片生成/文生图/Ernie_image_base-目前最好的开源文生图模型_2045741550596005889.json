ab": false, "cnr_id": "comfy-core", "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "SaveImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 23}, {"mode": 0, "outputs": [{"name": "width", "links": [171, 172], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [169, 170], "label": "height", "type": "INT", "localized_name": "height"}], "size": [287.404296875, 150], "pos": [247.46783447265625, -94.10505676269531], "widgets_values": [false, "1024x1024 (1:1) (方形)", 1024, 1024], "inputs": [{"widget": {"name": "use_custom_resolution"}, "name": "use_custom_resolution", "label": "use_custom_resolution", "type": "BOOLEAN", "localized_name": "use_custom_resolution"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "custom_width"}, "name": "custom_width", "label": "custom_width", "type": "INT", "localized_name": "custom_width"}, {"widget": {"name": "custom_height"}, "name": "custom_height", "label": "custom_height", "type": "INT", "localized_name": "custom_height"}], "flags": {}, "id": 143, "type": "TTResolutionSelector", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TTResolutionSelector"}, "order": 7}, {"mode": 0, "outputs": [{"name": "STRING", "links": [133, 134], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [400, 200], "pos": [249.69021606445312, -390.7402038574219], "widgets_values": ["一幅科幻概念艺术渲染图，采用竖幅3:4比例，强调从穹顶到地底的完整立体空间。画面主体是一座建在巨型地下洞穴中的立体城市核心区，洞穴穹顶距离地面约800米，穹顶上镶嵌着一颗巨大的人造太阳灯球，发出暖白色的光芒，城市由数十根巨型混凝土柱支撑，分为地下四层：顶层为商业和居住混合区，建筑风格为装饰艺术与科幻的结合，中层为交通层，无数磁悬浮车辆在立体交错的透明管道中穿梭，下层为农业层，巨大的水培农场层层堆叠，最底层为工业层，暗红色的熔炉光芒从缝隙中透出。画面中央位置，有一条从顶层直达底层的透明观光电梯，电梯轿厢为圆柱形全玻璃结构，电梯内站着一位年轻的东亚女性地质工程师，身穿卡其色的工装连体衣，头戴安全帽，胸前挂着一副防眩光护目镜，双手背在身后，身体微微前倾，目光向下凝视着底层的工业区，表情专注而沉稳，安全帽下的黑色短发和清晰的面部轮廓在玻璃反光中格外醒目。背景是洞穴穹顶的人造太阳和放射状的光线，中景是密密麻麻的立体交通管道和悬浮车辆留下的彩色光轨，底层是暗红色熔炉光芒映照下的工业轮廓，远处洞壁上隐约可见巨大的支撑结构桁架。画面运用了鱼眼镜头和长曝光合成效果，前景的电梯轿厢和人物保持清晰，中景的交通层呈现光轨效果，底层工业区则保留细节的同时笼罩在大气雾霾中。光线处于人造白昼环境，人物主要被电梯内的隐藏灯带和穹顶太阳的漫射光照亮，面部呈现柔和的暖白色调，与中景冷蓝色的悬浮车灯轨和底层暗红色的熔炉光芒形成完整的冷暖光谱。整体色调为暖白色、冷蓝色、暗红色、混凝土灰与金属银交织，光影、玻璃反射与立体分层共同营造出一种宏大、有序且充满工业美学的立体城市核心区视觉体验。竖幅构图强化了从穹顶到地底八百米垂直落差的完整空间叙事，以及人物在透明电梯中悬浮于城市各个层级之间的纵深感。\n\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 107, "type": "PrimitiveStringMultiline", "title": "String (Multiline - Prompt)", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.42.11", "VHS_latentpreview": false, "ds": {"offset": [48.90781476223856, 317.0833375452064], "scale": 1.5535220464768997}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "Text to Image", "bounding": [690.4856567382812, 496.85467529296875, 1450, 1060]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Image Size", "bounding": [720.4856567382812, 1236.854736328125, 310, 290]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Prompt", "bounding": [1040.4857177734375, 546.8546752929688, 470, 670]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Model", "bounding": [710.4856567382812, 546.8546752929688, 320, 670]}