QwenEditResolution"}, "order": 3}, {"outputs": [{"name": "text", "links": [144], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["一幅描绘八十年代中国北方村庄角落的宁静场景画面，中景镜头。\n画面的视觉中心是一棵枝繁叶茂的巨大老槐树，树干粗糙，布满岁月的痕迹。浓密的树冠在地面上投下大片的斑驳树荫。\n树荫下，安放着一个由两层石盘组成的旧石磨。石磨的表面因长年使用和风吹日晒而变得光滑，边缘有些许破损，石缝里长着几点青苔。\n石磨周围是压实的黄土地，地面上散落着一些干枯的落叶。背景是村庄的夯土墙和一角青瓦房顶，略带虚化处理，以突出前景的主体。\n清晨的阳光透过树叶的缝隙，化作一道道光束洒在地面和石磨上，形成明暗交错、光影斑驳的效果。整个场景宁静、古朴，充满了浓厚的生活气息，仿佛在等待着一个故事的发生。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [-495.2311706542969, 131.36782836914062], "id": 78, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}, {"outputs": [{"name": "STRING", "links": [145], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#332922", "widgets_values": ["大明动画风格", "", ",", ""], "inputs": [{"widget": {"name": "text1"}, "name": "text1", "label": "text1", "type": "STRING", "localized_name": "text1"}, {"widget": {"name": "text2"}, "name": "text2", "link": 144, "label": "text2", "type": "STRING", "localized_name": "text2"}, {"widget": {"name": "separator"}, "name": "separator", "label": "separator", "type": "STRING", "localized_name": "separator"}, {"widget": {"name": "text3"}, "shape": 7, "name": "text3", "label": "text3", "type": "STRING", "localized_name": "text3"}], "flags": {"collapsed": true}, "type": "ConcatTextOfUtils", "mode": 0, "bgcolor": "#593930", "size": [400, 220], "pos": [-20.250802993774414, 361.318359375], "id": 82, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ConcatTextOfUtils"}, "order": 9}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#332922", "widgets_values