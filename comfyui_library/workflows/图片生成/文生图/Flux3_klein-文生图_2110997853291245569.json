\n\n- 画风：明亮丰富马卡龙配色，线条干净，市井治愈的小镇生活感，密集小人物与小动物，充满烟火气；\n- 题材：多层立体剖视小镇，描绘周末小镇人们休闲日常，属于手帐造景贴纸原图。"], "inputs": [{"name": "clip", "link": 185, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [487.0860900878906, 334.135009765625], "pos": [2881.048095703125, 158.32177734375], "id": 151, "properties": {"cnr_id": "comfy-core", "ver": "0.41.0", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"outputs": [{"name": "width", "links": [195], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [196], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#233", "widgets_values": ["9:16 (Portrait Widescreen)", 1.5, 8], "inputs": [{"shape": 7, "name": "preview", "label": "preview", "type": "RESOLUTION_PREVIEW", "localized_name": "preview"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "mode": 0, "bgcolor": "#355", "size": [278.2530212402344, 150], "pos": [3414.224365234375, 333.4559631347656], "id": 160, "properties": {"cnr_id": "comfy-core", "ver": "0.41.0", "ue_properties": {"widget_ue_connectable": {"preview": true, "aspect_ratio": true, "megapixels": true, "multiple": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 4}], "extra"