e"}], "flags": {}, "type": "AILab_QwenVL", "mode": 0, "bgcolor": "#374539", "size": [411.7745056152344, 485.4484558105469], "pos": [683.658447265625, 3261.664794921875], "id": 164, "properties": {"cnr_id": "ComfyUI-QwenVL", "ver": "fcd1ada87a28f922cb887f779db32429f78a022c", "widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 22}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [256], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [473.4804382324219, 300.0079040527344], "pos": [97.81299591064453, 3255.654541015625], "widgets_values": ["东方佳人全身立于古雅书房，身旁铺展宣纸泛着温润墨韵，静谧禅意氤氲其间  \n——柔光从左上方倾泻而下，形成柔和漫射光勾勒身形曲线；背景虚化处理，焦外散景朦胧衬托主体  \n\n主视角锁定人物半身至足踝，面部特写呈现眼眸内跃动眼神光，虹膜纹理细腻明晰，目光沉静却富有穿透力  \n镜头采用极浅景深，仅保留衣袂边缘及指尖处真实毛细纹路，在暖灰基调上浮现出微妙肌理层次  \n\n肌肤呈哑光玉质触感，无塑料假象，每一寸肤相皆显自然沟壑；发丝间垂落薄雾般的逆光粒子，随呼吸轻颤成流动光晕  \n衣物褶皱含蓄卷曲，棉麻质地在低饱和色域里散发低调奢华质感，不染俗气之浓烈  \n\n整幅影像以照片写实主义技法构筑，具备超锐利原始画质，黑白过渡层层递进却不失温度，光影动态范围精准掌控  \n运用电影级布光构建情绪纵深，最终呈现如同胶片珍藏般的古典美学史诗 —— 不需修饰，自生高贵  \n\n(8K | 超细节 | 杰作 | 最佳质量 | 基于物理渲染 | 光线追踪)"], "inputs": [{"name": "text", "link": 218, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 167, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "609f3afaa74b2f88ef9ce8d939626065e3247469", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 23}, {"mode": 0, "outputs": [{"name": "STRING", "links": [254], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [381.8741455078125, 110.5600357055664], "pos": [1941.480712890625, 3625.36669921875], "widgets_values": ["全身照，东方女性，书房宣纸旁，静谧中式佳人，低饱和高级\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 187, "type": "PrimitiveStringMultiline", "title": "提示词", "properties": {"cnr_id": "comfy-core", "ver": "0.20.1", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 14}, {