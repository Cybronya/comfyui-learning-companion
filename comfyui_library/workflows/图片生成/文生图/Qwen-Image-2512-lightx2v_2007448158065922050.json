，半透明的皮肤下，脉络里流淌的不是血液，而是被捕获的星光。TA身着由“固态时空”织成的长袍，上面用活的星尘刺绣着早已湮灭的古老星座。TA所在的空间是一个没有书籍的图书馆，取而代之的是亿万个悬浮的水晶光棱，每一个光棱都封印着一颗恒星从诞生到超新星爆发的完整记忆。档案管理员正伸出修长的手指，轻轻触碰其中一个光棱，指尖的触碰让那颗“死亡之星”的最后光芒瞬间绽放，形成一道绚烂的、充满悲剧美的环状星云，照亮了TA毫无波澜的脸庞。整个场景的光源仅来自这些记忆光棱和背景中遥远的星云，构图采用对称式构图，充满神性的静谧与宇宙级的孤独。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 13, "type": "PrimitiveStringMultiline", "title": "Prompt", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.5.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 5}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [13], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [315, 106], "pos": [657.7755126953125, 1576.64111328125], "widgets_values": [1472, 1104, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 14, "type": "EmptySD3LatentImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {"batch_size": true, "width": true, "height": true}, "Node name for S&R": "EmptySD3LatentImage"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [2073.2258853061026, -563.4964898786778], "scale": 0.35049389948139253}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Model", "bounding": [1148.312988281