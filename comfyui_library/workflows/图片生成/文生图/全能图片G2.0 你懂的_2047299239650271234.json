 [7063.17236328125, 2388.84423828125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 14, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 27, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 16}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [16], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [274.080078125, 314.0000305175781], "pos": [7736.95849609375, 2280.756103515625], "widgets_values": ["729aea918435abf09c52e896e592c418fafe1229fe7036341afd08694ade91c4.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 28, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 5}, {"mode": 4, "outputs": [{"name": "prompt", "links": [17], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [8114.181640625, 2659.636962890625], "widgets_values": ["为韩立制作的一张仙侠风格的角色海报，采用极具艺术感的双重曝光构图，其视觉核心是以人物的半身轮廓作为风景的载体，而画面外部背景呈现出通透、留白的浅月色与墨韵感。画面上方是韩立清冷沉稳的侧颜特写，面容平凡而棱角分明，肤色健康微黝，五官端正深邃，长发以简单青竹发簪束起，气质内敛却透露着不易察觉的锋芒与坚毅。在韩立的侧脸下方、肩颈及衣袍区域被设计为透明的视觉容器，内部巧妙嵌套着云雾缭绕的修仙世界景象——远处是巍峨的落云宗仙山、黄枫谷的飞檐楼阁与悬瀑飞流，近处穿插着青翠的天雷竹林、竹林间悬浮着散发出淡金色雷光的青竹蜂云剑阵以及古朴的青瓷小绿瓶中流淌着墨绿色灵液的灵动光效，云雾之中星星点点的灯火与飞剑寒芒闪烁其间。画面下方是韩立的全身缩影，他身着一袭墨青色点缀雷纹的朴素道袍，沉稳地盘坐在月光水面上一朵散发着温润青光的巨大莲台之上，右手轻握悬浮于身侧的青竹蜂云剑，左手虚托一只淡绿色的小瓶（掌天瓶），周身有细微的雷光游走，于低调中尽显万法归宗的强者气场。背景整体采用极简的深色基调，以一轮若有若无的巨大圆月、如丝绸般流动的淡墨色云气与细碎的银色雷光星芒组成，营造出一种空灵、深邃且充满禅意的超凡意境。整体色调统一为冷冽的青黑色、墨绿色与月白色，呈现出电影级CG的写实质感与东方水墨意境相结合的独特美感。画面文案布局如下：右上角竖排书写作品名“凡人修仙传”及其英文“A RECORD OF A MORTAL'S JOURNEY TO IMMORTALITY”与红底白字的“修仙”印章；右侧中部竖排意境诗句“凡骨问道逆天行，一念通玄万法寂”；左侧中部以苍劲凌厉的书法字体呈现角色名“韩立”及其拼音“HAN LI”；左下角为两行八字的人物性格描述“道心坚定，杀伐果断，谋定后动，不负本心”；整张海报构图虚实相生，完美融合了新中式意境美学与硬核修仙的凌厉气韵。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 29, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 6}, {"mode": 4, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [725.853271484375, 624.9677734375], "pos": [8994.1826171875, 2276.75537109375], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 15, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 30, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 17}, {"outputs": [], "color": "#432", "widgets_values": ["这个节点有2个用法，如果令牌分组default，目前已经支持2K 4K，且支持分辨率选择，4K可能部分分辨率不生效，价格0.04积分，第二个办法就是把令牌分组改成openai优质，这是官方版，按照TOKEN收费，我之前跑的4K的大概1积分多，具体看设置和要求，并非固定\n\n\n贞贞的AI工坊（各种API）：https://ai.t8star.cn/register?aff=6ZPd80923\n左侧令牌，创建令牌，随便取个名字，复制API即可使用，，每日签到领积分\nComfyui调用API节点：https://github.com/T8mars/Comfyui-zhenzhen\n\n\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 4, "bgcolor": "#653", "size": [378.3358459472656, 199.41868591308594], "pos": [7719.533203125, 2673.38623046875], "id": 32, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"mode": 4, "outputs": [{"name": "apikey", "links": [18], "label": "apikey", "type": "STRING", "localized_name": "apikey"}], "size": [388.1313171386719, 152.80702209472656], "pos": [8108.63720703125, 2416.7734375], "widgets_values": ["zhenzhen", "", "", false], "inpu