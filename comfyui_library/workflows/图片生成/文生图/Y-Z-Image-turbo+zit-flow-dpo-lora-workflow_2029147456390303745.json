": "#232", "widgets_values": ["一位年轻俊美的亚洲女子，她有着长长的、笔直的黑色头发和白皙的皮肤，正坐在一个木制框架的窗户旁。她戴着一顶米色的平顶帽，穿着一件宽松的米色毛衣，露出了肩膀，穿着白色的高腰内裤和白色的短袜，脚蹬白色的运动鞋。她的双腿膝盖交叉，凝神地凝视着左边窗外的景色。背景中可以看到窗户玻璃上的白色建筑倒影，前景中有一些模糊的秋叶，为原本平淡的色调增添了一抹温暖的色彩。可以看到木制窗户框架的纹理，透过窗户洒进来的光线在她的脸上和身上投下柔和的阴影。她的表情平静而沉思。画面有一种自然、真实的感觉，重点突出了主人公宁静而内省的瞬间。整体风格休闲而亲密，捕捉到了一个安静、沉思的时刻。构图和光线强调了主人公平和的神态以及温馨的秋日氛围。"], "inputs": [{"name": "clip", "link": 1, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [943.7000122070312, 335.29998779296875], "id": 4, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"text": true}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"outputs": [{"name": "MODEL", "links": [12], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#223", "widgets_values": ["ZIT-flow-dpo-lora.safetensors", 0.8500000000000002], "inputs": [{"name": "model", "link": 13, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#335", "size": [303.8534240722656, 82], "pos": [848.3821411132812, 179.72686767578125], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 6}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.30.6", "VHS_latentpreview": false, "ds": {"offset": [-57