, "name": "thinking", "label": "thinking", "type": "BOOLEAN", "localized_name": "thinking"}, {"widget": {"name": "use_default_template"}, "shape": 7, "name": "use_default_template", "label": "use_default_template", "type": "BOOLEAN", "localized_name": "use_default_template"}, {"widget": {"name": "sampling_mode.temperature"}, "name": "sampling_mode.temperature", "label": "sampling_mode.temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "sampling_mode.top_k"}, "name": "sampling_mode.top_k", "label": "sampling_mode.top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "sampling_mode.top_p"}, "name": "sampling_mode.top_p", "label": "sampling_mode.top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "sampling_mode.min_p"}, "name": "sampling_mode.min_p", "label": "sampling_mode.min_p", "type": "FLOAT", "localized_name": "min_p"}, {"widget": {"name": "sampling_mode.repetition_penalty"}, "name": "sampling_mode.repetition_penalty", "label": "sampling_mode.repetition_penalty", "type": "FLOAT", "localized_name": "repetition_penalty"}, {"widget": {"name": "sampling_mode.seed"}, "name": "sampling_mode.seed", "label": "sampling_mode.seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "sampling_mode.presence_penalty"}, "shape": 7, "name": "sampling_mode.presence_penalty", "label": "sampling_mode.presence_penalty", "type": "FLOAT", "localized_name": "presence_penalty"}], "flags": {}, "id": 60, "type": "TextGenerate", "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "TextGenerate"}, "order": 8}, {"outputs": [{"name": "STRING", "links": [85], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["一位女性伫立于海边的礁石滩上，身着纯黑色抹胸长裙，头戴宽檐斗笠，手捧竹编灯笼，周围遍布成群的发光灯笼，背景为红紫色渐变天幕与海域，整体氛围神秘肃穆且极具东方美学张力。\n\n**人物与姿态：**\n\n人物位于画面正中央位置，以侧面朝向画面左方。身形修长高挑，体态挺拔优雅。头部微微低垂，目光凝视手中捧持的灯笼。双手交叠捧托灯笼——左手在下右手在上，手指纤细姿态端庄。发型为整洁的盘发或短发造型完全收纳于帽下。\n\n**服饰与头部装饰：**\n\n身穿一袭纯黑色的抹胸式紧身长裙（或连体礼服）——面料呈现哑光质感（似丝绒或缎面），剪裁修身合体贴合身体曲线，从胸部一直垂落至脚踝以下形成流畅的纵向线条。肩部及手臂完全裸露，锁骨线条清晰可见。\n\n头戴一顶宽大扁平的黑色斗笠式帽饰——帽檐宽阔呈等腰三角形/菱形轮廓，边缘线条硬朗利落，帽顶有微微的弧度，整体造型带有浓郁的传统东方风格与现代极简设计的融合感。\n\n**道具细节：**\n\n手中捧持一盏大型竹编灯笼——呈圆筒形（略带椭圆形），框架由细密的竹篾编织交叉构成菱形网格纹理，内部光源明亮透出温暖的琥珀黄色光芒，通过竹编缝隙形成规则的光影图案。灯笼顶部有提手结构。\n\n**前景与环境：**\n\n人物脚下及周边区域布满了大量同款的竹编织灯笼——大小略有差异（部分为矮胖的圆桶形、部分为高瘦的长筒形），均由相同工艺的竹篾网格编织而成，内部透出暖黄色的灯光。所有灯笼之间以鲜红色的粗绳/渔网状绳索相互缠绕连接，红色网线在灯笼群中交错纵横形成了醒目的色彩脉络和层次框架。地面为潮湿的黑色礁石滩表面，有明显的积水反光效果映射出灯笼的光点。\n\n远景是一片开阔的海域——水面平静深沉呈深蓝黑色调，远处可见几处暗色的礁石轮廓露出水面。地平线清晰横贯画面中下部位置。\n\n天空占据了画面约上半部分空间——呈现出极为强烈的色彩渐变：从地平线附近的鲜艳玫红色向上逐渐过渡为深紫红色、再往上变为暗紫黑色，整个天幕被染成一片浓烈的暗红色调，云层稀薄均匀分布，光线来自日落/日出时分的自然散射光。\n\n**构图与色调：**\n\n竖幅全身构图，人物居中占据绝对视觉重心成为画面的叙事核心。整体配色方案极为大胆且克制——大面积的纯黑色（服装+帽子+礁石+远海）作为绝对的主导基底奠定了神秘沉稳的氛围基调；红色天幕提供了戏剧性的背景色彩张力；灯笼的暖黄色内光则成为画面中最温暖明亮的视觉焦点；而缠绕于灯笼之间的鲜红绳网则在地面层注入了强烈的色彩节奏与纹理层次。人物全身黑色剪影与手中发光的灯笼形成了\"暗与亮\"、\"冷与暖\"的核心对比关系。水面反光增加了画面的纵深感与梦幻质感。光线条件为黄昏/黎明的自然弱光环境配合灯笼的人造暖光源，使整体视觉效果充满电影级的氛围感与东方美学的意境深度。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Text String (User Prompt)", "mode": 0, "bgcolor": "#353", "size": [546.1563110351562, 424.7207336425781], "pos": [-800.3863525390625, -17.502880096435547], "id": 63, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 5}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [3321.31893857704, 1584.4294968307017], "scale": 0.23092115320381806}}, "groups": [], "links": [[72, 56, 0, 51, 0, "CLIP"], [75, 51, 0, 53, 1, "CONDITIONING"], [77, 52, 0, 53, 3, "LATENT"], [78, 53, 0, 54, 0, "LATENT"], [79, 57, 0, 54, 1, "VAE"], [82, 56, 0, 60, 0, "CLIP"], [83, 61, 0, 60