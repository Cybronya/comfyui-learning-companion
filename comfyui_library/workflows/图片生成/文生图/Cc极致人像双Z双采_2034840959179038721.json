幻风，色彩柔和低饱和，以粉色和白色为主。\n构图上，人物居中，占据画面主体，庭院元素和背景：同一人物不同服饰通过双重曝光完整地印在人物轮廓内。\n8K 超高清，细节丰富，皮肤质感通透，樱花花瓣纹理清晰，和服面料的轻薄褶皱自然，暗角过渡柔和，整体呈现出细腻、空灵的梦境质感。\n\n\n\n\n"], "inputs": [{"name": "clip", "link": 77, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [438.4783020019531, 473.3900146484375], "pos": [1249.739990234375, 288.453369140625], "id": 8, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 14}, {"outputs": [{"name": "prompt", "links": [102], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#233", "widgets_values": [""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {"collapsed": false}, "type": "CR Prompt Text", "mode": 4, "bgcolor": "#355", "size": [388.7658386230469, 430.44891357421875], "pos": [2532.775634765625, 1961.4302978515625], "id": 63, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#593930", "groupcolor": "#b06634", "color": "#332922"}}, "order": 8}, {"outputs": [{"shape": 6, "name": "STRING", "links": [52], "label": "STRING", "type": "STRING", "localized_n