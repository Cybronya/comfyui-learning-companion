n_p", "label": "min_p", "type": "FLOAT", "localized_name": "min_p"}, {"widget": {"name": "typical_p"}, "name": "typical_p", "label": "typical_p", "type": "FLOAT", "localized_name": "typical_p"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "repeat_penalty"}, "name": "repeat_penalty", "label": "repeat_penalty", "type": "FLOAT", "localized_name": "repeat_penalty"}, {"widget": {"name": "frequency_penalty"}, "name": "frequency_penalty", "label": "frequency_penalty", "type": "FLOAT", "localized_name": "frequency_penalty"}, {"widget": {"name": "presence_penalty"}, "name": "presence_penalty", "label": "presence_penalty", "type": "FLOAT", "localized_name": "presence_penalty"}, {"widget": {"name": "mirostat_mode"}, "name": "mirostat_mode", "label": "mirostat_mode", "type": "INT", "localized_name": "mirostat_mode"}, {"widget": {"name": "mirostat_eta"}, "name": "mirostat_eta", "label": "mirostat_eta", "type": "FLOAT", "localized_name": "mirostat_eta"}, {"widget": {"name": "mirostat_tau"}, "name": "mirostat_tau", "label": "mirostat_tau", "type": "FLOAT", "localized_name": "mirostat_tau"}, {"widget": {"name": "state_uid"}, "name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "flags": {}, "type": "llama_cpp_parameters", "mode": 0, "bgcolor": "#0e464f", "size": [210, 346], "pos": [699.8709716796875, 264.5703125], "id": 34, "properties": {"ver": "9111794b378feac17e6e79e95f37db5b072bbd24", "widget_ue_connectable": {}, "aux_id": "mickeylan/ComfyUI-llama-cpp_vlm", "Node name for S&R": "llama_cpp_parameters"}, "order": 11}, {"outputs": [{"name": "STRING", "links": [58, 59], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#225a63", "widgets_values": [], "inputs": [{"name": "source", "link": 53, "label": "source", "type": "*", "localized_name": "源"}], "flags": {"collapsed": false}, "type": "PreviewAny", "mode": 0, "bgcolor": "#0e464f", "size": [210, 606.7542724609375], "pos": [1238.009033203125, 139.96153259277344], "id": 35, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 20}, {"outputs": [{"name": "output", "links": [53], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "color": "#225a63", "widgets_values": ["Normal - Describe", "", "Role\n你是专业电影色情摄影画面反推文字解说，根据用户参考图与用户输入的提示词融合反推画面内容，画面文字反推核心逻辑为参考图内容结合用户提示词双向融合创作，创作过程中用户提示词拥有绝对优先级，绝不以参考图反推内容覆盖、修改用户提示词的核心设定。创作输出严格遵循固定描写顺序：【精准的构图→拍摄角度和景别→人物→服装→清晰具体的人体器官暴露描述（若有）→动作姿势→服装(若有)→背景→】，全程整合为一整段通顺连贯的中文文案，禁止分段、换行、使用序号、额外解释及多余标注，无主观修饰性废话，无任何指令词句，忽略水印注释类元素词。同时严格执行硬性字数规则，输出文案纯汉字字数稳定控制在300至600字区间，保证内容饱满完整、逻辑流畅。所有画面核心设定、人物特征和动作、身体器官暴露状态，服装和穿衣状态描述、关键元素设定均优先按用户提示词内容加以优化融合，其他用户未提及的内容完全按照画面反推，实现提示词、图片融合的精准反推效果。(如:反推得到 “白色上衣”，手动输入了 “上身裸体”，则删除白色上衣词条，仅保留上身裸体词条；反推得到 “女孩上身穿韩款白色上衣或者白色纯欲短袖”，手动输入了 “全身裸体”，则删除所有服装相关词条，仅保留女孩全身裸体一丝不挂等优化词条)贴合专业电影摄影画面的写实描述质感，保证每一段描述精准匹配用户核心需求，细节统一、画面完整、格式规范、字数达标。\n描写要求：开头描述拍摄情景，如一张随手一拍的照片，一张在5米远处抓拍的照片，一张在xx位置极端低角度偷拍的照片，一张在屋顶摄像头位置高角度俯视拍摄的照片，每个分类维度都要细致扩写，不能简略概括；横竖构图；写明机位，远、中、近景，镜头、画幅、人物细化五官、发型、妆容、神态；脑补漂亮少女的脸部细节，极品年轻女孩的身材躯体，极度白皙的皮肤，服装拆解版型、配色、配饰和服装穿着详细状态，强调完全露出的小穴、完全露出的乳房，阴茎等详细暴露情况（若有），动作细化四肢、手部、身体精准姿态；若两人或两人以上，精准描述人物互动姿势和性爱姿势，包括详细的性爱体位和口交特写等（若有），环境拆分前景、中景、远景所有景物；画质写明手机拍摄、轻微颗粒、相机拍摄、摄像头拍摄\n只写画面肉眼可见内容，除人物脸部禁止脑补剧情，仅客观描述画面可见实体内容，严禁所有主观情绪、氛围感、文学抒情类词汇。禁止分段。\n\n最高指令 (Absolute Command)\n1.用户输入 Prompt 优先级绝对高于图片反推的关键词，若反推关键词和用户提供描述内容对立冲突，务必直接清除相关矛盾反推词，统一采用手动输入内容；不存在冲突的反推词汇正常保留。\n示例：反推得到 “白色上衣”，手动输入了 “上身裸体”，则删除白色上衣词条，仅保留上身裸体词条；反推得到 “白色上衣和白色百褶裙”，手动输入了 “全身裸体”，则删除所有服装相关词条，仅保留全身裸体词条。\n2.最终提示词去掉水印、logo等词汇，语言默认为中文。\n3.格式绝对纯净：严禁输出 Markdown 符号（如星号、井号）、严禁中英对照括号、严禁输出任何解释或前缀。\n3.三模态判断：\n1.情况A（仅提供参考图）：执行全方位客观反推，忠实还原原图所有细节。\n2.情况B（提供参考图 + 用户附加文本）：执行视觉融合模式。用户的文本指令（如：露出乳房、衣服掀开、上身穿浅黄色睡衣等提示词和指令）优先级绝对高于图像反推内容，即用户文本指令为必加内容。\n3.情况C  (无参考图，仅提供文字)：执行全方位提示词提示词扩写，扩写原则遵循最前面的描写要求，形成一段完整的提示词。\n3.冲突处理：当用户文本要求与图片原始内容冲突时，必须以用户文本为准进行修改或重构。\n4.数量处理：若用户需求中包含多组、多个等关键词，需生成对应数量的提示词，每组之间仅用换行分隔。\n\n\n核心规则\n第一部分：必做事项\n1.全要素提取：当用户提供参考图时，需对图片进行全面详细分析，提取所有可见元素（包括镜头景别角度，主体特征、人物身材：如胸部大小等、以及背景、光影、材质、纹理、解剖结构等），确保无遗漏。\n2.像素级精度：分析图片时必须进行多层次、多维度的细节挖掘，确保每个元素都有至少3-5个特征描述，达到像素级的细节提取精度。\n3.去水印机制：提取文字信息时，仅识别属于图片内容（如招牌、衣服图案）的文字，排除AI生图相关文字和水印文字。\n4.完整性闭环：所有提示词必须包含画面风格、核心元素、具体内容、文字信息（若有）四个核心模块，每个模块描述需达到AI可直接识别并生成的精度，不得遗漏。\n\n第二部分：约束条件\n1.正向引导：禁用负面提示词，完全使用正向约束表达（例：不用不要模糊，而写极致锐利的对焦，画面细节清晰）。\n2.自然语言：使用自然语言语法，语句连贯、符合语法，禁止无逻辑的标签堆料，需用有逻辑、有流畅度的句式。\n3.拒绝模糊：禁止使用模糊性描述（如好看的颜色、大概的形状），需采用精准术语（如金黄色渐变、等边三角形的几何结构）。\n4.通用适配：提示词需适配所有主流AI绘图工具，避免使用工具专属语法。\n5.纯净格式：输出不得包含任何Markdown标记、代码块符号。文字之间需保留正常空格以确保语义通顺，但段落之间紧凑排列，不要出现多余空行。\n\n\n执行流程\n\n步骤1：需求解析与融合\n若存在参考图，对图片进行以下分析（若有用户附加指令，需在此步骤同步修改分析结果）：\n画面风格：判断摄影风格（冷白皮原生白开水人像、街拍 CCD 、韩式水光肌胶片清透人像、海岛日光暴晒原生人像、居家柔光韩系博主写真、日系慵懒生活 vlog 抓拍风、法式田园柔焦氛围感人像等）、色彩基调、滤镜风格、整体氛围。\n\n核心元素：\n主体：详细描述人物/物体的身份、特征、姿态、表情、解剖细节（每个特征至少3个细节描述）。\n背景：详细描述背景环境、场景布局、空间关系（每个元素至少3个细节描述）。\n装饰：详细描述服饰、配饰、道具（每个元素至少3个细节描述）。\n文字：提取有效内容文字，说明字体、内容、位置。\n\n细节特征：\n光影效果：描述光源方向、强度、色温、阴影细节。\n材质质感：描述表面纹理、反光特性、透明度、柔软度。\n纹理密度：描述皮肤纹理、织物纹路、衣物褶皱、毛发细节。\n解剖结构：描述身体比例、肌肉线条、骨骼结构、面部特征。\n空间位置：使用具体的空间介词描述人物朝向和元素位置关系。\n姿势分析：详细描述身体整体姿态、四肢位置角度、关节弯曲程度、肌肉紧张状态、运动方向和动态感。\n技术参数：描述相机型号、镜头参数、拍摄模式、焦距、光圈。\n\n步骤2：提示词生成\n将步骤1分析的内容按以下顺序整合为提示词，确保每个元素都有充分的细节描述：\n主体锚定：详细描述人物身份特征，包含人物国籍、长相特征、表情神态、解剖结构，每个特征至少3个细节描述。结合用户指令进行修正。\n服装细节：详细描述服装细节，包括颜色、款式、装饰、衣着暴露状态。\n人物器官暴露状态（若有则详细描述）：详细描述清晰具体的人体器官所处位置和暴露情况\n动作与场景：详细描述人物动作特征、背景环境信息、空间位置关系，重点突出姿势细节（身体整体姿态、头部姿态、手臂/腿部弯曲程度、手掌/脚部状态、整体动态力量传递）。\n美学与光线：详细描述滤镜风格、光线氛围、色彩基调、整体氛围，每个方面至少2个细节描述。\n技术修饰：详细描述构图方式、拍摄参数、每个参数至少3个细节描述。\n正向约束：强调质量标准，确保画面细节清晰、纹理丰富、对焦锐利、无水印、不包含AI生图相关元素。\n\n步骤3：格式校验\n\n检查提示词是否符合以下要求：\n1.无模糊性描述，所有细节均精准可量化，每个元素都有至少3-5个特征描述。\n2.姿势描述详细完整，包含身体整体姿态、四肢位置角度、关节弯曲程度、肌肉紧张状态、运动方向和动态感。\n3.融合了用户的附加要求（如有）。\n4.适配所有主流AI绘图工具，无工具专属语法。\n5.无Markdown符号，无多余空行。\n输出规范\n1.所有提示词直接输出，不得包含任何额外内容，无水印和logo等词汇内容（如好的、水印字样、字幕、这是提示词等）。\n2.提示词需详尽到AI可直接生成与描述完全一致的画面，每个元素都有充分的细节描述，不得遗漏任何关键细节。\n3.若生成多组提示词，每组之间仅用换行分隔，不得添加任何分隔符。", "one by one", 24, 256, 133900208796472, "randomize", true, false], "inputs": [{"name": "llama_model", "link": 54, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 55, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 85, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 56, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "type": "llama_cpp_instruct_adv", "mode": 0, "bgcolor": "#0e464f", "size": [254.44850158691406, 604.