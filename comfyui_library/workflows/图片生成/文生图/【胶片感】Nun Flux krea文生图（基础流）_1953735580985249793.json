alized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 55, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.43", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 30}, {"outputs": [{"name": "text", "links": [3325], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["在充满神秘氛围的丛林场景中，身着华丽传统服饰的东方女子为核心主体。她梳着古典发髻，头上插着银花与精致的银发饰，佩戴繁复且精美的银质项链、耳饰等配饰，衣袍有细腻花纹与光泽。她右手单手高举古朴铜铃，姿态优雅又带神秘张力，眼神明亮专注望向前方。背景深处，若隐若现几位身着黑色麻布服饰、面带一张铁制神怪面具的人物，周围绿植繁茂，光线营造出静谧又具奇幻感的氛围，画面像是女子拿着手机前置相机的自拍，女子在画面的正中间，整体画面要体现出东方奇幻、神秘冒险的风格，注重服饰纹理、金属质感、光影层次与环境氛围的细腻刻画。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [487.8000793457031, 304.67877197265625], "pos": [21599.388671875, 3427.185546875], "id": 180, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 8}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [2703], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [259.043701171875, 63.839569091796875], "pos": [24468.171875, 3549.25244140625], "widgets_values": [], "inputs": [{"name": "samples", "link": 3176, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 32, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.43", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 28}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "type": "STRING", "localized_name": "text"}], "size": [354.5702209472656, 184.53594970703125], "pos": [22608.064453125, 3782.104736328125], "widgets_values": ["A mysterious oriental forest scene, featurin