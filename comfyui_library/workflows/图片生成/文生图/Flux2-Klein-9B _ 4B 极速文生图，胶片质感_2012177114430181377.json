": \"f/1.4 (极浅景深，营造朦胧感)\",\n      \"快门速度\": \"Slow shutter speed effect (产生运动模糊/抽帧感)\",\n      \"胶片\": \"Kodak Vision3 500T, cinematic grain\"\n    },\n    \"视觉风格\": [\n      \"高对比度，高饱和度，低照度摄影\",\n      \"霓虹感\",\n      \"怀旧氛围\",\n      \"抽帧，运动模糊\"\n      \"背景是冷色（暗绿/深蓝），人物主体被暖色（橙/红霓虹灯）勾勒\"\n    ]\n  },\n  \"灯光\": {\n    \"类型\": \"调性照明 (Chiaroscuro lighting)\",\n    \"光源\": \"霓虹灯、百叶窗透过的光、或是单侧强光源\",\n    \"颜色\": \"蓝绿影调与暖橙色的对比 (Teal and Orange contrast)\",\n    \"氛围\": \"迷幻、朦胧、烟雾缭绕\"\n  },\n  \"构图\": {\n    \"规则\": \"非对称构图 (Asymmetrical composition)\",\n    \"透视\": \"带有前景遮挡的偷窥视角 (Framing within a frame)\",\n    \"景别\": \"特写或中景，强调人物面部光影\"\n  },\n  \"质量控制\": {\n    \"细节\": \"高度真实的皮肤质感，流动的光影，明显的胶片颗粒\",\n    \"负面约束\": \"明亮白光，均匀照明，现代感，极简主义，高清数码感，白平衡过准\"\n  }\n}"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [376.8189392089844, 541.0927734375], "pos": [-756.1123046875, -47.64677047729492], "id": 111, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 5}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [195], "VHS_MetadataImage": true, "ue_links": [{"controller": 130, "upstream": "62", "downstream_slot": 1, "downstream": 57, "upstream_slot": 0, "type": "VAE"}], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.28.6", "VHS_latentpreview": false, "ds": {"offset": [502.03663290982036, 191.58841176503984], "scale": 1.1671841070450215}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "4B 模型", "bounding": [-1385.860595703125, 176.42625427246094, 380.9122619628906, 363.8946838378906]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 8, "title": "9B 模型", "bounding": [-1386.1109619140625, -189.44998168945312, 385.170166015625, 346.8569030761719]}], "links": [[79, 57, 0, 58, 0, "