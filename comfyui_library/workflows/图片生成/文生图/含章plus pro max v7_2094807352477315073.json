r": 16}, {"outputs": [{"name": "CONDITIONING", "links": [562], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["**镜头视角与光影氛围**\n画面采用极具质感的**中近景特写**，焦点精准锁定在女性面部的上半部分，背景呈现柔和的焦外虚化，营造出一种朦胧的呼吸感。光线处理上运用了经典的“伦勃朗光”变体，主光源位于人物右上方，形成一道明亮的切面光，将她的鼻梁、颧骨及下颌轮廓勾勒得如雕塑般立体，而左脸颊与颈部则保留了细腻的阴影，增强了五官的深邃度。整幅画面笼罩在一层**暖调低饱和度的胶片滤镜**中，色调偏向奶油白与暖金，赋予肌肤一种温润如玉的通透质感，仿佛是在午后慵懒的阳光下被瞬间捕捉的私密瞬间。\n\n**主体姿态与细节刻画**\n画面中的女性呈现**微微低头的侧脸**姿态，视线向下垂落，带着几分迷离与沉思的神情，头部略微向左倾斜，形成一道优美的颈部S型曲线。她留着一头浓密的**黑色长卷发**，发丝在发梢处略显凌乱，几缕发丝自然地垂落在左肩与胸前，随风轻拂，发质看起来蓬松且充满光泽。妆容精致而清透，眼妆强调了微微上挑的眼尾，唇色为自然的**豆沙红**，双唇微张，显露出一种不设防的娇态。\n\n**服饰与配饰细节**\n她佩戴着一对极具设计感的**长款流苏耳坠**，银色金属链条上悬挂着数颗透明的水晶珠，垂坠感极强，耳坠在光线下折射出细碎的冷光，与她温暖的肤色形成冷暖对比。上身穿着**白色薄纱质地的吊带上衣**，肩带纤细，领口处带有层层叠叠的荷叶边设计，布料呈现出半透明的朦胧感，隐约勾勒出锁骨与颈部的纤细线条，展现出一种轻盈、浪漫的夏日风格。\n\n**构图与背景**\n构图上采用了**非对称的三分法**，人物面部位于画面的视觉重心偏左位置，右侧留有适当的呼吸空间。背景虽然高度虚化，依稀可辨是浅色的横向线条，可能是窗户的百叶窗或街道的模糊光影，这种浅景深处理有效地将主体的细节从环境中剥离出来。整体画面没有多余的干扰元素，纯粹通过光影的明暗交界来引导视线，展现出一种电影级的人物肖像美感。"], "inputs": [{"name": "clip", "link": 544, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 537, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [456.7753601074219, 435.0620422363281], "pos": [727.9916381835938, 1412.3253173828125], "id": 305, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"mode": 0, "outputs": [{"name": "GUIDER", "links": [559], "label": "GUIDER", "type": "GUIDER", "localized_name": "GUIDER"}], "size": [155.71875, 46], "pos": [1195.62451171875, 1428.301513671875], "widgets_values": [], "inputs