围感。写实摄影风格，非商业修图，保留轻微的噪点、锐化、高光不过曝，阴影有细节。动作体态呈现随性而为松弛慵懒"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 257, "type": "PrimitiveStringMultiline", "title": "Prompt", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.5.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 3}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [61, 62], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [270, 106], "pos": [-1978.464599609375, -33.27711868286133], "widgets_values": ["qwen_3_4b.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 18, "type": "CLIPLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 4}, {"mode": 0, "outputs": [{"name": "VAE", "links": [45, 454, 456, 458], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [270, 58], "pos": [-1983.010986328125, 144.2769317626953], "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localize