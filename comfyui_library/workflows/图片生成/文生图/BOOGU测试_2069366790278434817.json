"order": 21}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [3499.753662109375, 1671.8428955078125], "pos": [3792.267578125, 3731.312255859375], "widgets_values": [], "inputs": [{"name": "images", "link": 168, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 71, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 28}, {"outputs": [{"name": "prompt_list", "label": "列表", "type": "LIST", "localized_name": "prompt_list"}, {"shape": 6, "name": "prompt_strings", "links": [134], "type": "STRING", "localized_name": "prompt_strings"}], "color": "#233", "widgets_values": ["真实舞蹈摄影。一名穿白色长裙的专业舞者正在废弃的哥特式教堂中央高速旋转。她的身体向后舒展，一只手伸向高处，另一只手向身体外侧展开，宽大的裙摆在半空形成流畅圆弧。周围是高大的石柱、破损拱门、残缺雕像和彩色玻璃碎片，灰尘随着舞者的动作扬起。前景残破雕像形成自然遮挡，中景人物动作清晰，背景建筑向深处延伸。真实布料动态，准确人体结构，高速快门凝固旋转瞬间，优雅、激烈且富有舞台张力。", "原创温暖手绘幻想动画。一名戴黄色草帽、穿白色连衣裙的小女孩骑着红色旧自行车，从陡峭山坡高速俯冲而下，身体前倾，草帽几乎被狂风吹走；车篮里圆滚滚的白色幻想小动物惊讶地抓住篮沿。蜿蜒小路从近处延伸至远方，道路两旁的绿色草浪、野花和树叶被风卷向天空。远处红屋顶村庄沐浴在金色夕阳中，巨大的深蓝色雷雨云正向村庄逼近，一道阳光从云隙穿出。略带夸张的透视和动感，细腻铅笔线条、水彩背景、传统二维手绘质感，明亮绿色与风暴蓝形成对撞，兼具童真冒险感与风雨将至的紧迫感。", "真实科幻动作电影剧照，准确表现五名角色。五个人在受损的空间站控制室内组成紧凑的防御阵型。中央前方是银色人形机器人，单膝跪地，用半透明能量护盾挡住飞来的碎片；左侧是扎红色马尾的女工程师，正在使用机械工具抢修设备；右侧是穿橙色宇航服的男性飞行员，手持信号枪警戒；后方是银色短发的年长女船长，伸手指向舷窗；她身旁戴黑框眼镜的年轻男科学家紧握数据板。五人外貌、服装和动作明显不同，身体完整，彼此没有重叠。控制室内散落着设备零件，舷窗外可以看见受损飞船和地球，场面紧迫而可信。", "专业科幻悬疑电影海报，完整设计与清晰排版。画面底部是一名背对观众、身穿鲜红色长大衣的女人，独自站在平静的黑色水面上，她的红色倒影向下延伸。画面中央是一颗巨大而破碎的白色星球，无数碎片悬浮在周围；画面上方，一座上下颠倒的未来城市从云层中垂直降落，密集建筑如尖刺般指向女人，形成强烈的压迫感与尺度反差。\n顶部用醒目、清晰、准确的白色中文字体写：“逆光之城”；其下写英文：“CITY AGAINST THE LIGHT”；底部写：“2026.10.01”。采用黑色、深蓝色、白色和鲜红色配色，中心轴构图，空间层次清晰，留白精致。所有文字必须完整准确，不得出现错字、漏字、重复内容或额外文字。具有国际院线科幻电影海报的专业设计、高级质感与视觉冲击力。", "真实高速动物摄影。一只毛茸茸的橘白猫从旧木窗台猛然跃向空中，身体完全离开窗台，后腿充分伸展，两只前爪张开，试图捕捉一只飞入房间的蓝色蝴蝶。猫咪的绿色眼睛紧盯蝴蝶，耳朵竖起，胡须、腹部毛发和蓬松尾巴随着动作扬起，四肢与爪子结构自然准确。前景中的细小水滴和木屑凝固在空中，窗外可以看见雨后的绿色花园。背景自然虚化，低角度近距离抓拍，高速快门，真实毛发细节，既可爱又充满爆发力。"], "inputs": [{"shape": 7, "name": "optional_prompt_list", "link": 104, "label": "列表（可选）", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [393.1051940917969, 520.0097045898438], "pos": [820.6340942382812, 5675.28955078125], "id": 50, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptList"}, "order": 8}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [629.7286987304688, 458.3602294921875], "pos": [2833.768798828125, 5819.54443359375], "widgets_values": [], "inputs": [{"name": "images", "link": 162, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 74, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 25}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [629.7286987304688, 458.3602294921875], "pos": [2737.76416015625, 5297.51171875], "widgets_values": [], "inputs": [{"name": "images", "link": 130, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 63, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 24}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-919.2951761881509, 