e for S&R": "VAELoader"}, "order": 0}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [20], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [230, 70], "pos": [2411.031005859375, 1247.0455322265625], "inputs": [{"name": "samples", "link": 16, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 21, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 16, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 12}, {"mode": 0, "showAdvanced": false, "outputs": [{"name": "CLIP", "slot_index": 0, "links": [14], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [354.8293762207031, 106], "pos": [1004.7127685546875, 1351.455810546875], "widgets_values": ["qwen3.5_9b_bf16.safetensors", "moss_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "id": 17, "type": "CLIPLoader", "properties": {"cnr_id": "comfy-core", "models": [{"name": "qwen3.5_9b_w4a8_gptq.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MOSS-Image/resolve/main/text_encoders/qwen3.5_9b_w4a8_gptq.safetensors"}], "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 1}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [11], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [355.8299255371094, 88], "pos": [1696.6295166015625, 1417.9112548828125], "widgets_values": ["```text\n电影级末日惊悚写实风格近景半身特写，焦点锁定在一位约45岁东亚男性惊恐的脸庞与胸前高举的智能手机上。男子身形瘦削，颧骨与下颌线条因极度恐惧而紧绷，面部沾满厚重的灰土与几道干涸的细血痕，汗湿的黑色短发凌乱地贴在额头与鬓角。他的双眼圆睁，瞳孔紧缩，目光死死锁定在手机屏幕上，神情极度惊恐但专注。双手将黑色智能手机举至胸前，机身因手部剧烈颤抖而产生轻微的运动模糊，屏幕发出明亮的暖白补光，照亮他的下巴、鼻翼、嘴唇及手指关节，与周围冷暗环境形成强烈对比。\n\n背景是崩塌的现代都市天际线，摩天大楼断裂倾斜，钢筋裸露，硝烟与尘埃在斜射的冷青色天光中翻涌弥漫，空气充满厚重的颗粒感。画面左后方悬浮着一只巨大的生物机械蜘蛛机甲，多节金属肢体交错，中央一只红色发光单眼散发着刺眼光芒，红光穿透烟尘，将附近的废墟与尘埃染成血红色，与整体的冷青灰色调形成冲突。前景底部是虚化的惊慌人群剪影，他们或奔逃或跪地，轮廓模糊，增强画面的纵深与混乱感。\n\n采用35mm电影镜头拍摄，浅景深，焦点清晰落在男子面部与手机屏幕，背景机甲与前景人群均处于焦外虚化状态。照明为低照度环境光，主色调为冷青灰，手机屏幕的暖白光作为局部主光源，红色机甲光作为背景点缀光。画面具有Kodak Vision3胶片颗粒质感，高动态范围，细节丰富，色彩对比强烈，呈现出电影海报般的史诗感与紧迫感。\n```"], "inputs": [{"name": "clip", "link": 18, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 31, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 18, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 9}, {"mode": 0, "outputs": [{"name": "MODEL", "slot_index": 0, "links": [5], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [351.5550231933594, 82], "pos": [1004.35693359375, 1202.6575927734375], "widgets_values": ["moss_image_sft_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "UNET名称"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 7, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "models": [{"name": "moss_image_sft_int8_convrot.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/MOSS-Image/resolve/main/diffusion_models/moss_image_sft_int8_convrot.safetensors"}], "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 2}, {"mode": 0, "showAdvanced": true, "outputs": [{"name": "MODEL", "links": [10], "label": "MODEL", "type": "MODEL", "localized_name": "模型"}], "size": [343.361328125, 130], "pos": [1700.0338134765625, 1244.50732421875], "widgets_values": ["", "22", 0, 0.5], "inputs": [{"name": "model", "link": 9, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "double_layers"}, "name": "double_layers", "label": "double_layers", "type": "STRING", "localized_name": "double_layers"}, {"widget": {"name": "single_layers"}, "name": "single_layers", "label": "single_layers", "type": "STRING", "localized_name": "single_layers"}, {"widget": {"name": "start_percent"}, "name": "start_percent", "label": "start_percent", "type": "FLOAT", "localized_name": "start_percent"}, {"widget": {"name": "end_percent"}, "name": "end_percent", "label": "end_percent", "type": "FLOAT", "localized_name": "end_percent"}], "flags": {}, "id": 11, "type": "SkipLayerGuidanceDiTSimple", "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "SkipLayerGuidanceDiTSimple"}, "order": 10}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [919.15234375, 550.7767333984375], "pos": [2695.242919921875, 1245.9212646484375], "widgets_values": ["moss_image_t2i"], "inputs": [{"name": "images", "link": 20, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 20, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 13}, {"mode": 0, "showAdvanced": true, "outputs": [{"name": "width", "links": [7], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [8], "label": "height", "type": "INT", "localized_name": "height"}], "size": [527.5811767578125, 126], "pos": [1016.190185546875, 1644.1346435546875], "widgets_values": ["3:4 (Portrait Standard)", 2, 16], "inputs": [{"shape": 7, "name": "preview", "label": "preview", "type": "RESOLUTION_PREVIEW", "localized_name": "preview"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "id": 21, "type": "ResolutionSelector", "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 3}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [12], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [366.0063171386719, 88], "pos": [1692.0606689453125, 1544.8653564453125], "widgets_values": ["nsfw, worst quality, bad anatomy, watermark, jpeg artifact"], "inputs": [{"name": "clip", "link": 6, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 9, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 8}, {"outputs": [{"name": "STRING", "links": [31], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#332922", "widgets_values": ["```text\n竖版构成主义海报，比例约为 3:4，米白色纸张为底，全图只用红、黑、米白三色。视觉中心是画面中上部的主标题区，所有元素服从这一中心，不设第二个焦点。\n\n画面最上方是一块横向的黑色实心色块，占据画宽约九成，位置略偏右，左端距画面左缘约一成宽。色块内排两行白色无衬线大写字母：第一行是「MOSS IMAGE」，字号最大，字距收紧，几乎顶到色块的上下边缘；第二行是「文生图」，字号约为第一行的六成，左对齐，与上一行的第一个字母对齐，行距很窄。白色字是纸色透出的留白，不是印刷白墨，边缘带一点纸张纤维的毛口。\n\n左上角有一个深红色的数字「image」，字号仅次于主标题，斜置约八度，压在黑色色块的左上角外侧，一部分叠在色块边缘上。数字与字母是同一套无衬线字体，笔画粗，末端平切。它与主标题之间留出约两指的空隙，不接触。\n\n沿画面左边缘自上而下竖排三行小字：「文字渲染」「布局控制」「开源模型」。三行字号统一且很小，约为副标题的四分之一，行距均匀，整体从画面上部三分之一处开始，向下延伸到画面中部偏下。字是黑色，竖排，每行独立成列，列与列之间留出约半个字宽的间隙。三行不顶到画面上下边缘，上下各留出空白。\n\n画面底部偏左，有一行小号英文「MOSS-IMAGE / OPENMOSS」，黑色，横排，字号与左侧竖排小字相同，字距略拉开。它位于主标题色块下方较远处，靠近画面下缘但不贴边。\n\n底图元素分布在主标题之外的空白区域，密度低于标题区，不抢主标题。画面右侧中下部有一组红色几何构成：一个正圆、一条斜向的粗黑条、一个被黑条切断的红色矩形，三者互相叠压，边缘锐利，是构成主义的块面语言。圆的直径约占画宽的两成，位置偏右，与黑色斜条相交处保留硬边。画面下部中央偏左有一组细密的黑色横线，等距排列，形成一块约手掌大小的纹理区，横线在右端逐渐变短，收成一个斜口。画面右上角有一小段红色弧线，弧线两端渐细，像是从画面外切进来的一段圆。这些底图元素都用平涂色块与硬边，没有渐变，没有阴影。\n\n印刷套色错位是这张图的关键质感。红色版整体相对黑色版偏移约两毫米，方向朝右下：红色圆、红色矩形、红色弧线、左上角红色数字的边缘都露出一道错位的红边，红边只出现在元素的一侧，方向一致。黑色版本身不偏移，黑色字与黑色块面边缘干净。错位处的红与黑叠压成深褐，叠压区窄，是两条边之间的细带。\n\n纸张是粗糙的米白，表面有可见的纤维与细小凹凸，颜色不匀，局部偏暖、局部偏灰。纸面上散布细密的印刷颗粒，颗粒在黑色大面积色块内最明显，呈细小的白点与灰点。画面四角与边缘有轻微的磨损与折痕，右下角有一道斜向的浅折痕，折痕两侧的纸色略有差异。\n\n海报张贴痕迹分布在边缘：画面上缘偏右有一小片撕掉的胶带残迹，残迹边缘毛糙，带一点泛黄的胶痕；左下角有一处圆形的水渍印，边缘颜色比周围深一档，水渍内纸面略微起皱；画面右缘中部有一道竖向的旧折线，折线处纸色发白，说明这张海报被折过又展开。\n\n主光是从画面左上方来的均匀散射光，模拟平拍一张贴在墙上的纸。所有元素没有投影，只有纸张自身的细微起伏带来的明暗变化：折痕与水渍处略暗，纸面凸起处略亮。红色与黑色都是平涂，不受光影响产生渐变。\n\n色彩分配：米白占画面约六成，是底与留白；黑色占约三成，集中在主标题色块、左侧竖排字、底部英文与几何条块；红色占约一成，集中在左上角数字、右侧几何构成与右上弧线，是全图唯一的高饱和色，出现次数少而位置明确。\n\n成像为平面设计稿的翻拍质感，正面平视，无透视变形，边缘锐利，颗粒中等。文字必须清晰可读，主标题两行与左上角数字是最高优先级，左侧竖排三行小字与底部英文次之。画面不出现水印、二维码、签名或额外的装饰性飞尘。\n```"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Text (User Prompt)", "mode": 0, "bgcolor": "#593930", "size": [717.2222290039062, 384.8888854980469], "pos": [1015.8130493164062, 1839.67431640625], "id": 26, "properties": {"cnr_id": "comfy-core", "ver": "0.41.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 4}, {"mode": 0, "outputs": [{"name": "", "links": [6, 18], "type": "CLIP"}], "size": [75, 26], "pos": [1589.681030273437