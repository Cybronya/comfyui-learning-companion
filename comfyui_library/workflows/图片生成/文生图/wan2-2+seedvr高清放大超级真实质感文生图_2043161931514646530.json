: "STRING", "localized_name": "image_urls"}], "color": "#223", "widgets_values": [], "inputs": [{"name": "images", "link": 116, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#335", "size": [276.7729187011719, 485.2054138183594], "pos": [2516.78564453125, -61.73816680908203], "id": 80, "properties": {"cnr_id": "comfy-core", "ver": "0.3.51", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 29}, {"outputs": [{"name": "text", "links": [114], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#1b8230", "widgets_values": ["1个女孩，正面镜头，中近景，中心构图。视觉焦点集中在人物上半身与手部动作。情绪愉悦，嘴角微微上扬，露出浅浅笑意，嘴唇闭合，眼神柔和自然。深棕色长发扎成低马尾，发梢略显凌乱，几缕碎发随风拂过脸颊与肩头，增添灵动气息。她右手抬起，手掌轻遮额头，似在遮挡阳光，左手自然垂下握着一部银色边框智能手机，手腕佩戴一只淡青色玉镯，姿态轻松自然，身体略微侧转，肩部放松，整体呈现休闲随性的街头风格。女孩上身穿一件淡粉色冷调纯棉工装衬衫，宽松版型，胸前左右各有一个翻盖口袋，配有金属纽扣，袖口卷起至小臂中部，露出纤细手臂，衣摆塞入裙内；下装为同色系高腰A字牛仔短裙，前中线有双排金属纽扣装饰，裙摆边缘做轻微毛边处理，质感挺括，贴合腰部曲线。斜挎一只米白与黑色拼接帆布包，包身主体为米白色帆布材质，底部与提手连接处为黑色皮革，黑色宽肩带从左肩斜跨至右侧腰间，包体自然垂落于右胯位置。背景为户外石阶场景，左侧为灰褐色石材台阶，表面粗糙，纹理清晰，台阶边缘有轻微磨损痕迹；右侧为灰色砖墙，砖块排列整齐，缝隙填充水泥，墙面略显斑驳，具年代感；远处背景虚化，隐约可见绿植与建筑轮廓。自然日光从右上方斜射，光线明亮柔和，在人物面部与衣物上形成清晰高光与柔和阴影，衣物质感与皮肤光泽被充分凸显，整体氛围清新自然、充满青春活力，营造出夏日午后漫步街头的惬意情境。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#076e1c", "size": [400, 191.20533752441406], "pos": [-1266.6160888671875, -131.68585205078125], "id": 56, "properties": {"cnr_id": "comfyroll", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 9}, {"outputs": [{"name": "INT", "links": [105], "label": "整数", "type": "INT", "localized_name": "整数"}], "color": "#1470b7", "widgets_values": [1080], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": 