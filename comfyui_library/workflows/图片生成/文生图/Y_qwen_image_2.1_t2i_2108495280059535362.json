e": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "mode": 0, "bgcolor": "#353", "size": [300, 190], "pos": [298.404052734375, 3811.434814453125], "id": 498, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 5}, {"outputs": [{"name": "STRING", "links": [735], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["高质量照片，一位留长发的年轻中国女子身穿一件白色长袖男士有领衬衫，微微一笑，略微低头四分之三侧脸，视线向左，目光低垂，右手轻触头发，光线柔和自然，对比度高，中等特写，采用三分法构图，景深浅，背景模糊，衬衫上有细腻的纹理，头发略显凌乱，皮肤光滑，阴影柔和，无明显珠宝或配饰，可见女性面部与上半身，头发部分遮挡脸部，光源来自左前方，头部轻微倾斜，视线平视眼睛，写实风格，背景细节不明显，整体呈现柔和自然的美感，中等焦距，头发和肌肤质感真实，对焦略有柔和感，照片具有较高的审美价值，头发与手臂形成微妙的引导线，无数字特效，光线自然逼真，拍摄于室内环境。照片边缘以浅色勾勒边框，中间线条以点和线组成，上下四角缀着细小的桃花花瓣装饰线条。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Text (System Prompt)", "mode": 0, "bgcolor": "#353", "size": [421.3102722167969, 541.724365234375], "pos": [188.84510803222656, 3138.504150390625], "id": 503, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 6}, {"outputs": [], "color": "#232", "widgets_values": ["## Prompt Enhancer\n\nThe prompt enhancer rewrites your prompt with the Qwen 3.5 prompt enhancer model before the image model sees it. These settings follow the official prompt enhancer release, and the ones you are most likely to change are exposed on the node.\n\n- `refine_prompt`: on runs the rewrite and feeds it to the image model, off passes your prompt through as written. On gives the image model a fuller prompt and usually better results; off skips the rewrite pass and the run finishes faster. This template starts with it off.\n- `thinking_mode`: turn this on together with the enhancer. The checkpoint was trained with a reasoning block and loses quality without it.\n- `max_length`: the token budget for the reasoning block plus the rewritten prompt, 4096 here. The official setting is 16256; this template caps it lower so a single rewrite cannot run for many minutes.\n- `sampling_mode`: the sampling values live inside the subgraph. They follow the official ones: `temperature` 1.0, `top_p` 0.95, `top_k` 20, `min_p` 0, `presence_penalty` 1.5, `repetition_penalty` 1.0.\n\nThe enhancer checkpoint and its system prompt live inside the subgraph."], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: PE", "mode": 0, "bgcolor": "#353", "size": [420, 480], "pos": [567.5588989257812, 2497.591064453125], "id": 483, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [{"name": "images", "links": [775], "label": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#232", "widgets_values": ["%date:yyyy-MM-dd%\\Qwen_image_2.1", "png", "8-bit", "sRGB"], "inputs": [{"name": "images", "link": 727, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "format"}, {"widget": {"name": "format.bit_depth"}, "name": "format.bit_depth", "label": "format.bit_depth", "type": "COMBO", "localized_name": "bit_depth"}, {"widget": {"name": "format.input_color_space"}, "name": "format.input_color_space", "label": "format.input_color_space", "type": "COMBO", "localized_name": "input_color_space"}], "flags": {}, "type": "SaveImageAdvanced", "mode": 0, "bgcolor": "#353", "size": [210, 342], "pos": [2432.1884765625, 3561.887451171875], "id": 497, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImageAdvanced"}, "order": 13}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"n