"images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 30, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 24}, {"outputs": [{"name": "prompt_list", "label": "prompt_list", "type": "LIST", "localized_name": "prompt_list"}, {"shape": 6, "name": "prompt_strings", "links": [29], "label": "prompt_strings", "type": "STRING", "localized_name": "prompt_strings"}], "color": "#233", "widgets_values": ["苹果手机5s拍摄风格，画面主体是一个漂亮白皙很瘦的少女，少女有斜刘海长发有点卷，戴着酒红色发卡，她穿着长袖微微修身上衣，少女托腮，呈现慵懒感，45度仰拍视角，背景是夜晚暗简约室内。", "少女 网感 场景是在室内的一处休闲区域，背景是带有质朴质感的浅色墙面与木质护墙板，透着温馨舒适的氛围。人物穿着灰色带有卡通图案的卫衣，发型是将头发盘起，并用白色的发饰装饰。衣服颜色为灰色，搭配卡通元素，显得可爱又休闲。她呈坐姿，姿势是用手托腮，脸部露出笑意，显得俏皮又活泼。边上的物体有棕色的包包，包包上还挂着可爱的玩偶，以及桌上的饮品等。从画面来看是手机拍摄的，虽不清楚具体手机像素，但画面清晰，光线方面，是柔和的室内光线，营造出温暖、惬意的氛围，很好地衬托出人物的活泼状态与周围的温馨感。", "整体风格清新自然，细节如下：女生留着一头长发，发色以深棕为主，发丝在阳光照射下泛着浅棕光泽，显得蓬松柔和；头发侧边别着一个带有粉、白等色彩装饰的小巧发夹，增添了精致感；她穿着简约的深灰色上衣，妆容清淡，气质清新甜美。背景是户外的街道旁，能看到绿树、步道，还有模糊的行人身影，属于日常的城市/校园户外环境；画面的光线是明亮的自然光，阳光从侧方洒在发丝和面部，形成柔和的光影，让整体氛围更温暖治愈。画面氛围：自拍的视角加上自然的场景、柔和的光线，传递出轻松、日常的生活感，整体风格清新舒适。", "", ""], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "optional_prompt_list", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [400, 324], "pos": [988.5468139648438, 240.187744140625], "id": 27, "prope