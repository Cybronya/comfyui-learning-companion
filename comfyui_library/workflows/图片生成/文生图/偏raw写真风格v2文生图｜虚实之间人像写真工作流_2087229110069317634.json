缀着精致的褶边，胸前系有一根米白色丝带。她的颈部佩戴着一双层白色珍珠项链，耳垂上缀有一颗小巧的珍珠耳环。整套穿搭展现出优雅、古典而浪漫的维多利亚风格。"], "inputs": [{"name": "clip", "link": 275, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [456.7753601074219, 435.0620422363281], "pos": [384.0437927246094, 0], "id": 67, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 16}, {"outputs": [{"name": "image", "links": [430], "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#323", "widgets_values": [1.0000000000000002, 1.0000000000000002, 0.8000000000000002], "inputs": [{"name": "image", "link": 432, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "brightness"}, "name": "brightness", "label": "brightness", "type": "FLOAT", "localized_name": "brightness"}, {"widget": {"name": "contrast"}, "name": "contrast", "label": "contrast", "type": "FLOAT", "localized_name": "contrast"}, {"widget": {"name": "saturation"}, "name": "saturation", "label": "saturation", "type": "FLOAT", "localized_name": "saturation"}], "flags": {}, "type": "LayerColor: BrightnessContrastV2", "mode": 0, "bgcolor": "#535", "size": [265.3830871582031, 112.49766540527344], "pos": [0, 1474.976318359375], "id": 260, "properties": {"cnr_id": "comfyui_layerstyle", "ver": "d94bef1ee5ed3656f5ff1bb2830a4ffd94f40935", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"saturation": true, "brightness": true, "contrast": true}, "Node nam