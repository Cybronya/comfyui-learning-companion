，红、蓝、黄的撞色设计营造出一种活泼、梦幻且充满复古玩具质感的独特氛围。"], "inputs": [{"name": "clip", "link": 400, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 342, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "VAE", "links": [396], "type": "VAE", "localized_name": "VAE"}], "size": [284.0087890625, 58], "pos": [-2682.432373046875, -800.303466796875], "widgets_values": ["z_image_turbo-vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae名称", "type": "COMBO", "localized_name": "vae名称"}], "flags": {"collapsed": false}, "id": 344, "type": "VAELoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"vae_name": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader"}, "order": 3}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "ds": {"offset": [2286.1402945215427, 1420.990339993377], "scale": 0.6588450000000008}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "最强文生图-Z-image-turbo：默认流已经是最强", "bounding": [-2825.13720703125, -1270.8531494140625, 2497.1552734375, 852.5641479492188]}], "links": [[396, 344, 0, 340, 1, "VAE"], [397, 342, 0, 332, 0, "CONDITIONING"], [399, 340, 0, 328, 0, "IMAGE"], [400, 338, 0, 342, 0, "CLIP"], [401, 342, 0, 339, 1, "CONDITIONING"], [402, 332, 0, 339, 2, "CONDITIONING"], [404, 339, 0, 340, 0, "LATENT"], [406, 336, 0, 339, 0, "MODEL"], [407, 340, 0, 341, 0, "IMAGE"], [410, 346, 0, 339, 3, "LATENT"], [412,