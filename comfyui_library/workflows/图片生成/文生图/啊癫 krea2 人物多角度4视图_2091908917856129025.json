s": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 23}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [474], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [210, 46], "pos": [1053.046875, 6665.6669921875], "widgets_values": [], "inputs": [{"name": "samples", "link": 422, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 423, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 304, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.64", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "VAEDecode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 20}, {"outputs": [{"name": "prompt", "links": [417], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["你是「#Krea2角色四视图Prompt」模板。\n\n触发方式：用户输入 #Krea2角色四视图：{角色中文描述}（可附带风格/用途/必须出现/必须避免）。\n\n固定开头（强制）：输出必须以以下英文句子逐字开头，不得改动：\n\n\"Adopt a side-by-side split-screen composition of a character concept design sheet, with the frame strictly divided from left to right into exactly four independent panels and exactly four character depictions in total: the first panel is a refined close-up portrait of the character's face, the second panel is a front-view full-body standing pose, the third panel is exactly one single side-view full-body standing pose shown from only one side, and the fourth panel is a back-view full-body standing pose with the back clearly visible. Do not generate any additional character view, do not show both left-side and right-side profiles, and do not create a fifth figure.\"\n\n开头之后，紧接同一段落继续扩写，整段总长度不少于 500 个英文单词。禁止输出标题、解释、拆解、表格、代码块及任何中文——最终只输出这一整段英文 Prompt。\n\n内部工作流（不输出过程）：\n\n分析角色身份/体型/年龄/气质 → 服装与装备细节（四个视图必须保持同一套服装、同一配色、同一发型）→ 材质纹理 → 场景背景（建议纯色或浅灰摄影棚背景，不抢主体）→ 光线（均匀柔和棚拍光或按用户风格调整）→ 风格媒介（concept art character sheet / anime / realistic，按用户需求）→ 合并成一段流畅英文。\n\n扩写必须覆盖：\n\n四视图一致性：\nsame outfit, same hairstyle, same color palette, consistent proportions across all four panels\n\n脸部特写：\nfacial features、expression、skin/hair texture、eye detail\n\n站姿：\nneutral standing pose, arms relaxed, natural anatomy, full body visible head to toe\n\n服装细节：\n正/侧/背面各自的可见结构、褶皱、配饰、背部设计（back design clearly readable）\n\n侧视图限制：\nthe third panel must contain exactly one side-view figure only, shown from one side only; never show both left and right side views; never duplicate the side pose; no additional three-quarter side pose\n\n背景与构图：\nfour clearly separated panels, clean neutral background, character sheet layout; the first portrait panel may be wider, while the front, side and back full-body panels remain clearly separated and orderly\n\n风格与质量：\n按用户风格指定渲染方式 + 高清细节\n\n必带限制词：\n\nexactly four character depictions total, exactly four panels, one portrait only, one front-view figure only, one side-view figure only, one back-view figure only, no fifth figure, no extra pose, no duplicate side view, no second side view, no opposite side view, no three-quarter extra view, no text, no logo, no watermark, no labels, no distorted anatomy, no extra limbs, no inconsistent clothing between panels, no cropped feet or head, no clutter, no low-resolution artifacts。\n\n输出前自检：\n\n是否以固定开头句逐字开始？\n\n只有一段英文？\n\n≥500词？\n\n整张图片是否严格只有4个人物表现：\n\n1个脸部特写 + 1个正面全身 + 1个侧面全身 + 1个背面全身？\n\n侧面是否严格只有一个，而不是左侧面+右侧面？\n\n是否明确禁止第五个人物？\n\n四视图一致性和背面清晰度是否写明？\n\n可直接复制进 Krea 2？\n\n全部通过才输出。\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#335", "size": [360.3008117675781, 169.7090606689453], "pos": [-1339.396484375, 7343.796875], "id": 313, "properties": {"widget_ue_connectable": {}, "Node name f