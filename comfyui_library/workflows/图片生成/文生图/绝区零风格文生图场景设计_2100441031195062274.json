NING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#322", "widgets_values": [""], "inputs": [{"name": "clip", "link": 40, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 14, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Negative)", "mode": 0, "bgcolor": "#533", "size": [400, 120], "pos": [1030.0001220703125, 540.1187744140625], "id": 8, "properties": {"cnr_id": "comfy-core", "ver": "0.33.2", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 10}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [58], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [270, 262], "pos": [1522.728759765625, 135.3069305419922], "widgets_values": [296604756114293, "randomize", 8, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 63, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 61, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 62, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 59, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 38, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 11}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [142.376953125, 266], "pos": [2366.943603515625, -174.29930114746094], "widgets_values": [], "inputs": [{"name": "images", "link": 52, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 37, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 14}, {"outputs": [], "color": "#422", "widgets_values": ["Krea2 Game Scene Concept Art Workflow v1\n职位: AI场景美术师 / 场景概念图生成\n架构参考: Aaalice Workflow v1.5 潜空间放大\n\n=== 适用场景 ===\n1. 前期概念探索: 根据主美文字描述快速生成场景概念图、情绪板、光影氛围图\n2. 草图转精细: 上传线稿/白模(Blockout)，img2img模式生成精细渲染\n3. 风格化转换: 搭配LoRA实现特定游戏风格(魂系/原神/UE5/赛博朋克/奇幻)\n4. 概念定稿输出: 三段潜空间放大+超分 输出2K级概念图供评审\n\n=== 三段式潜空间放大管线 ===\nKSampler 1: 1024x576 (16:9), steps=8, denoise=1.0\n  -> 基础构图、大关系、整体氛围\n  -> LatentUpscaleBy1 (nearest-exact, 1.5x -> 1536x864)\nKSampler 2: steps=8, denoise=0.45\n  -> 建筑结构细化、材质层次\n  -> LatentUpscaleBy2 (nearest-exact, 1.5x -> 2304x1296)\nKSampler 3: steps=8, denoise=0.3\n  -> 微细节、光影抛光、氛围颗粒\n  -> VAEDecode -> 4x-UltraSharp超分 -> ImageScale(2048x1152) -> SaveImage\n\n=== 提示词模板结构 (七段式) ===\n1. 质量词 + 画师/风格参考 (top 3 lines)\n2. 场景类型 + 核心主体 (scene type)\n3. 建筑/结构细节 (architecture)\n4. 植被/道具/装饰 (vegetation & props)\n5. 光影系统 (lighting) - 最重要！\n6. 构图/镜头 (composition)\n7. 氛围/情绪 (atmosphere)\n8. 游戏风格 (game style reference)\n\n=== LoRA 搭配建议 ===\n使用 Power Lora Loader (rgthree) + LoRAManager:\n- Slot 1: 风格LoRA (风格主导, weight 0.6-0.8)\n  如: ghibli style, dark souls style, cyberpunk style\n- Slot 2: 场景LoRA (环境材质, weight 0.5-0.7)\n  如: fantasy environment, sci-fi corridor, ancient temple\n- Slot 3: 细节/材质LoRA (增强质感, weight 0.4-0.6)\n  如: PBR texture, realistic material, cinematic lighting\n\n=== img2img 模式 (草图/白模转渲染) ===\n1. 上传草图/白模到 LoadImage(21)\n2. 断开 EmptyLatentImage(9) -> KSampler1(10) 的latent连接\n3. 连接 VAEEncode(23) LATENT -> KSampler1(10) latent_image\n4. 设置 KSampler1 denoise:\n   - 线稿转场景: 0.7-0.8 (保留构图, 大量生成)\n   - 白模转渲染: 0.5-0.6 (保留结构, 材质光影)\n   - 风格迁移: 0.4-0.5 (保留内容, 换风格)\n\n=== 分辨率预设 (修改 EmptyLatentImage) ===\n- 宽幅概念图: 1024x576  (16:9, 基础尺寸)\n- 竖幅场景: 576x1024  (竖向深渊/高塔)\n- 正方形环境: 832x832  (室内/圆形场景)\n- 超宽屏: 1216x512    (21:9 电影感)\n注: 最终输出 = 基础 x 2.25 (两次1.5x潜放) + 4x超分后缩到2K\n\n=== 场景风格关键词库 ===\n奇幻: fantasy, elven, dwarven, ancient temple, magical forest, crystal cave\n科幻: sci-fi, cyberpunk, neon city, space station, alien planet, futuristic\n末日: post-apocalyptic, ruined city, overgrown ruins, wasteland, desert\n恐怖: horror, abandoned, dark dungeon, haunted, foggy graveyard, decrepit\n国风: chinese traditional, ancient china, pagoda, bamboo forest, misty mountain\n现代: modern city, urban street, downtown, skyscraper, rooftop view\n\n=== Krea2 参数说明 ===\n- steps=8 (turbo模型专用, 速度快)\n- CFG=1.0 (Krea2需要低CFG, 高了会过曝)\n- sampler=euler, scheduler=simple (Krea2官方推荐)\n- CLIPLoader type=krea2 (使用Qwen3-VL 12层特征)\n- 放大方式: 优先潜空间放大(质量更好), 最后一步用图像超分补细节\n\n=== 质量自检清单 ===\n[ ] 构图: 前景/中景/背景层次分明, 有视觉引导线\n[ ] 光影: 明确的主光源方向, 有明暗对比, 体积光/丁达尔\n[ ] 材质: 不同材质区分清晰(石头/木头/金属/水/植被)\n[ ] 细节: 近景有丰富纹理, 远景有空气透视\n[ ] 色彩: 主色调明确, 有对比色点缀, 整体色调统一\n[ ] 氛围: 情绪明确(神秘/壮观/温馨/压抑)\n[ ] 比例: 建筑/道具比例合理, 有参照尺度"], "inputs": [], "flags": {}, "type": "Note", "title": "Scene Concept Workflow Guide", "mode": 0, "bgcolor": "#633", "size": [370, 500], "pos": [18.830480575561523, 705.1461791992188], "id": 30, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 7}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [63], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 82], "pos": [498.6802978515625, 118.67061614990234], "widgets_values": ["zzzsence_c1-st6000.safe