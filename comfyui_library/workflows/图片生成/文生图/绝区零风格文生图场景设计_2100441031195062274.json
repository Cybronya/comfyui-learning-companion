, 0, 35, 0, "LATENT"], [59, 9, 0, 38, 3, "LATENT"], [61, 7, 0, 38, 1, "CONDITIONING"], [62, 8, 0, 38, 2, "CONDITIONING"], [63, 33, 0, 38, 0, "MODEL"]], "id": "9b3ac3e2-5ba7-4d9e-b4d1-3325ba11d646", "config": {}, "version": 0.4, "last_node_id": 38, "revision": 0}