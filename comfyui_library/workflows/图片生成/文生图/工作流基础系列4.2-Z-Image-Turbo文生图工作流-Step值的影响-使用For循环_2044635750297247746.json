mpt_list", "label": "prompt_list", "type": "LIST", "localized_name": "prompt_list"}, {"shape": 6, "name": "prompt_strings", "label": "prompt_strings", "type": "STRING", "localized_name": "prompt_strings"}], "color": "#233", "widgets_values": ["这是一位**15岁少女**，画面采用**半身近景**拍摄，人物自然站立在城市街道中，镜头平视正对少女，焦点清晰落在面部。\n少女有着干净稚嫩的脸庞，皮肤白皙细腻，带着少年人独有的清透质感；眉眼舒展柔和，眼神明亮清澈，正**对着镜头自然微笑**，嘴角轻扬，笑容纯真又阳光，没有刻意修饰，满是十五岁的鲜活与朝气；鼻梁小巧，唇形柔和，神情轻松自在，透着不加掩饰的青春活力。\n她穿着简约日常的浅色系短袖T恤，搭配宽松休闲长裤，整体穿搭清爽随性，贴合街头氛围，尽显少年的轻松随性。\n背景是生活化的城市街景，浅景深处理，模糊掉路边的建筑与行人，只保留柔和的街道光影，既保留街头氛围感，又不抢夺人物主体。光线为自然的室外柔光，均匀洒在面部，光影柔和自然，还原真实生动的街头状态。\n构图居中稳定，人物站姿舒展自然，画面清新、治愈、充满生活气息，完美捕捉到15岁少女最真实灵动的瞬间。", "", "", "", ""], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "optional_prompt_list", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [565.4545288085938, 554.4545288085938], "pos": [-529.4461669921875, 170.46441650390625], "id": 18, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptList"}, "order": 6}, {"mode": 0, "outputs": [{"name": "batch", "links": [30], "label": "batch", "type": "*", "localized_name": "batch"}], "size": [140, 46], "pos": [2664.65869140625, 253.45199584960938], "widgets_values": [], "inputs": [{"name": "any_1", "link": 41, "label": "any_1", "type": "*", "localized_name": "any_1"}, {"name