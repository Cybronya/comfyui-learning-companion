": true}, "Node name for S&R": "PrimitiveBoolean"}, "order": 6}, {"outputs": [{"name": "STRING", "links": [8, 11], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#322", "widgets_values": ["画面中是一位身着传统服饰的女性，她仰头闭眼，面容精致，妆容浓烈而富有戏剧性。她的唇色为鲜艳的红色，与脸颊上晕染开的粉红腮红形成鲜明对比，突显出一种古典与神秘交织的美感。发髻高耸，装饰着繁复的金饰和珍珠，其中点缀着红色与绿色的宝石，闪烁着微光。几缕卷曲的黑发从发髻边缘垂落，增添了几分柔美与灵动。她的肩部裸露，皮肤白皙，胸前绘有粉色玫瑰与飞鸟图案的彩绘，仿佛是身体上的艺术作品。一缕轻烟从她的口中缓缓飘出，缭绕在空气中，营造出梦幻般的氛围。光线主要来自上方偏左侧，柔和地照亮她的面部轮廓与颈部线条，同时在背景中留下深邃的阴影，增强了画面的层次感与立体感。构图上采用低角度拍摄，使人物显得更加高贵与神秘，整体色调以暗红、黑色为主，辅以金色与白色点缀，呈现出一种复古而华丽的视觉效果。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "提示词：", "mode": 0, "bgcolor": "#533", "size": [520, 360], "pos": [-1260.3199462890625, 1028.089599609375], "id": 8, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {"value": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 7}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [1, 2], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [450, 140], "pos": [-1225.0626220703125, -246.78515625], "widgets_values": ["Krea2-Asian-Aesthetics-FP8.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 1, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "krea2_turbo_fp8_scaled.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Krea-2/resolve/main/diffusion_models/krea2_turbo_fp8_scaled.safetensors"}], "ver": "0.25.0