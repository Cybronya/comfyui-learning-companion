petition_penalty", "type": "FLOAT", "localized_name": "repetition_penalty"}, {"widget": {"name": "sampling_mode.seed"}, "name": "sampling_mode.seed", "label": "sampling_mode.seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "sampling_mode.presence_penalty"}, "shape": 7, "name": "sampling_mode.presence_penalty", "label": "sampling_mode.presence_penalty", "type": "FLOAT", "localized_name": "presence_penalty"}, {"widget": {"name": "thinking"}, "shape": 7, "name": "thinking", "label": "thinking", "type": "BOOLEAN", "localized_name": "thinking"}, {"widget": {"name": "use_default_template"}, "shape": 7, "name": "use_default_template", "label": "use_default_template", "type": "BOOLEAN", "localized_name": "use_default_template"}, {"widget": {"name": "mtp"}, "shape": 7, "name": "mtp", "label": "mtp", "type": "COMBO", "localized_name": "mtp"}], "flags": {}, "id": 65, "type": "TextGenerate", "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "widget_ue_connectable": {"sampling_mode.top_p": true, "sampling_mode.presence_penalty": true, "mtp": true, "use_default_template": true, "sampling_mode.repetition_penalty": true, "thinking": true, "sampling_mode.temperature": true, "sampling_mode.seed": true, "sampling_mode.top_k": true, "prompt": true, "sampling_mode": true, "sampling_mode.min_p": true, "max_length": true}, "Node name for S&R": "TextGenerate"}, "order": 20}, {"mode": 0, "outputs": [{"name": "STRING", "links": [92], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [225, 121], "pos": [1188.825439453125, 1549.5372314453125], "widgets_values": ["", "", ""], "inputs": [{"widget": {"name": "string_a"}, "name": "string_a", "link": 93, "label": "string_a", "type": "STRING", "localized_name": "string_a"}, {"widget": {"name": "string_b"}, "name": "string_b", "link": 94, "label": "string_b", "type": "STRING", "localized_name": "string_b"}, {"widget": {"name": "delimiter"}, "name": "delimiter", "label": "delimiter", "type": "STRING",