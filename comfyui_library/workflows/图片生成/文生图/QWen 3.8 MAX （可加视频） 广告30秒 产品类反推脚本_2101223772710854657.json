mage_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [140, 266], "pos": [2142.975341796875, 783.2310180664062], "widgets_values": [], "inputs": [{"name": "images", "link": 3, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 5, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 2}, {"mode": 0, "outputs": [{"name": "STRING", "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [413.32965087890625, 338.9883728027344], "pos": [964.391845703125, 364.1568908691406], "widgets_values": [], "inputs": [{"name": "source", "link": 2, "label": "source", "type": "*", "localized_name": "源"}], "flags": {}, "id": 3, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 5}, {"outputs": [{"name": "response", "links": [1, 2], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "raw_response", "label": "raw_response", "type": "STRING", "localized_name": "raw_response"}], "color": "#432", "widgets_values": ["qwen/qwen3.8-max", "1 概述 \n产品展示+VO 类型  炫酷的感觉 视频广告提示词\n视频没有VO ，就不要写VO，务必有BGM的说明 ，整体节奏感强\n产品：小米 SU7 海湾蓝 · 30 秒电影级广告 · Seedance 2.5 生视频提示词\n\n2素材描述\n@车身@车尾：小米 SU7 海湾蓝（Aqua Blue）标准外观参考图，用于锁定车身颜色、四门轿跑低趴比例、蚌式引擎盖、水滴形矩阵大灯、贯穿式光环尾灯、五辐运动轮毂及车顶激光雷达等造型特征。\n@夜晚内饰，白天内饰@：海湾蓝 SU7 环抱式运动座舱内饰参考图，用于锁定科技大屏、运动方向盘 Boost 极速按键、金属换挡拨片与极简座舱线条。\n\n3一句话概述\n一部电影级汽车广告，30 秒，主角为海湾蓝小米 SU7 轿跑：以暗棚冷光剪影开场，经灯组与溜背曲线特写，驶出亮相并展示座舱，随后在夜霓虹、雨夜赛道至清晨高架的纯都市空间极速穿行，最后冲入白天海岸公路优雅急停甩尾、黑场收标「XIAOMI SU7」；暗调开场、霓虹与阳光收尾，高对比光影、浅景深、航拍与特写交替；画幅 16:9，分辨率 720p。\n\n4分镜内容\n0-6 秒｜暗棚冷光剪影\n正向描述：纯黑画面，一束冷白追光自暗处扫下，精准勾勒海湾蓝小米 SU7 的蚌式引擎盖与车顶激光雷达轮廓，车身在暗影中泛出深海潜流般的金属微光。低角度贴地镜头紧贴车头，沿车身中轴线缓缓环绕升起并向前推入，定格于宽体低趴的整车剪影。低频大提琴拉弓长音起，伴随一声清脆心跳重音。\nVO：「风，本无形。」\n反向描述：不要过曝光源、不要杂乱背景、不要镜头快速抖动、不要塑料质感漆面、不要其他品牌标识。\n\n6-12 秒｜灯组与车身曲线特写\n正向描述：水滴形矩阵大灯如星辰汇聚般逐一点亮，镜头快切至侧面极速横移跟踪，流光沿溜背 C 柱与五辐运动轮毂划过；切至车尾急推，贯穿式光环尾灯瞬间勾勒宽体低趴轿跑姿态，最后快速拉远定格尾灯，光影余晖拉长空间纵深。高科技晶体激活声、电驱蜂鸣低鸣渐强。\nVO：「直到……美学将它雕琢成型。」\n反向描述：不要字幕、不要水幕、不要大灯点亮延迟、不要轮毂细节模糊、不要车身线条变形、不要转场卡顿。\n\n12-18 秒｜整车亮相与座舱\n正向描述：暗棚出口冷光透入，海湾蓝 SU7 压低蚌式引擎盖疾驶而出，流线型四门轿跑整车姿态完全亮相；硬切至环抱式运动座舱内饰特写（无人物）：科技大屏亮起，运动方向盘上的 Boost 极速按键被按下，金属换挡拨片与极简座舱线条一览无余。外观与内饰为两个独立镜头，硬切切换，不做运镜衔接。电子重低音轰然炸裂、按键咔哒声回响。\nVO：「小米 SU7。极致风阻，为驾驶而生。」\n反向描述：不要车窗穿透畸变、不要内饰材质粗糙、不要画面色彩失真、不要出现其他品牌车型、不要出现任何人物（驾驶员/路人）。\n\n18-24 秒｜纯都市穿行：夜晚到白天的速度跃迁\n正向描述：海湾蓝 SU7 从夜晚城市高架驶入霓虹隧道，以极限速度穿梭于高楼之间，车身反光掠过蓝紫霓虹、湿润路面与玻璃幕墙（低角度跟拍，车头破风，灯带形成速度拖影）；猛切雨夜都市赛道，SU7 连续精准变道超车，尾灯拖出炽红光速残影，轮毂在积水路面溅起细密水雾（侧后追车急推，车身低趴稳定，侧倾干净利落）；切入挡风玻璃 POV，城市灯牌、路口、桥梁如光速后退，前景光线拉成蓝色电弧（POV 极速推进，路景纵深强烈）；车侧极速横移定格，水滴大灯与宽体溜背在霓虹雨幕中迸发冷蓝锋芒（车侧横移定格，光轨拉丝）；天色由深蓝夜逐渐过渡到清晨冷灰，SU7 穿过城市立交桥与滨海大道，阳光从高楼缝隙斜射下来（昼夜交接，冷暖光交织）。配乐以爆炸性提速切入——电机高频尖啸叠加密集电子鼓点，节奏疯狂加速，风声呼啸与电子交响乐推进。\nVO：「穿越夜色，奔向晨光。」\n反向描述：不要画面拉伸扭曲、不要车轮悬空或漂移轨迹不自然、不要环境贴图失真、不要镜头丢焦、不要快切眩晕、不要车速感不足、不要跑车姿态软绵、不要出现人物、不要从白天直接跳转到夜晚而无过渡、不要保留原海岸开场。\n\n24-30 秒｜白天海岸收标\n正向描述：海湾蓝 SU7 从都市滨海大道冲出，驶入白天海岸公路，远处海面明亮开阔，阳光映亮海湾蓝车漆与贯穿式尾灯。车辆在海岸尽头优雅急停甩尾，轮胎与地面产生轻微烟雾，流光贯穿尾灯在晨光中划出冷蓝弧线；镜头跟随车尾快速横甩定格，车身停稳后画面快速渐隐为黑场。黑场中浮现银色「XIAOMI SU7」车标。音乐戛然而止，空灵电驱余音与清脆 Logo 鸣音收尾。VO：「人车合一，极速，见未来。」\n反向描述：不要字幕闪烁跳变、不要水印、不要文字排版错位、不要 Logo 边缘模糊、不要黑场过渡缓慢、不要画面残留噪点、不要收标场景仍为纯夜晚、不要海岸氛围阴暗压抑。\n全局补充（结尾）\n\n5贯穿始终：\n电影级高对比光影、浅景深、4K 级清晰质感；暗棚（0-12s）→ 半开放出棚（12-18s）→ 夜间都市 / 雨夜（18-21s）→ 清晨立交（21-24s）→ 白天开阔海岸（24-30s）的完整时间演变，拒绝无逻辑昼夜跳切。海湾蓝（Aqua Blue）车漆在冷白追光、紫蓝霓虹与日光下金属质感统一；低趴四门轿跑比例、水滴大灯、贯穿尾灯、五辐轮毂及车顶激光雷达特征全程清晰一致，避免车身形变崩坏。\n整体声音：低频电子氛围与大提琴铺底开场，中段电驱蜂鸣、电子重低音、雨夜城市音效与电机高频尖啸交织，结尾转入清晨海岸开阔空气感，再以空灵电驱余音和 Logo 鸣音干净收尾。VO 为沉稳磁性男声内心独白\n全局禁止：禁止凭空出现人物 / 其他品牌车型 / 文字 / 标识 / 水印；禁止字幕闪烁、生硬跳变、车身形变崩坏、过度饱和与炫技运镜；禁止出现非小米 SU7 品牌信息。\n", "视频脚本反推 ，", 0.6, 131072, 1, 0, 0, "none", 1962556980, "randomize", false], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localize