puts": [{"shape": 6, "name": "text", "links": [949], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#223", "widgets_values": ["以配置的用户人物参考图作为画面中主要可见人物的面部身份依据；除与身份参考冲突的部分外，保留来源场景、服装、姿势、构图、光线和视觉风格。\n\n生成一张高细节、写实的生活方式人像摄影：成年女性放松地坐在奢华的深翡翠绿色天鹅绒沙发上，平静地阅读一本名为“comfyui 创享圈”的书。她留着深棕色长发，戴透明眼镜和精致银饰，穿深绿色上衣。一个芥末黄色纹理靠垫支撑着她的头部，舒适的灰色针织毯盖住下半身。背景中有装满彩色书籍的现代书架和一个可爱的白色毛绒玩具。采用纵向3:4构图，使人物、书、靠垫、毯子及背景细节都能辨认。使用温暖的环境光、自然的皮肤纹理、逼真的面部细节、柔和的电影感阴影、温馨的室内氛围、浅景深、清晰焦点和优雅构图。"], "inputs": [{"name": "text", "link": 804, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#335", "size": [316.8159484863281, 487.50927734375], "pos": [601.6978759765625, 1008.9502563476562], "id": 52, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "1.2.5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "aux_id": "pythongosssss/ComfyUI-Custom-Scripts", "Node name for S&R": "ShowText|pysssss"}, "order": 30}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "OPT_CONNECTION", "type": "*"}], "bgcolor": "#353", "size": [427.79998779296875, 394], "color": "#232", "pos": [-2416.4052734375, 1054.669677734375], "inputs": [], "flags": {}, "id": 92, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "showAllGraphs": true, "sort": "position", "matchTitle": "", "showNav": true, "toggleRestriction": "default"}, "order": 10}, {"outputs": [{"name": "LATENT", "slot_index": 0, "links": [941], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#223", "widgets_values": [1024, 720, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", 