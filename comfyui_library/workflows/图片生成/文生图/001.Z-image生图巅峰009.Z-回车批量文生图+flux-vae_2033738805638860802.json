tputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [750, 940], "pos": [-970, -370], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 21, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 20, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 13}, {"outputs": [{"name": "STRING", "slot_index": 0, "links": [57], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["写实漫画风格，兔子朱迪和狐狸尼克以夸张滑稽、搞笑、怪诞不经的造型，撕开报纸，从裂缝中探出头，脸上露出一副得意的笑的表情，一只手臂伸到镜头前比出V手势，如同登上报纸头条般引人注目，具有皮克斯漫画那种独特的风格。\n主体为一名女性，蓝紫色长发，发丝呈现出自然的蓬松与飘动感，面容精致，眼神神秘，姿态是食指竖于唇前做噤声手势，身着带有金属装饰、皮质与布料拼接的露脐装，手臂有黑色皮质护具、粉色装饰及纹身，腹部也有纹身；场景是昏暗的环境，光线聚焦于人物，营造出神秘氛围；风格是写真摄影，细腻还原人物的发丝、服饰、纹身及护具细节；镜头为特写，聚焦人物上半身及面部，运用侧光突出轮廓与质感，属于近景特写镜头；氛围神秘、冷艳、充满故事感；修饰词有精致、逼真、细腻、魅惑，借3D高精度建模渲染，发丝的纹理、服饰的材质、纹身的细节以及光影的层次，都丰富细腻真实，让人物尽显独特的个性与气场 。\n月夜屋顶，一只侠客装扮的橘猫，前爪握着迷你长剑摆出格挡姿势，警惕地盯着前方暗处的动静。琥珀色瞳孔锐利如鹰，耳朵微微竖起，口鼻周围绒毛因专注而绷紧，蓬松的橘色毛发带着深浅不一的纹路，头戴缩小版黑色帷帽，帽檐下露出几缕调皮的毛发，身披深色短披风，腰间系着精致的小腰带，体型圆胖却透着矫健，爪子上套着防护爪套，整体散发着沉稳又带点反差萌的侠客气场。特写镜头聚焦于橘猫上半身，平角度拍摄凸显真实感，浅景深虚化后方朦胧的瓦片与月光，静态构图中藏着蓄势待发的张力，猫咪占据画面中心，细节清晰可见。核心氛围：神秘、英勇又不失可爱。光影：月光从侧面洒下，在毛发上形成明暗交错的层次感，披风边缘有淡淡的光晕。色彩：橘色毛发为主调，搭配黑色服饰的沉稳，月光的银白色作为点缀。质感：毛发的柔软蓬松与皮革披风的细腻纹理对比鲜明，长剑的金属光泽真实可触。动态：虽静止却能感受到肌肉的紧绷和随时出击的爆发力，胡须微微颤动。艺术风格：超写实动物摄影，参考《穿靴子的猫》的侠客神韵。背景环境：古代中式屋顶，深夜，瓦片上覆盖着薄霜，远处有零星灯火，环境的静谧与猫咪的警惕形成呼应。8K分辨率，极致细节，超写实渲染，皮肤纹理清晰可见。避免：模糊、比例失调、卡通化、色彩失真、细节缺失。\nCG厚涂，3D建模，帅哥总裁，银灰色或头发，高冷不羁。 男主從電腦屏幕伸出手出來，他穿大尺寸衬衫燕麦白色。与我握手。我的手光洁小巧，无袖。第一视角，真人cosplay，角色扮演，奇幻，神秘，科幻，真實，立體，动作自然、真实摄影，细节刻画，高清画质，大师级，杰作。高分辨率。摄影后期处理。特写镜头。厚涂。暗调。明暗交替对比。冲击力十足的画面。精细，背景质感，超高清，高品质，高质量，画面清晰，先进光线捕捉技术，专业后期处理优化，真实细腻的皮肤质感，大师级影视级图像标准，真实渲染，真实光影。 自由发挥，写实风格,梦核风格,超写实风格,电影质感,光影艺术,摄影质感，高细节,高清晰,大笔触,有涂抹感和肌理感,色彩冷暖对比,强透视,非传统构图,高品质,超高清,笔触清晰,高饱和度,光影对比,最佳品质,流动感,繁复,画面光影明暗对比,高级感,梦幻,治愈,唯美,神秘,深邃,清冷,高雅,华丽,光影交错,光影斑斓,线条流畅,发丝细腻,柔焦,高质量,大师级光影,大俯视图,极端低角度腿部仰视视角,有故事感,线条纤细逼真,细节刻画细腻,肌肤纹理和毛孔清晰可见,3D渲染,精细,柔光,嘴上有高光,皮肤高光,意识流,画面发光,背景质感,先进光线捕捉技术,专业后期处理优化,超越游戏引擎的渲染精度,真实细腻的皮肤质感,大师级影视级图像标准,真实渲染,真实光影,情感捕捉,动态感,张力,纯欲,性感,高对比度，大远景，艺术氛围感强，有灵魂，有意境，有情感，大师杰作。\n超人像摄影，纯欲风，一位高挑高颜值美女，白色高领长袖针织短款包臀裙，白色细高跟长筒靴，冷白皮肤，皮肤白皙细腻，身材高挑完美，白色古驰包包挂在手臂上。看镜头，仰拍。写实风格，32k超高清画质，超高细节精度。"], "inputs": [{"widget": {"name": "string"}, "name": "string", "label": "string", "type": "STRING", "localized_name": "string"}], "flags": {"pinned": false}, "type": "String Literal", "title": "提示词 一段一张图，回车分隔", "mode": 0, "bgcolor": "#353", "size": [500, 940], "pos": [-2400, -370], "id": 55, "properties": {"cnr_id": "image-saver", "ver": "65e6903eff274a50f8b5cd768f0f96baf37baea1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {"string": true}, "Node name for S&R": "String Literal"}, "order": 2}, {"outputs": [{"name": "LATENT", "links": [7], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#232", "widgets_values": [1108930081315225, "randomize", 9, 1, "euler", "FlowMatchEulerDiscreteScheduler", 1], "inputs": [{"name": "model", "link": 1, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 3, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 5, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 6, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"