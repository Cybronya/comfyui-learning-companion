ctor", "label": "放大系数", "type": "FLOAT", "localized_name": "upscale_factor"}, {"name": "batch_size", "links": [13], "label": "批次大小", "type": "INT", "localized_name": "batch_size"}, {"name": "empty_latent", "label": "empty_latent", "type": "LATENT", "localized_name": "empty_latent"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [326, 278], "pos": [1083.7210693359375, 1544.62548828125], "widgets_values": [1024, 1024, "16:9 landscape 1344x768", "Off", 1, 1], "inputs": [], "flags": {}, "id": 8, "type": "CR SDXL Aspect Ratio", "properties": {"Node name for S&R": "CR SDXL Aspect Ratio"}, "order": 7}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [1], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [310, 262], "pos": [1951.954833984375, 1024.3619384765625], "widgets_values": [469837589725453, "randomize", 28, 1, "lcm", "simple", 1], "inputs": [{"name": "model", "link": 27, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "positive", "link": 6, "label": "正面条件", "type": "CONDITIONING", "localized_name": "正面条件"}, {"name": "negative", "link": 7, "label": "负面条件", "type": "CONDITIONING", "localized_name": "负面条件"}, {"name": "latent_image", "link": 8, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}], "flags": {}, "id": 6, "type": "KSampler", "properties": {"Node name for S&R": "KSampler"}, "order": 17}, {"mode": 0, "outputs": [{"name": "text", "links": [24], "label": "文本", "type": "STRING", "localized_name": "text"}], "size": [400, 340], "pos": [1058.0552978515625, 483.875], "widgets_values": ["chinese (simplified)", "english", false, "", "", "GoogleTranslator", "这是一部令人惊叹的杰作，捕捉到了一艘中世纪船只在遥远的月亮下令人难忘的空灵之美。当来自月球和周围大气的金色和深蓝色光芒在船高耸的黑色风帆上闪闪发光时，这一场景散发出神秘、危险和宏伟的气氛。它下面的黑暗水域反射出月亮的怪异光芒，创造出黑暗和炽热色调的迷人相互作用。这艘船是一个巨大的纯木结构，船体上画着古代的符文。在明亮的月光下，船体清晰地反射出来。额外的深色阴影和对比唤起了一种迫在眉睫的危险感，阴影在水面上延伸得又长又深。光的使用产生了一种空灵的效果，使这艘船看起来既植根于现实，又超凡脱俗，仿佛被困在凡人世界和幽灵飞机之间。向上卷向月亮的烟雾似乎与云层本身融为一体，为构图增添了梦幻般的质感。月亮很小，渐渐消失，闪闪发光，占据了背景，在整个场景中投下了淡淡的光芒。它的冷光和燃烧的船的温暖炽热的光芒并置，在一个令人惊叹的时刻象征着生命和毁灭。平静的水面，带着火光和月光的微光，暗示着暴风雨前的可怕平静。这艘船虽然在燃烧，但仍然保持着它的结构，高高举起船帆，体现了古代航海家的韧性。这幅图像讲述了冒险、厄运和人类努力的崇高本质，与深不可测的自然力量作斗争。在这个精湛的幻想中，生动的色彩、强烈的阴影和柔和发光的亮点交织在一起，唤起了一种传奇感——就像一个世代相传的故事，一艘永远迷失在海上的鬼船。整个场景充满了永恒，仿佛这是一个冻结在神话中的时刻。", "proxy_hide", "authorization_hide"], "inputs": [], "flags": {}, "id": 22, "type": "DeepTranslatorTextNode", "properties": {"Node name for S&R": "DeepTranslatorTextNode"}, "order": 8}], "extra": {"ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-1005.2718505859375, -459.11688232421875], "scale": 1.771561000000001}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 1, "title": "文生图", "bounding": [1011.95556640625, 857.2637939453125, 1939.3028564453125, 1111.375244140625]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 3, "title": "反推提示词", "bounding": [1525.5418701171875, 400.9090270996094, 1426.6827392578125, 441.5]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 4, "title": "手动提示词", "bounding": [1008.5562744140625, 404.6788635253906, 501.8999938964844, 434.1999816894531]}], "links": [[1, 6, 0, 1, 0, "LATENT"], [2, 4, 0, 1, 1, "VAE"], [3, 1, 0, 2, 0, "IMAGE"], [6, 16, 0, 6, 1, "CONDITIONING"], [7, 15, 0, 6, 2, "CONDITIONING"], [8, 13, 0, 6, 3, "LATENT"], [11, 8, 0, 13, 0, "INT"], [12, 8, 1, 13, 1, "INT"], [13, 8, 3, 13, 2, "INT"], [16, 19, 0, 15, 0, "CLIP"], [17, 19, 0, 16, 0, "CLIP"], [18, 14, 0, 16, 1, "STRING"], [24, 22, 0, 14, 0, "STRING"], [27, 3, 0, 6, 0, "MODEL"], [29, 30, 0, 29, 0, "JoyTwoPipeline"], [30, 28, 0, 29, 1, "IMAGE"], [31, 12, 0, 28, 0, "IMAGE"], [32, 29, 0, 11, 0, "STRING"], [33, 29, 0, 14, 1, "STRING"], [35, 20, 0, 3, 0, "MODEL"]], "id": "166bfc36-f3fa-4f58-8dd5-afeb52de0cb7", "config": {}, "version": 0.4, "last_node_id": 33, "revision": 0}