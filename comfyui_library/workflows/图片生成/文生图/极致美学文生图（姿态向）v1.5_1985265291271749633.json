, {"widget": {"name": "denoise"}, "name": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {"pinned": true}, "id": 5, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 19}, {"mode": 0, "outputs": [], "size": [986.7517700195312, 1681.6414794921875], "pos": [1104.0396728515625, -54.898014068603516], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 22, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {"pinned": true}, "id": 19, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 21}, {"mode": 0, "outputs": [{"name": "text", "links": [18], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [510.4764404296875, 108], "pos": [537.0269775390625, 522.6442260742188], "widgets_values": ["9"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true, "collapsed": false}, "id": 17, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["输入出图张数"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [140, 60], "pos": [585.4269409179688, 425.4903869628906], "id": 36, "properties": {}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["输入简单提示词即可"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [140, 60], "pos": [550.1592407226562, 982.24560546875], "id": 37, "properties": {}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-247.86230425692753, 53.4400872487908], "scale": 1.1671841070