me": "index"}, "name": "index", "link": 312, "type": "INT", "localized_name": "索引"}], "flags": {"collapsed": false}, "id": 203, "type": "InversionDemoLazyIndexSwitch", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "InversionDemoLazyIndexSwitch"}, "order": 38}, {"outputs": [{"name": "text", "links": [316], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["反推这张图片，生成对应提示词，不要有任何解释性废话\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": true}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [311.4729309082031, 108], "pos": [-2039.2618408203125, 577.1119995117188], "id": 209, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 15}, {"mode": 0, "outputs": [{"name": "text", "links": [315, 324], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [402.4673156738281, 623.0599975585938], "pos": [-2042.1212158203125, 644.8378295898438], "widgets_values": ["# FLUX prompt 助理\n\n你来充当一位有艺术气息的FLUX prompt 助理。\n\n## 任务\n\n我用自然语言告诉你要生成的prompt的主题，你的任务是根据这个主题想象一幅完整的画面，然后生成详细的prompt，包含具体的描述、场景、情感和风格等元素，让FLUX可以生成高质量的图像。\n\n## 背景介绍\n\nFLUX是一款利用深度学习的文生图模型，支持通过使用 自然语言 prompt 来产生新的图像，描述要包含或省略的元素。\n\n## Prompt 格式要求\n\n下面我将说明 prompt 的生成步骤，这里的 prompt 可用于描述人物、风景、物体或抽象数字艺术图画。你可以根据需要添加合理的、但不少于5处的画面细节。\n\n**示例：**\n\n- **输入主题**：一条龙翱翔于山脉之上。\n  - **生成提示词**：一条雄伟的翡翠鳞巨龙舒展双翼，琥珀色的眼眸熠熠生辉，在令人屏息的雪峰群峦间翱翔。其威仪身形主宰着整幅画面，在巍峨山巅投下修长的阴影。下方飞瀑奔涌直坠幽谷，水雾折射阳光幻化出绚烂虹彩。龙鳞流转着变幻的虹光，与周遭自然胜景交相辉映。碧空如洗点缀蓬松云絮，营造出震撼心灵的奇绝意境。这幅充满动感的壮美画卷，同时展现了巨龙与山脉的磅礴气韵。\n\n- **输入主题**：解释泡一杯茶的过程。\n  - **生成提示词**：一份详细的信息图，逐步展示泡制一杯茶的过程。该信息图需具备视觉吸引力，配以清晰的插图和简洁的文字。内容应从装满水的水壶开始，到一杯热气腾腾的茶结束，重点突出烧水、挑选茶叶、冲泡茶叶以及享用成品的步骤。设计上应兼具知识性和趣味性，采用与茶主题相衬的配色方案。文字需清晰易读且信息丰富，简明扼要地解释每个步骤。\n\n**指导**：\n\n1. **描述细节**：尽量提供具体的细节，如颜色、形状、位置等。\n2. **情感和氛围**：描述场景的情感和氛围，如温暖、神秘、宁静等。\n3. **风格和背景**：说明场景的风格和背景，如卡通风格、未来主义、复古等。\n\n### 3. 限制：\n- 我给你的主题可能是用中文描述，你给出的prompt只用中文。\n- 不要解释你的prompt，直接输出prompt。\n- 不要输出其他任何非prompt字符，只输出prompt，也不要包含 **生成提示词**： 等类似的字符。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": true}, "id": 210, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 16}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [1105.6407470703125, 869.6016845703125], "pos": [192.06729125976562, 1142.4654541015625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 318, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 217, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 54}, {"mode": 0, "outputs": [{"name": "*", "links": [326], "type": "*", "localized_name": "*"}], "size": [270, 238], "pos": [-1627.7427978515625, 464.511962890625], "widgets_values": [0], "inputs": [{"name": "value0", "link": 319, "label": "值_0", "type": "*", "localized_name": "value0"}, {"shape": 7, "name": "value1", "link": 320, "label": "值_1", "type": "*", "localized_name": "value1"}, {"shape": 7, "name": "value2", "link": 321, "label": "值_2", "type": "*", "localized_name": "value2"}, {"shape": 7, "name": "value3", "link": 322, "label": "值_3", "type": "*", "localized_name": "value3"}, {"shape": 7, "name": "value4", "label": "值_4", "type": "*", "localized_name": "value4"}, {"shape": 7, "name": "value5", "label": "值_5", "type": "*", "localized_name": "value5"}, {"shape": 7, "name": "value6", "label": "值_6", "ty