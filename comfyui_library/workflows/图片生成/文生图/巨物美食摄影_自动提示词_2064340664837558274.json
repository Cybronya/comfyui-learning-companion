alized_name": "text"}], "flags": {"collapsed": false}, "type": "CR Text", "title": "💾 保存文件名前缀（可修改）", "mode": 0, "bgcolor": "#6c6088", "size": [234.09091186523438, 108], "pos": [1396.60009765625, 604.4700927734375], "id": 3, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}, {"mode": 0, "outputs": [{"name": "response", "links": [3], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "raw_response", "label": "raw_response", "type": "STRING", "localized_name": "raw_response"}], "size": [454.1318359375, 592.692626953125], "pos": [913.0390014648438, 291.6299743652344], "widgets_values": ["https://api.deepseek.com", "sk-191496b2d64f40e0a15b25b542098086", "deepseek-v4-pro", "你是一个创意美食摄影专家，擅长为「巨物美食」系列撰写中文提示词。风格要求：将巨型食物表现为工业工地、建筑现场或探险场景，微型工人在食物表面进行施工、运输或探索，突出材质纹理、蒸汽、刀痕、油亮光泽等细节，微距电影感，光影真实。请根据用户提供的食物名称，生成一段50~100字的详细画面描述。示例：\\n- 烤鸭：一只巨大北京烤鸭被表现成大型施工现场，微型工人沿烤鸭表皮搭脚手架、刷酱、切片、运输配料；油亮焦糖色表皮、蒸汽、刀痕和肉质纹理清晰，微距景深。\\n- 面条：一碗巨大的手工面被构造成桥梁与高架工程，微型工人在面条上牵引、加固、运输，汤汁如河流，葱花和辣油像环境地貌。\\n- 饺子：一只巨大生饺子当作工业装配线，穿防护服的微型工人用机械灌馅、封边、压褶，周围竹蒸笼形成山脉，面皮与馅料纹理真实。\\n- 火锅：微型探险队在翻滚的麻辣火锅中航行，莲藕片做木筏，潜水员观察巨大花椒与辣椒，红油反光，蒸汽热浪营造危险感。\\n请直接输出描述，不要额外解释。", "", 0.8, 1, 1024, 0, 0, "", 6790154010, "randomize"], "inputs": [{"widget": {"name": "api_url"}, "name": "api_url", "label": "api_url", "type": "STRING", "localized_name": "api_url"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "user_prompt"}, "name": "user_prompt", "link": 4, "label": "user_prompt", "type": "STRING", "localized_name": "user_prompt"}, {"widget": {"name": "temperature"}, "shape": 7, "name": "temperature", "label": "temperature", "type": "FLOAT", "localize