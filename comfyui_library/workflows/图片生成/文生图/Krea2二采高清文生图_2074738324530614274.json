7.650390625, 523.3973999023438], "id": 268, "properties": {"ver": "8ff50e4521881eca1fe26aec9615fc9362474931", "randomMin": 0, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "aux_id": "rgthree/rgthree-comfy", "randomMax": 1125899906842624}, "order": 8}, {"outputs": [], "color": "#432", "widgets_values": ["焚诀：拥有明显丰满的大胸身材，胸型圆润饱满、上围突出但自然，纤细腰身与修长双腿形成强烈曲线对比，\n\n关键提示词：胸部轮廓饱满立体且通过穿搭自然展现​，\n\n增加身材效果的提示词：增加图中人物极具张力的身体曲线​\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [537.9826049804688, 128.42108154296875], "pos": [2331.2158203125, -612.2608642578125], "id": 375, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#432", "widgets_values": [], "inputs": [{"name": "images", "link": 368, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#653", "size": [742.740234375, 1119.328857421875], "pos": [5451.30126953125, -295.8643798828125], "id": 355, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 28}, {"outputs": [{"name": "CONDITIONING", "links": [293, 305, 385], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["画面风格：清新时尚人像摄影风格，采用高清晰度与高分辨率呈现，色彩明亮自然，光影过渡柔和细腻，整体氛围浪漫甜美且具有生活气息，呈现出都市街头的时尚美感。\n核心元素：年轻的东亚女性角色，站在鲜花店铺门前，身着米色底红色玫瑰印花连衣裙，手提编织小包，背景为充满鲜花的街边花店，红色门框与粉色花朵形成鲜明色彩对比，人物位于画面中心偏右位置，构图采用三分法与视觉引导线结合，前景为人物与花包，中景为花束陈列，远景为花店门面招牌，增强空间纵深感。\n具体内容：女性角色拥有明显丰满的大胸身材，胸型圆润饱满、上围突出但自然，纤细腰身与修长双腿形成强烈曲线对比，拥有深棕色长卷发，自然披散在肩部，面部五官精致立体，皮肤白皙光滑，眼神温柔含笑注视镜头，嘴唇微启呈浅粉色微笑，表情自然放松且充满亲和力。她双手轻握一个米白色编织小包，包身带有金色链条肩带，姿态优雅且富有动态感。服装为米色底大红色玫瑰印花V领连衣裙，裙摆自然垂坠，面料质感轻盈飘逸，肩部有荷叶边装饰，胸前有系带设计。周围摆放着大量鲜花花束，包括粉色玫瑰、白色绣球花等，花束用透明包装纸包裹，插在白色和黑色花盆中。背景花店拥有红色木质门框，上方悬挂黑底金字招牌，写着繁体汉字\"花坊\"，店内陈列着更多花卉和装饰物。街道地面为灰色石板铺设，整体环境充满生活气息。\n构图方式：采用三分法构图，人物位于右侧三分之一处，视线方向留有适当空间。前景编织包与人物面部形成视觉焦点，中景花束引导视线向远景延伸，形成自然的视觉动线。相机参数设定为全画幅传感器，使用50mm标准镜头，光圈f/2.0，快门速度1/250秒，ISO 200，白平衡自动，对焦模式为单点对焦，确保人物面部与服装细节清晰锐利。光线来自正面偏左，形成柔和的漫射光效果，人物面部光照均匀，阴影过渡自然，无明显硬边。整体色彩基调以米色、红色、粉色为主，辅以绿色植物点缀，营造出温馨浪漫的春日街头氛围。\n\n"], "inputs": [{"name": "clip", "link": 389, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [530.17724609375, 395.6944885253906], "pos": [2349.196044921875, -303.0393981933594], "id": 264, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 13}, {"mode": 0, "outputs": [{"shape": 3, "name": "image_urls", "label": "image_urls", "dir": 4, "type": "STRING"}, {"shape": 3, "name": "images", "dir": 4, "type": "IMAGE"}], "size": [734.6184692382812, 1112.875244140625], "pos": [6241.09326171875, -293.2346496582031], "widgets_values": [[{"name": "A", "selected": true, "url": "/view?filename=rgthree.compare._temp_keiom_00001_aboig_1783496381.jpg&type=temp&subfolder=&rand=0.5306583995449649&Rh-Comfy-Auth=eyJ1c2VySWQiOiJhZTVmYmMwMTUxMTA3MWI2NWY3MWFjZGNmNDRiMDc0MiIsInNpZ25FeHBpcmUiOjE3ODQxMDA1MTQ2NjUsInRzIjoxNzgzNDk1NzE0NjY1LCJzaWduIjoiMDBkMjJiMWM4Njg5ZDBiZjdlZDA3ZjExOWI1NGQ3MTYifQ==&Rh-Identify=ae5fbc01511071b65f71acdcf44b0742"}, {"name": "B", "selected": true, "url": "/view?filename=rgthree.compare._temp_keiom_00002_tpxnr_1783496383.jpg&type=temp&subfolder=&rand=0.7591204555820984&Rh-Comfy-Auth=eyJ1c2VySWQiOiJhZTVmYmMwMTUxMTA3MWI2NWY3MWFjZGNmNDRiMDc0MiIsInNpZ25FeHBpcmUiOjE3ODQxMDA1MTQ