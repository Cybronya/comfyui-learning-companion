81.86019897460938], "pos": [-72.48745727539062, -608.3571166992188], "widgets_values": ["绘本类型：心智解读（心智解读类 画风：以面部特写为主，放大眼神、嘴型等细节，帮助孤独症儿童直观识别开心、生气等情绪；用气泡图呈现人物内心想法（文字或简单图像形式），助力他们理解他人心理活动与场景关系。 构图：采用左右分栏的对比构图，左图展示人物情绪表情，右图呈现对应场景原因，搭建 “表情 - 事件” 的因果关联；场景需简化处理，剔除无关元素，仅保留核心内容，避免干扰注意力，聚焦情绪与事件的核心逻辑。 色彩：建立固定情绪 - 色系关联（如红色对应愤怒、蓝色对应悲伤、黄色对应开心），帮助快速识别情绪；对比构图中用色块分区，表情区与场景区采用对应情绪色系，强化关联的同时划分画面边界，烘托情绪氛围。\n构图：采用单场景顺序叙事构图（非左右分栏）；画面中央偏右为乐乐（短发、穿天蓝色上衣，小男孩形象，保持不变）；乐乐在厨房端了一杯水，画面左侧为简化的厨房操作区，浅木色操作台上放着一个水壶，乐乐正用双手稳稳的拿着装满水的水杯，背景为简化的浅色厨房环境，仅保留水壶、操作台和浅色墙面，避免视觉干扰。\n色彩：整体为暖色调插画风格；安静、体贴的行为以柔和黄色与浅蓝色为主；天蓝色上衣、透明水杯、浅木色台面、浅米色或浅灰色墙面，色彩柔和统一。\n文字：文字内容为 “乐乐轻轻走到厨房，倒了一杯温水。”黑色、文字清晰可读没有错误。 除指定文字外，不得添加任何额外文字，严禁出现 “Lora” 及其他无关字样。字体清晰圆润"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 140, "type": "Text Multiline", "properties": {"cnr_id": "pr-was-node-suite-comfyui-47064894", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 4}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "groupNodes": {}, "ds": {"offset": [199.55117928749303, 1031.7457024503458], "scale": 0.8769226950000005}}, "groups": [], "links": [[240, 95, 0, 98, 0, "LATENT"], [241, 94, 0, 98, 1, "VAE"], [267, 126, 0, 95, 0, "MODEL"], [269, 128, 0, 95, 2, "CONDITIONING"], [270, 100, 0, 128, 0, "CONDITIONING"], [272, 98, 0, 130, 0, "IMAGE"], [277, 100, 0, 95, 1, "CONDITIONING"], [285, 134, 0, 126, 0, "MODEL"], [288, 137, 0, 95, 3, "LATENT"], [301, 94, 0, 150, 2, "VAE"], [310, 100, 0, 150, 0, "CONDITIONING"], [411, 153, 0, 150, 1, "MODEL"], [2772, 140, 0, 100, 1, "STRING"], [2801, 153, 0, 134, 0, "MODEL"], [2818, 96, 0, 100, 0, "CLIP"]], "id": "959cc08e-f34e-4dee-b3d8-2844b4b4c088", "config": {}, "version": 0.4, "last_nod