": "COMBO"}], "color": "#233", "widgets_values": ["未来感亚洲少女，短发荧光蓝，机械耳麦，雨中破旧巷口，霓虹反光，一手高举白色LED牌子「Z-Image开源」，赛博朋克色调，高对比紫青补光，35 mm镜头，胶片颗粒\n90年代香港街头，[棕调肤色]男演员，花衬衫大背头，柔焦滤镜，霓虹灯牌倒映雨迹，双手举手写纸板「Z-Image开源」，暖黄钨丝灯，柯达200胶片质感\n清冷水墨风，[淡颜系]女侠，白衣金绣，竹林薄雾，手持宣纸木牌「Z-Image开源」，留白构图，淡彩晕染，工笔描线，顶部柔光\n蒸汽波泳池场景，[拉美肤色]阳光少年，90s运动墨镜，VHS噪点+错位扫描线，水面反光，单手举塑料冲浪板写「Z-Image开源」，粉紫青渐变天空\n巴洛克宫廷贵妇，[白瓷肤色]，鎏金束腰长裙，烛光暗调，伦勃朗光，双手托古木牌「Z-Image开源」，厚涂笔触，深棕背景\n超写实摄影，[深肤色]黑人模特，脏辫，纯白无影棚，环形闪光灯，高分辨率毛孔可见，一手举亚克力板「Z-Image开源」，黑白极简\n日系青春动画，JK制服少女，樱花飘飞，校园屋顶逆光，大眼睛高光，双手举硬纸板「Z-Image开源」，柔和粉调，赛璐璐阴影\n废土世界，[小麦肤色]女战士，金属义肢，沙尘暴背景，冷暖对撞，一手举锈蚀铁牌「Z-Image开源」，颗粒感胶片，橙青色调\n波普拼贴风，[多彩肤色]男歌手，夸张漫画描边，红黄蓝高饱和，重复丝网印刷噪点，手持漫画气泡牌「Z-Image开源」，安迪·沃霍尔式构图\n暗黑哥特萝莉，[苍白肤色]，黑红撞色裙装，废弃教堂彩窗，顶光+尘埃体积光，单手举铁艺牌「Z-Image开源」，暗红玫瑰点缀", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "最大行数"}], "flags": {}, "type": "easy promptLine", "title": "参考 可以用豆包写", "mode": 4, "bgcolor": "#355", "size": [400, 200], "pos": [53.54201889038086, -140.6773681640625], "id": 15, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptLine"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [730.9371765922464, 421.2887731642374], "scale": 0.4950000000000003}}, "groups": [], "links": [[2, 2, 0, 5, 0, "CLIP"], [3, 5, 0, 4, 1, "CONDITIONING"], [4, 5, 0, 6, 0, "CONDITIONING"], [5, 6, 0, 4, 2, "CONDITIONING"], [6, 7, 0, 4, 3, "LATENT"], [7, 4, 0, 8, 0, "LATENT"], [8, 3, 0, 8, 1, "VAE"], [10, 8, 0, 10, 0, "IMAGE"], [13, 1, 0, 4, 0, "MODEL"], [17, 16, 0, 5, 1, "STRING"]], "id": "07fd3352-11ca-4df8-bebb-45432c155e4d", "config": {}, "version": 0.4, "last_node_id": 16, "revision": 0}