ice"}, "shape": 7, "name": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "id": 7, "type": "CLIPLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 2}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [66], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [1645.02490234375, 5387.19287109375], "widgets_values": [1024, 1536, 2], "inputs": [{"widget": {"name": "width"}, "name": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {}, "id": 8, "type": "EmptyLatentImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [688.3123168945312, 484.6934814453125], "pos": [2810.7412109375, 4923.03466796875], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 68, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 33, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 8}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [13, 64], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [402.44207763671875, 266.750244140625], "pos": [1576.86474609375, 5024.728515625], "widgets_values": ["相机：佳能EOS R6，RF 85mm f/1.2L USM，f/2.0，ISO 100，1/500s，傍晚侧逆光，-0.3EV，佳能人像模式，轻度修肤。\n\n光线：傍晚黄金时刻侧逆光，阳光从左上方射入，发丝边缘金色轮廓光明显，面部受柔和漫反射光照明，明暗对比强烈有层次感。\n\n色调：暖金调为主，肤色蜜桃粉白带暖感（佳能人像柔润调），牛仔蓝与银灰车身形成冷色对比，背景深绿树木偏暗，整体高级氛围感强。\n\n背景：户外停车场景，右侧为银灰色小米SU7轿车尾部（可见XIAOMI字母标识与红色贯穿式尾灯），后方为茂密深绿色树木形成虚化背景，天空微亮呈淡青白色。\n\n主体性别：女，眼神直视镜头带冷艳自信感，唇色正红水润饱满微抿，表情清冷疏离中带一丝妩媚张扬的气场。\n\n姿势：正面全身站立，右臂高举弯曲手掌搭于头顶上方手腕交叠，左手搭于车尾翼子板/尾箱盖边缘，身体微微向左侧轻侧，头部正直面向镜头，呈现时尚大片的经典pose。\n\n构图：竖向全身构图，人物居中偏左，小米SU7车尾占据画面右下形成工业风背景框架，左侧树木提供自然层次，视觉重心在面容、红唇与牛仔穿搭上。\n\n发型：黑色长卷发（纯黑），无刘海中分，头顶蓬松饱满颅顶高度适中，大量发丝自然垂落于脸颊前方遮住部分耳际越过肩膀垂落至胸前甚至超过锁骨位置，发尾大波浪卷曲蓬松自然弧度优美，发质乌黑如墨顺滑有光泽如绸缎质感，逆光下发丝呈金色透明光晕，整体法式慵懒风带有成熟女性的随性高级感。\n\n皮肤质感：肤色蜜桃白皙透亮带暖调，肤质极度细腻光滑经专业后期精修几乎无毛孔无瑕疵，双颊粉色腮红从颧骨向下方晕染面积适中，眼下卧蚕提亮增强立体度，鼻梁挺直精致，面部轮廓流畅下颌线清晰锐利呈精致小V脸，腹部平坦紧致露腰线条清晰，整体专业影棚级瓷肌质感。\n\n服装：深蓝色水洗牛仔抹胸上衣/牛仔胸衣（Denim Corset Top），一字抹胸设计露出全肩颈与锁骨线条，面料为硬挺牛仔布材质表面布满自然水洗纹理与磨白效果，前中缝有明线装饰，剪裁修身贴合身形展现曲线，下摆短款露出完整腰部与腹部肌肤；下身为同款深蓝色高腰阔腿牛仔裤，裤腰宽松低胯设计，裤腿宽松垂坠长度及脚面；腰部系一条白色帆布腰带/衬衫扎系于腰间打结增添造型层次。\n\n配饰：颈部佩戴极细金色链条项链坠有小巧吊坠若隐若现；左手腕佩戴细链手镯与手链叠戴；右手腕佩戴极细金色手链或手绳；右手无名指佩戴简约戒指；左手中指佩戴戒指；指甲为浅紫色/淡紫灰色长款美甲指尖尖锐呈杏仁型。\n\n表情：眼神清澈明亮直视镜头带冷艳自信感与穿透力不回避，眉形精致微弯眼尾拉长增强神采，唇色正红色/草莓红色水润饱满光泽极其明显成为画面最大色彩视觉焦点之一微微闭合嘴角平直不带笑意但唇形饱满，表情清冷自信略带一丝妩媚张扬的疏离距离感——正如标题\"被SU7的氛围感拉满了\"所传达的高级时尚气场。"], "inputs": [{"name": "clip", "link": 11, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 11, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [284.1364373101128, -4234.7703043619795], "scale": 0.45}}, "groups": [], "links": [[4, 5, 0, 3, 1, "VAE"], [11, 7, 0, 11, 0, "CLIP"], [13, 11, 0, 9, 0, "CONDITIONING"], [63, 2, 0, 32, 0, "MODEL"], [64, 11, 0, 32, 1, "CONDITIONING"], [65, 9, 0, 32, 2, "CONDITIONING"], [66, 8, 0, 32, 3, "LATENT"], [67, 32, 0, 3, 0, "LATENT"], [68, 3, 0, 33, 0, "IMAGE"]], "id": "79b2facb-7a1a-49f7-9a00-b3891d875081", "config": {}, "version": 0.4, "last_node_id": 33, "revision": 0}