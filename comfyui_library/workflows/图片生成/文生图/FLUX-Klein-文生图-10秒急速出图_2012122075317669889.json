nnectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"width": true, "height": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "EmptyFlux2LatentImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 12}, {"outputs": [{"name": "NOISE", "links": [165], "label": "噪波生成", "type": "NOISE", "localized_name": "噪波"}], "color": "#2a363b", "widgets_values": [229452932623323, "randomize"], "inputs": [{"widget": {"name": "noise_seed"}, "name": "noise_seed", "link": 238, "label": "noise_seed", "type": "INT", "localized_name": "随机种"}], "flags": {}, "type": "RandomNoise", "mode": 0, "bgcolor": "#3f5159", "size": [270, 82], "pos": [-144.98507690429688, 702.7452392578125], "id": 93, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.8.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"noise_seed": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "RandomNoise", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 10}, {"outputs": [{"name": "STRING", "links": [177], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#2a363b", "widgets_values": ["一位中国女孩，黑色长发扎成高高的双丸子头，蓬松的微卷刘海略显凌乱地覆盖在额前。她拥有狐狸眼，采用了渐层烟熏妆，水汪汪的杏仁状瞳孔中闪烁着金属质感的高光，浓密而微微上翘的假睫毛下是一对深邃的眼睛。她的鼻梁挺直，薄唇涂上了深玫瑰红色哑光唇膏，轻轻撅起并微张，露出洁白整齐的牙齿。白皙的瓜子脸上有淡淡的粉色腮红，锁骨处有浅浅的凹陷。\n\n她身穿一件白色的宽袖棉质开衫，随意地披在肩上，袖口被卷折起来，露出里面一件黄色的紧身crop背心，背心上的“alwaysbaem on pinterest”字样细腻清晰。她的小腹平坦且紧致，肚脐眼和人鱼线隐约可见。下身穿着一条黑色的高腰leggings，完美包裹住她的蜂腰和翘臀，勾勒出大腿的曲线直至膝盖处圆润光滑。\n\n她的右手四指戴着多层银色细戒指，中指轻触唇角，拇指微微弯曲；左手自然下垂。一条粗链式的银色项链悬挂在胸前，大大的圆环坠饰随着动作摇晃，耳朵上挂着的大圈银耳环也随之摆动。身后是光线充足的白天背景，一面纯白色的墙面上布满了狂野的涂鸦，用红色狂草书写的英文与蓝色漆料绘制的数字“18”，以及“S”图案和飞溅的墨迹似乎从墙上滴落至地面，形成了裂纹和粗糙的质感。整个场景设置在一个充满活力的城市街头，阳光明媚，高清现实风格的摄影捕捉了每一个细节：发丝黑亮且分叉卷曲、眼妆中的珠光效果仿佛泪雾般的瞳纹、唇釉的纹理和光泽、开衫上的棉绒褶皱及纤维质感、背心棉质材料下的微妙阴影变化、裤子莱卡材质的光泽和勒痕、首饰上的金属刮痕和反光以及链环上的锈迹，还有墙面喷漆颗粒的溅射效果。自然的冷白色阳光与城市街头的暖色调霓虹灯相互交织，强调出一种叛逆而又自信的酷炫魅力。这样的画面营造了一个既明亮又具有个性的潮流氛围。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Prompt", "mode": 0, "bgcolor": "#3f5159", "size": [490.5661926269531, 354.0682678222656], "pos": [-1143.9490966796875, 697.516845703125], "id": 76, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.9.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 4}, {"outputs": [{"shape": 3, "name": "SEED", "links": [238], "label": "随机种", "dir": 4, "type": "INT"}], "color": "#2a363b", "widgets_values": [5496645, "", "", ""], "inputs": [], "flags": {}, "type": "Seed (rgthree)", "mode": 0, "bgcolor": "#3f5159", "size": [486.23907470703125, 130], "pos": [-1146.54541015625, 1371.1505126953125], "id": 107, "properties": {"cnr_id": "rgthree-comfy", "ver": "e9d56181883d4e05c4236f09422582f49abdec86", "randomMin": 0, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "randomMax": 1125899906842624}, "order": 5}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#2a363b", "widgets_values": ["Flux2-Klein"], "inputs": [{"name": "images", "link": 248, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#3f5159", "size": [486.8841857910156, 672.804443359375], "pos": [489.3584899902344, 729.9886474609375], "id": 9, "pro