t": 10}, "order": 4}, {"outputs": [{"name": "CONDITIONING", "links": [36, 41], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["这张图片呈现的是一位身着中山装的年长男性，坐在一间充满书卷气的书房中。\n人物细节：\n他是一位光头、面容温和的老年男性，穿着深灰色的中山装（立领、多扣、双贴袋设计），坐姿端正，双手自然放在膝盖上，神态平和放松。\n环境细节：\n背景是整面木质书架墙：书架为浅棕色实木材质，分为多层，摆满了密密麻麻的书籍，书籍以浅色、红色、蓝色封面为主，排列整齐，透出浓厚的学术或文化氛围；\n书架下方是同色系的木质柜门，带有简洁的金属把手；\n地面是浅棕色木地板，整体空间色调温暖、风格朴素雅致。\n这一场景（书房 + 中山装形象）常与科学家钱学森的书房复原场景相关联，展现出学者 / 科学家工作生活空间的质朴与厚重感。\n8K超高清。"], "inputs": [{"name": "clip", "link": 44, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [410, 370], "pos": [450.2638244628906, 305.2545166015625], "id": 45, "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 5}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.32.9", "VHS_latentpreview": false, "ds": {"offset": [129.85783567073884, -164.26774256237556], "scale": 1.2839025177495011}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Step2 - Image size", "bounding": [120.26380920410156, 665.2545166015625, 290, 200]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Step3 - Prompt", "bounding": [430.2638244628906, 235.25450134277344, 450, 540]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Step1 - Load models", "bounding": [120.26380920410156, 235.25450134277344, 290, 413.6000061035156]}], "link