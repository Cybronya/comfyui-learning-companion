, 0, 15, 0, "LATENT"], [29, 15, 0, 16, 0, "IMAGE"], [30, 15, 0, 18, 1, "IMAGE"], [31, 17, 0, 18, 0, "UPSCALE_MODEL"], [32, 18, 0, 19, 0, "IMAGE"], [33, 19, 0, 20, 0, "IMAGE"], [34, 21, 0, 22, 0, "IMAGE"], [35, 22, 0, 23, 0, "IMAGE"]], "id": "9b3ac3e2-5ba7-4d9e-b4d1-3325ba11d646", "config": {}, "version": 0.4, "last_node_id": 32, "revision": 0}