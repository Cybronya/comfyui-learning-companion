家场景\",\n    \"elements\": [\n      {\n        \"type\": \"家具\",\n        \"name\": \"浅灰色布艺沙发\",\n        \"details\": \"搭配同色系抱枕，沙发质感柔软，线条简约\"\n      },\n      {\n        \"type\": \"建筑结构\",\n        \"name\": \"落地窗\",\n        \"details\": \"白色窗框，窗外可见绿色植物与模糊建筑轮廓，自然光透过窗户洒入室内\"\n      },\n      {\n        \"type\": \"光线\",\n        \"details\": \"午后暖光自然光，在人物衣物、腿部与沙发表面形成柔和光斑与阴影，营造温暖氛围感\"\n      },\n    ]\n  },\n  \"lighting\": {\n    \"type\": \"自然侧窗暖光\",\n    \"direction\": \"光源来自侧后方窗户，午后阳光漫射\",\n    \"effect\": \"暖色调软光，在人物发丝、衣物与腿部形成柔和高光与渐变阴影，背景明亮通透，突出居家慵懒氛围\"\n  },\n  \"mood\": \"慵懒治愈、温柔甜美，充满居家舒适感与暖光氛围感，符合现代短视频审美\"\n}"], "inputs": [{"name": "clip", "link": 8, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 27, "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#3f5159", "size": [450, 350], "pos": [2084.65869140625, -114.6136245727539], "id": 14, "properties": {"cnr_id": "comfy-core", "ver": "0.3.43", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 14}, {"outputs": [{"name": "CONDITIONING", "links": [13], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#2a363b", "widgets_values": [""], "inputs": [{"name": "clip", "link": 18, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#3f5159", "size": [450, 150], "pos": [2096.25830078125, 303.99169921875], "id": 21, "properties": {"cnr_id": "comfy-core", "ver": "0.3.43", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 15}, {"outputs": [], "color": "#432", "widgets_values": ["#\"res_2s\"和\"bong_tangent\"采样器和调度程序分别来自\"Res4Lyf\"自定义节点。这个组合提供了迄今为止最好的质量，\n当然你也可以使用ComfyUI的默认采样器和调度程序。\n请注意，\"res_2s\"大约会使生成时间增加一倍。"], "inputs": [], "flags": {}, "type": "Markd