ioning", "link": 1, "label": "conditioning", "type": "CONDITIONING", "localized_name": "conditioning"}], "flags": {"collapsed": false}, "id": 1, "type": "ConditioningZeroOut", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ConditioningZeroOut", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#1 ConditioningZeroOut\n作用：把条件输入置空/弱化，减少条件干扰。\n参数：\n- conditioning：当前值=来自 节点#6 CLIPTextEncode 的 `CONDITIONING` 输出；作用：接收上游 `conditioning` 连线输入；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 190], "pos": [920, 188], "id": 12, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#2 UNETLoader\n作用：加载扩散主干模型（UNet），决定核心生成能力。\n参数：\n- unet_name：当前值=ernie-image-turbo.safetensors；作用：选择 UNet 模型文件；范围：模型下拉列表中的文件名；默认：系统默认 UNet。\n- weight_dtype：当前值=default；作用：模型权重精度类型；范围：fp16 / bf16 / fp8 等枚举；默认：默认精度。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 226], "pos": [0, 188], "id": 13, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#3 CLIPLoader\n作用：加载 CLIP 语义编码器，供文本/图像条件编码使用。\n参数：\n- clip_name：当前值=ministral-3-3b.safetensors；作用：选择 CLIP 模型文件；范围：模型下拉列表中的文件名；默认：系统默认 CLIP。\n- type：当前值=flux2；作用：CLIP 工作模式；范围：插件定义的下拉枚举；默认：default。\n- device：当前值=default；作用：模型运行设备；范围：cpu / cuda / mps 等可用设备；默认：default。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 280], "pos": [0, 1154], "id": 14, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#4 SaveImage\n作用：保存图像到输出目录并生成文件名前缀。\n参数：\n- filename_prefix：当前值=StarTed/Ernie-Image-Turbo；作用：输出文件名前缀；范围：字符串（文件系统合法字符）；默认：ComfyUI。\n- images：当前值=来自 节点#8 VAEDecode 的 `IMAGE` 输出；作用：接收图像序列输入（可是一张图或多帧批次）；范围：图像数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 226], "pos": [2300, 618], "id": 15, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#6 CLIPTextEncode\n作用：将文本编码为条件向量（常用于负面词或补充条件）。\n参数：\n- text：当前值=帮我生成一幅插画，极简油画风格，笔触细腻，纹理清晰，图片远处最上方是排成一字白色的海鸥在天空飞翔，…；作用：输入文本内容（正/负提示词）；范围：字符串，通常 0 ~ 4096 字符；默认：空字符串。\n- clip：当前值=来自 节点#3 CLIPLoader 的 `CLIP` 输出；作用：接收 CLIP 编码器对象，用于把提示词编码成条件向量；范围：CLIP 编码器对象（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 280], "pos": [460, 278], "id": 16, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#7 VAELoader\n作用：加载 VAE 编解码器，负责像素域与潜空间转换。\n参数：\n- vae_name：当前值=flux2-vae.safetensors；作用：选择 VAE 文件；范围：VAE 文件列表中的文件名；默认：系统默认 VAE。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 172], "pos": [0, 698], "id": 17, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#8 VAEDecode\n作用：将采样 latent 解码为可视图像。\n参数：\n- samples：当前值=来自 节点#10 KSampler 的 `LATENT` 输出；作用：接收待处理 latent 样本（如待解码或待上采样的数据）；范围：latent 数据（连线输入）；默认：由上游节点输出决定。\n- vae：当前值=来自 节点#7 VAELoader 的 `VAE` 输出；作用：接收 VAE 对象，用于像素图像与 latent 之间转换；范围：VAE 对象（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 262], "pos": [1840, 188], "id": 18, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#10 KSampler\n作用：核心采样器：按步数/采样器/调度器将噪声迭代为目标 latent。\n参数：\n- seed：当前值=601240929502329；作用：随机种子，控制可复现性；范围：整数，常见 0 ~ 2^63-1；默认：0。\n- control_after_generate：当前值=randomize；作用：每次生成后对种子的处理策略；范围：固定/随机/递增等枚举值；默认：fixed。\n- steps：当前值=8；作用：采样步数，步数越高通常细节越充分；范围：整数，常见 1 ~ 150；默认：20。\n- cfg：当前值=1；作用：提示词引导强度；范围：浮点，常见 0.0 ~ 30.0；默认：7.0。\n- sampler_name：当前值=euler；作用：采样算法类型；范围：下拉枚举（如 euler / dpm / sa_solver）；默认：euler。\n- scheduler：当前值=simple；作用：噪声调度策略；范围：下拉枚举（normal / karras / beta 等）；默认：normal。\n- denoise：当前值=1；作用：去噪强度；1 表示完整重绘；范围：浮点 0.0 ~ 1.0；默认：1.0。\n- model：当前值=来自 节点#2 UNETLoader 的 `MODEL` 输出；作用：接收上游模型对象（具体是扩散模型、姿态模型或检测模型由该节点类型决定）；范围：模型对象（连线输入）；默认：由上游节点输出决定。\n- positive：当前值=来自 节点#6 CLIPTextEncode 的 `CONDITIONING` 输出；作用：接收正向条件向量，告诉模型“应该生成什么”；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。\n- negative：当前值=来自 节点#1 ConditioningZeroOut 的 `CONDITIONING` 输出；作用：接收负向条件向量，告诉模型“尽量避免什么”；范围：CONDITIONING 类型数据（连线输入）；默认：由上游节点输出决定。\n- latent_image：当前值=来自 节点#11 EmptyFlux2LatentImage 的 `LATENT` 输出；作用：接收起始 latent 画布或中间 latent 结果，作为采样输入底稿；范围：latent 数据（连线输入）；默认：由上游节点输出决定。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 928], "pos": [1380, 398], "id": 19, "properties": {"widget_ue_connectable": {}}, "order": 11}, {"outputs": [], "color": "#27364a", "widgets_values": ["节点#11 EmptyFlux2LatentImage\n作用：为 Flux 工作流创建空白 latent 画布。\n参数：\n- width：当前值=1024；作用：控制输出尺寸与清晰度；改大更清晰但更耗时、更占显存；范围：整数或预设分辨率档位（常见 256 ~ 4096）；默认：1024（常见）。\n- height：当前值=1024；作用：控制输出尺寸与清晰度；改大更清晰但更耗时、更占显存；范围：整数或预设分辨率档位（常见 256 ~ 4096）；默认：1024（常见）。\n- batch_size：当前值=1；作用：一次生成的图片数量；范围：整数，常见 1 ~ 16；默认：1。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#3f5b7f", "size": [240, 316], "pos": [0, 1783], "id": 20, "properties": {"widget_ue_connectable": {}}, "order": 12}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [2973.1748046875, 4142.5], "pos": [-3073.914794921875, 0], "widgets_values": ["5ea7b6dddd00c759948ac5990f2255e6d9464063ed0de5d84e6a4cd840029a69.jp