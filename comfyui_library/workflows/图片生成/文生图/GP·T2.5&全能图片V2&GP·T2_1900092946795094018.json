902770996094, 354.7672119140625], "pos": [1037.83447265625, 1526.047119140625], "widgets_values": ["8abda9232bbcfb703420759c541bc7155fcd9df59d4656b0e1f3287e17ce908f.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 94, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 7}, {"mode": 4, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [427.982421875, 439.3578796386719], "pos": [1759.8203125, 1522.9964599609375], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 133, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 95, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 18}, {"mode": 0, "outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [468.85418701171875, 541.3880615234375], "pos": [2256.650146484375, 2335.53125], "widgets_values": ["①------光影自动合成优化\n\n绝对保持原图的色温和色彩。仅根据画面原本的主光源方向，计算产品在模特身上投射的阴影位置并生成阴影，消除产品边缘的悬浮感。\n\n②------同SKU调色\n\n将图2的颜色完美迁移到图1的产品上。不仅要修改主材质颜色，还要同步修改拉链、缝线、扣具、内衬和织带的颜色，确保产品整体色调的高度统一。\n\n③------场景裂变其他角度\n\n保持背景环境、光照和产品的所有细节完全不变。将摄影机视角向右（或左）移动45度，呈现产品的四分之三侧面视图，根据透视原理自然地展示产品的侧面细节。\n\n④------白底图自动匹配背景\n\n为白色背景的产品图片生成一个与模特服装相协调的背景场景。需考虑模特服装的风格、颜色和主题。背景应能提升产品和模特的整体视觉效果，营造出自然且美观的构图。确保生成的背景中的光线与模特和产品的光线相匹配，以保持一致性。\n\n⑤------模特换包\n\n将图2这款包包自然地合成到图1模特身上，包包要看起来像是真实背在身上的，而不是P上去的。注意包包带子与身体的贴合度。\n\n⑥------指定区域修改\n\n将图2背包放在图1红色虚线框内座椅底部，保持画面细节不变，并移除红色虚线。\n\n⑦------修改包包大小\n\n将模特手中的包包放大，放大到包包四个角对应四个红色标记点位置大小，并删除红色标记点，最后将图4包包替换放大之后的图1包包。\n\n⑧------精修\n\n参考图1精修效果，对图2进行精修。\n\n⑨------减少即梦生图AI感\n\n优化这张AI模特的面部，重点修复不自然的五官，让人脸看起来像真实的人脸。\n修复重点：\n1. 眼睛：调整形状、大小、位置、眼神光\n2. 鼻子：修正鼻梁、鼻翼、鼻孔的自然形态\n3. 嘴巴：优化唇形、牙齿、表情肌的联动\n4. 耳朵：调整位置、大小、细节\n5. 面部轮廓：协调三庭五眼的比例关系\n目标：消除“AI脸”特征，达到真人照片的自然感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"disabled": false}, "id": 73, "type": "JjkText", "title": "提示词参考推荐", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 8}, {"mode": 4, "outputs": [{"name": "int", "links": [148], "label": "整数", "type": "INT", "localized_name": "int"}], "size": [270, 58], "pos": [2540.1875, 1663.2220458984375], "widgets_values": [2000], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "value"}], "flags": {"disabled": false}, "id": 113, "type": "easy int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy int"}, "order": 9}, {"mode": 4, "outputs": [{"name": "image", "links": [149, 152], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [294.1185607910156, 291.58782958984375], "pos": [2558.146240234375, 1851.78076171875], "widgets_values": ["seedvr2_ema_3b_fp8_e4m3fn.safetensors", 966411890, "randomize", 1216, 5], "inputs": [{"name": "images", "link": 150, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "block_swap_config", "link": 146, "label": "block_swap_config", "type": "block_swap_config", "localized_name": "block_swap_config"}, {"shape": 7, "name": "extra_args", "label": "extra_args", "type": "extra_args", "localized_name": "extra_args"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "new_resolution"}, "name": "new_resolution", "link": 148, "label": "new_resolution", 