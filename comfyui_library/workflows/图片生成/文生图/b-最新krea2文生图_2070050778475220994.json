pe": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [270, 290], "pos": [1267.3984375, 215.49449157714844], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 57, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 52, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 9}, {"mode": 0, "outputs": [{"name": "text", "links": [58], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 200], "pos": [-510.4106140136719, -101.8398208618164], "widgets_values": ["整体拍摄风格为户外足球冠军应援写真，高清写实体育时尚大片，平视机位拍摄，竖幅近景半身肖像，带有夏日阳光、国家队荣耀与女性力量感；画面美学氛围热烈、骄傲、明艳，红黄主色高度饱和，西班牙国旗铺满背景，金色奖杯反光增强胜利仪式感；主体为年轻东亚女性位于画面中心，身体正面略微左倾，眼神直接自信地凝视镜头，长发被风吹散覆盖部分脸颊与肩颈；前景为人物怀中的白色足球与右侧金色世界杯造型奖杯，足球贴近左下角，带红黄笔触纹理与西班牙盾形徽章，右手握住奖杯底部，蓝白指甲清晰可见；中景主体穿红色西班牙足球球衣，轻薄透气针织面料，V领剪裁，肩部三道黄色条纹，袖口黄色滚边，胸前有黄色品牌标志与西班牙队徽、一颗金色星标，下装为高腰白色百褶裙，挺括面料与垂直褶线突出清爽运动感；背景为巨幅西班牙国旗近距离展开，红黄红横向色带占满画面，左上可见模糊王冠与盾徽，旗面被风吹起形成大幅波浪褶皱，右上角露出少量蓝天；构图为中心对称偏动态构图，奖杯与足球分布左右形成平衡；视觉引导由国旗波浪线、发丝走向、汇聚到脸部与奖杯；光影效果为强烈户外硬质阳光与侧逆光，发丝边缘高光明显，脸部半明半暗，奖杯产生金属高光，背景色块明亮，轻微胶片颗粒；全画幅相机，35mm镜头，f2.0光圈，ISO100，1/1600s，高速快门，浅景深，背景轻微虚化。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 53, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}], "extra": {"VHS_KeepIntermediate": false, "links_added_by_ue": [], "workflow_notes": "Native ComfyUI 0.25.0+ Krea2 workflow. Uses official CLIPLoader/UNETLoader nodes. Requires 3 model files (see Note node).", "VHS_MetadataImage": false, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.45.19", "VHS_latentpreview": true, "ds": {"offset": [764.3288391915102, 331.4305698945166], "sca