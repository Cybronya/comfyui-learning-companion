[2580, 2030], "inputs": [{"name": "", "link": 498, "type": "*"}], "flags": {}, "id": 4, "type": "Reroute", "properties": {"horizontal": false, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "showOutputText": false}, "order": 18}, {"mode": 0, "outputs": [{"name": "", "links": [54], "type": "VAE"}], "size": [75, 26], "pos": [3390, 2240], "inputs": [{"name": "", "link": 17, "type": "*"}], "flags": {}, "id": 3, "type": "Reroute", "properties": {"horizontal": false, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "showOutputText": false}, "order": 17}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [405], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314], "pos": [3050, 3780], "widgets_values": ["f3aac448d612e4d5d3e00bd6f1d8d7185c4898003e32a81261477643c40bb0b6.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 271, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.16.3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"mode": 4, "outputs": [{"shape": 6, "name": "text", "label": "字符串", "type": "STRING", "localized_name": "text"}], "size": [540, 520], "pos": [5150, 3150], "widgets_values": ["画面呈现出一种深邃而梦幻的明暗关系，光源主要来自背景中高悬的满月和悬浮建筑内部透出的暖黄灯光，以及镜面反射出的柔和光辉。这种多层次的光影设计使得主体人物在冷色调的夜色中显得格外突出，面部和服饰的亮部细节清晰可见，而阴影部分则融入了周围的云雾之中，营造出一种虚实相生的神秘感。主体是一位拥有灵狐特征的女性神祇，她生着一对毛茸茸的狐耳，头戴镶嵌宝石的金色繁复头饰，长发如墨般流淌，发梢在风中飘舞。她身着精致的青白渐变古风汉服，衣料轻薄如纱，表面布满细腻的金色刺绣和珠光纹理，宽大的袖口和飘逸的裙摆层层叠叠，尽显高贵与优雅。她的右手持一面华丽的圆形古镜，镜框雕花精细，镜面内竟映照出另一个微缩的奇幻世界，有飞鸟、高塔和明月，仿佛通往异次元。\n\n前中景部分，巨大的白色狐尾如同云海般在人物身后和身侧翻涌，毛发的质感蓬松柔软，每一缕丝毛都清晰可辨，与人物身上的丝绸衣物形成了粗与细、软与滑的质感对比。右侧中景处，一只青色的小灵狐正立于云端岩石之上，与主体遥相呼应，增加了画面的叙事性。背景则是云雾缭绕的仙境楼阁，具有典型的东方古典建筑风格，飞檐翘角在夜色中若隐若现，远处一轮巨大的圆月悬挂天际，云层在月光下呈现出冷冽的银蓝色调。构图上采用了对角线式的动态布局，人物的姿态、飘动的发丝与衣带以及背景中延伸的桥梁共同引导着视线从左下方向右上方流动，最终汇聚在人物手中的古镜和远处的明月之上。\n\n视觉引导主要通过光影的强弱变化和线条的流向来实现，明亮的镜面和人物面部是视觉的第一落点，随后顺着她延伸的手臂和飘扬的衣带向四周扩散。整体色调以冷艳的青蓝色、银白色为主，辅以金色的装饰线条和暖黄色的灯光点缀，形成冷暖对比，既突出了月夜的清冷幽静，又不失仙境的华丽辉煌。光影氛围充满了空灵与静谧的气息，空气中似乎弥漫着淡淡的荧光粒子，云雾的流动感极强，使得整个画面仿佛是一个静止的动态瞬间，充满了东方神话的浪漫主义色彩和超现实主义的奇幻美感，令人仿佛置身于一个远离尘世喧嚣的永恒梦境之中。"], "inputs": [{"name": "text", "link": 408, "label": "文本", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 272, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "609f3afaa74b2f88ef9ce8d939626065e3247469", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 20}, {"mode": 4, "outputs": [{"name": "any", "links": [434, 490], "label": "any", "type": "*", "localized_name": "any"}], "size": [330, 26], "pos": [4730, 3460], "widgets_values": [], "inputs": [{"name": "any", "link": 407, "label": "any", "type": "*", "localized_name": "any"}], "flags": {}, "id": 268, "type": "llama_cpp_unload_model", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2e0ce849519e38d2a5a8f087b52552524beea273", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "aux_id": "lihaoyun6/ComfyUI-llama-cpp_vlm", "Node name for S&R": "llama_cpp_unload_model"}, "order": 19}, {"mode": 4, "outputs": [{"name": "anything", "label": "anything", "type": "*", "localized_name": "anything"}], "size": [270, 82], "pos": [4789.10205078125, 3077.615966796875], "widgets_values": [3, true], "inputs": [{"name": "anything", "link": 490, "label": "anything", "type": "*", "localized_name": "anything"}, {"widget": {"name": "clean_intensity"}, "name": "clea