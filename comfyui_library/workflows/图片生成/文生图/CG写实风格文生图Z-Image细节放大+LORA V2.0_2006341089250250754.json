 "#322", "widgets_values": ["超写实氛围人像，东亚女性，深棕大波浪长发（发丝被柔风轻吹、几缕搭在脸颊 / 唇侧）；\n妆容精致：根根分明的浓翘睫毛、浅粉雾面唇釉，佩戴碎钻流苏长款耳环（耳环垂至下颌线）；身着黑色低领薄纱吊带，外搭浅卡其色宽松罩衫（罩衫滑落至肩臂）；姿态：侧身轻靠在米白色柔软面料（如沙发）上，右手抬至额前、指尖轻触眉骨，肩颈线条自然舒展；\n相机视角：近距离微俯拍（镜头位于人物上方约 15° 角，视线略向下聚焦面部）；构图比例：近景特写，三分构图法，人物位于画面下方三分线处（人物占画面 50% 空间，裁剪至胸部上方，背景完全虚化暗调处理），画面主体偏右，左侧留白露出部分面料质感；\n光影：侧前方单束暖调硬光（光线从画面左前方射入，在发丝边缘形成金边轮廓光，皮肤、唇瓣上形成细腻高光，颈部、发丝间隙形成柔和阴影）；\n画质：8K 分辨率，3D 渲染超写实质感（发丝纹理、薄纱通透度、耳环碎钻光泽清晰可见），氛围慵懒又冷艳，色调偏暗调高级感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#533", "size": [400, 200], "pos": [-3475.80322265625, -671.1079711914062], "id": 135, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 13}, {"outputs": [{"name": "MODEL", "links": [306], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#232", "widgets_values": ["lulu1w.safetensors", 1.0000000000000002], "inputs": [{"name": "model", "link": 305, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 4, "bgcolor": "#353", "size": [270, 82], "pos": [-1487.454833984375, -721.1682739257812], "id": 183, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 17}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [2091.172288989977, 890.5817532835817], "scale": 1.2284597357368012}}, "groups": [{"color": "#8A8", "font_size": 24, "flags": {}, "id": 3, "title": "t2i", "bounding": [-2137.541259765625, -801.0945434570312, 1901.