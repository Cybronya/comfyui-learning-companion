mpt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_LLMAPI_NODE", "mode": 0, "bgcolor": "#353", "size": [282.0143127441406, 719.6843872070312], "pos": [-201.6542510986328, -535.8517456054688], "id": 74, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 10}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [82], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [262.9193115234375, 82], "pos": [756.39794921875, -424.66827392578125], "widgets_values": ["WAN_阳光奶奶_低噪3000.safetensors", 0.4000000000000001], "inputs": [{"name": "model", "link": 83, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 67, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.3.51", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 23}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#232", "widgets_values": ["一位中国奶奶模特，蓬松短发，发丝自然柔软，眼角略带细纹，微笑着直视镜头，饱含慈祥与智慧。她身穿深灰色H型宽松羽绒服，衣襟敞开，露出内搭的黑色高领针织衫，针织衫细腻光泽，自然垂坠，增添几分优雅。羽绒服整体呈菱形绗缝纹理，立领连帽设计，帽沿配有抽绳，前襟中央以金属拉链搭配按扣闭合，拉链外侧饰有竖向压线，两侧斜插口袋盖采用中式盘扣设计，深灰布质盘扣配金属扣环，精致典雅。衣身两侧以及口袋盖上点缀银灰色花卉刺绣，流畅细腻的线条与微小亮片相辅相成，呈现立体层次。袖口与下摆采用松紧收口设计，整体轮廓简洁利落，质感高级，展现中国风的独特魅力。她端坐于一张木质扶手椅上，椅背与扶手雕刻精美，椅子上摆放着橙色刺绣靠垫与坐垫，鸟与花卉的图案鲜艳明丽，富有传统韵味。她右手轻扶椅扶手，左手自然放置腿上，姿态端庄，气质从容。左侧是一张木质小茶几，青花瓷瓶内插着几支红色鲜花，旁边放着一只精致的青花瓷茶杯与碟子，茶几的摆设细腻雅致。地面铺设浅色地毯，抽象水波纹样的装饰与整体空间相得益彰。中景为一扇黑色屏风，上绘花鸟图，黄色与橙色花卉搭配枝叶与飞鸟，充满自然气息。背景是一面深蓝色墙壁，墙上挂着一幅圆形花卉装饰画，画面清雅脱俗。右侧放置一张木质柜子，柜面上摆放白色陶瓷花瓶、红色茶壶与托盘，层次分明，色调和谐，整体空间洋溢着浓郁的中国传统美学，宁静而优雅。"], "inputs": [{"shape": 7, "name": "anything", "link": 124, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#353", "size": [405.2429504394531, 322.81829833984375], "pos": [1522.3641357421875, -1202.26513671875], "id": 49, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 22}, {"mode": 0, "outputs": [{"name": "FLOAT", "links": [129], "label": "FLOAT", "type": "FLOAT", "localized_name": "浮点"}], "size": [298.3359069824219, 65.60225677490234], "pos": [492.71466064453125, 306.175048828125], "widgets_values": [0.6000000000000001], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "值"}], "flags": {}, "id": 85, "type": "PrimitiveFloat", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 8}, {"outputs": [{"name": "describe", "links": [70, 115, 124], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#232", "widgets_values": ["", "", "", "##角色定位\n你是一位富有艺术感的Prompt 助理，在不改变主体内容的情况下，对提示词进行润色和扩写，能够将我提供给你的文本内容转化为丰富、生动、具体的文本提示词（prompt），以用于图像生成模型。\n\n---\n\n##核心任务\n\n我将提供一段文本内容，你的任务是：\n\n1.对提供的文本进行优化扩写，丰富整个场景，更富个商业摄影风格。\n2.根据不同场景、道具和搭配，丰富人物肢体动作，符合主题的细节；根据年龄增一些脸部细节，如眼角皱纹，皮肤细节等。\n3.结合服装和场景，为人物增添首饰和道具，非必须。（如：适合高贵老年人的珍珠项链，玉镯，珍珠耳环，棕色女包，围巾，帽子,星巴克等，适合当前场景的道具）。\n4.如果场景中有椅子，展现模特的端庄坐姿；（写书法、茶道、喝茶、中国结、手摸衣服、敞开衣服、插口袋、扶眼镜、打招呼等，尽可能的丰富人物的肢体动作）。\n5.如果常经理没有椅子，展现模特站立姿势，丰富手部动作（参考：抬起左手至胸前，右手插兜；手里拿着茶杯，手里拿着中国结等。）\n6.外套类型的服装可以敞开衣襟展示，可见针织衫内搭。\n7.针织衫类型的衣服不要出现内搭，可以佩戴珍珠项链。\n---\n\nPrompt 输出格式要求\n\n- **语言**：仅使用中文生成 prompt\n- **语气**：描述性强、画面感明确，避免口语化或模糊措辞\n- **结构**：连贯自然，不分条目，形成一段完整描述\n- **长度**：足够详尽，字数限制在100词。\n- **内容限制**：\n  - 人物动作不要出现双手自然垂下或者双手放在腹部等；\n  - 不解释 prompt 内容\n  - 不添加“生成提示词”、“Prompt:”等前缀\n  - 整理成一段进行输出。\n\n---\n", "", 0.6, 1110, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 128, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_LLMAPI_NODE", "mode": 0, "bgcolor": "#353", "size": [507.8987121582031, 605.5608520507812], "pos": [938.8751220703125, -1114.270263671875], "id": 51, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 19}, {"outputs": [{"name": "INT", "links": [75], "label": "整数", "type": "INT", "localized_name": "整数"}], "color": "#223", "widgets_values": [1536], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "type": "ImpactInt", "mode": 0, "bgcolor": "#335", "size": [210, 58], "pos": [1046.561279296875, -17.417261123657227], "id": 58, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImpactInt"}, "order": 9}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offse