潮湿石面、植物叶脉各有真实触感，避免锐化光晕与塑料般的表面。横向宽幅构图，留出足够天空与海面，空间纵深明确。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false, "disabled": false}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [680, 460], "pos": [480, 0], "id": 277, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 5}, {"outputs": [{"name": "LATENT", "links": [477], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#323", "widgets_values": [], "inputs": [{"name": "pixels", "link": 475, "label": "pixels", "type": "IMAGE", "localized_name": "pixels"}, {"name": "vae", "link": 476, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "type": "VAEEncode", "mode": 0, "bgcolor": "#535", "size": [420, 120], "pos": [2750, 1420], "id": 300, "properties": {"cnr_id": "comfy-core", "ver": "0.37.0", "widget_ue_connectable": {}, "Node name for S&R": "VAEEncode"}, "order": 35}, {"outputs": [{"name": "LATENT", "slot_index": 0, "links": [468], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#323", "widgets_values": [0, "fixed", 6, 1, "res_2s_ode", "kl_optimal", 0.18], "inputs": [{"name": "model", "link": 465, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 466, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 467, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 477, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name":