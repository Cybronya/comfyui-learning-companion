177, "type": "INT", "localized_name": "索引"}], "flags": {"collapsed": false}, "id": 106, "type": "InversionDemoLazyIndexSwitch", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "InversionDemoLazyIndexSwitch"}, "order": 37}, {"mode": 0, "outputs": [{"name": "output", "links": [82, 102, 196], "type": "*", "localized_name": "output"}], "size": [435.0865478515625, 409.7862854003906], "pos": [-669.4867553710938, 1029.7816162109375], "widgets_values": ["一张极具东方古典美学的半身人像摄影作品。画面中心是一位温婉清丽的中国汉服美女，她身穿一袭浅青色与柔和桃粉色交织的传统齐胸襦裙，轻盈的半透明丝绸面料上用银线精心刺绣着绽放的白梅图案。她的乌黑长发挽成优雅的随云髻，发间斜插着一支温润的白玉步摇，细密的珍珠流苏在耳畔轻轻垂坠。女子面容姣好，画着精致的古典妆容，柳叶眉配以点绛唇，眼神温柔如水，流露出宁静与诗意的情感。背景是一座幽静的江南古典庭园，呈现出优美的景深虚化效果。隐约可见精雕细琢的木质花窗、几缕随风轻拂的翠绿垂柳，以及远处波光粼粼的池塘和一座古朴的飞檐六角亭。柔和的夕阳余晖透过树叶的缝隙洒落，在她白皙的脸庞和丝绸衣物上打下斑驳而温暖的金色光影。整体画面充满唯美、恬静且略带神秘的氛围，采用电影级光影质感，8K超高分辨率，完美展现了中式传统文化的典雅气韵与绝美意境。"], "inputs": [{"shape": 7, "name": "anything", "link": 182, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 25, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "1.3.0", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 40}, {"outputs": [{"name": "text", "links": [151, 154, 155, 181], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["一个中国汉服美女，穿着美丽的汉服，半身照，中式庭园背景"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [365.7337951660156, 353.7393493652344], "pos": [-1529.4505615234375, 1706.5087890625], "id": 95, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 25}, {"outputs": [{"name": "value", "links": [126, 177], "label": "值", "type": "INT", "localized_name": "value"}], "color": "#332922", "widgets_values": [2], "inputs": [{"widget": {"name": "value"}, "name": "value", "type":