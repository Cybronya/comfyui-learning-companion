i_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 24, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 23, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 7}, {"mode": 0, "outputs": [{"name": "output", "links": [17], "type": "*", "localized_name": "output"}], "size": [308.7183532714844, 183.52589416503906], "pos": [298.2185363769531, 940.2390747070312], "widgets_values": ["一张写实风格的商业海报，整体画面以温馨的居家场景为核心，45度视角展现一套现代简约风格的沙发，沙发周围点缀绿植以提升空间的自然感与舒适感。沙发上坐着一家三口，父母微笑对视或与孩子互动，中间的小女孩抱着毛绒玩具，流露出幸福温馨的家庭氛围，强化情感共鸣。背景选用柔和的暖色调（如米白或浅灰）墙面，搭配木质纹理地板，营造清爽简约的室内空间感。\n\n画面构图以沙发为视觉中心，人物与绿植分布均衡，形成稳定的三角形构图。沙发展示多种颜色选项（如灰、蓝、米黄），在沙发右下角用小色块或标签点明“多色可选”卖点，增强产品信息传达的层次感。顶部的文案“温馨才是家”采用现代手写风格字体，字形圆润流畅，搭配轻微波浪线效果，传递亲切与柔和感。字体为暖色系（如橙黄或奶咖色），与整体画面氛围和谐统一。\n\n色彩方案以暖色为基调，点缀自然绿与柔和蓝，形成温馨而清新的家居氛围。画面左下角或右下角设计新品上市的标识，搭配简洁的促销信息（如“新品首发，限时优惠”），字体选择现代无衬线字体，排列紧凑但不压迫，增强商业信息的传递力。整体画面元素紧凑、布局和谐，既突出沙发的产品特性，又强化温馨家庭的核心主题。"], "inputs": [{"shape": 7, "name": "anything", "link": 27, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": false}, "id": 26, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 9}, {"mode": 0, "outputs": [{"name": "width", "links": [], "label": "宽度", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [], "label": "高度", "type": "INT", "localized_name": "height"}, {"name": "upscale_factor", "label": "放大系数", "type": "FLOA