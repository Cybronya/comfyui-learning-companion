ts_values": ["核心元素：年轻东亚女性，黑色侧编麻花辫造型，身着粉色紧身长袖上衣，背景为古色古香的户外街道，摆放着竹篮与紫色花束，构图采用近景自拍人像，前景为人物主体，中景为花束与建筑，背景为室内休闲区域，空间层次分明。\n具体内容：女性拥有白皙透亮的皮肤，五官精致立体，眼神看向镜头，表情清冷又带着温柔感。黑色长发编成侧麻花辫，发丝细节清晰，几缕碎发修饰脸型。身着粉色紧身长袖上衣，领口装饰着粉色与紫色的立体花朵，胸前线条柔和。佩戴着民族风的水滴流苏耳环，耳环带有彩色装饰与银色流苏，细节精致。背景为古色古香的木质建筑，石墙与木门搭配，竹篮里装满紫色花束，旁边摆放着绿色箱子，室内能看到浅灰色的休闲沙发。\n构图方式：采用近景自拍构图，人物位于画面中心，是视觉焦点。确保人物面部与服装细节清晰锐利。光线来自前方的自然光，阴影过渡自然。"], "inputs": [{"name": "clip", "link": 74, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [480, 420], "pos": [-1389.36474609375, -147.7930145263672], "id": 52, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [79], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [320, 590], "pos": [-881.0454711914062, -63.301109313964844], "widgets_values": [1012252640754505, "fixed", 8, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 111, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "positive", "link": 76, "label": "正面条件", "type": "CONDITIONING", "localized_name": "正面条件"}, {"name": "negative", "link": 77, "label": "负面条件", "type": "CONDITIONING", "localized_name": "负面条件"}, {"name": "latent_image", "link": 78, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "type": "COMBO", "localized_name": "调