109375, -79.38677978515625], "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 3, "type": "VAELoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 3}, {"outputs": [{"name": "prompt", "links": [88], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["一位身着精致粉色汉服的年轻女子，发髻高挽，饰以金丝花钿、珍珠流苏与粉白莲花发簪，长发如墨瀑般垂落肩头，几缕发丝随风轻扬。衣衫轻薄透纱，缀满珍珠串链与金线刺绣，肩颈处饰有蝶形金饰，衣袖宽大飘逸，衣袂间隐约透出内衬白纱，衣料质感如云似雾，泛着柔润光泽。她侧身回眸，眉目如画，眼波流转，唇色如初绽桃花，神情温婉中透着一丝清冷孤傲，似从古画中走出的仙子。背景为深邃朦胧的暗紫色调，似夜幕轻纱，微光如星尘般飘散，营造出梦幻空灵的氛围。构图采用中近景特写，人物占据画面主体，略偏右，视线引向左上方，形成自然视觉引导。光影柔和，主光源自左前方打来，勾勒出人物轮廓与服饰纹理，面部光影过渡细腻，鼻梁与唇角微光，增强立体感。整体氛围静谧唯美，如月下仙子独舞，兼具古典东方美学与现代光影艺术，画面层次丰富，虚实相生，充满诗意与神秘感。提示词：一位身着粉色珍珠金线汉服的年轻女子，发髻高挽饰以莲花发簪与流苏珍珠，长发飘逸，衣袂轻盈，侧身回眸，眉目如画，唇色如桃花，背景深紫朦胧，如夜幕星尘，光影柔和，构图中近景特写，氛围静谧唯美，古典东方美学与现代光影艺术结合，如月下仙子独舞，充满诗意与神秘感。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#335", "size": [346.26580810546875, 261.41632080078125], "pos": [-542.1195068359375, -701.1998291015625], "id": 53, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#593930", "groupcolor": "#b06634", "color": "#332922"}}, "order": 4}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [23, 45], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "width", "links": [], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height",