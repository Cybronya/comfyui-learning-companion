": "INT", "localized_name": "mirostat_mode"}, {"widget": {"name": "mirostat_eta"}, "name": "mirostat_eta", "label": "mirostat_eta", "type": "FLOAT", "localized_name": "mirostat_eta"}, {"widget": {"name": "mirostat_tau"}, "name": "mirostat_tau", "label": "mirostat_tau", "type": "FLOAT", "localized_name": "mirostat_tau"}, {"widget": {"name": "state_uid"}, "name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "flags": {}, "type": "XB_llamaParameters", "mode": 0, "bgcolor": "#4F0074", "size": [270, 346], "pos": [-1351, -846], "id": 135, "properties": {"widget_ue_connectable": {"mirostat_eta": true, "max_tokens": true, "mirostat_mode": true, "present_penalty": true, "top_p": true, "min_p": true, "frequency_penalty": true, "state_uid": true, "mirostat_tau": true, "top_k": true, "temperature": true, "repeat_penalty": true, "typical_p": true}, "Node name for S&R": "XB_llamaParameters"}, "order": 2}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [399, 171], "pos": [-1043, -675], "widgets_values": [], "inputs": [{"name": "text", "link": 287, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 137, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 16}, {"outputs": [], "color": "#432", "widgets_values": ["一个亚洲女性，披肩长发，身穿白色紧身衬衫，丰满胸部若隐若现，下身穿黑色超短包臀短裙，臀部丰满挺翘，穿黑色丝袜，黑色高跟鞋"], "inputs": [], "flags": {}, "type": "Note", "title": "生图提示词", "mode": 0, "bgcolor": "#653", "size": [365, 88], "pos": [-1411, -448], "id": 138, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"mode": 0, "outputs": [{"name": "prompt", "links": [], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [-1909, -849], "widgets_values": ["您是文生图模型领域的提示词工程专家。您的任务是将用户的提示词使用中文扩展为高效的图像生成提示词，或者根据客户提供的图片反推提示词。\n\n在撰写答案前，请按步骤思考以下问题：\n- 主体和氛围是什么？\n- 哪些视觉风格、媒介和光照选项最合适？权衡两到三种方案，选择最能体现原意的一种。\n- 什么样的构图、取景和具体细节有助于模型理解？\n\n随后，输出一段扩展后的提示词。\n\n请严格遵守以下规则：\n1. **忠实原意：** 保留所有原始主体、动作、颜色和空间关系。除非用户明确暗示，否则不要添加新的物体、道具、角色或动物。\n2. **实用的 T2I 结构：** 编写易于模型解析的提示词。将主体与其属性及动作组合在一起。使用具体的措辞描述姿势、互动和空间布局。\n3. **风格规划过程不外显：** 在内部思考阶段确定风格、媒介、取景和光照。不要在最终输出的文本中包含规划标签或包装代码。\n4. **文本渲染：** 如果用户要求显示文字、引语、标签或排版内容，请明确指定具体文本，并将相关词汇用引号括起来。\n5. **避免过度具体化：** 除非输入内容有相关依据，否则不要凭空捏造过于具体的服装、颜色、材质或场景细节。\n6. **结构：** 在思考过程之后，撰写一个连贯的段落。不要使用项目符号、JSON 或 Markdown 格式。\n7. **尊重现有细节：** 如果用户的提示词已经很详细，只需稍加润色和定稿，无需大幅扩展——应保留其原有的措辞和意图。\n8. **尊重人物形象：** 尊严地描绘人物。默认服装覆盖生殖器及私密部位。\n9. **保留用户指定的媒介：** 如果用户明确要求某种媒介（例如“照片”、“摄影作品”、“插画”、“油画”、“素描”或“3D 渲染图”），请务必遵循。不要为了规避难度而更改媒介——应符合用户的既定意图。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 144, "type": "CR Prompt Text", "title": "生图提示词", "properties": {"widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 4}, {"outputs": [{"name": "llama_model", "links": [283], "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}], "color": "#16727c", "widgets_values": ["Huihui-Qwen3-VL-4B-Instruct-abliterated.Q8_0.gguf", "Huihui-Qwen3-VL-4B-Instruct-abliterated.mmproj-Q8_0.gguf", "Qwen3-VL", 8192, -1, 0, 0], "inputs": [{"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "mmproj"}, "name": "mmproj", "label": "mmproj", "type": "COMBO", "localized_name": "mmproj"}, {"widget": {"name": "chat_handler"}, "name": "chat_handler", "label": "chat_handler", "type": "COMBO", "localized_name": "chat_handler"}, {"widget": {"name": "n_ctx"}, "name": "n_ctx", "label": "n_ctx", "type": "INT", "localized_name": "n_ctx"}, {"widget": {"name": "vram_limit"}, "name": "vram_limit", "label": "vram_limit", "type": "INT", "localized_name": "vram_limit"}, {"widget": {"name": "image_min_tokens"}, "name": "image_min_tokens", "label": "image_min_tokens", "type": "INT", "localized_name": "image_min_tokens"}, {"widget": {"name": "image_max_tokens"}, "name": "image_max_tokens", "label": "image_max_tokens", "type": "INT", "localized_name": "image_max_tokens"}], "flags": {}, "type": "XB_llamaModelLoader", "mode": 0, "bgcolor": "#4F0074", "size": [270, 202], "pos": [-1347, -1127], "id": 134, "properties": {"widget_ue_connectable": {"image_min_tokens": true, "vram_limit": true, "mmproj": true, "model": true, "n_ctx": true, "chat_handler": true, "image_max_tokens": true}, "Node name for S&R": "XB_llamaModelLoader"}, "order": 5}, {"mode": 0, "outputs": [{"name": "prompt", "links": [289], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [-1907, -1121], "widgets_values": ["prompt# Krea 2 巨构提示词扩写规则\n\n用户输入中文关键词、自然语言或参考图后，直接输出一段 80–140 词的纯英文自然语言图像 Prompt。只输出 Prompt。\n\n先锁定用户输入的主角。它可以是建筑、巨兽、有机体、机器、自然地貌、天体或任何其他对象；整张图的巨大主体始终是它本身。题材、文化、时代和材料只改变这个主角的外形与气质，画面内其余元素都从这个主角派生。\n\n当输入只给出宽泛主体类型，先在内部收束为一个完整、可见、前后一致的主形，再设计镜头：生物先确定身体构型与体表，有机体先确定生长组织，机器先确定工作结构，自然体先确定地质或气象过程。这个主形贯穿前景和远景，文化词只参与它的形态、材料与环境。\n\n把画面设计成一个单帧的空间关系，而不是物件清单。先选一个最适合主角的地貌级关系：它压在环境上方、沿地平线延伸、从地面或云海中出现、横跨峡谷或水面、以自身的开口／肢体／缝隙框住远景，或让风、云、潮、雾沿它流动。整张图只保留这一个关系。\n\n巨构依靠一个连续、简单、可一眼读出的主形成立。镜头看见主形的一段近景证据，同时看见同一主形向远方、云层或画外延续。让主体的一部分被画框、云雾、地平线或阴影截断，使它的完整尺度留在画外。小建筑、道具与装饰只附着在这一主形上，用于说明其材料、功能或尺度。\n\n根据主角自身选择一个可识别的局部：建筑的屋面、门洞、台基或立面；生物的背脊、肢体、翼或甲壳；有机体的根、膜、孔洞或纤维；机器的舱段、梁架、轨道或关节；自然与天体的地层、浪面、环带或光幕。该局部必须和远处的巨大延续属于同一个主角。\n\n放入一个符合环境的小比例锚点。用户没有指定锚点时，优先从人、动物、树、船或飞行器中选择；用户已经给出文明设施或建筑环境时，再从普通建筑与聚落中选择。锚点贴近主角、位于其下方或被它遮挡，用于证明尺度，并保持为比例参照。\n\n文化身份进入主形的轮廓、结构与材料：中式要在巨构本身读出中式结构，北欧要在巨构本身读出北欧构造，其他题材同理。主角属于生物、有机体、机器或自然体时，文化身份落实在它自身的解剖、生长、装配、地貌、表面与环境中。纹样、雕刻、符文、管线、鳞片和植被只丰富已成立的主形。用户未指定材料时，表面从主角本身和所处环境的风化痕迹中取材。\n\n每张只安排一个光线事件：斜光擦过边缘、云隙照亮局部、风暴揭开一段、内部泄出光，或月光落在水／冰上。保留足够的天空、云海、水面、荒原或暗部，让巨大的主形与小锚点形成安静而明确的尺度关系。\n\n英文 Prompt 依次写：观看位置与镜头；主角的连续主形和唯一空间关系；近景局部与远处延续；比例锚点；文化／材料身份；光线和环境；用户指定的视觉媒介。每句话只写最终画面中能看见的内容。\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 143, "type": "CR Prompt Text", "title": "巨构提示词", "properties": {"widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 6}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [-1869.3685302734375, -574.2765502929688], "widgets_values": ["pasted/5b16a4decb4c2912f66e05f5cf346e8e7b9796791f894bfea530944145a3db09.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 150, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["孤独，大海，老人"], "inputs": [], "flags": {}, "type": "Note", "title": "巨构提示词", "mode": 0, "bgcolor": "#653", "size": [362, 88], "pos": [-1023, -446], "id": 139, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"mode": 0, "outputs": [{"name": "output", "links": [287, 288], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [400, 394], "pos": [-1043.052490234375, -1145.20068359375], "widgets_values": ["Prompt Style - Cinematic [EN]", "孤独，大海，老人", "", "one by one", 24, 256, 799390026640047, "randomize", 