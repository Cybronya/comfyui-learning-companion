ece sways delicately against a backdrop of towering tropical foliage.\n[Bottom right image]:In a wide shot, the woman stands at the edge of a lotus pond, her pastel purple silhouette reflected in the water. Distant tropical leaves frame the scene as floating petals drift around her ankles."], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 78, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 55, "type": "ShowText|pysssss", "properties": {"Node name for S&R": "ShowText|pysssss"}, "order": 63}, {"mode": 0, "outputs": [{"shape": 3, "name": "CONDITIONING", "slot_index": 0, "links": [14, 39, 111], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [307.95574951171875, 136], "pos": [1070, 10], "widgets_values": ["", "", 3.5], "inputs": [{"name": "clip", "link": 18, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "t5xxl"}, "name": "t5xxl", "link": 77, "label": "t5xxl", "type": "STRING", "localized_name": "T5XXL"}], "flags": {"collapsed": false}, "id": 18, "type": "CLIPTextEncodeFlux", "properties": {"Node name for S&R": "CLIPTextEncodeFlux"}, "order": 62}, {"mode": 0, "outputs": [{"shape": 3, "name": "MODEL", "slot_index": 0, "links": [17], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [397.0731506347656, 82], "pos": [520, 460], "widgets_values": ["flux1-dev-fp8-Kijai.safetensors", "fp8_e4m3fn"], "inputs": [], "flags": {}, "id": 10, "type": "UNETLoader", "properties": {"Node name for S&R": "UNETLoader"}, "order": 1}, {"outputs": [{"name": "IMAGE", "slot_index": 0, "links": [254], "label": "IMAGE", "type": "IMAGE"}], "color": "#2a363b", "widgets_values": ["000"], "inputs": [], "flags": {"collapsed": false}, "type": "GetNode", "title": "Get_000", "mode": 0, "bgcolor": "#3f5159", "size": [210, 58], "pos": [2716.07421875, 1752.076904296875], "id": 209, "properties": {"ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color"