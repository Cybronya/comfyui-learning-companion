lux2-vae.safetensors"}}, {"showAdvanced": true, "outputs": [{"name": "MODEL", "links": [75], "label": "MODEL", "type": "MODEL", "localized_name": "模型"}], "color": "#223", "widgets_values": ["", "22", 0, 0.5], "inputs": [{"name": "model", "link": 86, "label": "model", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "double_layers"}, "name": "double_layers", "label": "double_layers", "type": "STRING", "localized_name": "双层"}, {"widget": {"name": "single_layers"}, "name": "single_layers", "label": "single_layers", "type": "STRING", "localized_name": "单层"}, {"widget": {"name": "start_percent"}, "name": "start_percent", "label": "start_percent", "type": "FLOAT", "localized_name": "开始百分比"}, {"widget": {"name": "end_percent"}, "name": "end_percent", "label": "end_percent", "type": "FLOAT", "localized_name": "结束百分比"}], "flags": {}, "type": "SkipLayerGuidanceDiTSimple", "mode": 0, "size": [340.1543884277344, 136.75973510742188], "pos": [540, -140], "id": 38, "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "SkipLayerGuidanceDiTSimple"}, "order": 14, "widgets_values_named": {"single_layers": "22", "double_layers": "", "start_percent": 0, "end_percent": 0.5}}, {"showAdvanced": false, "outputs": [{"name": "CLIP", "slot_index": 0, "links": [53, 61], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#223", "widgets_values": ["qwen3.5_9b_bf16.safetensors", "moss_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "size": [350, 140], "pos": [540, 40], "id": 30, "properties": {"cnr_id": "comfy-core", "models": [{"name": "qwen3.5_9b_w4a8_gptq.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MOSS-Image/resolve/main/text_encoders/qwen3.5_9b_w4a8_gptq.safetensors"}], "ver": "0.42.0", "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 2, "widgets_values_named": {"clip_name": "qwen3.5_9b_bf16.safetensors", "type": "moss_image", "device": "default"}}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [56], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["@iwamushi, cel shading, 1girl, long hair, low ponytail, track jacket, expressionless, closed mouth, no blush, no racket, empty hands, character sheet\n\n9:16 竖幅人物定妆照，2×2 四格，格间没有边框也没有留白。四格里是同一个十八九岁的女高中生，造型完全一致，只换视角：上排一张正面半身近景、一张四分之三侧半身近景，下排一张全身正面、一张全身背面。四格的背景是同一块纯色底，浅奶油白，均匀平整、无渐变、无纹理、无暗角，四格完全一致；只有脚下落着一小片极淡的接触阴影。四格统一用平视机位，镜头高度固定。双手空握，手指自然弯曲、掌心朝内，手腕与手上不放任何物件。\n\n下排两格是全身，人物身高约占格高的九成，头高约为格高的十三分之二，也就是六头半身的比例。她是三人里最矮的，但只是个子小、骨架完整，肩、胯、四肢的比例仍是十八九岁，不允许画成五头身的儿童。\n\n上排两格是半身近景，约占五成五，头顶留半个额头，下缘切在锁骨下方、胸口上缘以上。\n\n五官比例写死：眼睛的高度落在头部的垂直中线上，鼻底位于眼到下巴的正中间，嘴的中线位于鼻底到下巴的正中间；颅顶到发际的距离与额头相当。眼型圆而亮但眼白不外扩，虹膜浅褐。脸偏圆，下巴短，脸颊有一点软。\n\n面部面无表情到近乎呆板：上下唇自然闭合、两端齐平，嘴角不上扬也不下压，眉毛不压不挑，眼睛睁开、视线水平看向镜头，面部肌肉放松。面颊不施红色，也没有任何高饱和的暖色块，脸部的立体只用比肤色深半度的冷调阴影交代；唇色是原肤色加深半度，不加唇彩，不泛光。\n\n渲染是赛璐璐：明暗交界清楚，只在内侧留一窄条柔化；深灰细线稿全程保留。明度高，外套的白接近纸白。光是柔和的正面偏上光，方向清楚但不硬；纯色底上没有地面反光，暗部只用冷调的第三层色块交代，人物与背景靠深灰线稿的轮廓分开。\n\n左上格是正面半身近景。她正对镜头，头不偏。眼睛圆而亮，睫毛密，眉毛顺着眼形，鼻头小，唇形厚。皮肤平涂，额头与鼻梁被光照得柔亮。深棕色长发光顺，脑后扎成低马尾，头顶戴一条白色细发带，把额前头发往后拢，露出完整的额头和耳前一小片皮肤。\n\n右上格是同一个人的四分之三侧脸半身近景。身体略转向自己的右侧，头回旋到镜头方向，近侧颊部完整可见，远侧下颌软圆，远侧耳朵露出，视线朝镜头方向但不做表情。这一格里能看到发带绕过头顶的白色细线、低马尾从颈后垂到肩前的走向，以及外套立领立起来的一小截。\n\n左下格是全身正面。她站在基线上，双脚并拢，重心老实。身形娇小：肩宽不足两个头宽，骨架小但有肉，上臂与大腿有明确的圆度，腰不明显，身高最矮但腿长仍占身高一半。上身穿长袖拉链运动外套，白色占衣身八成，墨绿只出现在肩线到袖子的一条两指宽竖条、袖口的一圈滚边与立领内侧，其余部分不出现第二种配色；拉链拉到胸口一半，拉开的部分露出里面的墨绿短袖；下身墨绿运动长裤，整条墨绿，裤侧一条白细边，裤脚收口落在脚踝上；白色球场鞋。胸口一个拇指盖大小的圆队徽，图形不可辨，点一点暖橘。\n\n右下格是全身背面，面部不可见，只写后脑、后颈与后背。白色细发带在头顶绕到后脑、被发丝压住一段；低马尾从后脑低处垂下，发尾落在肩胛之间，末端有一点内扣；颈后皮肤露出。背面与前片同色同款，只取消前襟结构，主色面积不变：外套后背整片白，肩到袖的墨绿竖条在背后继续延伸，肩胛处被顶起两道浅褶，下摆到胯部偏下；长裤后腰的松紧收出一条横向浅沟，裤脚收口在脚跟上堆出一小段。双手垂在身侧，手背朝向观众。双脚脚跟朝向观众。\n\n四格是同一个人：脸型、眼型、发带、马尾高度、外套下摆长度、拉链位置、长裤裤脚收口、鞋型完全对应。不允许某一格变成高马尾、发带消失、外套换成短款、长裤换成短裙，也不允许把整套画成小学生比例。\n\n色彩收得干净：白、墨绿、深棕，加一点暖橘，落在一块浅奶油白的纯色底上。阴影不走灰，一律偏冷偏蓝绿。材质靠块面区分：外套是柔哑的布面加一道肩线高光，拉链用一条极细的浅灰线交代、齿不逐个画；长裤的面料比外套更实、褶更少；球鞋鞋侧一块硬高光；发带是纯白、边缘利落。\n\n不做厚涂、不做写实贴图纹理、不做照片颗粒与体积光雾。画面里没有球拍、没有战术板、没有笔、没有运动包，没有手持道具；也不出现文字、号码、品牌标、色卡、部件引线、比例尺、水印或 UI 元素。"], "inputs": [{"name": "clip", "link": 53, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "size": [588.9487701448734, 590.2182934352372], "pos": [1949.4981309639552, 108.34799178998598], "id": 29, "properties": {"cnr_id": "comfy-core", "ver": "0.42.0", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 8, "widgets_values_named": {"text": "@iwamushi, cel shading, 1girl, long hair, low ponytail, track jacket, expressionless, closed mouth, no blush, no racket, empty hands, character sheet\n\n9:16 竖幅人物定妆照，2×2 四格，格间没有边框也没有留白。四格里是同一个十八九岁的女高中生，造型完全一致，只换视角：上排一张正面半身近景、一张四分之三侧半身近景，下排一张全身正面、一张全身背面。四格的背景是同一块纯色底，浅奶油白，均匀平整、无渐变、无纹理、无暗角，四格完全一致；只有脚下落着一小片极淡的接触阴影。四格统一用平视机位，镜头高度固定。双手空握，手指自然弯曲、掌心朝内，手腕与手上不放任何物件。\n\n下排两格是全身，人物身高约占格高的九成，头高约为格高的十三分之二，也就是六头半身的比例。她是三人里最矮的，但只是个子小、骨架完整，肩、胯、四肢的比例仍是十八九岁，不允许画成五头身的儿童。\n\n上排两格是半身近景，约占五成五，头顶留半个额头，下缘切在锁骨下方、胸口上缘以上。\n\n五官比例写死：眼睛的高度落在头部的垂直中线上，鼻底位于眼到下巴的正中间，嘴的中线位于鼻底到下巴的正中间；颅顶到发际的距离与额头相当。眼型圆而亮但眼白不外扩，虹膜浅褐。脸偏圆，下巴短，脸颊有一点软。\n\n面部面无表情到近乎呆板：上下唇自然闭合、两端齐平，嘴角不上扬也不下压，眉毛不压不挑，眼睛睁开、视线水平看向镜头，面部肌肉放松。面颊不施红色，也没有任何高饱和的暖色块，脸部的立体只用比肤色深半度的冷调阴影交代；唇色是原肤色加深半度，不加唇彩，不泛光。\n\n渲染是赛璐璐：明暗交界清楚，只在内侧留一窄条柔化；深灰细线稿全程保留。明度高，外套的白接近纸白。光是柔和的正面偏上光，方向清楚但不硬；纯色底上没有地面反光，暗部只用冷调的第三层色块交代，人物与背景靠深灰线稿的轮廓分开。\n\n左上格是正面半身近景。她正对镜头，头不偏。眼睛圆而亮，睫毛密，眉毛顺着眼形，鼻头小，唇形厚。皮肤平涂，额头与鼻梁被光照得柔亮。深棕色长发光顺，脑后扎成低马尾，头顶戴一条白色细发带，把额前头发往后拢，露出完整的额头和耳前一小片皮肤。\n\n右上格是同一个人的四分之三侧脸半身近景。身体略转向自己的右侧，头回旋到镜头方向，近侧颊部完整可见，远