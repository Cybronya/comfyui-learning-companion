"batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 219, "type": "EmptyLatentImage", "title": "最终生成图片宽高", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage"}, "order": 3}, {"showAdvanced": false, "outputs": [{"name": "MODEL", "links": [313], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "widgets_values": ["Flux2-Klein-9B-True-v2-int8_convrot.safetensors", "fp8_e4m3fn"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLoader", "title": "flux2大模型", "mode": 0, "size": [297.7375793457031, 82], "pos": [-1797.27099609375, -726.6597290039062], "id": 146, "properties": {"cnr_id": "comfy-core", "ver": "0.7.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 4}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [311], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [263.5846252441406, 82], "pos": [-1321.0369873046875, -675.8386840820312], "widgets_values": ["flux2 klein 9b Y-v2.0-8_000002600.safetensors", -0.36], "inputs": [{"name": "model", "link": 313, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 144, "type": "LoraLoaderModelOnly", "title": "细节面部优化（lora）", "properties": {"cnr_id": "comfy-core", "ver": "0.7.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 6}, {"mode": 0, "outputs": [{"name": "text", "links": [301], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [375.6150207519531, 492.717041015625], "pos": [-1647.5787353515625, -412.5519104003906], "widgets_values": ["【人物】：一位年方二八的绝世清冷剑仙。她并非寻常娇弱闺阁女子，而是常年隐于雪山之巅的孤高修士。眉宇间自带三分凌厉与七分出尘，气质如高山之雪，不染凡尘。\n【外貌】：眉如远山含黛，眸若寒星浸水，瞳色浅褐，眼尾微挑，唇色淡粉，似点未点，肌肤胜雪，耳垂缀一枚白玉小环，发髻高挽，鬓边斜插一支银丝缠玉步摇，流苏垂落，随呼吸轻颤。\n【穿搭】：身着月白暗纹云锦大袖衫，衣缘绣有银线勾边的寒梅纹样，外罩一层薄如蝉翼的雾灰纱披帛，随风轻扬，腰间系一条青灰丝绦，垂下两缕流苏，末端缀小玉铃，行走时声若碎雪。\n【神态】：眉目低垂，似在凝思，又似在听雪，唇角微抿，不笑不悲，眸光沉静如深潭，偶有雪花落于睫上，亦不拂去，神情中透出一种“世人皆醉我独醒”的孤绝与温柔。\n【动作】：右手轻抬，指尖微曲，似欲接一片飘落的雪花，左手自然垂落，袖口滑落，露出一截皓腕，腕间系一根褪色红绳，绳上挂一枚刻有古篆的铜铃，静默无言。\n【背景】：深冬雪夜中的古老庭院，枯枝覆雪，檐角悬挂一盏微明纸灯笼，远处隐约可见连绵雪山轮廓。\n【光影】：主光源来自檐下纸灯笼，暖黄光晕自右上方斜洒，勾勒出人物面部轮廓与衣褶层次，形成柔和的伦勃朗光效；背景雪地反射冷蓝月光，与人物的暖光形成冷暖对比，发丝与纱披帛边缘泛起微光，如霜雪凝辉。\n【色彩】：整体色调为“月白+雾灰+青灰”为主，点缀“淡粉唇色”与“暖黄灯光”，雪地泛蓝，灯笼光晕带橘，形成“冷境中一点温存”的视觉焦点，色彩饱和度极低，唯唇与灯稍显鲜活，突出人物存在感。\n【情绪】：孤寂而不哀，清冷而有情，如雪中寒梅，不争不抢，却自有风骨。情绪内敛，似有千言万语，却只化作一声轻叹，融于风雪。\n【构图】：采用对角线构图，人物从右下向左上延伸，雪枝与灯笼光带形成视觉引导线，背景雪山与庭院轮廓构成稳定三角，留白处题一竖行小楷：“雪落无声，心自有声”，字体瘦金体，墨色淡如烟。\n【景别】：中景，展现人物半身姿态。\n【视角】：低角度仰拍，略带三分俯视，突出人物清冷孤高的气质，镜头从庭院石阶向上延伸，引导视线聚焦于人物面部与肩颈线条。\n【人物比例】：黄金分割构图，人物置于画面右侧三分之一处，左侧留白以雪枝与灯笼光影平衡，人物高度占画面约60%，身形修长，肩线平直，颈项如天鹅，比例符合古典仕女画“三庭五眼、九头身”审美。\n【风格】：新中式古典写实风，融合宋代仕女画的清雅与电影级光影质感，笔触细腻，细节丰富，兼具工笔之精微与写意之空灵，整体氛围如一幅“会呼吸的古画”。"], "inputs": [{"shape": 7, "name": "prefix", "label": "prefix", "type": "STRING", "localized_name": "prefix"}, {"shape": 7, "name": "suffix", "label": "suffix", "type": "STRING", "localized_name": "suffix"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 224, "type": "TextInp