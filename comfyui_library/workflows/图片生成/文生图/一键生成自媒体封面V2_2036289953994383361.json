rder": 10}, {"outputs": [], "color": "#432", "widgets_values": ["调节画面对比度和饱和度，更有氛围一些，暗调更明显"], "inputs": [], "flags": {}, "type": "Note", "mode": 4, "bgcolor": "#653", "size": [275.6566467285156, 95.6023178100586], "pos": [-1767.244384765625, -1583.755859375], "id": 68, "properties": {"widget_ue_connectable": {}}, "order": 11}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [46], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [717.203125, 228.578125], "pos": [-3133.932861328125, -1045.26708984375], "widgets_values": ["一位年轻女性，东亚面孔，拥有深棕色中长发，发丝蓬松自然，部分发丝被风吹拂至脸颊，形成动态的飘动效果。她的眼神温柔含蓄，目光直视镜头，嘴角微扬，带着一丝恬静的微笑。她的皮肤白皙细腻，脸颊两侧有淡淡的泪痕，增添了一丝柔美与哀愁感。\n\n她身穿一件米白色丝绸旗袍，衣物质地光滑，带有细腻的丝绸光泽和柔和的褶皱。旗袍领口为中式立领，配有精致的盘扣。衣服上绣有立体感极强的粉色玫瑰花图案，花瓣层次分明，边缘带有细腻的丝线勾勒，花蕊和枝叶点缀着闪亮的水晶或珠饰，形成华丽的装饰效果。\n\n她的耳朵上佩戴着长款珍珠耳坠，耳坠由数颗大小不一的珍珠串联而成，垂坠至锁骨位置，珍珠表面光滑圆润，反射出柔和的光泽。她的右手轻柔地搭在旗袍的盘扣上，手指修长，指甲修剪整齐，呈现出自然的粉嫩色泽。\n\n背景为暖色调的模糊纹理，呈现出类似油画的质感，背景中隐约可见斑驳的光影效果，仿佛透过树叶的阳光洒落。整体画面采用柔和的暖光照明，光线从左上方照射，在她的面部和衣物上形成自然的光影过渡，突出了人物的立体感和材质的细腻纹理。\n\n画面风格为写实主义油画风格，色彩温暖柔和，构图聚焦于人物上半身，营造出一种古典、优雅且富有情感的氛围。"], "inputs": [{"name": "clip", "link": 52, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 58, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 69, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 30}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [49], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 115.328125], "pos": [-3110.5048828125, -1252.2677001953125], "widgets_values": ["Kook_Zimage_瑶光.safetensors", 1.0000000000000002], "inputs": [{"name": "model", "link": 53, "label": "model", "type": "MODEL", "localized_name"