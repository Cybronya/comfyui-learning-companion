: "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#335", "size": [315.6140441894531, 100.12346649169922], "pos": [1041.171630859375, 250.3189697265625], "id": 14, "properties": {"cnr_id": "comfy-core", "ver": "0.16.3", "ue_properties": {"widget_ue_connectable": {"lora_name": true, "strength_model": true}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 17}, {"mode": 0, "outputs": [{"name": "STRING", "links": [78], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [667.27685546875, 280.8706970214844], "pos": [372.01708984375, 509.2493896484375], "widgets_values": ["夜色中的宫墙夹道狭长逼仄，两侧红墙被雨水浸得发暗，一位穿黛紫色宫装的贵女站在画面近处，手中提着一盏快要熄灭的宫灯，脸型偏长，眉眼清冷，唇色淡而克制，发髻上只插一支冷玉簪；画面远处，一位穿玄色朝服的年轻权臣停在宫门阴影里，手里握着一枚碎裂的玉佩。镜头从低处贴近湿润青砖拍过去，宫灯、水光、长墙形成压迫感，她没有看他，只看灯火即将熄灭的芯，他却看着她，氛围像一场被权力和旧情压住的深宫重逢。\n清晨的湖心亭被白雾包围，一位穿浅碧色纱裙的少女坐在亭边栏杆上，脚边是一只小竹篮，发间系着青色丝带，脸型短圆，眼睛明亮，神情灵动；亭外木桥上站着一位穿月白长袍的少年书生，手里拿着一卷被雾气打湿的诗稿，清俊克制。镜头从湖面水草之间斜拍，前景有虚化荷叶和水面倒影，她偏头看向他，像刚故意问了一个难答的问题，他低头看诗稿却忍不住笑，画面轻、亮、有春水般的暧昧感。\n古战场夜营，帐外火把摇晃，风卷起黄沙和残旗，一位穿深红骑装的女将坐在木案边擦拭短刀，浓眉，方圆脸，眼神锋利，嘴唇抿紧，气质英气而压迫；帐门外，一位穿灰白文士袍的年轻谋士掀帘而入，手里拿着军报，脸色苍白但眼神很稳。镜头从木案低处拍，前景是刀锋、酒盏和摇动火光，她没有抬头，只问了一句似乎早已知道答案的话，他站在阴影里看她，整体有战前密谋的紧张和暗涌。\n月下花楼的二层回廊，一位穿孔雀蓝舞衣的舞姬倚在雕花栏杆旁，肩披半透明披帛，发间金铃轻垂，脸型心形，眼尾微挑，妆容明艳却不媚俗；楼下巷口站着一位穿黑色劲装的年轻捕快，腰间佩刀，眉眼冷峻，像追查到了不该追查的地方。镜头从楼下仰拍，花楼灯笼、木栏、飞檐形成层次，她低头看他，唇边带一点似笑非笑，他抬头看她却不动声色，氛围危险、暧昧、像一场互相试探。\n冬日书院，窗外细雪落在青瓦上，一位穿灰蓝长袄的清冷女子坐在窗边抄书，脸型椭圆，眉眼柔长，气质温静，指尖按着一页没有写完的信；门外站着一位披深青斗篷的故人，肩头落雪，手里握着一把旧油纸伞。镜头从书案后方过肩拍她，前景是砚台、信纸和烛火，她不回头，只停下笔，他站在门口也没有进来，两人之间隔着一道门槛和满室安静，画面细腻、克制、像久别重逢前的一秒。\n大漠月夜，驿站外的风沙被篝火照成金红色，一位穿白色胡服的异域贵女坐在马车边，头戴银饰额链，五官立体，眼窝深，唇形饱满，手里慢慢拨弄一串银铃；对面木桩旁，一位穿黑袍的年轻游侠正替自己的马解鞍，侧脸锋利，神色淡漠。镜头用横向宽幅构图，把两人分置画面两端，中间隔着火堆和流动风沙，她看向他的剑，他看向她手里的银铃，氛围松弛却暗藏江湖试探。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 51, "type": "TextInput_", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInput_"}, "order": 5}, {"mode": 0, "outputs": [{"name": "width", "links": [98], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [99], "label": "height", "type": "INT", "localized_name": "height"}], "size": [340.27337646484375, 196.73251342773438], "pos": [1098.3953857421875, 619.902587890625], "widgets_values": [false, "1920x1080 (16:9) (横屏)", 1024, 1024], "inputs": [{"widget": {"name": "use_custom_resolution"}, "name": "use_custom_resolution", "label": "use_custom_resolution", "type": "BOOLEAN", "localized_name": "use_custom_resolution"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "custom_width"}, "name": "custom_width", "label": "custom_width", "type": "INT", "localized_name": "custom_width"}, {"widget": {"name": "custom_height"}, "name": "custom_height", "label": "custom_height", "type": "INT", "localized_name": "custom_height"}], "flags": {}, "id": 60, "type": "TTResolutionSelector", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TTResolutionSelector"}, "order": 6}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [29], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [328.5579528808594, 106], "pos": [1097.33935546875, 453.73358154296875], "widgets_values": [1920, 1080, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 98, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 99, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size"