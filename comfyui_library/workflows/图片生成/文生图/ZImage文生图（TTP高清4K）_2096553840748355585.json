ype": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["这是一张竖幅近景人像照片，采用平视略微仰拍的视角，正面，视线望向斜上方，构图上以蓝天与远山作为背景留白，层次舒展自然。画面主体是一位年轻女孩，留着蓬松的双马尾，用浅米色丝带绑发，齐刘海搭配清透妆容，笑容温柔干净，身着藏蓝撞色吊带与军绿色工装裤，手腕佩戴深色串珠手链，细节充满元气少女感。场景设定在户外山野间，澄澈的蓝天与远处的层叠山峦构成背景，前景隐约可见绿植，清新自然的环境烘托出松弛氛围。光影为明亮的户外自然光，柔和的侧逆光勾勒出发丝与肩颈轮廓，光线均匀通透，曝光适中，既保留了皮肤的细腻质感，也让衣物的纹理清晰呈现。整体色调清新明快，以蓝天的浅蓝、发丝的深棕、衣物的藏蓝与军绿为主，搭配清透的肤色，风格偏向日系清新户外人像，兼具胶片感与自然灵气，传递出青春明媚、松弛自由的美学气质。"], "inputs": [{"name": "clip", "link": 135, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [419.73150634765625, 318.3890075683594], "pos": [1663.8980712890625, 468.4508056640625], "id": 7, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 10}, {"outputs": [{"name": "LATENT", "links": [9], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#1479c7", "widgets_values": [1024, 1536, 4], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "type": "EmptyLatentImage", "mode": 0, "bgcolor": "#0065b3", "size": [270, 106], "pos": [1733.0946044921875, 945.8402099609375], "id": 5, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 8}, {"outputs": [{"name": "MODEL", "links": [180], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#332922", "widget