: "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"multiline_text": true}, "Node name for S&R": "CR Prompt List"}, "order": 21}, {"mode": 0, "outputs": [{"name": "STRING", "links": [64], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 200], "pos": [2952.322998046875, -900.6715698242188], "widgets_values": ["", "去空行"], "inputs": [{"widget": {"name": "input_string"}, "name": "input_string", "link": 63, "label": "input_string", "type": "STRING", "localized_name": "input_string"}, {"widget": {"name": "option"}, "name": "option", "label": "option", "type": "COMBO", "localized_name": "option"}], "flags": {"collapsed": true}, "id": 57, "type": "ProcessString", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ProcessString"}, "order": 19}, {"outputs": [{"name": "STRING", "slot_index": 0, "links": [63], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#346434", "widgets_values": ["一位年轻女性摄影师站在雨后的城市街角，手持复古胶片相机，身穿米色风衣与深色围巾，地面有积水反射霓虹灯光，背景是略微虚化的东京夜晚街道，路灯在湿润空气中散发柔和光晕，空气中有轻微雾气，浅景深，人物居中偏下构图，整体电影感、真实摄影风格，35mm镜头质感，细节清晰。\n\n一位年长工匠在昏暗的铁匠铺中锻造刀具，火星四溅，橙红色炉火照亮他布满皱纹的脸与粗糙双手，铁锤击打金属瞬间产生高频火花，背景堆满旧工具与木质架子，空气中有烟尘漂浮，强烈明暗对比与体积光效果，金属高反光细节清晰，整体具有油画般的真实摄影质感。\n\n黄昏时分的山间小镇，一列老式列车从山谷铁桥缓缓驶过，桥下是河流与森林，远处群山被夕阳染成金色与紫色渐变，天空云层厚重但有光束穿透，画面具有清晰的远中近三层空间结构，列车成为视觉引导线，整体史诗感、宁静、真实风景摄影风格。\n\n一间旧书店的内部场景，空间狭窄但高度很高，书架延伸至二层阁楼，一位穿深色毛衣的男子站在梯子上整理书籍，窗外阳光斜射进来形成体积光，空气中漂浮灰尘颗粒，书籍封面细节丰富且略有磨损，镜头轻微仰拍增强空间压迫感与沉浸感，真实摄影风格。\n\n一个繁忙的地中海集市清晨场景，多位摊主正在整理水果、香料与布料，顾客在狭窄街道中穿行，画面人物数量较多但层次清晰，不同摊位色彩丰富（橙色柑橘、紫色香料、蓝色布匹），阳光从建筑间隙洒落形成斑驳光影，动态感强但画面秩序稳定，纪录片式真实摄影风格。\n\n暴风雨即将来临的海岸悬崖，一名冲浪者站在岩石边缘准备入海，远处巨浪正在形成白色泡沫墙体，天空乌云翻滚并呈现强烈层次结构，海风吹动衣物与头发，浪花细节清晰，水与空气交界充满动势与张力，自然纪实摄影风格。\n\n夜晚现代地铁车厢内部，一节几乎空无一人的车厢中乘客分散坐着，车窗反射城市霓虹灯形成多层叠影，顶部冷白灯与窗外暖色城市灯光形成冷暖对比，地面轻微反光，人物表情安静克制，空间透视强烈，强调反射与叠加视觉结构，电影级真实感。\n\n雨夜公交站，一位外卖骑手坐在长椅上短暂休息，头盔放在一旁，手机屏幕微光照亮脸部，背景是模糊车灯与雨幕，雨滴在路灯下形成光丝，整体情绪偏孤独但真实克制，强调城市夜晚生活质感与细腻情绪表达，浅景深纪录摄影风格。\n\n冬季火车站离别场景：前景是一对拥抱的情侣，中景是检票口人群流动，背景是一列即将启动的列车，玻璃上有雾气与手写痕迹，站内灯光温暖而窗外是冷蓝色雪景，同时存在多个叙事焦点但画面秩序清晰，电影级复杂构图与空间层次表达。\n\n黎明时分的古罗马遗迹广场，一场小型露天交响乐演出正在进行，前景是演奏小提琴的音乐家，中景是观众与石柱廊道，背景为半坍塌古建筑与初升太阳光束穿透云层，空气中有薄雾与体积光，石材纹理与乐器反光细节极高，兼具宏大空间感与人物情绪的电影级真实摄影风格。\n"], "inputs": [{"widget": {"name": "string"}, "name": "string", "label": "string", "type": "STRING", "localized_name": "string"}], "flags": {"pinned": false}, "type": "String Literal", "title": "提示词 一行一个", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [515.4217529296875, 171.86424255371094], "pos": [2383.469970703125, -841.7136840820312], "id": 2, "properties": {"cnr_id": "image-saver", "ver": "65e6903eff274a50f8b5cd768f0f96baf37baea1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"string": true}, "Node name for S&R": "String Literal"}, "order": 14}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.45.19", "VHS_latentpreview": false, "ds": {"offset": [-2663.4446788632017, 1285.5019236145679], "scale": 0.8769226950000395}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "zimage-turbo", "bounding": [3210, -950, 679.60546875, 735.8544311523438]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "krea2_turbo", "bounding": [3205.697509765625, -189.18565368652344, 750.8412475585938, 621.9105224609375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "boogu", "bounding": [3197.731689453125, 450.69610595703125, 956.20751953125, 603.3057861328125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "反推", "bounding": [-142.99853515625, -902.3898315429688, 2150, 920]}, {"color": "#cf2a2a", "font_size": 24, "flags": {}, "id": 5, "title": "用户输入区", "bounding": [2373.469970703125, -915.3