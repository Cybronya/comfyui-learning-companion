et": 80, "Node name for S&R": "SaveImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 19}, {"outputs": [{"name": "STRING", "links": [112, 111], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["一张9:16竖版时尚杂志封面风的商业棚拍照片，极简浅灰白无缝背景，整体干净明亮，高调画面配合左上方强烈硬质影棚光或直打闪光，人物、椅子和道具在背景与地面上投出清晰锐利的阴影，顶部横跨整张画面的超大黑色粗体无衬线英文标题“VIMAGE”，右上角为黑色英文杂志文案排版“NEW HI-TECH BEAUTY SOLUTIONS 88 FOR SKIN, HAIR, AND BODY”，其中“88”字号很大、数字醒目，整体具有高级时尚编辑封面设计感；画面中央偏下是一位年轻女性，肤色冷白细腻，银白偏铂金的长卷发，发量蓬松，做成双高马尾并垂下大波浪卷，脸部朝向右上方，视线望向画外，嘴巴张开呈惊喜又俏皮的笑意，神情活泼灵动；她穿鲜红色复古运动风短袖紧身短上衣，袖子有两道白色条纹，搭配同色系超短运动短裤，侧边也有白色条纹与小徽章细节，颈部缠绕红白蓝三色运动围巾，手腕戴红色护腕并有白色字样，白色中筒袜，脚穿一双非常亮眼的高饱和钴蓝色高帮系带厚底工装靴/马丁靴，鞋面和鞋带细节清晰；人物坐在画面正中的复古奶油白色金属可口可乐冰箱/冷藏箱上，箱盖是亮红色，正面印有大面积红色手写体“Drink Coca-Cola Refreshing”字样，带金属提手与边角，箱体略带搪瓷复古质感；她的姿势张力很强，双腿大幅分开，左腿向左前方伸展落地，左脚蓝靴踩在地面前景，右腿向右上方弯曲抬起，右脚蓝靴踩在红色箱盖边缘，形成夸张的时尚姿态，双手压在两腿之间的箱盖上，手指纤长，美甲明显；人物身后左右各有一张深海军蓝接近黑色的亮面塑料椅，带金属支架，椅面有明显高光反射，像候车椅一样对称分布，增强空间层次；前景地面散落数本杂志和白色印刷纸张，右下角纸页有局部黑色英文，左下角杂志封面露出人物照片，营造随性拍摄现场感；整体风格是时尚大片、杂志封面、Y2K运动甜酷美学、干净高对比、红蓝撞色极强、锐利清晰、商业摄影质感、略低机位全身构图、50mm左右自然透视、细节丰富、不要多余人物、不要背景杂物过多、不要文字乱码、不要手部畸形、不要服装结构错误。 \n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "String (Multiline - Prompt)", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [-791.3192138671875, -235.15768432617188], "id": 98, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}, {"outputs": [{"name": "LATENT", "links": [107], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "color": "#232", "widgets_values": [