p"}], "size": [412.87396240234375, 384.24322509765625], "pos": [382.32098388671875, 460.93377685546875], "widgets_values": ["都市夜景风写真\n\n一位身着黑色丝绒吊带长裙的女性，肌肤白皙通透，眼妆以深棕与银灰渐变晕染，眼尾点缀细碎星闪，唇色为冷调暗红；长发微卷，一侧随意垂落肩头，发间别着一枚小巧的珍珠发卡。\n\n场景选在城市天台，背景是鳞次栉比的摩天大楼，玻璃幕墙反射着万家灯火与霓虹招牌，远处跨江大桥的灯带如流光般延伸；构图采用三分法，人物站在天台边缘，侧身望向远方，裙摆被晚风微微吹动，脚下散落着一盏复古煤油灯。\n\n光影以城市夜景的散射光为主，远处暖黄的窗灯与冷蓝的霓虹形成撞色，煤油灯的暖光在人物侧脸投下柔和光斑，整体色调偏暗却不失层次，营造静谧又带点疏离的氛围；画面质感细腻，保留夜景的自然颗粒感，高光处的灯火有轻微的弥散效果。\n\n使用索尼A7S III搭配索尼G大师24-70mm F2.8镜头拍摄，开启高感降噪模式，模拟夜景胶片的色彩风格，输出1080P高清影像，确保暗部细节清晰同时保留高光的氛围感。", false, "'", false, "", false], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}, {"widget": {"name": "convert_from_csv"}, "name": "convert_from_csv", "type": "BOOLEAN", "localized_name": "使用CSV"}, {"widget": {"name": "csv_quote_char"}, "name": "csv_quote_char", "type": "STRING", "localized_name": "CSV引用符"}, {"widget": {"name": "remove_chars"}, "name": "remove_chars", "type": "BOOLEAN", "localized_name": "移除字段"}, {"widget": {"name": "chars_to_remove"}, "name": "chars_to_remove", "type": "STRING", "localized_name": "移除内容"}, {"widget": {"name": "split_string"}, "name": "split_string", "type": "BOOLEAN", "localized_name": "分离字符串"}], "flags": {}, "id": 32, "type": "CR Multiline Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Multiline Text"}, "order": 3}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [406.6656799316406, 357.2518005371094], "pos": [369.394775390625, -16.49614715576172], "widgets_values": [], "inputs": [{"name": "text", "link": 15, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 17, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "aac13aa7ce35b07d43633c3bbe654a38c00d74f5", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pys