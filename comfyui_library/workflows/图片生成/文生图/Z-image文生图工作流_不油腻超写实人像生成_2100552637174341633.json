d": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 23}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#232", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 52, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#353", "size": [787.0238037109375, 922.5494995117188], "pos": [1031.722900390625, 0], "id": 3, "properties": {"cnr_id": "comfy-core", "ver": "0.27.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 34}, {"outputs": [{"name": "CONDITIONING", "links": [38, 44], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["风景空镜摄影。竖幅构图，中远景，机位平视，距主体约二十米，使用50mm标准镜头，焦平面完全覆盖前景与天空，无透视畸变。三分法构图，地平线置于画面底端约四分之一处，树与屋作为视觉锚点位于画面左下方与右下方，天空占据上方四分之三，那朵孤云被精确置于画面中上部约三分之一处的黄金分割点附近，视线由下方地面落叶自然向上引导至云朵，形成从地面到天空的纵向视觉动线。主体为一棵落叶乔木与一座白色小屋。树干粗壮，深褐色树皮，树冠呈半圆形，叶片稀疏，呈现秋季的橙黄、焦糖与锈红色，部分枝条已裸露。小屋为单层平房，白灰墙面，表面有轻微风化与斑驳的痕迹，屋顶为深棕色茅草，厚实且纹理清晰，屋正面开有一扇深蓝色木门与一扇深蓝色小窗，门窗均为闭合状态。树与屋并排而立，树冠的右侧边缘恰好与小屋屋顶的左侧边缘相接，两者间距约两米，形成一种相互依偎的亲密关系。地面为干燥的浅褐色沙土地，表面粗糙，散落着大量与树冠同色的枯黄落叶，落叶的分布密度从树干底部向外围逐渐递减。前景为近处的地面沙土与落叶，质感细腻；中景为树与屋的主体组合，细节丰富；背景为纯净无云的深蓝色天空，仅在画面中上部有一朵孤立的白色积云，云朵边缘柔和，呈絮状。主光为强烈的直射阳光，来自画面左上方，光比中等，在树冠右侧与小屋右侧投下清晰的深色阴影，阴影轮廓锐利，强调了物体的立体感。色彩以天空的深蓝色为基调，与树冠的橙黄色形成鲜明的冷暖对比，小屋的白色墙面与深蓝色门窗作为中性过渡，整体色调干净、通透，饱和度较高，但不过分艳丽。美学风格为极简主义风景摄影，带有明显的胶片质感，画面干净利落，色彩饱和度高但层次丰富，光影对比强烈，呈现出一种宁静、荒凉而又充满诗意的孤独感。材质上，天空具有细腻的胶片颗粒感，沙土地与落叶呈现出真实的粗糙质感，茅草屋顶的纹理清晰可见，白墙的粉刷质感与风化痕迹真实可感。8k分辨率，细腻的胶片颗粒，高动态范围，色彩层次丰富，印刷级精度，画面锐利且通透，无任何文字或水印。"], "inputs": [{"name": "clip", "link": 43, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [561.722900390625, 913.4420166015625], "pos": [370, 0], "id": 14, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 12}, {"outputs": [{"name": "MODEL", "links": [30], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#323", "widgets_values": ["REDZ15_DetailDaemonZ_lora_v1.1.safetensors", -0.8], "inputs": [{"name": "model", "link": 42, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {"collapsed": false}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#535", "size": [345.54217529296875, 82.0355224609375], "pos": [1383.74267578125, 1042.549560546875], "id": 13, "properties": {"cnr_id": "comfy-core", "ver": "0.7.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 19}, {"outputs": [{"name": "VAE", "links": [32], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "color": "#323", "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "v