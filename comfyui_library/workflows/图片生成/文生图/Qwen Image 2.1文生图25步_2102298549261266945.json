隐约山水暗纹；画面右侧是逆光下朦胧的柳丝竹影。\n\n暖金色侧逆光从右后方打来，在发丝边缘、肩头轮廓与薄纱披帛上勾勒出明亮金边；人物正面有柔和暖补光，面部受光匀净；前景牡丹被逆光打透成橙红透亮，空气中有极淡光雾。整体为琥珀橙金暖调，红衣金线与石青裙形成浓郁而克制的对比。\n\n风格融合唐代工笔重彩与电影级写实3D：丝绸金线的光泽、薄纱的透光感、牡丹花瓣的柔嫩质感都要真实；保留自然皮肤纹理，不塑料不磨皮。焦点落在女子回眸的面部，前景牡丹与背景人物、鹦鹉全部柔和虚化。不要水印，不要现代元素，不要网红脸。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "Text Multiline", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [770, 350], "pos": [409.04742431640625, 27.896221160888672], "id": 486, "properties": {"cnr_id": "was-ns", "ver": "44de705818d4663fefefde57ffe0ea5a9ea39df4", "widget_ue_connectable": {"text": true}, "Node name for S&R": "Text Multiline"}, "order": 11}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.53.6", "VHS_latentpreview": false, "ds": {"offset": [-56.25416409649634, -63.75709833825208], "scale": 0.7247295000000034}}, "groups": [{"color": "#4a7c4a", "font_size": 24, "flags": {}, "id": 1, "title": "图片视频输入类 (1)", "bounding": [-30, -45, 360, 210]}, {"color": "#4a7c4a", "font_size": 24, "flags": {}, "id": 2, "title": "文字输入类 (1)", "bounding": [370, -45, 830, 440]}, {"color": "#4a7c4a", "font_size": 24, "flags": {}, "id": 3, "title": "输出类 (1)", "bounding": [1240, -45, 527.3150024414062, 670.25634765625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "处理类 (8)", "bounding": [-30, 655.25634765625, 2770, 570]}], "links": [[747, 493, 0, 494, 1, "CONDITIONING"], [748, 493, 1, 494, 2, "CONDITIONING"], [750, 489, 0, 494, 4, "INT"], [751, 494, 0, 495, 0, "LATENT"], [752, 492, 0, 495, 1, "VAE"], [768, 490, 0, 494, 0, "MODEL"], [744, 491, 0, 493, 0, "CLIP"], [745, 486, 0, 493, 3, "STRING"], [770, 502, 0, 494, 3, "LATENT"], [776, 507, 0, 502, 0, "INT"], [777, 507, 1, 502, 1, "INT"], [778, 495, 0, 508, 0, "IMAGE"], [779, 511, 0, 512, 0, "M