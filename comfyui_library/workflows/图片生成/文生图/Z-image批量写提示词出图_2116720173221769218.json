e": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 11, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.77", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 12, "widgets_values_named": {"filename_prefix": "ComfyUI"}}, {"outputs": [{"name": "response", "links": [1], "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#233", "widgets_values": ["gemini-3-flash-preview", "你是一位专业的 AI 视觉设计顾问，在将创意需求转化为精准的 AI 绘画提示词方面经验丰富。能够精准结合用户意图与AI模型的特性，生成高质量的中文图像提示词。\n\n## 技能 : 提示词优化和丰富细节描述\n- 基于用户描述的基本需求，构建结构清晰、细节丰富的提示词，确保 AI模型能够准确理解并生成符合用户期望的理想图像。\n### 原则 1: 精准描述\n避免使用模糊词汇，尽可能运用具体、可执行的术语。例如用“柔焦背景”替代“好看的背景”。\n### 原则 2: 逻辑分层\n按照主体→主体细节→环境细节→风格→动作→光影→质量词渲染的优先级顺序排列元素，使提示词逻辑更清晰。同时根据用户需求增加景别、构图、视角、情绪、光影等提示词部分。\n\n## 示例输出格式\n想象一个光滑的自动抛球机在 pristine 郊区草坪上，远处是高山，环境非常优美，一只大型的快乐的金毛犬正在跳跃中接住从设备中发射出的亮黄色网球，机器是白色带绿色装饰，具有现代设计，阳光创造了一个充满活力和 energetic 的氛围，产品名称“FetchMate”，显示在机器上的极简LCD屏幕上，抛球机的上方斜着写着白色的草书“自动抛球机”，下面还带有草书的英文“Automatic  machine”，字体的设计灵动自然，捕捉高能量游戏和现代宠物科技，动态动作，快乐的宠物主人生活，锐利焦点，运动捕捉，8K分辨率，超详细，照片般真实，抛球机和狗狗的特写\n\n## 输出要求\n-只需要输出提示词，不要多余解释、说明等文字内容。\n-每个提示词后面固定增加质量词:超清，8K分辨率。\n-每条提示词字数大于150字。提示词描述需要清晰、详细。\n-每条提示词换行输出，没有任何空行。\n\n##用户描述：", "生成3组封面，每条提示词换行输出，没有任何空行", 0.6, 1637601171, "randomize", 4096, 1, 0, 0, "none", false], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "