alized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 76, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 4}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#232", "widgets_values": ["一位优雅的中国奶奶模特，商业写实摄影风格，顶着一头蓬松的灰白短发，发丝自然且有层次感，面容饱满，眼角略带岁月的细纹，神情从容淡定，散发出成熟的魅力。她身着一件深紫色仿皮草外套，外套表面具有立体麻花编织的纹理，高领翻领与衣身一体，领口点缀着金属圆形纽扣，长袖收口设计精致，廓形修身，整体面料柔软绒感，质地饱满温暖，内搭一件米白色高领针织衫，针织纹理清晰，增添柔和感，下身穿着黑色修身长裤，剪裁得体，拉长腿部线条，脚踩一双深棕色皮质短靴。颈间佩戴一串单颗粒的珍珠项链，珍珠光泽柔和，与整体造型相得益彰，尽显高贵优雅。\n\n她保持着专业模特的站姿，身体微微侧转，头部轻轻抬起，目光平和而坚定，双手自然交叠于腹前，展现出沉着稳重的气质。在宽敞明亮的中国风室内场景中，阳光透过纯白色轻薄的窗帘洒入室内，窗帘垂直而柔和地悬挂，透光性极佳，营造出温暖的光影氛围。房间铺着光滑的深色木质地板，背景是一面带有几何图案镂空设计的深棕色木质推拉门，展现传统中式风格。旁边是一扇落地窗，窗外的光线让整个空间显得更加通透。\n\n中景处，一棵造型优美的梅花盆栽被精心摆放，枝干自然弯曲，姿态疏朗，红色与黄色点缀的梅花增添一抹生机。盆栽旁边放置了一把深棕色中式风格的木质靠背椅，椅面上搭配着一个简约的白色靠垫，显得舒适而雅致。靠背椅旁是一张小巧的圆形茶几，茶几上摆放了一只青绿色的陶瓷花瓶，内插几枝黄色的花朵，与梅花盆栽的色彩形成和谐对比。\n\n前景左侧光线充足，温暖的阳光在深色地板上形成斑驳的光影效果。右侧墙面上悬挂着一幅深棕色木质画框的中式水墨画，画中以黑色书法题字和红色印章为主，散发着浓厚的文化气息。画框下是一张小型深棕色木质柜子，柜面上摆放着另一个青绿色陶瓷花瓶，与茶几上的花瓶相互呼应，内插几枝清新的黄色花卉。整体空间色调以深棕色为主，辅以青绿色、白色和红色点缀，构图平衡而优雅，展现了中国风的细腻与高贵。"], "inputs": [{"shape": 7, "name": "anything", "link": 124, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#353", "size": [405.2429504394531, 322.81829833984375], "pos": [1503.248291015625, -871.0521240234375], "id": 49, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 23}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [298.1286926269531, 362.0235595703125], "pos": [-529.2308959960938, -162.39483642578125], "widgets_values": ["中国风室内场景，宽敞明亮的房间，铺着光滑的深色木质地板，阳光透过窗帘洒入室内，形成柔和的光影效果。背景是一面带有几何图案镂空设计的木质推拉门，门框呈深棕色，镂空图案呈现传统中式风格。旁边是一扇落地窗，窗帘为纯白色轻薄材质，垂直悬挂，透光性良好，增强空间的通透感。\n\n中景中摆放着一棵造型优美的梅花盆栽，枝干呈自然曲折形态，花朵点缀着红色和黄色的细节，充满生机。梅花盆栽旁边是一张深棕色木质靠背椅，椅子设计简约，具有中式风格，座椅上放置了一个白色的靠垫，增添舒适感。靠背椅旁边是一张小巧圆形茶几，茶几上摆放着一个青绿色陶瓷花瓶，花瓶内插着几枝黄色花朵，与梅花形成色彩上的对比。\n\n前景中左侧光线充足，形成温暖的阳光斑驳。右侧墙面上挂着一幅中式水墨画，画框为深棕色木质材质，画面上有黑色书法题字和印章，整体风格典雅。水墨画下方是一张小型深棕色木质柜子，柜面上摆放着一个青绿色陶瓷花瓶，与茶几上的花瓶相呼应，内部未见摆件。\n\n整体色调以深棕色为主，搭配青绿色、白色和红色点缀，构图平衡简约，空间布局和谐，体现了中国风的优雅与细腻。"], "inputs": [{"name": "text", "link": 114, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 81, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 15}, {"outputs": [{"name": "IMAGE", "slot_index": 0, "links": [126], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "rgba(0,0,0,.8)", "widgets_values": [2, 90992264604691, "randomize", 12, 1, "res_2s", "bong_tangent", 0.2, "Linear", 512, 512, 8, 64, "None", 1, 64, 8, 16, true, true], "inputs": [{"name": "image", "link": 100, "label": "图像", "type": "IMAGE", "localized_name": "image"}, {"name": "model", "link": 102, "label": "模型", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 103, "label": "正面条件", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 104, "label": "负面条件", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "vae", "link": 105, "label": "VAE", "type": "VAE", "localized_name": "vae"}, {"name": "upscale_model", "link": 96, "label": "放大模型", "type": "UPSCALE_MODEL", "localized_name": "upscale_model"}, {"widget": {"name": "upscale_by"}, "name": "upscale_by", "label": "upscale_by", "type": "FLOAT", "localized_name": "放大系数"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "t