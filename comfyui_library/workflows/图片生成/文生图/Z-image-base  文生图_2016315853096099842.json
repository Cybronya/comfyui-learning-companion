G", "localized_name": "正面条件"}, {"name": "negative", "link": 83, "label": "负面条件", "type": "CONDITIONING", "localized_name": "负面条件"}, {"name": "latent_image", "link": 77, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "type": "COMBO", "localized_name": "调度器"}, {"widget": {"name": "denoise"}, "name": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {}, "id": 69, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.64", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "KSampler", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 9}, {"outputs": [{"name": "text", "links": [], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["专业商业人像摄影，极致光影塑造，8K超高清极致细节，皮肤纹理细腻通透且带自然原生光泽，毛孔与肌肤质感真实还原，特写构图，平视平视镜头，画面聚焦人物面部与上半身情绪表达。画面主体是一位面容清冷又自带少年感的年轻东亚女性，身处温馨明亮的机场候机厅/现代简约公共建筑内，正抬手自拍，神情平静专注，清亮的眼眸直凝视相机镜头，情绪内敛又有张力。她留着深棕色柔顺长直发，头戴黑色针织冷帽，帽身带有清晰的耐克白色经典logo，宽大的白色连帽羽绒服兜帽自然拉起罩在头部，冷帽与兜帽层次叠加，打造酷飒随性的冬日潮流氛围感；白皙透亮的肌肤搭配红润显气色的唇彩，冷暖对比更衬五官精致；白色羽绒服左胸处有隐约可见的黑色耐克经典logo刺绣，低调有细节，内搭黑色衬衫边缘微露，黑白撞色简约高级，穿搭质感拉满。背景为明亮开阔的现代室内空间，高耸的白色立柱搭配方形网格结构的透光天顶，柔和自然光透过天顶漫洒，背景呈现淡雅冷色调，光影均匀不刺眼，无生硬阴影，整体画面色调沉稳高级，低饱和冷调为主，精准捕捉现代都市女性简约利落、慵懒又高级的穿搭美学，背景轻微虚化突出主体，画面兼具纪实感与时尚人像大片的大气精致感。\n\n\n特写镜头，平视视角，精准捕捉一位兼具清冷气质与少年感的年轻东亚女性在冬日公共空间中的自拍瞬间。她身处一座明亮开阔的现代机场候机厅（或类似高挑通透的公共建筑），背景可见高耸的纯白立柱与极具建筑美感的网格状透光天顶——柔和的自然漫射光从上方倾泻而下，在地面投下细腻的几何光斑，整体环境呈现出淡雅、克制的冷灰白色调，营造出静谧而高级的空间氛围。 人物面容白皙细腻，肌肤纹理清晰可见，泛着健康自然的微光；眉眼清亮，眼神平静而专注，直视镜头，流露出一种内敛的自信。唇部轻点红润唇彩，在冷色调环境中形成恰到好处的视觉焦点。她留着深棕色长直发，发丝柔顺垂落肩前，头戴一顶黑色针织冷帽，帽檐正中缀有醒目的耐克白色Swoosh标志，为整体造型注入街头潮流基因。 她身披一件宽大蓬松的白色连帽羽绒服，兜帽高高拉起，完全罩住头部，仅露出面部，形成强烈的轮廓包裹感，既保暖又极具造型张力。羽绒服左胸处隐约可见精致的黑色品牌刺绣标识，内搭为简约黑色衬衫，领口微露，与冷帽和唇色形成微妙的色彩呼应。整体穿搭融合了功能性、极简主义与冬日街头美学，展现出当代都市女性随性却不失格调的穿衣哲学。 画面光线均匀柔和，无强烈阴影，突出材质肌理与人物神态；色调沉稳克制，以白、黑、灰为主，辅以唇彩的一抹暖红，平衡冷感与温度。整幅作品精准传达出“酷飒、松弛、高级”的冬日都市女性形象，兼具纪实感与时尚叙事性。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [399.5916748046875, 463.7974853515625], "pos": [467.2944641113281, 473.3797607421875], "id": 77, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 5}, {"outputs": [{"name": "CONDITIONING", "links": [75], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["专业商业人像摄影，极致光影塑造，8K超高清极致细节，皮肤纹理细腻通透且带自然原生光泽，毛孔与肌肤质感真实还原，特写构图，平视平视镜头，画面聚焦人物面部与上半身情绪表达。画面主体是一位面容清冷又自带少年感的年轻东亚女性，身处温馨明亮的机场候机厅/现代简约公共建筑内，正抬手自拍，神情平静专注，清亮的眼眸直凝视相机镜头，情绪内敛又有张力。她留着深棕色柔顺长直发，头戴黑色针织冷帽，帽身带有清晰的耐克白色经典logo，宽大的白色连帽羽绒服兜帽自然拉起罩在头部，冷帽与兜帽层次叠加，打造酷飒随性的冬日潮流氛围感；白皙透亮的肌肤搭配红润显气色的唇彩，冷暖对比更衬五官精致；白色羽绒服左胸处有隐约可见的黑色耐克经典logo刺绣，低调有细节，内搭黑色衬衫边缘微露，黑白撞色简约高级，穿搭质感拉满。背景为明亮开阔的现代室内空间，高耸的白色立柱搭配方形网格结构的透光天顶，柔和自然光透过天顶漫洒，背景呈现淡雅冷色调，光影均匀不刺眼，无生硬阴影，整体画面色调沉稳高级，低饱和冷调为主，精准捕捉现代都市女性简约利落、慵懒又高级的穿搭美学，背景轻微虚化突出主体，画面兼具纪实感与时尚人像大片的大气精致感。"], "inputs": [{"name": "clip", "link": 78, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "