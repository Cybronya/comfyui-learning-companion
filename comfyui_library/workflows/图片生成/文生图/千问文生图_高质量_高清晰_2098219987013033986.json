ilename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 49, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 14}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [52, 53], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [396.9643859863281, 348.7451477050781], "pos": [412.1607360839844, 772.9779663085938], "widgets_values": ["使用提供的【海滩日光场景】基础，创建一幅全景观赏型人像大片。主角是一位肤若凝脂、身形丰腴迷人的青年女性，正慵懒地斜倚于木质沙滩躺椅之上——她身披一件由半透明蕾丝与轻纱交织而成的白色渐变比基尼泳装，面料随体态起伏呈流动波浪感；胸前与腰侧饰有细密珠链勾勒出柔美曲线轮廓，水流自肌肤滑落形成晶莹剔透的动态水痕，恰似刚从海水中起身未干的湿润肌理，令肤色愈发清透诱人。整体姿态舒展放松，眼神温柔含情，唇瓣泛起蜜桃光泽，在午后金辉洒落之下，营造极致感官氛围。背景虚化处理，远处椰林摇曳、浅滩延绵，强化焦点集中在人物身上。构图为远近对比式全景拍摄，前段人物高清锐利，后方环境朦胧唯美，强调层次纵深与沉浸体验。服装材质需体现丝绸般的垂坠质感及细腻闪光颗粒，在强光下反射温暖光芒，凸显奢华度假美学。整幅作品须传达浪漫、慵懒、性感却不失优雅的气息，符合高级商业摄影调性。"], "inputs": [{"name": "clip", "link": 47, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 45, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 6}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.26.11", "VHS_latentpreview": true, "groupNodes": {}, "ds": {"offset": [1140.4681820339626, -72.90609571668836], "scale": 0.45}}, "groups": [], "links": [[47, 42, 0, 45, 0, "CLIP"], [48, 41, 0, 51, 0, "MODEL"], [49, 51, 0, 54, 0, "MODEL"], [50, 54, 0, 62, 0, "MODEL"], [51, 62, 0, 47, 0, "MODEL"], [52, 45, 0, 47, 1, "CONDITIONING"], [53, 45, 0, 46, 0, "CONDITIONING"], [54, 46, 0, 47, 2, "CONDITIONING"], [55, 43, 0, 44, 1, "VAE"], [56, 48, 0, 47, 3, "LATENT"], [58, 47, 0, 44, 0, "LATENT"], [59, 63, 0, 64, 0, "UPSCALE_MODEL"], [60, 64, 0, 49, 0, "IMAGE"], [61, 44, 0, 64, 1, "IM