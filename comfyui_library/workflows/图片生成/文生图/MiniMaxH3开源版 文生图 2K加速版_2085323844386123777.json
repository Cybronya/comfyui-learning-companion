, "localized_name": "text"}], "color": "#232", "widgets_values": ["魔幻电影风格，神话山海经，九尾狐仙立于云海仙山崖巅，蓬松九尾漫天舒展，狐身流转琉璃流光与幽蓝灵焰纹路，狐首轻抬，眸光清冷摄人，仙雾在周身盘旋翻涌，远古神性扑面而来，极致压迫感，史诗宏大氛围，粒子灵雾特效，动态气流特效，极致细节，超精细，超高质感，高对比度，高饱和度，充满张力的镜头，极强视觉冲击力，夺目的视觉效果，灵雾缠绕感，强烈画面张力，杰作，最佳品质，虚幻 5 引擎，HDR 写实质感，UE5+Octane 渲染，8K 分辨率，非对称式构图，细节清晰详尽，运用弥散光和轮廓光特写，局部高曝、轻微过曝，暗调基底，伦勃朗光，强烈明暗对比，高反差，苍凉神幻氛围，皮毛肌理质感，情绪氛围感拉满，慢快门，朦胧美学，多层空间层次感，完美构图，超现实电影摄影效果"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [397.71929931640625, 639.0352783203125], "pos": [-685.1883544921875, 5227.64208984375], "id": 158, "properties": {"cnr_id": "ComfyUI-Jjk-Nodes", "ver": "b3c99bb78a99551776b5eab1a820e1cd58f84f31", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "JjkText"}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "KKvideo_latentpreview": false, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [1173.031791188867, -5162.557085930075], "scale": 1.8797616762370455}}, "groups": [{"font_size": 24, "flags": {}, "id": 1, "title": "MiniMaxH3 文生图 2K加速版", "bounding": [-1386.8443603515625, 4572.77978515625, 1809.311279296875, 591.142578125]}], "links": [[229, 119, 0, 122, 1, "VAE"], [231, 129, 0, 125, 0, "NOISE"], [232, 126, 0, 125, 1, "GUIDER"], [233, 123, 0, 125, 2, "SAMPLER"], [234, 124, 0, 125, 3, "SIGMAS"], [235, 131, 1, 125, 4, "LATENT"], [237, 131, 0, 126, 1, "CONDITIONING"], [240, 128, 0, 131, 0, "CLIP"], [241, 119, 0, 131, 1, "VAE"], [246, 125, 0, 122, 0, "LATENT"], [248, 122, 0, 135, 0, "IMAGE"], [256, 142, 0, 131, 5, "INT"], [257, 142, 1, 131, 6, "INT"], [272, 135, 0, 157, 0, "IMAGE"], [278, 158, 0, 131, 4, "STRING"], [279, 