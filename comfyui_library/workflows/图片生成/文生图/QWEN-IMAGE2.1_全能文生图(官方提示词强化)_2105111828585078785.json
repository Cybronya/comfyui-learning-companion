{"last_link_id": 724, "nodes": [{"mode": 0, "outputs": [{"name": "VAE", "links": [682], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [510, 70], "pos": [-66.06918334960938, 4538.4580078125], "widgets_values": ["qwen_image_2.1_vae_bf16.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "id": 471, "type": "VAELoader", "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen_image_2.1_vae_bf16.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors"}], "ver": "0.36.0", "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader"}, "order": 0}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [690], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [510, 90], "pos": [-66.06918334960938, 4178.45361328125], "widgets_values": ["qwen_image_2.1_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "UNET名称"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 468, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "models": [{"name": "qwen_image_2.1_int8_convrot.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"}], "ver": "0.36.0", "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 1}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [681], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [510, 120], "pos": [-66.06918334960938, 4338.45849609375], "widgets_values": ["qwen3vl_8b_bf16.safeten