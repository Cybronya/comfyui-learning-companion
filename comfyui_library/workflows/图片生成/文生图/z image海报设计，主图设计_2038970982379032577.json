效果：描述光源类型、光照方向、阴影处理、特殊效果（光晕/粒子/镜头光斑/体积光等）、材质表现\n第六段-整体氛围总结：概括情绪基调（活力/宁静/奢华/温馨等）、视觉冲击力、目标感受\n关键细节要素库\n色彩描述：电光紫、洋红、青色、翡翠绿、深酒红、琥珀色、渐变、饱和度高、冷暖对比\n材质质感：光泽、磨砂、金属、半透明、丝绒、水晶、液态、磨砂玻璃、拉丝\n光影效果：体积光、环境光、定向光、柔光、硬光、光晕、镜头光斑、星芒、反射、漫射\n构图术语：中心构图、对角线、三分法、对称、留白、层次感、景深、透视\n风格关键词：3D立体、波普艺术、极简主义、赛博朋克、中国风、写实、插画风、扁平化\n氛围情绪：活力四射、宁静致远、奢华高端、温馨治愈、神秘梦幻、热烈欢庆\n输出要求\n生成的提示词必须是英文（图像生成工具通用语言）\n总长度控制在800-1500词之间\n段落之间用换行连接，不要有空行\n使用具体可视觉化的描述，避免抽象概念\n保持语句流畅，适合直接用于图像生成\n示例转换逻辑\n用户输入：\"双12促销海报，天猫黑猫，热闹\"\n你需扩写包含：节日主题定位、黑猫形象细节、舞台场景、色彩方案、文字排版、促销信息区域、光影特效、整体氛围等完整元素\n现在请根据用户的简单描述，生成专业详细的海报提示词。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 82, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.41.21", "VHS_latentpreview": false, "ds": {"offset": [2193.0339407542397, 293.54396347772513], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "海报内容简单描述", "bounding": [33.88827896118164, 951.8534545898438, 420, 283.5999450683594]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "海报设计", "bounding": [-213.98440551757812, 187.66348266601562, 2508.085693359375, 1057.7899169921875]}], "links": [[18, 23, 0, 14, 0, "MODEL"], [22, 12, 0, 16, 0, "CLIP"], [23, 22, 0, 17, 0, "LATENT"], [24, 11, 0, 17, 1, "VAE"], [26, 14, 0, 22, 0, "MODEL"], [27, 24, 0, 22, 1, "CONDITIONING"], [28, 16, 0, 22, 2, "CONDITIONING"], [29, 21, 0, 22, 3, "LATENT"], [30, 18, 0, 23, 0, "MODEL"], [31, 12, 0, 24, 0, "CLIP"], [48, 33, 0, 32, 0, "LLAMACPPMODEL"], [49, 34, 0, 32, 1, "LLAMACPPARAMS"], [103, 32, 0, 24, 1, "STRING"], [106, 17, 0, 78, 0, "IMAGE"], [107, 17, 0, 79, 0, "IMAGE"], [109, 81, 0, 32, 5, "STRING"], [110, 82, 0, 32, 6, "STRING"]], "id": "ef484dc3-5d09-4e2c-a