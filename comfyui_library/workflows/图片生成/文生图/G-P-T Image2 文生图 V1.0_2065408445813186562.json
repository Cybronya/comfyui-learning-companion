使用小型手写风格标签。允许使用细微的编辑和标注标记，但保持简约和优雅。\n\n风格：简约、电影感、高端、艺术书板、干净、富有表现力、适用于制作。\n\n最终图像应感觉像一张艺术性的角色身份板，旨在帮助 AI 模型理解角色的面部、轮廓、服装、姿势和情感范围。\n\n", "16:9", false, 1732856009, "randomize", "4k"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}], "flags": {}, "type": "RH_RhartImageG2TextToImage", "mode": 0, "bgcolor": "#535", "size": [439.29034423828125, 447.8918151855469], "pos": [817.528564453125, 1211.8626708984375], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2TextToImage"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [326.728515625, 519.2625732421875], "pos": [1701.98388671875, 1272.9404296875], "widgets_values": ["pasted/ffe48fe84d949e10d220be0e59f3cbbd12bec850e026f5c678f2695fb3ec8df2.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 8, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node