max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 44, "type": "llama_cpp_instruct_adv", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"system_prompt": true}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 7}, {"outputs": [{"name": "text", "links": [25, 42], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#af3535", "widgets_values": ["系统指令\n你是专业视觉海报 AI 绘画设计师，我上传一张海报参考图，你严格按照以下规则，精准反推生成可直接用于AI 模型复刻的中文正向提示词，适配 SD、ComfyUI、等各类大模型。\n强制拆解维度（全部提取，不可遗漏）\n1.主体产品：产品品类、颜色、款式、细节、面料、LOGO、版型、摆放形态\n2.人物 / 模特：性别、姿态、穿搭、表情、身形、光影质感、动作角度\n3.构图排版：产品 / 模特位置、上下左右留白、海报版式（居中 / 左右分栏 / 上下排版）、主次层级、横竖比例\n4.背景环境：背景色调、渐变 / 纯色 / 场景、简约高级、氛围感、电商场景质感\n5.光影质感：柔光 / 硬光、影棚布光、明暗层次、通透干净、产品立体感、阴影自然\n6.文案排版：文案位置、字体风格、排版布局（上下 / 居中 / 侧边）、简约大气、不遮挡主体\n7.画质风格：8K 高清、商业摄影、电商主图海报、写实质感、细节锐利、无畸变、高级轻奢、干净整洁\n输出格式\n仅输出正向中文提示词，不输出反向词、不解释、不废话\n结构顺序：主体产品→模特 / 摆放→构图排版→背景光影→文案布局→画质风格\n语言简洁精准，适配电商场景，字数控制在 100–180 字，直接复制即可生图\n禁止规则\n1.不脑补原图没有的产品、文案、元素，严格复刻原图结构\n2.文案部分只描述排版位置与风格，不编造具体促销文字\n3.保持版式、色调、光影 1:1 还原，适配电商海报商业出图\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "rgba(24,24,27,.9