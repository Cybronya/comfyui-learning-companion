: [4572.59423828125, 483.4978332519531], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 16, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 30, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 4}, {"outputs": [{"name": "image", "links": [16], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["次世代3D国漫CG，全身完整人物立绘，标准完整全身三视图横向三格同框，正面、45°斜侧、侧面，三视图人物身形五官服饰完全统一，电影级伦勃朗柔光，丁达尔光束穿透空气，细腻PBR物理材质，8K超高分辨率，极致细节，50mm定焦镜头，浅景深，画面质感厚重写实，国风奇幻场景。\n\n【人物核心设定】\n年轻女子，22岁左右，高挑纤细身段，肩颈线条柔和舒展，腰肢纤细，四肢修长匀称，骨骼纤细却不孱弱，体态沉静带着隐忍的清冷感。脸型是流畅柔和鹅蛋脸，下颌线条圆润利落，皮肤是细腻冷白皮，带有通透血色，面部次世代高精度贴图，皮肤可见极淡绒毛，毛孔细微自然。眼型狭长丹凤眼，眼尾微微向上轻挑，深墨色瞳孔，瞳中藏细碎琥珀色反光，长而浓密的黑睫毛，眼妆淡雅，只在眼尾扫一层浅棕红眼影；眉形是自然远山眉，墨色柔和不锐利。唇形饱满薄厚适中，唇色是低饱和豆沙红，唇纹细腻。乌黑浓密的长发，大半头发松松挽成低发髻，余下几缕碎发垂落在脸颊两侧与颈肩，发丝带有自然光泽，单根发丝清晰可见，发髻穿插暗银缠枝莲纹发簪，点缀几颗细小哑光珍珠，鬓边垂着一条浅蓝丝带，丝带末端系一枚青铜小铃铛，随动作微微晃动。耳饰为大颗球形通透水蓝琉璃耳坠，搭配金属隔珠，下方垂蓝色长流苏。手部纤细修长，指甲修剪圆润，裸粉自然甲色；右手佩戴三只长尖金色金属指套，鎏金表面带有细微手工錾刻花纹，指尖锋利，手腕套一枚淡青和田玉手镯，玉镯边缘金属包边。脚上穿素色绣银线云纹软底布鞋，鞋头点缀小巧玉珠。\n\n【服饰细节】\n身着暗纹烟青色广袖交领古风长袍，面料是哑光暗纹纱罗，布料带有自然垂坠褶皱，衣身织暗银色流云缠枝纹样，光线变化时纹路隐约浮现；交领边缘滚浅银灰窄边，内衬是米白色柔棉。宽大袖口随风轻微扬起，袖口内侧绣淡蓝色缠花，腰间系深灰蓝色宽布腰带，腰带正中悬挂一块水滴形墨玉玉佩，玉佩用红绳串起，红丝线垂落。外搭一层极薄半透烟灰色披帛，披帛轻薄飘逸，带有朦胧柔光。\n\n【背景环境】\n古色古香的江南阁楼内室，傍晚时分，室内光线昏暗，仅窗边一盏青铜油灯散发出暖金色光晕，油灯火焰轻轻跳动，空气中漂浮细微尘埃，丁达尔光从木格窗斜射入房间。房间陈设古朴，深色实木雕花家具，侧边摆放矮木几，几上放置青瓷茶杯与半卷古籍；墙面悬挂褪色水墨山水画卷，角落立青铜香炉，一缕细烟缓缓升腾。远处背景做虚化散景，窗外是朦胧暮色，能隐约看见庭院里的枯竹与假山，环境氛围静谧压抑，带着暧昧又紧绷的氛围感。前景有几根垂直的纤细红丝线，轻微遮挡画面，增加画面层次感。\n\n【光影与氛围】\n主光源来自侧面油灯暖光，明暗对比柔和，伦勃朗布光，人物面部一半被暖光包裹，另一半落在柔和阴影中，冷暖光影交织，低饱和色调，青灰底色搭配局部暗红点缀。环境存在微弱环境漫反射，布料、玉石、金属、琉璃材质反光真实自然，金属带有冷硬高光，玉石温润柔光，纱料半透明透光。整体情绪氛围：沉静、隐忍，温柔外表之下暗藏张力，安静又带着一丝危险感。无多余杂物，画面干净，电影级渲染，虚幻引擎UE5，全局光照，光线追踪，超高细节，8K，极致写实，国风3D动漫风格。\n", "9:16", "2k", false, 1233935692, "randomize"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartImageG25SunburstTextToImage", "mode": 4, "bgcolor": "#653", "size": [537.39794921875, 623.2066040039062], "pos": [3983.980224609375, 474.28875732421875], "id": 31, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG25SunburstTextToImage"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [17], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [348.3328857421875, 348.1872863769531], "pos": [2196.087646484375, 482.7847900390625], "widgets_values": ["pasted/a30c69b0d72ea8b58995475d94c0f5d9cd21b84e87b993311ca090864de1641e.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {"disabled": false}, "id": 22, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"outputs": [{"name": "image", "links": [18], "label": "image", "type": "IMAGE", "