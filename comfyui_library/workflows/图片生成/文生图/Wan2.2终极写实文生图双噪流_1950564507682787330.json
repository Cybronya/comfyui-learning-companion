&R": "VAEDecode"}, "order": 30}, {"outputs": [{"name": "text", "links": [152], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["2010年代初用手机拍摄并上传到Facebook的快照照片, 具有动态自然光照, 以及中性白色色彩平衡和褪色效果,"], "inputs": [], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [401.5205078125, 119.41521453857422], "pos": [7937.12109375, 3661.30419921875], "id": 120, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}, {"outputs": [{"name": "describe", "links": [179], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#232", "widgets_values": ["", "", "", "# FLUX Prompt 反推提示词说明\n\n## 🧠 角色定位\n你是一位富有艺术感的 **FLUX Prompt 助理**，具备对图像的深度理解能力，能够将视觉内容转化为丰富、生动、具体的文本提示词（prompt），以用于图像生成模型 FLUX 或 Stable Diffusion。\n\n---\n\n## 🎯 核心任务\n\n我将提供一张图片或一个简短的主题描述，你的任务是：\n\n1. **理解图像/主题**：分析图像中的内容、元素、情感与风格。\n2. **生成 Prompt**：根据分析结果，输出一段详尽的英文 prompt，用于高质量图像生成。\n\n---\n\n## 🖼️ 图像分析维度\n\n请从以下角度描述图像内容，确保 prompt 丰富、准确、具象：\n\n- **主要元素**：人物、动物、物体、风景等核心对象\n- **画面细节**：颜色、纹理、光影、服饰、姿态、动作、表情、环境构成等（不少于5处具体细节）\n- **场景氛围**：温馨、神秘、奇幻、宁静、末世感等\n- **艺术风格**：现实主义、赛博朋克、油画风、水彩、卡通、像素风、未来主义等\n- **构图视角**：如“俯视”、“仰视”、“特写”、“广角”等\n\n---\n\n## ✏️ Prompt 输出格式要求\n\n- **语言**：仅使用中文生成 prompt\n- **语气**：描述性强、画面感明确，避免口语化或模糊措辞\n- **结构**：连贯自然，不分条目，形成一段完整描述\n- **长度**：足够详尽，建议不少于60词\n- **内容限制**：\n  - 不解释 prompt 内容\n  - 不添加“生成提示词”、“Prompt:”等前缀\n\n---\n\n## ✅ 示例\n\n- **输入主题**：一只飞在雪山上的龙\n- **输出 prompt**：\n\n  > 一条雄伟的绿鳞巨龙，眼中泛着琥珀色光芒，双翼张开，飞翔在令人叹为观止的雪山群中。它强壮的身影投下长长的阴影，笼罩着高耸入云的山峰。下方是一条清澈的河流，在深谷中蜿蜒流淌，倒映着明亮的天空。空气中弥漫着飘渺的薄雾，营造出清新而梦幻的氛围。这幅画面展现了令人敬畏的自然与野性之美。", "", 0.6, 307, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 177, "label": "prompt", "type": "STRING"}], "flags": {}, "type": "RH_LLMAPI_NODE", "mode": 0, "bgcolor": "#353", "size": [274.411865234375, 286], "pos": [7940.900390625, 3843.456298828125], "id": 128, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 13}, {"outputs": [{"name": "text", "links": [175, 177], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["摄影，阳光明媚的上午，一只蓝色眼睛的哈士奇做出自拍的姿势和神态，它身后是长城。摄影级照片风格，细节丰富，光影自然真实，超清画质。"], "inputs": [], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#335", "size": [315.6014404296875, 217.5799560546875], "pos": [9666.5830078125, 3386.789794921875], "id": 124, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 8}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#232", "widgets_values": ["2010年代初用手机拍摄并上传到Facebook的快照照片, 具有动态自然光照, 以及中性白色色彩平衡和褪色效果,一只蓝色眼睛的哈士奇，毛色柔顺细腻，呈现出灰白交织的纹理，正以一种俏皮的姿势模拟自拍动作，前爪微微抬起，头部略微倾斜，嘴角扬起仿佛露出一丝笑意，眼神中透着灵动与自信。背景是壮丽的长城，蜿蜒起伏于青翠的山峦之间，阳光明媚，清晨的阳光洒在砖石上，勾勒出古老建筑的纹理细节。画面中光影自然柔和，哈士奇的毛发在阳光下呈现出微微的光泽，周围的环境色彩丰富，远处的天空湛蓝，点缀着几朵洁白的云。整体构图以摄影级风格呈现，超高清画质，细节逼真，充满生动的生命力与自然的和谐美感。"], "inputs": [{"shape": 7, "name": "anything", "link": 173, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#353", "size": [398.4926452636719, 296.8557434082031], "pos": [8274.138671875, 3837.375244140625], "id": 119, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 23}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.4", "VHS_latentpreview": false, "ds": {"offset": [-9622.52662912579, -3443.8703568422734], "scale": 1.4122927695244554}}, "groups": [{"color": "#b06634", "font_size": 120, "flags": {}, "id": 9, "title": "B站、YouTube、公众号：嘟嘟A