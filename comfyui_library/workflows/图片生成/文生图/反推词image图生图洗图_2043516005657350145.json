NbgOverride": {"bgcolor": "rgba(24,24,27,.9)", "groupcolor": "#3f789e", "color": "#006691"}}, "order": 20}, {"outputs": [{"shape": 6, "name": "text", "links": [91], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#2a363b", "widgets_values": ["一位金发卷发的小女孩（约3-5岁），扎着俏皮的双马尾辫，用蓝色小发圈固定；她低头微笑着，眼神温柔地注视着手中的一个鲜亮橙子，嘴角上扬露出甜美的笑容。小女孩身穿浅绿色荷叶边吊带背心搭配米白色内衬和宽松牛仔阔腿裤，脚踩一双简约米色人字拖。\n\n画面细节丰富：背景是郁郁葱葱的户外田园场景——绿意盎然的草地与树木环绕，阳光透过树叶洒下柔和光影。在树杈间悬挂着一件卡其色连衣裙、一条粉色网兜购物袋（里面装有水果）以及一块灰白棉布晾晒物。地面是泥土地面点缀青苔与落叶石块，旁边摆放两个大小不一的手工编织草编篮筐。\n\n整体风格清新自然，充满童真夏日气息，构图温馨宁静，色彩明快和谐，适合儿童服饰或生活美学摄影宣传图。  \n关键词补充：AI绘画 | 清新治愈系 | 自然光拍摄 | 田园风 | 儿童穿搭展示 | 高饱和度暖色调 | 环保生活方式元素\n\n--- \n\n*此为适配Midjourney/DALL·E等模型优化后的详细中文提示词模板，可直接用于生成类似图像。*\n\n✅ 推荐使用参数如：\n`--ar 16:9 --v 6.0 --style photographic`\n\n希望这个版本能帮助你精准还原原图氛围！ 🌞👧🍊"], "inputs": [{"name": "text", "link": 87, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#3f5159", "size": [210, 330], "pos": [-480, 820], "id": 38, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss", "ttNbgOverride": {"bgcolor": "rgba(24,24,27,.9)", "groupcolor": "#3f789e", "color": "#006691"}}, "order": 16}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [79], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [240, 330], "pos": [-1340, 820], "widgets_values": ["0699f8a272c076ca44c0bd775c43c9e365e93fe6698e4a52ab9316f626d49c57.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 48, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", 