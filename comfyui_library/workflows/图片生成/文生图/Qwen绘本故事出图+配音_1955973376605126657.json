, "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "speed"}, "name": "speed", "label": "speed", "type": "FLOAT", "localized_name": "speed"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "temperature"}, "shape": 7, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "top_p"}, "shape": 7, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized_name": "top_p"}, {"widget": {"name": "top_k"}, "shape": 7, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "repetition_penalty"}, "shape": 7, "name": "repetition_penalty", "label": "repetition_penalty", "type": "FLOAT", "localized_name": "repetition_penalty"}, {"widget": {"name": "length_penalty"}, "shape": 7, "name": "length_penalty", "label": "length_penalty", "type": "FLOAT", "localized_name": "length_penalty"}, {"widget": {"name": "num_beams"}, "shape": 7, "name": "num_beams", "label": "num_beams", "type": "INT", "localized_name": "num_beams"}, {"widget": {"name": "max_mel_tokens"}, "shape": 7, "name": "max_mel_tokens", "label": "max_mel_tokens", "type": "INT", "localized_name": "max_mel_tokens"}, {"widget": {"name": "sentence_split"}, "shape": 7, "name": "sentence_split", "label": "sentence_split", "type": "COMBO", "localized_name": "sentence_split"}], "flags": {}, "id": 77, "type": "IndexTTSNode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "IndexTTSNode"}, "order": 11}, {"mode": 0, "outputs": [], "size": [270, 112], "pos": [462.7168884277344, 1132.764404296875], "widgets_values": ["audio/ComfyUI"], "inputs": [{"name": "audio", "link": 136, "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "id": 80, "type": "SaveAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudio"}, "order": 13}, {"mode": 0, "outputs": [{"name": "string", "links": [135], "type": "STRING", "localized_name": "string"}], "size": [430.1580505371094, 573.2059326171875], "pos": [-496.6860046386719, 914.0252685546875], "widgets_values": ["恐龙老师来上课啦\n“哐当 ——” 教室门被撞开时，雨珠顺着门框滚成串。霸王龙老师抖了抖雨衣，尖牙上挂着的梧桐叶轻轻晃了晃。小猪噜噜吓得把脸埋进算术本，他赶紧用爪子捂住嘴，声音软乎乎的：“今天教叠手帕哦。”\n布满老茧的巨爪捏着粉方巾，指尖像碰棉花糖似的慢慢拢，叠出只歪歪扭扭的三角龙。噜噜偷偷抬头，看见他睫毛上还挂着雨珠，突然伸手摸了摸那布满鳞片的手背，糙得像晒过的树皮。\n“呼 ——” 翼龙老师带着风冲进来，作业本像白羽毛飘了满地。“抓稳小尾巴！” 她抓起小松鼠朵朵的大尾巴往空中一甩，两人掠过屋顶时，朵朵看见棉花糖似的白云在天上写：“今天的风是草莓味的。”\n剑龙老师背对着大家，骨板 “咔嗒咔嗒” 转着，阳光透过骨板，在黑板拼出闪闪的算式。“5 只小刺猬，正好能躲进我的尾巴影子。” 小刺猬们缩成刺球滚进去，突然发现影子里藏着星星。剑龙尾巴一摇，骨板 “唰” 地亮起彩虹光，把每个小家伙的鼻尖都染成了彩色。\n放学时，霸王龙蹲在门口，爪子捏着鞋带轻轻打蝴蝶结。“明天学做草莓酱哦。” 他对小兔莉莉眨眨眼，尾巴尖扫过篱笆，牵牛花 “噗噜噜” 变成了紫色的星星。莉莉摸了摸口袋里的三角龙手帕，发现尖角里藏着颗会发光的小太阳，暖乎乎的像霸王龙老师的掌心。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 79, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 4}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [107], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [50, 510], "widgets_values": [1328, 1328, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {}, "id": 58, "type": "EmptySD3LatentImage", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "EmptySD3LatentImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffse