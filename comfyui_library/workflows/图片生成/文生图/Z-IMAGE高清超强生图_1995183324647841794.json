nnectable": {}, "Node name for S&R": "GetImageSize"}, "order": 20}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [111], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [413.26324462890625, 235.82167053222656], "pos": [-2042.46630859375, 561.6302490234375], "widgets_values": ["一位身着华美红色刺绣抹胸礼服的年轻女子优雅倚坐于古典温泉池边，裙摆垂落至膝下，外披米色提花薄纱长袍轻柔拂动；发髻高挽，一侧簪插粉色绢花，耳坠珍珠流苏微晃，颈间细链吊坠低调闪耀。她目光低垂凝神，唇角含蓄笑意，肌肤白皙细腻，在暖光映衬下更显温婉气质。画面前景为深色石质浴缸边缘与晶莹水面倒影，右侧可见木质雕花桌几及古风灯盏幽辉闪烁；中远景是厚重木框屏风内嵌水墨枝梅壁画，墨韵淡雅，右上角落“松柏延年”四字题款隐约可辨；天花板悬挂水晶吊灯折射碎芒，侧壁壁灯投射柔和光晕勾勒空间层次。整体采用中心偏左黄金分割构图，人物居镜面三分线交点处，身体自然倾斜形成动态平衡；视线由肩部向腰臀曲线顺势延伸，引人聚焦服饰纹样——金丝缠绕牡丹藤蔓繁复精致，束腰收拢凸显玲珑体态；光影以暖黄主调营造私密静谧氛围，逆光虚化后方陈设强化主角轮廓神圣感，地面几何拼接瓷砖暗藏东方美学秩序。此图为专业级摄影棚布景实拍效果，融合新中式宫廷风与现代时尚语汇，呈现沉浸式奢靡场景中的女性神性之美，适配高端写真杂志封面或影视剧古装宴会戏份定格瞬间。"], "inputs": [{"name": "text", "link": 109, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 76, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "943e5cc7526c601600150867a80a02ab008415e7", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 14}, {"mode": 0, "outputs": [{"name": "文本输出", "links": [109], "label": "文本输出", "type": "STRING", "localized_name": "文本输出"}], "size": [481.6855773925781, 572.2732543945312], "pos": [-2601.167236328125, 525.3749389648438], "widgets_values": ["Huihui-Qwen3-VL-8B-Instruct-Abliterated", "None (FP16)", "提示词风格 - 极致详细", "你是一位专业的AI图像生成提示词工程师。请详细描述这张图像主体、前景、中景、背景、构图、视觉引导、光影氛围等细节并创作出具有深度、氛围和艺术感或日常业余设备拍摄的图像提示词。\n\n要求：若熟悉图片中人物（如名人、电影角色、动画人物等），请直接使用其本名，中文提示词，不用出现对图像水印的描述，不要出现无关的文字和符号，不需要总结，限制在800字以内", 1024, 0.6, 0.9, 1, 1.2, 16, "auto", true, 1], "inputs": [{"shape": 7, "name": "🖼️ 图像1", "link": 108, "label": "🖼️ 图像1", "type": "IMAGE", "localized_name": "🖼️ 图像1"}, {"shape": 7, "name": "🖼️ 图像2", "label": "🖼️ 图像2", "type": "IMAGE", "localized_name": "🖼️ 图像2"}, {"shape": 7, "name": "🖼️ 图像3", "label": "🖼️ 图像3", "type": "IMAGE", "localized_name": "🖼️ 图像3"}, {"shape": 7, "name": "🖼️ 图像4", "label"