s": {}, "id": 18, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.3.61", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.1"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 8}, {"outputs": [{"name": "MODEL", "links": [26], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#af3535", "widgets_values": ["QwenimageshuyeStyle_000005000.safetensors", 1], "inputs": [{"name": "model", "link": 25, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [270, 82], "pos": [-2690.387939453125, 1551.0152587890625], "id": 19, "properties": {"cnr_id": "comfy-core", "ver": "0.3.61", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.1"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 11}, {"outputs": [], "color": "#432", "widgets_values": ["举例：\n一个由树叶拼组而成的老虎，放在地上。\n一个由树叶和花拼组而成的狮子，放在大理石桌上\n一个由红色花瓣拼组而成的美女，贴在墙上\n\n复杂举例：\n一片由晨露未晞的梧桐叶、赭石色枫香叶与细碎的松针层叠拼组而成的苍鹰，羽翼舒展如覆着细碎金箔，鹰喙以深紫鸢尾花萼雕琢出锐利弧度，鹰爪紧握两枚圆润的橡果；苍鹰下方，是用浅黄棣棠花瓣铺展的流云，云絮边缘点缀着极小的白色雏菊，整体悬浮于嵌着暗纹的胡桃木博古架中央，博古架左侧衬着半盏盛着清水的青瓷盏，水面倒映出苍鹰与流云的细碎影子，右侧立着一支干枯的莲蓬，莲蓬孔洞间还嵌着几粒淡粉的樱花瓣，阳光透过雕花窗棂，在拼组作品上投下菱形的暖光，为叶片与花瓣镀上一层柔和的金边。\n\n一件由多层自然物料精构而成的中国龙形拼组作品，盘踞于铺着墨色云纹绒布的酸枝木长案之上。龙身以深青松针与墨绿柏叶交错叠铺，模拟出鳞甲的层叠肌理，每片 “鳞甲” 边缘还点缀着细碎的银灰色杉木叶，在光线下泛着柔和的金属质感；龙首尤为精巧，额间 “王” 字用朱红枫叶拼缀，眼窝嵌着两颗莹润的深褐桂圆核，眼白是剪碎的象牙白茉莉花瓣，龙角以两节带着纹理的深棕桑树枝雕琢，龙髯则是垂落的浅黄迎春花枝，末梢还缠着几缕纤细的银柳丝。\n龙的脊背处，用橙红柿子瓣与金黄银杏叶交替排布，模拟出龙身起伏的弧度；龙爪紧握三颗饱满的深紫野葡萄，爪尖则用削尖的深褐竹枝勾勒，锐利感十足。龙尾蜿蜒至长案一端，尾尖散开，以粉白樱花瓣与淡蓝绣球花瓣铺成蓬松的尾鳍状。\n长案左侧，立着一尊浅青釉瓷瓶，瓶中斜插几枝干枯的莲蓬与深红南天竹果枝，与龙身色彩相映；右侧摆放一只黄铜托盘，盘中盛着半盏清水，水面漂浮着几片极小的翠绿荷叶，倒映出龙首的局部轮廓。午后阳光透过雕花窗棂，将龙形的影子投射在身后的浅灰墙壁上，叶片的缝隙间漏下细碎的光斑，为整幅作品添上了几分灵动的仙气。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [273.6048889160156, 588.953369140625], "pos": [-3452.22998046875, 1197.966552734375], "id": 24, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"outputs": [{"name": "LATENT", "links": [11], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#322", "widgets_values": [768, 1344, 1, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 33, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 34, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "label": "length", "type": "INT", "localized_name": "length"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "type": "EmptyHunyuanLatentVideo", "mode": 0, "bgcolor": "#533", "size": [270.0943298339844, 130], "pos": [-2660.73779296875, 1195.9329833984375], "id": 8, "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "ue_properties": {"widget_ue_connectable": {"batch_size": true, "width": true, "length": true, "height": true}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "EmptyHunyuanLatentVideo"}, "order": 10}, {"outputs": [{"name": "text", "links": [29], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#322", "widgets_values": ["一个由树叶和花拼组而成的机器猫，放在地上"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#533", "size": [400, 200], "pos": [-3109.923095703125, 1195.480224609375], "id": 23, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}, {"outputs": [{"name": "INT