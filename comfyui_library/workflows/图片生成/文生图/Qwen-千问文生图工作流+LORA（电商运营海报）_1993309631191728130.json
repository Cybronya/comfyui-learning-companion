zed_name": "条件"}], "size": [308.4297790527344, 138.53506469726562], "pos": [847.0428466796875, 1198.292724609375], "widgets_values": ["3D渲染赛博朋克风格场景，\n描绘了一个男孩形象，身着潮流时尚服装，脚踩悬浮滑板，底部发光；周围环绕着电子科技产品，有闪电标志的耳机、键盘、手机、相机、（炫彩镭射包装）等产品。\n男孩单脚立于悬浮滑板，双手展开保持平衡，身体前倾呈现高速滑行姿态，扬起散发粒子光效。\n赛博朋克风格的霓虹蓝色调未来街景，有荧光绿与蓝色的全息广告牌，巨型全息电子屏幕悬挂着“科技日”立体字样，银色传送带滚动展示商品包装盒，空中漂浮着透明数据流与折扣标签。\n色调以霓虹蓝、荧光绿色、金属银为主，光线充满激光射线与全息投影效果；产品呈现金属拉丝与荧光涂层质感，悬浮滑板底部喷射蓝色离子气流，背景建筑表面布满数码纹理与流动的光带。\n顶部倾斜动感的3D立体艺术字“科技大冒险”，字体厚重带有金属光泽；下方立体字“向快乐出发”，字体棱角分明，带有电路板纹理，内部填充流动光效。\n充满科技感与未来元素的电商大促场景，动态光线与悬浮元素交织，传递出潮流科技与购物狂欢的震撼视觉体验。"], "inputs": [{"name": "clip", "link": 24, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 17, "type": "CLIPTextEncode", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [22], "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "CLIP", "links": [24], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [315, 126], "pos": [844.8976440429688, 1022.6053466796875], "widgets_values": ["【油条】运营3D海报-场景含IP_V1.0.safetensors", 0.6, 1], "inputs": [{"name": "model", "link": 26, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "clip", "link": 28, "label": "CLIP", "type": "CLIP", "localized_name": "CLIPCLIP"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}, {"widget": {"name": "strength_clip"}, "name": "strength_clip", "type": "FLOAT", "localized_name": "CLIP强度"}], "flags": {}, "id": 21, "type": "LoraLoader", "properties": {"hasSecondTab": f