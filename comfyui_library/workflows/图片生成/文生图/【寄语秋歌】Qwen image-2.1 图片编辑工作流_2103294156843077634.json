_connectable": {}, "aux_id": "kijai/ComfyUI-KJNodes", "Node name for S&R": "GetNode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "positive", "links": [759], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "links": [760], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent", "links": [761], "label": "latent", "type": "LATENT", "localized_name": "latent"}], "size": [405.69818115234375, 603.702392578125], "pos": [499.6918640136719, 2432.90576171875], "widgets_values": ["横版16:9电影级CG写实风格视频封面，虚幻引擎渲染质感，次时代画面，像一张3A游戏宣传海报。\n\n背景：深邃的星空蓝黑渐变，远处漂浮着淡淡的云海与光尘粒子，一道柔和的体积光从上方洒下，画面有强烈的空间纵深。\n\n右侧主视觉：一位容貌绝美的年轻古装女子以半身立绘姿态立于画面右侧四分之一处——柳叶细眉，杏眼清澈含光，琼鼻樱唇，肌肤白皙细腻泛着次表面散射的柔光，乌黑长发挽成流云高髻，斜插一支金步摇，鬓边碎发轻垂，身着淡青色广袖流仙裙，裙裾绣银线云纹，衣袂与月白色帔帛被风轻轻扬起，她微微侧头回眸望向镜头，神情清丽出尘。 人物完整可见，不被任何面板遮挡，仅裙摆末端可轻微飘出画面右缘。\n\n三块立体发光面板互不重叠、间距均匀，呈阶梯式错落环绕在人物左侧的空中，每块面板完整可见 ：左上方的面板是她的四角度视图卡，2×2排列正面、侧面、背面、回眸，边缘泛蓝色辉光；左下方的面板是四格分镜，回眸、抚琴、仗剑、执伞四场景，边缘泛紫色辉光；右上方的面板是她的九宫格Q版表情包，九格是九种表情的三头身Q版小头像——开心大笑、惊讶张嘴、生气鼓腮、害羞脸红、无奈摊手、得意挑眉、委屈瘪嘴、疑惑歪头、双手比心，五官简洁圆润，边缘泛金色辉光。三块面板大小相近，均有真实的玻璃厚度与反光，面板微微朝向镜头倾斜，与人物之间保持明确的空隙。\n\n左侧大字区： 画面左侧约五分之二为独立文字区，与所有面板之间留出明显的呼吸空隙 。两行超大号白色立体粗黑体标题“闭源模型”“可以省了？”，字体带金属质感与冷光描边，“省了？”为亮黄色发光字；下方一行亮蓝色中号字“Qwen-Image 2.1 实测”；再往下三个横排圆角小标签：蓝底白字“角色多视图”、紫底白字“分镜”、金底白字“表情包”， 三个标签与上方大字严格左对齐 ；标签下方一行白色小字“一键2K直出”， 同样左对齐，与标签间距一致 。\n\n电影级打光，8K细节，皮肤与布料材质真实。整体排版疏密有致：文字区、面板区、人物区三块泾渭分明，互不拥挤。所有文字清晰锐利笔画完整。画面中除上述文字外，无任何其他文字", "", 1024], "inputs": [{"name": "clip", "link": 753, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "link": 754, "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "images.image_2", "link": 755, "label": "参考图 2 (Image-2)", "type": "IMAGE", "localized_name": "参考图 2 (Image-2)"}, {"shape": 7, "name": "images.image_3", "link": 756, "label": "参考图 3 (Image-3)", "type": "IMAGE", "localized_name": "参考图 3 (Image-3)"}, {"shape": 7, "name": "images.image_4", "li