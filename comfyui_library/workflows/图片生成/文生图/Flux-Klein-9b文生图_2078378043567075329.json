木制托盘和玻璃瓶形成对角线构图，右下角的杂志上有帐篷插图。露营车以45°的角度停放以展示车身细节。三角形帐篷增加了防水缝线。背景特征包括圆形湖泊和放射状的树冠。\n（杰作：1.2），最佳品质，杰作，高分辨率，原创，极其精细的壁纸，完美光线，（极其精细的CG：1.2），绘画，画笔，杰作，最佳品质，8K，疯狂的细节，错综复杂的细节，超精细，超高品质，高细节，极致精细，"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {"pinned": true}, "type": "PrimitiveStringMultiline", "title": "Prompt", "mode": 0, "bgcolor": "#535", "size": [390, 130], "pos": [-1000, 830], "id": 76, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.9.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PrimitiveStringMultiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 10}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "qgn_navigation_groups": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "qgn_locked": false, "VHS_latentpreviewrate": 0, "frontendVersion": "1.38.13", "VHS_latentpreview": false, "ds": {"offset": [1670.9501908267825, -533.5234915862982], "scale": 0.9646149645000015}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 1, "title": "设置组", "bounding": [-1020, 620, 430, 860]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 2, "title": "工作组", "bounding": [-1020, 1500, 1010, 820]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 3, "title": "图片保存", "bounding": [-570, 620, 560, 860]}], "links": [[162, 94, 0, 86, 0, "MODEL"], [163, 97, 0, 86, 1, "CONDITIONING"], [165, 93, 0, 87, 0, "NOISE"], [166, 86, 0, 87, 1, "GUIDER"], [167, 84, 0, 87, 2, "SAMPLER"], [168, 85, 0, 87, 3, "SIGMAS"], [169, 89, 0, 87, 4, "LATENT"], [170, 87, 0, 88, 0, "LATENT"], [171, 96, 0, 88, 1, "VAE"], [175, 95, 0, 97, 0, "CLIP"], [176, 88, 0, 9, 0,