078125, 160.94677734375], "inputs": [{"name": "anything", "link": 4, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 5, "type": "easy cleanGpuUsed", "properties": {"cnr_id": "comfyui-easy-use", "ver": "2b4b38ce036ff624a56106ffe00f14d453f1d381", "Node name for S&R": "easy cleanGpuUsed"}, "order": 13}, {"outputs": [{"name": "MODEL", "links": [10], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#432", "widgets_values": ["qingsha flux-lora-000004.safetensors", 1], "inputs": [{"name": "model", "link": 16, "label": "model", "type": "MODEL", "localized_name": "model"}], "flags": {}, "type": "NunchakuFluxLoraLoader", "mode": 0, "bgcolor": "#653", "size": [334.3122863769531, 82], "pos": [914.222412109375, 138.8182373046875], "id": 13, "properties": {"cnr_id": "ComfyUI-nunchaku", "ver": "f9e1a202db7b0233a525be4ba15d3b8efc88fc7b", "aux_id": "mit-han-lab/ComfyUI-nunchaku", "Node name for S&R": "NunchakuFluxLoraLoader"}, "order": 5}, {"outputs": [{"name": "translation", "links": [15], "label": "translation", "type": "STRING", "localized_name": "translation"}], "color": "#232", "widgets_values": ["服饰​​：\n\n一袭淡雅纱衣（如浅紫/水蓝/月白色），外披半透明轻纱帔帛，衣袂飘飘若流风回雪。\n纱衣绣有暗纹（如梅花、云鹤、缠枝莲），袖口与裙裾缀银丝滚边，腰间束素色织锦带，凸显纤腰如柳。\n唐代风格可加金丝薄烟纱帔子，宋代风格则叠穿多层纱衣，层次分明。\n​​容貌与姿态​​：\n\n肌肤莹润如雪，眉若远山含黛，唇点浅朱，眸似秋水含情。\n手持团扇或执一枝新荷，步履轻盈如踏云，回眸时纱衣流转如波光。\n​​发饰与细节​​：\n\n高髻簪牡丹或灵蛇髻斜插碧玉步摇，鬓边垂珍珠流苏，随风轻颤。\n耳坠琥珀或翡翠，腕间白玉镯与纱衣相映，颈佩璎珞项圈。\n​​场景与氛围​​：\n\n背景可选宫廷朱栏、荷塘月色或竹林雾霭，突出纱衣的飘逸感。\n可添加“风吹纱动显肌理”“夕阳下纱衣泛柔光”等光影细节。", 1649, "randomize", "auto"], "inputs": [], "flags": {}, "type": "RH_Translator", "mode": 0, "bgcolor": "#353", "size": [376.26202392578125, 332.6712341308594], "pos": [411.153076171875, 649.7757568359375], "id": 14, "properties": {"Node name for S&R": "RH_Translator"}, "order": 3}, {"mode": 0, "outputs": [{"name": "width", "links": [11], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [12], "label": "height", "type": "INT", "localized_nam