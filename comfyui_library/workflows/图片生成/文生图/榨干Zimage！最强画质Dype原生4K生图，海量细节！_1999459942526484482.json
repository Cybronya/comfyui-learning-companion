: 0, "outputs": [{"name": "string", "links": [80], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [444.2389221191406, 502.7323913574219], "pos": [1043.689208984375, -390.9176940917969], "widgets_values": ["雨夜霓虹都市街景，湿漉漉的柏油路倒映着高楼与悬浮列车的炫彩光影。前景中，行人撑着各色雨伞匆匆穿行，衣着日常却被未来感建筑映衬得格外真实；左侧街边小摊灯火通明，贩卖着热食与汽水，烟火气与科技感交织。中景处，高架轨道上一列涂鸦装饰的磁悬浮列车正缓缓驶过，车窗内隐约可见乘客身影；右侧巨型锈蚀机械人矗立于工业管道之间，喷射水雾如喷泉般洒落，其金属关节与斑驳锈迹暗示着被遗忘的工业遗产。背景是林立的赛博朋克摩天大楼，巨幅像素化广告牌闪烁着“FINESSA”“ADUVEY”等品牌标识，霓虹灯带如血管般缠绕建筑立面，天空中两艘悬浮飞行器低空掠过，留下淡淡的尾迹。构图采用对角线引导，从左下角的行人视线延伸至右上角的机械巨像，形成强烈纵深感；画面中心被雨伞与蒸汽云雾轻柔分割，视觉焦点自然落在机械人与列车交汇处。色调以深蓝、紫罗兰、霓虹粉与金属灰为主，辅以暖黄街灯与雨滴反光，营造出潮湿、迷离又充满活力的赛博都市氛围。光影交错于建筑立面与地面水洼，霓虹光晕在雨幕中晕染开，形成梦幻般的粒子效果；机械人喷雾与蒸汽在空气中凝结成朦胧雾气，增强了画面的动态与层次。整体氛围兼具日常生活的烟火气与未来科技的冷峻感，仿佛在雨夜中穿梭于现实与虚拟的边界，既真实又超现实，极具视觉冲击力与沉浸感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 36, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 4}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [3, 4], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [480, 216], "pos": [1509.7767333984375, -379.640380859375], "widgets_values": [""], "inputs": [{"name": "clip", "link": 62, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 80, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 5, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.71", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 13}, {"outputs": [{"name": "Patched Model", "links": [55], "label": "Patched Model", "type": "MODEL", "localized_name": "Patched Model"}], "color": "#322", "widgets_values": [2560, 2560, "auto", "vision_yarn", true, true, 1024,