ctable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "DyPE_FLUX"}, "order": 9}, {"outputs": [{"name": "STRING", "links": [305], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#332922", "widgets_values": ["一位年轻亚洲男性正对着镜头露出灿烂笑容，嘴角上扬带动脸颊肌肉自然起伏，牙齿洁白整齐，眼神明亮有神，充满活力与亲和力；黑色短发略带蓬松纹理，前额微湿似刚洗过头或受热影响，增添真实生活气息；身穿纯黑圆领T恤，简洁无装饰，凸显人物面部表情为画面焦点。\n\n场景位于室内居家环境，墙面素白干净，左上方悬挂一台白色壁挂式空调机，机身贴有蓝色标签但模糊不清；右侧可见一扇浅灰木纹门板边缘，门框处隐约附着红色福字剪纸一角，暗示节日气氛或传统家居布置。\n\n构图为近景特写，人物居于画幅中央偏下位置，头部占据约三分之二高度，视线直视前方形成强烈互动感；光线来自正面柔和光源（如手机前置灯），均匀照亮脸部未产生明显阴影，皮肤质感细腻呈现轻微毛孔及汗珠光泽，增强现实感；整体色调以黑白灰为主调辅以红点缀，营造温馨而朴素的生活化美学风格。\n\n画面采用略微仰拍视角，使人物更显亲切饱满；暗部过渡平滑不突兀，符合普通消费级摄像头拍摄特征——像素略有噪点、色彩饱和度适中、边缘稍软却保留丰富层次。整个影像传递轻松愉悦的情绪基调，在平凡生活中捕捉到纯粹的笑容瞬间，极具人文温度与纪实美感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "Text Multiline", "mode": 0, "bgcolor": "#593930", "size": [449.5937805175781, 187.9716339111328], "pos": [329.2640075683594, 1237.9700927734375], "id": 163, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "Text Multiline"}, "order": 8}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "workspace_info": {"saveLock": false, "id": "3X7qbjPuJEeamXz7sOJD3"}, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.34.9", "VHS_latentpreview": false, "ds": {"offset": [-157.89356464499645, -643.3206917829393], "scale": 0.9646149645000035}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "SeedVR2放大", "bounding": [956.8289184570312, 1662.7283935546875, 618.8623046875, 628.594482421875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "TTP放大", "bounding": [-190.7646026611328, 1659.7257080078125, 1105.6805419921875, 612.48095703125]}, {