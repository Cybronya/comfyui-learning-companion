ocalized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["\"A stunning young Chinese fantasy girl in her early twenties, with a slender and graceful figure, long flowing straight black hair, and striking large blue eyes. She wears an elegant, semi-transparent white gown adorned with delicate lace patterns and voluminous romantic sleeves. She stands gracefully within a mystical ancient Chinese garden filled with misty pathways, traditional red pavilions, koi-filled ponds, and stone arch bridges. Towering crystalline peonies bloom around her, glowing softly in the twilight. The atmosphere is dreamlike and surreal, illuminated by floating lanterns and shimmering light. The style is cinematic magical realism, highly detailed, 8K resolution."], "inputs": [{"name": "clip", "link": 127, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 134, "type": "STRING"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [349.778564453125, 184.0186004638672], "pos": [47.58707046508789, 461.3118591308594], "id": 6, "properties": {"cnr_id": "comfy-core", "ver": "0.3.24", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 13}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [42], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#233", "widgets_values": [3.5], "inputs": [{"name": "conditioning", "link": 41, "label": "conditioning", "type": "CONDITIONING", "localized_name": "conditioning"}], "flags": {}, "type": "FluxGuidance", "mode": 0, "bgcolor": "#355", "size": [336.7859802246094, 134.40354919433594], "pos": [50.206642150878906, 272.8116760253906], "id": 26, "properties": {"cnr_id": "comfy-core", "ver": "0.3.24", "widget_ue_connectable": {}, "Node name for S&R": "FluxGuidance"}, "order": 15}, {"mode": 0, "outputs": [{"name": "translation", "links": [131], "label": "translation", "type": "STRING", "localized_name": "translation"}], "size": [405.9673767089844, 223.7117919921875], "pos": [-411.0615539550781, 962.4677124023438], "widgets_values": ["一位惊艳的年轻中国幻想女孩，年龄在二十出头，身材苗条优雅，拥有一头长长的顺滑黑发和引人注目的蓝色大眼睛。她身穿一件精致的半透明白色长裙，饰有细腻的蕾丝图案和蓬松浪漫的泡泡袖。她优雅地站在一座神秘的古代中国园林中，园中有雾气缭绕的小径、传统的朱红亭台、锦鲤游动的池塘以及石拱桥。她周围盛开着高耸入云的水晶般质感的牡丹，在暮色中柔和发光。整个场景充满梦幻与超现实的氛围，漂浮的灯笼与闪烁的光影交织其中。整体风格为电影感十足的魔幻现实主义，细节丰富，8K超清画质\n人物特写，电影光照，写实风格", 269, "randomize", "auto"], "inputs": [], "flags": {}, "id": 50, "type": "RH_Translator", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Translator"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [9], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [323.23687744140625, 57.03860092163086], "pos": [446.5792541503906, 355.3055725097656], "widgets_values": [], "inputs": [{"name": "samples", "link": 24, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 12, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 8, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.24", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 19}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.4", "VHS_latentpreview": false, "groupNodes": {}, "node_versions": {"comfy-core": "0.3.24"}, "ds": {"offset": [1037.852286384849, 90.72407632317588], "scale": 0.7247295000000019}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "提示词润色", "bounding": [-414.72186279296875, 148.08616638183594, 415.853271484375, 765.1316528320312]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "lora", "bounding": [432.7325439453125, 890.3225708007812, 368.2020263671875, 313.2767028808594]}], "links": [[9, 8, 0, 9, 0, "IMAGE"], [12, 10, 0, 8, 1, "VAE"], [19, 