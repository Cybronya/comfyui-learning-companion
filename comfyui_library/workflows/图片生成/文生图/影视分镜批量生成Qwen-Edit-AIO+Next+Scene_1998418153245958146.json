ue_connectable": {}}, "order": 22}, {"mode": 0, "outputs": [{"name": "*", "links": [], "label": "*", "type": "*"}], "size": [270, 60], "pos": [2300, 1900], "widgets_values": ["prompt"], "inputs": [{"name": "STRING", "link": 103, "label": "STRING", "type": "STRING"}], "flags": {}, "id": 39, "type": "SetNode", "title": "Set_STRING", "properties": {"previousName": "prompt", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}}, "order": 25}, {"outputs": [{"shape": 6, "name": "STRING", "links": [103], "label": "STRING", "type": "STRING", "localized_name": "STRING"}, {"shape": 6, "name": "COMBO", "links": [], "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#233", "widgets_values": ["Next Scene:主体为身着华美汉服、头戴金红珠翠发冠的女子（昭君），立于风雪中，目光望向远方匈奴方向，神情略带惆怅与坚毅；场景是漫天飞雪的塞外荒原，远处山峦覆雪朦胧；运动为头部微转、目光远眺，镜头慢推；美学控制是中景、侧光+雪景柔光、冷调高对比，呈现汉服刺绣与发冠金饰的精致，景别中景。\n\nNext Scene:主体为昭君，轻抚腰间玉佩，指尖冰凉，雪花落在手背随即融化；场景是雪地中的驿站旁，残破的旌旗在风雪中飘摇；运动为手部轻触玉佩、指尖微动，镜头特写；美学控制是近景、特写镜头、细腻光影，突出玉佩纹理与雪花动态，景别特写。\n\nNext Scene:主体为昭君，骑于马上，红袍在风雪中翻飞，发冠流苏随马步轻晃；场景是风雪交加的塞外古道，马蹄踏碎薄冰，远处有匈奴使者队伍的模糊轮廓；运动为骑马缓行、袍摆飞扬，镜头跟拍；美学控制是中景、跟拍镜头、电影感构图，呈现人物与环境的动态交融，景别中景。\n\nNext Scene:主体为昭君，立于营帐前，望着帐内匈奴单于送来的暖裘，神情复杂；场景是匈奴营地，帐外风雪呼啸，帐内灯火隐约；运动为身体微侧、目光扫过暖裘，镜头侧移；美学控制是中近景、侧移镜头、冷暖光影对比，突出人物内心的挣扎与环境的孤寂，景别中近景。\n\nNext Scene:主体为昭君，在匈奴宫廷中，身着融合汉匈风格的服饰，手持胡笳，目光平和望向殿外飞雪；场景是匈奴宫殿，内饰带有游牧民族特色，殿外雪花纷飞；运动为手持胡笳、姿态优雅，镜头环绕；美学控制是中景、环绕镜头、写实风格，呈现文化融合的细节与人物的从容，景别中景。", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "link": 102, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "start_index"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "max_rows"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [270, 470], "pos": [2300, 2000], "id": 16, "properties": {"cnr_id": "comfyui-easy-use", "ver": "11794f7d718dc38dded09e677817add796ce0234", "ue_properties": {"widget_ue_connectable": {"start_index": true, "max_rows": true, "prompt": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"start_index": true, "max_rows": true, "prompt": true}, "Node name for S&R": "easy promptLine"}, "order": 20}, {"mode": 0, "outputs": [], "size": [2640, 1130], "pos": [2610, 1360], "widgets_values": [], "inputs": [{"name": "images", "link": 17, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 13, "type": "PreviewImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.60", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 27}, {"outputs": [], "color": "#232", "widgets_values": ["你需要学习这个文档内容，然后我会给你一张图片，你需要给我一个5秒的图生视频的提示词。\n\n提示词的公式是：视频提示词= 运动 + 运镜\n运动描述：结合图像中的元素（如⼈物、动物），描述其相动态的过程，如奔跑、打招呼，可以通\n过形容词来控制动态的程度与速度，如“快速地”、“缓慢地”。\n运镜：若对镜头运动有特定要求，通过提示词如“镜头推进”、“镜头左移”控制，若希望镜头不要发\n⽣变化，可以通过“固定镜头”来强调。\n同时也需要结合影视级没血控制，光源，光线，景别文档中的视频类型来创建。5秒的图生视频提示词需要给到2-3个镜头。按秒给，比如第1秒，第2-3秒。\n"], "inputs": [], "flags": {}, "type": "Note", "title": "图生视频交付格式-提示词", "mode": 0, "bgcolor": "#353", "size": [290, 890], "pos": [1000, 430], "id": 55, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}}, "order": 9}, {"outputs": [], "color": "#232", "widgets_values": ["【输入方式】：参考图 + 文本描述  \n【延展目标】：基于上一张图的画面风格、人物外形、光影氛围、镜头语言，生成下一张分镜图，使得剧情延续\n提⽰词=主体（主体描述）+场景（场景描述）+运动（运动描述）+美学控制+风格化\n\n保持人物外观一致  \n色调光影与参考图统一  \n背景元素延续，不突变  \n构图具备电影感（景别/光影/空间层次）\n\n镜头类型（特写/中景/远景/俯拍/跟拍/环绕/侧移/拉远）  \n镜头运动节奏（慢推/快切/手持感）  \n\n人物发色、身形不变  \n服饰延续衔接，不跳变  \n动作表情是上一个镜头的自然推进  \n背景环境连续递进\n\n高清画面  \n电影级光影  \n真实材质  \n无噪点无畸变  \n可作为下一张分镜生成基础\n\n输出时以Next Scene:开头，后面马上接文字。每一段文字是连续的，没有特殊符号，没有多余的解释，每一段文字100字左右，直接输出内容。"], "inputs": [], "flags": {}, "type": "Note", "title": "参考图出分镜交付格式-提示词", "mode": 0, "bgcolor": "#353", "size": [290, 1150], "pos": [1000, 1360], "id": 54, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}}, "order": 10}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [47], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [950, 690], "pos": [1340, 1410], "widgets_values": ["ac9e7c11ce5daa02782a0f5fa6cdc5cb2e20f32e6b361d2b8be6823bde0de5cf.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 10, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.60", "ue_properties": {"widget_ue_connectable": {"image": true, "upload": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 11}, {"outputs": [{"name": "MODEL", "links": [75], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#233", "widgets_values": ["next-scene_lora-v2-3000.safetensors", 0.8], "inputs": [{"name": "model", "link": 95, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#355", "size": [380, 90], "pos": [1340, 1090], "id": 4, "properties": {"cnr_id": "comfy-core", "ver": "0.3.60", "ue_properties": {"widget_ue_connectable": {