e": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "调度器"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {}, "id": 88, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "ue_properties": {"widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "Node name for S&R": "KSampler"}, "order": 11}, {"outputs": [{"name": "MODEL", "links": [263], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#223", "widgets_values": ["赛璐璐平涂动漫风格Qwen2.1_2000.safetensors", 0.5], "inputs": [{"name": "model", "link": 256, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#335", "size": [366.29730224609375, 82], "pos": [259.43927001953125, -1633.619873046875], "id": 198, "properties": {"cnr_id": "comfy-core", "ver": "0.39.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"lora_name": true, "strength_model": true}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 7}, {"outputs": [{"name": "positive", "links": [101], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "links": [102], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent", "label": "latent", "type": "LATENT", "localized_name": "latent"}], "color": "#232", "widgets_values": ["风格限定：赛璐璐平涂动漫风格，日系二次元清冷禁欲系男神原画质感，清晰利落的墨色轮廓线，平整块面铺色，衬衫面料、金属配饰、发丝光晕处辅以柔和渐变过渡，明暗边界干净清晰；适配现代都市/暗黑系男性半身人像立绘创作，兼顾平涂画风利落表现力与神秘冷感氛围，动画剧场版视觉质感；\n视角构图：竖版半身人像特写构图，正面平视微仰视机位，人物位于画面绝对视觉中心，三分法结合中心构图，人物占据画面主体，头顶与画面左右适度留白，背景虚化平涂实现虚实分层构图，突出人物五官与配饰细节，图片比例 9:16；\n主体描述：清冷慵懒的年轻男性，自带生人勿近的厌世感与暗黑哥特气质；冷白皮色，银灰色微卷碎发，发丝凌乱富有层次，发梢微翘，几缕碎发自然垂落在额前与眉眼间；脸部识别点：狭长深邃的紫色眼眸，眼尾微微上挑并晕染着淡淡的紫红色眼影，眼神淡漠疏离、微微向下睥睨，鼻梁挺拔，自然浅色薄唇微抿，下颌线极其锋利；身材高挑清瘦，肩颈线条硬朗，完美展露深刻的锁骨；身着深紫色宽松长袖衬衫，面料顺滑带有轻微光泽，领口大敞，露出大片冷白胸膛与锁骨；配饰丰富：颈部佩戴黑色宽边皮质Choker（正中心嵌有银色十字架金属吊坠），胸前叠戴多层银色金属细链条项链（一条坠有黑色十字架，一条坠有菱形银色边框紫宝石）；左耳佩戴黑色圆环耳钉、紫色发光十字架长坠耳环与蓝紫渐变宝石耳骨钉；\n背景设定：暗黑赛博哥特风的现代都市雨夜街头，人物身后是虚化平涂处理的欧式复古路灯与高耸的现代建筑轮廓，远处闪烁着紫色的霓虹灯牌，空气中飘落着细密的雨丝，湿滑的柏油路面积水倒映着幽暗的紫蓝色光斑与霓虹倒影，烘托人物冷感神秘的气场，不喧宾夺主；\n细节修饰：精细化刻画人物干净利落的面部轮廓与凌厉的下颌线，细化紫色眼眸通透的星形高光层次与眼尾红晕；细化银灰色短发的发丝分层走向、凌乱感与边缘的冷色轮廓光；平涂还原深紫衬衫的顺滑布料质感、领口的自然褶皱与阴影、以及敞口处的胸膛肌肤肌理；精细刻画黑色皮质Choker的哑光皮纹与金属铆钉、银色十字架项链的金属冷硬反光、以及宝石切割面的折射质感，左耳多款耳饰的金属光泽与紫色微光点缀；刻画背景雨丝的平涂线条、路面水洼的霓虹色块反光以及远处的虚化光斑；优化人物整体轮廓线条，色块平整均匀，无毛刺、无画面畸变、无抠图割裂瑕疵；\n光影色调：遵循赛璐璐平涂光影逻辑，主光源为正面微偏左上的冷调柔光，打亮人物面部、锁骨与衬衫的高光区域；背景的紫色霓虹灯牌与冷蓝路灯作为侧逆光环境光，在人物银灰发丝、紫衬衫边缘与金属配饰上形成华丽的冷艳轮廓光（Rim Light）；阴影深邃且边界清晰，暗部色块平整；固定主色调：深紫色、冷银灰、纯黑、幽蓝夜色、霓虹紫；色彩对比强烈，暗部沉稳，高光利落，精准还原平涂光影质感，烘托清冷、神秘、禁欲的暗黑赛博都市氛围；\n质量词：高清极致画质、构图完整协调、细节丰富饱满、线条干净流畅、光影层次分明、色彩柔和统一、色块平整均匀、画面精致无瑕，清冷暗黑系男神氛围感拉满，无画面畸变，金属皮革质感表现到位；\n图片比例：9:16", "", 1024], "inputs": [{"name": "clip", "link": 100, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_n