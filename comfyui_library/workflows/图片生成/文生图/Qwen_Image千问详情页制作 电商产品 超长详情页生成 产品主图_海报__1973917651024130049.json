 "*", "localized_name": "anything"}], "flags": {"collapsed": true}, "type": "easy cleanGpuUsed", "mode": 0, "bgcolor": "#353", "size": [140, 26], "pos": [2935.416259765625, 868.3665161132812], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy cleanGpuUsed"}, "order": 9}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [6], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "shape": 1, "widgets_values": [""], "inputs": [{"name": "clip", "link": 9, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 10, "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": true}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [320.119140625, 148.76280212402344], "pos": [2957.554443359375, 573.0448608398438], "id": 9, "properties": {"cnr_id": "comfy-core", "ver": "0.3.48", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 14}, {"outputs": [{"name": "VAE", "slot_index": 0, "links": [34], "type": "VAE", "localized_name": "VAE"}], "color": "#232", "shape": 1, "widgets_values": ["qwen_image_vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "type": "VAELoader", "mode": 0, "bgcolor": "#353", "size": [249.863525390625, 66.9263916015625], "pos": [2917.95556640625, 430.4658203125], "id": 11, "properties": {"cnr_id": "comfy-core", "ver": "0.3.48", "widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 5}, {"outputs": [{"name": "text", "links": [19], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["白色简约背景下，一副通体银灰色的蓝牙耳机平铺中央，耳机外壳光滑圆润，充电盒开盖呈 45 度角，露出内部嵌放的耳机主体，盒身侧面的 Type-C 充电口清晰可见，光线从左上方柔和打下来，在底部形成浅淡阴影，整体质感细腻，突出产品的简约设计，无文案。\n场景切换至办公桌，同一款银灰色蓝牙耳机放在木质桌面上，旁边是打开的笔记本电脑，屏幕显示着音乐播放界面，一只手正拿起其中一只耳机准备佩戴，背景中散落着几本工作手册和一杯热咖啡，暖色调灯光营造出轻松的办公氛围，与第一张图的产品色调相呼应，无文案。\n户外街道场景，一位穿着浅灰色运动外套的人正在慢跑，耳朵上戴着这款蓝牙耳机，耳机与耳廓贴合自然，线材（若为颈挂式则突出颈挂部分的灵活性）随动作轻微摆动，背景是虚化的街道绿植和晨跑人群，阳光透过树叶洒下光斑，整体充满活力，产品在动态中展现稳定性，无文案。\n近距离特写耳机佩戴状态，聚焦于耳朵与耳机的贴合处，展现耳塞的柔软质感和人体工学设计，耳机外壳的触控区域有微光闪烁，暗示操作便捷性，背景虚化处理为浅米色，与耳机的银灰色形成温和对比，延续整体简约风格，无文案。\n家庭客厅场景，沙发上放着平板电脑，屏幕播放着电影画面，同款蓝牙耳机放在平板旁，充电盒处于关闭状态，旁边有一个无线充电板，暗示耳机支持无线充电功能，客厅灯光柔和，沙发靠垫为浅灰色系，与产品色调协调统一，无文案。\n多人聚会场景，几个人围坐在一起，其中一人戴着这款蓝牙耳机，正通过耳机与人通话（可展示耳机的降噪功能，背景人物动作虚化），周围环境温馨，家具色调以浅木色和灰色为主，与产品的整体风格保持一致，无文案。\n产品全家福展示，蓝牙耳机（含左右耳）、充电盒、充电线、不同尺寸的备用耳塞整齐摆放在浅灰色托盘上，背景为白色渐变，光线均匀，突出产品的完整配件，画面风格回归简约，与第一张图形成首尾呼应，让整套详情页过渡自然，无文案。​\n场景切换至办公桌，同一款银灰色蓝牙耳机放在木质桌面上，旁边是打开的笔记本电脑，屏幕显示着音乐播放界面，一只手正拿起其中一只耳机准备佩戴，背景中散落着几本工作手册和一杯热咖啡，暖色调灯光营造出轻松的办公氛围，与第一张图的产品色调相呼应，无文案。\n深蓝色渐变背景，一副黑色蓝牙耳机悬浮于中央，充电盒半开，耳机机身的金属线条在侧光下泛着冷光，盒盖内侧的电量指示灯亮着绿光，整体呈现出科技感满满的视觉效果，无文案。\n深夜卧室场景，一个人躺在床上，戴着这款黑色蓝牙耳机，手机放在枕边播放着助眠音频，房间只开着一盏暖黄色小夜灯，耳机在暗光中显得低调沉稳，与周围环境的静谧氛围相契合，无文案。\n\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [489.6063537597656, 849.4739379882812], "pos": [1141.6883544921875, 395.4293518066406], "id": 23, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1293.1675753057734, 1512.3823678303004], "scale": 0.16105100000000014}}, "groups": [{"color": "#A88", "font_size": 24, "flags": {}, "id": 3, "title": "输入提示词，每段对应一张图", "bounding": [1131.4918212890625, 312.9260559082031, 505.27215576171875, 940.530029296875]}, {"color": "#A88", "font_size": 30, "flags": {}, "id": 28, "title": "模型采样生成区", "bounding": [1642.400146484375, 311.4122619628906, 2147.930419921875, 1578.4342041015625]}, {"color": "#b06634", "font_size": 24, "flags": {}, "id": 29, "title": "白边高度", "bounding": [1668.402587890625, 692.37646484375, 275.2850341796875, 186.5176239013672]}, {"color": "#b06634", "font_size": 24, "flags": {}, "id": 30, "title": "每