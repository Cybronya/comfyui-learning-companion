dgets_values": ["手机实拍质感，时长调整到十秒，再给我一组nanobanana图像提示词 \n\n镜头保持静止，老妇人位于镜头中央。画面采用中景客观镜头构图。老妇人坐在车厢后座，目光直视前方镜头。背景伴随极其细微的车辆怠速低频嗡嗡声。老妇人双唇开启，发出略带沙哑且音量适中的女性嗓音，语速平稳地说道：“如果他失业了怎么办？”伴随发音，她的面部肌肉规律牵引，下巴轻微上下开合。头部随着说话的节奏产生极小幅度的左右轻晃。老妇人右手握持手机，手腕随语音顿挫产生轻微的上下点动；左手手指轻轻搭在腿部的手提包上，指尖微动，同步传出微弱的皮革摩擦“沙沙”声。略微停顿半秒后，她继续用平稳的语调发声：“失业的男人就像过期的优惠券，毫无价值还占地方。”在这句话的输出过程中，她的头部随着字词的发音有轻微的前倾点动动作。身体躯干随着平缓的呼吸起伏，外套表面产生极其细微的布料摩擦声。光线持续稳定地照射在主要拍摄对象的面部，无明显光影变化，老妇人保持原有的姿势与视线方向直至语音结束。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 26, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 9}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [2914.1723692612377, 305.30430553278956], "scale": 0.5989500000000036}}, "groups": [], "links": [[1, 1, 0, 2, 0, "IMAGE"], [2, 2, 0, 3, 0, "IMAGE"], [3, 4, 0, 5, 0, "IMAGE"], [4, 7, 0, 5, 10, "STRING"], [5, 5, 0, 6, 0, "IMAGE"], [6, 8, 0, 2, 11, "STRING"], [10, 15, 0, 13, 17, "STRING"], [11, 13, 0, 14, 0, "IMAGE"], [13, 17, 0, 13, 0, "IMAGE"], [14, 18, 0, 13, 20, "STRING"], [15, 19, 0, 13, 1, "IMAGE"], [19, 27, 0, 28, 10, "STRING"], [20, 26, 0, 28, 11, "STRING"], [22, 28, 0, 30, 0, "*"]], "id": "e4211902-2d6f-4f58-b140-9891b47e9dda", "config": {}, "version": 0.4, "last_node_id": 30, "revision": 0}