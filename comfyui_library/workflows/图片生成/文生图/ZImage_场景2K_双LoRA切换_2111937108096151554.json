operties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "INTConstant"}, "order": 3}, {"outputs": [{"name": "value", "links": [442], "label": "值", "type": "INT", "localized_name": "value"}], "color": "#4c4a3e", "widgets_values": [1080], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "值", "type": "INT", "localized_name": "值"}], "flags": {"collapsed": false, "disabled": false}, "type": "INTConstant", "mode": 0, "bgcolor": "#333229", "size": [380, 80], "pos": [1480, 440], "id": 276, "properties": {"cnr_id": "comfyui-kjnodes", "ver": "e8e88f7c88e3f6205b122f5de87e69a09fbce5ac", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "INTConstant"}, "order": 4}, {"outputs": [{"name": "text", "links": [444], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#41445c", "widgets_values": ["海边山坡上一座停用的气象观测站，黎明将至，低矮的圆形建筑面向辽阔海湾，外墙覆着褪色的蓝灰涂层，盐蚀痕迹沿接缝蔓延。屋顶立着缓慢转动的风向标，金属百叶箱旁生长着被海风压弯的野草。通往岸边的石阶缺了几级，锈红色护栏上凝着细小露珠，台阶尽头停着一辆老式自行车，车篮里放着折叠的米色雨衣。远处潮水退去，露出交错的礁石与湿润沙滩，一艘小渔船正驶离防波堤，身后留下细长的白色航迹。\n\n天际透出浅淡的银粉色，冷白晨光掠过建筑边缘，背光处呈现低饱和石墨灰。海雾分布在不同距离，近处草叶与剥落漆面清晰可辨，远方岛屿逐渐消隐。环境安静空旷，带有等待某人归来的叙事意味。画面无人。\n\n实景外拍观感，35mm广角，f/5.6，平视取景，石阶从右下角引向观测站，地平线位于画幅上三分之一。保留自然明暗关系和克制的色彩，金属氧化、潮湿石面、植物叶脉各有真实触感，避免锐化光晕与塑料般的表面。横向宽幅构图，留出足够天空与海面，空间纵深明确。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false, "disabled": false}, "type": "CR Text", "mode": 0, "bgcolor": "#2d2f40", "size": [680, 460], "pos": [660, 310], "id": 277, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "versi