ndTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "KSampler", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [46], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": [""], "inputs": [{"name": "clip", "link": 74, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 131, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [422.84503173828125, 164.31304931640625], "pos": [390, 60], "id": 6, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"mode": 0, "outputs": [{"name": "STRING", "links": [131], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [400, 200], "pos": [-34.09437561035156, -235.32339477539062], "widgets_values": ["8K高清，全身像，广角构图。画面定格于唐代女帝立于芙蓉园的水榭长廊之上，夜色清辉，园中池水如镜，倒映宫阙与灯火。远处主殿飞檐高挑，檐角金铃随风轻响，园中亭台与花树层层相映。水面漂浮莲灯，微光点点，仿佛星河坠入凡尘。\n她身着月白与浅金渐变色的唐代宫宴礼服，衣面绣有荷花与游鱼纹，金丝细密，流光在水面反射的波纹中微微颤动。披帛如水雾般轻盈，垂落在长廊朱柱旁。腰间玉带缀以莲瓣形的翡翠挂坠，随着风与步伐发出轻柔碰击声。\n她神情安然，眼神中透出柔和与威严的平衡。唇色淡朱，额心以白玉雕成的莲花钿为饰，高髻稳固，配以镶珍珠与水晶的凤冠，十二旒轻垂，映照出水面灯火的波光。\n背景是芙蓉园的主殿与花木，长廊两侧水面映出如幻的双重世界：上是宫灯与楼阁，下是倒影与莲灯。岸边花树微摇，风送花香与水汽交织。几名宫女立于廊外，静候旨令，不扰她的凝思。\n镜头采用近景低角度，人物在画面中央，前景是木栏与莲灯，背景被延伸至深处的主殿与夜空。整体色调以月白、浅金、湖蓝为主，辅以朱柱与灯火暖光，形成冷暖交错的诗意画面。\n整幅画面细节极其丰富：丝绸的褶皱纹理、莲灯烛芯的微光、池面波纹的细微变化、檐铃的微晃都能清晰可见，如一幅会流动的水月长卷，承载着帝王盛世的静美与华贵。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "