: [295.4065856933594, 2666.538330078125], "widgets_values": ["**视觉总监提示词（1:1宽高比）：**\n\n> 一位年轻男性健身者，身穿灰色短袖T恤与黑色运动短裤，脚踏黑色运动鞋，正坐在一台现代黑色电动健身自行车上，专注地进行室内有氧训练。他双手紧握车把，身体微微前倾，双腿有节奏地踩踏，展现出专注而充满活力的姿态。健身车配备了一块高清显示屏，屏幕上显示着色彩鲜艳的虚拟骑行游戏界面——模拟城市街道、霓虹灯光与动态赛道，营造沉浸式运动体验。背景为明亮现代家居环境：米色布艺沙发配以棕色与深灰靠垫，木质茶几置于左侧，右侧是透光的白色纱帘与落地窗，自然光柔和洒入，营造温馨舒适的氛围。地面铺有浅米色绒毛地毯，与深色健身器材形成视觉对比。镜头采用中景平视角度，聚焦人物与健身车，突出运动与科技融合的现代感。整体色调以中性灰、米白与黑色为主，辅以屏幕霓虹蓝紫光效，光影柔和自然，画面干净利落，充满都市健康生活气息，强调“科技健身+沉浸娱乐”的核心概念。\n\n—— 该提示词严格锚定原图角色造型、场景风格、色彩基调，并强化动作张力与氛围沉浸感，确保生成图像具备高度可执行性与视觉冲击力。"], "inputs": [{"shape": 7, "name": "anything", "link": 21, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 24, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 16}, {"outputs": [{"name": "prompt", "links": [26], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["保持产品原有角度不变"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#335", "size": [346.26580810546875, 261.41632080078125], "pos": [-556.776611328125, 2379.772216796875], "id": 27, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#593930", "groupcolor": "#b06634", "color": "#332922"}}, "order": 9}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4],