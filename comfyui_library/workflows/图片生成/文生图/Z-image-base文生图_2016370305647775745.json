/ 冰晶秘境 / 妖域花海式水墨晕染渐变。\n质感与后期风格：画质为 8K 超清，质感可选水墨氤氲 + 灵雾粒子悬浮、珐琅光泽 + 冰晶通透感、绢本工笔肌理 + 荧光刺绣质感、琉璃流光 + 星云缥缈感、鳞纹细腻 + 妖雾弥漫感；后期可加仙韵朦胧、冷冽清透、光斑叠加、动态流光模糊、水墨晕染渐变、暗部幻纹浮现、高光荧光溢出效果；风格定位东方玄幻美学，兼具梦幻流光感、魔幻诡谲感与东方电影级叙事感，适配跨媒介传播的仙幻 / 秘境 / 仙侠 / 妖域意境。", "一个女生，古风，玄幻，武侠。", "Qwen2.5-3B-Instruct", "none", false, 0.7, 1024, 1168, "randomize"], "inputs": [{"widget": {"name": "system"}, "name": "system", "label": "system", "type": "STRING", "localized_name": "system"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 25, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 19, "type": "Qwen2.5", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Qwen2.5"}, "order": 7}, {"mode": 0, "outputs": [{"name": "text", "links": [25], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [210, 292.14959716796875], "pos": [807.3507080078125, -329.1085205078125], "widgets_values": ["一个女生，古风，玄幻，武侠。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 21, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 4}, {"mode": 0, "outpu