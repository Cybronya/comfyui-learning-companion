套装，外搭全息投影披风（投射数据流光影），手持能量手枪，站在霓虹闪烁的未来都市街头，背景是悬浮车辆与全息广告牌，画面高对比度，冷调为主，科技感与酷飒感拉满", "水墨山水国风写真，人物身着玄色广袖长袍立于悬崖边，背后是水墨晕染的远山云海，冷冽山风扬起衣摆与发丝，侧光突出面部轮廓，画面以浓淡墨色为主，点缀少量赭石色，大气磅礴，兼具侠气与诗意。标题写着“Z-image 批量生图+SD放大”"], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "optional_prompt_list", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [400, 324], "pos": [-2994.913818359375, -254.6931610107422], "id": 11, "properties": {"cnr_id": "comfyui-easy-use", "ver": "9947b8be70e17ceabafa4fa7f476b54626de4704", "widget_ue_connectable": {}, "Node name for S&R": "easy promptList"}, "order": 11}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.32.9", "VHS_latentpreview": true, "ds": {"offset": [2873.433998259861, 426.66495536053213], "scale": 0.8769226950000049}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "放大", "bounding": [-1480.210205078125, -304.48138427734375, 597.3629760742188, 684.4776000976562]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "提示词列表", "bounding": [-3021.4384765625, -313.38006591796875, 524.8067016601562, 686.6616821289062]}, {"color": "#3f789