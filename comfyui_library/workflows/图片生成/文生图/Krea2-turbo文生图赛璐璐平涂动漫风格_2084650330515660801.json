idget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"select": true, "sel_mode": true}, "Node name for S&R": "LatentSwitch"}, "order": 5}, {"outputs": [{"name": "CONDITIONING", "links": [118], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#323", "widgets_values": ["写实风格，照片级真实感，3D 渲染，渐变阴影，复杂纹理细节，模糊，低质量，多余肢体，手部畸形，解剖结构错误，多余手指，面部扭曲，比例失调，油画，水彩，素描质感。"], "inputs": [{"name": "clip", "link": 116, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#535", "size": [400, 200], "pos": [1932.3853759765625, 289.9980773925781], "id": 82, "properties": {"cnr_id": "comfy-core", "ver": "0.28.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 7}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [75], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["SLL，风格限定\n赛璐璐平涂动漫风格，日系动画原画质感，清晰利落的墨色轮廓线，平整块面铺色，少量柔和渐变过渡，明暗边界干净清晰；主打温柔治愈的青春少女叙事感，兼具慵懒氛围感与清新审美，适配二次元角色半身插画、氛围场景创作；电影级视觉叙事感，画面充满松弛自然的灵动美感，动画剧场版视觉质感，融入中国传统配色质感。\n视角构图\n近景半身视角、中心构图，人物居于画面视觉核心，背景海滨场景适度虚化拉开空间层次，横版画幅舒展饱满；大师级构图与配色，画面聚焦人物神态与造型，主次分明、氛围感充足。\n主体描述\n青春少女，白皙通透肤色，雾霾蓝灰色及腰大波浪长发，发尾卷发，发丝蓬松慵懒、卷度自然柔和，细碎刘海修饰脸型，发梢随风微微扬起，冷调发色与浅烟粉色连衣裙形成柔和冷暖对比；暖琥珀金棕色大眼睛，眼瞳点缀多彩细碎高光，睫毛纤长分明，脸颊晕染淡淡粉红腮红，嘴角噙着温柔浅笑，神情清甜治愈；身着浅烟粉色吊带连衣裙，低胸设计，深V领，露肩，胸部区域拉紧的面料细节，自然的胸型曲线，胸部周围的柔和阴影，增加立感，细腻的胸部线条，领口点缀精致白色蕾丝花边，腰间系同色系缎面细带自然打结，裙摆呈现柔和垂坠褶皱，面料轻盈通透；固定静态姿态为侧身轻靠，一手指尖撩起肩上发丝，身姿松弛柔软，自带温柔慵懒的少女气场。\n背景设定\n日落时分的郊外海滨木栈道场景，脚下是浅棕色木质步道，栈道边缘生长着蓬松的芦苇草与浅紫色野花；远处海面泛着橙金落日碎光，天际晕染粉橙渐变的晚霞，几只海鸥剪影悠然掠过天际，整体氛围温柔治愈，与长发连衣裙的少女气质高度契合。\n细节修饰\n精细化刻画大波浪长发的卷度层次、雾霾蓝灰发色的明暗块面与利落墨线轮廓，呈现发丝蓬松飘逸的块面质感；细化眼部多彩高光的层次表现、纤长睫毛的线条细节与脸颊红晕的柔和渐变过渡；精准雕琢连衣裙蕾丝花边的纹样细节、缎面腰带的光泽质感与裙摆褶皱的平整铺色表现；细化木质栈道的纹理层次、芦苇草的蓬松形态与海面落日波光的块面表现，远景晚霞与海鸥剪影虚化过渡自然；优化全身墨色轮廓线条，明暗边界干净清晰，少量柔和渐变过渡自然，整体造型完整规整，无冗余瑕疵。\n光影色调\n以日落黄昏暖金色柔光为环境主光源，搭配柔和电影级面光，冷暖光线交织碰撞；落日余晖侧方铺洒在发丝与裙装上，雾霾蓝灰头发边缘泛出淡金轮廓光，皮肤呈现通透光泽质感，光影层次分明，明暗对比清晰，兼具深邃氛围感与清透质感，呈现浪漫诗意视觉调性；整体主色调为雾霾蓝灰、烟粉、暖金、浅橙，色彩柔和高级，自适应饱和度，专业色彩校准，整体氛围治愈松弛，烘托清新温柔的海滨落日少女氛围感。\n质量词\n手绘大师级杰作，动画剧场版超清画质，构图完整协调，细节丰富饱满，线条干净流畅，光影自然立体，色彩柔和统一，高级质感渲染，画面精致无瑕，高级感拉满。\n图片比例\n9:16"], "inputs": [{"name": "clip", "link": 73, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [395.8930969238281, 210.51416015625], "pos": [1933.3201904296875, 25.96906280517578], "id": 52, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 6}, {"mode": 0, "outputs": [{"name": "VAE", "links": [79], "type": "VAE", "localized_name": "VAE"}], "size": [397.5299377441406, 58], "pos": [1451.2841796875, 223.36990356445312], "widgets_values": ["qwen_image_vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "id": 58, "type": "VAELoader", "properties": {"cnr_id": "comfy-core", "models": [{"name": "qwen_image_vae.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/Krea-2/resolve/main/vae/qwen_image_vae.safetensors"}], "ver": "0.25.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader"}, "order": 1}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [102], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [400.1866760253906, 82], "pos": [1935.6226806640625, -135.82220458984375], "widgets_values": ["赛璐璐平涂动漫风格Krea2_000002