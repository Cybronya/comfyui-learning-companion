antization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 189, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention_mode"}, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}], "flags": {"collapsed": true}, "type": "AILab_QwenVL", "mode": 0, "bgcolor": "#374539", "size": [409.0403747558594, 327.41680908203125], "pos": [702.1110229492188, 1598.2493896484375], "id": 158, "properties": {"cnr_id": "ComfyUI-QwenVL", "ver": "10d736d8d99f0fb1d9625f804cc25d2af0f5319e", "widget_ue_connectable": {"custom_prompt": true}, "aux_id": "1038lab/ComfyUI-QwenVL", "Node name for S&R": "AILab_QwenVL"}, "order": 40}, {"mode": 0, "outputs": [{"name": "STRING", "links": [188], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [357.72119140625, 251.04327392578125], "pos": [670.3429565429688, 1603.569580078125], "widgets_values": ["角色设定\n你是一名专业的文生图提示词优化专家，专门为中文用户服务。你的任务是将用户简短、模糊的中文描述，转化为详细、精确且富有画面感的中文提示词，并确保其能够被文生图模型准确理解。\n\n核心任务\n将用户输入的“基础描述”转化为“优质中文提示词”。\n\n优化流程与规范\n1. 理解与分析\n识别核心要素：明确用户描述中的主体、动作、场景。\n\n判断风格倾向：分析用户潜在需求（如写实、动漫、国风、科幻等）。\n\n捕捉情绪氛围：理解画面需要传递的情绪（如宁静、震撼、欢乐、神秘）。\n\n2. 结构化扩展\n你将按照以下固定结构对提示词进行层层细化：\n\n【画面质量与类型】 + 【核心主体】 + 【场景与环境】 + 【艺术风格】 + 【构图与光影】 + 【色彩与氛围】\n\n每个部分的扩展原则如下：\n\n【画面质量与类型】：自动补充如“最高质量”、“8K分辨率”、“电影质感”、“细节丰富”、“照片级真实感”或“大师级绘画”等标签。\n\n【核心主体】：对人物、生物或主要物体的外观、神态、服饰、材质、动作进行具体描述。\n\n【场景与环境】：详细刻画背景、时间、天气、空间、道具等环境细节。\n\n【艺术风格】：指定如“赛博朋克”、“水墨丹青”、“吉卜力动画”、“蒸汽波”、“北欧极简”等具体风格。\n\n【构图与光影】：设计“全景”、“特写”、“黄金分割”等构图，以及“戏剧性灯光”、“柔光”、“逆光”等光影效果。\n\n【色彩与氛围】：定义“浓郁配色”、“柔和色调”、“冰冷科技感”、“温暖治愈”等色彩和整体氛围。\n\n3. 输出格式\n只需输出最终完整提示词，可直接粘贴给AI绘图工具使用的提示词部分。\n\n提供基础信息如下："], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": true}, "id": 161, "type": "Text Multiline", "properties": {"cnr_id": "pr-was-node-suite-comfyui-47064894", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 12}, {"outputs": [{"name": "value", "links": [178], "label": "值", "type": "INT", "localized_name": "value"}], "color": "#232", "widgets_values": [1080], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "type": "INTConstant", "mode": 0, "bgcolor": "#353", "size": [321.70703125, 63.54548645019531], "pos": [1722.091552734375, 1556.650390625], "id": 95, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "INTConstant"}, "order": 13}, {"outputs": [{"name": "STRING", "links": [191], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#322", "widgets_values": ["半身照，面向镜头"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "type": "Text Multiline", "mode": 0, "bgcolor": "#533", "size": [383.905517578125, 88], "pos": [551.1862182617188, 1556.984130859375], "id": 162, "properties": {"cnr_id": "pr-was-node-suite-comfyui-47064894", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 14}, {"outputs": [], "color": "#432", "shape": 4, "widgets_values": ["古风短剧男主，俊美少年郎，眉眼温润，肤白如玉，墨色长发束起，身着素雅古风长衫，身姿清逸，古典妆容，中式古风布景，写实古风人像，柔光灯效，中景镜头，画质细腻\n\n\n古装侠客，