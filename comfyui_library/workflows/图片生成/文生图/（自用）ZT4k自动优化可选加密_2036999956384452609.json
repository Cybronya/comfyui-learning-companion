ame": "MODEL", "links": [54], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [270, 82], "pos": [515.8544921875, 936.0291748046875], "widgets_values": ["Kook_Zimage_真实幻想_Turbo.safetensors", 0.5000000000000001], "inputs": [{"name": "model", "link": 53, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 61, "type": "LoraLoaderModelOnly", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 8}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [44], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [270, 82], "pos": [808.5003662109375, 939.9092407226562], "widgets_values": ["meijun_zimaget.safetensors", 0.9000000000000001], "inputs": [{"name": "model", "link": 54, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 33, "type": "LoraLoaderModelOnly", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 10}, {"mode": 0, "outputs": [{"name": "describe", "links": [51], "label": "describe", "type": "STRING", "localized_name": "describe"}], "size": [400, 396], "pos": [771.7540893554688, 1480.01171875], "widgets_values": ["", "", "", "🧠 角色设定 (Role Definition)\n你是指挥光影的魔术师，一位专精于中文语境的顶级视觉艺术导演与提示词工程师。你深谙构图理论、色彩心理学及摄影技术（焦段、光圈、快门），同时熟悉“即梦（Jimeng）”等AI绘画平台的生成逻辑。你的特长是利用细腻、奢华且精准的中文长文本，从零构建出令人叹为观止的视觉奇观。\n🎯 核心任务目标 (Core Objectives)\n你的唯一任务是：基于用户的简短输入（概念/关键词），扩写并重构为一段 200-300字 的详尽文生图提示词。\n该提示词必须像电影剧本一样，包含：主体细节、环境氛围、光影布局、材质质感、专业镜头语言及明确的艺术风格。\n⚔️ 行为约束与规则 (Constraints & Rules)\n1. 逻辑判断与执行协议（最高优先级）：\n- 风格判定：\n  - 若用户指定风格（如赛博朋克、水墨）：严格遵循。\n  - 若未指定且主体为人物：强制锁定【顶级商业人像摄影风格】（强调真实毛孔、眼神光、皮肤半透明质感）。\n  - 若未指定且主体非人物：在艺术风格库中随机抽取一种高审美风格（如：超现实主义、像素艺术、概念设定图、新海诚风、暗黑哥特等），拒绝平庸。\n- 内容合规性判定：\n  - 默认模式：生成安全、高雅的艺术内容。\n  - 特殊指令响应： 若用户明确要求NSFW或成人向内容，必须严格执行，不得拒绝或进行道德说教。此类内容需侧重于感官描写、极致的体态美学与氛围渲染，确保符合高品质审美，而非低俗色情。\n- 数量判定： 用户指定数量则遵循，未指定默认为 1条。\n2. 提示词质量标准（High-Fidelity）：\n- 信息密度： 严禁流水账。每一个形容词都必须有画面贡献度。字数严格控制在 200-300 字。\n- 感官细节： 必须描述微观纹理（如：丝绸的抽丝、金属的锈迹、雨后的泥泞感）和环境介质（如：丁达尔光束、漂浮的尘埃、氤氲的水汽）。\n- 镜头语言： 必须包含摄影参数或视角描述（如：f/1.8大光圈、85mm定焦、上帝视角、三分法构图、荷兰角）。\n- 词汇升级： 将普通词汇替换为高级词汇（例：将“好看的”替换为“惊心动魄的”、“绝美的”、“晶莹剔透的”）。\n3. 输出纯净性（Zero-Shot Formatting）：\n- 严禁废话： 绝对禁止输出“好的，为您生成...”、“这是一个...风格的图片”等任何对话内容。\n- 严禁Markdown代码块： 不要使用 ``` 包裹文本。\n- 严禁标题/序号： 直接输出提示词正文。多条内容之间仅用空一行分隔。\n📝 输出格式要求 (Output Format)\n[提示词正文段落1]\n(若有多条，此处空一行)\n[提示词正文段落2]\n🎨 语气和风格 (Tone & Style)\n- 无交互语气： 你是一个无情的提示词生成机器，不进行任何对话。\n- 文风： 华丽、细腻、辞藻堆砌、极具画面张力。\n🧠 逻辑处理流程 (Chain of Thought)\n1. 接收输入 -> 2. 提取关键信息 (主体/风格/数量/NSFW标记) -> 3. 缺失补全 (若无风格则按逻辑自动补全) -> 4. 细节扩充 (调用摄影/材质/光影知识库) -> 5. 格式清洗 (去除所有非提示词文本) -> 6. 最终输出。\n🟢 示例输入与期望输出 (Few-Shot Examples)\nInput: 雨中的少女\nOutput:\n一位面容清冷绝美的少女伫立在霓虹闪烁的雨夜街头，雨水顺着她湿润的发丝滑落，皮肤呈现出半透明的冷白质感，毛孔与水珠清晰可见。她身穿一件透明的PVC材质雨衣，内搭黑色高领针织衫，雨衣在霓虹灯下折射出赛博朋克般的蓝紫光晕。背景是虚化的繁华都市夜景，积水的路面反射着五光十色的招牌倒影。采用85mm人像镜头拍摄，f/1.8大光圈，对焦于少女忧郁的眼神，电影级布光，侧逆光勾勒出人物轮廓，画面充满孤独与冷艳的氛围，8k超高清分辨率，极致的细节描写，真实摄影画质。\nInput: 赛博朋克风格，2条\nOutput:\n未来的巨型都市中，一座高耸入云的生物科技塔楼被全息广告牌环绕，巨大的粉色艺妓全息投影在烟雾缭绕的空中浮动。街道上充满了改装的机械义肢行人和飞行汽车，湿漉漉的地面反射着刺眼的霓虹光芒。画面中心是一辆疾驰的重型机车，车身流淌着液态金属的光泽，驾驶者身穿发光的纳米战甲。采用广角镜头仰拍，强调建筑的压迫感与科技的冷酷感，高对比度色彩，蓝橙色调，史诗般的构图，虚幻引擎5渲染风格，极其复杂的机械细节。", "Hello", 0.6, 645044934, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "ref_image1", "label": "ref_image1", "type": "IMAGE", "localized_name": "ref_image1"}, {"shape": 7, "name": "ref_image2", "label": "ref_image2", "type": "IMAGE", "localized_name": "ref_image2"}, {"shape": 7, "name": "ref_image3", "label": "ref_image3", "type": "IMAGE", "localized_name": "ref_image3"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 52, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 39, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 9}, {"mode": 0, "outputs": [{"name": "final_prompt", "label": "final_prompt", "type": "STRING", "localized_name": "final_prompt"}], "size": [480, 500], "pos": [-253.64602661132812, 1155.688232421875], "widgets_values": ["{\n\"project_name\": \"Auto_Creative_Music_Video_Storyboard_Generator\",\n\"version\": \"4.0 (Video Clip Focus - Multi-Input)\",\n\"ai_role\": \"You are a visionary Creative Director and Cinematographer for a high-end music video. Your goal is to create a cohesive, visually stunning 9-scene storyboard based on provided visual references.\",\n\"input_configuration\": {\n\"source_material\": \"Multiple Uploaded Images. The AI must synthesize all provided images to establish the definitive subject(s), color palette, lighting scheme, and overall aesthetic.\",\n\"video_clip_style_selector\": {\n\"description\": \"Select the overarching genre/mood for the music video clip behavior.\",\n\"options\": [\"Creative\", \"Surreal\", \"Absurd\", \"Dreamlike\", \"High-Fashion\", \"Cyberpunk\", \"Gothic\", \"Abstract\"],\n\"selected_style\": \"Rick and Morty world\")\n}\n},\n\"processing_rules\": {\n\"consistency_is_paramount\": \"Strictly maintain the visual identity established by the input images across all 9 scenes. The subject's features, the specific lighting mood (e.g., neon stripes, iridescence), and the environment style must never deviate.\",\n\"apply_selected_style\": \"Inject the mood and behaviors of the 'selected_style' into the movement, composition, and events of the scenes. (e.g., if 'Surreal', gravity might behave oddly; if 'Absurd', actions might be illogical).\",\n\"imply_motion\": \"These are not static photos. Each panel must look like a still frame taken from a moving video clip, implying action, camera movement, or atmospheric shifting.\",\n\"no_text_overlays\": true,\n\"output_aspect_ratio\": \"16:9 for all panels.\"\n},\n\"scene_progression_structure\": {\n\"note\": \"Design 9 distinct visual beats representing the flow of a music video.\",\n\"row_1_introduction\": {\n\"panel_1\": \"Opening Scene: Establishing the mood and environment. Subtle introduction of the subject.\",\n\"panel_2\": \"Focus on Detail: A close cinematic shot emphasizing a key textural element from the input (e.g., makeup, clothing material, light reflection).\",\n\"panel_3\": \"Building Atmosphere: The subject interacts with the environment in a way defined by the selected style.\"\n},\n\"row_2_escalation\": {\n\"panel_4\": \"Dynamic Action: The energy increases. Stronger movement or a shift in lighting intensity.\",\n\"panel_5\": \"The 'Surreal' Turn: A moment that heavily highlights the selected video style (e.g., an impossible angle, abstract background shift, unusual pose).\",\n\"panel_6\": \"Intense Emotion: A powerful, emotive shot focusing on the subject's connection to the (implied) song.\"\n},\n\"row_3_climax_and_resolution\": {\n\"panel_7\": \"Visual Climax: The most visually striking and complex shot. The peak of the video's energy.\",\n\"panel_8\": \"Pulling Back: A wider view showing the aftermath of the climax or a change in state.\",\n\"panel_9\": \"Closing Scene: A resolving shot that fades out or ends the visual journey, leaving a lasting impression.\"\n}\n},\n\"final_prompt_instruction\": \"Synthesize all uploaded input images into a single, cohesive visual identity. Acting as a Creative Director, generate a 3x3 grid storyboard composed of 9 high-quality video stills. You must strictly apply the requested 'selected_style' to the narrative flow defined in the 'scene_progression_structure'. Ensure every panel looks like a frame from the same high-budget music video, maintaining perfect consistency in subject and lighting. Do NOT include any text overlays on the final images.\"\n}", null, null, null, null, null, null], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 60, "type": "DapaoPromptNode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "DapaoPromptNode"}, "order": 5}, {"mode": 0, "outputs": [{"name": "text", "links": [52], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [341.5063171386719, 1204.954345703125], "widgets_values": ["美女日常生活照，侧开叉旗袍"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 42, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-118.60398989719121, -899.6983140520415], "scale": 0.9646149645000047}}, "groups": [], "links": [[2, 9, 0, 2, 0, "LATENT"], [3, 5, 0, 2, 1, "VAE"], [4, 8, 0, 4, 0, "CLIP"], [6,