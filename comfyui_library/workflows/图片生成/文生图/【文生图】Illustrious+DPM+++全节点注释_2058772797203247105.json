ts": [{"name": "CONDITIONING", "links": [5, 19], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#3f384f", "widgets_values": ["受卡哇伊启发的俏皮工作室时尚社论，主角是一位开朗的年轻亚洲女性，留着蓬松的短波波头和薄透刘海，穿着超大号粉彩街头服饰，饰有怀旧的动漫启发图形和复古漫画细节。她身穿一件舒适的超大号运动衫，叠穿宽松牛仔短裤或休闲牛仔裤，佩戴彩色手镯、粗大戒指、粉彩色耳机，并随手拿着一顶可爱的棒球帽摆造型。灿烂真诚的笑容，富有表现力的俏皮姿势，充满活力的青春气息，融合了现代原宿时尚与柔和的Y2K怀旧感。\n\n拍摄于充满活力的工作室布景，拥有醒目的黄油黄色无缝背景，干净的柔光箱照明，以及充满波普艺术灵感的造型。小星星、涂鸦、卡哇伊贴纸、磁带、向日葵、糖果包装纸和杂志拼贴元素等悬浮道具营造出有趣的社论氛围。以粉色调为主的调色板，点缀着桃色、薄荷绿、薰衣草紫、婴儿蓝和泡泡糖粉。舒适的超大廓形，叠穿纹理，以及受日本街头时尚杂志和韩国时尚广告启发的时尚Z世代造型。\n\n高端时尚目录摄影，融合了梦幻的卡哇伊社论美学，超净图像质量，亮面杂志质感，柔软自然的皮肤纹理，清晰的细节和糖果色调。富有表现力的姿势，俏皮的动作，值得Pinterest收藏的构图，时尚型录能量，现代青年文化品牌感，超细腻的8k美学。\n\n风格参考：原宿流行时尚，卡哇伊街头服饰社论，粉色调动漫核心造型，复古漫画启发服装，俏皮的Y2K时尚大片，色彩鲜艳的青年文化摄影，舒适的超大时尚，梦幻波普艺术工作室拍摄。"], "inputs": [{"name": "clip", "link": 33, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true, "collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#6c6088", "size": [240, 200], "pos": [2870, 0], "id": 3, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 32}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-2549.2706624297625, 154.7134520449712], "scale": 0.724729500000001}}, "groups": [{"color": "#3f789e", "font_size": 300, "flags": {}, "id": 1, "title": "🔽邀请码：jq8lvwrk", "bounding": [-3075.032958984375, -4708.02001953125, 2973.1748046875, 421.0096130371094]}], "links": [[1, 1, 1, 2, 0, "CLIP"], [5, 3, 0, 5, 1, "CONDITIONING"], [6, 4, 0, 5, 2, "CONDITIONING"], [7, 6, 0, 5, 3, "LATENT"], [11, 5, 0, 9, 0, "LATENT"], [12, 1, 2, 9, 1, "VAE"], [13, 9, 0, 11, 1, "IMAGE"], [14, 10, 0, 11, 0, "UPSCALE_MODEL"], [15, 11, 0, 12, 0, "IMAGE"], [16, 12, 0, 13, 0, "IMAGE"], [17, 1, 2, 13, 1, "VAE"], [19, 3, 0, 14, 1, "CONDITIONING"], [20, 4, 0, 14, 2, "CONDITIONING"], [21, 13, 0, 14, 3, "LATENT