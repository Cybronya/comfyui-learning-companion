几何韵律。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 57, "type": "CR Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 16}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "frontendVersion": "1.49.6", "ds": {"offset": [-3177.377896971202, -757.3426607061696], "scale": 1.0834705943389118}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Z-IMAGE-Turbo", "bounding": [3159.595458984375, 846.2290649414062, 1793.38671875, 492.7115783691406]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Z-IMAGE-base", "bounding": [3102.19384765625, 1415.816650390625, 2127.765380859375, 555.4852905273438]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "Auto prompt", "bounding": [3203.684814453125, 2039.2650146484375, 1264.001953125, 645.4555053710938]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "输入区", "bounding": [1509.2296142578125, 810.3040771484375, 1468.768310546875, 458.18450927734375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "输出区", "bounding": [1499.4522705078125, 1305.2261962890625, 1497.9998779296875, 1229.5999755859375]}], "links": [[29, 29, 0, 26, 0, "MODEL"], [30, 26, 0, 27, 0, "MODEL"], [32, 32, 0, 31, 0, "LATENT"], [33, 37, 0, 31, 1, "VAE"], [34, 28, 0, 32, 0, "MODEL"], [35, 33, 0, 32, 1, "CONDITIONING"], [36, 35, 0, 32, 2, "CONDITIONING"], [37, 30, 0, 32, 3, "LATENT"], [38, 34, 0, 33, 0, "CLIP"], [39, 49, 0, 33, 1, "STRING"], [40, 34, 0, 35, 0, "CLIP"], [41, 45, 0, 36, 0, "LLAMACPPMODEL"], [42, 50, 0, 36, 1, "LLAMACPPARAMS"], [43, 57, 0, 36, 5, "STRING"], [44, 46, 0, 36, 6