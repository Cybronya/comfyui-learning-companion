operties": {}, "order": 23}, {"outputs": [{"shape": 6, "name": "text", "links": [63], "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["画面采用 35mm T/1.4 广角电影镜头进行全身构图（Full-Body Shot），一位拥有极致倾国倾城之貌、皮肤白皙如凝脂的绝美女性正呈现出一个充满叙事张力的动态姿态，她的身体重心呈现非对称的对角线偏移，仿佛在梦幻的虚空之中进行一场优雅的慢动作旋转，裙摆随动作在空气中划出流线型的动态轨迹。镜头从低角度仰拍，完整锁定她从繁复华丽的头饰到足尖的整体廓形，精美绝伦的洛丽塔风格服饰在身体扭转下产生细腻的褶皱流向与丝绸质感的微光反射。整体氛围呈现出一种超现实的梦核（Dreamcore）与神秘感，皮肤纹理在极高分辨率下清晰可见，呈现出通透的玻璃感与细腻的毛孔质感。光源采用极低光照的氛围设计，伴随着弥漫在空间的朦胧烟雾，光线随动作在皮肤表面产生动态的阴影位移与柔和的边缘勾勒，呈现出一种类似于 BJD 娃娃般的精致与非人类的完美感。画面充满了胶片高噪点与颗粒感，色彩在梦幻色系与暗调之间进行非线性过渡，呈现出一种破碎而又华丽的视觉美学。采用 RED V-Raptor 摄影机规格捕捉，色彩空间遵循 Log-C 调色，结合极致的体积光（Volumetric Lighting）与丁达尔效应，画质呈现出 8K 超高清的物理路径追踪细节与顶级好莱坞电影的艺术质感。"], "inputs": [{"name": "text", "link": 13, "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#355", "size": [452.3023376464844, 286.69415283203125], "pos": [719.4998168945312, 556.9639282226562], "id": 14, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 29}, {"outputs": [{"name": "string", "links": [18], "label": "string", "type": "STRING", "localized_name": "string"}], "color": "#332922", "widgets_values": ["胶片摄影，镜头语言，淡彩，暗调，氛围低光，个性视角，奇妙融合意境，一位美人，真人，有着倾国倾城之貌、皮肤白皙嫩滑， 仿Bjd风格，头上戴着繁华的饰品，清冷感，有洛丽塔支离破碎感， 透光感，玻璃感，洛丽塔御姐范，梦幻色系，精美繁复服饰配饰，神秘，梦核，高级。高级，烟雾朦胧美，明亮，高颜值，高对比度，虚焦，既视感，情绪氛围感拉满，暗朦，光朦，粒子高噪点，胶片颗粒质感，层次丰富，写意，朦胧美学，光的美学，lomo效果，超现实，高级感，杰作，五官刻画精细，皮肤纹理刻画细腻，脸上白皙有光泽"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "Text", "mode": 0, "bgcolor": "#593930", "size": [403.0023498535156, 239.66673278808594], "pos": [651.9887084960938, -1257.445068359375], "id": 19, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 24}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-508.04069545150423, 1562.1906799