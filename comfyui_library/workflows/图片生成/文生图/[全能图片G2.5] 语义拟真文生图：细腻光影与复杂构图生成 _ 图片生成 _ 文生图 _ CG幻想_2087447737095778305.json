rties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG25FlareTextToImage"}, "order": 1}, {"mode": 0, "outputs": [{"name": "text", "links": [4], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [419.0332946777344, 605.5557250976562], "pos": [443.17401123046875, -604.206298828125], "widgets_values": ["竖屏9:16半身近景，镜头隔着前景翻涌的薄纱拍摄：前景是大幅鼓荡翻飞的香槟金色披帛与广袖，半透明纱料被高空强风吹得灌满风、如浪涛般扑向镜头，纱面泛着珍珠母贝般的虹彩光泽，暗织的牡丹缠枝纹在透光处若隐若现，丝缎高光随褶皱流动成液态金线，近景纱幕在大光圈下虚化成柔和的暖金色半透明色块，几缕纱尾扫过镜头前缘化作朦胧光斑，形成天然的柔焦画框与强烈的空间纵深；\n\n人物细节：鹅蛋脸小巧精致，肌肤白皙如瓷、透出冷调光泽，远山眉斜飞入鬓，暖红橘色系眼影层层晕染、眼尾微挑，长睫浓密，瞳仁清澈直视镜头，鼻梁秀挺，红唇饱满微启、唇色珊瑚朱红；乌黑秀发高束凌云髻，余发披散及腰被风扬起；头戴一尊银色展翅凤冠，凤凰双翅张开、翎羽纤毫毕现，凤口衔落数串珍珠流苏步摇垂至颊侧，耳戴细长银链珍珠耳坠随风气轻晃，额间一点碎钻仙钿；\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 14, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [246.86646130328631, 747.8877884337196], "scale": 0.7972024500000005}}, "groups": [], "links": [[3, 5, 0, 13, 0, "IMAGE"], [4, 14, 0, 5, 1, "STRING"]], "id": "9e9628c0-a2d1-44c6-a91f-3a82b1430b44", "config": {}, "version": 0.4, "last_node_id": 15, "revision": 0}