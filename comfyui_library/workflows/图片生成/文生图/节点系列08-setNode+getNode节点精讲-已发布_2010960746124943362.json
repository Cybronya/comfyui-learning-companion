与生活气息。", 1, 1, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "start_index"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "max_rows"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [487.37261962890625, 502.5295104980469], "pos": [-262.2018127441406, 1172.01904296875], "id": 45, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptLine"}, "order": 19}, {"mode": 0, "outputs": [{"name": "*", "type": "*"}], "size": [210, 60], "pos": [906.9346313476562, -376.0494689941406], "widgets_values": [""], "inputs": [{"name": "*", "type": "*"}], "flags": {}, "id": 61, "type": "SetNode", "title": "SetNode", "properties": {}, "order": 20}, {"mode": 0, "outputs": [{"name": "*", "type": "*"}], "size": [210, 60], "pos": [910.4863891601562, -265.5963439941406], "widgets_values": [""], "inputs": [], "flags": {}, "id": 62, "type": "GetNode", "title": "GetNode", "properties": {}, "order": 21}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [846.6981156356874, 704.3948769653443], "scale": 0.7247295000000241}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 1, "title": "原理讲解", "bounding": [-731.7941284179688, -35.298561096191406, 1670.302734375, 433.8482666015625]}, {"color": "#8AA", "font_size": 24, "flags": {}, "id": 2, "title": "这里是工作流的中间部分", "bounding": [-375.7630310058594, -20.569591522216797, 383.6851501464844, 413.6000061035156]}, {"color": "#3f789e", "font_size": 44, "flags": {"pinned": true}, "id": 3, "title": "节点系列08-setNode/getNode节点", "bounding": [-250.5672607421875, -601.1991577148438, 809.2985229492188, 80]}, {"color": "#3f789e", "font_size": 44, "flags": {"pinned": true}, "id": 4