, 226.72988891601562], "widgets_values": ["相机质感写实摄影，高对比，明暗对比突出角色，面部细节精细。流光溢彩轮廓打光，侧光白打光。\n二十多岁美男，肤色亮白色调，面部强白打光。\n忧郁感眼神，眼睛狭长，抿唇得意笑。层次感凌乱发，刘海凌乱，发丝根根分明。\n纯白T恤（印图案）随性休闲，下装搭配浅水洗蓝工装阔腿长裤，腰间系蓝格纹衬衫。叠戴项链、耳机挂肩膀，日韩系街头风。阴影和打光展示阴影、衣服褶皱。\n角色玩滑板夸张动作，手伸向镜头，透视。\n角色看镜头，镜头聚焦面部和玩滑板的动作，镜头仰视视角。背景夏日色彩感滑板场和天空"], "inputs": [{"name": "clip", "link": 2, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 5, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.10.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [10, 17], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [337.2317199707031, 450.3136291503906], "pos": [504.89263916015625, 660.898681640625], "widgets_values": ["18a621c6717d691de67f4ee5f1d2074f3b9b0c2a75c29ec2821b5c68b93b2c3c.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 10, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [11], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [140, 46], "pos": [973.8357543945312, 694.6915893554688], "widgets_values": [], "inputs": [{"name": "pixels", "link": 10, "label": "图像", "type": "IMAGE", "localized_name": "像素"}, {"name": "vae", "link": 14, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 12, "type": "VAEEncode", "properties": {"widget_ue_connectable": {}, "Node name for S