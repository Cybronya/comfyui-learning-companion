], "pos": [564.7066650390625, 269.318359375], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"outputs": [{"name": "text", "links": [6], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["图1是18岁少年陆寒舟，图2是张导，图3是场景，\n生成一张专业故事板风格的2x2四宫格分镜总图，横版16:9排版，干净背景，四个画面有清晰分隔。角色包括副导演、陆寒舟、张导，同一场景（片场拍摄区），光线统一（侧光+顶光）。不允许出现风格漂移、人物变形。每个面板严格为 16:9 比例，右下角分别添加统一样式小标签：1、2、3、4。\n\n左上格 1（起）：中景，副导演（瘦高，戴工作牌）伸手拦住陆寒舟，表情不耐烦，嘴张开正在说话，背景是片场和群演，侧光，写实细节，电影级画质，\n右上格 2（承）：中景，陆寒舟无视副导演的手，眼神直接越过他看向远处的张导，表情平静但坚定，粗布蓝绿色龙套服，侧逆光强调轮廓，背景虚化，电影感，\n左下格 3（转）：近景，陆寒舟对着张导方向，嘴唇微动念出台词，眼神深邃悲怆，表情隐忍，声音仿佛穿透屏幕，背景虚化，柔光聚焦面部，电影级特写，\n右下格 4（合）：中景，张导嘴慢慢张开，表情从愤怒转为震惊，手里的剧本“啪嗒”掉在地上，眼睛直直盯着陆寒舟，背景工作人员也呆住，顶光，戏剧性定格感，电影画质，\n\n整体要求：叙事清晰，构图优秀，角色一致，道具一致，空间一致，无字幕，无水印，无时间码，无多余文字。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [446.9697570800781, 340.404052734375], "pos": [2041.9375, 293.466796875], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-2108.266358615261, -269.1225134941829], "scale": 1.771561000000002}}, "groups": [{"color": "#3f789e", "font_size": 120, "flags": {}, "id": 1, "title": "四宫图生成流程-0.08一次", "bounding": [58, 31, 4288.68408203125, 1461.9771728515625]}], "links": [[1, 7, 0, 6, 0, "IMAGE"], [2, 3, 0, 7, 0, "IMAGE"], [3, 4, 0, 7, 1, "IMAGE"], [4, 5, 0, 7, 2, "IMAGE"], [5, 2, 0, 7, 3, "IMAGE"], [6, 8, 0, 7, 10, "STRING"]], "id": "bedc36db-a891-4fe9-bf7e-25c6c710b08b", "config": {}, "version": 0.4, "last_node_id": 8, "revision": 0}