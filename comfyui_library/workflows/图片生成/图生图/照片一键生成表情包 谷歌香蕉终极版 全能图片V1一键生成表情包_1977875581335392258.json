大张）8) 得意坏笑（单边嘴角上扬，挑眉）9) 害羞脸红（低头抿嘴，脸颊泛红）。每个表情都配有相应的动态特效：爱心、火焰、泪滴等元素以简洁线条呈现。采用扁平插画风格，色彩明快饱和，线条流畅圆润，表情变化夸张生动。保持画面高品质、高质量、8K 高清，9 个表情从左到右3行3列依次呈现在白色背景的画布上。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 13, "type": "Text Multiline", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "Text Multiline", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 1}, {"mode": 0, "outputs": [{"name": "image", "links": [16], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [400, 240], "pos": [1775.4063720703125, 644.0382080078125], "widgets_values": ["", 1959009424, "randomize", "auto"], "inputs": [{"shape": 7, "name": "images", "link": 14, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 15, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}], "flags": {}, "id": 17, "type": "RH_Nano_Banana_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana_Image2Image"}, "order": 3}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "