 1790998171, "randomize", "1:1", "1k", "Third-party", false], "inputs": [{"shape": 7, "name": "images", "link": 1, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 4, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "id": 1, "type": "RH_Nano_Banana2_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 2}, {"mode": 0, "outputs": [{"name": "text", "links": [4], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [339.8659973144531, 172.47787475585938], "pos": [-871.2951049804688, 305.002197265625], "widgets_values": ["核心任务：维度重塑 (2D to 3D Re-imagining)\n将输入的插画构图作为蓝图，利用 物理渲染 (PBR) 引擎逻辑进行三维重建。\n\n1. 几何与实体构建 (Geometry & Volume)\n高精建模：采用高多边形 (High-poly) 数值，消除所有锯齿与平涂线条。\n\n生物校准：强制执行解剖学正确性，确保人物拥有真实的骨骼结构、正确的指节数量及肌肉体积感。\n\n体积实体：超现实元素（如悬浮物）必须具备明确的质量感，通过阴影与环境光遮蔽 (Ambient Occlusion) 锚定在三维空间中。\n\n2. 电影级光影系统 (Cinematic Lighting)\n全局光照：模拟复杂的全局光照 (GI) 与多级光线反弹。\n\n材质交互：光线需根据材质的 粗糙度 (Roughness) 和 金属度 (Metallic) 产生真实物理反应。\n\n边缘高光：在物体轮廓处增加细腻的逆光 (Rim Light)，以增强主体与背景的剥离感。\n\n3. 高级表面材质 (Advanced Shaders)\n非线性质感：皮肤需呈现微小的毛孔与半透明的 次表面散射 (SSS) 效果。\n\n复杂折射：透明或流体物质应具备正确的折射率 (IOR) 与色散现象。\n\n细节纹理：表面布满微观的磨损、尘埃或纹理层级，彻底告别平整的塑料感。\n\n4. 镜头与后期 (Lens & Rendering)\n光学模拟：使用大光圈镜头（f/1.8）模拟真实感十足的浅景深 (DOF)。\n\n动态范围：极高动态范围 (HDR)，确保高光不溢出，暗部有细节，画面纯净无杂色。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 5, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 0}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [411.4921875, 543.9075927734375], "pos": [-1410.8499755859375, -135.25888061523438], "widgets_values": ["1286f91197e99e6e0baa3162c59019c713d4a0ed54cb339aa7f37b2660b8c111.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 2, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "orde