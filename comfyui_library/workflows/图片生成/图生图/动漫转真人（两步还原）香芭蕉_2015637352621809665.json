me": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}], "flags": {}, "id": 200, "type": "RH_Nano_Banana2_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 13}, {"mode": 0, "outputs": [{"name": "prompt", "links": [312], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [860.3366088867188, 273.0297546386719], "pos": [-1074.0789794921875, 282.1683654785156], "widgets_values": ["  <anime_to_real_conversion_prompt>\n\n  <role>\n  You are an expert AI image generator specializing in converting anime/manga characters into photorealistic humans with Japanese photography aesthetics. Your output mimics professional Japanese portrait photography with a \"behind-the-scenes film set\" atmosphere.\n  </role>\n\n  <input>\n  User provides: ONE anime character reference image\n  </input>\n\n  <output_format>\n  Generate ONE single photorealistic image with this EXACT composition:\n  - MAIN SUBJECT: Photorealistic human version of the anime character (occupies 70-80% of frame)\n  - OVERLAY ELEMENT: Small anime original image displayed as a card/photo in the lower-left corner (15-20% of frame)\n  - ENVIRONMENT: Japanese film set / photography studio atmosphere with visible camera equipment and crew silhouettes\n  </output_format>\n\n  <character_conversion_rules - HIGHEST PRIORITY>\n\n  MUST PRESERVE FROM ANIME TO REAL:\n  1. CLOTHING: Exact same outfit - color, style, material, fit, all details\n  2. HAIR: Same color, length, style, texture, accessories (ribbons, clips)\n  3. POSE: Identical body position, hand placement, head tilt\n  4. EXPRESSION: Same emotional state and facial expression\n  5. ACCESSORIES: All items (hat, glasses, jewelry, earrings) must appear\n  6. BODY TYPE: Similar proportions and build\n\n  CONVERSION QUALITY STANDARDS:\n  - Face: Natural Asian features, not overly perfect/AI-looking\n  - Skin: Realistic texture with natural imperfections, Japanese beauty aesthetic\n  - Hair: Photorealistic strands with natural shine and movement\n  - Fabric: Real material textures (cotton, silk, wool) with natural folds\n  - Eyes: Natural human proportions (NOT anime-large), expressive\n\n  </character_conversion_rules>\n\n  <visual_style_requirements>\n\n  PHOTOGRAPHY STYLE - \"Japanese Film Set Portrait\":\n  1. LIGHTING:\n     - Natural daylight or soft studio lighting\n     - Gentle fill light, no harsh shadows\n     - Slight rim light for subject separation\n     - 透明感 (toumei-kan) - translucent, airy quality\n\n  2. COLOR GRADING:\n     - Soft, slightly desaturated Japanese photography palette\n     - Warm skin tones with natural variation\n     - Clean whites, not blown out\n     - Subtle color harmony between subject and background\n\n  3. ATMOSPHERE:\n     - Professional film/photo shoot environment\n     - Visible camera equipment (cinema cameras, monitors, rigs)\n     - Crew members as silhouettes or partial figures (blue/dark clothing)\n     - Urban Japanese backdrop (city skyline, buildings) or traditional interior\n\n  4. DEPTH & FOCUS:\n     - Subject in sharp focus\n     - Background slightly soft (f/2.8 - f/4 equivalent)\n     - Natural bokeh on background elements\n     - Camera equipment adds depth layers\n\n  5. COMPOSITION:\n     - Subject centered or slightly off-center\n     - Camera crew framing the shot (left/right edges)\n     - Anime reference card positioned lower-left, angled naturally\n     - 9:16 vertical aspect ratio (smartphone/social media format)\n\n  </visual_style_requirements>\n\n  <anime_reference_card_placement>\n\n  The original anime image MUST appear in the final output as:\n  - POSITION: Lower-left quadrant of the frame\n  - SIZE: Approximately 15-20% of total image area\n  - PRESENTATION: Displayed as a physical card/photo being held or mounted\n  - ANGLE: Slightly tilted (5-15 degrees) for natural look\n  - INTEGRATION: Appears as part of the scene (held by crew member or on stand)\n\n  PURPOSE: Creates direct visual comparison between anime original and realistic conversion\n\n  </anime_reference_card_placement>\n\n  <environment_elements>\n\n  REQUIRED BACKGROUND ELEMENTS (choose appropriate combination):\n  - Professional cinema camera on tripod/rig\n  - Camera monitors/screens\n  - Lighting equipment (softboxes, reflectors)\n  - Crew members in casual work attire (partial view, silhouettes)\n  - Japanese urban backdrop OR traditional Japanese interior\n  - Natural daylight from windows or outdoor setting\n\n  ATMOSPHERE KEYWORDS:\n  - Behind-the-scenes (メイキング / making-of)\n  - Professional photo shoot\n  - Japanese entertainment industry aesthetic\n  - Clean, organized set environment\n\n  </environment_elements>\n\n  <quality_checklist>\n\n  Before finalizing output, verify:\n\n  □ CHARACTER ACCURACY:\n    - Same outfit as anime (exact colors and style)\n    - Same hairstyle and hair color\n    - Same pose and expression\n    - Same accessories\n\n  □ REALISM QUALITY:\n    - Natural human features (not uncanny valley)\n    - Realistic skin texture\n    - Believable fabric materials\n    - Natural lighting on subject\n\n  □ COMPOSITION:\n    - Anime reference card visible in lower-left\n    - Film set atmosphere present\n    - Camera equipment visible\n    - Proper aspect ratio (vertical 9:16)\n\n  □ STYLE:\n    - Japanese photography aesthetic\n    - Professional quality\n    - Clean, not over-processed\n    - Natural color grading\n\n  □ NO TEXT:\n    - Zero text, labels, or watermarks in image\n\n  </quality_checklist>\n\n  <example_descriptions>\n\n  EXAMPLE 1 - Young woman with hat:\n  \"Photorealistic Japanese woman in off-shoulder dark blue dress and white sun hat, long wavy brown hair, standing on Japanese film set with city skyline background. Cinema cameras and crew visible on sides. Small anime character card showing same outfit displayed in lower-left corner. Natural daylight, Japanese portrait photography style.\"\n\n  EXAMPLE 2 - Elderly woman in kimono:\n  \"Photorealistic elderly Japanese woman in traditional beige/green kimono, grey hair in bun, gentle smile, seated in traditional Japanese room. Professional photography setup visible. Anime version of same character shown as reference card in lower-left. Soft natural lighting, warm tones.\"\n\n  EXAMPLE 3 - Young man in school uniform:\n  \"Photorealistic Japanese male student in white short-sleeve shirt, short dark hair, serious expression, standing outdoors with mountains in background. Film crew and cameras framing the shot. Anime original displayed as card in lower-left corner. Clean daylight, Japanese photography aesthetic.\"\n\n  </example_descriptions>\n\n  <forbidden_elements>\n  ❌ Text, labels, watermarks, or any typography\n  ❌ Western/non-Japanese aesthetic\n  ❌ Over-processed or artificial skin\n  ❌ Anime-style large eyes on realistic face\n  ❌ Incorrect clothing colors or style\n  ❌ Missing the anime reference card overlay\n  ❌ Empty/plain backgrounds without film set elements\n  ❌ Horizontal aspect ratio (must be vertical 9:16)\n  </forbidden_elements>\n\n  <final_output>\n  Generate ONE image containing:\n  1. Photorealistic human conversion of anime character (main subject)\n  2. Japanese film set environment with camera equipment\n  3. Original anime image as small card in lower-left corner\n  4. Vertical 9:16 aspect ratio\n  5. Zero text elements\n\n  The image should look like a \"behind-the-scenes\" photo from a Japanese film/photo production where the anime character has been brought to life.\n  </final_output>\n\n  </anime_to_real_conversion_prompt>"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 112, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 3}, {"mode": 0, "outputs": [{"name": "prompt", "links": [329], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [860.3366088867188, 273.0297546386719], "pos": [-733.4716186523438, 1184.2530517578125], "widgets_values": ["把图2的动漫场景变成现实场景，要求尽量还原场景细节。将图1的真实人物替换到图2的现实场景中去。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 215, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 4}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [1239.913818359375, 1368.9371337890625], "pos": [1334.0235595703125, 207.3472137451172], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 314, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 114, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.65", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 14}, {"mode":