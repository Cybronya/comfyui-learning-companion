用清晨暖调侧逆光，光线柔和自然，精准还原磨砂银的细腻颗粒感与抛光边缘的金属高光，火山岩呈现粗糙厚重的质感，海面与城市光影通透自然。8K 超高清，全画面清晰锐利，无多余杂物，整体氛围恢弘高级，菲律宾地标风光与传统银饰工艺融合，自然轻奢珠宝审美与本土地域特色完美结合。", "empty", false, 782852915, "randomize", "1k"], "inputs": [{"name": "image1", "link": 2, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}], "flags": {}, "type": "RH_RhartImageG2ImageToImage", "mode": 0