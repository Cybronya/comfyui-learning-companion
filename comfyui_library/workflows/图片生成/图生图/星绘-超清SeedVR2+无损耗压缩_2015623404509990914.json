entify=e3a65be5dc5687341b816bedd49c38cf"}, {"name": "B", "selected": true, "url": "/view?filename=rgthree.compare._temp_jnmkd_00002_pbekz_1769397588.jpg&type=temp&subfolder=&rand=0.7009077150777968&Rh-Comfy-Auth=eyJ1c2VySWQiOiJlM2E2NWJlNWRjNTY4NzM0MWI4MTZiZWRkNDljMzhjZiIsInNpZ25FeHBpcmUiOjE3NzAwMDE5MDc4NjcsInRzIjoxNzY5Mzk3MTA3ODY3LCJzaWduIjoiN2FkZGFkMGU2MDVhNjdkYTIxMDljYzE3YmQ2NGI3MGQifQ==&Rh-Identify=e3a65be5dc5687341b816bedd49c38cf"}]], "inputs": [{"name": "image_a", "link": 332, "label": "图像_A", "dir": 3, "type": "IMAGE"}, {"name": "image_b", "link": 333, "label": "图像_B", "dir": 3, "type": "IMAGE"}], "flags": {}, "type": "Image Comparer (rgthree)", "mode": 0, "bgcolor": "#3f5159", "size": [1070, 470], "pos": [1410, -430], "id": 180, "properties": {"hasSecondTab": false, "cnr_id": "rgthree-comfy", "ver": "42e73c3c48e8268129a6a1ea6d9766913bfc5435", "comparer_mode": "Slide", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 24}, {"outputs": [], "color": "#432", "widgets_values": ["模型地址：\nhttps://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler\n\n型号：选择您的 DiT 型号\n\n3B 型号：速度更快，显存需求更低\nseedvr2_ema_3b_fp16.safetensorsFP16（最佳质量）\nseedvr2_ema_3b_fp8_e4m3fn.safetensorsFP8 8位（高质量）\nseedvr2_ema_3b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\nseedvr2_ema_3b-Q8_0.ggufGGUF 8 位量化（高质量）\n\n7B 型号：画质更高，显存需求更高\nseedvr2_ema_7b_fp16.safetensorsFP16（最佳质量）\nseedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors：FP8，最后一个数据块使用FP16，以减少伪影（质量良好）\n\nseedvr2_ema_7b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\nseedvr2_ema_7b_sharp_*：锐化版本，增强细节\n设备：用于 DiT 推理的 GPU 设备（例如，cuda:0）\n\noffload_device：当 DiT 模型不处于活跃处理状态时，用于卸载 DiT 模型的设备\n\nnone：将模型保存在推理设备（速度最快、显存最大的设备）上\ncpu：卸载到系统内存（减少显存）\ncuda:X：将负载转移到另一块GPU（如果可用，则可获得良好的负载均衡）\ncache_model：在工作流运行之间，保持卸载设备上的 DiT 模型加载状态\n\n适用于批量处理，避免重复加载\n需要设置 offload_device\nblocks_to_swap：块交换内存优化\n\n0：已禁用（默认）\n1-32：需要替换为 3B 型号的变压器模块数量\n1-36：需要更换为 7B 型号的变压器模块数量\n数值越高，节省的显存越多，但处理速度越慢。\n需要设置 offload_device 并且使其与 device 不同。\nswap_io_components：卸载输入/输出嵌入和归一化层\n\n结合 blocks_to_swap 可进一步节省 VRAM\n需要设置 offload_device 并且使其与 device 不同。\nattention_mode：注意力计算后端\n\nsdpa: PyTorch scaled_dot_product_attention（默认值，稳定，始终可用）\nflash_attnFlash Attention 2（在支持的硬件上速度更快，需要 flash-attn 软件包）\ntorch_compile_args：连接到 SeedVR2 Torch 编译设置节点，可提升 20-40% 的速度。\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [620.6390380859375, 641.826171875], "pos": [-2040, -1100], "id": 183, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 4}, {"outputs": [{"name": "image", "links": [262], "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#2a363b", "widgets_values": [2901895611, "randomize", 1024, 0, 1, false, "wavelet", 0, 0, 0, 0, "cpu", false], "inputs": [{"name": "image", "link": 258, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "dit", "link": 228, "label": "dit", "type": "SEEDVR2_DIT", "localized_name": "dit"}, {"name": "vae", "link": 229, "label": "vae", "type": "SEEDVR2_VAE", "localized_name": "vae"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "INT", "localized_name": "resolution"}, {"widget": {"name": "max_resolution"}, "name": "max_resolution", "label": "max_resolution", "type": "INT", "localized_name": "max_resolution"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}, {"widget": {"name": "uniform_batch_size"}, "name": "uniform_batch_size", "label": "uniform_batch_size", "type": "BOOLEAN", "localized_name": "uniform_batch_size"}, {"widget": {"name": "color_correction"}, "name": "color_