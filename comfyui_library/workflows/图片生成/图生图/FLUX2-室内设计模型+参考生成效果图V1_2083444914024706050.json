完整还原室内模型轮廓逻辑\",\n    \"转换逻辑\": \"以图片1原图模型3D为基底，以图片2参看图哑面木饰面，将参考图中的材质应用到室内墙面，保室内轮廓结构不变，生成具有参考材质的写室内效果图，参考基于模型结构赋予高精度PBR物理写实材质，复刻原始镜头视角，弱化模型线条感，，升级为全写实影视级视觉质感\"\n  },\n  \"场景与光效\": {\n    \"设计风格\": \"现代轻奢效\",\n    \"室内外景\": \"阳台，高楼大厦环境\",\n    \"地面\": \"浅灰色750*1500规格质感地砖，自然肌理地面铺装\",\n    \"墙面\": \"米灰色墙面，哑光表面，哑面木饰面，暖白色竖条线性灯，黑色哑光地脚线\",\n    \"天花\": \"走边天花，四周暖黄色暗藏灯带\",\n    \"时间\": \"黄昏时分\",\n    \n     \n    \"室内光\": [\n      \"影视级全局照明，真实光线追踪，物理全局光照，柔和环境光遮蔽，分层写实阴影，线性侧光，灯光层次分明，自然光线衰减，材质光影真实交互\"\n    ]\n  },\n  \"摄影参数\": {\n    \"相机型号\": \"尼康Z9\",\n    \"光圈\": \"f/10\",\n    \"快门\": \"1s\"\n  },\n  \"渲染精度\": {\n    \"画面表现\": \"沉浸式静谧高级氛围，影视级超写实渲染，材质细节拉满，电影级分层调色，高动态范围画质，空间光影层次丰富\"\n  }\n}"], "inputs": [{"name": "clip", "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 4, "bgcolor": "#533", "size": [629.3296508789062, 546.3236083984375], "pos": [-767.8197631835938, -65.95472717285156], "id": 66, "properties": {"hasSecondTab": false, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 5}, {"outputs": [{"name": "LATENT", "slot_index": 0, "links": [7], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#322", "widgets_values": [674952150320386, "fixed", 7, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 96, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 115, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 89, "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 21, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"n