, "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#0074b7", "widgets_values": ["画面以浓郁的红色为基调，营造出浓厚的中国传统节日氛围。中央是一只红釉瓷碗，碗身饰有金色花卉纹样，内盛数颗洁白汤圆，汤圆上点缀着细小的金色花饰，象征团圆与吉祥。碗置于深红色木质托盘之上，托盘边缘有金色线条勾勒。背景中悬挂一盏古典红灯笼，灯笼上绘有金色花纹，下方垂挂一枚圆形镂空金饰，饰以对称花形图案，配以红色流苏。灯笼旁有枝条垂落，缀满金黄色小花，花瓣精致，与红灯笼相映成趣。画面左侧竖排金色书法“元宵喜乐”，下方附有“灯火良宵 岁岁团圆”小字，字体飘逸典雅。左下角有“THE LANTERN FESTIVAL”英文字样，字体纤细，与整体风格协调。画面右下角可见红色中国结与流苏，结饰繁复，细节清晰。整体构图对称，色彩饱和度高，红金搭配凸显喜庆与华贵，光影柔和，突出瓷器与金属的质感，营造出温馨祥和的元宵节意境。背景隐约可见模糊的红色圆形纹样，增强画面纵深感与传统装饰感。整体画面无多余元素，聚焦于节日核心意象，视觉焦点明确，传达出团圆、喜庆、祥和的节日精神。"], "inputs": [{"name": "text", "link": 19, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#004d7a", "size": [290, 400], "pos": [-1087.8984375, -70.56503295898438], "id": 19, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 3}, {"outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#323", "widgets_values": ["", "反推", "txt", true], "inputs": [{"name": "text", "link": 31, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "output_file_path"}, "name": "output_file_path", "label": "output_file_path", "type": "STRING", "localized_name": "output_file_path"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overw