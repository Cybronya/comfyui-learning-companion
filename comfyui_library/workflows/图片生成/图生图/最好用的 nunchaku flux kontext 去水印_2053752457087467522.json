lux 原本需要 20-50 步的采样过程，压缩到仅需 8-10 步就能生成出高质量图像\n## 它不是传统意义上的 “风格 / 内容 LoRA”，而是一个速度优化 LoRA，直接作用于模型的采样步骤，让生成速度提升 3-5 倍\n## 方案1. 使用这个lora，KSampler用10 Steps 快速出图；\n## 方案2. 禁用这个lora，KSampler用20 Steps 较慢生图；\n## 如果你是为了稳定去水印 + 快速出图，保留这个 LoRA 节点是最优解，它能让你的工作流又快又稳。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "注释（模型参数选择）", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [756.2626342773438, 261.34112548828125], "pos": [884.2153930664062, -40.33299255371094], "id": 24, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 6}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [427.5299987792969, 589.8799438476562], "pos": [-1711.7415771484375, 263.4007568359375], "widgets_values": ["c88b069ba231f6f36894bf5ae7a6d509046625a5c87d525741b266103a339c29.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 25, "type": "LoadImage", "title": "定制加V信: XunMeiTech", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.10.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoadImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "VHS_latentpreview": false, "frontendVersion": "1.42.15", "ds"