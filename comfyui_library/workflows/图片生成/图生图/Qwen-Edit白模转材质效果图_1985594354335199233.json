3599090576172], "pos": [431.6758117675781, 240.5655517578125], "widgets_values": ["白膜转材质，聚焦一个现代科技主题展位。展位空间尺寸为长 20 米、宽 10 米、高 4.5 米，整体呈流线型造型，结构边缘有暖色LED灯带，侧面墙面有 LED 屏幕，墙面以大面积亮面银色为主，用橙色元素点缀，穿插金色不锈钢材质与木纹装饰，同时嵌入暖色 LED 灯带营造氛围。地面呈现柔和的模糊反射效果，画面需进行镜头矫正，背景为简洁的纯黑色，突出展位主体，细节清晰，光影过渡自然。"], "inputs": [{"name": "clip", "link": 173, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "link": 139, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image", "link": 171, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 77, "type": "TextEncodeQwenImageEdit", "properties": {"cnr_id": "comfy-core", "ver": "0.3.50", "widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEdit"}, "order": 10}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.27.10", "VHS_latentpreview": false, "ds": {"offset": [59.00398366291688, -174.70086270304682], "scale": 1.4122927695244516}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Step1 - Load models", "bounding": [10, -20, 350, 433.6000061035156]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Step2 - Image size", "bounding": [10, 430, 327.2072448730469, 423.27520751953125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Step3 - Prompt", "bounding": [380, 160, 450, 470]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "白膜转材质", "bounding": [380, -20, 450, 170]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "加速lora", "bounding": [429.6849670410156, -235.7949676513672, 289.9999694824219, 165.60000610351562]}], "links": [[76, 39, 0, 8, 1, "VAE"], [125, 66, 0, 3, 0, "MODEL"], [128, 