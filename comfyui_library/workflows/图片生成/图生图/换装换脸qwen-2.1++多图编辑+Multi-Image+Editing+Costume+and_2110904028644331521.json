持<image1>中的状态不变。保持<image1>中人物的面部、长直黑发发型、肤色、坐姿、双手捧持咖啡杯与茶托的姿态、手腕上的银色手表、金色大圆环耳环，以及背景中的藤编靠背木椅、米色坐垫、绿植盆栽、玻璃窗和远处座椅完全不变。"], "inputs": [{"name": "text", "link": 105, "type": "STRING", "localized_name": "text"}], "flags": {"disabled": false}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "rgba(21, 23, 27, 0.96)", "size": [334.5814514160156, 209.38070678710938], "pos": [1879.229736328125, 1064.10498046875], "id": 52, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 19}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [40, 96, 136], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [230, 60], "pos": [1802.640380859375, 86.90731048583984], "widgets_values": [], "inputs": [{"name": "samples", "link": 34, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 35, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 28, "type": "VAEDecode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 24}, {"outputs": [{"name": "image", "links": [104, 108, 110, 135, 137], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"name": "matched_ratio", "label": "matched_ratio", "type": "STRING", "localized_name": "matched_ratio"}, {"name": "resolution_value", "links": [107], "label": "resolution_value", "type": "INT", "localized_name": "resolution_value"}], "color": "#332922", "widgets_values": ["2K", "lanczos"], "inputs": [{"name": "image", "link": 106, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "resize_method"}