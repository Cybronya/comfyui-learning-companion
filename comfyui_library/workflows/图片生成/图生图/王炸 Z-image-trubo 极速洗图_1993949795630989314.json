_values": ["图像呈现一只美丽的眼睛，眼妆设计独具匠心，融合了中国传统水墨画意境。整个妆面以蓝色为主调，描绘了山水画景，山峦叠翠、水波荡漾，眼影宛如清澈的湖面，其中倒映着微波粼粼的细节。眼尾处的红日升起，与白色云层交相辉映，几只飞鸟展翅翱翔，增添灵动之感。此外，脸部妆容加入了珍珠装饰，模仿水滴从山水间滑落的效果，凸显精致与优雅。面部下方出现了中国传统建筑样式的亭台楼阁，蓝白色的建筑与整体妆容风格相呼应，充满诗意与东方韵味。这幅艺术妆容既唯美又富有文化内涵。"], "inputs": [{"name": "text", "link": 167, "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 16, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 8}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [2, 4], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [262.5093994140625, 141.39744567871094], "pos": [930.5760498046875, 203.4921875], "widgets_values": [""], "inputs": [{"name": "clip", "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 146, "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 3, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 7}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [5], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [140, 26], "pos": [1052.360595703125, 401.3870849609375], "inputs": [{"name": "conditioning", "link": 4, "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "flags": {}, "id": 5, "type": "ConditioningZeroOut", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ConditioningZeroOut"}, "order": 9}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [6], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [929.6192626953125, 487.3921813964844], "widgets_values": [936, 1664, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "type": "INT",