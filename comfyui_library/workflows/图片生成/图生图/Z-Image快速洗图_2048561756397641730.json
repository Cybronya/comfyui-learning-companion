1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 11}, {"outputs": [{"name": "STRING", "links": [410], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#332922", "widgets_values": ["你是一位观察力极强的视觉分析专家。首先确定这张图片的主体类型（是人像、建筑、风景，还是静物产品），然后生成一段高质量的英文提示词。\n请严格遵循以下逻辑：\n\n1. 主体判定与描述（至关重要）：\n若图片为建筑/空间：详细描述建筑风格（如哥特式、现代主义）、内部结构（如拱顶、梁柱）、材质（石材、木材、金属）及空间透视。严禁在描述中虚构不存在的人物。\n若图片为静物/产品：着重描写材质的反光、纹理细节、配色方案及摆放构图。\n若图片包含人物：仅在此情况下描述人物的性别、服饰、发型和动作。若画面空无一人，则跳过此部分，不得虚构人物。\n\n2. 环境与光影：\n描述光源（自然光、人造光、丁达尔效应）、光影反差及整体氛围（庄严、神秘、明亮）。\n\n3. 构图与视角：\n描述镜头的视觉语言（如对称构图、广角仰拍、微距特写、景深虚化）。\n\n输出要求：\n• 输出连贯的自然英文段落，不使用项目符号。\n• 若原图不含人物，描述中严禁出现“男人”、“女人”或“行人”等词汇。\n• 描述限制在500字符以内。\n\n英文提示词：不包含图片水印、无关文字符号或总结性描述。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {"collapsed": true}, "type": "PrimitiveStringMultiline", "mode": 0, "bgcolor": "#593930", "size": [398.4154357910156, 231.61981201171875], "pos": [-1926.9422607421875, 1330.971435546875], "id": 177, "properties": {"cnr_id": "comfy-core", "ver": "0.3.76", "ue_properties": {"widget_ue_connectable": {"value": true}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 3}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [373, 398, 426, 427], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [169.15721130371094, 54.830894470214844], "pos": [-966.8001098632812, 687.2549438476562], "widgets_values": [], "inputs": [{"name": "samples", "link": 261, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 424, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 103, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode