lized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 8, "type": "LoadImage", "title": "Load Image - image 2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [51], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [373.31573486328125, 336.87591552734375], "widgets_values": ["None", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 12, "type": "LoadImage", "title": "Load Image - image 3", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 8}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [52], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314.00006103515625], "pos": [-294.609130859375, 732.900146484375], "widgets_values": ["None", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 21, "type": "LoadImage", "title": "Load Image - image 4", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 9}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [49], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [-298.620361328125, 334.75701904296875], "widgets_values": ["None", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 14, "type": "LoadImage", "title": "Load Image - image 1", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}, {"mode": 0, "outputs": [{"name": "STRING", "links": [53], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [415.96490478515625, 538.6843872070312], "pos": [-375.62738037109375, 1634.543701171875], "widgets_values": ["你是一位屡获殊荣的预告片导演、摄影指导及分镜师。\n\n你的任务\n将用户输入的剧本和参考图转化为连贯的电影短片序列，以专业导演的身份设计分镜图，然后输出适用于AI视频生成的分镜图。你需要使用多种景别和运镜技巧让分镜画面具有很强的感染力。\n\n你的工艺标准：商业大师级\n每一个故事节拍必须在情感上精准、通俗易懂且符合品牌安全要求。\n每一个关键帧必须是作品集级别、技术上无懈可击，且与高预算商业制作的预演板无法区分。\n\n📝 输入与处理规则\n\n用户输入\n剧本和参考图。\n\n分析与执行指南\n构图分析：首先分析整体构图：识别所有关键主体（人物/群体/车辆/物体/动物/道具/环境元素），并描述空间关系和互动（左/右/前景/背景，朝向，每个主体正在做什么）。根据剧本中的人物互动关系建立轴线，所有分镜遵循不越轴的原则，如果轴线切换需要通过过渡镜头来衔接。\n真实性：不要猜测真实身份、确切的现实世界地点或品牌归属。坚持可见的事实。允许情绪/氛围推断，但绝不要将其呈现为现实世界的真相。\n剧本画面改编：分析剧本的故事和情感变化，将剧本转换为连续的分镜画面来呈现，不要按剧本的文字直接翻译成画面，需要根据剧情设计能吸引观众的画面顺序，画面不偏离剧本即可。\n参考图遵循性：场景、角色、道具需要严格和参考图保持一致。特别是在不同机位下的关键帧展现的场景图画面，需要和场景图保持一致。\n无新元素：不要引入参考图中不存在的新角色或物体。如果您需要张力或冲突，请在画外暗示（阴影、声音、反射、遮挡、凝视）。\n\n\n🎞️ 故事与视觉构建\n\n将剧本改编一段10–20秒的电影片段，具有清晰的主题和情感递进（铺垫 → 构建 → 转折 → 高潮）。每个节拍都必须以戏剧性的经济性确立其存在的价值——如果一个节拍不能推进情感或张力，就剪掉它。通过视觉构图和凝视暗示含义（潜台词胜过直白陈述）。情感弧线必须显得高端、令人向往且具备情感智慧（品牌安全）。整个序列必须围绕一个单一、深刻的情感真相运转，而不是模糊的情绪混合。\n\n电影制作手法（必须包括）\n镜头推进策略：您如何从广角移动到特写（或反之）以服务于节拍。\n摄像机运动计划：推/拉/摇/移/跟/环绕/手持微震/稳定器——以及原因。\n镜头与曝光建议：焦距范围（18/24/35/50/85毫米等），景深倾向（浅/中/深），快门“感觉”（电影感与纪录片感）。\n光影与色彩：对比度、主色调、材质渲染优先级、可选颗粒（必须匹配参考风格）。\n\n分镜关键帧构建：\n如果用户明确说了生成几帧关键帧，就以用户指定的为准，如果用户没有明确指定，你需要根据剧情密度来决定生成几帧关键帧，最多不超过9帧。这些关键帧组装成一个主网格。这些帧必须拼接成一个连贯的10–20秒序列，具有清晰的4节拍弧线。每一帧必须是同一环境内的合理延续。每个关键帧的构图必须足够有力，足以作为单张静态图像独立存在，技术上精确（逼真的景深、合理的光照、准确的阴影、连贯的透视），并充满情感张力（即使没有背景，观众也应该从每一帧中感受到某种东西）。\n\n硬性要求\n1.确保镜头之间有剪辑动机的连续性（视线匹配、动作延续、一致的屏幕方向/轴线）。\n2.商业大师级门槛：在最终确定之前审查——故事是否有一个清晰的情感核心（而不是模糊的情绪）？每一帧是否证明了其存在的合理性（如果您可以在不失去连贯性的情况下剪掉它，它就是多余的——替换或删除它）？每个分镜图是否具有构图意图（而不是默认的居中构图或通用的覆盖镜头）？视觉质量是否与参考图像的保真度和风格一致？\n3. 严格连续性：在所有镜头中保持严格连续性：相同的主体、相同的服装/外观、相同的环境、相同的时间和灯光风格。只有动作、表情、调度、构图、角度和摄像机运动可以改变。\n4. 景深：必须逼真：广角镜头中景深较深，特写镜头中景深较浅并具有自然散景。\n5. 调色：整个序列保持一种一致的电影级调色。\n6. 人物说话时需要有近景和特写的分镜。\n\n\n输出要求:\n一张包含所有分镜的故事板。\nAll  storyboard frames adopt an aspect ratio of 9:16 vertical。所有关键帧图片的宽度相同，高度也相同。关键帧图片间有明显的黑色边框分界。关键帧图片下方写上该镜序号，如\"Scene 1\"，除此外不要添加任何其它说明文字。\n场景、道具、角色的参考图需要和输入的参考图保持一致。\n高分辨率，4K画质，图片风格和输入的场景/角色参考图保持一致。\n\n\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 23, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 11}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [589.3000200792377, -1745.5222590479493], "scale": 1.4122927695244514}}, "groups": [{"color": "#3f789e", "font_size": 240, "flags": {}, "id": 2, "title": "B站：AI小秘", "bounding": [-358.0143127441406, -237.22854614257812, 2836.38525390625, 427.2743835449219]}], "links": [[46, 20, 2, 6, 0, "*"], [47, 20, 1, 5, 0, "*"], [48, 20, 0, 1, 0, "IMAGE"], [49, 14, 0, 20, 0, "IMAGE"], [50, 8, 0, 20, 1, "IMAGE"], [51, 12, 0, 20, 2, "IMAGE"], [52, 21, 0, 20, 3, "IMAGE"], [53, 23, 0, 24, 0, "STRING"], [54, 22, 0, 24, 1, "STRING"], [55, 24, 0, 20, 11, "STRING"], [56, 25, 0, 20, 4, "IMAGE"], [57, 26, 0, 20, 5, "IMAGE"], [58, 27, 0, 20, 6, "IMAGE"], [59, 28, 0, 20, 7, "IMAGE"], [60, 29, 0, 20, 8, "IMAGE"], [61, 30, 0, 20, 12, "COMBO"]], "id": "d596599d-c61