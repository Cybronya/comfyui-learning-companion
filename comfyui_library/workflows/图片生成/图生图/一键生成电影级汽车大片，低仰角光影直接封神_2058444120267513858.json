{"last_link_id": 3, "nodes": [{"mode": 0, "outputs": [{"name": "text", "links": [2], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 200], "pos": [-544.321533203125, 357.86602783203125], "widgets_values": ["一张极具电影质感的超写实汽车摄影作品。低角度仰拍视角，展示一辆 [用户上传车图片] 在专业赛道上疾驰。车身拥有精致的细节质感。地面沥青和车轮呈现强烈的动态模糊效果，强调极致的速度感。背景是戏剧性的多云天空，金色的夕阳阳光穿透云层洒在车身上，形成绝美的轮廓光。8k分辨率，商业广告级画质，光影层次丰富，色彩饱满，高清晰度。\n负词：模糊画质，低分辨率，马赛克，失真变形，车身破损，瑕疵划痕，多余杂物，人物路人，乱入车辆，画面杂乱，光线暗沉，曝光过度，色彩寡淡，塑料廉价质感，比例失调，水印文字，水印 logo，多余边框，卡通手绘，二次元风格，噪点颗粒，虚影重影，静态呆板，构图杂乱\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 4, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}, {"outputs": [{"name": "image", "links": [3], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "3:4", false, 1295447326, "randomize", "1k"], "inputs": [{"name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized