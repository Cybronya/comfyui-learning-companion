NG", "type": "STRING", "localized_name": "STRING"}], "color": "#2a363b", "shape": 1, "widgets_values": ["比例9:16"], "inputs": [{"widget": {"name": "inStr"}, "name": "inStr", "label": "inStr", "type": "STRING", "localized_name": "inStr"}], "flags": {}, "type": "String", "mode": 0, "bgcolor": "#3f5159", "size": [210, 58], "pos": [725.2022094726562, 1402.315673828125], "id": 20, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "String"}, "order": 6}, {"outputs": [], "color": "#432", "shape": 1, "widgets_values": ["# 0为出图比例1:1\n# 1为出图比例2:3\n# 2为出图比例3:2\n# 3为出图比例3:4\n# 4为出图比例4:3\n# 5为出图比例9:16\n# 6为出图比例16:9\n# 7为出图比例21:9\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [210, 364.327880859375], "pos": [172.3126678466797, 766.8204956054688], "id": 10, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [{"name": "STRING", "links": [20], "label": "STRING", "type": "*", "localized_name": "STRING"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#2a363b", "shape": 1, "widgets_values": ["，"], "inputs": [{"shape": 7, "name": "text1", "link": 19, "label": "text1", "type": "STRING", "localized_name": "text1"}, {"shape": 7, "name": "text2", "link": 10, "label": "text2", "type": "STRING", "localized_name": "text2"}, {"widget": {"name": "separator"}, "shape": 7, "name": "separator", "label": "separator", "type": "STRING", "localized_name": "separator"}], "flags": {}, "type": "CR Text Concatenate", "mode": 0, "bgcolor": "#3f5159", "size": [215.2631378173828, 78], "pos": [722.2587280273438, 812.3478393554688], "id": 12, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text Concatenate"}, "order": 12}, {"mode": 0, "outputs": [{"name": "prompt", "links": [19], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [411.70758056640625, 457.5674133300781], "pos": [163.43460083007812, 240.5224151611328], "widgets_values": ["# 即梦4.1模型 - 枫林时尚杂志风写真生成提示词工程模板\n## 核心指令\n基于上传的参考照片，生成时尚杂志风格枫林写真，**严格保留人物面部核心特征**，强化人物姿势与枫林场景的自然融合，穿搭需多样且与秋景和谐呼应，整体符合以下结构化要求，确保风格统一、细节完整。\n\n## 1. 核心主题与风格定位\n时尚杂志风户外写真，秋日枫林主题，经典好莱坞优雅风格，高雅神秘气质，真实人像质感，专业商业人像摄影水准，高饱和度秋景与多元时尚穿搭自然呼应。\n\n## 2. 场景与环境细节\n- 主体场景：茂密枫林与银杏林交织，枫树红叶与银杏黄叶分层错落，林间点缀红色花簇（自然分布，不喧宾夺主）；\n- 环境元素：地面散落少量完整落叶（无腐烂、破损），无杂乱杂物，背景干净通透，营造沉浸式秋日林间氛围；\n- 光影效果：柔和自然侧逆光（阳光透过树叶缝隙穿透），形成斑驳光影洒在人物发丝、肩头与地面，光影边缘柔和不生硬，整体光线明亮温暖，无明显暗角。\n\n## 3. 人物与动作规范（强化“自然融合”）\n- 人物状态：基于参考照片人物，1:1还原面部特征（五官比例、神态、肤色），保持核心体态特征（身高比例、身形轮廓），姿态自然放松，契合“林间漫步”的惬意感；\n- 核心动作：与枫林场景深度融合（二选一或自然组合，无需刻意僵硬）：① 手持一片完整枫叶（自然握持于身前/身侧，指尖轻触叶片脉络）；② 侧身低头观察地面落叶/抬手轻拂身旁树枝（动作轻柔，不夸张）；③ 缓步前行时侧脸微转，目光自然望向林间深处/镜头（神态慵懒惬意，无刻意摆拍感）；\n- 造型细节：妆容精致淡雅（符合好莱坞经典优雅风格，强调眉眼轮廓与自然唇色，无浓妆艳抹），发型整洁不凌乱（可带轻微自然风吹动感，与林间环境呼应）。\n\n## 4. 多元穿搭体系（与枫林和谐适配，随机生成1种或组合搭配）\n### （1）穿搭核心原则\n色彩呼应秋景（避免高饱和撞色，如荧光绿、亮紫），材质适配秋日氛围，风格多样但不突兀，确保人物在枫林背景中突出且协调。\n\n### （2）细分穿搭风格与细节\n#### ① 优雅复古风\n- 单品组合：长款驼色/焦糖色羊毛大衣（过膝长度，版型宽松垂坠）+ 米白色高领针织衫 + 深棕色麂皮半裙（或直筒裤）+ 黑色短靴（粗跟，简约款）；\n- 配饰点缀：复古金属项链（细链+小巧吊坠）+ 皮质手套（浅卡其色，简约款）；\n- 色彩逻辑：驼色/焦糖色呼应枫叶红，米白提亮整体，深棕色增加层次感，材质（羊毛、麂皮）凸显秋日温暖质感。\n\n#### ② 简约休闲风\n- 单品组合：燕麦色oversize针织开衫（内搭白色基础T恤）+ 浅卡其色直筒牛仔裤（或灯芯绒长裤）+ 棕色乐福鞋（或白色运动鞋，低饱和度款）；\n- 配饰点缀：米色帆布包（简约无过多图案）+ 细框眼镜（可选，增加文艺感）+ 针织发带（与开衫同色系）；\n- 色彩逻辑：低饱和燕麦色、卡其色与银杏黄呼应，白色提亮，牛仔裤的休闲感平衡秋景的厚重，适配林间漫步的松弛感。\n\n#### ③ 法式浪漫风\n- 单品组合：酒红色丝绒连衣裙（中长款，收腰A字版型）+ 米白色针织开衫（外搭，慵懒披在肩头）+ 裸色细带高跟鞋（或玛丽珍鞋）；\n- 配饰点缀：珍珠耳饰（小巧款）+ 棕色皮质手提包（简约锁扣设计）+ 丝巾（浅米色，可系在颈部或包柄）；\n- 色彩逻辑：酒红色与枫叶红形成同色系呼应，丝绒材质的光泽感与林间光影呼应，米白、裸色中和红色的浓烈，凸显法式优雅。\n\n#### ④ 大地色通勤风\n- 单品组合：深棕色风衣（中长款，H型版型）+ 浅棕色衬衫（或条纹衬衫，低饱和配色）+ 卡其色阔腿裤 + 棕色乐福鞋（或短靴）；\n- 配饰点缀：黑色皮质腰带（收腰，提升腰线）+ 简约公文包（深棕色，质感皮质）+ 金属腕表（表盘小巧）；\n- 色彩逻辑：深棕、浅棕、卡其色构成大地色系，与枫林、地面落叶自然融合，风衣的利落感适配杂志风的精致，通勤风兼顾实用性与时尚感。\n\n## 5. 技术参数与画质要求\n- 分辨率：超高清（300dpi以上），杂志印刷级画质；\n- 细节表现：皮肤纹理自然细腻（无过度磨皮），发丝根根清晰（带轻微光泽），衣物质感真实（羊毛的柔软、丝绒的光泽、牛仔的硬朗等特性清晰呈现），树叶脉络、花簇细节、落叶纹理可辨；\n- 色彩调校：秋景色彩浓郁但不失真（红叶/黄叶饱和度适中，避免过曝），人物肤色还原自然，穿搭色彩与秋景色调协调统一（无色彩割裂感），整体色调温暖协调（偏橙黄系，契合秋日氛围）；\n- 构图比例：杂志封面标准比例（建议1:1.5或1:2），人物位于画面黄金分割点，场景留白合理，人物与背景层次分明（无融为一体的模糊感）。\n\n## 6. 参考图关联指令（核心约束）\n① 严格基于上传的参考照片生成，1:1还原人物面部特征、神态与核心体态；② 仅替换背景为指定枫林场景，调整动作至“与枫林自然融合”的状态；③ 穿搭随机选择上述1种风格，或在风格框架内微调单品（如将大衣替换为风衣），但需保留参考照片中的穿搭风格基调（如简约/优雅/休闲），不强行替换风格。\n\n## 7. 审核合规补充\n无暴力、色情、敏感元素，人物造型得体，场景自然写实，穿搭风格积极健康，符合公序良俗，可直接通过模型审核。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 9, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 8}, {"outputs": [{"name": "INT", "links": [13], "label": "INT", "type": "INT", "localized_name": "INT"}], "color": "#232", "shape": 1, "widgets_values": [1, "fixed"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "type": "PrimitiveInt", "mode": 0, "bgcolor": "#353", "size": [243.6578826904297, 82], "pos": [401.8272705078125, 830.7762451171875], "id": 11, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveInt"}, "order": 9}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [-139.599365234375, 240.22584533691406], "widgets_values": ["91be83c7a2bcfbfdcd3309b1498675206e4fd01b71543bc73d26ba35233ad1bc.jpeg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 2, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [432.5178203126767,