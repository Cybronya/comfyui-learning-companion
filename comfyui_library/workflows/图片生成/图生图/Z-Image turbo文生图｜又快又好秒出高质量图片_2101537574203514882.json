谊和陪伴的美好。"], "inputs": [{"name": "clip", "link": 43, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [410, 370], "pos": [0, 0], "id": 45, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 12}, {"outputs": [{"name": "CLIP", "links": [43, 71], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#323", "widgets_values": ["qwen_3_4b.safetensors", "lumina2", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#535", "size": [389.6735534667969, 106], "pos": [1734.8900146484375, 82], "id": 39, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"directory_invalid": true, "name": "qwen_3_4b.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/text_encoders/qwen_3_4b.safetensors"}], "ver": "0.3.73", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPLoader", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 3}, {"outputs": [{"name": "CONDITIONING", "links": [72], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "wid