质格栅或窗棂结构，这暗示场景可能设定在那个充满神秘感的“无限城”中。\n光影： 光线从上方和侧面打在角色身上，突出了他头发的层次感和肌肉的轮廓，同时也加深了画面的阴郁氛围。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 223, "type": "PrimitiveStringMultiline", "properties": {"cnr_id": "comfy-core", "ver": "0.3.67", "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 1}, {"outputs": [{"name": "CLIP", "slot_index": 0, "links": [675], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#223", "widgets_values": ["qwen_2.5_vl_7b_fp8_scaled.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#335", "size": [380, 106], "pos": [-6.564608573913574, 185.94158935546875], "id": 38, "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [781, 782], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}], "size": [270, 336], "pos": [-319.8000793457031, 297.5242919921875], "widgets_values": [512, 512, "lanczos", "resize", "0, 0, 0", "center", 16, "cpu", "<tr><td>Output: </td><td><b>1</b> x <b>736</b> x <b>1296 | 10.92MB</b></td></tr>993ba4ca09fb09b3f8bd2885819bde5a"], "inputs": [{