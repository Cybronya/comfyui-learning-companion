": [{"name": "positive", "links": [46], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "links": [47], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent", "links": [], "label": "latent", "type": "LATENT", "localized_name": "latent"}], "color": "#232", "widgets_values": ["将图像中的人物重新编排为一张横向专业角色建模参考图，图像作为唯一的人物身份与造型依据。准确保持人物的面部身份、年龄观感、体型、发型、发色、头饰、妆容、服装、鞋履和配饰不变，仅重新建立取景、姿态、观察角度和人物排列。画面采用固定的左侧大幅身份特写与右侧三个大型全身转面视图组合，四个人物视图共同置于同一块连续的浅灰白色无缝棚拍背景中，通过自然留白分隔。左侧约36%空间由一张放大的正面身份特写完整占据，人物位于左侧空间中央，相机与双眼等高并正对人物面部，面部中轴垂直，双眼等高，鼻尖和下巴朝向镜头，左右面颊、双耳和双肩呈对称关系。左侧人物采用紧凑的头肩与上胸部取景，头部、脸部、颈部、锁骨、双肩和少量上胸部清晰入画，头顶靠近画面上方，肩膀向左右延伸至取景范围之外，上胸部一直延伸并被整幅画面的下方自然裁切。头部连同完整发型占左侧空间高度约55%，脸部占左侧空间宽度约55%，双眼位于左侧空间高度约三分之一的位置，人物的肩部与上胸部填满左侧空间下半部分，使身份特写从画面上方连续延伸至最下方，不形成悬浮的小头像。右侧约64%空间从左到右依次排列同一人物的正面全身视图、朝向画面左侧的90度侧面全身视图和背面全身视图。三个全身人物尺寸一致并接近画面全高，头顶靠近画面上方，双脚靠近画面下方，人物高度约占整幅画面高度的84%，三个人物等距排列、间距均匀、互不遮挡。正面视图中，面部、胸腔、骨盆、膝盖和双脚均朝向镜头，双肩与髋部平行于画面，双臂自然垂落；90度侧面视图中，头部和身体形成严格的单一侧面轮廓，呈现一侧眼睛、鼻梁、下巴、胸部、手臂和腿部的侧面结构；背面视图中，后脑勺、背部、髋部、腿部和脚跟朝向镜头，完整展示背部发型、服装背面和配饰。右侧三个全身视图属于同一个人物，保持完全相同的身高、身体比例、发型、服装、鞋履和配饰，服装的长度、层次、领口、袖型、腰线、下摆、材质、装饰纹样及其位置在三个方向准确对应。采用均匀柔和的中性棚拍光线，人物面部、皮肤、发丝、身体轮廓、服装结构和材质细节清晰可辨。整幅画面由左侧放大的身份特写和右侧三个接近全高的转面视图横向铺满，人物比例醒目，空间利用充分，背景从顶部至最下方连续统一。", "", 1280], "inputs": [{"name": "clip", "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "link": 45, "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "images.image_2", "label": "参考图 2 (Image-2)", "type": "IMAGE", "localized_name": "参考图 2 (Image-2)"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "negative_prompt"}, "name": "negative_prompt", "label": "negative_prompt", "type": "STRING", "localized_name": "negative_prompt"}, {"widget": {"name":