0214844], "pos": [2409.632080078125, 1021.1854248046875], "widgets_values": ["一对亚洲时尚年轻情侣惬意地坐在温馨的客厅沙发上，沉浸于一场充满乐趣的AR游戏体验。手中紧握游戏手柄，神情专注而投入。女生身穿清爽蓝色背带裤，卡其色卷发，内搭白色条纹背心，双腿盘膝坐在沙发上，笑容灿烂，洋溢着青春活力；男生身着简约白色T恤，外披卡其色休闲外套，深蓝色的牛仔裤，难掩兴奋之情。他们坐在深蓝色的沙发上，沙发上放置着浅色的抱枕，尽情享受休闲时光。\n\n背景是现代简约风格的居家空间：浅色的墙壁，两边是浅色亚麻窗帘柔顺垂落，角落摆放着郁郁葱葱的绿植，木质落地灯散发出温暖光晕，一旁的书架上陈列着书籍与小摆件，细节满满，尽显生活质感。整体环境以暖色调为主，灯光柔和，营造出舒适放松的氛围。电影级质感画面，营造出冷暖对比。\n\n画面采用浅景深效果，人物清晰锐利，焦点精准落在情侣的表情与互动上，而背景中的窗帘、绿植与落地灯则呈现自然柔和的虚化，暗示使用大光圈镜头，有效突出主体，增强视觉层次与情感代入感。科技与生活完美融合，生动展现当代年轻人在家中享受智能娱乐的轻松、快乐与亲密时光。"], "inputs": [{"name": "clip", "link": 6, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 7, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.45", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [19, 21], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [210, 46], "pos": [3146.51611328125, 700.9398193359375], "inputs": [{"name": "samples", "link": 4, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 5, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 6, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.45", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 11}, {"mode": 0, "outputs": [], "size": [1208.969970703125, 710.4400024414062], "pos": [4401.96435546875, 668.9710083007812], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 21, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 19, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 13}], "extra":