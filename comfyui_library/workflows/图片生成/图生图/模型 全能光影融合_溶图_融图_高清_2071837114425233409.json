: 4, "label": "图像_B", "dir": 3, "type": "IMAGE", "localized_name": "image_b"}], "flags": {}, "id": 4, "type": "Image Comparer (rgthree)", "properties": {"comparer_mode": "Slide", "widget_ue_connectable": {}, "Node name for S&R": "Image Comparer (rgthree)"}, "order": 3}, {"mode": 0, "outputs": [{"name": "text", "links": [5], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [321.23211669921875, 409.2374267578125], "pos": [268.4766540527344, 598.5587158203125], "widgets_values": ["1、任务： 基于画面现有主光源，修正并补全所有阴影问题。请严格按以下步骤处理：\n\n诊断光源：识别画面中唯一的主光源方向（如左上、右侧等），后续所有阴影必须与此方向完全一致，不允许出现多方向阴影或反向阴影。\n\n修复错误阴影：\n\n删除所有与主光源方向矛盾的阴影（例如物体左侧出现右侧光源产生的阴影）。\n\n将生硬、锐利的不自然阴影边缘改为柔和、羽化的过渡边缘（软阴影）。\n\n补全缺失阴影：\n\n接触阴影：物体与地面/桌面的交接处必须添加极窄、低不透明度的深色阴影（避免物体“漂浮”）。\n\n遮挡投影：根据物体间的空间关系（如包包提手遮挡包身、肩带遮挡包体），为每一处前后遮挡关系补全投射阴影。\n\n环境光遮蔽：在物体自身凹陷、褶皱、缝隙处（如包盖边缘、拉链头根部）加深微弱的暗部细节。\n\n保持材质不变：\n\n严禁改变包包的原始纹理（颗粒、编织纹）、皮质光泽度（高光位置与强度）及固有色相/饱和度。\n\n阴影只能叠加为“正片叠底”或“柔光”效果，禁止提升亮度或对比度。\n\n统一与约束：\n\n整体光影氛围与原图完全一致，不增强反差，不添加额外光源。\n\n输出前自查：所有阴影是否逻辑自洽？接触点是否全部有落地阴影？边缘是否柔和？\n\n最终目标：生成一张光影真实自然、阴影层级分明、但材质与色彩零改变的图像。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 5, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 1}, {"mode": 0, "outputs": [{"name": "image", "links": [3, 6], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [461.9679870605469, 594.8181762695312], "pos": [609.8474731445312, 210.1422576904297], "widgets_values": [" ", 1270044871, "randomize", "3:4", "2k", false, "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 1, "label": "images", "type": "IM