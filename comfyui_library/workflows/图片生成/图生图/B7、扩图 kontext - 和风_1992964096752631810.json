puts": [], "color": "#223", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 27, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#335", "size": [427.3000793457031, 307.2600402832031], "pos": [3260.5517578125, 1394.955322265625], "id": 20, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 21}, {"outputs": [{"name": "IMAGE", "links": [1], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#223", "widgets_values": ["782def8effe4e663e82ab05fc944a9b056005a6cd27e782004eb48d0af799138.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#335", "size": [363.7026062011719, 329.3868408203125], "pos": [1097.23291015625, 493.2572021484375], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"outputs": [{"name": "STRING", "links": [15], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#223", "widgets_values": ["在保持图像其余部分不变的同时，移除蓝色区域，确保新区域与原始图像无缝融合，同时保留原始风格和构图。", "zh", "en"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "from_lang"}, "name": "from_lang", "label": "from_lang", "type": "COMBO", "localized_name": "from_lang"}, {"widget": {"name": "to_lang"}, "name": "to_lang", "label": "to_lang", "type": "COMBO", "localized_name": "to_lang"}], "flags": {}, "type": "ACE_TextTranslate", "mode": 0, "bgcolor": "#335", "size": [363.0957336425781, 215.83013916015625], "pos": [1097.85888671875, 893.0287475585938], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ACE_TextTranslate"}, "order": 4}, {"outputs": [], "color": "#323", "widgets_values": ["👉       【各大模型出图商用原则】\n-\n1. 需严格遵照作者对模型的商业许可范围声明综合判断，具体如下：\n- ❌如底模出图不可商用，则创作的图片不可商用。\n- ❌如底模出图可商用，但搭配的 LoRA 出图不可商用，则创作的图片不可商用。\n- ✅如底模出图可商用，且搭配的 LoRA 出图可商用，则创作的图片可商用。\n---\n\n2. 需严格遵照工作流的作者对工作流和模型的商业许可范围声明综合判断，具体如下：\n- ❌如工作流作者声明出图可商用，但工作流中涵盖的模型是其他作者的不可商用模型，则不可商用，侵权行为与工作流作者无关。\n- ✅如工作流提供的作者声明出图不可商用，但工作流中没有涉及API，且使用的模型为可商用，节点也是开源节点，则创作的图片只要你不承认自己是抄袭的工作流，即可商用。虽不道德但不侵权。这种事要小心被曝光，或者遇见搅屎棍。\n- ✅如工作流声明出图可商用，且使用的模型声明可商用，则创作的图片可商用。\n---\n\n3. 出图内容需严格遵照国家法律，如果违背或侵权，应承担对应的法律责任。其中包括但不限于的具体内容有下：\n- ❌故意输入可能侵犯第三方知识产权或其他权益的关键词或提示词，导致生成的图片可能侵犯第三方知识产权或权益的，该图片不得用于商业用途，且用户应承担由此产生的全部侵权责任。\n- ❌出图人物侵犯他人肖像权，且没有证据自证者，图片不得商用。\n- ❌出图内容为18禁的内容，或者明确为黄赌毒的宣传标语，图片不得商用，若经传播，应承担相应法律责任。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "和风友情提示", "mode": 0, "bgcolor": "#535", "size": [371.36602783203125, 519.91259765625], "pos": [35.61109924316406, 833.82421875], "id": 21, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 5}, {"outputs": [], "color": "#323", "widgets_values": ["🌈 扩图工作流选择Kontext的原因：万相扩图虽然创意足，有时能有效补充缺失部分，但成图不稳定，时效也差不多，有点两头堵的感觉，导致抽卡次数很容易上升。千问扩图的光影以及文字补充都非常不错，但质量相对较低，容易出现模糊的割裂感。\n所以Kontext是我测试多次之后，用排除法得到的最优选。\n\n🦋 kontext的缺陷是不支持中文，所以还是用的翻译节点，另外做人物的时候效果不佳。\n\n✍ 本工作流制作于2025年8月，目前暂无更新。\n\n---\n\n和风工作流节点颜色简易区分：\n-\n\n- 💎蓝色为需求输入和结果获取；\n\n- ✅绿色为根据需求更换；\n\n- 💜紫色为注意参考；\n\n- ☝黄色为尽量不更改；\n\n- ❌红色为绝对不要更改；\n\n- 🔗灰色为其他默认链接框架。\n\n---\n\n外补画板添加扩图的像素，因为是提示词控制成图的结果，所以这里必须要注意描述的物体和原图的比例，一定要控制好，尤其是对人物相片的扩图需求求。譬如原图人物图像分辨率为800*800，是个半身像，那么需要补充成全身，就必须根据补充的部分去按比例添加扩图的像素，譬如修改为800*1800。这只举例。你可以把vae编码之后的所有流程禁用，先预览像素遮罩和原图的比例来进行判断。\n\n另外人物扩图有两点需要注意，①服装过于复杂时，尽量不要描述，或者尽可能详细的描述，否则容易出错。②不要同时多个方向扩图，可以一个方向一个方向的重复扩图，否则容易出现光影错乱的割裂感。\n\n该工作流，非常适用于建筑，常见物品的扩图。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "工作流概览", "mode": 0, "bgcolor": "#535", "size": [373.99072265625, 519.6904296875], "pos": [34.99446105957031, 262.4771728515625], "id": 22, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 6}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-90.12500332350737, -208.3768628043959], "scale": 1.5535220464769057}}, "groups": [{"color": "#3f789e", "font_size": 80, "flags": {}, "id": 1, "title": "扩图 flux kontext -- 和风", "bounding": [1030.6414794921875, 151.9849395751953, 2712.9931640625, 1609.8319091796875]}, {"color": "#b58b2a", "font_size": 168, "flags": {}, "id": 2, "title": "和风友情提示", "bounding": [1928.0916748046875, -557.5921630859375, 1023.6593017578125, 234.3857879638672]}, {"color": "#b06634", "font_size": 80, "flags": {}, "id": 3, "title": "只做工作流分享，不做技术解析，感谢大家的支持和鼓励，希望大家都能良好使用", "bounding": [963.0923461914062, -197.22935485839844, 2884.8388671875, 111.7882308959961]}, {"color": "#b06634", "font_size": 80, "flags": {}, "id": 4, "title": "和风再次提醒大家，若需商用，一定要做好版权查询，切莫侵权，否则只会伤人害己", "bounding": [921.061767578125, -38.0189208984375, 2967.04541015625, 112.72915649414062]}], "links": [[1, 1, 0, 2, 0, "IMAGE"], [2, 2, 0, 3, 0, "IMAGE"], [3, 3, 0, 4, 0, "INT"], [4, 3, 1, 4, 1, "INT"], [5, 4, 0, 5, 0, "IMAGE"], [6, 2, 1, 5, 1, "MASK"], [7, 5, 0, 6, 1, "IMAGE"], [8, 2, 0, 6, 0, "IMAGE"], [9, 2, 1, 6, 2, "MASK"], [10, 6, 0, 7, 0, "IMAGE"], [11, 7, 0, 8, 0, "IMAGE"], [12, 9, 0, 10, 0, "MODEL"], [13, 11, 0, 12, 0, "CLIP"], [15, 13, 0, 12, 1, "STRING"], [16, 12, 0, 14, 0, "CONDITIONING"], [17, 14, 0, 10, 2, "CONDITIONING"], [18, 12, 0, 15, 0, "CONDITIONING"], [19, 15, 0, 16, 0, "CONDITIONING"], [20, 16, 0, 10, 1, "CONDITIONING"], [21, 7, 0, 17, 0, "IMAGE"], [22, 18, 0, 17, 1, "VAE"], [23, 17, 0, 15, 1