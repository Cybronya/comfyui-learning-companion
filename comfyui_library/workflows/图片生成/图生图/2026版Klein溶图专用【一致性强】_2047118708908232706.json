composition layout. Relight the product to perfectly match the bright cold ambient lighting conditions of the environment, ensuring physically accurate contact shadows and reflection mapping. **Maintain strict original product geometry and exact color values, ensure accurate white balance consistency, no color shift, no hue shift.** Enhance crystal clear glass transparency and accurate liquid refraction. Hyper-realistic digital integration, PBR, professional studio relighting, no distortion, 8k resolution, high fidelity.\n", 1024, true, 347829733981649, "randomize"], "inputs": [{"shape": 7, "name": "image", "link": 5, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 6, "type": "AILab_QwenVL", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 8}, {"mode": 0, "outputs": [{"name": "image", "links": [5, 7, 8, 18], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"