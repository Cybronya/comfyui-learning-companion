构。"], "inputs": [{"shape": 7, "name": "anything", "link": 11, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 134, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 8}, {"mode": 0, "outputs": [{"name": "prompt", "links": [12], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [100, 924], "widgets_values": ["画个简笔画"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 142, "type": "CR Prompt Text", "title": "自己写的提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "STRING", "links": [11, 26], "label": "STRING", "type": "*", "localized_name": "STRING"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [270, 78], "pos": [1100, 130], "widgets_values": [""], "inputs": [{"shape": 7, "name": "text1", "link": 12, "label": "text1", "type": "STRING", "localized_name": "text1"}, {"shape": 7, "name": "text2", "link": 13, "label": "text2", "type": "STRING", "localized_name": "text2"}, {"widget": {"name": "separator"}, "shape": 7, "name": "separator", "label": "separator", "type": "STRING", "localized_name": "separator"}], "flags": {}, "id": 135, "type": "CR Text Concatenate", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text Concatenate"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [27], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [100.00001525878906, 210.2672576904297], "widgets_values": ["ca32e643a76d99e59cc078adbd1ca57ab838dafa4