&R": "LayerUtility: SmolLM2"}, "order": 60}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#8e0101", "size": [320, 60], "color": "#a21515", "pos": [3270, 70], "inputs": [], "flags": {}, "id": 125, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "sort": "custom alphabet", "matchTitle": "视频生成", "showNav": true, "toggleRestriction": "default"}, "order": 34}, {"mode": 4, "outputs": [], "size": [670, 660], "pos": [2370, -710], "widgets_values": ["食物"], "inputs": [{"name": "images", "link": 60, "label": "图像", "type": "IMAGE", "localized_name": "图片"}], "flags": {}, "id": 78, "type": "SaveImage", "properties": {"Node name for S&R": "SaveImage"}, "order": 78}, {"mode": 0, "outputs": [{"name": "STRING", "slot_index": 0, "links": [114], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 700], "pos": [2670, 830], "widgets_values": ["作为超现实生物描述生成器，你接收图片的[主体]和[场景]，按以下规则生成提示词：\n固定规则\n\n随着手指施加压力，外壳开始剥开，露出意想不到的东西\n\n动词必须为：peel/pry/split/crack + 水果部位（表皮/外壳/叶片）\n\n剥开前触感限于真实物理属性（如坚硬/粗糙/粘腻）\n\n分层暴露生物\n剥开后必须出现：\n\n中间过渡层（囊体/晶体/黏液膜）\n\n核心生物（含动态器官+异常能量）\n\n场景冲突锚点\n必须包含一个日常物品（如价签/餐具/木纹）和光源互动（反射/折射/投射）\n\n自由规则\n\n生物需混合2类特征：\n运动（抽搐/旋转/分裂）\n分泌物（反重力液/结晶/气化）\n\n输出格式\nFirst-person POV, hands [动作] a [颜色][水果] from [场景]. [触感]. As [剥开结果], [中间层]. [生物动态]. [渗出物]. [场景冲突对比].\n输出格式参考：\nFirst-person POV, hands grasp a large, yellow melon from a metal display rack at a supermarket. Its smooth surface is slightly waxy to the touch, firm under pressure. As the fingers apply pressure, the outer shell begins to peel apart, revealing something unexpected inside. A glowing, semi-transparent sac stretches beneath the rind, pulsing with soft waves of neon blues, deep purples, and sickly greens. Within, a small, coiled form shifts—a tiny, embryonic creature with an iridescent exoskeleton, its minuscule appendages twitching against the thin membrane. Thick, gel-like fluid seeps from the openi