e": "IMAGE", "links": [22], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314.0000305175781], "pos": [-412.3349304199219, 437.8582763671875], "widgets_values": ["0a0d77ffe3f2da300aa060fc0fb14fd58710d4135c735db190b274c1533f2b36.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 6, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 1}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [21], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314.0000305175781], "pos": [-42.15958023071289, 519.060791015625], "widgets_values": ["3516e79a33fb97ec1def7bbe81e9f47b71e9a6e2feec551c4fad745b02dda13f.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 4, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}, {"mode": 0, "outputs": [{"name": "STRING", "links": [25], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [270, 82], "pos": [274.3970947265625, 683.2031860351562], "widgets_values": ["- 图1 = 产品：画面中的产品必须与图1完全一致（外形、颜色、logo、比例细节），禁止改动、变形或替换成其他产品。 - 图2 = 视觉风格：整体画面风格、背景、装饰元素、光影氛围参照图2。 - 图3 = 版式与内容：步骤数量、步骤顺序、步骤文案、标题样式和配色方案全部沿用图3，与图3保持一致。", "视角展示"], "inputs": [{"widget": {"name": "a"}, "name": "a", "label": "a", "type": "STRING", "localized_name": "a"}, {"widget": {"name": "b"}, "name": "b", "link": 12, "label": "b", "type": "STRING", "localized_name": "b"}], "flags": {}, "id": 8, "type": "JWStringConcat", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JWStringConcat"}, "order": 4}, {"mode": 0, "outputs": [{"name": "string", "links": [12], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [427.22723388671875, 189.40155029296875], "pos": [-195.5359344482422, 958.9761962890625], "widgets_values": ["安装图以三张步骤卡片沿对角动线展开，步骤1、2、3配浅灰数字节点和英文动作短语，手部只服务关键操作，最后卡片呈现安装后的稳定状态。\",\n    \"prompt\": \"本图视觉目标为制作安装步骤信息图，用三个连续且清晰的操作卡片说明车内调节儿童观察镜的连接、夹合和调节方式。画面为1:1宽高比，采用半场景半排版的非对称结构，左侧上方为标题与说明留白，右侧和下方布置三张圆角步骤卡片，三张卡片按1、2、3形成从左上到右下的视觉动线，卡片合计占画面约72%。产品外观保持真实：上端为黑色短宽圆角夹头，夹头内侧有浅灰色锯齿状软质防滑垫；中间为细长黑色竖向圆柱支撑柱；支撑柱下方连接黑色横向支撑锁紧结构；下部为宽幅圆角矩形镜面，黑色厚实外框包围，底边中央有半圆形内凹缺口，镜面反射呈浅灰白渐变。每个步骤卡片底色白色，描边色浅灰色，文字颜色深炭黑，圆角二十四像素，投影为低透明短距离灰影；数字圆形图标底色浅灰色，数字颜色白色，外圈描边色浅灰色，箭头为浅灰色细线。英文主标题固定置于画面正上方，采用粗体 Sans Serif 斜体气质，深炭黑大写字母，字号为画面宽度的7%，字距紧凑，标题关键词以浅灰色细线切分形成黑色与浅灰色撞色，标题下方居中放置一条浅灰色装饰细线和一个极简线性小图标。主标题文字为 EASY ASSEMBLY，副标题文字为 Clip And Adjust，置于标题下方居中，深炭黑轻字重，字号为主标题的30%，画面中文字仅包含英文。步骤1卡片位于左中，动作短语为 Connect Parts，展示支架与镜体对接并拧紧的中间瞬间：产品镜体平放在哑光极浅暖白台面上，镜面朝上，黑色支撑柱已对准镜体上缘后侧的横向连接位，单只成人右手出现，五根手指可见，拇指和食指捏住黑色旋紧连接位，掌心悬于台面上方2厘米，另一只手未出现，产品主体由台面承托。步骤2卡片位于右上，动作短语为 Clip On Mirror，展示顶部夹头夹住原车后视镜本体的中间瞬间：原车后视镜固定在车内前挡风玻璃下方，单只成人左手出现，四根手指可见，手指压在夹头外侧边缘，浅灰锯齿防滑垫贴近原车后视镜下缘，竖向支撑柱垂直下垂，镜体悬挂在原车后视镜下方。步骤3卡片位于右下最大区域，动作短语为 Tighten Adjust，展示安装后的单一完成状态：顶部夹头已紧密夹在原车后视镜本体上，支撑柱垂直，横向锁紧结构位于镜体上缘后方，镜面朝向驾驶员方向，黑色镜框完整，底部半圆内凹缺口清晰，成人手部退出画面，产品与原车后视镜形成稳定悬挂空间关系。三张卡片之间使用浅灰色细箭头连接，箭头方向从步骤1指向步骤2再指向步骤3。背景延续左上高亮至右下极浅暖白灰渐变，卡片内部车内环境为低对比深度虚化，台面与原车后视镜均按真实尺寸呈现，单个产品在每张卡片中的宽度比例以 6 in 为视觉基准，原车后视镜长边大于产品夹头宽度。主光来自左上方45°，辅光来自正前方漫射，轮廓光来自右后方，黑色塑料夹头、支撑柱和镜框边缘形成细窄高光，浅灰防滑垫齿纹呈哑光细节，镜面维持浅灰白柔和反射；手部皮肤受光自然，手指位于夹头和连接位边缘空区，关键结构保持清晰。相机高度为产品高度的1.5倍，相机光轴与水平面成约20°俯角，70mm焦段感，透视压缩中等，景深覆盖每张卡片内的产品、手部和原车后视镜接触位置，背景虚化顺滑。产品接缝、边缘包边、连接位贴合关系和底部缺口弧线均以高分辨率呈现，视觉动线由 EASY ASSEMBLY 进入步骤1手部连接动作，再经箭头进入夹合动作，最后落到安装完成状态。输出为8K商业摄影级清晰度，高分辨率产品细节，精确边缘，真实材质表现，自然阴影，克制高光，高级商业精修，清晰英文排版，准确产品比例，真实空间关系，亚马逊电商信息图品质，国际品牌产品目录质感。产品一致性保护要求：三步中的产品均为同一件黑色夹持式婴儿观察镜，顶部夹头、浅灰锯齿防滑垫、竖向支撑柱、横向锁紧结构、圆角矩形镜面、底部半圆内凹缺口和单个成品数量保持一致。AVOID：1. 无中文字符；2. 无乱码英文；3. 无水印；4. 无品牌标志；5. 无产品变形；6. 无卡通插画感；7. 无产品与手部融合；8. 无遮挡产品关键结构；9. 无场景杂乱；10. 无多余零件；11. 无错误安装方向；12. 无错误使用方式；13. 无镜像结构错误；14. 无产品粘连；15. 无缺失零件。\""], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 7, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 3}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [738.4096279263923, -102.36035519790391], "scale": 0.7247295000000004}}, "groups": [], "links": [[12, 7, 0, 8, 1, "STRING"], [19, 1, 0, 10, 0, "IMAGE"], [20, 1, 0, 10, 1, "IMAGE"], [21, 4, 0, 10, 2, "IMAGE"], [22, 6, 0, 10, 3, "IMAGE"], [24, 10, 0, 3, 0, "IMAGE"], [25, 8, 0, 10, 10, "STRING"]], "id": "dfc259f2-c3d2-4c41-b31d-9d58f2d80dd3", "config": {}, "version": 0.4, "last_node_id": 10, "revision": 0}