ype": "INT", "localized_name": "decode_tile_overlap"}, {"widget": {"name": "tile_debug"}, "shape": 7, "name": "tile_debug", "label": "tile_debug", "type": "COMBO", "localized_name": "tile_debug"}, {"widget": {"name": "offload_device"}, "shape": 7, "name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}], "flags": {}, "id": 119, "type": "SeedVR2LoadVAEModel", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SeedVR2LoadVAEModel"}, "order": 8}, {"mode": 0, "outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 150], "pos": [1595.809326171875, 1310.6571044921875], "widgets_values": ["output/软件/文本", "反推图片提示词", "txt", true], "inputs": [{"name": "text", "link": 171, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "output_file_path"}, "name": "output_file_path", "label": "output_file_path", "type": "STRING", "localized_name": "output_file_path"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overwrite", "type": "BOOLEAN", "localized_name": "overwrite"}], "flags": {}, "id": 148, "type": "easy saveText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy saveText"}, "order": 21}, {"mode": 0, "outputs": [{"name": "image_urls", "links": [130], "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [331.1303405761719, 552.405517578125], "pos": [2171.27294921875, 935.089599609375], "widgets_values": [], "inputs": [{"name": "images", "link": 129, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 133, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 25}, {"mode": 0, "outputs": [{"shape": 6, "name": "文本", "label": "文本", "type": "STRING", "localized_name": "文本"}], "size": [445.53424072265625, 405.5939636230469], "pos": [-931.77099609375, 513.7266845703125], "widgets_values": ["一、核心目标​\n请对所提供的图片进行全面的摄影细节分析，目的是根据你的分析结果反推出可用于生成同类风格照片的详细提示词（Prompt）。\n二、分析维度与结构要求​\n请务必按以下结构化框架进行详细分析，并确保每个部分都有具体描述：\n主体与构图\n主体描述：​ 人物（数量、五官、妆容、性别）、主要物体或场景的核心特征。\n摆姿与神态：​ 如果是人物，描述其姿势（站、坐、卧、动作）、肢体语言、面部表情及视线方向。\n构图方式：​ 分析使用的构图技法，如居中构图、三分法、对称构图、引导线构图、框架构图等，并说明主体在画面中的位置。\n景别：​ 特写、近景、中景、全景还是远景？\n视角：​ 平视、仰视、俯视？拍摄机位的高度和角度。\n光影与色彩\n光源类型与方向：​ 自然光（晴、阴、时段）还是人造光？主光方向（顺光、侧光、逆光、顶光、底光）。\n光线质量：​ 光线是硬光（阴影锐利）还是软光（阴影柔和、过渡平滑）？\n影调与氛围：​ 整体是高调（明亮）、低调（昏暗）、中间调？光影创造了何种氛围（明亮清新、深沉神秘、温暖温馨、冷峻科技感等）？\n色彩风格：​ 整体色调（暖色调、冷色调、中性色）。色彩是鲜艳饱和、清淡柔和、还是低饱和/单色？有无明显的色彩偏向或滤镜感。\n影像技术细节（推断）\n景深：​ 背景是清晰（大景深）还是虚化（浅景深）？虚化程度如何？\n镜头焦段推断：​ 根据透视和景深效果，推断可能使用的镜头焦段（如广角、标准、中长焦、长焦）。\n相机参数推断：​ 推断可能的光圈（f值大小影响景深）、快门速度（是否有动态模糊）、感光度（画面噪点水平）。\n画幅与质感：​ 是否有胶片颗粒、柔光、漏光、划痕等特殊质感或滤镜效果？\n场景、服装与道具\n环境与背景：​ 详细描述拍摄环境（室内、室外、影棚）及背景中的关键元素。\n服装造型：​ 人物的衣着风格、颜色、材质、款式。发型与妆容特点。\n道具与装饰：​ 画面中出现的任何道具、装饰物，及其在构图中的作用。\n风格与美学参考\n整体风格：​ 总结图片所属的摄影风格（如人像写真、时尚大片、电影感、纪实、静物美学、概念艺术等）。\n参考类比：​ 可联想到的摄影师风格、电影视觉、艺术流派或特定文化美学。\n三、输出格式要求​\n请将你的分析结果严格按照以下格式组织，以便直接提取用于生成提示词：\n【图片摄影分析报告】\n\n**1. 主体与构图**\n- **主体：** [描述]\n- **摆姿/神态：** [描述]\n- **构图与景别：** [描述]\n- **视角：** [描述]\n\n**2. 光影与色彩**\n- **光源与方向：** [描述]\n- **光线质量：** [描述]\n- **影调与氛围：** [描述]\n- **色彩风格：** [描述]\n\n**3. 影像技术细节（推断）**\n- **景深与虚化：** [描述]\n- **镜头焦段推断：** [描述]\n- **相机参数推断：** [描述]\n- **画质与特效：** [描述]\n\n**4. 场景、服装与道具**\n- **环境与背景：** [描述]\n- **服装造型：** [描述]\n- **道具装饰：** [描述]\n\n**5. 风格与美学参考**\n- **整体风格：** [描述]\n- **参考类比：** [描述]\n\n**6. 综合提示词建议**\n基于以上分析，整合成一段或多段可用于AI绘图的详细提示词（要中文，建议包含核心关键词）。例如：“[一个详细的、包含上述关键元素的描述性提示词]”\n四、注意事项​\n分析应尽可能具体、客观，避免模糊词汇。\n对于技术参数（如焦段、光圈）的推断，可基于视觉效果给出合理推测。\n“综合提示词建议”部分旨在将分析结论直接转化为可操作的内容，是本次任务的关键产出。\n请基于此指令，对接收到的图片进行分析。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {}, "id": 160, "type": "MuyeTextEditOutput", "title": "提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MuyeTextEditOutput"}, "order": 9}, {"mode": 0, "outputs": [{"name": "STRING", "links": [101], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [311.8819274902344, 415.3843994140625], "pos": [315.0762634277344, 951.0285034179688], "widgets_values": ["一、核心目标​\n请对所提供的图片进行全面的摄影细节分析，目的是根据你的分析结果反推出可用于生成同类风格照片的详细提示词（Prompt）。\n二、分析维度与结构要求​\n请务必按以下结构化框架进行详细分析，并确保每个部分都有具体描述：\n主体与构图\n主体描述：​ 人物（数量、五官、妆容、性别）、主要物体或场景的核心特征。\n摆姿与神态：​ 如果是人物，描述其姿势（站、坐、卧、动作）、肢体语言、面部表情及视线方向。\n构图方式：​ 分析使用的构图技法，如居中构图、三分法、对称构图、引导线构图、框架构图等，并说明主体在画面中的位置。\n景别：​ 特写、近景、中景、全景还是远景？\n视角：​ 平视、仰视、俯视？拍摄机位的高度和角度。\n光影与色彩\n光源类型与方向：​ 自然光（晴、阴、时段）还是人造光？主光方向（顺光、侧光、逆光、顶光、底光）。\n光线质量：​ 光线是硬光（阴影锐利）还是软光（阴影柔和、过渡平滑）？\n影调与氛围：​ 整体是高调（明亮）、低调（昏暗）、中间调？光影创造了何种氛围（明亮清新、深沉神秘、温暖温馨、冷峻科技感等）？\n色彩风格：​ 整体色调（暖色调、冷色调、中性色）。色彩是鲜艳饱和、清淡柔和、还是低饱和/单色？有无明显的色彩偏向或滤镜感。\n影像技术细节（推断）\n景深：​ 背景是清晰（大景深）还是虚化（浅景深）？虚化程度如何？\n镜头焦段推断：​ 根据透视和景深效果，推断可能使用的镜头焦段（如广角、标准、中长焦、长焦）。\n相机参数推断：​ 推断可能的光圈（f值大小影响景深）、快门速度（是否有动态模糊）、感光度（画面噪点水平）。\n画幅与质感：​ 是否有胶片颗粒、柔光、漏光、划痕等特殊质感或滤镜效果？\n场景、服装与道具\n环境与背景：​ 详细描述拍摄环境（室内、室外、影棚）及背景中的关键元素。\n服装造型：​ 人物的衣着风格、颜色、材质、款式。发型与妆容特点。\n道具与装饰：​ 画面中出现的任何道具、装饰物，及其在构图中的作用。\n风格与美学参考\n整体风格：​ 总结图片所属的摄影风格（如人像写真、时尚大片、电影感、纪实、静物美学、概念艺术等）。\n参考类比：​ 可联想到的摄影师风格、电影视觉、艺术流派或特定文化美学。\n三、输出格式要求​\n请将你的分析结果严格按照以下格式组织，以便直接提取用于生成提示词：\n【图片摄影分析报告】\n\n**1. 主体与构图**\n- **主体：** [描述]\n- **摆姿/神态：** [描述]\n- **构图与景别：** [描述]\n- **视角：** [描述]\n\n**2. 光影与色彩**\n- **光源与方向：** [描述]\n- **光线质量：** [描述]\n- **影调与氛围：** [描述]\n- **色彩风格：** [描述]\n\n**3. 影像技术细节（推断）**\n- **景深与虚化：** [描述]\n- **镜头焦段推断：** [描述]\n- **相机参数推断：** [描述]\n- **画质与特效：** [描述]\n\n**4. 场景、服装与道具**\n- **环境与背景：** [描述]\n- **服装造型：** [描述]\n- **道具装饰：** [描述]\n\n**5. 风格与美学参考**\n- **整体风格：** [描述]\n- **参考类比