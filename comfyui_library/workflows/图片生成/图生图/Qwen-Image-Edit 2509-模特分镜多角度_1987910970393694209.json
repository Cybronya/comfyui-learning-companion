4.469482421875, 895.5064086914062], "widgets_values": ["Next Scene: A low-angle close-up of the shoes, emphasizing texture and design. The background remains consistent with the lush greenery visible through the window, and the wooden floor adds a natural contrast.\nNext Scene: A wide shot capturing the full body of both models, standing slightly apart. The camera is positioned at eye level, highlighting the shoes in the context of their overall outfits.\nNext Scene: A dynamic side view of both models walking, the camera tracking their movement to focus on the shoes in motion. The lush greenery remains visible in the background.\nNext Scene: A close-up of one model’s feet, slightly turned outward to showcase the shoe design. The wooden floor is prominently displayed, creating a warm and natural atmosphere.\nNext Scene: A medium shot of the models seated on a minimalist bench, legs extended slightly to draw attention to the shoes. The window and greenery provide depth to the frame.\nNext Scene: A dramatic overhead shot focusing on the models’ shoes from above, creating a unique perspective. The symmetry of their positioning adds visual interest.\nNext Scene: A low-angle shot of the models standing near the window, with their shoes as the focal point. The greenery outside creates a soft, blurred background.\nNext Scene: A medium close-up with one model stepping forward, the shoe prominently displayed in the foreground. The other model remains slightly blurred in the background.\nNext Scene: A tight close-up of the shoe’s laces and texture, capturing intricate details. The wooden floor and greenery subtly frame the shot.\nNext Scene: A wide-angle shot of the models leaning casually against the window frame, their shoes subtly highlighted within the composition. The natural light enhances the scene.\nNext Scene: A dynamic tracking shot of the models walking toward the camera, with their shoes gradually coming into focus. The surrounding environment adds motion and depth.\nNext Scene: A creative low-angle shot from behind the models, showcasing the shoes as they walk away. The greenery outside the window provides a soft, natural backdrop.\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 151, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [12458, 12459, 12460, 12461, 12462, 12463, 12464], "VHS_MetadataImage": true, "ue_links": [{"controller": 147, "upstream": "145", "downstream_slot": 0, "downstream": 61, "upstream_slot": 0, "type": "CLIP"}, {"controller": 147, "upstream": "146", "downstream_slot": 1, "downstream": 61, "upstream_slot": 0, "type": "VAE"}, {"controller": 147, "upstream": "145", "downstream_slot": 0, "downstream": 68, "upstream_slot": 0, "type": "CLIP"}, {"controller": 147, "upstream": "146", "downstream_slot": 1, "downstream": 68, "upstream_slot": 0, "type": "VAE"}, {"controller": 147, "upstream": "146", "downstream_slot": 1, "downstream": 69, "upstream_slot": 0, "type": "VAE"}, {"controller": 147, "upstream": "148", "downstream_slot": 0, "downstream": 56, "upstream_slot": 0, "type": "MODEL"}, {"controller": 147, "upstream": "146", "downstream_slot": 1, "downstream": 60, "upstream_slot": 0, "type": "VAE"}], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [2488.212142929804, -408.56994792377606], "scale": 0.964614964500016}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 12, "title": "Group", "bounding": [-35.91878890991211, 150.047119140625, 759.8109130859375, 634.2203979492188]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 13, "title": "Group", "bounding": [-1360.0760498046875, 144.15902709960938, 1306.275390625, 646.2509765625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 15, "title": "Group",