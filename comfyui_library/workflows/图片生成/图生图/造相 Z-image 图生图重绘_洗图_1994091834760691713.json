name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 16, "type": "AILab_QwenVL", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 25}, {"mode": 0, "outputs": [{"name": "output", "links": [3], "label": "output", "type": "*", "localized_name": "output"}], "size": [526.0617065429688, 471.5259094238281], "pos": [1717.5771484375, 1145.045654296875], "widgets_values": ["一位亚洲青年男子坐在户外长椅上，双臂张开呈“欢迎”或放松姿态，身体微微后仰，面向镜头。他戴着白色口罩遮住口鼻，短黑发略显凌乱但整洁，露出清晰轮廓与坚毅眼神，虽被口罩掩盖部分面部情绪，但仍透出自信神态。其体型健硕，肩部及手臂线条分明，腿部毛发浓密自然，呈现健康型肌理感。穿着黑色运动背心搭配同色系短裤，脚踩黑白蓝三色拼接篮球鞋，袜子为纯白带蓝色图案设计，凸显潮流街头风。\n\n该男子坐姿舒展，双腿微屈向前伸展，双脚轻点地面，形成动态平衡。镜头从低处向上仰拍，以广角捕捉全身比例，强化力量感与空间纵深。阳光明媚，天空湛蓝如洗，绿树成荫环绕四周，远处隐约可见公园设施与模糊植被，地面上有局部湿润痕迹反射光线，增添真实质感。\n\n整幅画面采用大光圈虚化处理，焦点集中于人物躯干与四肢，背景树木柔和过渡至淡影中。色彩饱和度高，蓝天碧草映衬深灰衣装与亮蓝球鞋，视觉对比鲜明而和谐。明亮日光照耀下，阴影层次丰富却不刺眼，营造轻松活力又具都市气息的生活美学基调。此图为当代年轻健身文化写照——在公共休闲场所展现自我状态，兼具时尚表达与健康宣言意味。"], "inputs": [{"shape": 7, "name": "anything", "link": 31, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 11, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 27}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [21], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 262], "pos": [1325.96484375, 3142.677001953125], "widgets_values": [1030454734910631, "fixed", 4, 1, "euler", "simple", 0.7500000000000001], "inputs": [{"name": "model", "link": 36, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "positive", "link": 17, "label": "正面条件", "type": "CONDITIONING", "localized_name": "正面条件"}, {"name": "negative", "l