": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "title": "画布比例与像素", "mode": 0, "bgcolor": "#333229", "size": [420, 170], "pos": [100, 850], "id": 213, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 0}, {"outputs": [{"name": "prompt", "links": [3], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#41445c", "widgets_values": ["生成一张超写实摄影风格的人物三视图与面部特写设定卡，纯白无缝影棚背景。整张图只展示参考图中同一人物的四个视图：正面全身、侧面全身、背面全身、正面头部特写。\n\n【人物与姿态一致性】\n以参考图为唯一人物依据，保持面部结构、五官比例、发际线、发型、发色、体型及身体比例一致。服装款式、颜色、材质、剪裁、配饰和手持道具均与参考图一致，不重新设计，不增加或删减。\n\n三个全身视图呈现同一人物在同一瞬间、保持同一姿势时，从不同方向观察到的样子。保留参考图中的站姿、重心、四肢位置、手势和握持方式，仅改变观察角度。配饰及道具始终位于人物自身相同的一侧，不因换角度而左右互换；允许身体产生合理遮挡，不为展示道具而改变姿势。\n\n【版面布局】\n画面左侧约占总宽度的三分之二，分为三个等宽区域，从左到右依次为：\n1. 正面全身：身体正面朝向镜头。\n2. 严格侧面全身：身体与面部均呈90度侧面，避免四分之三侧身。\n3. 背面全身：身体背对镜头，头部随身体保持原有朝向，不回头。\n\n三个全身视图使用相同的拍摄比例与平视视角，人物身高一致，头顶和脚底分别对齐。从发顶到鞋底完整入画，四肢、配饰及手持道具不超出各自区域，视图之间留有清晰空隙，不重叠、不裁切。\n\n画面右侧约占总宽度的三分之一，单独放置同一人物的正面头部大特写，完整保留发顶、两侧发型、双耳所在区域及下巴，清楚呈现五官与皮肤细节。特写与左侧全身视图保持相同的人物身份、发型、妆容和肤色。\n\n【未展示结构】\n参考图未展示的侧面与背面细节，依据可见服装的剪裁、接缝、材质和配饰连接方式合理补全。正侧背结构相互对应，不凭空增加图案、装饰、开口或配件。\n\n【摄影与画质】\n柔和、均匀、中性的专业影棚布光，各视图曝光与白平衡一致。真实自然的皮肤纹理、发丝与衣料质感，细节清晰，避免过度磨皮和塑料光泽。全身视图保持足够景深，面部、衣服及鞋履均清楚可辨。\n\n纯白背景，版面干净，不画分隔线。无文字、标签、色卡、标尺、边框、Logo或水印。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#2d2f40", "size": [620, 540], "pos": [660, 1120], "id": 214, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 1}, {"outputs": [{"name": "VAE", "links": [2, 6], "type": "VAE", "localized_name": "VAE"}], "color": "#344857", "widgets_values": ["qwen_image_2.1_vae_bf16.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "type": "COMBO", "localized_name": "vae名称"}], "flags": {}, "type": "VAELoader", "mode": 0, "bgcolor": "#242f39", "size": [420, 90], "pos": [100, 650], "id": 219, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 2}, {"outputs": [{"name": "CLIP", "links": [4], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#344857", "widgets_values": ["qwen3vl_8b_bf16.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#242f39", "size": [420, 120], "pos": [100, 460], "id": 225, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 3}, {"outputs": [{"name": "IMAGE", "links": [5], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#334c50", "widgets_values": ["e0b16c6849c290a549b930485a2a0e506bc169e2212b23109914ae5987f0e66c.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#253337", "size": [620, 740], "pos": [660, 310], "id": 215, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 4}, {"outputs": [], "color": "#35434c", "widgets_values": ["从左到右：模型与画布 