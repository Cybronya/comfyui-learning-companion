转正面] 贞贞极其野性地将太刀扛在肩上，转身面向镜头，胸前运动内衣包裹的曲线在冷光下展现出致命的力量感。画外音：“目前只是早期版本，”\n镜8 (14-15s)[第一人称主观镜头] 贞贞狂野地挥舞太刀，一道耀眼的蓝色剑气直接劈向镜头，画面在光芒中瞬间切黑。画外音：“耍起！”", "15", "720p", "16:9", true, -1, "fixed", false], "inputs": [{"shape": 7, "name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 7, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "video1", "label": "video1", "type": "VIDEO", "localized_name": "video1"}, {"shape": 7, "name": "video2", "label": "video2", "type": "VIDEO", "localized_name": "video2"}, {"shape": 7, "name": "video3", "label": "video3", "type": "VIDEO", "localized_name": "video3"}, {"shape": 7, "name": "audio1", "link": 5, "label": "audio1", "type": "AUDIO", "localized_name": "audio1"}, {"shape": 7, "name": "audio2", "label": "audio2", "type": "AUDIO", "localized_name": "audio2"}, {"shape": 7, "name": "audio3", "label": "audio3", "type": "AUDIO", "localized_name": "audio3"}, {"shape": 7, "name": "api_config", "link": 3, "label": "api_config", "type": "SEEDANCE_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "l