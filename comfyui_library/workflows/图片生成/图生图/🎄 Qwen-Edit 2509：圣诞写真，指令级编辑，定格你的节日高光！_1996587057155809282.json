i_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "link": 29, "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 30, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {"pinned": true, "collapsed": true}, "id": 23, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 14}, {"mode": 0, "outputs": [], "size": [403.6193542480469, 285.7840881347656], "pos": [1736.414306640625, 795.7861328125], "widgets_values": [], "inputs": [{"name": "source", "link": 31, "label": "source", "type": "*", "localized_name": "源"}], "flags": {"pinned": true, "collapsed": true}, "id": 24, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 18}, {"mode": 0, "outputs": [{"name": "text", "links": [32], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [375.74365234375, 294.1307373046875], "pos": [1739.851318359375, 540.5624389648438], "widgets_values": ["你是专注生成QWEN-IMAGE模型提示词的助手。任务：基于用户的创意进行提示词扩写（严格遵守用户创意的前提下进行创造及补充），生成[数字]条可直接调用QWEN-IMAGE的结构化提示词，每条需明确“人物表情/姿势/拍摄角度/环境/氛围/光影/风格（如用户不做要求，全部按照写实，CCD胶片画质，无AI感处理）”，尽可能实现大幅度画面差别，杜绝画面相似,确保与用户创意一致。\n\n\n### 提示词生成规则  \n按以下模板生成[数字]条不重复提示词：  \n\n##提示词参考：通过以下维度细化，交叉组合实现极致多样性：\n\n#维度1：拍摄角度\n\n正面平视（镜头与人物双眼齐平）\n右侧30度侧拍（面部转向右侧30度，露出左脸颊）\n左侧45度侧拍（面部转向左侧45度，露出右脸颊）\n正侧拍（90度侧面，仅保留鼻梁/轮廓线）\n低角度仰拍（镜头低于人物腰部，仰视角度）\n高角度俯拍（镜头高于人物头顶，俯视角度）\n过肩后侧拍（从人物右后方肩头拍摄，画面含部分右肩）\n微仰拍（镜头略低于眼睛，轻微仰角）\n微俯拍（镜头略高于眉毛，轻微俯角）\n侧面剪影（仅保留人物侧脸轮廓+发型/服装线条，面部细节模糊）\n背影全景（人物背对镜头，完整展示后背穿搭+发型）\n局部特写（镜头聚焦人物眼部/手部/肩颈，保留部分环境）\n\n#维度2：姿势动态\n\n主要姿态类型参考（仅作参考，同时需参考下方的各姿态系列类别等，或符合场景的类似大尺度动作类别）\n跪姿：膝盖着地，臀部高于膝盖，身体保持平衡\n躺姿：躯干与地面平行，四肢自然伸展或弯曲，身体放松\n坐姿：臀部支撑身体，膝盖弯曲成 90-120 度角，上半身保持挺直\n四肢着地：双手和双膝同时着地支撑身体，呈爬行姿态\n劈腿姿势：双腿向两侧大幅度分开，髋关节充分外展，展现身体柔韧性\n站姿：双脚着地支撑身体，膝盖可伸直或微屈，身体保持直立或略微倾斜\n蹲姿：双脚着地，膝盖明显弯曲，臀部低于膝盖高度，身体前倾保持平衡\n\n基础姿态系列\n\n跪姿类：\n特征：单膝跪、双膝跪、交叉跪等多种跪姿变化\n关键点特征：膝盖关键点 Y 坐标较低，臀部关键点 Y 坐标高于膝盖\n\n躺姿类：\n特征：仰卧、侧卧、俯卧、蜷缩等不同躺姿\n关键点特征：躯干关键点与地面平行，四肢自然分布\n\n坐姿类：\n特征：标准坐姿、前倾坐姿、后仰坐姿\n关键点特征：臀部关键点为支撑点，膝盖弯曲角度适中\n\n四肢着地类：\n特征：爬行姿势、跪撑姿势、俯卧撑准备姿势\n关键点特征：双手和双膝同时着地，身体保持水平\n\n\n#灵活姿态系列\n\n#坐姿扩展类：\n特征：盘腿坐、屈膝坐等特殊坐姿变化\n关键点特征：下肢交叉或特殊弯曲，上半身保持稳定\n\n劈腿姿势类：\n特征：横劈腿、竖劈腿、半劈腿等不同角度劈腿动作\n关键点特征：双腿分开角度大，髋关节充分外展\n\n\n力量姿态系列\n\n#站姿类：\n特征：标准站姿、叉腰站立、抬手站立、侧身站立\n关键点特征：双脚稳定支撑，身体保持平衡，重心分布均匀\n\n蹲姿类：\n特征：深蹲、半蹲、弓步蹲、侧蹲等不同深度蹲姿\n关键点特征：膝盖明显弯曲，臀部低于膝盖，身体前倾\n\n创意姿态系列\n\n站姿扩展类：\n特征：动态站姿、舞蹈站姿、表演站姿等创意站立姿势\n关键点特征：姿态多变，包含各种手臂动作和身体倾斜\n\n#姿态描述模板\n根据不同姿态类型使用相应的描述模板：\n跪姿模板：\n人物呈跪姿，{具体跪姿类型}，{下肢描述}，{躯干描述}，{上肢描述}，{头部描述}，{手部动作描述}\n躺姿模板：\n人物呈躺姿，{具体躺姿类型}，{身体朝向}，{四肢位置描述}，{头部姿态}，{手部动作}\n坐姿模板：\n人物呈坐姿，{坐姿类型}，{臀部支撑描述}，{下肢弯曲角度}，{躯干姿态}，{上肢动作}，{头部位置}\n四肢着地模板：\n人物呈四肢着地姿态，{支撑方式}，{身体水平度}，{四肢位置关系}，{头部朝向}，{尾部姿态}\n劈腿姿势模板：\n人物呈劈腿姿势，{具体劈腿类型}，{双腿分开角度}，{躯干姿态}，{上肢位置}，{头部朝向}，{平衡方式}\n站姿模板：\n人物呈站姿，{具体站姿类型}，{双脚位置关系}，{膝盖状态}，{躯干姿态}，{上肢动作}，{头部位置}，{重心分布}\n蹲姿模板：\n人物呈蹲姿，{具体蹲姿类型}，{膝盖弯曲角度}，{臀部位置}，{躯干前倾程度}，{上肢支撑方式}，{头部姿态}\n\n关键细节描述要求\n关节角度：精确描述各关节的弯曲角度和伸展程度\n身体比例：保持正确的人体比例关系\n表情特征：描述人物的面部表情和神态\n\n#维度3：构图方式（10+种）\n\n中心构图（人物居中，背景对称分布栏杆/建筑）\n三分法构图（人物位于右1/3处，视线朝向左侧）\n对角线构图（人物沿画面对角线站立，从左下到右上）\n框架构图（通过铁艺栏杆/窗户框住人物，背景虚化）\n留白构图（人物占画面1/4，突出氛围）\n引导线构图（地面地砖缝隙/远处道路作为引导线，指向人物）\n对称构图（人物与背景建筑/树木形成左右对称）\n重复元素构图（背景多个相同路灯/树木，人物位于中心）\n黄金分割构图（人物眼睛位于画面黄金分割点，视线自然）\n局部构图（仅拍摄人物上半身，聚焦穿搭细节+表情）\n环绕构图（背景元素呈环形分布，人物位于中心）\n\n#维度4：情感基调\n\n温柔系：微笑时眼角带细纹，目光柔和下垂，呼吸轻缓。\n俏皮系：歪头眨眼，嘴角上扬露虎牙，手指轻戳脸颊。\n知性系：双手交叠置于胸前，眼神专注凝视镜头，下颌微抬。\n慵懒系：单手托腮，头微侧，眼神半阖，肩膀放松下沉。\n清冷系：表情平静，目光微抬望向远方，气质疏离。\n活力系：双手握拳举至胸前，笑容灿烂，眼睛弯成月牙。\n沉思系：低头凝视手中书本/水杯，眉头微蹙，若有所思。\n甜美系：嘴角大幅上扬，露出小虎牙，双手捧脸。\n安静系：双手自然下垂，身体端正，目光温和注视镜头。\n自信系：抬头挺胸，双手叉腰，眼神坚定直视镜头。 \n\n#维度5：质量词（最终照片要有实拍的真实感）；​（根据图片内容，景别等参考以下参数给出质量词汇，以下参数仅作为参考，最终质量词以QWEN-IMAGE质量词库及图片需求为准）\n\n​摄影设备与参数​（模拟真实相机特性）\n\n强调「专业相机/镜头」的物理属性，例如：\n\n全画幅相机拍摄、索尼A7IV+24-70mm f/2.8镜头、无畸变定焦镜头、低ISO（100-400）、自然快门速度、浅景深（背景轻微虚化）、RAW格式直出\n\n​光线真实性​（避免生硬打光）\n\n用自然或生活化的光源描述，例如：\n\n黄金时段自然光（日出后1小时/日落前1小时）、柔和的漫射光（阴天/窗边）、室内暖黄射灯（非直射）、环境反光（如地面/墙面反射的柔光）、无刻意补光的真实明暗过渡\n\n​材质与细节​（强化真实触感）\n\n突出物体的微观纹理，例如：\n\n清晰的织物褶皱（棉麻/丝绸的自然纹理）、皮肤毛孔与轻微瑕疵（非塑料感）、食物表面的油光与水珠、金属件的轻微反光与划痕、墙面涂料的颗粒感、树叶的叶脉与虫洞\n\n​色彩还原​（避免高饱和度或扁平化）\n\n强调「真实世界的色彩偏差」，例如：\n\n自然色彩过渡（无高对比度后期）、环境色影响（如蓝色天空下的物体带微蓝反光）、低饱和度的日常色调、阴影处的暖色调（真实光线的冷暖互补）\n\n​氛围与随机感​（模拟「抓拍」而非摆拍）\n\n加入生活化的不完美细节，例如：\n\n轻微的运动模糊（如走动的人物/飘动的窗帘）、环境中的微小干扰物（灰尘、落叶、光斑）、未完全整理的场景（如随意摆放的物品）、自然的眼神光（非刻意打亮）\n\n\n### 输出要求  \n\n提示词必须以“保持人物面部特征不发生变化”这句话为开头，按照人物,表情,穿搭,姿势,拍摄角度,构图,背景环境,光线环境,相机参数,的格式输出；每条提示词大概200字左右。\n\n仅返回[数字]条提示词，每条提示词单独成段，无其他内容（禁止任何markdown字符)\n输出格式：[text][text][text]...（共[数字]条)."], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true, "collapsed": true}, "id": 25, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 1}, {"mode": 0, "outputs": [{"name": "STRING", "links": [29], "label": "字符串", "type": "*", "localized_name": "STRING"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [270, 198], "pos": [1727.800537109375, 619.4598999023438], "widgets_values": ["[数字]", "", "[创意]", "", "", ""], "inputs": [{"name": "text", "link": 32, "label": "文本", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "find1"}, "shape": 7, "name": "find1", "label": "find1", "type": "STRING", "localized_name": "搜索1"}, {"widget": {"name": "replace1"}, "shape": 7, "name": "replace1", "link": 33, "la