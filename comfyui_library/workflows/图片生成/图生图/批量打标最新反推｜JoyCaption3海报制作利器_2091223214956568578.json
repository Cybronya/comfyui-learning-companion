{"last_link_id": 193, "nodes": [{"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#323", "widgets_values": ["这是一种具有质感的流行艺术风格的数字图。它具有具有拟人型品质的斑马，唱歌成老式麦克风。斑马戴着橙色的心形太阳镜和一件红色和白色的条纹毛衣。它的嘴张开，表明它是中间的。背景是坚固的鲜红色，斑马后面有大的橙色圆形阳光状形状。在左边，有一棵小型，风格化的非洲相思树。斑马的黑白条纹是详尽而突出的。整体构图充满活力和嬉戏，红色背景与斑马的条纹图案之间存在强烈的对比。"], "inputs": [{"shape": 7, "name": "anything", "link": 156, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#535", "size": [425, 475], "pos": [1480.5, 1335], "id": 130, "properties": {"cnr_id": "comfyui-easy-use", "ver": "e4ac947d9612ef5d12fb055c0b51b9de8b981deb", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 28}, {"outputs": [{"name": "width", "links": [147], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [148], "label": "height", "type": "INT", "localized_name": "height"}, {"name": "count", "label": "count", "type": "INT", "localized_name": "count"}], "color": "#323", "widgets_values": [], "inputs": [{"name": "image", "link": 146, "label": "image", "type": "IMAGE", "localized_name": "image"}], "flags": {}, "type": "GetImageSize+", "mode": 0, "bgcolor": "#535", "size": [485, 66], "pos": [1630, 770], "id": 126, "properties": {"cnr_id": "comfyui_essentials", "ver": "9d9f4bedfc9f0321c19faf71855e228c93bd0dc9", "widget_ue_connectable": {}, "Node name for S&R": "GetImageSize+"}, "order": 13}, {"outputs": [{"name": "CONDITIONING", "links": [142, 143], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": [""], "inputs": [{"name": "clip", "link": 151, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 157, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [465, 93],