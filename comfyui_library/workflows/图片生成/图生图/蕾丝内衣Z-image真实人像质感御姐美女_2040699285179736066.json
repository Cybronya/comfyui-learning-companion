er": 17}, {"outputs": [{"name": "VAE", "links": [8, 25], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "color": "#232", "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "type": "VAELoader", "mode": 0, "bgcolor": "#353", "size": [383.5210876464844, 117.97339630126953], "pos": [-379.0463562011719, -381.8849182128906], "id": 3, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "output"}], "size": [402.78863525390625, 463.46417236328125], "pos": [148.22164916992188, -346.8580322265625], "widgets_values": ["红衣女郎立于专业摄影棚中央，身着剪裁利落的深红色西装式连体装束——V型领口低垂至锁骨，腰间双层金属扣带收紧曲线，下摆高收束凸显臀线；长袖贴合臂弯，肩部翻折设计增添结构张力。颈间悬坠一枚镶钻钥匙吊坠，在柔光映衬下闪烁冷冽光泽；耳畔垂挂流苏钻石耳环随发丝轻颤。棕褐卷发自然散逸于右肩与颊边，几缕被风拂动似有生命律动感。\n\n镜头聚焦胸腹核心区，采用浅景深压缩空间层次：近处肌肤纹理细腻可见，远处服装褶皱渐次模糊，营造身体雕塑般的立体纵深。画面左上角一盏方形LED灯以斜切角度投射暖调侧逆光，勾勒轮廓边缘的同时使面部明暗过渡柔和；右侧补光板则提供均匀底色，避免过曝阴影。整体色调偏暖灰蓝，白色反光墙作为纯净基底托举主体，强化“时尚大片”质感。\n\n构图遵循三分法黄金分割点定位人物双眼及腰部关键节点，并辅以轻微俯拍视角放大胸部比例优势。视线从眉心引向唇瓣再向下延伸至腰带扣件形成Z形叙事路径，暗示力量与优雅共存的主题内核。空气流动方向自右上方掠过脖颈与发梢，赋予静态影像动态呼吸节奏。\n\n氛围兼具高级时装秀场的戏剧性与私密影棚的沉浸感——既非纯商业广告般直白张扬，亦不似街头抓拍那般随意洒脱，而是精心雕琢后的当代女性美学宣言：自信却不傲慢，性感而不浮夸，将现代都市丽人置于聚光之下却保持从容姿态。\n\n适合用于模拟佳能R5+135mm f/2.8定焦镜组实拍效果：前期布光需三主光源协同控制曝光宽容度，后期保留皮肤噪点颗粒增强胶片肌理，同时通过LUT调整提升饱和度但抑制过度艳俗倾向，最终呈现既有数码锐化精度又不失人文温度的画面风格。此形象可联想为《黑天鹅》女主角妮娜·瓦尔多夫式的蜕变前夜状态——尚未完全卸去青涩外壳，却已蓄势待发迎接命运舞台中心灯光洗礼。"], "inputs": [{"shape": 7, "name": "anything", "link": 125, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": true}, "id": 55, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "or