t": 80, "Node name for S&R": "TextEncodeQwenImageEditPlus", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"mode": 0, "outputs": [{"name": "seed", "links": [512], "label": "随机种子", "type": "INT", "localized_name": "seed"}], "size": [291.8540344238281, 109.20256805419922], "pos": [-1456.5416259765625, -258.426513671875], "widgets_values": [520472588681563, "fixed", null], "inputs": [{"widget": {"name": "seed"}, "name": "seed", "type": "INT", "localized_name": "seed"}], "flags": {"pinned": true}, "id": 291, "type": "easy seed", "properties": {"cnr_id": "comfyui-easy-use", "ver": "1.3.6", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "easy seed"}, "order": 6}, {"outputs": [], "color": "#223", "widgets_values": ["哼哼AI 您的AI朋友\n\n## [点击链接加入群聊【哼哼AI 您的AI朋友（交流）】](https://qm.qq.com/q/e0RIM20r96)\n\n出图尺寸：1024或者1280（按照短边进行缩放）\n\nlora模型选择：通过ctrl+B来开关 优先顺序为上中下  模型会有微小的变化\n\nlora权重:0.8-1.2\n\n模特图要求：人物腰部左右  不带头部或者是头部顶画面上方 尺寸最好在9:16左右  \n                     \n            模特最好是根据服装图的结构来生成衣服穿着  \n                    \n            模特图最好是室外  室内会导致服装过亮\n\n服装图要求：人台模特图 半身  全身无效\n\n图像要求：模特图和人台图 正 侧 背 最好是对应位置 效果会好一点  \n\n换装提示词：光影融合自然 这句可以不带\n\n总结：\n           由于数据集的限制 所有对生成效果有所影响   \n\n           个别会出现皮肤假的现象\n\n           个别衣服会出现白边的问题\n\n           有些衣服会自动加上内衣和内裤 \n\n           对换装衣服有一定要求\n\n           数据有限不能全部适配\n\n\n\n数据集由小伙伴提供 如果有小伙伴需要可以联系我 共创更好模型  感谢小伙伴的提供  本模型经过小伙伴的同意后 模型全部开源 \n"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#335", "size": [608.3648071289062, 561.8887329101562], "pos": [-3971.033203125, -491.27264404296875], "id": 587, "properties": {"widget_ue_connectable": {}}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.43.18", "VHS_