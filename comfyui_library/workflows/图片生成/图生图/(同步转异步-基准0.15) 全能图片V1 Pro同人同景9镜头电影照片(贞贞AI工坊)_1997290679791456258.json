9\\u4f53\\uff09\\u3002\\n\\n\\n\\n**\\u7b2c\\u4e8c\\u884c\\uff08\\u6838\\u5fc3\\u8986\\u76d6\\uff09\\uff1a**\\n\\n4. **\\u4e2d\\u666f\\uff08MS\\uff09\\uff1a** \\u4ece\\u8170\\u90e8\\u4ee5\\u4e0a\\u62cd\\u6444\\uff08\\u9488\\u5bf9\\u4eba\\u7269\\uff09\\u6216\\u4ece\\u7269\\u4f53\\u7684\\u4e2d\\u5fc3\\u90e8\\u5206\\u62cd\\u6444\\u3002\\n\\n5. **\\u4e2d\\u8fd1\\u666f\\uff08MCU\\uff09\\uff1a** \\u4ece\\u80f8\\u90e8\\u4ee5\\u4e0a\\u62cd\\u6444\\u3002\\u805a\\u7126\\u4e3b\\u8981\\u4e3b\\u4f53\\u3002\\n\\n6. **\\u8fd1\\u666f\\uff08CU\\uff09\\uff1a** \\u7d27\\u51d1\\u5730\\u62cd\\u6444\\u9762\\u90e8\\u6216\\u7269\\u4f53\\u7684\\u201c\\u6b63\\u9762\\u201d\\u3002\\n\\n\\n\\n**\\u7b2c\\u4e09\\u884c\\uff08\\u7ec6\\u8282\\u4e0e\\u89d2\\u5ea6\\uff09\\uff1a**\\n\\n7. **\\u7279\\u8fd1\\u666f\\uff08ECU\\uff09\\uff1a** \\u8fd1\\u8ddd\\u79bb\\u62cd\\u6444\\u67d0\\u4e2a\\u5173\\u952e\\u90e8\\u4f4d\\uff08\\u5982\\u773c\\u775b\\u3001\\u624b\\u90e8\\u3001\\u6807\\u5fd7\\u3001\\u7eb9\\u7406\\uff09\\u7684\\u7ec6\\u8282\\u3002\\n\\n8. **\\u4f4e\\u89d2\\u5ea6\\u955c\\u5934\\uff08Worm's Eye\\uff09\\uff1a** \\u4ece\\u5730\\u9762\\u4ef0\\u62cd\\u4e3b\\u4f53\\uff08\\u8425\\u9020\\u5a01\\u4e25\\u6216\\u82f1\\u96c4\\u611f\\uff09\\u3002\\n\\n9. **\\u9ad8\\u89d2\\u5ea6\\u955c\\u5934\\uff08Bird's Eye\\uff09\\uff1a** \\u4ece\\u4e0a\\u65b9\\u4fef\\u62cd\\u4e3b\\u4f53\\u3002\\n\\n\\n\\n\\u786e\\u4fdd\\u4e25\\u683c\\u7684\\u4e00\\u81f4\\u6027\\uff1a\\u6240\\u67099\\u4e2a\\u753b\\u9762\\u4e2d\\u7684\\u4eba\\u7269/\\u7269\\u4f53\\u3001\\u670d\\u88c5\\u548c\\u5149\\u7ebf\\u90fd\\u4fdd\\u6301\\u4e00\\u81f4\\u3002\\u666f\\u6df1\\u5e94\\u771f\\u5b9e\\u5730\\u53d8\\u5316\\uff08\\u8fd1\\u666f\\u65f6\\u51fa\\u73b0\\u865a\\u5316\\u6548\\u679c\\uff09\\u3002\\n\\n\\n\\n**\\u8981\\u6c42\\uff1a**\\n\\n\\u751f\\u6210\\u4e00\\u4e2a\\u4e13\\u4e1a\\u76843x3\\u7535\\u5f71\\u5f0f\\u6545\\u4e8b\\u677f\\u7f51\\u683c\\uff0c\\u5305\\u542b9\\u4e2a\\u753b\\u9762\\u3002\\n\\n\\u8be5\\u7f51\\u683c\\u4ee5\\u591a\\u79cd\\u7126\\u8ddd\\u5168\\u9762\\u5c55\\u793a\\u8f93\\u5165\\u56fe\\u50cf\\u4e2d\\u7684\\u4e3b\\u4f53/\\u573a\\u666f\\u3002\\n\\n- **\\u9876\\u90e8\\u884c\\uff1a** \\u5bbd\\u5e7f\\u7684\\u73af\\u5883\\u955c\\u5934\\u3001\\u5168\\u666f\\u30013/4\\u89c6\\u89d2\\u3002\\n\\n- **\\u4e2d\\u95f4\\u884c\\uff1a** \\u4ece\\u8170\\u90e8\\u4ee5\\u4e0a\\u62cd\\u6444\\u3001\\u4ece\\u80f8\\u90e8\\u4ee5\\u4e0a\\u62cd\\u6444\\u3001\\u9762\\u90e8/\\u6b63\\u9762\\u7279\\u5199\\u3002\\n\\n- **\\u5e95\\u90e8\\u884c\\uff1a** \\u7279\\u5199\\u7ec6\\u8282\\u3001\\u4f4e\\u89d2\\u5ea6\\u955c\\u5934\\u3001\\u9ad8\\u89d2\\u5ea6\\u955c\\u5934\\u3002\\n\\n\\u6240\\u6709\\u753b\\u9762\\u90fd\\u5177\\u6709\\u903c\\u771f\\u7684\\u7eb9\\u7406\\u3001\\u4e00\\u81f4\\u7684\\u7535\\u5f71\\u8272\\u5f69\\u8c03\\u8272\\uff0c\\u5e76\\u4e14\\u6839\\u636e\\u5206\\u6790\\u51fa\\u7684\\u4e3b\\u4f53\\u6216\\u7269\\u4f53\\u7684\\u6570\\u91cf\\u8fdb\\u884c\\u6b63\\u786e\\u7684\\u6784\\u56fe\\u3002\", \"aspect_ratio\": \"16:9\", \"image_size\": \"4K\", \"seed\": 1080059769, \"images_count\": 1, \"image_url\": \"https://webstatic.aiproxy.vip/output/20251206/9208/00973b80-4fd4-48a8-b3be-37d301422316.jpg\", \"all_urls\": [\"https://webstatic.aiproxy.vip/output/20251206/9208/00973b80-4fd4-48a8-b3be-37d301422316.jpg\"]}"], "inputs": [{"shape": 7, "name": "anything", "link": 304, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 195, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 11}, {"mode": 0, "outputs": [], "size": [1239.913818359375, 1368.9371337890625], "pos": [1434.0443115234375, 194.26419067382812], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 297, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 114, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.65", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["API注册：https://ai.t8star.cn/register?aff=dP7j\n目前0.2积分一个图,暂时1K,2K,4K价格一样"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [284.60247802734375, 117.55081939697266], "pos": [-967.0240478515625, 545.43505859375], "id": 109, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"mode": 0, "outputs": [{"name": "prompt", "links": [301], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [860.3366088867188, 273.0297546386719], "pos": [-1101.43896484375, 190.47280883789062], "widgets_values": ["<指令>\n\n分析输入图像的整个构图。识别出所有出现的主体（无论是单个人、一群人/一对人、一辆车还是某个特定的物体）以及它们之间的空间关系和互动方式。\n\n生成一个连贯的3x3网格“电影式联系图”，其中包含9个在同一场景中的不同主体镜头。\n\n你需要根据内容调整标准的电影镜头类型（例如，如果是一个人群，则将整个群体都拍进画面；如果是某个物体，则将整个物体完整地拍入画面）：\n\n\n\n**第一行（建立背景）：**\n\n1. **极远景（ELS）：** 在广阔的背景中，主体显得很小。\n\n2. **远景（LS）：** 从上到下（从头部到脚部/从轮子到车顶）完整展示主体或群体。\n\n3. **中远景（American/3-4）：** 从膝盖以上拍摄（针对人物）或从3/4的角度拍摄（针对物体）。\n\n\n\n**第二行（核心覆盖）：**\n\n4. **中景（MS）：** 从腰部以上拍摄（针对人物）或从物体的中心部分拍摄。\n\n5. **中近景（MCU）：** 从胸部以上拍摄。聚焦主要主体。\n\n6. **近景（CU）：** 紧凑地拍摄面部或物体的“正面”。\n\n\n\n**第三行（细节与角度）：**\n\n7. **特近景（ECU）：** 近距离拍摄某个关键部位（如眼睛、手部、标志、纹理）的细节。\n\n8. **低角度镜头（Worm's Eye）：** 从地面仰拍主体（营造威严或英雄感）。\n\n9. **高角度镜头（Bird's Eye）：** 从上方俯拍主体。\n\n\n\n确保严格的一致性：所有9个画面中的人物/物体、服装和光线都保持一致。景深应真实地变化（近景时出现虚化效果）。\n\n\n\n**要求：**\n\n生成一个专业的3x3电影式故事板网格，包含9个画面。\n\n该网格以多种焦距全面展示输入图像中的主体/场景。\n\n- **顶部行：** 宽广的环境镜头、全景、3/4视角。\n\n- **中间行：** 从腰部以上拍摄、从胸部以上拍摄、面部/正面特写。\n\n- **底部行：** 特写细节、低角度镜头、高角度镜头。\n\n所有画面都具有逼真的纹理、一致的电影色彩调色，并且根据分析出的主体或物体的数量进行正确的构图。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 112, "typ