.safetensors、AlekPet Custom Nodes、ComfyUI-KJNodes、Comfyroll、ComfyUI Essentials。RH 在线版本已配齐。\n\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "使用方式", "mode": 0, "bgcolor": "#653", "size": [731.2991333007812, 405.341552734375], "pos": [-3479.732421875, -39.117835998535156], "id": 35, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 0}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [36], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [350, 180], "pos": [4172.45166015625, 15.61825942993164], "widgets_values": [2], "inputs": [{"shape": 7, "name": "image1", "link": 31, "label": "图像1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 32, "label": "图像2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 33, "label": "图像3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "link": 34, "label": "图像4", "type": "IMAGE", "localized_name": "image4"}, {"widget": {"name": "Input"}, "name": "Input", "label": "Input", "type": "INT", "localized_name": "输入"}], "flags": {}, "id": 19, "type": "CR Image Input Switch (4 way)", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Image Input Switch (4 way)"}, "order": 35}, {"mode": 0, "outputs": [{"name": "width", "links": [16, 18, 20], "label": "宽度", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [17, 19, 21], "label": "高度", "type": "INT", "localized_name": "height"}, {"name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "size": [260, 124.00001525878906], "pos": [3091.170166015625, 224.67320251464844], "widgets_values": ["width: 1080, height: 1686\n batch size: 1862b2dfc67b8a5bc6cb2f32db91d130b