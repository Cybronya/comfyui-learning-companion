_2.5_vl_7b_fp8_scaled.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 2, "type": "CLIPLoader", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"directory_invalid": true, "name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors"}], "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPLoader", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 3}, {"outputs": [{"name": "text", "links": [39], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#1d7db9", "widgets_values": ["一位胸部丰满，穿着单肩红色长摆群礼服、脚穿红色高鞋的中国女人，在纯红绸缎飘逸背景下摆姿。\n她长发卷曲垂落，唇色鲜红，眼神自信而略带魅惑地凝视斜上方；\n左手轻抚胸前褶皱处，右手叉腰，右腿优雅抬起，裙摆随风扬起形成动态弧线。\n整幅画面以浓烈赤红为主色调，从地面到天花板皆被流动丝绸覆盖，背景上部融入巨大的横排金色毛笔书法“新年快乐”字样，两边悬挂高低错落的红灯笼，飘落金色纸屑。整体呈现热闹生动的春节氛围，温馨喜庆。\n\n\n构图为全身人像特写，采用略微仰拍角度增强气场压迫力，模特居画中央偏左但姿态自然倾斜打破中心轴对称。\n视觉焦点通过面部表情、手部动作及腿部线条层层递进——由头部至躯干再到脚踝高跟，引导视线沿身体曲线向下延伸，并借裙摆飞扬之势制造动感留白空间。\n光线来自前方柔光箱+侧后方补光组合，勾勒轮廓同时保留皮肤细腻质感；阴影柔和过渡，无硬边切割，使立体度不显突兀却具雕塑般肌理。\n\n整体氛围兼具古典油画沉郁厚重与现代时尚摄影张扬奔放之韵，仿佛舞台剧幕布掀开瞬间定格的人物肖像，充满权力象征与情感爆发前奏的静谧躁动。\n色彩饱和度极高，近乎霓虹灯管式荧光红浸透每一寸空气，强化情绪浓度与仪式感。\n材质表现真实考究：丝绒触感隐约可见于腰部束结部分，拖尾纱质半透明层叠间折射微弱光泽，足尖细绳缠绕金属扣件反射冷调反光点，为炽热基调注入一丝冷静克制。\n\n此场景可想象设定于“皇家舞会”、“宫廷秘宴”或“未来主义剧场”，无需道具仅靠服饰肢体语言即完成叙事闭环。\n适合用于高端品牌广告大片、杂志封面故事、影视概念海报乃至数字艺术装置展陈。\n强调“极简主义中的极致繁复”美学风格——单一主色下多重层次纹理叠加，既统一又冲突，成就令人屏息的视觉奇观。\n"], 