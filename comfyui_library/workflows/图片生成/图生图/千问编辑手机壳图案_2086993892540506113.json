饰有小花图案；背景是飘雪的冬日场景，天空灰蒙，雪花纷飞，地面覆盖白雪，营造出冬日的清冷氛围，整体风格温馨且充满对冬天的美好期许。旁边站着图中的女人，女人微笑着，人物靠近标牌右侧，人物和标牌占画面比例一致，指着旁边的标牌，人物和标牌在画面中间，全景，超清32k写真超高清画面感，色彩亮丽\n\n新年海报，真实摄影，顶部写着：“2026 ”，加粗字字体，小字“顺风顺水顺财神”，字体手写，创意有艺术感。五官端正漂亮，国泰民安脸，高马尾辫，正面特写，恬静幸福感，穿红色毛衣，红色围巾，双手祈祷状态，极简主义，模糊，与背景融合互动，高级质感红色背景，红色喜庆新年氛围，特写，描绘清晰细致，高美感，极简主义，留白，意境，高级，杰作，极简"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [527.133544921875, 460.7431335449219], "pos": [189.66871643066406, 2639.5283203125], "id": 43, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"outputs": [], "color": "#432", "widgets_values": ["换为线稿，只有线稿轮廓，没有皱纹\n二次元\n吉卜力\nQ版\n水彩插画"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [452.2029113769531, 232.8265838623047], "pos": [379.6588134765625, 3925.86181640625], "id": 42, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"outputs": [{"name": "IMAGE", "links": [13], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#332922", "widgets_values": ["dd4e4c19c9b825314d4d93c1e2e0484437cb2cecce3ee9999ae5e1036c349d85.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#593930", "size": [556.3959350585938, 751.85791015625], "pos": [-441.83758544921875, 2230.193603515625], "id": 17, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"image": true, "upload": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoadImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 4}, {"outputs": [{"name": "STRING", "links": [28], "label": "字符串", "ty