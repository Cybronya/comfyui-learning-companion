at:\n不要有多余的解释，请直接输出最终结果。\n\n---\n[等待用户上传图片]", 0.6, 608384608, "randomize"], "inputs": [{"shape": 7, "name": "image1", "link": 96, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 97, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 98, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "link": 99, "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_LLMAPI_Pro_Node", "mode": 0, "bgcolor": "#000", "size": [438.3553161621094, 962.2388305664062], "pos": [-259.0284423828125, 477.9951477050781], "id": 85, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_Pro_Node"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["的英文提示词（Prompt），不需要任何解释，也不要输出中间步骤。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [360.48626708984375, 88], "pos": [-215.1605987548828, 1509.8856201171875], "id": 88, "properties": {}, "order": 3}, {"outputs": [{"name": "IMAGE", "links": [97, 100], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#222", "shape": 1, "widgets_values": ["example.png", "imag