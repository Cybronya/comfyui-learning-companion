d_name": "STRING"}], "color": "#527e99", "widgets_values": ["使用<Picture 1>作为唯一人物的身份与服装参考，使用<Picture 2>作为场景参考。约10秒、16:9、写实电影质感的连续镜头。傍晚细雨，一位约28岁的成年女性穿米色风衣、灰蓝色针织上衣与深灰长裤，站在图书馆门口的雨棚下。镜头从腰部以上的中景缓慢推进到胸部以上的近景，人物先安静看向雨幕，再轻轻转头望向镜头旁的同伴，露出自然温暖的微笑。第3至7秒，她用自然清晰的普通话温柔地说一次：“雨快停了，我们一起回家吧。”其余时间保持安静的呼吸和细微动作。只有这一位人物入镜；同伴不入镜也不发声。保留人物身份、发型与服装，背景保持温暖玻璃门光线与冷色雨夜反光，动作和口型自然连贯。声音由模型生成：一位成年女性的自然说话声、轻柔雨声和微弱城市环境声；无旁白、无背景音乐、无第二说话人。画面无字幕、无水印、无片头片尾、无快速剪切。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "剧情与声音 / 中文对白·雨夜示例", "mode": 0, "bgcolor": "#27313b", "size": [660, 530], "pos": [835, 90], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 5}, {"outputs": [{"name": "IMAGE", "links": [282], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "links": [], "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#4b837c", "widgets_values": ["7b97bc5307c9824e89709b28978654da924393e983b308a9cdb5acda1355e957.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "title": "场景参考 / 图2·默认启用", "mode": 0, "bgcolor": "#27313b", "size": [660, 470], "pos": [35, 635], "id": 139, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 6}, {"outputs": [{"name": "CLIP", "links": [316], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#887096", "widgets_values": ["qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "minimax", "default"], "inputs": [{"widget": {"n