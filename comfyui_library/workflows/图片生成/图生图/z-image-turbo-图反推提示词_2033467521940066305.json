LEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "AILab_QwenVL", "mode": 0, "bgcolor": "#374539", "size": [400, 300], "pos": [-143.61776733398438, -154.5113525390625], "id": 9, "properties": {"cnr_id": "comfyui-qwenvl", "ver": "2.0.0", "widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 5}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [6, 15], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [282.798828125, 314], "pos": [-514.0365600585938, -74.85586547851562], "widgets_values": ["c87890552360d6ea36410d871155eec63c1175976738898b7950502559264e22.jpeg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 10, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.9.2", "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"outputs": [], "color": "#432", "widgets_values": ["Qwen3-VL-4B-Instruct 与 QwenVL 插件 详细介绍\n\n以下分别对 Qwen3-VL-4B-Instruct 模型与 QwenVL 插件进行介绍，均包含一句话核心总结、下载地址说明及具体用法，贴合 z-image-turbo 反推提示词工作流的实际使用场景，便于快速上手。\n\n一、Qwen3-VL-4B-Instruct（多模态核心模型）\n\n1. 一句话介绍\n\nQwen3-VL-4B-Instruct 是阿里通义千问团队开源的4B参数多模态模型，经指令微调优化，具备强大的图像理解与文本生成能力，可精准解析图像特征并转化为结构化文本提示词，显存占用可控、适配消费级显卡，是 z-image-turbo 反推提示词工作流的核心能力载体，性能可媲美更高参数量的旧版模型。\n\n2. 下载地址介绍\n\n模型官方托管于 Hugging Face 仓库，可直接下载全部模型文件，也可通过插件自动获取，具体地址及说明如下：\n\n- 官方下载地址：[https://huggingface.co/qwen/qwen3-vl-4b-instruct](https://huggingface.co/qwen/qwen3-vl-4b-instruct)，进入页面后，下载全部模型相关文件（含权重文件、配置文件等），无需额外转换格式。\n\n- 补充说明：模型支持 BF16、FP8 等多种量化版本，可根据自身显卡显存情况选择，下载后需放置到指定目录（后续用法中说明），确保插件能正常识别加载，也可通过 ModelScope 工具命令行下载（如：modelscope download –model Qwen/Qwen3-4B –local_dir 自定义路径）。\n\n3. 用法介绍（结合 z-image-turbo 工作流）\n\n该模型需配合 QwenVL 插件使用，核心用于 z-image-turbo 反推提示词工作流，具体步骤如下：\n\n- 第一步：部署模型，将下载好的全部模型文件，放置到 ComfyUI 安装目录下的 `text_encoders` 文件夹（路径参考：ComfyUI/models/text_encoders/），确保文件名与下载时一致，避免加载失败。\n\n- 第二步：打开 ComfyUI 并加载 z-image-turbo 反推提示词工作流，模型会被 QwenVL 插件自动识别，无需手动配置模型路径。\n\n- 第三步：在工作流中，通过 LoadImage 节点上传参考图像，图像会传入调用该模型的节点（如 AILab_QwenVL），模型会根据预设指令（如“详细描述图像特征”），自动解析图像的主体、细节、风格、光影等信息，生成贴合的文本提示词。\n\n- 第四步：模型生成的提示词会自动传入 CLIPTextEncode 节点，转化为模型可理解的特征向量，为后续 UNET 模型扩散生成图像提供文本引导，完成“图像→提示词”的反推全过程。\n\n二、QwenVL 插件（ComfyUI 适配插件）\n\n1. 一句话介绍\n\nQwenVL 插件（常用名称：ComfyUI-QwenVL）是专门为 ComfyUI 开发的第三方节点插件，核心作用是桥接 Qwen3-VL-4B-Instruct 等 Qwen 系列多模态模型与 ComfyUI 工作流，提供可视化操作节点，无需编写代码，即可便捷调用模型的图像理解与提示词生成能力，支持多种量化模式，适配不同硬件环境。\n\n2. 下载地址介绍\n\n插件为开源免费工具，主要通过 ComfyUI 插件管理器下载，也可手动克隆代码安装，具体方式如下：\n\n- 方式一（推荐，新手友好）：打开 ComfyUI，进入插件管理器（ComfyUI Manager），搜索“QwenVL”，找到对应插件后点击安装，安装完成后重启 ComfyUI 即可生效，无需手动配置依赖。\n\n- 方式二（手动安装）：QwenVL节点**并非由ComfyUI-GGUF提供**（ComfyUI-GGUF核心用于GGUF格式模型加载，不包含QwenVL相关节点），正确手动安装方式是克隆专门的QwenVL插件仓库，地址：[https://github.com/AI-Creative/ComfyUI-QwenVL](https://github.com/AI-Creative/ComfyUI-QwenVL)，将克隆后的文件夹放入ComfyUI安装目录下的 `custom_nodes` 文件夹，重启ComfyUI即可加载QwenVL节点。\n\n3. 用法介绍（结合 z-image-turbo 工作流）\n\n插件安装完成后，全程通过 ComfyUI 可视化节点操作，无需代码，具体用法的核心步骤如下：\n\n- 第一步：重启 ComfyUI 后，在节点列表中搜索“QwenVL”，可找到对应的可视化节点（标准节点适合新手，高级节点可细调参数），将其添加到 z-image-turbo 工作流中。\n\n- 第二步：连接节点，将 LoadImage 节点（上传参考图）的输出端连接到 QwenVL 节点的输入端，再将 QwenVL 节点的输出端（提示词输出）连接到 CLIPTextEncode 节点的输入端，完成链路搭建。\n\n- 第三步：配置节点参数，双击 QwenVL 节点，选择已部署的 Qwen3-VL-4B-Instruct 模型，可根据需求调整量化模式（4-bit、8-bit 等）、输出提示词长度（max_tokens）等参数，新手默认参数即可满足需求。\n\n- 第四步：运行工作流，QwenVL 插件会调用 Qwen3-VL-4B-Instruct 模型解析参考图像，自动生成提示词并传入后续节点，最终配合 z-image-turbo 工作流完成图像生成，全程可视化操作，无需额外调试。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "工作流说明", "mode": 0, "bgcolor": "#653", "size": [640.4022216796875, 1198.6845703125], "pos": [-1342.334716796875, -466.2515563964844], "id": 15, "properties": {"widget_ue_connectable": {}}, "order": 4}], "extra": {"VHS_KeepIntermediate":