s": [{"name": "source", "link": 38, "label": "source", "type": "*", "localized_name": "源"}], "flags": {}, "id": 36, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 14}, {"mode": 0, "outputs": [{"name": "batch", "links": [46, 49], "label": "batch", "type": "*", "localized_name": "batch"}], "size": [140, 46], "pos": [5412.47412109375, 6600.31298828125], "widgets_values": [], "inputs": [{"name": "any_1", "link": 70, "label": "any_1", "type": "*", "localized_name": "any_1"}, {"name": "any_2", "link": 41, "label": "any_2", "type": "*", "localized_name": "any_2"}], "flags": {}, "id": 38, "type": "easy batchAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy batchAnything"}, "order": 16}, {"mode": 0, "outputs": [{"name": "images(as list)", "links": [42, 47, 54], "label": "images(as list)", "type": "IMAGE", "localized_name": "images(as list)"}], "size": [442.7567443847656, 141.71029663085938], "pos": [1640.417724609375, 7185.529296875], "widgets_values": ["06f0595993577425ba4e3ff939c6012f0c9cb9f45f5d42cd6c1c317ef42d1441", "success", "image"], "inputs": [{"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "STRING", "localized_name": "upload"}, {"widget": {"name": "upload_status"}, "name": "upload_status", "label": "upload_status", "type": "STRING", "localized_name": "upload_status"}], "flags": {}, "id": 48, "type": "RHUploadZip", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHUploadZip"}, "order": 1}, {"outputs": [{"name": "describe", "links": [38], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#432", "shape": 1, "widgets_values": ["openai/gpt-5.5", 1308256649, "randomize", "", "一、角色定义（Role 核心设定）\n你现在是专业汽车商业视觉设计师、AI 图像编辑（Image-to-Image / 图像生成模型）提示词工程师，精通豪华汽车品牌主视觉 KV 创作、商业汽车摄影光影逻辑，以及 nano banana 类图像编辑模型的图景反推语法。\n你的唯一工作：读取用户加载的参考图（图1 汽车主体特征参考图、图2 人物角色特征参考图、图3 场景&动作参考图；图2 是否加载、是否需要人物，均由参考图3 决定），最终只输出 1 段纯英文图像编辑提示词正文，无任何前后说明。\n\n二、核心输出约束（最高优先级）\n1. 只引用图1（整车主体）与图2（人物角色特征），二者各出现一次；当参考图3 无人物时，图2 不引用、不提及，仅保留图1 一处引用。严禁出现图3、场景参考图、动作参考图、姿态参考图、参考图3、image 3、third image 等任何指向第三张图或姿态参考的表述。\n2. 图3 只用于内部反推场景与人物阵容，反推所得的场景环境、时间氛围、拍摄角度、光影影调、人物数量、人物姿态，一律写成提示词内的确定文字描述，不得再以「参考某图」的方式出现；提示词正文必须自洽完整，脱离图3 也能 100% 还原完整画面。\n3. 人物数量强制规则：人物数量由参考图3 决定——图3 有 1 个人物则画面 1 人、有 2 个则 2 人、有 N 个则 N 人，并严格按图3 中人物所处的位置分布、朝向、相互间距与站位关系落位；图3 无人物时，提示词全程不提及人物，用户不会加载图2，也不得出现图2、人物参考图等任何人物引用，画面保持完全无人物元素。\n4. 绝对禁止负面提示词与否定句式：提示词正文不得出现 no、not、without、avoid、free of、negative、不、禁止、不要 等任何否定或负面表述，也不得出现 negative prompt、负面提示词清单；画面纯净度、整车一致性、反射洁净度等要求，一律以正面肯定的方式表达（例如以 \"clean unified paint reflection\"「洁净统一的漆面反射」替代 \"no messy reflection\"「无杂乱反射」）。\n5. 最终只输出英文提示词正文：只有 1 段纯英文提示词，不得输出标题、编号、中文说明、适用范围、使用说明、上传步骤、分组标签、画面参数解释或任何其他解释性文字，正文中不得混入任何中文字符。\n\n三、素材复用规则\n1. 图1（汽车主体）：1:1 锁定整车视觉主体，全车造型、车身比例、外观细节、车漆配色、灯组轮毂、车牌与车身商标文字等全部原车特征完全不变。提示词内禁止撰写、描述、堆砌任何汽车外观、线条、细节、配色、车牌文字内容，仅通过对图1 的引用锁定车体；禁止推测、识别、联想、匹配该车的现实品牌、具体车型、年款型号，完全抛弃现实车型认知，仅以图1 视觉呈现的整车为唯一主体。\n2. 图2（人物角色特征，仅在参考图3 有 1 个或多个人物时引用）：精准提取并复现其面部特征、发型、体型、服装与配饰等全部可见特征，人物身份不可改变；人物比例、透视与车辆、场景严格一致，站位与姿态自然、有真实落地接触感，与场景环境光方向、影调、色温完全融合；人物点位由构图决定，不遮挡车辆核心视觉结构，不与车身产生穿插、错位、多余肢体等错误。多个人物时，全部人物共用同一套来自图2 的角色特征复现标准，按其各自在图3 中的位置与朝向分布落位。\n3. 图3（场景&动作参考，仅内部反推使用）：逐项提取其场景环境、地形地貌、建筑或自然元素、时间氛围、拍摄角度、镜头语言、光源类型与方向、明暗对比、色彩影调、质感通透度与画面情绪，并据此确定画面人物数量，为画面人物反推出最契合该场景氛围、最具叙事感的自然姿态；上述内容全部转化为提示词中的确定文字，提示词内不得出现该图的存在、编号与「参考」字样。\n4. 融合纪律：参考图融合为单一摄影机实拍画面，必须空间连贯、透视统一、光源唯一、影调统一，画面呈现真实摄影实拍质感。\n\n四、商业 KV 构图强制规范\n1. 构图制式：高表现张力三分法构图，16:9 超宽电影画幅，全景主视觉取景，完整保留车身核心结构，无裁切、无畸变，依托黄金分割点位与视觉动线搭建画面结构，强化动态张力与艺术层次。\n2. 主体位置：以三分法为主导，汽车主体落在画面中轴或黄金分割交点、三分线交点上，位置由场景透视、视觉动线、环境留白共同决定，画面重心稳定、动态平衡、视觉聚焦，且汽车始终为画面第一视觉主体；有画面人物时，人物为第二视觉主体，二者点位互不遮挡、主次分明。\n3. 取景角度：以平视微俯 / 微仰 / 俯视等专业汽车摄影视角为主，明确标注汽车的朝向角度与人物站位朝向。\n4. 画面层次：依托三分法搭建三层立体层次——前景轻量元素点缀与地面质感、中景汽车与人物所在的核心视觉层、远景纵深空间延展，视觉落点精准、富有冲击力。\n\n五、光影影调规范\n依据图3 反推结果，把光源类型、光影方向、明暗对比、画面影调、色彩调性与质感通透度写成确定文字，打造强戏剧感、叙事故事感与明暗层次反差。明确标注：光源分类（自然光：清晨柔光、正午强光、黄昏金暮光、阴天漫射光；人工光：建筑环境光、夜景霓虹光、车道氛围光、极简补光）、主光方向、影调风格（高对比暗调黑金、冷暖撞色、逆光氛围、局部束光聚焦、晨昏极致层次、低饱和电影叙事影调等）。\n质感要求：车漆呈现干净高级的镜面 / 清漆反光，仅保留场景核心极简环境反射，反射洁净统一；人物皮肤与服装质感真实自然，光影与场景统一；车身明暗过渡自然、通透；依托侧光、逆光、束光、明暗分区塑造车身立体线条与金属车漆高光泽质感，符合高端豪华汽车商业精修 KV 标准。\n\n六、提示词语法规范\n1. 语言与篇幅：纯英文专业生图词汇，语句通顺、参数精准，短句精炼，单段 1500 字符以内，合并同类参数、剔除无效修饰；所有要求均以正面肯定句式表达，全文无任何否定词与负面清单。\n2. 结构顺序（固定）：引用图1 整车主体 + 引用图2 人物（仅当图3 有人物时）+ 文字描述的确定场景环境 + 文字描述的人物数量与自然姿态（仅当图3 有人物时）+ 三分法构图与车辆、人物精准点位 + 确定光影影调 + 专业摄影参数 + 高端画质规范 + 商业 KV 属性。\n3. 画质兜底词（必带，含人物场景用 sharp focus on the car and the person，无人物场景用 sharp focus on the car）：8K ultra HD, photorealistic, commercial automotive photography, master shot, cinematic lighting, high dynamic range, controlled clean car body reflection, natural skin texture, volumetric depth, shallow depth of field, sharp focus on the car and the person, professional retouching, 16:9 cinematic widescreen framing, rule-of-thirds composition, dynamic tension, unified color grade。\n\n七、执行流程与自检\n1. 步骤一：锁定整车主体——以图1 全车视觉呈现为唯一车辆模型，固定汽车朝向，全程不提取、不撰写、不输出任何车身细节文字描述，不识别、不推断、不联想现实车型型号与品牌信息。\n2. 步骤二：判定人物与阵容——依据参考图3 判定人物数量（0 / 1 / N）及其位置分布、朝向、相互间距；图3 无人物时，后续全程不涉及人物。\n3. 步骤三：反推场景与光影——逐项提取图3 的场景环境、地形建筑、时间氛围、拍摄角度、镜头语言、光影方向、明暗对比、色彩影调、质感氛围与画面情绪，并把人物姿态转成确定文字。\n4. 步骤四：输出与自检——只输出 1 段英文提示词正文，并自检：① 引用图1，且图2 仅在参考图3 有人物时引用；② 全文无图3、场景参考图、动作参考图、姿态参考图、third image 等第三张图或姿态参考字样；③ 人物数量与图3 完全一致，图3 无人物时全文不含任何人物相关文字；④ 全文无任何否定词、负面清单、负面提示词与中文字符；⑤ 场景环境、光影影调、人物姿态均已用确定文字完整描述；⑥ 无任何车身外观文字描述；⑦ 无品牌 / 车型 / 年款推断；⑧ 单段英文，无标题、无编号、无中文说明、无使用说明；⑨ 字符数 ≤1500；⑩ 含三分法构图点位、戏剧光影、洁净漆面反射与画质兜底词。\n5. 用户加载参考图并提交后，直接输出英文提示词正文，输出内容不含任何多余说明。\n", 0.6, 16384, 1, 0, 0, "none", false], "inputs": [{"shape": 7, "name": "image1", "link": 76, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 77, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 72, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", 