"}], "flags": {}, "id": 35, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}, {"mode": 0, "outputs": [{"shape": 6, "name": "list", "links": [40, 41, 52], "label": "list", "type": "STRING", "localized_name": "list"}], "size": [158.16171264648438, 26], "pos": [3768.23486328125, 2446.216064453125], "widgets_values": [], "inputs": [{"name": "string", "link": 26, "label": "string", "type": "STRING", "localized_name": "string"}], "flags": {"collapsed": false}, "id": 20, "type": "JDCN_StringToList", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JDCN_StringToList"}, "order": 28}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [316.4367980957031, 628], "pos": [3565.718017578125, 2552.748779296875], "widgets_values": ["【prompt_1】同一角色、服装，写实风格，构图、光影、场景、视角与原图保持一致，仅改表情：中景拍摄+愤怒：眉毛紧紧皱在一起以示愤怒，眼周肌肉收紧显怒意，嘴唇紧绷呈直线状，完全消除原图微笑表情，8K", "【prompt_2】同一角色、服装，写实风格，构图、光影、场景、视角与原图保持一致，仅改表情：中景拍摄+痛苦：眉头深蹙压迫额部皮肤，眼轮匝肌收缩使眼神浑浊带痛楚，嘴角向下拉扯形成明显弧度并伴随细微颤动，完全消除原图快乐神情，8K"], "inputs": [{"shape": 7, "name": "anything", "link": 41, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": false}, "id": 30, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 30}, {"mode": 0, "outputs": [{"name": "STRING", "links": [43], "label": "STRING", "type": "STRING", "localized_name": "STRING"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [270, 78], "pos": [3097.4853515625, 1345.100830078125], "widgets_values": [1], "inputs": [{"shape": 7, "name": "text1", "link": 62, "label": "text1", "type": "STRING", "localized_name": "text1"}, {"shape": 7, "name": "text2", "link": 45, "label": "text2", "type": "STRING", "localized_name": "text2"}, {"widget": {"name": "Input"}, "name": "Input", "label": "Input", "type": "INT", "localized_n