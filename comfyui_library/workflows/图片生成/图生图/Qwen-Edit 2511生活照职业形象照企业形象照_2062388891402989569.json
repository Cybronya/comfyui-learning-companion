: "7.5.1"}, "widget_ue_connectable": {"color_correction": true, "batch_size": true, "seed": true, "uniform_batch_size": true, "enable_debug": true, "latent_noise_scale": true, "prepend_frames": true, "offload_device": true, "temporal_overlap": true, "input_noise_scale": true, "resolution": true, "max_resolution": true}, "Node name for S&R": "SeedVR2VideoUpscaler", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 23}, {"outputs": [], "color": "#432", "widgets_values": ["注意：\n半身构图，服装提示词不得出现“鞋子”相关提示词。\n全身构图，服装提示词里一定要加上“鞋子”相关提示词。\n\n1.挺括白色衬衫、黑色修身西服套装，搭配深色条纹领带，服装贴合身形无褶皱，黑色皮鞋。\n\n2.正式白色衬衫、黑色西装套装，系上细条纹商务领带，黑色皮鞋。\n\n3.粉色女式西装套装，紫色女式蝴蝶结，白色高跟鞋。\n\n4.藏青色女士修身西装套装，内搭纯白色衬衫，领口系浅粉色蝴蝶结，西装肩部挺括，衬衫领口整齐。白色高跟鞋。\n\n5.浅紫色女士西装套装，内搭米白色缎面衬衫，领口点缀同色系小蝴蝶结，西装收腰设计凸显身形；服装无褶皱无污渍，白色高跟鞋。\n\n6.高品质白色衬衫、黑色商务西装，搭配质感条纹领带，衬衫领口整齐，西装肩部挺括。突出面部轮廓，肤色自然，画质高清，呈现专业干练的职业形象，保留人物自身气质。\n\n7.白色长袖衬衫，衬衫款式简洁，前襟有纽扣，黑色商务西裤，衣料平整无褶皱。\n\n8.白色衬衫，黑色西装，打着条纹领带，黑色西裤，黑色皮鞋。专业商务正装，简洁纯色浅灰色背景"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [445.3029479980469, 314.4283447265625], "pos": [306.4307556152344, 738.5458984375], "id": 56, "properties": {"widget_ue_connectable": {}}, "order": 12}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [175], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [520.419677734375, 745.9017333984375], "pos": [-45.70659255981445, -192.97756958007812], "widgets_values": ["None", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {"collapsed": false}, "id": 33, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.59", "ue_properties": {"widget_ue_connectable": {"image": true