CLIPLoader"}, "order": 3}, {"outputs": [{"name": "VAE", "links": [2929, 2930], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "color": "#233", "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {"collapsed": false}, "type": "VAELoader", "mode": 0, "bgcolor": "#355", "size": [270, 60], "pos": [-110, -7470], "id": 655, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader"}, "order": 4}, {"outputs": [{"shape": 6, "name": "text", "links": [2920], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#2a363b", "widgets_values": ["画面主体为一位身着华美红衣的女性，背对镜头，长发如瀑垂落，发间点缀精致红色花饰与银质发簪，衣袍以深红为主调，绣有细腻的黑金纹样，衣摆随风轻扬，质感柔顺而富有光泽。她立于一扇古典中式雕花木窗前，窗格呈几何镂空结构，线条流畅而庄重，透出淡雅的光线。背景是漫天飘落的红叶，枝干遒劲，叶片如火，营造出浓郁的秋日氛围，与人物衣饰形成视觉呼应。光线自右侧透入，柔和地勾勒出人物轮廓与衣褶，形成明暗对比，增添画面层次感。整体色调以红与黑为主，辅以木质的深棕与背景的浅灰，营造出古典、静谧又略带哀婉的意境。构图上，人物居中偏左，窗格与红叶构成对角线引导线，增强画面纵深感，镜头视角为中景平视，景深适度虚化背景，突出人物主体。光影柔和，丁达尔效应隐约可见，使画面更具梦幻质感。整体氛围静谧而富有诗意，充满东方古典美学韵味。"], "inputs": [{"name": "text", "link": 2934, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#3f5159", "size": [481.21270751953125, 167.58255004882812], "pos": [169.42410278320312, -7755.2333984375], "id": 528, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 9}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [2707], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [472.8868713378906, 52.87969970703125], "pos": [171.9297332763672, -754