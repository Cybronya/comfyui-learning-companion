om/cubiq/ComfyUI_InstantID\n\n本工作流推荐视频地址：https://www.bilibili.com/video/BV13W421A7sy/\n教程视频地址：（待录制..）\n\n\n作者：B站【Rick不想上班】"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [380, 660], "pos": [-1420, -370], "id": 166, "properties": {"text": ""}, "order": 11}], "extra": {"workspace_info": {"saveLock": false, "id": "o_nqhrYfh7eMeagTRhZdH"}, "ue_links": [{"controller": 145, "upstream": "11", "downstream_slot": 0, "downstream": 77, "upstream_slot": 0, "type": "INSTANTID"}, {"controller": 145, "upstream": "38", "downstream_slot": 1, "downstream": 77, "upstream_slot": 0, "type": "FACEANALYSIS"}, {"controller": 145, "upstream": "16", "downstream_slot": 2, "downstream": 77, "upstream_slot": 0, "type": "CONTROL_NET"}, {"controller": 145, "upstream": "11", "downstream_slot": 0, "downstream": 60, "upstream_slot": 0, "type": "INSTANTID"}, {"controller": 145, "upstream": "38", "downstream_slot": 1, "downstream": 60, "upstream_slot": 0, "type": "FACEANALYSIS"}, {"controller": 145, "upstream": "16", "downstream_slot": 2, "downstream": 60, "upstream_slot": 0, "type": "CONTROL_NET"}, {"controller": 146, "upstream": "4", "downstream_slot": 4, "downstream": 174, "upstream_slot": 2, "type": "VAE"}, {"controller": 146, "upstream": "4", "downstream_slot": 4, "downstream": 147, "upstream_slot": 2, "type": "VAE"}], "0246.VERSION": [0, 0, 4], "ds": {"offset": [3063.3565083536905, 2230.3222147361057], "scale": 0.1908439282676187}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "构图控制", "bounding": [1210, 610, 730, 470]}, {"color": "#444", "font_size": 60, "flags": {}, "id": 2, "title": "B站【Rick不想上班】", "bounding": [350, -700, 559, 84]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "高清修复区", "bounding": [1180, -400, 1132, 996]}, {"color": "#b58b2a", "font_size": 24, "flags": {}, "id": 4, "title": "预览区", "bounding": [326, -403, 833, 993]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title"