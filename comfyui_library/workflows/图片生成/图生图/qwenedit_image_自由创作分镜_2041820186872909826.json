ype": "STRING", "localized_name": "show_help"}], "color": "#332922", "widgets_values": ["宽屏16:9电影画幅，8K超高清，写实3D次世代渲染，PBR物理材质，好莱坞科幻动画电影质感，平视固定镜头，镜头高度与坐着的核心人物视线齐平\n画面绝对中心为核心男性人物图2，呈端正坐姿，面部大特写，仅头部、颈部与肩部入镜，是画面唯一清晰焦点\n人物面部完全正对镜头，视线向上看向画面斜上方，眉头紧锁，嘴唇微张，神情紧张错愕，呈现被强制控制的情绪状态\n核心人物身后左右两侧，各有一名站立的士兵如图3，身体微微前倾，戴黑色手套的手牢牢摁住核心人物的双肩，形成对称合围的压制姿态，仅下半张脸、肩部与上半身入镜，做浅景深虚化处理\n场景为未来科幻风封闭审讯室，冷灰色哑光金属墙面，顶部嵌入式冷白色柔光灯带，主光源从正前方均匀照亮核心人物面部，后方警员带自然柔和阴影，整体冷蓝色调，氛围冷峻压抑，无画面畸变，无噪点，细节拉满"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#593930", "size": [443.656005859375, 373.6087646484375], "pos": [-4099.9560546875, -1474.55810546875], "id": 45, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [142.376953125, 246], "pos": [-4784.4716796875, -1665.109130859375], "widgets_values": [], "inputs": [{"name": "images", "link": 34, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 39, "type": "PreviewImage", "properties": {"cnr_id": "comfy-core", "ver": "0.18.1", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 30}, {"outputs": [{"name": "VAE", "links": [18], "label": "VAE", "type": "VAE"}], "color": "#322", "widgets_values": ["vae"], "inputs": [], "flags": {"collapsed": true}, "type": "GetNode", "title": "Get_vae", "mode": 0, "bgcolor": "#533", "size": [210, 34], "pos": [-3465.95751953125, -1570.9111328125], "id": 6, "properties": {"ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "aux_id": "GetNode",