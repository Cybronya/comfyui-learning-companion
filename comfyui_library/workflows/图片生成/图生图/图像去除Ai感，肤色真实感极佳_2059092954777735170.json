ale", "type": "FLOAT", "localized_name": "input_noise_scale"}, {"widget": {"name": "latent_noise_scale"}, "shape": 7, "name": "latent_noise_scale", "label": "latent_noise_scale", "type": "FLOAT", "localized_name": "latent_noise_scale"}, {"widget": {"name": "offload_device"}, "shape": 7, "name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}, {"widget": {"name": "enable_debug"}, "shape": 7, "name": "enable_debug", "label": "enable_debug", "type": "BOOLEAN", "localized_name": "enable_debug"}], "flags": {}, "type": "SeedVR2VideoUpscaler", "mode": 0, "bgcolor": "#0187a2", "size": [375.114501953125, 528.89892578125], "pos": [1505.724365234375, -17.46268653869629], "id": 18, "properties": {"cnr_id": "seedvr2_videoupscaler", "ver": "912ab4a5da8bb3590c4659f8f19160a7bd88a656", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"color_correction": true, "batch_size": true, "seed": true, "uniform_batch_size": true, "enable_debug": true, "latent_noise_scale": true, "prepend_frames": true, "offload_device": true, "temporal_overlap": true, "input_noise_scale": true, "resolution": true, "max_resolution": true}, "Node name for S&R": "SeedVR2VideoUpscaler", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 33}, {"outputs": [{"shape": 6, "name": "text", "links": [71], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#159bb6", "widgets_values": ["一名温柔清冷的古典美人一位年轻女性，闭目轻笑，神情宁静温柔，长发柔顺垂落肩头，发丝间透出自然光泽。她身着米色针织开衫，内搭白色衬衫，颈间佩戴简约金色细链项链，耳畔点缀小巧精致耳钉，整体穿搭简约而富有质感。她怀抱一把红棕色渐变电吉他，琴颈深色木质纹理清晰，琴身泛着温润光泽，黑色背带自然垂落于身侧，手指轻触琴弦，似在沉浸演奏或静待旋律。\n\n前景聚焦于她的面部与吉他上半部分，细腻捕捉睫毛轻颤、唇角微扬的温柔瞬间，画面构图采用中近景特写，人物占据画面中心偏上位置，视觉重心稳定而柔和。背景虚化处理，隐约可见粉嫩花朵与翠绿枝叶，营造出春日花园的朦胧氛围，虚实对比强化主体存在感。\n\n画面采用自然柔光，光线从侧上方温柔洒落，勾勒出面部轮廓与发丝边缘，形成柔和的明暗过渡，无强烈阴影，整体氛围温暖恬静，带有一丝文艺与治愈感。色彩以暖调为主，米色、奶油白、红棕吉他与背景粉绿形成和谐搭配，视觉舒适自然。\n\n构图上，人物头部微微下倾，视线垂落，配合吉他斜向延伸的线条，引导观者目光从面部自然过渡至手部与乐器，形成视觉流动。画面留白适度，不拥挤，营造出呼吸感与空间感。\n\n整体氛围如午后花园中的静谧时光，既有艺术摄影的精致感，又保留日常设备拍摄的真实质感——无过度锐化、无强烈后期痕迹，光影自然，色彩柔和，仿佛随手捕捉的温柔片刻，却充满情绪张力与画面诗意。画面传递出一种沉浸于音乐、享受当下的宁静幸福感，是生活美学与艺术表达的完美融合。"], "inputs": [{"name": "text", "link": 69, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#0187a2", "size": [344.52984619140625, 511.567626953125], "pos": [51.439605712890625, -25.126455307006836], "id": 58, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 26}, {"outputs": [{"name": "IMAGE", "links": [103], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#171673", "widgets_values": ["c93996d3ac421f50cafb21434e00fb1abd93db3606237873a4aab58d9f5ba69d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#03025f", "size": [401.58135986328125, 776.6902465820312], "pos": [-575.0006713867188, 598.1063842773438], "id": 12, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 15}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#171673", "widgets_values": [], "inputs": [{"name": "images", "link": 109, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#03025f", "size": [994.4952392578125, 767.0136108398438], "pos": [611.0950317382812, 615.8504638671875], "id": 64, 