"label": "zip_filename", "type": "STRING", "localized_name": "zip_filename"}], "color": "#222", "widgets_values": ["ComfyUI", "PNG", ""], "inputs": [{"name": "images or video_path", "link": 36, "label": "images or video_path", "type": "*", "localized_name": "images or video_path"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "image_format"}, "name": "image_format", "label": "image_format", "type": "COMBO", "localized_name": "image_format"}, {"widget": {"name": "password"}, "shape": 7, "name": "password", "label": "password", "type": "STRING", "localized_name": "password"}], "flags": {"pinned": true, "collapsed": true}, "type": "CompressImages", "mode": 0, "bgcolor": "#000", "size": [287.109375, 106], "pos": [217.5111846923828, 1442.6719970703125], "id": 31, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CompressImages"}, "order": 27}, {"outputs": [{"name": "IMAGE", "links": [36], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "#222", "widgets_values": [], "inputs": [{"name": "image", "link": 37, "label": "图像", "type": "IMAGE", "localized_name": "image"}], "flags": {"pinned": true, "collapsed": true}, "type": "ImageListToBatch+", "mode": 0, "bgcolor": "#000", "size": [140, 26], "pos": [-3.9189796447753906, 1480.18115234375], "id": 33, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImageListToBatch+"}, "order": 26}, {"outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#222", "widgets_values": [], "inputs": [{"name": "images", "link": 23, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {"pinned": true}, "type": "PreviewImage", "mode": 0, "bgcolor": "#000", "size": [1145.6839599609375, 1125.8846435546875], "pos": [-468.9079895019531, 605.5015258789062], "id": 19, "properties": {"cnr_id": "comfy-core", "ver": "0.7.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 25}, {"outputs": [{"shape": 6, "name": "STRING", "links": [35], "label": "字符串", "type": "STRING", "localized_name": "字符串"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#222", "widgets_values": ["俯拍中景：三人围坐于自助餐厅靠窗的圆形餐桌旁，图1位于画面左前方，右手悬停在半空，指尖夹着一双竹筷，正对准餐盘中央的糖醋排骨；图2居右后方，左手托腮，嘴角微扬，目光聚焦于图1的动作；图3背对窗户坐于画面底部中央，低头凝视自己面前盛满米饭的白瓷碗。午后斜阳从右侧高窗倾泻而下，在桌面投下清晰的筷影与人物轮廓光，不锈钢餐盘反光柔和，背景虚化的取餐区隐约可见保温罩与玻璃隔板。构图呈三角稳定布局，餐具、食物与人物手部构成视觉引导线。\n平视近景：图2正面特写，占据画面三分之二，她刚将一块红烧肉送入口中，双唇微张，牙齿轻咬肉块边缘，右颊略鼓；背景虚焦处可见图1与图3的肩部及部分餐桌。顶光从上方柔光灯箱洒落，在她鼻梁与颧骨形成细腻高光，油亮的酱汁在唇角留下细微反光。前景桌面上一只青花小碟盛着蒜蓉青菜，蒸汽已散尽，仅余温润水汽附着于瓷面。镜头略带浅景深，焦点精准落在唇部与食物接触点。\n低角度侧拍：图3半身入镜，坐姿端正，左手持碗底，右手执筷夹起一缕粉丝，手臂悬停于胸前高度，动作凝固如雕塑。背景为自助餐台金属栏杆与叠放的空托盘，光线自左侧高窗斜射，在其白色衬衫肩部形成明亮光斑，同时在桌面拉出细长投影。图1与图2分别位于画面左右边缘，仅露出局部衣袖与餐盘，暗示围坐关系。构图以图3为中心轴，筷子与视线方向指向画面右上角留白，营造静态张力。\n过肩镜头（图1视角）：从图1背后拍摄，前景为其右肩与举起的筷子，中景为图2正伸手欲取转盘上的清蒸鱼，指尖距鱼腹约十厘米；图3在画面右侧低头舀汤，瓷勺悬于碗沿。餐厅顶灯在不锈钢转盘表面形成环形高光，鱼身银鳞与汤面油星反射点状光源。背景虚化但可辨识自助餐区的冷饮柜与绿植隔断。画面采用三分法，人物手部动作构成动态平衡，光线均匀漫射，无强烈阴影。\n特写-手部与食物：画面仅聚焦桌面局部——图1的右手与图2的左手同时伸向一盘宫保鸡丁，两双筷子尖端几乎相触，间隔不足一厘米。木质筷身纹理清晰，鸡丁裹着琥珀色酱汁，花生米散落于青瓷盘沿。顶光垂直照射，在酱汁表面形成高光点，筷影短促投于盘底。背景完全虚化为暖灰色调，仅通过衣物袖口颜色（图1藏青、图2米白）暗示人物身份。构图紧凑，强调即将交汇却未接触的瞬间张力。\n平视全景：三人完整入镜，围坐于铺有格纹桌布的方桌。图1身体前倾，右手扶碗，左手比划讲解，五指微张；图2侧身朝向图1，一手搭在椅背，另一手搁于膝上，神情专注；图3端坐对面，双手交叠置于桌面，面前餐盘堆叠三层空碟。餐厅日光灯管横向排布，光线均匀覆盖全桌，仅在金属餐具边缘产生锐利反光。背景为整齐排列的四人座卡座区，绿植与菜单架构成秩序感。画面横平竖直，人物姿态各异但重心稳定。\n高角度斜侧拍：镜头自餐桌左上方45度俯视，图3位于画面中心，正用公筷将西兰花拨入图1面前的空碟，筷尖悬停于碟口上方三厘米；图1双手捧碗作接受状，图2则扭头望向邻桌，表情松弛。桌面食物分布清晰：近景为椒盐虾壳堆成小丘，中景是半空的番茄蛋汤碗，远景为尚满的米饭桶。窗外天光透过百叶帘，在桌面投下平行光栅，明暗交替强化空间层次。构图利用餐具连线形成隐形对角线。\n浅景深侧脸特写：图1侧颜占据画面右半，嘴唇微启似在发笑，眼角细纹因表情舒展而显现；焦点外的背景中，图2与图3的模糊身影正举杯相碰，玻璃杯折射出餐厅顶灯光斑。主光源来自画面左侧窗洞，照亮图1面部轮廓，在颧骨与下颌形成柔和过渡的明暗交界线。前景虚化的餐盘边缘可见残留的辣椒油渍，暗示刚结束的进食。色调偏暖，突出皮肤质感与玻璃器皿的通透感。\n桌面水平视角：镜头贴近桌面高度，仰拍三人下半身与桌面交界。图1的牛仔裤腿、图2的亚麻裙摆、图3的西裤脚踝呈扇形分布，脚边散落两张使用过的餐巾纸。桌面上，三副碗筷呈放射状摆放，筷尾指向各自主人，中间转盘停驻于凉拌木耳位置。顶光经桌面浅色木纹漫反射，在裤料纤维上形成柔和高光。构图强调物品归属与空间占有，人物虽未露脸，但服饰与物品状态完整传递身份与行为逻辑。\n广角平视：三人并排坐于长条桌一侧，背对取餐区玻璃墙。图1居中，双手撑桌似欲起身；图2在其右，正将最后一块咕咾肉放入图3碗中，手腕悬停；图3左手扶碗，右手握拳抵唇，似忍笑意。餐厅顶灯阵列在抛光地面映出倒影，增强纵深感。背景玻璃墙外可见排队人群虚影，强化自助餐厅环境属性。光线整体明亮均匀，仅在人物发丝边缘勾勒出淡淡轮廓光。画面横幅宽广，人物间距自然，餐具与食物状态呼应聚餐尾声。", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "最大行数"}], "flags": {"pinned": true}, "type": "easy promptLine", "mode": 0, "bgcolor": "#000", "size": [846.7656860351562, 613.1355590820312], "pos": [-1323.7489013671875, 765.744140625], "id": 24, "properties": {"cnr_id": "comfyui-easy-use", "ver": "8ecc929cd41cf0f7ef6fcc45d4bbc5729c6f287f", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy promptLine"}, "order": 7}, {"outputs": [], "color": "#222", "widgets_values": ["\n============工作流使用说明=============\n\n一共分3步，\n\n1.设置分辨率\n\n2.放入你的剧本文本\n\n3.添加你的角色照片，不用的角色位请“忽略”【选择节点，顶部第三个图箭头图标就是忽略/取消忽略】\n\n出图很快，已经接入打包ZIP。\n\n\n============剧本设计说明=============\n\n1.每一条描述词请清晰的叙述每个静态镜头的重要元素，人物，动作，姿势，场景环境，光影，拍摄角度，等等。你描述的越清晰，图片内容越具体。避免混乱。\n\n2.镜头数量不限制，大约10-100条没有问题。\n\n3.如果有服装变动，场景变动等元素变动，需要写清楚，不然AI依然会使用随机内容进行填补。\n\n4.大多数AI对话会偷懒，少写，所以你需要对剧本进行审核和评论，让AI知道你期待的内容。\n\n5.剧本创作推荐：GROK,GPT5.1,千问.\n\n6.给你们一段模板，你们可以自行修改\n\n\"请生成【数量】段彼此独立、各自完整的静态照片描述（非视频分镜或动态场景），每段【字数下限】–【字数上限】字。所有照片必须围绕“【统一主题】”展开，设定在【具体场景】中，且每张画面均包含【角色列表】（可全身、半身或局部入镜，但需能通过位置、姿态或服饰特征识别身份）；每幅描述须呈现一个完全凝固的瞬间姿态（如【示例动作1】、【示例动作2】等自然行为的定格），单看即可构成一幅构图严谨、元素齐全的剧照；描述中必须包含可感知的光影效果（如光源方向、明暗对比、物体投影、材质反光或环境漫射），以构建空间深度与视觉氛围；全部照片在人物关系、物品状态或环境细节上应体现自然延续性，但不得依赖叙事衔接；语言须严格具象，聚焦可观察的实体形态、空间关系与物理细节，禁用抽象情绪概括。\"\n\n\n============分镜图有什么用？=============\n\n你可以多次生成不同剧情的分镜图，然后用分镜图去构建你的故事。\n\n使用首位帧来让分镜图变成你希望的视频剧情。\n\n超好玩，推荐给你！\nAI应用：首尾帧-WAN2.2-RemixV2-I2V-鸭子加密 \n体验地址：https://www.runninghub.cn/ai-detail/2007090886139711490/?inviteCode=eaylmgdi\n\n当然也有更多好玩的，有趣的，更高效的首尾帧工作流和应用，你都应该去尝试一下。\n\n"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "mode": 0, "bgcolor": "#000", "size": [495.77630615234375, 1131.72119140625], "pos": [-1828.7801513671875, 606.6752319335938], "id": 30, "properties": {"widget_ue_connectable": {}}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [2233.8172680313855, -640.4642896448173], "scale": 1.3310000000000006}}, "groups": [], "links": [[1, 22, 0, 2, 0, "MODEL"], [2, 7, 0, 3, 0, "CONDITIONING"], [3, 27, 0, 4, 0, "CONDITIONING"], [4, 2, 0, 5, 0, "MODEL"], [5, 1, 0, 7, 0, "CLIP"], [6, 9, 0, 7, 1, "VAE"], [7, 15, 0, 7, 2, "IMAGE"], [8, 10, 0, 7, 3, "IMAGE"], [9, 11, 0, 7, 4, "IMAGE"], [10, 28, 0, 10, 0, "IMAGE"], [11, 29, 0, 11, 0, "IMAGE"], [12, 5, 0, 12, 0, "MODEL"], [13, 4, 0, 12, 1, "CONDITIONING"], [14, 3, 0, 12, 2, "CONDITIONING"], [15, 17, 0, 12, 3, "LATENT"], [16, 12, 0, 13, 0, "LATENT"], [17, 9, 0, 13, 1, "VAE"], [20, 23, 0, 15, 0, "IMAGE"], [21, 15, 0, 16, 0, "IMAGE"], [22, 9, 0, 16, 1, "VAE"], [23, 13, 0, 19, 0, "IMAGE"], [24, 18, 0, 20, 0, "MODEL"], [25, 20, 0, 21, 0, "MODEL"], [26, 21, 0, 22, 0, "MODEL"], [28, 12, 0, 26, 0, "LATENT"], [29, 9, 0, 26, 1, "VAE"], [30, 1, 0, 27, 0, "CLIP"], [31, 9, 0, 27, 1, "VAE"], [32, 15, 0, 27, 2, "IMAGE"], [33, 10, 0, 27, 3, "IMAGE"], [34, 11, 0, 27, 4, "IMAGE"], [35, 24, 0, 27, 5, "STRING"], [36, 33, 0, 31, 0, "*"], [37, 13, 0, 33, 0, "IMAGE"]], "id": "a4ee2917-58db-436b-859e-3301c7056c45", "config": {}, "version": 0.4, "last_node_id": 35, "revision": 0}