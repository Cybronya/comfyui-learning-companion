984375, 1444.1270751953125], "widgets_values": ["c96aff8b2d6259381605a63762b580a5a0572d673250c955495b55b42cbb46d8.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 28, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 15}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "字符串", "type": "STRING", "localized_name": "text"}], "size": [430.2435607910156, 186.63128662109375], "pos": [1418.9130859375, 966.0258178710938], "widgets_values": ["这是一张年轻男子与猫咪的合影。男子留着深棕色短发，略显凌乱，戴着黑色方框眼镜。他肤色白皙，神情略带严肃地直视镜头，身穿黑色衬衫，脖颈间挂着一副银色包边的黑色耳机。他的右手轻抚猫咪胸口，左手托住猫的背部。猫咪是长毛品种，毛发蓬松柔软，通体雪白，眼周、耳朵和鼻部点缀着棕褐色斑纹。它微微眯着蓝色的眼睛，表情略显不悦，但毛发梳理得十分整洁。背景是简洁的室内环境，右侧上方隐约可见白墙与棕色门框。自然光线从画面左侧洒入，投下柔和的阴影，照亮了主人与猫咪的面部以及猫咪的毛发。构图采用近景特写，聚焦于男子与猫，背景略微虚化以突出前景主体。整张照片散发着温暖亲密的氛围，定格了人与猫之间静谧交流的瞬间。"], "inputs": [{"name": "text", "link": 5, "label": "文本", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 6, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 34}, {"mode": 0, "outputs": [{"name": "image", "links": [17, 42], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING"}, {"name": "response", "label": "response", "type": "STRING"}], "size": [400, 240], "pos": [742.6127319335938, 2146.539794921875], "widgets_values": ["把图片改成线稿", 188251596, "randomize", "auto"], "inputs": [{"shape": 7, "name": "images", "link": 13, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "imag