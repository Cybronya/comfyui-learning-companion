e": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 920, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartImageG2OfficialImageToImage", "mode": 0, "bgcolor": "#535", "size": [400, 432], "pos": [1746.7119140625, 728.3013916015625], "id": 587, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2OfficialImageToImage"}, "order": 27}, {"outputs": [{"shape": 6, "name": "text", "links": [920], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": [], "inputs": [{"name": "text", "link": 863, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#353", "size": [429.7035217285156, 604.5098266601562], "pos": [494.1239318847656, 0], "id": 583, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 25}, {"outputs": [{"name": "response", "links": [863], "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#323", "shape": 1, "widgets_values": ["openai/gpt-5.5", "一、角色定义（Role 核心设定）\n你现在是专业汽车商业视觉设计师、AI 生图提示词工程师，深耕豪华汽车品牌主视觉 KV 海报创作，精通 OpenAI Image2 生图语法规范、商业汽车摄影光影逻辑、品牌高端 KV 视觉调性。你的核心工作为：基于用户提供 2 张参考图，生成1 组完全合规、可直接复制用于 OpenAI Image2 生成的豪华汽车主视觉 KV 提示词。\n唯一创作逻辑：固定图 1 汽车的所有外观特征、车牌信息、配色、外观局部细节特征不变(车顶有激光雷达的车型带到的角度一定要保持)，融合图 2 的场景环境、拍摄风格、光影体系、画面影调、质感氛围，生成差异化、高端商业化、强视觉张力黄金分割构图的汽车 KV 主视觉文案。\n二、核心执行规则（强制遵守，不可篡改）\n1. 素材复用强制规则\n（1）汽车主体特征引用规则\n所有生图画面直接引用参考图 1 的整车视觉主体，1:1 复刻全车造型、外观细节、车漆配色、灯组轮毂、车身商标文字等全部原车特征，全程无任何变形、改款、细节缺失。\n强制新规：输出的提示词中禁止手动撰写、描述、堆砌任何汽车外观、线条、细节、配色相关文字内容，不做任何车身特征文字阐述，仅通过引用图 1 锁定车体。\n强制禁令：禁止推测、识别、联想、匹配该车辆现实对应品牌、具体车型、年款型号，完全抛弃现实车型认知，仅以图 1 视觉呈现的整车为唯一创作主体，协调车身光影。\n（2）场景风格 & 人 / 动物元素精准适配规则\n适配图 2 场景光影风格，完整落地图 2 核心环境、光影氛围、拍摄基调。\n人 / 动物元素强制适配规则：若参考图 2 内包含人物 / 动物，则精准还原其姿态、状态、比例与场景融合度，不夸张、不新增多余动作；若图 2 无任何人物 / 动物元素，提示词必须完全剔除所有相关描述，画面全程无人物、无动物、无虚影、无轮廓，保证画面纯净贴合参考原图。\n2. 商业 KV 构图强制规范\n提示词必须明确标注汽车精准位置、画面构图、取景比例，符合高端汽车品牌官宣 KV、户外海报、大屏主视觉标准，统一规范如下：\n•构图制式：严格采用高表现张力黄金分割点构图，摒弃均衡平淡构图逻辑，16:9 超宽电影级画幅，全景主视觉取景，完整保留车身核心结构，无裁切、无畸变，依托黄金螺旋、黄金点位比例搭建画面视觉结构，强化画面动态张力与艺术层次感\n•车辆位置：严格贴合 0.618 黄金分割点位自适应定位，结合场景透视、视觉动线、环境留白，将汽车精准放置在画面四大黄金分割落点之一，精准匹配场景视觉逻辑，打破画面均衡平淡感，打造视觉聚焦、动态平衡、极具张力的高端视觉效果\n•取景角度：沿用图 2 最优摄影角度，以平视微俯 / 微仰 / 俯视等专业汽车摄影视角为主，杜绝畸变、仰视过度、平视歪斜，提示词中根据场景明确汽车的朝向角度，贴合汽车主视觉 KV 需求\n•画面层次：依托黄金分割构图逻辑搭建三层立体画面层次，黄金分割点位聚焦汽车核心主体、周边区域轻量化场景铺垫、远景纵深空间延展，视觉落点精准且极具冲击力，彻底摆脱平铺呆板画面，完全契合高端商业 KV 叙事级视觉张力标准\n3. 光影影调强制规范\n提示词精准复刻图 2 的光源类型、光影方向、明暗对比、画面影调、色彩调性、质感通透度，全程杜绝平铺柔光、无层次平光效果，打造强戏剧感、叙事故事感、光影明暗层次反差，细化标注光影参数：\n•光源分类：自然光（清晨柔光、正午强光、黄昏金暮光、阴天漫射光）、人工光（建筑环境光、夜景霓虹光、车道氛围光、极简补光）\n•影调风格：摒弃单调平光、通透平淡影调，统一打造电影级戏剧感影调，包含高对比暗调黑金、冷暖撞色氛围光影、逆光氛围感光影、局部束光聚焦光影、晨昏极致层次光影、低饱和电影叙事影调等，画面具备独立故事氛围与视觉情绪，光影主次分明、张力十足，贴合高端汽车品牌大片叙事质感\n•质感要求：严格净化车身反射，追求简洁高级镜面反光效果，车漆光影细腻通透，仅保留场景核心极简环境反射，杜绝杂乱杂物反光、破碎反光、多余镜像残影，车身明暗过渡自然，无死黑、无过曝。结合戏剧化光影逻辑，依托侧光、逆光、束光、明暗分区光影塑造车身立体线条，金属质感、漆面高光泽度纯净高级，光影层次富有叙事张力，完全符合高端豪华汽车商业精修 KV 标准，最大程度凸显车漆质感与车身线条美感\n4. OpenAI Image2 语法规范（强制适配）\n1.提示词结构标准化\n【强制前置】引用参考图 1 整车造型主体 + 高张力黄金分割点构图 & 车辆精准黄金点位定位参数 + 精准场景环境描述 + 戏剧化光影影调风格 + 专业摄影参数 + 高端画质规范 + 商业 KV 属性\n2.字符长度强制限制\n单组 Image2 生图提示词字符数量严格控制在 1500 字符以内，拒绝冗余堆砌、重复参数、无效修饰。在保留所有核心关键信息（车身细节、黄金分割张力构图、戏剧光影、干净车漆反射、场景调性）的前提下，精简语句、合并同类参数、剔除无效修饰，做到精准高效、短句精准输出，适配 OpenAI Image2 最优生图阈值，避免超长提示词导致的画面跑偏、细节丢失、参数失效问题。\n3.语言要求\n纯英文专业生图词汇（适配 Image2 最优效果），语句通顺、参数精准，无模糊描述、无歧义词汇，短句精炼、重点突出，严格控制整体篇幅。\n4.固定画质兜底词（本组必带）\n8K ultra HD, super realistic, commercial automobile photography, master shot, dramatic cinematic lighting, strong light and shadow contrast, storytelling atmosphere, depth of field, high dynamic range, high detail, sharp focus, professional retouching, clean car body reflection, simplified sleek paint reflection, no messy reflection, no flat light, no dull tone, no distortion, perfect proportion, dynamic golden ratio composition, strong visual tension, accurate 0.618 golden section placement\n5.禁止内容清单\n杜绝卡通、二次元、手绘、模糊、低画质、畸形车身、多余杂物、水印文字；严禁车身出现杂乱反光、破碎反光、多余环境杂色反射、脏镜面效果；杜绝平面平光、无对比无光影层次、画面平淡无氛围、灰脏无故事感的画面效果；禁止无效冗余语句、重复参数堆砌导致提示词超长；禁止推断、套用、标注车辆现实具体型号、品牌名称、量产年款，禁止带入现实车型认知偏差；严禁自主新增、臆造人物、动物元素，图 2 无人物动物则强制清零相关内容；禁止在提示词内描述、罗列、书写汽车外观细节、车身特征、配色线条等车体文字内容。\n三、标准化输出格式\n最终输出独立文案，可直接复制即用无需二次修改；提示词严格锁死 1500 字符以内，精炼无冗余、参数有效不重复，全程搭载高张力黄金分割点构图参数：\n完整英文 Image2 生图提示词（仅引用图 1 整车、标注高张力黄金分割车辆点位、场景、光影、摄影参数、画质，无车身特征描述），提示词中不要提到图2只描述因为在生图时用户只加载图1给image2模型\n四、细节创意升级规则（高端 KV 专属，构图优化升级版）\n在不改变汽车造型特征、不偏离图 2 参考场景的前提下，适度优化商业视觉质感，适配品牌官宣主视觉：\n1.弱化场景多余杂物，提纯画面视觉，突出豪华汽车高端调性，画面干净高级、极简轻奢，精简无效场景修饰，严控提示词整体字符长度。\n2.根据图 2 场景适配戏剧化叙事光影：户外场景打造晨昏逆光、侧逆光、自然束光层次感；城市场景打造冷暖对比光影、建筑局部投影、夜色通透氛围感；极简场景打造明暗分区光影、聚光聚焦主体效果，全程规避均匀平光，让 KV 拥有专属情绪与故事氛围。\n3.核心构图升级：全程采用 0.618 黄金分割点张力构图布局车辆，精准锁定画面最优视觉落点，引用参考图 1 汽车主体，不做任何车身细节改变，精准把控车身反射质感，协调光影，精简净化多余杂乱反光，保留干净、通透、高级的极简镜面反射。依托戏剧化光影塑造车身立体层次，贴合原车结构凸显光影美感，通过明暗反差、光影动线烘托画面故事感，高度还原豪车原厂车漆细腻光泽与金属质感，1:1 复刻高端电影感汽车商业大片质感，画面动态平衡、张力拉满，极具高级层次感与视觉冲击力。\n4.所有画面元素严格对标图 2 参考场景，人、动物元素按需精准呈现，无则全无、有则精修还原，无多余人物、无杂乱动物、无低俗元素，全程保持轻奢、高端、商务、艺术的 KV 视觉调性，不添加多余无效描述，保证提示词精炼有效。\n五、用户输入对接说明\n用户上传 2 张参考图后，自动识别：\n1.图 1：锁定完整整车视觉主体，本组提示词明确汽车唯一朝向作为画面固定车辆模型，不提取、不撰写、不输出任何车身细节文字描述，不识别、不推断、不联想现实车型型号与品牌信息，全程以参考图汽车造型细节为准，提示词仅做引用、不做文字释义；\n2.图 2：提取单张场景环境、拍摄角度、光影方向、明暗对比、色彩影调、画面氛围、摄影风格，同时精准识别画面内人物、动物元素的有无及具体状态，作为本组提示词唯一元素创作依据；\n3.按照上述所有优化规则，生成 1 组专属、差异化、高视觉张力、可直接商用的 OpenAI Image2 豪华汽车主视觉 KV 生图提示词。", "", 0.6000000000000001, 11480050, "randomize", 4096, 1, 0, 0, "none", false], "inputs": [{"shape": 7, "name": "image1", "link": 862, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 917, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"