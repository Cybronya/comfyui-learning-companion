, 0], "widgets_values": ["e57d9612826c3e4acd78ef1b88aa756c0edb403287145216e170bde5dfda85e4.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {"collapsed": false}, "id": 2, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 5}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [2], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [240, 314], "pos": [0, 702], "widgets_values": ["78b6fa349ba517156b1fbb5d48b3fa51d9a2d094b370887540db9f60d1d4a8c0.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {"collapsed": false}, "id": 3, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 6}, {"outputs": [{"name": "image", "links": [5], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["【任务目标】\n将参考图A中的人物和服装替换为新素材，生成融合后的合成图像。\n\n【输入素材】\n- 参考图A（原图）：提供构图、姿势、场景环境、背景元素、光影方向\n- 素材图B（新人物）：提供替换人物的面部特征、肤色、发型\n- 素材图B（新服装）：提供替换服装的款式、材质、颜色、细节\n\n【替换规则】\n\n1. 人物替换：\n   - 保留参考图A的姿势、体态、动作角度\n   - 将素材图B的人物面部特征迁移到参考图A\n   - 保持人物肤色、发型与素材图B一致\n   - 确保人物比例与原图协调\n\n2. 服装替换：\n   - 将素材图B的服装完整迁移到参考图A\n   - 保持服装的褶皱、光影与原图姿势匹配\n   - 服装材质、颜色、图案与素材图C一致\n   - 服装需贴合人物姿态，自然不穿模\n\n3. 保留不变：\n   - 参考图A的背景环境完全保留\n   - 参考图A的场景道具完全保留\n   - 参考图A的整体构图不变\n   - 参考图A的光影方向和氛围不变\n\n【融合质量要求】\n- 人物与新姿势自然融合，无违和感\n- 服装褶皱、光影与动作协调\n- 边缘过渡自然，无拼接痕迹\n- 色调统一，整体协调\n- 保持原图分辨率\n\n【输出规格】\n- 分辨率：与参考图A一致\n- 格式：高清无水印\n- 质量：细节清晰，无模糊\n\n【验收标准】\n✓ 人物面部为素材图B的特征\n✓ 服装为素材图B的款式\n✓ 姿势与参考图A完全一致\n✓ 背景、场景、道具与参考图A相同\n✓ 整体画面自然协调，无明显拼接感", "16:9", false, 1425039852, "randomize"], "inputs": [{"name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 2, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {"collapsed": false}, "type": "RH_RhartImageG2ImageToImage", "mode": 0, "bgcolor": "#653", "size": [308.3540954589844, 224], "pos": [540, 0], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2ImageToImage"}, "order": 7}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1179.156285603841, 772.4444444444445], "scale": 0.45}}, "groups": [], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 3, 0, 1, 1, "IMAGE"], [5, 1, 0, 4, 0, "IMAGE"]], "id": "0d383b69-092e-42ca-a333-de094c00649b", "config": {}, "version": 0.4, "last_node_id": 9, "revision": 0}