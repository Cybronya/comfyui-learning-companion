ength_model": true}, "version": "7.0.1"}, "secondTabOffset": 80, "Node name for S&R": "LoraLoaderModelOnly", "tabWidth": 65, "secondTabWidth": 65, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "tabXOffset": 10}, "order": 16}, {"outputs": [{"shape": 6, "name": "STRING", "links": [50], "label": "字符串", "type": "STRING", "localized_name": "字符串"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#432", "widgets_values": ["近景,昏黄的壁灯散发出柔和光晕，为整个客厅铺上一层暖色调。女人优雅地坐在天鹅绒沙发边缘，身体微微前倾，手肘轻搭在膝盖上，托着下巴。她眼神专注，似在沉思，又似在聆听着空气中若有若无的旋律。精心勾勒的眉形下，双眸深邃而神秘，犹如藏着无数故事。殷红的嘴唇微微抿起，嘴角带着一丝难以捉摸的浅笑，与客厅里奢华却不失格调的装饰相得益彰。\n特写,女人精致的面容在暖光下宛如一件稀世珍宝。她那卷翘的睫毛，根根分明，每一次眨动都像蝴蝶振翅，扑闪间带出丝丝魅惑。高挺的鼻梁线条流畅，犹如山峦的优雅起伏。嘴唇似娇艳的玫瑰花瓣，色泽饱满，泛着诱人的光泽，仿佛轻轻一触就会留下唇印。而在那细腻的肌肤上，淡淡的光影勾勒出脸部柔和的轮廓，每一寸都散发着成熟女人独有的韵味。\n中景,豪华的客厅里，水晶吊灯洒下璀璨光芒，映照在大理石地面上，反射出如梦似幻的光影。女人身着一袭修身的晚礼服，在客厅中央缓缓踱步。她的身姿轻盈而曼妙，裙摆随着步伐轻轻摇曳，如同流动的绸缎。周围摆放着复古的真皮沙发、精致的雕花茶几以及各种艺术摆件，与她相得益彰，宛如一幅生动的油画，诉说着奢华与优雅的故事。", 0, 6, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "最大行数"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#653", "size": [676.6047973632812, 452.87908935546875], "pos": [1809.4044189453125, 1088.2628173828125], "id": 18, "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "Node name for S&R": "easy promptLine"}, "order": 5}, {"outputs": [], "color": "#432", "widgets_values": ["\n\n\n😏😪😜🤤🙂↕️😈😏😪😜🤤🙂↕️😈\n\n2、工 作 流 & 模 型 下 载：\n\nComfyUI 模型已经分类放好，点击链接即可保存。https://pan.quark.cn/s/87501faa4042\n\n😏😪😜🤤🙂↕️😈😏😪😜🤤🙂↕️😈\n\n