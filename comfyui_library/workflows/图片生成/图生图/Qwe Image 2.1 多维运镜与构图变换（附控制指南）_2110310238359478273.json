: "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [564.7808227539062, 302], "pos": [134.08677673339844, 293.57354736328125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 71, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 46, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 13}, {"outputs": [{"name": "text", "links": [65], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#4b5563", "widgets_values": ["<qma> back view elevated shot wide shot"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "提示词", "mode": 0, "bgcolor": "rgba(21, 23, 27, 0.96)", "size": [291.6195068359375, 192.46047973632812], "pos": [-221.56658935546875, 290.0021667480469], "id": 42, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [67], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [411.3658752441406, 82], "pos": [1131.918701171875, 642.5723876953125], "widgets_values": ["qwen-image-2.1-qma-camera-angles.safetensors", 1.0000000000000002], "inputs": [{"name": "model", "link": 66, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 44, "type": "LoraLoaderModelOnly", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["# 📷 多视角相机控制提示词指南 (QMA Camera Angles)\n\n本功能支持通过极简的三维坐标指令，精确控制原图相机的**旋转角度、拍摄高度与镜头距离**。\n\n---\n\n## 📌 1. 提示词标准语法\n\n所有指令均需遵循固定结构，在触发词后**按顺序选择【方位角】+【俯仰角】+【景别】**组合输入：\n\n> `<qma> {方位角 Azimuth} {俯仰角 Elevation} {景别 Distance}`\n\n---\n\n## 🧭 2. 三维控制参数速查表\n\n> ⚠️ **注意**：方向是**基于原图相机位置的相对旋转**（并非主体自身的左右）。“Right side view” 指相机向原相机的右侧绕行 90 度。\n\n### ① 方位角（Azimuth）—— 相机水平环绕方向\n| 参数值（英文原词） | 视角说明 |\n| :--- | :--- |\n| `front view` | 正面视角 |\n| `front-right quarter view` | 右前 45° 视角 |\n| `right side view` | 右侧 90° 视角 |\n| `back-right quarter view` | 右后 45° 视角 |\n| `back view` | 正后 180° 视角 |\n| `back-left quarter view` | 左后 45° 视角 |\n| `left side view` | 左侧 90° 视角 |\n| `front-left quarter view` | 左前 45° 视角 |\n\n### ② 俯仰角（Elevation）—— 相机高度与仰俯状态\n| 参数值（英文原词） | 镜头效果 |\n| :--- | :--- |\n| `low-angle shot` | 仰拍 / 低角度机位 |\n| `eye-level shot` | 平视 / 与眼齐高 |\n| `elevated shot` | 抬高视角 / 微俯拍 |\n| `high-angle shot` | 俯拍 / 高角度鸟瞰 |\n\n### ③ 景别（Distance）—— 相机与主体的距离\n| 参数值（英文原词） | 镜头拉近/拉远 |\n| :--- | :--- |\n| `close-up` | 特写 |\n| `medium shot` | 中景 |\n| `wide shot` | 广角 / 全景 |\n\n---\n\n## 💡 3. 典型组合示例\n\n* **右侧平视中景**：\n  `<qma> right side view eye-level shot medium shot`\n* **背部抬高全景**：\n  `<qma> back view elevated shot wide shot`\n* **左前仰视特写**：\n  `<qma> front-left quarter view low-angle shot close-up`\n\n---\n\n## 🛠️ 4. 实操技巧与注意事项\n\n1. **最稳定组合**：45度斜角（Quarter views）、微俯视角（Elevated shots）以及改变镜头拉近推远（Distance changes）的表现最为准确稳定。\n2. **大范围旋转调整**：在风景/大场景中旋转 90 度时，若遇到旋转角度不到位的情况，可以通过更换随机种子（Seed）或尝试相邻角度（如 45 度侧角）来解决。\n3. **盲区补全推测**：对于原图遮挡或未展示的部分（如人物背面），模型会基于画面逻辑进行生成式推断补全。\n4. **叠加二次编辑指令**：仅输入相机角度指令效果最干净；若需要在旋转视角的同时修改画面，可以在相机指令后面追加具体的修改描述（例如：`<qma> right side view eye-level shot medium shot, change clothing to dark blue jacket`）。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [717.017822265625, 1206.0531005859375], "pos": [-975.5628662109375, 295.3815612792969], "id": 48, "properties": {}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "frontendVersion": "1.53.6", "ds": {"offset": [1234.4216160330034, 157.33799707051585], "scale": 0.8769226950000013}}, "groups": [{"color": "#b06634", "font_size": 70, "flags": {}, "id": 5, "title": "B站：野生技能师", "bounding": [-213.1822052001953, 104.93955993652344, 1780.7431640625, 96.66598510742188]}], "links": [[32, 31, 0, 34, 0, "MODEL"], [33, 30, 0, 34, 1, "CONDITIONING"], [34, 30, 1, 34, 2, "CONDITIONING"], [35, 30, 2, 34, 3, "LATENT"], [38, 34, 0, 35, 0, "LATENT"], [39, 35, 0, 36, 0, "IMAGE"], [52, 6, 0, 30, 0, "CLIP"], [54, 7, 0, 30, 3, "VAE"], [55, 7, 0, 35, 1, "VAE"], [62, 41, 0, 30, 1, "IMAGE"], [65, 42, 0, 30, 4, "STRING"], [66, 8, 0, 44, 0, "MODEL"], [67, 44, 0, 31, 0, "MODEL"], [70, 43, 0, 34, 4, "INT"], [71, 36, 0, 46, 0, "IMAGE"]], "id": "ea98369b-a6f3-4714-b34f-3b877fbe9017", "config": {}, "version": 0.4, "last_node_id": 48, "revision": 0}