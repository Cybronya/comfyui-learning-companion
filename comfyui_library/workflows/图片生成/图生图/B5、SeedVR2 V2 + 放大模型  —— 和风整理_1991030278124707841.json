model_name", "type": "COMBO", "localized_name": "放大模型名称"}], "flags": {}, "type": "UpscaleModelLoader", "mode": 0, "bgcolor": "#653", "size": [270, 58], "pos": [602.8839111328125, 259.6045227050781], "id": 16, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UpscaleModelLoader"}, "order": 2}, {"outputs": [{"name": "extra_args", "links": [4], "label": "extra_args", "type": "extra_args", "localized_name": "extra_args"}], "color": "#432", "widgets_values": [true, 512, 64, true, true, true], "inputs": [{"widget": {"name": "tiled_vae"}, "name": "tiled_vae", "label": "tiled_vae", "type": "BOOLEAN", "localized_name": "tiled_vae"}, {"widget": {"name": "vae_tile_size"}, "name": "vae_tile_size", "label": "vae_tile_size", "type": "INT", "localized_name": "vae_tile_size"}, {"widget": {"name": "vae_tile_overlap"}, "name": "vae_tile_overlap", "label": "vae_tile_overlap", "type": "INT", "localized_name": "vae_tile_overlap"}, {"widget": {"name": "preserve_vram"}, "name": "preserve_vram", "label": "preserve_vram", "type": "BOOLEAN", "localized_name": "preserve_vram"}, {"widget": {"name": "cache_model"}, "name": "cache_model", "label": "cache_model", "type": "BOOLEAN", "localized_name": "cache_model"}, {"widget": {"name": "enable_debug"}, "name": "enable_debug", "label": "enable_debug", "type": "BOOLEAN", "localized_name": "enable_debug"}], "flags": {}, "type": "SeedVR2ExtraArgs", "mode": 0, "bgcolor": "#653", "size": [270, 178], "pos": [921.3494262695312, 486.4976501464844], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SeedVR2ExtraArgs"}, "order": 3}, {"outputs": [], "color": "#323", "widgets_values": ["👉       【各大模型出图商用原则】\n-\n1. 需严格遵照作者对模型的商业许可范围声明综合判断，具体如下：\n- ❌如底模出图不可商用，则创作的图片不可商用。\n- ❌如底模出图可商用，但搭配的 LoRA 出图不可商用，则创作的图片不可商用。\n- ✅如底模出图可商用，且搭配的 LoRA 出图可商用，则创作的图片可商用。\n---\n\n2. 需严格遵照工作流的作者对工作流和模型的商业许可范围声明综合判断，具体如下：\n- ❌如工作流作者声明出图可商用，但工作流中涵盖的模型是其他作者的不可商用模型，则不可商用，侵权行为与工作流作者无关。\n- ✅如工作流提供的作者声明出图不可商用，但工作流中没有涉及API，且使用的模型为可商用，节点也是开源节点，则创作的图片只要你不承认自己是抄袭的工作流，即可商用。虽不道德但不侵权。这种事要小心被曝光，或者遇见搅屎棍。\n- ✅如工作流声明出图可商用，且使用的模型声明可商用，则创作的图片可商用。\n---\n\n3. 出图内容需严格遵照国家法律，如果违背或侵权，应承担对应的法律责任。其中包括但不限于的具体内容有下：\n- ❌故意输入可能侵犯第三方知识产权或其他权益的关键词或提示词，导致生成的图片可能侵犯第三方知识产权或权益的，该图片不得用于商业用途，且用户应承担由此产生的全部侵权责任。\n- ❌出图人物侵犯他人肖像权，且没有证据自证者，图片不得商用。\n- ❌出图内容为18禁的内容，或者明确为黄赌毒的宣传标语，图片不得商用，若经传播，应承担相应法律责任。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "和风友情提示", "mode": 0, "bgcolor": "#535", "size": [393.98455810546875, 523.682373046875], "pos": [-491.419921875, 372.002197265625], "id": 17, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 4}, {"outputs": [], "color": "#323", "widgets_values": ["✍ 本工作流初次制作于2025年10月，线上没有后续更新，该版本修复性更强，智能识别效率高，但截止到11月19号，线上依旧没有能使用的SeedVR2以及放大模型V2的更新内容，这里会比本地稍差一些。\n---\n\n和风工作流节点颜色简易区分：\n-\n\n- 💎蓝色为需求输入和结果获取；\n\n- ✅绿色为根据需求更换；\n\n- 💜紫色为注意参考；\n\n- ☝黄色为尽量不更改；\n\n- ❌红色为绝对不要更改；\n\n- 🔗灰色为其他默认链接框架。\n\n---\n\n放大模型加载器可根据需求选择，有部分不能兼容使用，请自行尝试。\n\n图像缩放的目的主要是初次放大之后对细节进行分辨率缩放，再经过SeedVR2进行细节上的智能修复。\n\n最短边这里输入需要的数值即可，该数值与最终成图的分辨率可能会有二位数的容差，这是比例规正，属于正常情况。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "工作流概览", "mode": 0, "bgcolor": "#535", "size": [394.2075500488281, 393.58001708984375], "pos": [-491.92413330078125, -63.26640701293945], "id": 18, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 5}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [717.0613692800696, 1665.9073231802847], "scale": 0.4736244074476716}}, "groups": [{"color": "#3f789e", "font_size": 80, "flags": {}, "id": 1, "title": "SeedVR2 V2 + 放大模型  —— 和风整理", "bounding": [-9.688210487365723, 84.8060073852539, 2518.21728515625, 608.8366088867188]}, {"color": "#b58b2a", "font_size": 125, "flags": {}, "id": 2, "title": "和风友情提示", "bounding": [856.3322143554688, -473.48211669921875, 768.6943969726562, 174