5, 117.55081939697266], "pos": [-967.0240478515625, 545.43505859375], "id": 109, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"mode": 0, "outputs": [{"name": "prompt", "links": [301], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [860.3366088867188, 273.0297546386719], "pos": [-1101.43896484375, 190.47280883789062], "widgets_values": ["2x2 网格，分屏，4 个面板之间有明显的白色边框，拼贴画，四联画。\n\n[角色来源：严格基于上传的参考图片。[所有分镜中均为同一角色]，超写实风格。\n\n\n\n全局光照设置：窄光束聚光灯，仅聚焦于面部中心，光线边缘锐利，阴影衰减明显，背景漆黑。身体和黑色衣物完全融入黑暗之中。\n\n\n\n第 1 格（左上）：正面视角，手轻轻抬到唇边，害羞犹豫的姿态，聚光灯直接照射在脸上，清晰的五官显露出神秘的气氛。\n\n\n\n第 2 格（右上）：3/4 角度视图，看向镜头，聚光灯照射在脸上，营造出强烈的对比效果，眼睛明亮而锐利，背景空白。\n\n\n\n第 3 格（左下角）：特写镜头，重点聚焦于眼睛，光束完美地照亮了 T 区和眼睛，头部其余部分逐渐变成黑色，细节清晰。\n\n\n\n第 4 格（右下角）：低角度拍摄，姿态优雅，脸部被明亮的聚光灯完全照亮，低头带着神秘的表情，脖子和肩膀在阴影中几乎看不见。\n\n\n\n整体色调：暗沉、忧郁、戏剧化、高对比度、8K 分辨率、原始照片纹理、明暗对比。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 112, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [296, 300], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [270, 314.0000305175781], "pos": [-156.6160430908203, 201.1985321044922], "widgets_values": ["c2c081a76a38fcbc481c9043c90ed46939ceecd0f24caaed946c5ed4b421f9ed.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 181, "type": "LoadImage", "properties