e4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 41, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "type": "RH_Nano_Banana2_Image2Image", "mode": 0, "bgcolor": "#d6be1f", "size": [400.85675048828125, 1052.86474609375], "pos": [120.41734313964844, 30.266704559326172], "id": 2, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 16}, {"outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#ead233", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 2, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#d6be1f", "size": [792.9876098632812, 1051.455322265625], "pos": [530.44775390625, 32.492332458496094], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 18}, {"outputs": [{"name": "text", "links": [45], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["1. 核心指令权重 (Priority Logic)\n\n你必须严格执行以下权重分配，任何冲突均以此为准：\n\n第一优先级（谁）： Image1 (面部 ID)。\n\n第二优先级（穿什么）： Image2 (全部服饰与配饰)。\n\n第三优先级（在哪里，什么姿势）： Image3 (空间构图与人体姿态，剔除小道具)。\n\n2. 万能合成公式 (Synthesis Formula)\n\n$$\\text{生成的图像} = \\text{Image1 (面部ID/样貌完全一致)} \\otimes \\text{Image2 (全部服饰/配饰完全一致)} \\otimes \\text{Image3 (纯净空间与姿态)}$$\n\n3. 输入参考深度识别规则 (Internal Processing)\n\n🔴 【强制】人物样貌参考 (Image1)\n\n最高执行标准： 身份与样貌 完全一致。\n\n执行细节： 生成的人物必须被识别为与此图中的人是 同一个人。像素级捕获其面部生物特征（眼形、骨相、鼻唇结构）、核心发型（基础长度、颜色和质感）、妆容和表情神态。在生成过程中，必须以 Image1 为唯一样貌模板，完全忽略其他参考图（尤其是 Image3）中的人物面部。\n\n🟢 【强制】服饰配饰参考 (Image2)\n\n最高执行标准： 服饰单品 完全一致。\n\n执行细节： 必须 100% 提取并像素级还原图中的所有可穿戴单品，并其“穿”在拥有 Image1 面部的人物身上。\n\n服装： 所有上装（包括图案、材质）、下装（特定水洗色、扣子细节）。\n\n配饰： 首饰（手链的具体珠串数、手表款式）、帽子、墨镜。\n\n鞋包： 所有包袋（特定的老花图案、皮质肩带细节）和鞋子（特定款式、鞋带）。\n\n🔵 【严格】纯净构图参考 (Image3)\n\n最高执行标准： 全身姿势、表情与空间构图 完全一致。\n\n关键执行逻辑（忽略小物品）：\n\n姿势迁移： 严格克隆图中人物的全身姿势（站/坐姿、身体倾向、手脚位置，包括特定脚踝交叉角度）。让拥有 Image1 面孔的人摆出该姿势与同样的表情。\n\n空间构图： 还原该场景的大致空间结构、镜头角度、光影氛围以及大型搭建物品（如沙发、桌子本身）。\n\n剔除污染（重要）： 必须忽略图 2 中人物手中持有的任何特定道具（如红皮书）、家具表面的小件装饰品（如盆栽、香薰蜡烛、散落的书本等）。 最终场景应是一个摆放好大型家具（如沙发、桌子）的干净空间，没有任何会喧宾夺主的小型生活物品。\n\n4. 合理化整合逻辑 (Reasoning & Physics)\n\n消除长相冲突： 将 Image3（姿势图）的人体视为一个“无面部的人体模型（Mannequin）”，将 Image1 的面部贴合上去。\n\n干净道具共存：\n\n如果 Image2（服饰图）有包包（如托特包），应将其合理、像素级地安排在人物的身体上（例如，仍挂在右肩）。\n\n由于 Image3 中的书本已被剔除，生成的人物左手应根据姿势自然放松，或自然摆放，而不应拿着任何东西。\n\n物理细节保真： 确保服饰（来自 Image2）随着 Image3 的姿势呈现出自然的褶皱；配饰像素级保留在手腕上，并遵循重力规律。\n\n5. 图像风格 (Style)\n\n风格： 高清、逼真的写实摄影（Photorealistic）。\n\n构图： 像素级克隆 Image3 的全身或截取构图。\n\n场景： 摆放好大型家具（来自 Image3）的干净、无小件物品“污染”的现代化室内空间。\n\n光影： 还原 Image3场景的自然光照效果。\n\n\n仅输出中文格式的提示词部分，无需有其它多余的描述。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [222.5438690185547, 397.64923095703125], "pos": [-708.6690673828125, 226.45431518554688], "id": 26, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 8}, {"outputs": [{"name": "response", "links": [40, 41], "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#232", "widgets_values": ["gemini-3-flash-preview", "", "", 0.6, 642530814, "randomize"], "inputs": [{"shape": 7, "name": "image1", "link": 18, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 19, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 21, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "link": 45, "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 43, 