idget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "GetImageSize", "ttNbgOverride": {"bgcolor": "#353", "groupcolor": "#8A8", "color": "#232"}}, "order": 20}, {"outputs": [{"name": "prompt", "links": [216], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["老照片修复提高分辨率，补充细节，修复画面并上色。超高清，极致细节，高对比度，清晰的光影细节，保持画面色调不变，8K画质。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {"collapsed": false, "disabled": false}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#353", "size": [210, 155.7682342529297], "pos": [7621.37060546875, 6376.166015625], "id": 162, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#353", "groupcolor": "#8A8", "color": "#232"}}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["所需要的模型：\n一、model------flux2-klein-9B-true-v2-fp8mixed.safetensors\n二、clip---------qwein_3_8b_fp8mixed.safetensirs\n三、vae----------flux2-vae.safetensors\n四、lora----------flux2-klein9b-anything2real-v2.0极致真实的人像模型，消除了AI油腻感，更加真实自然。\n\n\n\n1、图片风格转换，日景转夜景转黄昏，雪景雨景，手绘水墨等等风格转换\n\n2、SU模型转效果图\n\n3.材质替换\n\n4、毛坯房/su白模填家具-保证这个房间的大结构不变，生成室内设计，自然原木风（有机现代）：侧重温馨与触感\n提示词： 一个温暖舒适的日式北欧混搭风格（Japandi）客厅。空间中大量使用了天然材质，有一张造型圆润的米色羊羔绒沙发和质感粗糙的手工编织地毯。背景墙采用了温润的胡桃木格栅板装饰，角落里摆放着一棵高大的室内绿植（如橄榄树或琴叶榕）增添生机。整体色调是奶油色和大地色的结合，给人一种极度放松和疗愈的感觉。\n\n5、平面图上色/变3D-将这张图变成3D渲染风格，保持空间结构和家具位置不变。客厅和餐厅采用灰色瓷砖，卧室采用浅色木地板。整体和谐而现代。家具的配色是现代的浅色调。厨房设有大理石台面，散发出奢华感，增强了投影和摄影的感觉。\n\n6、线稿转效果图，室内室外，线稿上色\n\n7、老照片修复提高分辨率，补充细节，修复画面并上色。超高清，极致细节，高对比度，清晰的光影细节，保持画面色调不变，8K画质。"], "inputs": [], "flags": {"disabled": false}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [389.536376953125, 517.2791137695312], "pos": [5730.58935546875, 5989.1533203125], "id": 105, "proper