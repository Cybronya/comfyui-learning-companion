4375], "widgets_values": ["基于 Nano Banana Pro 模型生成：\n\n为[上传参考图]的包装创建一份专业的工业包装设计插图板。\n\n在中央展示一张带有真实材质、柔和工作室灯光和商业级成品质感的3D渲染主图。\n\n围绕主图提供技术视图：正面、侧面、顶部、底部、斜角透视和平面展开图（确保所有视图标签均为中文）。\n\n包含结构构造草图、折痕线、接缝细节以及带毫米标注的尺寸箭头（尺寸单位及相关说明均使用中文）。\n\n用中文手写风格注释展示材料和表面处理（哑光、光面印刷、塑料、纸张、玻璃等）。\n\n添加色板（色板标签为中文）、真实产品插图和柔和阴影。\n\n背景应类似干净的素描纸，将真实渲染与铅笔草图叠加相结合。\n\n现代工业设计美学、超高细节、可直接放入作品集展示。\n\n重要提示：图像中的所有文字内容、标签和注释必须全部为标准简体中文。\n\nStable Diffusion 设置：\n\nCFG：7–9\n\n采样步数：30–40\n\n采样器：DPM++\n\n分辨率：1024×1280 或更高\n\n宽高比：3:4"], "inputs": [{"shape": 7, "name": "passthrough", "label": "passthrough", "type": "STRING", "localized_name": "passthrough"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 4, "type": "Textbox", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Textbox"}, "order": 1}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [1225.1268293592666, 162.99419487847217], "scale": 0.45}}, "groups": [], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 1, 0, 3, 0, "IMAGE"], [3, 4, 0, 1, 10, "STRING"]], "id": "a9e6f560-25e0-43f2-90d3-6c38a6983bb7", "config": {}, "version": 0.4, "last_node_id": 4, "revision": 0}