": "LATENT", "localized_name": "LATENT"}], "color": "#49324f", "widgets_values": [20260921, "fixed", 14, 1, "euler", "simple", 0.18], "inputs": [{"name": "model", "link": 13, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent_image", "link": 16, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "type": "KSampler", "mode": 2, "bgcolor": "#18232e", "size": [355, 315], "pos": [846.8648681640625, 1427.0029296875], "id": 12, "properties": {"cnr_id": "comfy-core", "ver": "6bfaacc67c2103481e5f0c84d75257cd0581d86a", "widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 18}, {"outputs": [{"name": "IMAGE", "slot_index": 0, "links": [19], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "color": "#49324f", "widgets_values": [1024, 128, 64, 8], "inputs": [{"name": "samples", "link": 17, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 18, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "tile_size"}, "name": "tile_size", "label": "tile_size", "type": "INT", "localized_name": "tile_size"}, {"widget": {"name": "overlap"}, "name": "overlap", "label": "overlap", "type": "INT", "localized_name": "overlap"}, {"widget": {"name": "temporal_size"}, "name": "temporal_size", "label": "temporal_size", "type": "INT", "localized_name": "temporal_size"}, {"widget": {"name": "temporal_overlap"}, "name": "temporal_overlap", "label": "temporal_overlap", "type": "INT", "localized_name": "temporal_overlap"}], "flags": {}, "type": "VAEDecodeTiled", "mode": 2, "bgcolor": "#18232e", "size": [330, 215], "pos": [1261.86474609375, 1427.0029296875], "id": 13, "properties": {"cnr_id": "comfy-core", "ver": "6bfaacc67c2103481e5f0c84d75257cd0581d86a", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecodeTiled"}, "order": 19}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#49324f", "widgets_values": ["Studio_Qwen21/Refined_1p5x"], "inputs": [{"name": "images", "link": 19, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "type": "SaveImage", "mode": 2, "bgcolor": "#18232e", "size": [455, 405], "pos": [1656.8642578125, 1427.0029296875], "id": 14, "properties": {"cnr_id": "comfy-core", "ver": "6bfaacc67c2103481e5f0c84d75257cd0581d86a", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 20}, {"outputs": [], "color": "#443e2a", "widgets_values": ["使用入口｜首次导入先看这里\n\nQwen-Image-2.1｜高质感文生图工作流 v1.1\n面向 RunningHub 的标准 ComfyUI 0.4 画布 JSON。\n\n1. 在 RunningHub 的 ComfyUI 工作流编辑器中导入本 JSON。\n2. 节点01/02/03选择平台实际提供的对应2.1模型；同一文件在平台上的名称可能带目录或编号，以实际下拉框为准。\n3. 节点05改提示词，节点06改尺寸，节点07改seed；点击运行。\n4. 默认只生成并保存节点09的原生2048×2048 PNG。\n\n本次修复：已删除平台缺失的缓存控制节点，UNETLoader直接连接两个KSampler的model输入；全部节点使用原生默认名称。节点编号保留，说明中的编号对应节点ID。\n\n默认：BF16主模型 + BF16文本编码器 + 2.1专用VAE；40步，CFG=1，Euler/simple，batch=1。seed设为fixed，便于比较参数；要连续生成新构图，将control_after_generate改为randomize。\n\n核实日期：2026-09-20。依据Qwen正式发布仓库、Comfy-Org权重及官方示例制作。已做结构与接口静态校验，未在你的RunningHub实例实测，未进行GPU出图。平台需要同步含2.1支持的ComfyUI与模型文件，JSON不含模型权重。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [735, 485], "pos": [60, -380], "id": 20, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 3}, {"outputs": [], "color": "#443e2a", "widgets_values": ["参数说明｜保持2.1的正确采样路径\n\nCFG默认1.0：按照官方2.1文生图路径，此时负面提示词不参与CFG计算，因此负面框留空。希望约束的画面效果请用自然语言写进正面提示词。\n\n40步用于正式质量起点；25步可用于预览。画面质量取决于提示词、seed与模型，增加步数不保证更好。\n\n节点05的resolution仅控制参考图及其辅助latent，本工作流未接参考图，文生图的实际尺寸由节点06决定。\n\n已移除独立缓存控制节点。UNETLoader（节点01）的MODEL直接连接主KSampler（节点07）和可选KSampler（节点12）。缓存采用模型自身默认行为，无需安装报错的缓存节点。\n\n本工作流不加载额外LoRA、不接外部API。材质由提示词和模型生成，不通过强锐化堆出颗粒。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [460, 445], "pos": [60, 850], "id": 22, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 4}, {"outputs": [], "color": "#443e2a", "widgets_values": ["画幅与显存｜尺寸建议\n\n默认原生2K：2048×2048，约4.19MP。\n精确3:4：1728×2304；精确4:3：2304×1728。\n接近16:9：2752×1536；接近9:16：1536×2752。\n原生文生图宽高建议32的倍数。若启用1.5倍重绘，基础宽高选64的倍数，使放大后仍为32的倍数。\n\nBF16建议优先使用RunningHub提供的较大显存实例；未测显存峰值，不承诺特定显存可跑。显存不足先关闭可选分支、batch保持1，再将尺寸降至1024×1024做连通测试，或选择官方量化权重。\n若仅在节点08解码时显存不足，可换为原生VAEDecodeTiled，tile_size=1024、overlap=128。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [650, 325], "pos": [555, 970], "id": 23, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 5}, {"outputs": [], "color": "#443e2a", "widgets_values": ["可选分支｜开启后才会执行\n\n下方节点10–14默认全部静音（mode=Never），不会增加默认出图耗时。\n开启方法：选择节点10、11、12、13、14，将它们全部设为Always/始终执行（取消静音）；保持主采样节点07的seed为fixed。\n\n流程：原图 → Lanczos预放大1.5倍 → VAE编码 → 同模型低降噪重绘 → 分块解码 → 保存。默认2048×2048会输出3072×3072，并保留节点09原图供比较。\n\n节点12：14步，CFG=1，denoise=0.18。可试0.12–0.22，这是本工作流的实验性细化起点，并非官方最佳值或已实测提升。图像身份、文字、小图案可能改变，开启后需与原图对比。只改节点10做插值放大并不会产生真实新细节。\n该分支会显著增加计算与显存；分块VAE不能解决采样阶段的显存不足。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [830, 325], "pos": [1265, 970], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 6}, {"outputs": [], "color": "#443e2a", "widgets_values": ["提示词备选｜替换节点05完整正面提示词\n\n摄影质感提示词结构：主体与动作 → 材质 → 空间层次 → 主光/补光方向 → 构图 → 色彩 → 景深与细节。\n\n【人物肖像】\n一位30岁左右的亚洲女性，身穿剪裁利落的深灰色羊毛西装与米白色衬衫，半身肖像，身体自然侧转，眼神看向画面左侧，人物位于右侧三分之一处。背景为现代建筑室内，米灰色墙面与暗色门框形成前后层次。左侧窗户柔光照亮脸部，右侧轻微补光，眼睛清楚有自然高光。皮肤保留真实毛孔、细小绒毛与自然肤色变化，衣料纤维细腻，发丝边缘清楚。85mm人像摄影，浅而适度的景深，主体面部清楚，色彩自然，亮部柔和，暗部保留层次，成熟杂志编辑摄影质感，完整不透明背景，无文字、水印、过度磨皮或锐化白边。\n\n【室内空间】\n现代精品酒店的阅读休息区，胡桃木书架、深橄榄绿皮革单椅、亚麻窗帘与米色石灰岩地面形成丰富材质层次，座椅偏右，左侧长窗引入柔和午后日光。近处桌角、中景座椅、远处书架依次展开，空间透视准确，垂直线笔直。皮革、木纹、织物和石材各自呈现真实表面与接触阴影。建筑杂志摄影，35mm视角，自然白平衡，克制对比，暗部细节完整，清楚自然，无人物、文字、水印，画面完整且背景不透明。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [990, 460], "pos": [60, 1950], "id": 25, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 7}, {"outputs": [], "color": "#443e2a", "widgets_values": ["来源与运行问题｜保留便于排查\n\n官方模型说明：\nhttps://github.com/QwenLM/Qwen-Image-2.1\n官方ComfyUI文生图示例：\nhttps://github.com/Comfy-Org/workflow_templates/blob/main/templates/image_qwen_image_2_1_t2i.json\n原生节点支持：\nhttps://github.com/Comfy-Org/ComfyUI/pull/16400\n\n导入出现TextEncodeQwenImage21红色缺失节点：平台的ComfyUI核心尚未同步2.1支持，需要平台更新；不要随意安装同名第三方节点替代。\n模型名称not in list：重新在01/02/03下拉框选择同一模型的实际平台条目；没有对应条目时需先由平台上架或导入对应权重。\n维度、通道或加载错误：先核对三个文件均对应2.1，尤其新64通道VAE和Qwen3-VL 8B编码器。\n\n文件提供普通画布JSON，不包含RunningHub workflowId、密钥或API提交凭据。若要走RunningHub API，请先在自己的工作台保存并运行成功，再使用平台导出的API格式。\n\n模型许可证为Qwen Research License。官方条款第2条要求商业使用另行取得许可；商业摄影“风格”不代表已授予商用许可。许可原文：\nhttps://github.com/QwenLM/Qwen-Image-2.1/blob/main/LICENSE"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [985, 460], "pos": [1110, 1950], "id": 26, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 8}, {"outputs": [], "color": "#443e2a", "widgets_values": ["模型清单｜三个文件必须匹配\n\n节点01 / diffusion_models：\nqwen_image_2.1_bf16.safetensors\n\n节点02 / text_encoders：\nqwen3vl_8b_bf16.safetensors\nCLIPLoader的type必须保留为 qwen_image。\n\n节点03 / vae：\nqwen_image_2.1_vae_bf16.safetensors\n\n官方ComfyUI权重：\nhttps://huggingface.co/Comfy-Org/Qwen-Image-2.1\n\n显存紧张时可选择官方量化文件：\n主模型 qwen_image_2.1_int8_convrot.safetensors\n文本编码器 qwen3vl_8b_int8_convrot.safetensors\n更省内存的文本编码器 qwen3vl_8b_w4a8.safetensors\n量化模型仍使用weight_dtype=default；VAE仍用2.1专用BF16。量化可能改变输出；必须平台已支持该量化格式。不要混用旧Qwen-Image/2512/2511的文本编码器、VAE或LoRA。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#18232e", "size": [735, 485], "pos": [855, -380], "id": 21, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 9}, {"outputs": [{"name": "CLIP", "slot_index": 0, "links": [22], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#243849", "widgets_values": ["qwen3vl_8b_bf16.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#18232e", "size": [420, 125], "pos": [60, 365], "id": 2, "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen3vl_8b_bf16.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_bf16.safetensors"}], "ver": "6bfaacc67c2103481e5f0c84d75257cd0581d86a", "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 10}, {"mode": 0, "outputs": [{"name": "positive", "links": [20], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "links": [21], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}, {"name": "latent", "links": [], "label": "latent", "type": "LATENT", "localized_name": "latent"}], "size": [460, 426], "pos": [700.0430297851562, 261.4191589355469], "widgets_values": ["一张高端香水品牌的商业摄影风格概念图，方形画幅。主角是一只厚壁透明玻璃香水瓶，瓶内是清透浅琥珀色液体，瓶盖为香槟金色拉丝金属，瓶身无文字、无标志。香水瓶放在画面右侧三分之一处，瓶身完整、垂直，瓶口与瓶底几何结构准确，约占画面高度的一半。\n\n场景由前后错落的暖灰色石灰岩台座、深橄榄绿色弧形背景和一块自然垂落的深棕色丝绸组成。左下前景放置一小段佛手柑果皮和两片深绿色叶子，叶片不遮挡瓶身。以斜向台座和背景弧线形成有层次的不对称构图，画面饱满但主次清楚，背景与主体有明确距离。\n\n左上方大型柔光箱作为主光，右后方窄条柔光勾勒玻璃轮廓，柔和补光保留阴影中的细节。玻璃有可信的厚度、折射、透光和有控制的高光，液体清透，金属拉丝细密自然，丝绸高光沿褶皱连续变化，石材保留细微自然孔隙。各物体的接触阴影和反射方向一致。\n\n采用中画幅商业静物摄影的视觉语言，85mm镜头视角，适度景深，香水瓶整体清楚，前后景自然分离。颜色准确克制，暖琥珀与冷绿色形成细腻对比，高光柔和过渡，暗部通透，微小细节干净真实，边缘清晰而没有锐化白边。成片是一张完整、不透明背景的摄影画面，呈现自然的真实材质与精细的棚拍布光。画面只包含所描述的物体，不出现文字、商标、水印或拼贴边框。", "", 1024], "inputs": [{"name": "clip", "link": 22, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "images.image_1", "link": 25, "label": "参考图 1 (Image-1)", "type": "IMAGE", "localized_name": "参考图 1 (Image-1)"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "negative_prompt"}, "name": "negative_prompt", "label": "negative_prompt", "type": "STRING", "localized_name": "negative_prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "INT", "localized_name": "resolution"}, {"shape": 7, "name": "images.image_6", "label": "参考图 2 (Image-2)", "type": "IMAGE", "localized_name": "参考图 2 (Image-2)"}, {"shape": 7, "name": "images.image_7", "label": "参考图 3 (Image-3)", "type": "IMAGE", "localized_name": "参考图 3 (Image-3)"}, {"shape": 7, "name": "images.image_8", 