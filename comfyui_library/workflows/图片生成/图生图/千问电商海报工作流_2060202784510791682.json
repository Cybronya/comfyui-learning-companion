e10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 39, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartImageG2OfficialImageToImage", "mode": 0, "bgcolor": "#653", "size": [400, 432], "pos": [2709.822998046875, 347.1657409667969], "id": 31, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2OfficialImageToImage"}, "order": 15}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [428.09478759765625, 505.9665832519531], "pos": [746.600341796875, 620.937255859375], "widgets_values": ["### 电商主图设计方案\n\n#### 1. **产品定位与品牌调性**\n   - **产品类型**：高端运动鞋\n   - **品牌调性**：融合传统东方美学与现代科技感，展现文化自信与时尚潮流。\n   - **目标受众**：追求独特设计、注重文化内涵的年轻消费者。\n\n#### 2. **主图构图与视觉元素**\n   - **构图**：\n     - **中心位置**：放置鞋子，确保其成为画面的焦点。\n     - **背景**：采用纯白色背景，突出鞋子的设计细节，避免干扰。\n   - **视觉元素**：\n     - **鞋子特写**：展示鞋子的正面，清晰展示整体设计和细节。\n     - **局部放大**：对鞋面的山水画图案进行局部放大，突出其精细工艺。\n     - **配饰点缀**：展示鞋带上的中国结装饰，增加文化元素。\n     - **细节展示**：展示鞋底的竹节纹理和山景雕刻，体现材质与工艺的精致。\n\n#### 3. **色彩搭配与风格**\n   - **主色调**：黑白灰为主，营造经典与现代感。\n   - **辅助色**：少量金色点缀，提升奢华感。\n   - **风格**：简约而不失细节，强调设计感与文化内涵。\n\n#### 4. **文案与标签**\n   - **文案**：\n     - “融合东方美学与现代科技，打造独特文化符号。”\n     - “高端运动鞋，彰显个性与品味。”\n   - **标签**：\n     - #高端运动鞋\n     - #东方美学\n     - #文化自信\n     - #时尚潮流\n\n#### 5. **拍摄与后期处理**\n   - **拍摄**：\n     - 使用专业摄影设备，确保细节清晰可见。\n     - 控制光线，避免反光和阴影影响。\n   - **后期处理**：\n     - 调整对比度和饱和度，增强视觉冲击力。\n     - 去除噪点，保持图片纯净。\n     - 添加适量的阴影或高光，增强立体感。\n\n#### 6. **多角度展示**\n   - **正面**：展示整体设计。\n   - **侧面**：展示侧面轮廓和细节。\n   - **背面**：展示鞋带和后跟设计。\n   - **局部特写**：展示鞋面图案、鞋底纹理"], "inputs": [{"name": "text", "link": 17, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 12, "type": "QWEN_TextDisplay", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "QWEN_TextDisplay"}, "order": 9}, {"mode": 0, "outputs": [{"name": "STRING", "links": [39], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [457.9526672363281, 252.433349609375], "pos": [2685.3759765625, 842.9191284179688], "widgets_values": ["图1中的产品换成图2中的产品，并修改海报中不合理的地方，使产品和海报相融，优化光影和透视效果，海报构图时，始终考虑产品的最佳可视角度和最大可视角度，文案要匹配产品，海报中全部是中文"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 15, "type": "JWStringMultiline", "title": "指令调整", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JWStringMultiline"}, "order": 1}, {"mode": 0, "outputs": [{"name": "MODEL_0", "links": [44], "type": "MODEL"}, {"name": "CLIP_1", "links": [45], "type": "CLIP"}, {"name": "VAE_2", "links": [46], "type": "VAE"}, {"name": "VAE_3", "links": [47], "type": "VAE"}], "size": [270, 118], "pos": [1249.24462890625, 650.959228515625], "widgets_values": [""], "inputs": [{"widget": {"name": "pwd"}, "name": "pwd", "label": "pwd", "type": "STRING", "localized_name": "pwd"}], "flags": {}, "id": 33, "type": "RHHiddenNodes", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHHiddenNodes", "info": "", "ref_info": "Z0FBQUFBQnFHNktEN29Jc2RTU2F5ZXhZR0hYenpTZFdic3VxemtLU1dIVTlJMUY2cVQwTnQ3T1FxaVdVS1pQcU5ROGF0Xzc0QUc5QzV3Z