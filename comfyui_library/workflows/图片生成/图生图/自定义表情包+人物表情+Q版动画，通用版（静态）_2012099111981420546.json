ocalized_name": "show_help"}], "color": "#323", "widgets_values": ["请基于您提供的参考图像，生成一个以“马年快乐”为主题的人物写实风格表情包。并设计成9宫格表情包，每张图都要人物要与原图保持一致，不能出现变形、换衣或其他不好的元素出现。背景为金黄色，并配有红色的中国新年主题边框和装饰，如金元宝、红灯笼或金色叶子等。画面比例：1:1，以下是9宫格表情包的设计方案：\n1. 左上角：人物笑容灿烂，双手捧着脸颊。\n2. 上中：人物双手持一个红色中国新年红包，上面镶有金色“福”字，面带微笑。\n3. 右上角：人物双手持一个红色横，幅上面镶有金色“一马当先”字，面带微笑。\n4. 左中：人物手持一盏带有金色图案的红灯笼，面带微笑。\n5. 中间：人物左手持一条带有金色汉字“新年快乐”的红色横幅，右手手持一条带有金色汉字“马年大吉”的红色横幅，面带微笑。\n6. 右中：人物表情惊讶，双手捧着脸颊。\n7. 左下角：她正在大笑，双手捧着一个金元宝。\n8. 下中：她神情若有所思，双手托着脸颊。\n9. 右下角：她温柔微笑，双手捧着一匹骏马饰品，头顶带有金色汉字“马上成功”。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#535", "size": [340.9044494628906, 229.41079711914062], "pos": [-322.5841369628906, 399.6077575683594], "id": 10, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 1}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [1787.6874677870007, 293.464621649848], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Group", "bounding": [-492.4342346191406, -71.89839935302734, 1713.1895751953125, 735.2924194335938]}], "links": [[4, 1, 0, 5, 0, "IMAGE"], [10, 10, 0, 1, 10, "STRING"], [56, 34, 0, 1, 0, "IMAGE"]], "id": "c5ef8914-d613-4260-8e94-178b59a7628c", "config": {}, "version": 0.4, "last_node_id": 34, "revision": 0}