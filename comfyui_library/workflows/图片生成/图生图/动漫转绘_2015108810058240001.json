ui_layerstyle", "ver": "89014d833d2ad0998d724090eff1456692692a1d", "ue_properties": {"widget_ue_connectable": {"fit": true, "aspect_ratio": true, "method": true, "background_color": true, "round_to_multiple": true, "scale_to_side": true, "proportional_height": true, "proportional_width": true, "scale_to_length": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"fit": true, "aspect_ratio": true, "method": true, "background_color": true, "round_to_multiple": true, "scale_to_side": true, "proportional_height": true, "proportional_width": true, "scale_to_length": true}, "Node name for S&R": "LayerUtility: ImageScaleByAspectRatio V2"}, "order": 7}, {"mode": 0, "outputs": [{"name": "output", "links": [54], "type": "*", "localized_name": "output"}], "size": [323.5193176269531, 363.92364501953125], "pos": [2512.02294921875, 3193.4501953125], "widgets_values": ["银发少女侧卧于幽暗洞穴，发丝如雪，耳畔生有尖锐狐耳，耳尖泛橙红，耳垂缀银环，眼神清澈如水，唇色淡粉，面庞柔和，眉眼间透出沉静与神秘。她身着无袖战衣，肩部与袖口饰以蓬松白毛，衣料纹理细腻，暗纹如古篆，内衬红布隐约可见。右臂缠绕银纹护甲，指节处有微光闪烁，似符文流转。左臂覆蓝纹织锦，布面绣有云纹与星芒，与衣袍形成冷暖对比。\n\n前景聚焦于少女面部与肩部，构图采用近景特写，镜头略低，突出其柔美与威严并存的气质。背景为深蓝洞穴，岩壁嶙峋，隐约可见冰晶与水光，远处有微光闪烁如幽蓝萤火，营造出神秘的地下世界氛围。洞穴深处有模糊的石柱与藤蔓，增添荒古感。\n\n视觉引导从少女的右眼开始，视线自然延伸至左耳与肩部毛领，再向背景的幽光汇聚，形成柔和的引导线。光影以冷蓝为主调，面部受光柔和，高光落在眉骨与鼻梁，眼窝与发丝处形成深邃阴影，增强立体感。肩部与护甲处有微弱暖光反射，与冷色调形成微妙对比，凸显材质质感。\n\n整体氛围静谧而神秘，似在洞穴深处沉思或等待，既有东方古风的玄妙，又带奇幻色彩。光影细腻，材质真实，细节丰富，如毛发的每一根丝线、护甲的金属光泽、织锦的纹理都清晰可见，画面具有电影级质感，仿佛出自高精度渲染引擎，但又保留自然的微瑕感，如轻微尘埃与光斑，赋予其日常拍摄般的亲切感。画面不追求夸张，而是以细腻与真实打动人心，营造出一种“静谧中的力量”与“神秘中的温柔”的双重氛围。"], "inputs": [{"shape": 7, "name": "anything", "link": 52, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"pinned": true}, "id": 44, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 13}, {"mode": 0, "outputs": [{"name": "STRING