ODEL", "links": [80], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [324.9442138671875, 96.51356506347656], "pos": [-786.5328979492188, -754.33935546875], "widgets_values": ["芸芸V8 z-image trubol.safetensors", 0.8], "inputs": [{"name": "model", "link": 76, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 39, "type": "LoraLoaderModelOnly", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 12}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [100], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [324.9442138671875, 96.51356506347656], "pos": [-408.9800720214844, -758.1201171875], "widgets_values": ["芸芸V8 z-image BASE_copy_000008000.safetensors", 0.8], "inputs": [{"name": "model", "link": 99, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "id": 57, "type": "LoraLoaderModelOnly", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 11}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [76], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [321.7297058105469, 82], "pos": [-789.75048828125, -876.6741333007812], "widgets_values": ["Z-Image-Turbo_fp16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "UNET名称"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 16, "type": "UNETLoader", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 8}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [55, 62], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["\n一位年轻女性以充满活力与节日喜悦的姿态出现在画面中央——她拥有乌黑如墨般顺滑且略带光泽感的长直发，自然垂落在肩头并随动作微微飘动；齐刘海修饰出精致小巧的脸庞，一双清澈明亮的大眼睛闪烁着温暖笑意，眼线细致勾勒增强神采，唇色是柔和粉嫩的蜜桃红，在微笑中显露出洁白整齐的牙齿。她的皮肤白皙透亮，仿佛被柔光精心雕琢过，呈现出健康细腻的质感。\n\n身着一件厚实柔软的红色高领针织毛衣，采用经典的绞花编织工艺，纹路立体清晰可见，每一根纱线都透露出冬日暖意；下摆搭配一条轻盈蓬松的小白裙，蕾丝边沿在光影交错间若隐若现，形成鲜明色彩对比，并增添一丝少女般的甜美气息。她伸出右手向前方伸展手掌，指尖微张似要拥抱镜头或传递祝福，手部肌肤呈现自然温润色泽，指节分明而富有弹性。\n\n整个场景设置于一面鲜红色背景墙前，墙面占据构图大部分空间，其上用浓重泼洒式书法笔触书写“恭喜发财”四个大字，字体苍劲有力却不失喜庆韵味；在这组汉字之间巧妙嵌入黄色粗体英文“HAPPY NEW YEAR”，字母边缘带有轻微做旧磨砂效果，赋予现代时尚感。右侧则是一道简洁干净的纯白色垂直分割线条，强化视觉层次与平衡结构。\n\n光源来自正面偏左上方位置，使用柔化散射灯效营造均匀无硬影的效果：照亮人物面部轮廓的同时让头发泛起微妙反光，使衣物织物细节更加突出，尤其是毛衣表面因纤维走向形成的细微凹凸肌理跃然眼前；同时产生极淡却不明显的投影区域，主要集中在右臂下方及身体侧后方，进一步塑造三维立体体积而不破坏明快基调。\n\n色调统一热烈又和谐——大面积饱和度高的朱红色主导情绪渲染，辅之以纯净白衣制造清新呼吸点，再点缀金黄文字带来奢华庆典气氛。整幅画作笼罩一层梦幻氤氲的胶片滤镜质感，模拟专业摄影棚内高端布景下的理想成像环境，兼具商业广告级锐利对焦与电影美学的情感共鸣力。\n\n最终所构建的整体氛围是一种欢快奔放的新年贺岁仪式感：既有传统东方吉祥符号的文化底蕴支撑，亦融合当代流行审美表达方式，通过服饰选择、肢体语言乃至灯光布局共同构筑了一个既亲切可亲又能引发强烈情感共振的理想化新年庆祝时刻。观众不仅看到美丽的形象本身，更感受到那份源自心底深处对于未来一年美好期许的真诚祝愿。"], "inputs": [{"name": "clip", "link": 43, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 103, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [470.09521484375, 704.8836059570312], "pos": [-94.89161682128906, -305.65875244140625], "id": 6, "properties": {"ue_properties": {"widget_ue_connectable": {}