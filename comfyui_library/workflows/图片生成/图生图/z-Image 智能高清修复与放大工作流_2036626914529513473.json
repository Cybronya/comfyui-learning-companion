_width"}, "name": "proportional_width", "type": "INT", "localized_name": "比例宽"}, {"widget": {"name": "proportional_height"}, "name": "proportional_height", "type": "INT", "localized_name": "比例高"}, {"widget": {"name": "fit"}, "name": "fit", "type": "COMBO", "localized_name": "缩放模式"}, {"widget": {"name": "method"}, "name": "method", "type": "COMBO", "localized_name": "采样方法"}, {"widget": {"name": "round_to_multiple"}, "name": "round_to_multiple", "type": "COMBO", "localized_name": "倍数取整"}, {"widget": {"name": "scale_to_side"}, "name": "scale_to_side", "type": "COMBO", "localized_name": "缩放到边"}, {"widget": {"name": "scale_to_length"}, "name": "scale_to_length", "type": "INT", "localized_name": "缩放到长度"}, {"widget": {"name": "background_color"}, "name": "background_color", "type": "STRING", "localized_name": "background_color"}], "flags": {}, "id": 106, "type": "LayerUtility: ImageScaleByAspectRatio V2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: ImageScaleByAspectRatio V2"}, "order": 10}, {"mode": 0, "outputs": [{"name": "STRING", "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [402.14520263671875, 357.075439453125], "pos": [-437.5035705566406, -158.63113403320312], "widgets_values": ["['【专业摄影提示词描述】\\n\\n画面主体：一位气质出众的欧洲女性模特，拥有典型的欧洲人面部轮廓——高挺鼻梁、深邃眼眸、精致的五官，棕色中长发自然垂落肩头，妆容干净利落，强调眼部与唇部的自然光泽，眼神直视镜头，流露出冷静而自信的神情。\\n\\n服装造型：她身着一件丝质浅青绿色缎面吊带长裙，裙摆垂坠感极佳，光泽柔润；外搭一件色彩斑斓的粗花呢针织开衫，以蓝紫色为主调，边缘饰有金绿色链条与几何刺绣，袖口与领口处点缀深色镶边，层次丰富；颈间佩戴多层叠戴的金色链条项链，镶嵌方形绿色宝石吊坠，耳环与手镯同款设计，整体造型融合了复古与现代的奢华感。\\n\\n拍摄环境：场景设定在一家复古风格的欧洲餐厅内，背景中可见深色木质墙面、红白格纹地板、铺有白色桌布的餐桌与红色陶瓷杯具，远处模糊可见其他顾客身影，营造出真实而私密的社交氛围。\\n\\n摄影参数与风格：\\n- 拍摄设备：使用单反相机 + 胶片感滤镜，模拟拍立得即时成像的颗粒质感，画面边缘略带晕染，保留胶片特有的柔光与噪点。\\n- 光线处理：采用闪光灯补光，主光来自模特正前方偏上，形成柔和的轮廓光，同时保留背景环境的自然暗调，营造“高光人物、低光环境”的戏剧性对比。\\n- 色彩调性：整体色调偏暖，青绿色服装与暖棕色背景形成冷暖对比，闪光灯强化了金属配饰与丝绸面料的高光反射，使画面富有立体感与电影感。\\n- 构图与氛围：模特坐姿自然放松，身体略微侧转，目光直视镜头，构图居中偏右，背景虚化处理突出主体，营造“时尚大片+生活场景”的叙事张力，传达出优雅、从容、略带疏离的欧洲贵族气质。\\n\\n最终效果：画面如一幅复古时尚杂志封面，兼具胶片的温润质感与闪光灯的戏剧性高光，人物与环境和谐共存，充满故事感与高级审美。']"], "inputs": [{"name": "anything", "link": 174, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 108, "type": "ShowAnything|Mie", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowAnything|Mie"}, "order": 15}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [389.1878967285156, 456.7993469238281], "pos": [-1167.912353515625, 391.98968505859375], "widgets_values": [], "inputs": [{"name": "images", "link": 181, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 113, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 23}, {"mode": 0, "outputs": [{"name": "STRING", "links": [167, 174, 180], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [400, 348], "pos": [-899.9030151367188, -149.2076416015625], "widgets_values": ["你是专业摄影的提示词专家，详细地描述图片内容，描述任务的时候把人物描述成欧洲人，画面是用拍立得，胶片，单反等拍摄，要有闪光灯曝光感觉", "Huihui-Qwen3-VL-8B-Instruct-abliterated", "none", false, 0.7, 2048, 200704, 1003520, 1911, "randomize", "eager"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 168, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": 