1>的柔和正面冷色调影棚光逻辑：面部、肩部、手臂与腿部的明暗方向和阴影与<image1>一致，肤色色温匹配<image1>。背景保持<image1>的纯深青灰色背景完全不变。面部身份严格保持<image1>：脸型、眼形、鼻梁、唇形均取自<image1>，仅头部朝向与身体姿势改为与<image2>一致。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 508, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 17}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.53.6", "VHS_latentpreview": false, "ds": {"offset": [1436.3553525307668, -2046.9708669459299], "scale": 1.0152559799477205}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 38, "title": "Models", "bounding": [-678.7581176757812, 2352.13525390625, 530, 590]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 39, "title": "Image Size", "bounding": [-661.0130004882812, 2958.78173828125, 530, 250]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 40, "title": "Conditioning", "bounding": [-118.75809478759766, 2352.13525390625, 700, 860]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 41, "title": "Sampling", "bounding": [611.2418823242188, 2352.13525390625, 470, 860]}], "links": [[733, 481, 0, 483, 1, "VAE"], [734, 483, 0, 478, 0, "IMAGE"], [735, 484, 0, 483, 0, "LATENT"], [736, 485, 0, 484, 3, "LATENT"], [737, 482, 0, 485, 1, "LATENT"], [740, 487, 0, 484, 1, "CONDITIONING"], [741, 487, 1, 484, 2, "CONDITIONING"], [742, 487, 2, 485, 0, "LATENT"], [743, 13, 0, 482, 0, "INT"], [744, 13, 1, 482, 1, "INT"], [745, 480, 0, 487, 0, "CLIP"], [746, 476, 0, 487, 1, "IMAGE"], [747, 481, 0, 487, 2, "VAE"], [759, 497, 0, 498, 10, "STRING"], [760, 476, 0, 498, 0, "IMAGE"], [761, 477, 0, 498, 1, "IMAGE"], [762, 490, 0, 498, 2, "IMAGE"], [763, 491, 0, 498, 3, "IMAGE"], [764, 492, 0, 498, 4, "IMAGE"], [765, 493, 0,