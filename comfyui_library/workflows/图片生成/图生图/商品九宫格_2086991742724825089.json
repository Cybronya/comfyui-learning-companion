not_resize_image2"}, {"shape": 7, "name": "not_resize_image3", "label": "not_resize_image3", "type": "IMAGE", "localized_name": "not_resize_image3"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 2, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "target_size"}, "shape": 7, "name": "target_size", "label": "target_size", "type": "COMBO", "localized_name": "target_size"}, {"widget": {"name": "target_vl_size"}, "shape": 7, "name": "target_vl_size", "label": "target_vl_size", "type": "COMBO", "localized_name": "target_vl_size"}, {"widget": {"name": "upscale_method"}, "shape": 7, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": "crop_method"}, "shape": 7, "name": "crop_method", "label": "crop_method", "type": "COMBO", "localized_name": "crop_method"}, {"widget": {"name": "instruction"}, "shape": 7, "name": "instruction", "label": "instruction", "type": "STRING", "localized_name": "instruction"}], "flags": {}, "id": 1, "type": "TextEncodeQwenImageEditPlusAdvance_lrzjason", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEditPlusAdvance_lrzjason"}, "order": 14}, {"mode": 0, "outputs": [{"name": "text", "links": [22], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [425.1152038574219, 285.09014892578125], "pos": [1849.85498046875, 473.31494140625], "widgets_values": ["你是一位拥有 10 年以上经验的商业广告视觉导演与商品分镜设计师，专精于高端品牌广告（数码科技、美妆护肤、奢侈品、食品饮料等）的商业视觉叙事，熟悉现代商业广告分镜与微电影镜头语言体系。\n\n基于提供的商品参考图及描述（如无具体情节，请结合商品外观与质感自行拓展商业卖点与使用场景），生成商品广告分镜提示词。\n\n【输入方式】：参考图 + 商品/卖点描述（如无具体描述，请根据图片视觉特征自主扩写）  \n【延展目标】：基于上一张图的商品外观、材质质感、光影氛围与镜头语言，生成下一张商品分镜图，层层递进展现产品卖点，确保视觉与叙事连贯。\n\n### 核心控制原则\n* **商品极高一致性**：商品造型、结构、材质（金属/玻璃/磨砂/液体等）、Logo位置、配色与包装细节严密统一，无畸变变形。\n* **商业光影与质感**：光影色调与参考图高度统一（如高端布光、金属轮廓光、棚拍软光、自然晨光等），打造极致的商业摄影质感。\n* **场景与空间递进**：背景与环境元素自然衔接（如：产品微距特写 ➔ 使用场景融入 ➔ 动态效果呈现），无突兀跳跃。\n* **镜头语言与运镜**：\n  * **镜头类型**：微距特写 / 产品中景 / 场景全景 / 俯拍视角 / 环绕镜头 / 飞轨侧移 / 聚焦拉远\n  * **运镜节奏**：慢速推进 / 高速慢动作（如水花/烟雾/粒子）/ 旋转聚焦 / 动态快切\n* **动作与交互衔接**：人机交互动作（如按压、涂抹、拿起）、物理动态（如流体溅起、光效流动）须是上一镜头的自然推进。\n* **画面画质要求**：8K商业摄影级画质、真实物理材质反射、极致细节、透视准确、无噪点无变态拉伸无透视畸变，可直接作为下一张分镜生成的基础。\n\n### 输出要求\n输出时每一段文字均以 Next Scene; 开头，后面马上接提示词文本。每一段文字保持连续，禁止输出任何 Markdown 格式字符，没有任何多余的解释说明，每一段文字 100 字左右，直接输出内容。\n\n### 输出示例\nNext Scene;商业摄影微距特写镜头，慢速向前推进。高光棚拍环境，聚焦在黑色磨砂金属质感的无线耳机腔体上，细腻的金属纹理与镀金Logo清晰可见，背景柔和虚化。光线沿着耳机边缘滑动，呈现出高级的暗调金属轮廓光。\nNext Scene;特写镜头，旋转环绕运镜。顺接上一镜头，手指将耳机轻巧置入磁吸充电盒内，盒盖闭合瞬间，环形指示灯亮起柔和的极光蓝微光，微距捕捉到金属触点闭合与磁吸缝隙的精致光影变化，彰显极致工业设计感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 25, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}, {"mode": 0, "outputs": [{"name": "image", "links": [379, 380, 381], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 58], "pos": [1522.572265625, 263.0323181152344], "widgets_values": ["https://www.logosc.cn/uploads/articles/2024/01/16/AI%E8%AE%BE%E8%AE%A1%E5%B8%88-%E6%9E%81%E7%AE%80%E8%96%84%E8%8D%B7%E7%BB%BF%E5%B1%95%E5%8F%B0%E5%9C%BA%E6%99%AF-1705377934.jpeg"], "inputs": [{"widget": {"name": "url"}, "name": "url", "label": "url", "type": "STRING", "localized_name": "url"}], "flags": {}, "id": 31, "type": "YK_LoadImageFromURL", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "YK_LoadImageFromURL"}, "order": 5}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [382], "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [1072.67333984375, 1708.8572998046875], "pos": [3814.69677734375, 97.6613998413086], "widgets_values": [], "inputs": [{"name": "images", "link": 375, "label": "images", "type": "IMAGE", "loca