: "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 120, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"name": "qwen_image_edit_fp8_e4m3fn.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-Edit_ComfyUI/resolve/main/split_files/diffusion_models/qwen_image_edit_fp8_e4m3fn.safetensors"}], "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "UNETLoader", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 4}, {"mode": 0, "outputs": [{"name": "AI回复", "links": [1, 159], "label": "AI回复", "type": "STRING", "localized_name": "AI回复"}], "size": [400, 414], "pos": [599.6968383789062, -696.8349609375], "widgets_values": ["Qwen3-VL-8B-Instruct", "None (FP16)", "宝宝，太空", "为QwenImage和即梦等AI图像编辑工具生成高级写真风格婴儿图像编辑提示词（保留面部）\n\n角色设定：\n你是一位顶级的数字图像后期处理大师与摄影艺术总监，精通AI驱动的图像编辑技术。你能够精准理解用户意图，将现有婴儿图像转化为具有“高级摄影感”和“专业写真”风格的艺术作品，同时严格遵循面部保留原则。你深谙QwenImage和即梦等模型在图像编辑中的能力边界和最佳实践。\n\n核心任务目标：\n根据用户提供的少量关键词，并假定用户将上传一张婴儿原始图像，生成一套高度详尽、充满艺术感且能够直接用于AI图像编辑工具的高质量提示词。该提示词必须明确指示AI工具：严格保留原始图像中婴儿的面部特征和身份，仅修改面部以外的身体姿态（如需要）、服装、背景、光影、色彩、整体风格及添加特殊效果。\n\n行为约束与规则：\n\n强制性面部保留指令： 生成的提示词必须以明确的指令开头或包含在关键位置，强调“请严格保持原始图像中婴儿的面部特征和身份不变”。\n关键词深度解析与编辑方向：\n对用户提供的关键词进行深度解读，将其转化为图像编辑的具体指令，而非从零开始的创作。\n关键词应指导对背景、服装、身体姿态、光影、色彩、氛围和特殊效果的修改或替换。\n图像编辑元素详尽描述：\n主体（面部以外）： 描述婴儿面部以外的身体姿态（如需调整）、肤色（如需润饰）、发型（如需修改或添加）。例如，“婴儿的身体姿态调整为[描述]”，“皮肤白皙红润”。\n服装（创意替换）： 根据关键词和整体风格，创意性地设计并替换婴儿的现有服装。描述服装的材质、款式、颜色、细节和整体风格，确保与新场景协调。例如，“将婴儿服装替换为由[模型自由发挥]的精致定制服装”。\n环境/背景（创意替换）： 结合主题，创意性地构建并替换图像的现有背景。描述新背景的场景、元素、景深、纹理和氛围。例如，“将背景替换为[模型自由发挥]的精致摄影棚背景”。\n光影运用： 必须包含对光源方向、光线类型、光影效果的专业描述，以调整或添加到图像中，营造高级感。\n色彩与色调： 明确指定画面的整体色调，以及关键元素的色彩搭配，以重新渲染图像。\n构图与视角： 如果需要对构图进行微调或强调，可以描述，但要确保不与面部保留原则冲突。例如，“微调构图以突出婴儿主体”。\n纹理与材质： 描述新服装、新背景中关键元素的材质和纹理。\n氛围与情感： 明确传达编辑后图像应营造的氛围和情感。\n特殊效果： 包含对特殊视觉效果的描述，如景深模糊、光斑、颗粒感、烟雾、泡泡等，以添加到图像中。\n创意发挥与辅助元素： 在用户关键词的基础上，积极发挥创意，添加与主题相关且能提升画面美感的辅助元素和场景细节，这些元素应作为新增或替换的内容。\n语言风格： 使用专业摄影后期或艺术指导的语言，词汇丰富，描述精准，富有诗意和画面感。\n禁止重复和冗余： 避免在提示词中出现重复或意义重叠的词语，力求简洁而有效。\n输出格式： 直接输出一段完整的、连贯的、高质量的图像编辑提示词，无需任何前缀、解释或分隔符。\n输出格式要求：\n直接输出一个经过精心设计、准备用于AI图像编辑模型的完整提示词字符串。\n\n语气和风格：\n专业、艺术、富有想象力、精准、引导性强。", 0.7, 0.9, 2048, 0, "随机", false], "inputs": [{"shape": 7, "name": "🖼️ 图像1", "label": "🖼️ 图像1", "type": "IMAGE", "localized_name": "🖼️ 图像1"}, {"shape": 7, "name": "🖼️ 图像2", "label": "🖼️ 图像2", "type": "IMAGE", "localized_name": "🖼️ 图像2"}, {"shape": 7, "name": "🖼️ 图像3", "label": "🖼️ 图像3", "type": "IMAGE", "localized_name": "🖼️ 图像3"}, {"shape": 7, "name": "🖼️ 图像4", "label": "🖼️ 图像4", "type": "IMAGE", "localized_name": "🖼️ 图像4"}, {"widget": {"name": "🤖 模型选择"}, "name": "🤖 模型选择", "label": "🤖 模型选择", "type": "COMBO", "localized_name": "🤖 模型选择"}, {"widget": {"name": "⚙️ 量化级别"}, "name": "⚙️ 量化级别", "label": "⚙️ 量化级别", "type": "COMBO", "localized_name": "⚙️ 量化级别"}, {"widget": {"name": "💬 用户输入"}, "name": "💬 用户输入", "link": 155, "label": "💬 用户输入", "type": "STRING", "localized_name": "💬 用户输入"}, {"widget": {"name": "🎭 系统角色定义"}, "name": "🎭 系统角色定义", "label": "🎭 系统角色定义", "type": "STRING", "localized_name": "🎭 系统角色定义"}, {"widget": {"name": "🌡️ 温度"}, "name": "🌡️ 温度", "label": "🌡️ 温度", "type": "FLOAT", "localized_name": "🌡️ 温度"}, {"widget": {"name": "🎯 Top-P"}, "name": "🎯 Top-P", "label": "🎯 Top-P", "type": "FLOAT", "localized_name": "🎯 Top-P"}, {"widget": {"name": "📏 最大长度"}, "name": "📏 最大长度", "label": "📏 最大长度", "type": "INT", "localized_name": "📏 最大长度"}, {"widget": {"name": "🎲 随机种子"}, "name": "🎲 随机种子", "label": "🎲 随机种子", "type": "INT", "localized_name": "🎲 随机种子"}, {"widget": {"name": "🎮 种子控制"}, "name": "🎮 种子控制", "label": "🎮 种子控制", "type": "COMBO", "localized_name": "🎮 种子控制"}, {"widget": {"name": "🔄 保持模型加载"}, "name": "🔄 保持模型加载", "label": "🔄 保持模型加载", "type": "BOOLEAN", "localized_name": "🔄 保持模型加载"}, {"shape": 7, "name": "🎯 Qwen3VL额外选项", "label": "🎯 Qwen3VL额外选项", "type": "QWEN3VL_EXTRA_OPTIONS"