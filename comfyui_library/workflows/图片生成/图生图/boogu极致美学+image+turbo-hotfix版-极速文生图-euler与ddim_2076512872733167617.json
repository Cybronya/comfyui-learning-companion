 "source", "link": 259, "label": "source", "type": "*", "localized_name": "源"}], "flags": {}, "id": 156, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 12}, {"outputs": [{"name": "prompt", "links": [195], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#432", "widgets_values": ["“浅色简洁背景，居中构图，优雅韩国年轻女性，白皙皮肤，精致五官，黑色长卷发，自然垂落，柔和自然光线，白色吊带裙，高级质感，细腻肌肤光泽，浅灰色背景，简约美感，柔和光影，艺术风格肖像摄影，柔美优雅氛围。”\n**光影氛围**  \n柔和的自然光线勾勒出主体的面部轮廓和肌肤光泽，增加了画面的立体感和柔美感。光影的明暗变化恰到好处，面部和肩颈的光泽展现出一种细腻的质感，既不刺眼也不单调。光线在肩部的点状反光使画面多了一丝灵动性，为整体增添了真实感和氛围感。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#653", "size": [400, 200], "pos": [-1519.409423828125, 4834.29296875], "id": 111, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#fe3e3e", "size": [428.4745178222656, 116.95564270019531], "color": "#ff5252", "pos": [-1542.296875, 4398.65234375], "inputs": [], "flags": {}, "id": 158, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "01|02|03|04", "showNav": true, "toggleRestriction": "default"}, "order": 8}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": false, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.45.15", "VHS_latentpreview": true, "ds": {"offset": [2546.6585429007605, -3806.3655728280414], "scale": 0.5445000000000031}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "02 生图组", "bounding": [-1559.1510009765625, 4575.904