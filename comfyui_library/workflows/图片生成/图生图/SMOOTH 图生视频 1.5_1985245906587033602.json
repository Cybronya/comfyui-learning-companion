绚丽，镜头缓缓拉远，展现这场光与舞的盛宴。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "link": 226, "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {"pinned": true}, "type": "PrimitiveStringMultiline", "title": "Positive", "mode": 0, "bgcolor": "#353", "size": [361.16864013671875, 270.3067321777344], "pos": [-390.12652587890625, 792.5596923828125], "id": 88, "properties": {"cnr_id": "comfy-core", "ver": "0.3.33", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 23}, {"outputs": [{"name": "int", "links": [240], "label": "整数", "type": "INT", "localized_name": "int"}], "color": "#332922", "widgets_values": [5], "inputs": [{"widget": {"name": "int"}, "name": "int", "type": "INT", "localized_name": "整数"}], "flags": {"pinned": true}, "type": "Primitive integer [Crystools]", "mode": 0, "bgcolor": "#593930", "size": [210, 58], "pos": [-688.0929565429688, -1824.3504638671875], "id": 134, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Primitive integer [Crystools]"}, "order": 9}, {"outputs": [{"name": "int", "links": [241, 245, 247], "label": "整数", "type": "INT", "localized_name": "int"}], "color": "#332922", "widgets_values": [16], "inputs": [{"widget": {"name": "int"}, "name": "int", "type": "INT", "localized_name": "整数"}], "flags": {"pinned": true}, "type": "Primitive integer [Crystools]", "mode": 0, "bgcolor": "#593930", "size": [210, 58], "pos": [-687.7994384765625, -1624.2955322265625], "id": 135, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Primitive integer [Crystools]"}, "order": 10}, {"outputs": [{"name": "IMAGE", "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#322", "widgets_values": ["3cdf1dd9a7ee663e9fe2eecd5fab5e27ebd86464ff98e1a468ef3739661ed00b.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#533", "size": [639.5260620117188, 946.4710083007812], "pos": [-1996.570068359375, -1866.9227294921875], "id": 142, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"outputs": [{"name": "prompt", "links": [226], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#322", "widgets_values": ["【0-1秒】低角度俯拍，广角镜头，高对比度冷暖混合光（主光源为背景白光）从上方与侧后方投射，制造诡异剪影与阴影，中心构图，鬼新娘身着满是血污的破损白嫁衣，单手握着不断渗血的剪刀，指甲缝血渍明显，衣摆随未知气流微颤，背景白雾似在崩塌，烟雾缭绕弥漫，镜头轻微下压推进，强化窒息压迫感。\n【1-2秒】镜头切换至中近景，手持镜头轻微晃动，侧光打在新娘苍白且带血污的面庞，眼瞳泛红，嘴角微张似有尖牙隐现，右手持剪刀刺入桌上带血的织物中心，布料瞬间撕裂并渗出暗红血渍，血渍如滴雨落下，镜头右移跟随其动作，背景枯枝断裂声与低沉嗡鸣声渐起，营造阴森感。\n【2-3秒】镜头拉远至中景，对称构图，新娘突然抬头，双目直视镜头，背景白光骤然变红，镜头轻微上摇，将血色光影与诡异氛围进一步强化，恐怖感陡升。\n【3-4秒】镜头切换至特写，聚焦新娘持剪刀的指尖，血滴从指缝滴落，滴入下方带血的中式服装布料上，布料瞬间化为灰烬，灰烬中浮现出扭曲的人脸轮廓，镜头急速推进，灰烬爆裂开来，黑雾随之弥漫，背景老旧缝纫机运转的杂音与碎裂声交织，加剧压迫感。\n【4-5秒】镜头拉远至全景，超广角鱼眼镜头，新娘全身被黑雾吞噬，带血的白嫁衣化为残破布条，头冠崩裂，肌肤下似有骨骸隐现，背景烟雾中的枯树轮廓更显狰狞，红光熄灭，仅剩微弱的诡异光线摇曳，镜头缓慢上移，黑雾中浮现无数扭曲的面孔，画面逐渐沉入黑暗，结束。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {"pinned": true}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#533", "size": [583.4736328125, 243.69700622558594], "pos": [-1047.4302978515625, -1461.04541015625], "id": 129, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 12}, {"mode": 0, "outputs": [{"name": "p0", "links": [249], "label": "p0", "type": "*", "localized_name": "p0"}], "size": [210, 58], "pos": [1106.7744140625, 437.4100646972656], "widgets_values": [""], "inputs": [{"widget": {"name": "pwd"}, "name": "pwd", "label": "pwd", "type": "STRING", 