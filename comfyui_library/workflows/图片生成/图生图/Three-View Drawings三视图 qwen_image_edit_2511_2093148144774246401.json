pe": "IMAGE", "localized_name": "images"}], "size": [628.1405639648438, 833.577880859375], "pos": [1177.846923828125, -844.3290405273438], "widgets_values": ["8步"], "inputs": [{"name": "images", "link": 88, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 45, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 20}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [628.1405639648438, 833.577880859375], "pos": [1857.9150390625, -839.286376953125], "widgets_values": ["6步"], "inputs": [{"name": "images", "link": 166, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 92, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 21}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [40], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "size": [413.9450378417969, 258.99468994140625], "pos": [4970.0390625, -554.8563232421875], "widgets_values": ["基于输入人物参考图，生成同一人物的标准三视图全身立绘。三个视图必须视为同一个人物在同一位置、同一尺度、同一站立状态下，仅改变观察方向。严禁因为视角变化而改变人物大小、身高比例、身体比例、构图位置或垂直高度。\n\n【三视图统一基准——必须严格执行】\n\n三个视图必须使用完全相同的画布、摄影机高度、拍摄距离、焦距、人物缩放比例和构图基准。\n\n人物的头顶高度必须完全对齐，三个视图的头顶处于同一水平位置。\n\n人物的肩膀、腰部、胯部、膝盖等身体关键节点必须保持相同的垂直高度，仅因侧面和背面视角产生正常的视觉轮廓变化，不得出现整体上下移动。\n\n三个视图的双脚脚底必须处于完全相同的水平基准线上。正面、右侧面、背面三个视图的脚底最低点高度必须一致，不能出现某一个视图人物站得更高或更低的情况。\n\n人物从头顶到脚底的整体高度必须完全一致，三个视图的人物占画布高度比例必须完全一致。不得出现正面较大、侧面较小、背面较大等缩放差异。\n\n人物在画面中的垂直位置必须完全一致，三个视图的脚底基准线固定不变，不允许因为侧面或背面视角自动调整人物位置。\n\n人物的水平中心位置也必须保持统一，以相同的画面中心轴作为人物定位基准。三个视图排列后，应能够直接进行垂直和水平对齐，不需要后期重新调整人物位置。\n\n人物的身体比例必须完全一致，包括头身比、肩宽、胸腰比例、腿长、手臂长度、脚部大小等。侧面视图不能因为透视而明显缩短或拉长人物，背面视图也不能改变人物整体身高比例。\n\n【视图要求】\n\n1. 正面全身视图\n   人物正面朝向镜头，身体完全正对镜头，双脚自然站立，双腿自然伸直，双手自然垂落身体两侧。完整展示头顶至脚底。\n\n2. 右侧全身视图\n   人物严格向右旋转90°，形成标准右侧面视图。禁止左侧面，禁止45°斜侧面。保持与正面视图完全相同的人物高度、站立位置、脚底基准线、身体比例和姿态，仅改变观察方向。\n\n3. 背面全身视图\n   人物严格背对镜头，形成标准正后方180°视图。禁止斜背、禁止左右偏转。保持与正面和右侧面完全相同的人物高度、站立位置、脚底基准线、身体比例和姿态，仅展示人物背面。\n\n【背景与光线】\n\n背景必须为纯白色无缝背景，不出现墙面、地面分界线、灰色背景、环境元素或其他颜色。\n\n人物脚部与地面接触位置保留自然、柔和、真实的接地阴影。阴影仅用于表现人物站立关系，必须轻薄、自然、边缘柔和，并向周围逐渐衰减。阴影不能改变白色背景的整体纯白效果，也不能形成明显的地面区域。\n\n最终必须达到标准角色三视图对齐效果：\n\n正面、右侧面、背面三个视图的【头顶高度一致、脚底高度一致、整体人物高度一致、人物大小一致、垂直位置一致、水平基准一致、身体比例一致、构图占比一致】。\n\n三个视图排列后，三个脚底最低点必须落在同一条水平线上，三个头顶也必须落在同一条水平线上。将三个视图进行叠加对比时，人物整体高度和垂直位置应完全重合，仅人物轮廓和可见细节因观察方向不同而发生变化。\n"], "inputs": [{"name": "clip", "link": 30, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image1", "link": 156, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 24, "type": "TextEncodeQwenImageEditPlus", "title": "TextEncodeQwenImageEditPlus (Positive)", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.5.1", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "TextEncodeQwenImageEditPlus", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [173, 174, 181], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [3846.911865234375, -399.30419921875], "widgets_values": [1440, 1080, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "type": "IN