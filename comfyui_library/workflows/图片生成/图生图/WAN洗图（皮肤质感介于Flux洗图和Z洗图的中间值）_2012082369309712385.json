"properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "VAEDecode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [23], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#322", "widgets_values": ["色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"], "inputs": [{"name": "clip", "link": 22, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Negative Prompt)", "mode": 0, "bgcolor": "#533", "size": [510, 130], "pos": [700, -960], "id": 22, "properties": {"cnr_id": "comfy-core", "ver": "0.3.45", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 9}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [13, 17], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [400, 600], "pos": [-120, -1180], "widgets_values": ["0bdbd78a1a971866a80ddf1d58e1398db83cef0a1cda4e9b19cbb075198812fc.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 12, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.6.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [20], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [360, 410], "pos": [1020, -410], "widgets_values": ["一位年轻女性端坐于米白色针织沙发之上，身着宽松毛衣与同色系长裤，长发自然垂落肩头，神情专注而宁静，双手轻握一只银白相间的现代保温杯，目光低垂凝视杯身。她姿态放松，双腿交叠，身体微微前倾，营造出沉静内省的氛围。\n\n构图采用中心对称式布局，人物居于画面中轴线，沙发与茶几形成稳定视觉支点。右侧圆形木质茶几上，摆放着一套白色瓷杯与碟，下方叠放两本硬壳书，书页边缘微卷，增添生活质感。背景为浅米色古典护墙板，线条简洁而富有层次，强化空间纵深感。\n\n前景聚焦于人物双手与保温杯，杯身金属光泽在柔和光线下反射微光，细节清晰；中景为沙发与茶几，材质纹理细腻，如针织纹理与木质纹路清晰可见；背景护墙板与地面木纹形成视觉延伸，使画面层次分明。\n\n视觉引导从人物手中保温杯自然延伸至右侧茶几，再向上引导至人物面部，最终落于背景护墙板的装饰线条，形成稳定而柔和的视觉路径。光线来自左上方，柔和漫射，投下自然阴影，人物面部与杯身呈现温润高光，沙发与茶几表面有细腻光影过渡。\n\n整体色调以米白、浅灰、暖棕为主，色彩饱和度低，营造出极简、宁静、温暖的视觉感受。光影柔和，无生硬对比，强调材质的温润质感与空间的静谧氛围。画面氛围静谧、治愈、优雅，传递出现代都市生活中的片刻安宁与自我沉淀。"], "inputs": [{"name": "text", "link": 16, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 16, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 18}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [19], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["一位白发欧洲老婆婆端坐于米白色针织沙发之上，身着宽松毛衣与同色系长裤，长发自然垂落肩头，神情专注而宁静，双手轻握一只银白相间的现代保温杯，目光低垂凝视杯身。她姿态放松，双腿交叠，身体微微前倾，营造出沉静内省的氛围。\n\n构图采用中心对称式布局，人物居于画面中轴线，沙发与茶几形成稳定视觉支点。右侧圆形木质茶几上，摆放着一套白色瓷杯与碟，下方叠放两本硬壳书，书页边缘微卷，增添生活质感。背景为浅米色古典护墙板，线条简洁而富有层次，强化空间纵深感。\n\n前景聚焦于人物双手与保温杯，杯身金属光泽在柔和光线下反射微光，细节清晰；中景为沙发与茶几，材质纹理细腻，如针织纹理与木质纹路清晰可见；背景护墙板与地面木纹形成视觉延伸，使画面层次分明。\n\n视觉引导从人物手中保温杯自然延伸至右侧茶几，再向上引导至人物面部，最终落于背景护墙板的装饰线条，形成稳定而柔和的视觉路径。光线来自左上方，柔和漫射，投下自然阴影，人物面部与杯身呈现温润高光，沙发与茶几表面有细腻光影过渡。\n\n整体色