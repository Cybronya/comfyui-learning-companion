, "order": 3}, {"outputs": [{"name": "image", "links": [5], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["4:5 竖版西班牙弗拉明戈风格银饰珠宝海报，热烈复古奢华风格，写实产品摄影与手绘线稿融合创作。\n画面视觉中心放置参考图中的马头造型纯银吊坠，吊坠朝右，顶部带银质吊环，严格匹配参考图轮廓造型；主体为细腻磨砂银质感，外边缘是亮面抛光银边，内部是精致通透的镂空银丝编织花纹，银花丝细密规整，银饰表面点缀细碎金色闪粉，在暖光下呈现温润又璀璨的金属光泽，细节清晰锐利。\n\n背景为暗调复古南欧场景，左侧搭配金色细线手绘的弗拉明戈舞者侧身轮廓线稿，后方有立体红色折扇与垂坠的红色裙摆；右侧倚靠一把深色古典原声吉他，背景是斑驳做旧的橙黄色肌理墙面；吊坠放置在粗糙的深色岩石台面上，台面散落金色闪粉颗粒，整体氛围热烈又高级，充满西班牙传统人文气息。吊坠上掉落一点金粉，吊坠周围也必须有明显金色闪粉和金粉颗粒效果，金粉像被暖光照亮的漂浮粉尘，岩石台面表面也必须散落金色闪粉，尤其集中在吊坠底部和前景区域。金粉不能完全消失，不能变成灰尘、沙子或普通颗粒，必须呈现闪亮的金色亮片、金粉、粉尘光点质感。\n\n\n画面顶部居中放置暖金色优雅衬线字体的西班牙文「Sombras de flores tejiendo plata」，分为两行排版，字间距舒展，排版协调克制，不遮挡产品主体。\n\n整体采用强烈的侧方暖金色聚光，光影对比鲜明，精准还原磨砂银的细腻颗粒感、抛光边缘的高光与金色闪粉的璀璨质感，环境暗部柔和自然。8K 超高清，画面整洁无多余杂物，整体氛围浓郁高级，西班牙弗拉明戈文化氛围浓厚，传统银饰与复古奢华审美融合。", "empty", false, 694331348, "randomize", "1k"], "inputs": [{"name": "image1", "link": 2, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10