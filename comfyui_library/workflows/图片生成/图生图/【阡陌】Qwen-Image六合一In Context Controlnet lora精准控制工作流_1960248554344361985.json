5, 247.40354919433594], "widgets_values": ["以清新翠绿的草地为底色，创作一幅充满童趣与活力的电商主题艺术字插画。用圆润、灵动且富有手写感的字体呈现 “阡陌电商季”，字体颜色为白色，搭配浅蓝色、浅橙色等柔和渐变描边，让文字活泼又醒目。在文字周围，点缀各种超萌的卡通元素，像俏皮的小狗、憨态可掬的小熊、小巧的星星、嫩绿的枝叶、可爱的小花等，营造出轻松愉悦的夏日氛围。在文字下方，用同样风格的字体配上英文 “Summer” ，整体画面色彩明快、细节丰富，采用细腻的卡通渲染风格，突出清新自然与童趣感，让 “阡陌电商季” 主题在绿意盎然的场景中生动展现 。"], "inputs": [{"name": "clip", "link": 1, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 4, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 5}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [12], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [270, 82], "pos": [545, 188], "widgets_values": ["qwen_image_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "type": "COMBO", "localized_name": "UNET名称"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 1, "type": "UNETLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 4}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [22], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [210, 88], "pos": [989.6143798828125, 518.3560791015625], "widgets_values": [""], "inputs": [{"name": "clip", "link": 2, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 5, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-372.6512485065803, 81.5557549369822], "scale": 0.964614964500003}}, "groups": [], "links": [[1, 3, 0, 4, 0, "CLIP"], [2, 3, 0, 5, 0, "CLIP"], [7, 6