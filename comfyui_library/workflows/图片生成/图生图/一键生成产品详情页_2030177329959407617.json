光灯，魔法现实主义氛围，光线追踪反射，顶级CG渲染，殿堂级视觉杰作。"], "inputs": [{"shape": 7, "name": "anything", "link": 8, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#355", "size": [519.4323120117188, 330.51690673828125], "pos": [891.6236572265625, 752.9905395507812], "id": 7, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 6}, {"outputs": [], "color": "#432", "widgets_values": ["API调用需要再钱包充值"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [210, 88], "pos": [273.92388916015625, 1225.229736328125], "id": 41, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"outputs": [{"name": "IMAGE", "links": [], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#322", "widgets_values": ["pasted/ad86447a31dfa402ae14b9fa3da89f6a25509b05ced57506170f7d6ee043140c.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#533", "size": [411.833251953125, 326], "pos": [440.40338134765625, 1214.8638916015625], "id": 40, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}, {"outputs": [{"name": "image", "links": [46, 47], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#233", "widgets_values": ["", 1766553130, "randomize", "4:3", "2k", false, "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 45, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "