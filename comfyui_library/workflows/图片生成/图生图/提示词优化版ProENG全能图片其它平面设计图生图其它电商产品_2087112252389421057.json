{"last_link_id": 539, "nodes": [{"outputs": [{"name": "IMAGE", "links": [23], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "color": "#323", "shape": 1, "widgets_values": ["down", true, 0, "white"], "inputs": [{"name": "image1", "link": 21, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 22, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"widget": {"name": "direction"}, "name": "direction", "label": "direction", "type": "COMBO", "localized_name": "direction"}, {"widget": {"name": "match_image_size"}, "name": "match_image_size", "label": "match_image_size", "type": "BOOLEAN", "localized_name": "match_image_size"}, {"widget": {"name": "spacing_width"}, "name": "spacing_width", "label": "spacing_width", "type": "INT", "localized_name": "spacing_width"}, {"widget": {"name": "spacing_color"}, "name": "spacing_color", "label": "spacing_color", "type": "COMBO", "localized_name": "spacing_color"}], "flags": {"collapsed": false}, "type": "ImageStitch", "mode": 0, "bgcolor": "#535", "size": [395.3689880371094, 150], "pos": [396.4502258300781, 587.9155883789062], "id": 18, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {}, "Node name for S&R": "ImageStitch"}, "order": 22}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#323", "shape": 1, "widgets_values": ["提取参考图1中的吹风机，替换参考图2中人物手持的瓶子，保持参考图2人物的姿势、表情与服装不变，将其自然地安置在参考图3中的单人沙发上坐好。确保吹风机的展示角度与参考图1保持一致，手部持握关系真实、不穿模，产品比例与人手比例协调。整体构图与光影需完美融合参考图3的室内场景与窗外自然景观，呈现专业相机拍摄的商业摄影质感，材质细节极致真实且光影层次丰富。真实光影，细节清晰。"], "inputs": [{"shape": 7, "name": "anything", "link": 38, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#535", "size": [393.8363342285156, 199.0572967529297], "pos": [2378.686279296875, 587.9155883789062], "id": 11, "properties": {"ue_prope