ts_values": ["参照下面的草稿分镜图片，生成图一的草稿多分镜图片,黑白风格，不要出现文字\n \n"], "inputs": [{"widget": {"name": "multi_line_prompt"}, "name": "multi_line_prompt", "label": "multi_line_prompt", "type": "STRING", "localized_name": "multi_line_prompt"}], "flags": {}, "id": 11, "type": "MultiLinePromptIndex", "title": "提示词分组1", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MultiLinePromptIndex"}, "order": 3}, {"mode": 0, "outputs": [{"name": "text", "links": [27], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 200], "pos": [-100.3831787109375, 448.24774169921875], "widgets_values": ["镜号 5（中景，跟拍）张飞拍马直扑吕布，丈八蛇矛带着风声刺向吕布面门；吕布侧身闪避，方天画戟横扫，两人兵器碰撞发出 “铛” 的巨响，火星四溅。（音效：兵器碰撞的锐响、战马嘶鸣、士兵呐喊助威声）\n镜号 6（特写，慢动作）张飞怒目圆睁，络腮胡飞扬；吕布嘴角噙着冷笑，手腕发力压向蛇矛，两人手臂青筋暴起，僵持不下。（音效：兵器摩擦的刺耳声、双方沉重的呼吸声）\n镜号 7（全景，俯拍）两马盘旋厮杀，丈八蛇矛与方天画戟你来我往，招式凌厉，沙尘被马蹄搅得漫天飞舞，形成一个旋转的沙雾圈。（音效：马蹄声密集如鼓、兵器碰撞声此起彼伏）\n镜号 8（近景）张飞久战不下，额头青筋暴起，大喝一声再次挺矛刺出；吕布从容应对，画戟一拨一挑，化解攻势的同时反击，逼得张飞连连后退。（台词：张飞：“吕布匹夫，好生了得！” ）\n镜号 9（中景，从联军阵前拍）关羽见张飞渐落下风，眉头一皱，拍动青龙偃月刀，催马冲出：“三弟莫慌，某来助你！”（音效：青龙偃月刀出鞘的 “唰” 声、关羽沉稳的喝声、马蹄疾驰声）\n \n"], "inputs": [{"widget": {"name": "multi_line_prompt"}, "name": "multi_line_prompt", "label": "multi_line_prompt", "type": "STRING", "localized_name": "multi_line_prompt"}], "flags": {}, "id": 17, "type": "MultiLinePromptIndex", "title": "提示词分组2（剧本）", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MultiLinePromptIndex"}, "order": 4}, {"mode": 0, "outputs": [], "size": [532.2163696289062, 344.7007141113281], "pos": [857.9630126953125, 814.3605346679688], "widgets_values": [], "inputs": [{"name": "source", "link": 35, "label": "source", "type": "*", "localized_name": "source"}], "flags": {}, "id": 21, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-33.38747677406066, -241.635367004212], "scale": 1.0152559799477372}}, "groups": [], "links": [[2, 2,