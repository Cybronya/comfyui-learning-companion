, "size": [354.88323974609375, 905.857666015625], "pos": [-631.7366943359375, 120.11111450195312], "widgets_values": [], "inputs": [{"name": "images", "link": 184, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 75, "type": "PreviewImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.51", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 17}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [36, 41], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [350, 460], "pos": [-2855.78564453125, 1184.11865234375], "widgets_values": ["一位年轻女性倚靠在木质窗框旁，短卷发自然垂落，眼睛看向镜头，几缕发丝被阳光轻拂，柔顺贴在脸颊旁。她身穿一件无袖红褐色棉麻连衣裙，衣襟处有精致的盘扣装饰，材质质感细腻，随光线流动呈现出自然褶皱。她右手轻托下巴，指尖微翘，眼神温柔地望向镜头，嘴角含笑，表情宁静而略带沉思，仿佛沉浸在午后阳光的温柔里。\n\n前景是一束盛开的粉色郁金香，花瓣层次分明，边缘略带淡雅的白色晕染，花蕊呈金黄色，茎叶青翠挺拔，从画面右下角斜向延伸，与人物形成视觉引导线，增添画面的生机与柔美。花朵与人物形成亲密互动，仿佛她正轻抚花茎，或与之对视，营造出一种静谧的亲密感。\n\n中景是人物主体，占据画面中心偏左位置，身体微微侧转，姿态自然放松，手臂轻倚窗沿，阳光从左上方洒落，勾勒出她肩颈线条的柔和轮廓，光影过渡细腻，皮肤质感温润如玉，无明显阴影，呈现出伪2.5D风格特有的“半实半虚”的立体感。\n\n背景为复古蓝框木窗与原木墙面，窗框略显斑驳，木纹清晰可见，墙面纹理自然粗糙，与人物柔美形成对比。窗外景致模糊，仅能隐约辨识天空的浅灰与远处建筑轮廓，强化画面的纵深感。整体背景色调偏暖，与人物衣着和花朵色彩协调统一，营造出温暖怀旧的氛围。\n\n构图采用三分法，人物置于左上至中部，花朵从右下斜向延伸至中右，形成视觉平衡与引导。镜头视角略低于人物视线，增强亲切感。画面整体无明显对称，但通过光影与色彩的协调，保持视觉和谐。\n\n光影氛围温暖柔和，阳光从左上方斜射，形成明暗过渡自然的“光斑”效果，人物面部与花朵被均匀照亮，阴影柔和不突兀，呈现出伪2.5D风格特有的“轻薄感”与“半透明”质感，仿佛画面被一层薄雾笼罩，既真实又梦幻。\n\n整体风格为伪2.5D摄影，模拟日常业余设备拍摄的质感，但经过艺术化处理，保留真实光影细节，同时强化色彩饱和度与纹理表现力，营造出一种温柔、宁静、略带文艺气息的日常氛围，仿佛一个午后阳光下的静谧瞬间，被温柔定格。"], "inputs": [{"name": "clip", "link": 201, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 207, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 45, "type": "CLIPTextEncode", "title": "提示词", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectabl