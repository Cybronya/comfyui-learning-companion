ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [46, 131], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["温馨的现代客厅场景中，一张浅木色茶几置于画面前景，其上摆放着一台设计简洁的白色智能奶瓶消毒机，机身配以黑色触控面板，显示数字“6:10”，右侧透明水箱清晰可见，左侧并列两瓶婴儿奶瓶——一瓶盛有清水，一瓶装有淡黄色奶液，瓶身刻度清晰。消毒机后方，茶几延伸至中景，一对欧洲年轻父母正坐在米色布艺沙发上，父亲身着灰色毛衣与米色长裤，怀抱穿着黄色连体衣的婴儿，面带微笑俯身与孩子互动；母亲身着宽松浅蓝色长袖上衣与米色系阔腿裤，侧身倚靠沙发，温柔注视着父子，神情愉悦。沙发后方为浅灰蓝色护墙板，上方置有木质搁架，摆放绿植与书籍，右侧窗边透入柔和自然光。浅木色地板与浅褐米色拼接地毯。左侧角落可见米色单人沙发与绿植，整体空间布局疏朗舒适。视觉引导由前景的奶瓶消毒机自然延伸至中景的亲子互动，再至背景的家居陈设，形成清晰的纵深感。画面色调以米白、浅灰、浅蓝色为主，辅以黄色婴儿衣与绿植点缀，营造温暖柔和的视觉基调。光线来自左侧窗户，均匀洒落，形成柔和阴影，突出奶瓶与消毒机的立体感，同时赋予人物肌肤与布料自然光泽。整体氛围宁静、温馨、充满生活气息，传递出家庭育儿的幸福感与科技产品的实用美学。"], "inputs": [{"name": "clip", "link": 74, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [350, 320], "pos": [390, -80], "id": 6, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "OPT_CONNECTION", "type": "*"}], "size": [236.74765014648438, 130], "pos": [-310, 430], "inputs": [], "flags": {}, "id": 93, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.3"}, "widget_ue_connectable": {}, "showAllGraphs": tru