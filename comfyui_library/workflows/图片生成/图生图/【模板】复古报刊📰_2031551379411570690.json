es）、平行的雕版线条与局部半色调网点交织构成，呈现出如同纸币人像般的独特线描版画风格。严格保留 image1 中错位切割的矩形故障色块（Glitch slices）与红色的极细网格线。画面强制限制为高对比度的纯黑白与局部的深砖红色调。维持背景中巨大的红色粗体排版、报纸文本专栏，以及整体画面的多重曝光、欠曝沉郁氛围与强烈的墨水复印颗粒感。细节丰富，高质量，8K分辨率"], "inputs": [{"shape": 7, "name": "passthrough", "label": "passthrough", "type": "STRING", "localized_name": "passthrough"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 30, "type": "Textbox", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Textbox"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [48], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [285.4217224121094, 423.6656799316406], "pos": [1020.6515502929688, 16.37772560119629], "widgets_values": ["pasted/b10f16eff75a162f025b72cca42fdbaeeca9f4b129d6cdd6af5ab6a351ed2f7c.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {"collapsed": true}, "id": 29, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image", "links": [26, 36, 45], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [426.6789245605469, 521.4815063476562], "pos": [799.6156005859375, -31.720712661743164], "widgets_values": ["", 143873711, "randomize", "2:3", "1k", "Third-party", false], "inputs": [{"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "link": 48, "label": "image1", "type": "IMAGE", "localized_name": "ima