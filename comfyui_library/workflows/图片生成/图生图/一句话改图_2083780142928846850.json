": 0, "outputs": [{"name": "LATENT", "links": [183], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [8511.85546875, 2532.657958984375], "widgets_values": [1024, 1536, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 131, "label": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "link": 132, "label": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {"collapsed": false}, "id": 30, "type": "EmptySD3LatentImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.60", "ue_properties": {"widget_ue_connectable": {"batch_size": true, "width": true, "height": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"batch_size": true, "width": true, "height": true}, "Node name for S&R": "EmptySD3LatentImage"}, "order": 13}, {"mode": 0, "outputs": [{"name": "AI回复", "links": [340, 343], "label": "AI回复", "type": "STRING", "localized_name": "AI回复"}], "size": [419.9391784667969, 563.5866088867188], "pos": [7124.58447265625, 2629.37158203125], "widgets_values": ["Qwen3-VL-4B-Instruct", "None (FP16)", "SDPA", 768, "", "你是一个专业的图像编辑提示词工程师。用户会用口语化的方式描述他们想对图片做的修改，你的任务是将其转化为图像编辑模型（如 Qwen-Image-Edit）能精准执行的结构化提示词。\n\n工作流程\n理解用户意图：用户可能说得很模糊（\"把背景换好看点\"\"人再白一点\"），你需要推断具体操作。\n如果关键信息缺失（比如\"换个背景\"但没说换成什么），简短追问一次，不要反复追问。\n输出最终提示词，格式见下方。\n输出格式\n每次输出严格按以下结构：\n\n\n【编辑类型】局部重绘 / 元素替换 / 风格迁移 / 扩图 / 打光调整 / 去除元素 / 添加元素 / 整体调整\n【目标区域】描述要编辑的区域（如\"画面左侧的红色汽车\"\"人物面部\"\"整个背景\"）\n【编辑指令】一句话精确描述要做什么\n【约束条件】需要保持不变的部分（如\"保持人物姿态和表情不变\"\"保持前景建筑不变\"）\n【风格参考】（可选）目标风格、参考画家、材质质感等\n写提示词的原则\n具体胜过抽象：\"把天空换成黄昏时分的橙紫色渐变，带几缕薄云\" 优于 \"换个好看的天空\"\n用空间定位代替模糊指代：\"画面右下角的木桌\" 优于 \"那个桌子\"\n明确保留边界：告诉模型哪些不该动，防止误改\n材质和光影要写：如果涉及物体替换，写明材质（金属/木质/布料）和光照方向\n风格迁移给锚点：提及具体风格（赛博朋克、吉卜力、油画厚涂、产品摄影）比说\"好看\"有效十倍\n一条指令一个操作：复杂修改拆成多步，每步只改一件事，效果更可控\n常见场景速查\n用户说\t你应该输出\n\"把背景去掉\"\t去除元素：将背景替换为纯白/透明，保持主体边缘干净无锯齿\n\"人再好看点\"\t追问：是想调肤色、瘦脸、换发型、还是换衣服？\n\"做成动漫风\"\t风格迁移：将整幅画面转为日系赛璐璐动画风格，保持人物比例和构图不变，线条清晰，色块分明\n\"把衣服换成红色的\"\t元素替换：将人物上身衣物替换为红色，保持款式、褶皱和光影关系不变\n\"图太小了往外扩\"\t扩图：向四周自然延伸画面，延伸区域风格、透视、光照与原图一致\n\"加个帽子\"\t添加元素：在人物头顶添加一顶[追问款式]，与头部比例协调，光影方向与画面一致", 0.9, 0.9, 4096, 288, "随机", false, false, false], "inputs": [{"shape": 7, "name": "🖼️ 图像1", "link": 331, "label": "🖼️ 图像1", "type": "IMAGE", "localized_name": "🖼️ 图像1"}, {"shape": 7, "name": "🖼️ 图像2", "label": "🖼️ 图像2", "type": "IMAGE", "localized_name": "🖼️ 图像2"}, {"shape": 7, "name": "🖼️ 图像3", "label": "🖼️ 图像3", "type": "IMAGE", "localized_name": "🖼️ 图像3"}, {"shape": 7, "name": "🖼️ 图像4", "label": "🖼️ 图像4", "type": "IMAGE", "localized_name": "🖼️ 图像4"}, {"shape": 7, "name": "🎯 Qwen3VL额外选项", "label": "🎯 Qwen3VL额外选项", "type": "QWEN3VL_EXTRA_OPTIONS", "localized_name": "🎯 Qwen3VL额外选项"}, {"widget": {"name": "🤖 模型选择"}, "name": "🤖 模型选择", "label": "🤖 模型选择", "type": "COMBO", "localized_name": "🤖 模型选择"}, {"widget": {"name": "⚙️ 量化级别"}, "name": "⚙️ 量化级别", "label": "⚙️ 量化级别", "type": "COMBO", "localized_name": "⚙️ 量化级别"}, {"widget": {"name": "🧠 注意力模式"}, "name": "🧠 注意力模式", "label": "🧠 注意力模式", "type": "COMBO", "localized_name": "🧠 注意力模式"}, {"widget": {"name": "🖼️ 最大长边"}, "name": "🖼️ 最大长边", "label": "🖼️ 最大长边", "type": "INT", "localized_name": "🖼️ 最大长边"}, {"widget": {"name": "💬 用户输入"}, "name": "💬 用户输入", "link": 347, "label": "💬 用户输入", "type": "STRING", "localized_name": "💬 用户输入"}, {"widget": {"name": "🎭 系统角色定义"}, "name": "🎭 系统角色定义", "label": "🎭 系统角色定义", "type": "STRING", "localized_name": "🎭 系统角色定义"}, {"widget": {"name": "🌡️ 温度"}, "name": "🌡️ 温度", "label": "🌡️ 温度", "type": "FLOAT", "localized_name": "🌡️ 温度"}, {"widget": {"name": "🎯 Top-P"}, "name": "🎯 Top-P", "label": "🎯 Top-P", "type": "FLOAT", "localized_name": "🎯 Top-P"}, {"widget": {"name": "📏 最大长度"}, "name": "📏 最大长度", "label": "📏 最大长度", "type": "INT", "localized_name": "📏 最大长度"}, {"widget": {"name": "🎲 随机种子"}, "name": "🎲 随机种子", "link": 342, "label": "🎲 随机种子", "type": "