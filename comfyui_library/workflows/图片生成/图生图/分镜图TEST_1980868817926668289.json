特写展现老头的疲惫与胜利的神情，竹林恢复宁静，阳光洒满地面，怪兽化作灰烬消散，战斗结束，画面充满余韵。"], "inputs": [{"name": "text", "link": 62, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 57, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 12}, {"mode": 0, "outputs": [{"name": "p0", "links": [61], "label": "p0", "type": "*", "localized_name": "p0"}], "size": [270, 58], "pos": [945.5564575195312, 968.4215698242188], "widgets_values": [""], "inputs": [{"widget": {"name": "pwd"}, "name": "pwd", "label": "pwd", "type": "STRING", "localized_name": "pwd"}, {"name": "prompt_1", "link": 60, "label": "prompt_1", "type": "STRING"}], "flags": {}, "id": 56, "type": "RHHiddenNodes", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHHiddenNodes", "info": "", "ref_info": "Z0FBQUFBQm84VVpubmxIY1RBSHQ3NkF6QXBKeTMyY3p2QV9HVV9mTXpmZ2Etb2VIbDNaa2dJU09RclNkYzlyRHBOSUJreElucHowTTd4d3BJa3FVQ2FCWHhTVXU0eW5pWkE9PQ=="}, "order": 7}, {"outputs": [{"name": "IMAGE", "links": [13], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#222", "widgets_values": ["c73c346b30248ca40f4255708f14ba51839562bb228eb7533b8f383f145bd7d1.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#000", "size": [330.6414794921875, 326], "pos": [367.6468505859375, 795.2722778320312], "id": 8, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {"im