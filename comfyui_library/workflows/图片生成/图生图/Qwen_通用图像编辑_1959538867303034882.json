, {"outputs": [{"name": "patched_model", "links": [186], "label": "patched_model", "type": "MODEL", "localized_name": "patched_model"}], "color": "#008181", "widgets_values": [1], "inputs": [{"name": "model", "link": 141, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "strength"}, "name": "strength", "label": "strength", "type": "FLOAT", "localized_name": "strength"}], "flags": {}, "type": "CFGNorm", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [290, 60], "pos": [490, 300], "id": 75, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {"strength": true}}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CFGNorm", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 21}, {"outputs": [{"name": "IMAGE", "links": [178], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "#c09430", "widgets_values": ["lanczos", 2], "inputs": [{"name": "image", "link": 177, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "type": "COMBO", "localized_name": "缩放方法"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "type": "FLOAT", "localized_name": "像素数量"}], "flags": {"collapsed": false}, "type": "ImageScaleToTotalPixels", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [270, 82], "pos": [730, 530], "id": 93, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {"megapixels": true, "upscale_method": true}}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ImageScaleToTotalPixels", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 10}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [197, 198], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [270, 82], "pos": [840, 670], "widgets_values": ["lanczos", 1], "inputs": [{"name": "image", "link": 196, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "type": "COMBO", "localized_name": "缩放方法"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "type": "FLOAT", "localized_name": "像素数量"}], "flags": {"collapsed": true}, "id": 110, "type": "ImageScaleToTotalPixels", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {"megapixels": true, "upscale_method": true}}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ImageScaleToTotalPixels", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"outputs": [], "color": "#c09430", "widgets_values": ["A. 语义级编辑（允许画面整体像素变化，但保持语义/主体一致）\n\nIP/角色延展：在不丢失人物/形象识别度的前提下做风格、表情、配件等变化（如官方用 Capybara 做 MBTI 表情包延展）。\n\n新视角 / 新视图合成（Novel View Synthesis）：支持 90°/180° 旋转，能直接看到“背面/另一侧”，不仅是简单翻转。适合产品可视化、道具背部结构展示等。\n\n风格迁移（整图风格化）：将人像/场景转换为如 吉卜力 等艺术风格，同时尽量保持主体身份与语义一致。\n\n姿态/朝向/物体旋转：在不换主体的前提下改变朝向、角度与局部结构呈现。\n\nB. 外观级编辑（局部像素改动，其他区域尽量不变）\n\n增删改元素（Inpainting 类）：往画面里“加牌子”“加物体/配饰/文字泡”“去杂物/线头/污点/路人”等；官方示例还演示了加告示牌并自动生成真实反射/阴影。\n\n精修与清洁：去碎发丝、去小瑕疵、修理边缘锯齿、修小范围反光/阴影。\n\n背景/场景替换：将主体抠出或保持主体不变时替换背景。\n\n服饰替换 / 定制服装：变更上衣/西装颜色、材质、式样；社区贴有“一次性给多人换粉色西装与橙色领带”的对比。\n\n颜色定点修改：只改一个字母的颜色、只改某件物体的配色，其他保持不变。\n\n\nC. 文字级编辑（中英双语，强调版式保真）\n\n中英文字的“增删改”：可在图像中直接改字、替换标题/落款，并尽量保留原字体/字号/字重/字距与排版；适合海报、传单、招牌、包装与 UI Mock。\n\n细粒度改字/改色：如仅修改某个中文字的一个部件或只把单个字母改成蓝色。\n\n链式修字（连贯小步）：对生僻字/书法进行“框选→修正→再细修”的多步矫正，适合古籍/手写体纠错与长版图文的细节维护。\n\n\n组合与场景化应用（把上面能力用于真实业务）\n\n品牌/电商制图：批量做多语言本地化、更换法务文案/价签、快速出 配色/材质变体、补拍不到的“背面/底部”视角。\n\n广告合成与门店导视：加导视牌/海报/橱窗价签并自动匹配反射/阴影，适合投放预览与提案稿。\n\n人物写真/时尚快修：去碎发丝、替换服饰/配饰、换背景/场景风格。\n\n虚拟形象与周边延展：用“IP 延展 + 风格迁移”生成成套表情包、主题系列、衍生周边图。\n\n教程与批量化（ComfyUI 实践）：用 Prompt List 批量跑多个改字/改景指令；在低显存下配合 Lightning LoRA（4 steps） 提速（质量轻损）。\n\n\n社区最新经验补充（与任务边界相关）\n\n多图联合编辑：Reddit 有“拼接两张图并只输出目标区域”的土法多图编辑工作流，也有人反馈“多图编辑目前稳定性一般，官方称后续会改进”。适合“参考服装→替换到人像”这类任务的探索版。\n\n量化/低显存取舍：FP8/GGUF 能把门槛降到 16–24 GB，但细节与人脸质感较 FP16/原版略降；做“精修/高保真改字”任务时优先高精度权重。\n\n风格改造时的人脸/比例波动：社区反馈把写实照改成油画/赛博风时，面部/体态可能被“重新演绎”；实践上用小步链式（先加饰品→再换发型→再统一风格）更稳。\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [500, 1170], "pos": [-820, 130], "id": 109, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "rgba(24,24,27,.9)", "size": [360, 70], "color": "#c09430", "pos": [740, 720], "inputs": [], "flags": {}, "id": 112, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "showAllGraphs": true, "sort": "position", "matchTitle": "模式", "showNav": true, "toggleRestriction": "default"}, "order": 6}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [177, 192], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [274.080078125, 314.0000305175781], "pos": [-80, 520], "widgets_values": ["889858298f952b8d775fa601f37c3a33fc2210002533c3e26b7d19532b56eebf.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 78, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {"image": true, "upload": true}}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoadImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 7}, {"outputs": [{"name": "CONDITIONING", "links": [163], "label": "CONDITIONING", "type"