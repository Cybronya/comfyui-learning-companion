，通过统一调性和动态平衡构建极具传播力的人像商业大片范本。适合用于服饰品牌广告/社交媒体封面/IP形象延展等应用场景。  \n\n关键词标签建议添加：“cinematic daylight, urban street cafe setting, fashion photography composition, vibrant yellow color scheme contrast with denim and white tee, confident young woman pose, soft natural lighting, shallow depth of field background blur effect, modern minimalist furniture design, high-resolution detail rendering.”"], "inputs": [{"shape": 7, "name": "anything", "link": 117, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 89, "type": "easy showAnything", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "easy showAnything", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [96], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 106], "pos": [-3061.740478515625, 70.21514892578125], "widgets_values": [1080, 1920, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 121, "label": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "link": 122, "label": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {}, "id": 37, "type": "EmptyLatentImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage"}, "order": 15}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [43, 45], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [400, 200], "pos": [-3158.859130859375, -345.1565856933594], "widgets_values": [""], "inputs": [{"name": "clip", "link": 42, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 114, "label": "text", "type": "STRING", "localized_na