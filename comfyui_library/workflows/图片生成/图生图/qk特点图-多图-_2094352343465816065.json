image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 23, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 24, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 20, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}], "flags": {}, "id": 10, "type": "RH_Nano_Banana2_Gemini31Flash", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Gemini31Flash"}, "order": 5}, {"mode": 0, "outputs": [{"name": "string", "links": [13], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [455.5921325683594, 292.36846923828125], "pos": [-561.6429443359375, 865.998291015625], "widgets_values": ["\"layout_strategy\": \"特点图以完整产品小主视图作为位置锚点，三张大微距卡片错落覆盖主要视觉面积，用纤细引导线连接真实局部，突出防滑垫、包边、调节连接位和底部缺口。\",\n    \"prompt\": \"本图视觉目标为制作产品特点与细节信息图，通过真实微距材质和结构工艺表现车内调节儿童观察镜的夹持、防滑、包边和调节连接细节。产品整体为黑色纵向悬挂结构，上部短宽圆角夹头位于最顶端，夹头内侧嵌入浅灰色锯齿状软质防滑垫；中部黑色竖向圆柱支撑柱垂直向下，连接镜体上方的黑色横向支撑锁紧结构；下部是宽幅圆角矩形镜面，厚实黑色外框围合四边，底边中央形成半圆形内凹缺口，镜面呈浅灰白均匀反射，整体视觉重心落在下方镜面区域。左下角放置一个较小完整产品正面图，产品直立放在哑光极浅暖白台面上，占画面面积约18%，镜面朝向观者，顶部夹头朝上，作为微距位置索引。其余画面采用现代杂志式错落拼贴，四张圆角微距卡片合计占画面约72%，每张卡片底色白色，描边色浅灰色，文字颜色深炭黑，圆角二十四像素，投影为低透明短距离灰影，引导线为浅灰色细线，线端浅灰色圆点准确落在完整产品对应位置。版式为1:1宽高比，顶部标题区占14%，中部拼贴区占76%，底部留白占10%。英文主标题固定置于画面正上方，采用粗体 Sans Serif 斜体气质，深炭黑大写字母，字号为画面宽度的7%，字距紧凑，标题关键词以浅灰色细线切分形成黑色与浅灰色撞色，标题下方居中放置一条浅灰色装饰细线和一个极简线性小图标。主标题文字为 SMART DETAILS，画面中文字仅包含英文。第一张最大微距卡片位于右上，短语为 Grip Pad，展示顶部夹头内侧浅灰色锯齿状防滑垫，锯齿边缘呈规则波纹起伏，哑光软质表面吸收高光，与周围黑色半哑光塑料夹头形成材质对比，夹头圆角外壳边缘有细窄亮线。第二张横向微距卡片位于左上偏中，短语为 Rounded Rim，展示黑色圆角外框与浅灰镜面之间的细窄包边，外框厚度均匀，镜面边缘略深、中心略亮，包边转角圆滑，缝隙整齐。第三张竖向微距卡片位于右下，短语为 Adjust Joint，展示中部黑色旋紧连接位与调节关节，竖向支撑柱进入横向锁紧结构，连接处贴合紧密，硬质塑料表面平滑，边缘高光连续。第四张小微距卡片位于中下，短语为 Lower Notch，展示镜面底边中央半圆形内凹结构，黑色边框沿内凹弧线完整包覆，镜面反射在缺口上方形成浅灰渐变。背景延续左上高亮至右下极浅暖白灰渐变，并加入低对比度深度虚化车内轮廓，虚化区域位于画面最外侧，产品和文字清晰置于前景。主光来自左上方45°，辅光来自正前方漫射，右后方轮廓光勾勒微距卡片内的黑色边缘；微距景深控制在局部结构范围内，纹理焦平面清晰，背景虚化柔和。相机高度为产品高度的1.4倍，相机光轴与水平面成约12°俯角，微距卡片呈100mm微距焦段感，完整产品呈70mm焦段感，透视压缩自然。产品表面保留半哑光硬质塑料触感，浅灰防滑垫每条齿形清晰，镜面呈柔和反射而非强炫光，接缝线条直顺。画面留白围绕标题和完整产品展开，引导线形成由小产品指向四个真实细节的视觉动线，信息密度集中于局部工艺。输出为8K商业摄影级清晰度，高分辨率产品细节，精确边缘，真实材质表现，自然阴影，克制高光，高级商业精修，清晰英文排版，准确产品比例，真实空间关系，亚马逊电商信息图品质，国际品牌产品目录质感。产品一致性保护要求：完整产品与四个微距均对应同一个黑色夹持式婴儿观察镜，顶部夹头、浅灰锯齿防滑垫、竖向支撑柱、横向锁紧结构、圆角矩形镜框和底部半圆内凹缺口在所有区域保持一致。AVOID：1. 无中文字符；2. 无乱码英文；3. 无水印；4. 无品牌标志；5. 无产品变形；6. 无卡通插画感；7. 无廉价电商模板感；8. 无过度饱和；9. 无夸张光晕；10. 无虚构功能文字；11. 无多余零件；12. 无缺失零件；13. 无产品粘连；14. 无镜像结构错误。\"\n  },"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 6, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 0}, {"mode": 0, "outputs": [{"name"