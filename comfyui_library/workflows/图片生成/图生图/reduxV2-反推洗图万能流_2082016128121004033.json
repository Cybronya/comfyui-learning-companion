_name": "latent_image"}], "flags": {}, "type": "SamplerCustomAdvanced", "mode": 0, "bgcolor": "#653", "size": [298.0096740722656, 253.64129638671875], "pos": [990.2185668945312, 468.9034118652344], "id": 99, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SamplerCustomAdvanced"}, "order": 41}, {"mode": 0, "outputs": [{"name": "NOISE", "links": [164], "label": "NOISE", "type": "NOISE", "localized_name": "NOISE"}], "size": [315, 82], "pos": [980.22119140625, 721.6734008789062], "widgets_values": [631297730412535, "randomize"], "inputs": [{"widget": {"name": "noise_seed"}, "name": "noise_seed", "label": "noise_seed", "type": "INT", "localized_name": "noise_seed"}], "flags": {}, "id": 100, "type": "RandomNoise", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RandomNoise"}, "order": 8}, {"mode": 0, "outputs": [{"name": "SIGMAS", "links": [173], "label": "SIGMAS", "type": "SIGMAS", "localized_name": "SIGMAS"}], "size": [315, 106], "pos": [980.7586669921875, 811.7911987304688], "widgets_values": ["normal", 8, 0.5000000000000001], "inputs": [{"name": "model", "link": 187, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 108, "type": "BasicScheduler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "BasicScheduler"}, "order": 35}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [36, 88, 131, 137, 149, 194], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [856.39013671875, 1338.3160400390625], "pos": [-1852.5849609375, -152.83946228027344], "widgets_values": ["pasted/8485526b466f2496adf85d137d7c8aa26f7ef525bb4053bd0917d8896738abc5.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 39, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 9}, {"outputs": [], "color": "#432", "widgets_values": ["# 🎨 ComfyUI 工作流分析：智能判断与双路重绘/放大工作流\n\n## 1. 工作流概述\n\n这是一个基于 **FLUX.1** 模型的复杂图像生成与处理工作流。它的核心特色在于**“智能判断”**机制：通过 AI 视觉模型分析输入图片，判断画面主体是否为“人”。\n- **如果是人（输出 1）**：走**重绘（Redraw/Img2Img）**路径，使用 Turbo 模型快速生成，并应用风格模型。\n- **如果不是人（输出 2）**：走**文生图（Text2Img）**路径，使用 Dev 模型生成，并加载细节增强 LoRA。\n\n此外，工作流还包含一个**图像放大（Upscale）**模块，对生成的图像进行高清化处理，并最终通过**图像对比器**展示效果。\n\n---\n\n## 2. 主要功能模块\n\n| 模块名称 | 功能描述 | 关键节点 |\n| :--- | :--- | :--- |\n| **🧠 智能判断** | 分析输入图，判断主体是否为人，输出 1 或 2 | `RH_Captioner`, `Text to Number`, `Number to Int` |\n| **🔄 模型切换** | 根据判断结果，动态切换基础模型和 LoRA | `CR Model Input Switch` |\n| **🖼️ 路径 A：重绘** | 针对人像，使用 Img2Img 模式，保留原图结构 | `VAEEncode`, `SamplerCustomAdvanced` (下路) |\n| **🖼️ 路径 B：文生图** | 针对非人像，使用 Text2Img 模式，完全生成 | `EmptyLatentImage`, `SamplerCustomAdvanced` (上路) |\n| **🔍 图像放大** | 对生成结果进行 4x 高清放大 | `ImageUpscaleWithModel`, `ImageResizeKJ` |\n| **👁️ 风格控制** | 应用 Style Model 增强画面风格一致性 | `StyleModelApply` (两个) |\n| **📝 提示词生成** | 自动描述输入图，并翻译为英文提示词 | `RH_Captioner`, `RH_Translator` |\n\n---\n\n## 3. 输入与输出说明\n\n### 📥 输入说明\n1. **参考图像 (LoadImage)**:\n   - 节点 ID: `39`\n   - 作用：作为判断主体、重绘底图、以及风格参考的原始图像。\n2. **模型文件**:\n   - **基础模型**: `svdq-int4-flux.1-dev` (Nunchaku 量化版)\n   - **LoRA**: `FLUX-dev-lora-add_details-.safetensors` (细节增强), `FLUX.1-Turbo-Alpha.safetensors` (快速生成)\n   - **风格模型**: `flex1_redux_siglip2_512.safetensors`\n   - **放大模型**: `4xRealWebPhoto_v3_atd.safetensors`\n   - **VAE**: `ae.safetensors`\n   - **CLIP Vision**: `siglip2_so400m_patch16_512.safetensors`\n\n### 📤 输出说明\n1. **最终对比图 (Image Comparer)**:\n   - 节点 ID: `133`\n   - 展示放大后的图像与原始生成图像的对比，方便查看放大效果。\n2. **保存的图像 (SaveImage)**:\n   - 节点 ID: `106`\n   - 保存最终放大的高清图像。\n\n---\n\n## 4. 节点详解与数据流\n\n### 第一阶段：智能判断与模型准备\n\n1. **图像加载与预处理**\n   - `LoadImage` (39) 加载图片。\n   - `RH_Captioner` (114) 接收图片，提示词为：“这张图像的中心主体是人吗，如果是请用数字1表达，不是请用数字2表达，只回复1或2数字”。\n   - `easy showAnything` (115) 和 `Text to Number` (117) 将 AI 回复的文本转换为数字。\n   - `Number to Int` (118) 将数字转为整数，作为后续开关的信号。\n\n2. **模型加载与切换**\n   - `NunchakuFluxDiTLoader` (86) 加载 FLUX Dev 基础模型。\n   - `NunchakuFluxLoraLoader` (87) 加载 Turbo LoRA (权重 1.0)。\n   - `NunchakuFluxLoraLoader` (111) 加载细节增强 LoRA (权重 0.6)。\n   - **关键节点 `CR Model Input Switch` (113)**:\n     - **Input 1 (来自 87)**: 带有 Turbo LoRA 的模型（用于人像重绘，速度快）。\n     - **Input 2 (来自 111)**: 带有细节 LoRA 的模型（用于非人像文生图，质量高）。\n     - **Control Input**: 来自判断模块的 1 或 2。\n     - **逻辑**: 如果判断为 1 (人)，选择 Turbo 模型；如果为 2 (非人)，选择细节模型。\n\n3. **提示词生成**\n   - `RH_Captioner` (85) 对输入图进行详细描述。\n   - `RH_Translator` (128) 将描述翻译为英文（如果原始描述是中文）。\n   - `CLIPTextEncode` (9) 将翻译后的文本编码为 Conditioning。\n\n4. **风格模型应用**\n   - `CLIPVisionEncode` (62) 提取输入图的特征。\n   - 两个 `StyleModelApply` (64, 75) 将风格特征注入到 Conditioning 中，确保生成图像与参考图风格一致。\n\n### 第二阶段：双路生成\n\n#### 🛣️ 路径 A：人像重绘 (Img2Img)\n*当判断结果为 1 (人) 时激活*\n\n1. **图像编码**:\n   - 输入图经过 `ImageUpscaleWithModel` (119) 和 `ImageResizeKJ` (124) 放大并调整尺寸为 1280x1280。\n   - `VAEEncode` (121) 将处理后的图像编码为 Latent 空间数据。\n2. **采样设置**:\n   - `BasicScheduler` (108): 步数 8，Denoise 0.5 (保留较多原图信息)。\n   - `BasicGuider` (107): 结合模型和 Conditioning。\n3. **采样生成**:\n   - `SamplerCustomAdvanced` (99) 使用编码后的 Latent 进行采样生成。\n\n#### 🛣️ 路径 B：非人像文生图 (Text2Img)\n*当判断结果为 2 (非人) 时激活*\n\n1. **空 Latent 生成**:\n   - `GetImageSize` (56) 获取输入图尺寸 (1024x1024)。\n   - `EmptyLatentImage` (98) 创建相同尺寸的空 Latent。\n2. **采样设置**:\n   - `BasicScheduler` (97): 步数 8，Denoise 1.0 (完全生成)。\n   - `BasicGuider` (95): 结合模型和 Conditioning。\n3. **采样生成**:\n   - `SamplerCustomAdvanced` (92) 使用空 Latent 进行采样生成。\n\n### 第三阶段：后处理与输出\n\n1. **解码**:\n   - 两条路径生成的 Latent 分别通过 `VAEDecode` (104 和 47) 解码为像素图像。\n2. **放大**:\n   - 图像经过 `ImageUpscaleWithModel` (119) 使用 4x 模型放大。\n   - `ImageResizeKJ` (124) 调整最终尺寸为 1280x1280。\n3. **对比与保存**:\n   - `Image Comparer` (133) 对比放大前后的图像。\n   - `SaveImage` (106) 保存最终结果。\n\n---\n\n## 5. 使用步骤教程\n\n### 🚀 快速开始\n\n1. **准备环境**:\n   - 确保已安装 ComfyUI 及必要的自定义节点（如 `ComfyUI-Crystools`, `ComfyUI-Image-Comparers`, `RH_Captioner`, `Nunchaku` 等）。\n   - 下载工作流中指定的模型文件（FLUX Dev, LoRA, Style Model, Upscale Model 等）并放置在对应文件夹。\n\n2. **加载工作流**:\n   - 将提供的 JSON 数据导入 ComfyUI。\n\n3. **设置输入图像**:\n   - 点击 `LoadImage` 节点，上传你想要处理的图片。\n   - **建议**: 如果希望重绘效果，请上传人像；如果希望文生图，请上传非人像物体或风景。\n\n4. **调整参数 (可选)**:\n   - **判断逻辑**: 默认自动判断。如果需要强制指定路径，可以手动修改 `CR Model Input Switch` 的输入。\n   - **放大尺寸**: 在 `ImageResizeKJ` (124) 节点中，可以修改 `width` 和 `height` 来调整最终输出尺寸（当前为 1280x1280）。\n   - **风格强度**: 在 `StyleModelApply` 节点中，可以调整 `strength` 参数来控制风格迁移的强度。\n\n5. **执行生成**:\n   - 点击 **Queue Prompt** 开始生成。\n   - 观察 `easy showAnything` 节点，确认 AI 判断的主体类型（1 或 2）。\n\n6. **查看结果**:\n   - 在 `Image Comparer` 节点中，拖动滑块对比放大前后的图像。\n   - 最终高清图像将保存在 `SaveImage` 节点指定的输出目录中。\n\n---\n\n## 6. 常见问题与优化建议\n\n- **Q: 为什么人像生成速度慢？**\n  - A: 人像路径使用了 Turbo LoRA，通常步数较少（8步），速度应该很快。如果慢，可能是放大模块耗时较长。可以尝试降低放大尺寸。\n\n- **Q: 如何修改提示词？**\n  - A: 当前工作流使用 AI 自动描述。如果需要手动控制，可以在 `CLIPTextEncode` (9) 节点中直接修改文本，或者断开 `RH_Translator` 的连接，手动输入英文提示词。\n\n- **Q: 风格模型不起作用？**\n  - A: 检查 `StyleModelLoader` 是否正确加载了 `flex1_redux_siglip2_512.safetensors`。确保 `CLIPVisionEncode` 节点连接了正确的参考图。\n\n- **💡 优化建议**:\n  - 如果显存不足，可以考虑减少放大模块的分辨率，或者不使用 `ImageUpscaleWithModel` 进行二次放大，直接在生成时使用更高分辨率。\n  - 对于非人像生成，可以尝试调整 `BasicScheduler` 的步数，增加步数可能带来更高质量的细节。\n\n---\n\n希望这份教程能帮助你更好地理解和使用这个 ComfyUI 工作流！如有其他问题，欢迎随时提问。 🎉"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [885.882568359375, 2280.43603515625], "pos": [-2819.11279296875, -529.15283203125], "id": 134, "properties": {}, "order": 10}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [3115.2809339046635, 1992.4561080768783], "scale": 0.1610510000000033}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Redraw", "bounding": [-448.88720703125, -347.9583435058594, 1970.9073486328125, 633.6891479492188]}, {"color": "#8A8", "font_size": 24, "flags": {}, "id": 2, "title": "Switch ？Human", "bounding": [-86.02037811279297, 41.936126708984375, 208.353271484375, 181.8157196044922]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Upscale", "bounding": [-463.88665771484375, 418.9099426269531, 1994.291748046875, 508.0254211425781]}], "links": [[1, 9, 0, 3, 0, "CONDITIONING"], [70, 56, 0, 5, 3, "INT"], [71, 56, 1, 5, 4, "INT"], [83, 63, 0, 62, 0, "CLIP_VISION"], [84, 65, 0, 64, 1, "STYLE_MODEL"], [85, 62, 0, 64, 2, "CLIP_VISION_OUTPUT"], [88, 39, 0, 62, 1, "IMAGE"], [108, 3, 0, 64, 0, "CONDITIONING"], [110, 65, 0, 75, 1, "STYLE_MODEL"], [111, 62, 0, 75, 2, "CLIP_VISION_OUTPUT"], [119, 68, 0, 47, 1, "VAE"], [137, 39, 0, 85, 0, "IMAGE"], [139, 85, 0, 9, 1, "STRING"], [143, 64, 0, 75, 0, "CONDITIONING"], [147, 88, 0, 9, 0, "CLIP"], [149, 39, 0, 90, 0, "IMAGE"], [150, 90, 0, 56, 0, "IMAGE"], [151, 93, 0, 92, 0, "NOISE"], [153, 95, 0, 92, 1, "GUIDER"], [154, 96, 0, 92, 2, "SAMPLER"], [155, 75, 0, 95, 1, "CONDITIONING"], [156, 92, 0, 47, 0, "LATENT"], [157, 5, 0, 95, 0, "MODEL"], [158, 97, 0, 92, 3, "SIGMAS"], [159, 5, 0, 97, 0, "MODEL"], [161, 56, 0, 98, 0, "INT"], [162, 56, 1, 98, 1, "INT"], [164, 100, 0, 99, 0, "NOISE"], [166, 96, 0, 99, 2, "SAMPLER"], [169, 68, 0, 104, 1, "VAE"], [170, 99, 0, 104, 0, "LATENT"], [171, 104, 0, 106, 0, "IMAGE"], [172, 107, 0, 99, 1, "GUIDER"], [173, 108, 0, 99, 3, "SIGMAS"], [186, 5, 0, 107, 0, "MODEL"], [187, 5, 0, 108, 0, "MODEL"], [193, 113, 0, 5, 0, "MODEL"], [194, 39, 0, 114, 0, "IMAGE"], [195, 114, 0, 115, 0, "*"], [198, 115, 0, 117, 0, "STRING"], [199, 117, 0, 118, 0, "NUMBER"], [200, 118, 0, 113, 2, "INT"], [201, 86, 0, 87, 0, "MODEL"], [202, 87, 0, 111, 0, "MODEL"], [203, 111, 0, 113, 0, "MODEL"], [204, 87, 0, 113, 1, "MODEL"], [205, 47, 0, 119, 1, "IMAGE"], [207, 121, 0, 99, 4, "LATENT"], [209, 68, 0, 121, 1, "VAE"], [212, 119, 0, 124, 0, "IMAGE"], [213, 124, 0, 121, 0, "IMAGE"], [214, 123, 0, 125, 0, "*"], [215, 125, 0, 119, 0, "UPSCALE_MODEL"], [217, 3, 0, 107, 1, "CONDITIONING"], [218, 98, 0, 127, 0, "*"], [219, 127, 0, 92, 4, "LATENT"], [220, 85, 0, 128, 0, "STRING"], [221, 128, 0, 82, 0, "*"], [226, 104, 0, 133, 0, "IMAGE"], [227, 47, 0, 133, 1, "IMAGE"]], "id": "2185d3f4-3fa3-42fb-b760-4747c7e00211", "config": {}, "version": 0.4, "last_node_id": 134, "revision": 0}