{"last_link_id": 9, "nodes": [{"mode": 0, "outputs": [{"name": "text", "links": [9], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 200], "pos": [1249.8455810546875, 599.5035400390625], "widgets_values": ["图生图，实景照片叠加原创童书式细线速写，真实照片为画面主体，保留原图环境、季节、氛围、形状细节，根据照片场景构思微型小故事。\n小巧速写卡通人物，黑色钢笔轮廓线条松弛自然，简单五官、灵动姿态，少量排线，保留纸张底色，少量点缀呼应原图色彩。人物尺寸小巧，位置服务故事主次分明；动作、视线、道具接触点、遮挡关系准确，人物跨越照片边界，实现真实实景与手绘想象世界相连。\n围绕一个核心情节，人物有连贯动作，表达情绪，不只是单纯站立摆姿势；多人角色有互动情感关联，不要各自独立。\n空白留白处添加一句简短英文，4-10个单词，温柔有韵味，小号随性手写字体，可分2-3行，不遮挡画面主体，不抢视觉中心。\n整体干净通透、画面疏朗，充满童趣与叙事张力，禁止贴纸堆叠、粗重描边、复杂上色、3D卡通、夸张特效、多余装饰，不加标题、水印、平台界面。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "id": 9, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}, {"outputs": [{"name": "image", "links": [6], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "empty", false, 1872524032, "randomize", "4k"], "inputs": [{"name": "image1", "link": 2, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_na