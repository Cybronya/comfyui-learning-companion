t", "link": 134, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#3f5159", "size": [230, 320], "pos": [-2380, -280], "id": 90, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 18}, {"outputs": [{"name": "output", "links": [147], "label": "output", "type": "*", "localized_name": "output"}], "color": "#2a363b", "widgets_values": ["女性，深色长发，发丝自然垂落肩部，发尾微卷，发质柔顺有光泽。身穿白色细肩带吊带上衣，上衣为V领设计，胸部有明显隆起，下摆位于腰部上方，面料紧致贴身。下身搭配深蓝色格纹百褶短裙，裙摆呈多层褶皱，裙长及大腿中部，腰带为同色系，有明显腰线。佩戴一对长款流苏耳环，耳环垂坠感强，材质为金属质感，耳环末端有装饰性元素。双手自然下垂，手指修长，指甲修剪整齐，无明显饰品。面部妆容精致，眼妆浓重，睫毛浓密卷翘，眼线清晰，唇色为自然红润，肤色白皙。背景为室内环境，光线从左侧照射，形成明暗对比，地面为浅色瓷砖。"], "inputs": [{"shape": 7, "name": "anything", "link": 146, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": true}, "type": "easy showAnything", "mode": 0, "bgcolor": "#3f5159", "size": [210, 34], "pos": [-2380, 620], "id": 97, "properties": {"cnr_id": "comfyui-easy-use", "ver": "e94405e610bce3416b6c887d6b70601ab7a32dd7", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 27}, {"outputs": [{"shape": 6, "name": "text", "links": [146], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#2a363b", "widgets_values": ["女性，深色长发，发丝自然垂落肩部，发尾微卷，发质柔顺有光泽。身穿白色细肩带吊带上衣，上衣为V领设计，胸部有明显隆起，下摆位于腰部上方，面料紧致贴身。下身搭配深蓝色格纹百褶短裙，裙摆呈多层褶皱，裙长及大腿中部，腰带为同色系，有明显腰线。佩戴一对长款流苏耳环，耳环垂坠感强，材质为金属质感，耳环末端有装饰性元素。双手自然下垂，手指修长，指甲修剪整齐，无明显饰品。面部妆容精致，眼妆浓重，睫毛浓密卷翘，眼线清晰，唇色为自然红润，肤色白皙。背景为室内环境，光线从左侧照射，形成明暗对比，地面为浅色瓷砖。"], "inputs": [{"name": "text", "link": 137, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode"