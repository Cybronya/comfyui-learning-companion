r": 6}, {"outputs": [{"name": "image", "links": [168], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["一张高端运动潮流品牌KV海报，主视觉为一件红色李宁宽松足球风短袖上衣，衣服以漂浮姿态置于画面中央，呈现立体结构与面料质感。\n\n背景设定为夜晚的足球绿茵场，远处可见模糊的球场灯光与观众看台氛围，环境中带有轻微雾气与空气颗粒，营造赛前紧张与热血情绪。\n\n画面光影采用强对比电影级灯光：主光从侧前方打出，突出衣服轮廓与褶皱细节；背后有冷色轮廓光勾边，增强立体感与分离度；环境中加入微弱红色与白色动态光线轨迹，象征速度与能量流动。\n\n加入轻微动态元素：衣服周围有被风吹动的布料边缘、空气流动、微小尘粒与光点，强化“运动瞬间冻结”的感觉。\n\n构图极简但具有冲击力，画面中心聚焦产品，左上角加入品牌口号：\n“ANYTHING IS POSSIBLE”\n字体为现代无衬线字体，粗体，略微拉宽字距，白色或浅灰色，干净有力。\n\n左上角加入小号“LI-NING”品牌logo，排版克制高级。\n画面风格现代、年轻、街头、具有球迷文化氛围，质感真实，细节清晰，8K级别清晰度，超写实渲染，商业广告摄影风格，无杂乱元素，无拼贴感。", "3:4", false, 1374521382, "randomize", "2k"], "inputs": [{"name": "image1", "link": 167, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", 