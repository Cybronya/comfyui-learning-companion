": ["产品主图"], "inputs": [{"name": "images", "link": 30, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 3, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 9}, {"mode": 0, "outputs": [{"name": "string", "links": [23], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [260.7964782714844, 88], "pos": [1526.6676025390625, 867.4559326171875], "widgets_values": ["一、整体处理：将产品从原图中单独提取出来，放置在纯白色 #FFFFFF 背景上，产品居中、完整呈现，占画面约75%；补全产品被画面裁切的缺失部分，抚平表面褶皱，使其平整挺括。原图中的一切文字、图标、图形、色块、波浪、装饰元素全部去除，一律不得保留到输出图中。\n二、部件材质：按产品事实逐部件呈现，各部件的颜色、图案、纹理与图1实物一致，表面干净无污渍。\n三、光影：左上方45°柔和主光，光影均匀；产品底部带轻微自然虚化投影，营造白底悬浮感；禁止杂乱阴影、过曝或死黑。\n四、色彩画质：还原产品真实固有色，不偏色；高清晰质感，边缘锐利干净，无白边黑边。\n五、禁忌：背景必须是100%纯白，禁止任何图案、渐变、光晕、装饰图形；禁止改变产品结构与长宽比例；禁止出现文字、水印、边框、道具、桌面、人物、车辆或其他任何物体；禁止彩色投影。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 43, "type": "Text", "title": "手动尺寸（兜底参考，in，可留空）", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 3}, {"outputs": [{"name": "image", "links": [30], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "1:1", "1k", false, 1213391535, "randomize"], "inputs": [{"name": "image1", "link": 28, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 27, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4