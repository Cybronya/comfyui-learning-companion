e": "INT"}, {"name": "input18", "type": "INT"}, {"name": "input19", "type": "INT"}, {"name": "input20", "type": "INT"}, {"name": "input21", "type": "INT"}, {"name": "input22", "type": "INT"}, {"name": "input23", "type": "INT"}, {"name": "input24", "type": "INT"}, {"name": "input25", "type": "INT"}, {"name": "input26", "type": "INT"}, {"name": "input27", "type": "INT"}, {"name": "input28", "type": "INT"}, {"name": "input29", "type": "INT"}, {"name": "input30", "type": "INT"}], "flags": {}, "id": 22, "type": "ImpactSwitch", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImpactSwitch"}, "order": 21}, {"mode": 0, "outputs": [{"name": "INT", "links": [26], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [-930, 1910], "widgets_values": [480], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 19, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 14}, {"mode": 0, "outputs": [{"name": "INT", "links": [20], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [-920, 2010], "widgets_values": [832], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 20, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 15}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [210, 313.1538391113281], "pos": [2833.956787109375, 184.38587951660156], "widgets_values": ["minimax_h3/fl2va_first_frame", "mp4", "h264", "auto"], "inputs": [{"name": "video", "link": 6, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "编码器"}, {"widget": {"name": "codec.encoding"}, "shape": 7, "name": "codec.encoding", "label": "codec.encoding", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "encoding"}], "flags": {}, "id": 12, "type": "SaveVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 31}, {"mode": 0, "outputs": [{"name": "conditioning", "slot_index": 0, "links": [14], "label": "conditioning", "type": "MINIMAX_H3_CONDITIONING", "localized_name": "conditioning"}], "size": [439.3175048828125, 352.4482727050781], "pos": [1155.2237548828125, 290.18817138671875], "widgets_values": ["### 导演设计与视觉总纲\n\n*   **导演风格定调**：本视频采用华丽而诗意的东方新现实主义电影风格（Poetic Eastern Cinematic Realism），令人联想到侯孝贤的《刺客聂隐娘》与张艺谋的武侠美学。镜头拒绝任何CG感与廉价的滤镜，追求真实物理世界的光影质感与空气流动感。采用重型三脚架上的缓速轨道横移镜头（Slow Dolly Left），并配合极细微的摇摄（Pan），以表现宏大山水与精致人文的视觉对比。焦段选用50mm电影变形镜头（Anamorphic Lens），在保证人像比例自然的同时，提供宽广的横向视野与柔和的椭圆形背景虚化光晕（Anamorphic Bokeh）。画面呈现暖阳洒在朱砂红漆上的饱满色彩，同时带有35mm柯达胶片的细腻颗粒与宽容度。\n*   **物理空间环境**：这是一处依山而建的唐宋风格木制楼阁露台。主体建筑由名贵的金丝楠木与杉木构成，外表涂抹着厚重的朱砂红漆，漆面在阳光暴晒下呈现出真实而细微的皲裂木纹。露台的雕花围栏由红木制成，栏杆上因长年受潮而带有淡淡的青苔与灰尘痕迹。露台下方是宽阔的天然高山湖泊，湖面上漂浮着大片野生的白睡莲与绿荷叶。左侧背景是一面落差数十米的天然瀑布，水流激荡在山石上，溅起大片水雾，在空气中形成薄薄的物理湿气。\n*   **光影设计**：强烈的午后侧逆阳光。太阳位于画面右上方约45度角（色温4500K），强光穿透阁楼的红色木质隔扇门，在红木柱子与地板上投影出清晰的几何光斑。阳光打在女主角的右侧身体与长发上，勾勒出一道耀眼而柔和的金边。背光的左侧山谷与水面则受天空光反射，呈现出偏冷调的青绿色，形成冷暖色调的完美交融。\n*   **主体角色**：\n    *   **沈玉澜（主角）**：约22-25岁年轻东亚女性。她拥有极其典雅端庄的东亚面孔：面部线条流畅自然，带着古典的鹅蛋脸形，眉如远黛，内双的凤眼清澈而深邃，鼻梁挺直，唇色如朱砂般红润。黑发如瀑，梳着繁复精致的唐代半翻髻，发髻上插着真玉雕刻的簪子与几缕点翠步摇，步摇上垂挂着极细的金属流苏。她身着一套考究的双层真丝齐胸衫裙：内层为淡蓝色与白色交织的桑蚕丝抹胸裙，裙摆拖地，上面有手描的云水纹；外层披着一件薄如蝉翼的乳白色轻纱大袖衫，大袖衫边缘用金线手绣着细密的忍冬纹。她纤细的右手拿着一支竹质小毫毛笔（画笔），笔尖沾有湿润的朱砂墨，在阳光下微微反光。\n\n---\n\n### 一镜到底脚本段落\n\n#### 【段落1】\n*   **视觉调子**：宏大诗意，暖阳侧照，山水氤氲，空气中飘浮着真实的水雾与尘埃。\n*   **机位与构图**：中远景（Medium Wide Shot）。画面右侧1/3为阁楼露台，红色木柱与沈玉澜的身体构成强烈的垂直线条；左侧2/3为开阔的山谷、瀑布与湖泊。镜头从右向左极其缓慢、平稳地滑行（Dolly Left），速度约为每秒0.1米，保持绝对的平稳与呼吸感。\n*   **首帧状态**：完全复现参考图片——沈玉澜侧身伫立在红色雕花栏杆旁，右手抬起，手指轻捏着毛笔，目光低垂，凝视着手中的笔尖。左侧柳树的垂柳枝在风中微微摆动，水面上有数只野生的白鹭在低空飞翔，几条红色的锦鲤在荷叶间若隐若现。\n*   **动作分段**：\n    *   `[00:00.0-00:01.5]`：**清风徐来**。沈玉澜低头静立，微风吹拂着她大袖衫的纱质衣角，轻纱在空中飘逸地向左后方摆动，真丝面料折射出丝线特有的高贵光泽。她发髻上的点翠流苏步摇随着微风产生频率一致的细微晃动。左侧垂柳的细长柳叶在画面前景中微微摇曳，伴有几片黄叶缓缓飘落。\n    *   `[00:01.5-00:03.2]`：**飞鸟掠谷与水面起涟漪**：三只真实的白色野生白鹭（非CG）从左侧瀑布的方向扇动翅膀，呈对角线轨迹向右下方滑翔，低低掠过荷花水面，在平静的水面上留下一道长长的、向外扩散的物理波纹。水面下的红白锦鲤受惊，迅速甩尾游入深水区，水面再次泛起细小的物理波澜。\n    *   `[00:03.2-00:05.0]`：**回眸与定格**：沈玉澜长睫毛微颤，她缓缓抬起头，视线从手中的毛笔移开，转向左前方的瀑布深谷。随着她转头的动作，阳光洒在她原本处于阴影中的左侧脸颊上，汗毛在逆光下清晰可辨。她大袖衫上的白纱随着动作轻轻飘落贴在手臂上。镜头继续平滑向左移，直到柳树枝叶在左侧构成完美的脏前景框，画面徐徐定格。\n\n---\n\n### 对白语言\n\n*   本视频为纯视觉意境短片，无任何角色台词对白，仅保留大自然的环境音效。\n\n---\n\n### 尾帧定格——严格执行\n\n*   **定格瞬间**：`[00:05.0]` 视频的最后一帧。\n*   **画面细节**：沈玉澜面朝左侧山谷，侧脸轮廓在阳光中如白瓷般温润。她右手中的毛笔保持静止，笔尖的朱砂墨在阳光照射下闪着一点微光。她左侧的大袖衫在空中保持飘逸的波浪定格状。前景中的柳叶微卷，左侧水面上的两只白鹭正处于翅膀向后收拢的飞翔定格状态，水面波纹形成一圈圈静止的弧线。\n*   **画面状态**：画面完全定格。镜头的横移完美停止，没有任何抖动与像素漂移。瀑布的水雾在空中凝结为静止的白色烟岚，环境声中的流水声与鸟鸣声逐渐被推远、淡出，留下一秒的绝对静谧。\n\n---\n\n### 人物入画与出画硬约束——严格遵守\n\n1.  **镜头运镜约束**：全程5秒仅使用**单机位滑轨横移，中途绝不允许出现任何形式的切镜、画面跳跃或光学变焦（Zoom）**。镜头的移动速度必须保持匀速，不可忽快忽慢。\n2.  **身体可见范围约束**：全程保持中远景。沈玉澜的身体从头顶至大腿中段必须全程在画面的右侧区域可见，由于滑轨向左移动，她身体在画面中的相对位置会缓慢向右侧边缘靠拢，但绝不能出画，必须保留她的完整上半身。\n3.  **动作自然度硬约束**：衣服和柳叶的摆动必须完全由自然风力决定。衣服面料的飘动轨迹必须柔软、滞后且符合重力法则，绝不能出现违背物理常识的空中漂浮或僵硬折角。\n\n---\n\n### 物理空间与因果链硬约束——严格遵守\n\n1.  **前景/中景/背景层次**：\n    *   前景：画面最左侧边缘约15%区域，下垂的柳条与深绿色的柳叶（大光圈虚焦），随着风在镜头前晃动，增加画面前后的深度感。\n    *   中景：沈玉澜、红漆楼阁围栏、朱红木柱、露台上的石质香几（焦点清晰）。\n    *   背景：大片白莲花水面、飞翔的白鹭、远处的瀑布与层叠的中国古典塔楼（中度虚焦，水雾弥漫）。\n2.  **物理因果链锁定**：\n    *   风速加强 → 柳叶与大袖衫同时向左后方摆动，摆动幅度与方向完全一致。\n    *   白鹭贴水飞行 → 翅膀扇动带动的气流与脚蹼触水 → 在水面形成以触点为中心的同心圆水波。\n    *   阳光穿过花窗 → 照在红漆地面上 → 随着镜头横移，地面上的光斑形状根据木栏杆的阻挡关系产生相应的物理透视移动。\n\n---\n\n### 面部造型一致性锁定——跨镜头100%一致\n\n*   **沈玉澜面部特征锁死（全程100%一致）**：\n    *   **眼部**：内双凤眼，眼线自然拉长，眼珠为深棕色，睫毛长而黑，左侧眼角微翘。\n    *   **面部五官与轮廓**：鹅蛋脸，下巴线条圆润，人中深而明显。嘴唇饱满，下唇正中有一道极细微的天然唇纹。\n    *   **固定特征**：沈玉澜的右侧耳垂上戴着一枚由白玉与红玛瑙拼接而成的葫芦形耳坠，在打斗或转头动作中，耳坠必须跟随物理重力自然摇晃，且葫芦的材质与颜色全程绝对不能发生改变或移位。\n\n---\n\n### 音效分层总表\n\n1.  **环境铺底**：自然的中国山水白噪音。包括左侧背景中远处的瀑布轰鸣声（低频，音量-18dB）、微风吹过山谷与柳树叶的“沙沙”声（音量-15dB）、湖水轻轻拍击楼阁石基的微弱水声（音量-22dB）。\n2.  **动作拟音**：\n    *   `[00:00.5]`：风吹起真丝大袖衫，衣料在空中翻卷产生的细柔“拂拂”声。\n    *   `[00:01.8]`：白鹭低空掠过水面时，羽翼扇动空气的“扑扑”声与足尖点水的轻微“哔剥”声。\n    *   `[00:03.2]`：沈玉澜转头时，头戴的金属步摇流苏相互碰撞发出的极微弱、清脆的“叮当”金属撞击声。\n3.  **人声分层**：无台词。仅有沈玉澜深呼吸时，气流通过鼻腔的微弱呼吸声（音量-25dB）。\n\n---\n\n### 调性总述 (英文关键词)\n\n`live-action cinematic realism, non-CGI, non-animation, non-anime, photorealistic, 35mm film grain, cinematic slow dolly-left shot, 50mm anamorphic lens, shallow depth of field, natural golden hour sunlight, volumetric fog, misty waterfall in background, traditional Chinese architecture, red lacquered wooden pavilion, ancient scholar woman, white silk Hanfu, flowing sleeves, high-quality silk texture, hairpins with tassels, holding Chinese calligraphy brush, red ink, calm water with white lotuses, flying egrets, real physical wind blowing, serene and poetic atmosphere, color contrast of red wood and teal water, award-winning cinematography, masterpiece, 8k.`"], "inputs": [{"name": "h3_text_encoder", "link": 9, "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"name": "h3_vae_bundle", "link": 10, "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BUNDLE", "localized_name": "h3_vae_bundle"}, {"name": "target", "link": 11, "label": "target", "type": "MINIMAX_H3_TARGET", "localized_name": "target"}, {"name": "keyframes", "link": 8, "label": "keyframes", "type": "MINIMAX_H3_FL_KEYFRAMES", "localized_name": "keyframes"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 7, "type": "RHMiniMaxH3FL2VAEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3FL2VAEncode"}, "order": 26}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate