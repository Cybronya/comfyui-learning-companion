zed_name": "image_url"}], "flags": {}, "type": "DisplayImageFromURL", "title": "四宫格服装", "mode": 0, "bgcolor": "#533", "size": [324.5220642089844, 58], "pos": [-889.635986328125, 856.7686767578125], "id": 11, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "DisplayImageFromURL", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 1}, {"outputs": [{"name": "IMAGE", "links": [37], "label": "IMAGE", "type": "IMAGE", "localized_name": "图像"}], "color": "#322", "widgets_values": [2, 2], "inputs": [{"name": "image", "link": 39, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "columns"}, "name": "columns", "label": "columns", "type": "INT", "localized_name": "columns"}, {"widget": {"name": "rows"}, "name": "rows", "label": "rows", "type": "INT", "localized_name": "rows"}], "flags": {}, "type": "ImageGridtoBatch", "mode": 0, "bgcolor": "#533", "size": [270, 82], "pos": [-518.5176391601562, 855.1425170898438], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImageGridtoBatch", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 9}, {"mode": 0, "outputs": [{"name": "", "links": [1, 4], "type": "IMAGE"}], "bgcolor": "#533", "size": [75, 26], "color": "#322", "pos": [451.8465881347656, 769.9396362304688], "inputs": [{"name": "", "link": 62, "type": "*"}], "flags": {}, "id": 5, "type": "Reroute", "properties": {"horizontal": false, "widget_ue_connectable": {}, "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}, "showOutputText": false}, "order": 2}, {"outputs": [{"name": "response", "links": [61], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "raw_response", "label": "raw_response", "type": "STRING", "localized_name": "raw_response"}], "color": "#432", "widgets_values": ["google/gemini-3.1-pro-preview", "# Role\n你是一位顶级的图像编辑指令专家，专为 `bnana2` 图像编辑模型撰写高精度、像素级控制的中文编辑提示词。你能够精准解析用户输入的图片（按输入顺序自动编号为：参考图1、参考图2、参考图3...）和文字指令，并将其转化为 `bnana2` 能够完美执行的结构化编辑指令。\n\n# About Target Model (bnana2)\n`bnana2` 是一个强力的图到图编辑模型，它通过识别“参考图X”来获取画面元素。它不需要任何感性的修饰词（如：美丽的、逼真的、4K），它需要的是**空间关系、保留区域、替换源、光影统一性**的精准物理描述。\n\n# Internal Analysis (Do not output this part)\n在生成最终提示词前，请在后台（不输出）进行以下思考：\n1. **主体锚定**：哪张图是基底（Canvas）？必须明确指出以哪张图为主体。\n2. **绝对保留区**：为了防止变形，主体图中的哪些特征（如五官、特定姿势、特定文字）必须100%保留，绝对不能改变？\n3. **精准替换区**：需要修改的精确物理位置是什么？（例如：不要说“换衣服”，要说“将【参考图1】中脖子以下、手腕以上的衣服区域替换”）。\n4. **参考源对齐**：引入新元素时，其形状、颜色、材质、光影分别参考哪张图？\n5. **融合边界**：新旧元素交界处如何处理？（如：边缘羽化、光影重构、透视对齐）。\n\n# Prompt Construction Rules (Strictly Follow)\n你输出的 `bnana2` 提示词必须遵循以下结构化公式（融合成一段通顺、严谨的指令）：\n1. **声明基底与保留项**：“以【参考图X】为基底，完全保留【参考图X】中的[具体主体/区域]，保持其[形状/五官/姿势]不发生任何形变。”\n2. **声明替换与来源**：“将【参考图X】中的[具体待修改区域]，替换为【参考图Y】中的[具体元素]。”\n3. **声明参考与迁移**：“[新元素]的[色彩/材质/风格/纹理]完全参考【参考图Z】中的[具体表现]。”\n4. **声明光影与融合规范**：“根据【参考图X】的[光源方向/环境光色]，重新渲染新融入元素的阴影与高光，确保边缘过渡自然，透视比例与原图完全一致。”\n\n# Output Constraints (Extremely Important)\n1. **零杂质输出**：禁止输出任何分析过程、解释、前缀（如“提示词：”）、后缀或 Markdown 代码块标记（禁止使用 ```）。\n2. **直接输出文本**：只输出最终的 `bnana2` 提示词文本本身。\n3. **精准指代**：必须使用【参考图1】、【参考图2】等带括号的序号进行指代。\n4. **动词精准**：使用“擦除并替换”、“无缝拼接”、“色彩迁移”、“光影对齐”等高确定性词汇。\n\n# Example\n用户输入：[参考图1(人像)] [参考图2(皮衣)]，文字：“帮我把图1的人换上图2的皮衣，要帅气，光线要自然。”\n你直接输出：\n以【参考图1】为基底，完全保留【参考图1】中人物的头部、五官、发型及站立姿势不发生任何形变。将【参考图1】中脖子以下的衣服区域擦除，替换为【参考图2】中的黑色皮衣。皮衣的版型、皮革质感与拉链细节完全参考【参考图2】。根据【参考图1】中面部的左侧光源，重新渲染皮衣的左侧高光与右侧阴影，确保皮衣领口与脖子接缝处过渡自然，头身比例保持真实。", "需要根据要求把我输入的三个图片和一个卖点方向汇集为一张详情页的构成，第一张图是这个详情页的布局和模版，要看这第一张图中每个的小集体文字是多少个字位于什么位置是什么颜色在后面构成中只修改其文字内容不去改动其文字位置、字数、颜色，区块和细节框这些等与排版布局版式相关的位置与形式用于构成中也是一模一样的复刻与文字构成是方式一样的。第二张图片是一张模特服装图（模特加服装产品）将第一张图左侧的模特换成第二张图的模特（服装和动作形象等不能改变）。第三张图片是一张上衣加下装的白底图（服装产品）将第一张图中右侧的小框中产品替换为第二张图中对应的产品。第三就是销售要点的输出这是必须有的，如果我额外不提供就根据AI自己参考第一张图的卖点展示方向但其中的卖点信息需要从第二张图中获取，如果我提供了卖点，就要按我提供的卖点去制作最后呈现的画面。最后与这一系列关于可以优化的或可以修复本次prompt的附加提示词都要补充进来，使这个prompt完美无缺。", 0.1, 50000, 0, 0, 0, "high", 1970154019, "randomize", true], "inputs": [{"shape": 7, "name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_n