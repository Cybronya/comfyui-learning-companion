pe": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 5}, {"mode": 4, "outputs": [{"name": "image", "links": [70], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [712.60205078125, 911.2662963867188], "pos": [-3815.527587890625, 2036.8614501953125], "widgets_values": ["保持柜子结构细节不变，保持拍摄角度不变\n① 风格（Style）\n\n风格：现代包豪斯风格，中古复古设计，几何秩序审美，理智温润\n\n② 产品主体（Product）\n\n产品：暖棕色木质框配黑色双门及银色金属格栅隔板的轻巧鞋柜/客厅隔断柜，做客厅与玄关区域隔断、进门鞋履收纳、日常随手物品置物使用状态，左侧靠墙摆放\n\n③ 写实程度（Realism）\n\n写实：\n真实家居摄影风格，\n非概念设计图，\n真实比例，\n真实光影，\n真实材质反射\n\n⑤ 场景布置（Scene Setup）\n\n场景布置：\n地面：原木色人字拼实木复合地板 + 右前景铺设宝蓝色地毯一角\n背景墙：纯白色乳胶漆墙面，中上方墙面挂有包豪斯风几何图案装饰画，右侧靠近白纱窗帘柔光区域\n家具搭配：左前方带金属拉手的黑色室内门，右后方紧贴带有金属框架、深灰色皮革拉扣与绿色靠枕的复古皮沙发\n软装元素：鞋柜最高层台面摆放卡通长耳兔玩偶摆件、彩魔方与黑色复古蓝牙音箱；抽屉左侧摆放香薰玻璃瓶与叠放的书籍；底板上摆放三双居家拖鞋\n\n⑥ 光线（Lighting）\n\n光线：超写实8K超清室内效果图，柜子表现出高级质感，柔和漫反射自然光，专业商业渲染，光影整体明亮层次丰富，细节锐利，材质真实，V-ray渲染品质，画面干净通透，室内暖色辅助光为辅，光线柔和，局部阴影细腻，带有稀疏树影由实至虚打在墙面上\n\n\n⑦ 构图与视角（Composition）\n\n构图：\n竖向构图，\n远景右斜侧微俯视视角，\n右斜侧微俯视机位，\n玄关门边、隔断角落与沙发区域完整呈现，\n产品主体位于画面视觉中心\n\n⑧ 画面约束（Negative Prompt）\n\n排除：\n无人物，\n无夸张造型，\n无强设计感，\n无未来感，\n无商业摄影棚痕迹，\n无过度干净画面", 13939147, "randomize", "3:4", "4k", false, "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 209, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6