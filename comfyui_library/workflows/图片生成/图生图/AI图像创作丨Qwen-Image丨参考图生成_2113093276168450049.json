存参数包含 25 步、CFG 1、euler 采样器、beta 调度器、denoise 1、分辨率数值 1280；用途依据静态节点和连接分析，未声明已实跑验证。", "title": "AI图像创作丨Qwen-Image丨参考图生成"}, "VHS_latentpreviewrate": 0, "frontendVersion": "1.55.14"}, "groups": [{"color": "#387f74", "font_size": 26, "flags": {}, "id": 1, "title": "01 输入素材", "bounding": [40, 40, 361.7913818359375, 1185.3094482421875]}, {"color": "#936d36", "font_size": 26, "flags": {}, "id": 2, "title": "02 提示词与尺寸", "bounding": [485.7913818359375, 40, 334, 202]}, {"color": "#626eab", "font_size": 26, "flags": {}, "id": 3, "title": "03 模型与加速", "bounding": [903.7913818359375, 40, 574, 540]}, {"color": "#646e80", "font_size": 26, "flags": {}, "id": 4, "title": "04 编码与条件", "bounding": [1561.7913818359375, 40, 836.83837890625, 1150]}, {"color": "#976179", "font_size": 26, "flags": {}, "id": 5, "title": "05 采样生成", "bounding": [2482.629638671875, 40, 343.6587829589844, 388.6455383300781]}, {"color": "#3d7897", "font_size": 26, "flags": {}, "id": 6, "title": "06 结果与对比", "bounding": [2910.28857421875, 40, 377.81805419921875, 1386.93701171875]}], "links": [[731, 479, 0, 481, 1, "VAE"], [733, 482, 0, 481, 0, "LATENT"], [734, 483, 0, 482, 3, "LATENT"], [735, 480, 0, 483, 1, "LATENT"], [736, 477, 0, 484, 0, "MODEL"], [737, 484, 0, 482, 0, "MODEL"], [738, 485, 0, 482, 1, "CONDITIONING"], [739, 485, 1, 482, 2, "CONDITIONING"], [740, 485, 2, 483, 0, "LATENT"], [807, 481, 0, 518, 0, "IMAGE"], [819, 481, 0, 526, 1, "IMAGE"], [820, 526, 0, 527, 0, "IMAGE"], [822, 524, 0, 526, 0, "IMAGE"], [743, 478, 0, 485, 0, "CLIP"], [745, 479, 0, 485, 2, "VAE"], [825, 516, 0, 485, 3, "STRING"], [827, 530, 0, 485, 1, "IMAGE"], [828, 530, 0, 524, 0, "IMAGE"], [829, 470, 0, 530, 0, "IMAGE"], [830, 531, 0, 530, 2, "INT"], [831, 531, 0, 530, 3, "INT"], [832, 532, 0, 485, 6, "IMAGE"], [833, 532, 0, 524, 1, "IMAGE"], [834, 522, 0, 532, 0, "IMAGE"], [835, 531, 0, 532, 2, "INT"], [836, 531, 0, 532, 3, "INT"], [837, 530, 1, 480, 0, "INT"], [838, 530, 2, 480, 1, "INT"]], "id": "54bb395d-3e60-4c94-b525-85523901575b"