type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 13}, {"mode": 0, "outputs": [{"name": "prompt", "links": [301], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [860.3366088867188, 273.0297546386719], "pos": [-1101.43896484375, 190.47280883789062], "widgets_values": ["\"facelock_identity\": \"true\",\n\n\"accuracy\": \"100%\",\n\n\"scene\": \"具有鲜明Y2K风格的剪贴簿海报设计，色彩鲜艳的贴纸；多人穿着相同的服装和发型，但姿势和剪影各异；画面中运用了丰富的色彩线条和框架less的拼贴技巧。包含以下元素：特写镜头（手指呈心形）；全身蹲姿，托腮同时手持白色宝丽来相机；半身像（轻触脸颊并吹着粉色泡泡糖）；半身像（优雅微笑并抱着猫咪）；坐姿（一只眼睛眨眼并做出和平手势）；半身像（手持雏菊）。画面还融入了全息纹理、淡色调渐变、闪亮装饰、有趣的涂鸦以及杂志剪裁图案，整体布局虽混乱却充满美感。\"\n\n\"main_subject\": {\n\n  \"description\": \"剪贴簿中心的主要人物是一位具有Y2K风格的年轻女性。\"\n\n  \"style_pose\": \"活泼自信的Y2K姿势——轻微侧身，一只手拿着带有镜头光晕效果的钥匙扣；面朝镜头，表情可爱又酷炫；嘴角微微撅起，展现出21世纪初的随意氛围。\"\n\n},\n\n\"outfit\": {\n\n  \"top\": \"剪裁过的 oversized 淡色调毛衣，上面绣有图案\"\n\n  \"bottom\": \"淡色调裙子，搭配白色腰带\"\n\n  \"socks\": \"白色短袜，带有彩色淡色调条纹\"\n\n  \"shoes\": \"白色运动鞋\"\n\n  \"accessories\": [\n\n    \"彩色塑料手链\"\n\n    \"粗大的彩色戒指\"\n\n    \"闪亮的肚链\"\n\n  ]\n\n  \"hairstyle\": \n\n    \"type\": \"Y2K风格的半扎半披发型\"\n\n    \"details\": \"使用淡色调花朵发夹固定头发；前额的头发呈波浪状，下部带有泡泡糖粉色的色调，呈现出21世纪初的经典造型。\"\n\n},\n\n\"additional_visuals\": \n\n  \"心形、星星和蝴蝶形状的贴纸\"\n\n  \"复古风格的闪亮装饰\"\n\n  \"宝丽来相机相框\"\n\n  \"霓虹色轮廓\"\n\n  \"涂鸦边框\"\n\n  \"杂志剪裁文字：'太可爱了！'、'199X!'、'女孩风！'\"\n\n  \"淡色调灯光\"\n\n  \"光泽感十足的复古氛围\"\n\n  \"极具美感的剪贴簿布局\"\n\n},\n\n\"photography_rendering\": {\n\n  \"color_grading\": \"电影风格的霓虹色调（Y2K风格）\"\n\n  \"lighting\": \"柔和的闪光灯效果\"\n\n  \"skin_texture\": \"光滑有光泽的皮肤质感\"\n\n  \"rendering\": \"高细节、超逼真的Y2K风格剪贴簿效果\"\n\n  \"quality\": \"8K分辨率\"\n\n  \"composition\": \"布局完美且充满艺术感\"\n\n},\n\n\"negative_prompt\": \"禁止使用任何破坏Y2K风格的现实主义元素；禁止使用2020年代的现代服装；禁止画面构图混乱；禁止脸部模糊或手部变形；禁止出现多余的肢体或脸部扭曲；禁止使用低分辨率或颗粒感强的图片；禁止使用暗淡的色彩；禁止添加水印或AI处理痕迹。\""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "p