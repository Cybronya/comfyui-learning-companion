mage"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD"}], "flags": {}, "type": "LoadImage", "title": "01 · 输入图片 476 [476]", "mode": 0, "bgcolor": "#252b35", "size": [270, 314], "pos": [72, 120], "id": 476, "properties": {"cnr_id": "comfy-core", "ver": "0.36.0", "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}, {"outputs": [{"name": "output", "label": "output", "type": "*"}], "color": "#646e80", "widgets_values": ["为输入图中的人物生成一张竖幅第一人称视角的车内手机抓拍画面，镜头从人物胸前位置向下拍摄，完整延续该人物的真实摄影质感与肤色、年龄段身份特征，取景范围为胸部以下、仅纳入她坐在停放的宾利驾驶位上自然伸向方向盘的双腿和双脚。双腿膝盖靠近画面下方、双脚在方向盘上方轻轻交叉，其中一只脚抬得更高、脚底朝向镜头露出足弓轮廓，另一只脚收在后方支撑，整体姿态松弛自然；双臂自然垂放于身体两侧、手部处于画面下缘之外。双腿穿着一双简约轻薄、半透明的白色连裤袜，丝面贴合腿部与脚部轮廓并带细微织纹和克制柔和的光泽，膝盖、脚踝与脚趾处呈现自然的轻微褶皱和拉伸感，脚趾数量准确、形态完整，透过薄纱可见真实自然的皮肤质感。车内为高级宾利内饰：黑色真皮方向盘带清晰缝线，中央的飞翼造型圆形徽标中心露出清晰的金属字母\"B\"；方向盘后方为圆形仪表盘，画面左侧是深色木纹饰板、金属圆形空调出风口与黑色皮革车门，座椅边缘露出浅米色打孔真皮材质。清晨的暖调阳光从前挡风玻璃和左侧车窗斜射入车内，在丝袜受光面形成温暖明亮的高光、在腿部侧面投下方向盘的真实阴影，车内黑色区域保留丰富暗部细节；整体为低饱和暖色调，呈现细腻皮革纹理、木纹与金属反光及自然景深。构图采用轻微广角透视，车内线条略带倾斜，前景双腿占据大部分画面，背景仪表盘和方向盘清晰但略微虚化，氛围真实生活化的手机随手拍质感。右上角以黑色、字重中等的清晰无衬线字体分两行排布，第一行为\"Qwen\"，第二行为\"Image 2.1\"；人物肤色与身体特征始终与输入图保持一致，画面仅呈现双腿与双脚这一主体。"], "inputs": [{"shape": 7, "name": "anything", "link": 770, "label": "anything", "type": "*"}], "flags": {}, "type": "easy showAnything", "title": "编码与条件 · 499", "mode": 0, "bgcolor": "#252b35", "size": [210, 88], "pos": [2016, 1376], "id": 499, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 23}, {"outputs": [{"name": "LATENT", "links": [737], "label": "LATENT", "type": "LATENT"}], "color": "#646e80", "widgets_values": [1024, 1024, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 743, "label": "width", "type": "INT"}, {"widget": {"name": "height"}, "name": "height", "link": 744, "label": "height", "type": "INT"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "labe