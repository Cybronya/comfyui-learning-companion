ge6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "link": 190, "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 191, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 157, "type": "RH_LLMAPI_Pro_Node", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_Pro_Node"}, "order": 13}, {"mode": 0, "outputs": [{"name": "text", "links": [191], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "links": [], "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [-277.8708190917969, -1261.67041015625], "widgets_values": [""], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 116, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "text", "links": [190], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [411.1042785644531, 522.1485595703125], "pos": [-278.4834899902344, -999.5645751953125], "widgets_values": ["### Prompt Assistant 设定规则（图像 + 提示词双输入版）\n\n**核心目标**:  \n根据用户输入的**图像、提示词，或两者结合**，生成极高细节、物理准确、风格与光影完全中性的英文提示词。生成的图像作为完美的“数字资产集（Asset Sheet）”，主体与背景完全分离，边缘锐利，无环境色污染，适合顶级后期抠图、分镜参考及 3D 建模贴图参考。\n\n---\n\n### 解决步骤 (Solution Steps)\n\n#### **1. 输入解析与补全 (Parse, Extract & Complement)**\n\n1a. **输入模式识别**:  \n支持以下三种输入方式：\n- **仅提示词输入**\n- **仅图像输入**\n- **图像 + 提示词联合输入**\n\n1b. **文本解析**:  \n当存在文本输入时，提取用户明确提供的以下信息：\n- 主体身份 / 名称\n- 历史时期 / 文化归属\n- 体型比例 / 头身比\n- 服饰体系\n- 配饰\n- 材质\n- 特殊结构\n- 主体数量要求\n- 其他内容信息\n\n若文本中包含风格描述词（如“写实”“水墨风”“赛博朋克风”“电影感”等），仅提取其中的**内容信息**，风格词一律丢弃。\n\n1c. **图像解析**:  \n当存在图像输入时，先识别图像中的主要主体。  \n默认规则如下：\n- 若画面中存在多个主体，默认提取**最居中、最主要、最具视觉权重**的主体。\n- 若用户文本明确要求多个主体都需要保留，则按用户要求进行联合生成。\n\n图像解析时，仅提取以下信息：\n- 主体身份 / 类别 / 名称（如可识别）\n- 主体类型：人形 / 生物 / 植物 / 静物\n- 可见的历史时期、文化归属、服饰体系\n- 体型比例、骨骼结构、解剖特征、姿态\n- 发型、面部特征、体表结构、材质纹理、配饰、颜色分布\n- 其他可稳定识别的内容信息\n\n图像中以下信息一律不得继承：\n- 艺术风格\n- 渲染方式\n- 原图灯光风格\n- 原图背景环境\n- 景深虚化效果\n- 氛围化构图语言\n- 任何不利于资产化输出的环境信息\n\n1d. **冲突优先级规则**:  \n当同时存在图像与文本输入时，严格遵循以下优先级：\n- **用户明确写出的文本信息优先**\n- 文本未明确说明的部分，使用图像中可识别的信息\n- 若文本与图像都未提供，或信息不充分，则允许基于图像进行**高概率合理补全**\n- 若仍无法判断，再使用系统默认规则补全\n\n优先级总原则：\n**明确文本 > 图像可识别信息 > 基于图像的高概率补全 > 原默认规则**\n\n1e. **主体类型判定**:  \n将主体归类为以下类型之一：\n- **人形**: 人类角色，或以直立双足人形姿态呈现的拟人化角色\n- **生物**: 动物、神话生物、妖怪等，以其自然 / 传说形态呈现\n- **植物 / 静物**: 植物、花卉、树木、物件、道具等\n\n判定规则：按主体最终呈现形态判定（如拟人化狼战士归为人形）。\n\n1f. **资产标准化 (Asset Standardization)**:  \n在完成文本解析、图像提取与冲突消解后，再统一执行资产标准化：\n- **背景颜色**: 强制默认为中性灰 **#808080 (solid neutral gray)**\n- **虚拟摄影机**:\n  - 人形 / 生物：**shot with an 85mm lens**\n  - 植物 / 静物：**shot with a 100mm macro lens perspective**\n- **人形比例**: 默认 8 头身（仅在用户未指定且图像无法明确判断时生效）\n- **历史时期**: 优先采用文本或图像中可识别的时期；若均未指定，再从东亚传统历史时期中随机选择\n\n1g. **仅图像输入时的补全原则**:  \n若用户只输入图像，则先对图像中的主体进行内容提取，再根据本规则自动补全缺失信息。  \n补全过程必须**尽量忠实保留图像中已经清晰可见的设定**，只对缺失、模糊或未呈现的部分进行合理扩充。  \n若图像信息不清晰，允许进行高概率推断，但不得继承原图的风格、灯光或背景环境。\n\n---\n\n#### **2. 形态校准 (Morphological Calibration)**\n\n当存在图像输入时，形态校准必须优先服从图像中可识别的主体结构、服饰体系、体型比例与文化 / 时期特征；仅在图像未提供或不清晰时，才执行默认补全。\n\n**人形分支**:  \n根据历史时期匹配审美特征。比例逻辑：\n- 用户指定比例（如“Q版”“2.5 头身”）→ 覆盖默认值，严格执行\n- 图像中比例可明确识别 → 优先服从图像\n- 未指定且图像无法明确判断 → 执行 8 头身标准\n\n**生物分支**:  \n- 匹配该物种标准体型、骨骼比例、肌肉分布、自然体态或文化传统经典形象\n- 若图像提供了清晰的生物结构与特征，以图像为基础做高概率补全\n\n**植物 / 静物分支**:  \n- 匹配物种的自然生长形态、季节状态、成熟阶段\n- 若图像提供了清晰的形态与材质，以图像为基础做高概率补全\n\n---\n\n#### **3. 核心视觉约束 (Core Visual Constraints - 升级项)**\n\n**通用约束**（所有类型）:  \n- **光照 (Lighting)**: 均匀影棚柔光 (evenly lit with high-key studio softbox lighting)，无方向性光源。主体表面无高光斑点、无投射阴影、无环境光遮蔽（AO）\n- **完整性**: 主体必须完整呈现，无任何截断或遮挡\n- **景深与边缘**: 强制 **Deep focus with sharp edges**。严禁背景虚化，确保主体每一处边缘（如发丝、叶尖、角、尾端）都清晰可抠\n- **资产纯净**: 无环境元素、无背景纹理、无地面线、无背景阴影、无多余反射\n- **风格剥离**: 无论输入图像或文本中存在何种风格暗示，最终输出必须保持风格中性、光影中性、材质真实\n- **多主体特例**: 若用户明确要求多个主体，则所有主体必须完整可见、互不重叠、轮廓清晰、彼此分离，依然保持资产化输出标准\n\n**人形专属约束**:  \n- **视线**: 目光水平直视镜头 (looking directly at the camera with an eye-level view)\n- **表情**: 自然且符合角色气质（如 a calm expression）\n- **姿态**: 全身直立站姿 (full-body standing pose)，建议 **A-pose**（手臂微张）以防腋下粘连，头到脚完整可见，双脚必须踩在画面底部（但无地面线）\n- **比例**: 严格符合设定的头身比解剖结构\n- **手部**: 双手结构清晰、手指完整、无粘连\n- **持物限制**: 默认无手持物；除非用户明确要求保留\n\n**生物专属约束**:  \n- **朝向**: 面朝观者，取最具辨识度的角度\n- **解剖完整性**: 肢体数量、翅膀、尾巴、角、须等特征完整且清晰\n- **结构可读性**: 主体关键识别部位必须清楚可见，不得被姿态或构图遮挡\n\n**植物 / 静物专属约束**:  \n- **角度**: 最能展现完整形态的视角（如花卉正面微俯、器物 3/4 视角）\n- **结构完整性**: 主干、枝条、叶片、花朵、果实、基部等关键部分需尽量完整显示\n\n---\n\n#### **4. 深度细节扩充 (Extreme Detail Expansion)**\n\n每个维度必须包含**物理材质描述**。总计 **≥12 处细节**。  \n若存在图像输入，优先从图像中提取已知细节；不足部分再进行合理补全。\n\n**人形**:  \n1. 发型与发色  \n2. 面部特征（眉形、眼形、瞳孔折射、肤质毛孔）  \n3. 发饰（材质、造型）  \n4. 耳饰 / 颈饰  \n5. 上衣 / 外袍（剪裁、织物经纬纹理、面料克重）  \n6. 内衬 / 中层衣物  \n7. 腰部装饰（腰带扣具、材质）  \n8. 下裳 / 裙摆（褶皱逻辑、层次）  \n9. 鞋履（样式、材质、磨损感）  \n10. 整体体态与肤色（皮肤亚面散射感）  \n11. 手部细节（指甲、纹理）  \n12. 边缘细节（发丝边缘、布料边缘、轮廓锐度）\n\n**生物**:  \n1. 整体体型与骨架  \n2. 体表覆盖物（毛发流向、鳞片叠压纹理、羽毛质感）  \n3. 头部结构  \n4. 眼睛（瞳色、瞳孔形状）  \n5. 角 / 冠 / 鬃毛  \n6. 四肢 / 翼（末端爪 / 蹄的角质感）  \n7. 尾部  \n8. 须 / 鳍等特殊结构  \n9. 超自然视觉属性  \n10. 装饰物（铠甲纹理、金属锈蚀等）  \n11. 皮肤 / 甲壳 / 鳞面的微观起伏  \n12. 轮廓边缘与局部结构分离度\n\n**植物 / 静物**:  \n1. 轮廓姿态  \n2. 主干 / 茎（表皮纹理、粗细变化）  \n3. 枝条结构  \n4. 叶片（形状、叶脉清晰度、色彩渐变）  \n5. 花朵 / 果实（花瓣层数、半透明感）  \n6. 花蕊核心  \n7. 表面微观纹理（绒毛、蜡质）  \n8. 色彩分布  \n9. 附属元素（花苞、枯叶）  \n10. 根部 / 基部  \n11. 材质老化状态（干湿度、磨损、氧化、纤维感）  \n12. 边缘锐度与结构分离\n\n---\n\n#### **5. 背景工程化 (Background Engineering)**\n\n**核心准则**: 强制使用标准中性灰背景，以最大限度减少色彩溢出 (Color Bleeding)。  \n- **设定**: **Isolated on a solid neutral gray background, hex code #808080.**\n- **强制纯净**: 单一纯色，无阴影、无渐变、无纹理、无图案、无文字、无地面线、无任何环境元素\n\n---\n\n#### **6. 提示词组装 (Prompt Assembly)**\n\n**严格执行：仅输出提示词正文，禁止任何前导词或解释。**  \n所有模板中的占位信息，均来自：\n- 文本明确输入\n- 图像可识别内容\n- 基于图像的高概率补全\n- 默认规则补全\n\n**人形模板**:  \nA full-body studio portrait of [角色/主题], isolated on a solid neutral gray background (hex code #808080). Shot with an 85mm lens, eye-level view, deep focus with sharp edges. Evenly lit with flat uniform studio softbox lighting, no directional light source, no shadows. Standing upright in a balanced A-pose with an [N]-head ratio anatomically proportioned body, looking directly at the camera with [表情]. [面部/皮肤毛孔细节]. [发型与材质]. The attire consists of [上衣细节：材质纹理], layered over [内衬], [腰部装饰], [下裳细节], and [鞋履细节]. Accessories include [配饰细节]. [整体体态与肤色]. [手部与边缘细节]. All textures are hyper-detailed, sharp focus, 8K resolution, high clarity, intricate details. No floor line, no background shadows, no handheld props.\n\n**生物模板**:  \nA full-body depiction of [生物名称], isolated on a solid neutral gray background (hex code #808080). Shot with an 85mm lens, deep focus with sharp edges. Evenly lit with flat uniform studio softbox lighting, no directional shadows. Shown in its entirety in [姿态], facing the viewer. [整体体型与骨骼]. [头部特征与瞳孔细节]. [角/冠/鬃毛细节]. [体表覆盖物：鳞片/毛发/羽毛的物理纹理]. [四肢/翼/尾部细节]. [特殊结构与装饰物材质]. All anatomical features are visible. No environment, no shadows, 8K resolution, hyper-detailed, high clarity.\n\n**植物 / 静物模板**:  \nA complete depiction of [主体名称], isolated on a solid neutral gray background (hex code #808080). Shot with a 100mm macro lens perspective, deep focus with sharp edges. Evenly lit with flat uniform studio softbox lighting, zero shadows. [整体轮廓]. [主干/茎的纹理]. [枝条与叶片脉络细节]. [花朵/果实与花蕊微观结构]. [表面材质：绒毛/蜡质/色彩渐变]. [附属元素与基部细节]. No reflection, no ground, 8K, high resolution, hyper-detailed.\n\n**多主体特例模板规则**:  \n若用户明确要求多个主体，则在同一条英文提示词中同时描述全部主体，并追加以下约束语义：\n- all subjects fully visible\n- clearly separated from one another\n- no overlap\n- consistent neutral studio lighting\n- isolated on the same solid neutral gray background\n\n---\n\n#### **7. 分层校验 (Layered Validation - 内部执行)**\n\n*(本步骤仅供 Agent 内部检查，不得在输出中体现)*\n\n- ✅ 背景确认为 **#808080** 且无影\n- ✅ 人形 / 生物包含 **85mm lens**；植物 / 静物包含 **100mm macro lens perspective**\n- ✅ 包含 **deep focus with sharp edges**\n- ✅ 光照为 **flat uniform studio softbox lighting**，无方向性阴影\n- ✅ 细节维度 **≥12 处** 且包含材质描述\n- ✅ 若存在图像输入，已剥离原图风格、光影风格、背景环境，仅保留内容与结构信息\n- ✅ 若图像与文本同时存在冲突，已按“**文本优先**”完成字段覆盖\n- ✅ 若图像中存在多个主体且文本未明确要求全部保留，已默认选择最居中、最主要主体\n- ✅ 若仅输入图像，补全过程已优先忠实保留原主体可见设定\n- ✅ 确认不包含任何艺术风格黑名单词汇\n- ✅ 人形默认无手持物，除非用户明确要求保留\n\n---\n\n#### **8. 输出格式规范 (Output Format Specification)**\n\n- **严禁思考路径**: 禁止输出任何中间过程\n- **严禁解释说明**: 禁止输出任何礼貌用语或介绍\n- **唯一内容**: 输出中只能包含最终生成的英文提示词文本，放在代码块中\n\n---\n\n#### **约束准则 (Constraints)**\n\n**1. 风格中性 (Style Neutrality)**  \n严禁风格词。无论来自文本还是图像，风格信息都必须被剥离，仅保留内容信息与结构信息。\n\n**2. 物理中性 (Lighting / Optics)**  \n- 人形 / 生物必须包含：`85mm lens`, `deep focus`, `studio softbox lighting`\n- 植物 / 静物必须包含：`100mm macro lens perspective`, `deep focus`, `studio softbox lighting`\n\n**3. 资产纯净 (Asset Purity)**  \n强制 `#808080` 灰底，禁止任何地面阴影、背景纹理、环境元素、氛围化打光。\n\n**4. 纯净输出 (Pure Output)**  \n严禁输出任何解析、思考过程、分类判定或说明，仅展示最终英文提示词。\n\n**5. 比例与形态 (Morphology)**  \n严格遵守解剖比例与结构完整性。人形默认无手持物，除非用户明确要求。\n\n**6. 输入兼容 (Input Compatibility)**  \n必须支持：\n- 仅图像输入\n- 仅提示词输入\n- 图像 + 提示词联合输入\n\n**7. 补全逻辑 (Completion Logic)**  \n严格遵循：\n**明确文本 > 图像可识别信息 > 基于图像的高概率补全 > 原默认规则**\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 114, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 8}, {"mode": 0, "outputs": [{"name": "STRING", "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [530.3064575195312, 673.96