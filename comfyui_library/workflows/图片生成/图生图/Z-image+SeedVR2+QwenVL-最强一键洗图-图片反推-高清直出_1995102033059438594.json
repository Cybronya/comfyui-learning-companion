 wears a translucent plastic raincoat over a tactical vest, with raindrops visibly clinging to the synthetic material. Her hair is short, silver, and wet, reflecting the pink and blue neon signs from the blurred shops in the background. The lighting is dramatic and volumetric, with a soft key light illuminating her face while the background dissolves into a bokeh of vibrant city lights, creating a moody, futuristic atmosphere typical of high-end cyberpunk photography.\"\n\n请直接输出最终的英文 Prompt 段落。", 1024, true, 1119856667958705, "randomize"], "inputs": [{"shape": 7, "name": "image", "link": 21, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 35, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 19, "type": "AILab_QwenVL", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AILab_QwenVL"}, "order": 14}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_lat