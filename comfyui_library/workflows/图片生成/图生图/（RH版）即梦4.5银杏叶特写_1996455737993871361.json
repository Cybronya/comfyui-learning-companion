eInt"}, "order": 9}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [274.080078125, 314], "pos": [-139.599365234375, 240.22584533691406], "widgets_values": ["9284db642f5c33a91fb05927980607518ecec2aa4a323d22aed322359983fa8c.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 2, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}, {"mode": 0, "outputs": [{"name": "prompt", "links": [19], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [411.70758056640625, 457.5674133300781], "pos": [163.43460083007812, 240.5224151611328], "widgets_values": ["【主体保留与优化】\n- 保留：人物近景特写（腰部以上），半侧身{站立/侧蹲/侧坐}（身体与镜头呈{30°/45°}），面部正对镜头（正脸清晰，五官完整），保留五官、发型）；\n- 穿搭改造：替换为{白色/蓝色}时尚裙子（{收腰款/纱质款/法式款}，领口{V领/方领/圆领}）穿搭贴合上半身，细节清晰；\n- 肤色优化：面部肤色冷白通透，无蜡黄感、无暗沉，保留皮肤原生纹理（毛孔、轻微绒毛），唇色自然红润，眼周去暗沉，整体肤色与场景光线协调；\n【构图与层次（核心要求）】\n- 前景：{1片清晰银杏叶（肩头点缀）/一支清晰银杏叶（脸颊侧上方不能挡住脸）/叶片脉络分明、金黄饱满，与人物有前后层次感；\n- 主体：人物占据画面60%-70%，半侧身姿态自然（肩膀一高一低，身体微倾），正脸无歪斜，面部居中不偏移；\n- 背景：浅景深模糊处理的黄灿灿的银杏大道远景（{交错的银杏树枝/铺满落叶的地面/银杏叶拱廊}），模糊程度适中（不丢失银杏氛围），不抢人物焦点；\n【光影匹配（脸部白皙+突出层次）】\n- 光源：{清晨柔和侧光（从清晰树叶一侧照射）/阴天漫射光+局部补光}，光线均匀照射面部，清晰树叶表面带轻微高光（突出质感），避免面部阴影堆积；\n- 面部光影：额头、鼻梁、苹果肌带细腻高光，下颌线阴影柔和，正脸五官立体不扁平，无偏黄；\n- 树叶光影：清晰银杏叶的明暗对比自然，叶脉处有阴影，边缘带轻微光晕，与人物光影统一；\n【氛围强化】\n整体氛围：{清新温柔/时尚精致/日系纯欲/电影感文艺}，色调以“冷白面部+{白色/蓝色}穿搭+金黄清晰树叶+模糊暖黄背景”为主，对比度{柔和/适中}；\n【质量要求】\n超高清（8K），细节拉满（面部纹理、睫毛、发丝、裙子褶皱、银杏叶脉络），清晰树叶无模糊，人物与前景/背景融合自然，无拼接痕迹，层次感强，适合打印输出（肤色还原准确，树叶色彩鲜亮）。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 9, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [191.0528294600997, -98.3316474328505], "scale": 1.2839025177495136}}, "groups": [], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 1, 0, 3, 0, "IMAGE"], [10, 13, 0, 12, 1, "STRING"], [11, 14, 0, 13, 0, "*"], [12, 15, 0, 13, 1, "*"], [13, 11, 0, 13, 2, "INT"], [14, 16, 0, 13, 3, "*"], [15, 19, 0, 13, 4, "*"], [16, 20, 0, 13, 6, "*"], [17, 18, 0, 13, 7, "*"], [18, 17, 0, 13, 8, "*"], [19, 9, 0, 12, 0, "STRING"], [20, 12, 0, 1, 10, "STRING"]], "id": "77e47d63-6d2a-44d9-b139-a75c6b212761", "config": {}, "version": 0.4, "last_node_id": 20, "revision": 0}