现面部表情、发型和上衣细节。\n\n- 右侧面板（约占总宽度的 2/3）：同一主体的全身正交视图三视图，比例和垂直基线精确对齐，包含：\n\n• 正面视图：从头到脚的完整身高，面向镜头，自然站姿\n\n• 侧面视图：标准的 90° 纯侧面轮廓，全身，自然姿势\n\n• 背面视图：后侧全身视图，显示头部后方、躯干和腿部，保持与其他两张视图相同的构图高度和脚部对齐方式\n\n人物的身份、面部特征、比例、发型、身材比例、服装和整体造型必须与参考图像完全一致；所有面板的背景必须统一为白色背景。\n\n严禁添加任何文字、水印、徽标、字幕、用户界面元素、边框、面板标签（A/B/C/1/2/3）、角度标注、测量指南或任何其他类型的附加内容。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#355", "size": [436.71875, 392.78125], "pos": [-1778.64111328125, 627.4028930664062], "id": 186, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 5}, {"outputs": [{"name": "VAE", "slot_index": 0, "links": [332, 336], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "color": "#2a363b", "widgets_values": ["qwen_image_vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "type": "VAELoader", "mode": 0, "bgcolor": "#3f5159", "size": [341.157958984375, 59.77386474609375], "pos": [-1268.6229248046875, 425.6875], "id": 175, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"directory_invalid": true, "name": "qwen_image_vae.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/vae/qwen_image_vae.safetensors"}], "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "VAELoader", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 6}, {"outputs": [{"name": "MODEL", "links": [346], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#2a363b", "widgets_values": ["Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", 1], "inputs": [{"name": "model", "link": 343, "label": "model", "type": "MODEL", "localized_name": "model"},