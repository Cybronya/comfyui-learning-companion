"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4"}, "widget_ue_connectable": {}, "aux_id": "IuvenisSapiens/ComfyUI_Qwen3-VL-Instruct", "Node name for S&R": "Qwen3_VQA"}, "order": 18}, {"mode": 0, "outputs": [{"name": "output", "links": [397], "label": "output", "type": "*", "localized_name": "output"}], "size": [379.5164794921875, 311.8501281738281], "pos": [398.6543273925781, 681.4067993164062], "widgets_values": ["温暖的午后阳光斜洒进厨房，一位年轻女子正专注地站在燃气灶前烹饪。她留着齐肩短发，发梢微卷，眉眼清秀，嘴角含着浅浅笑意，目光温柔地望向镜头，仿佛在分享她亲手烹制的美味。她身着米白色针织毛衣，外搭一件卡其色围裙，围裙系带自然垂落，肩带为黑色，整体造型简约而居家。她右手持木勺轻搅锅中食材，左手稳握锅柄，动作娴熟流畅，锅中米饭与胡萝卜、青豆、肉丁等色彩缤纷的配料在蒸汽氤氲中翻滚，热气袅袅升腾，为画面增添生活气息。\n\n前景聚焦于正在加热的橙红色铸铁锅，锅底蓝色火焰清晰可见，锅沿微微泛光，锅内食材色彩饱满，颗粒分明。灶台旁的白色瓷碗盛着切好的青椒块，旁边一颗鲜红番茄静置，构图层次分明，引导视线从锅中食材自然延伸至女子的面部表情。中景是女子的上半身，她微微侧身，身体姿态舒展自然，围裙下摆轻垂，与背景形成视觉平衡。背景为浅色瓷砖墙面与木质置物架，架上整齐摆放着玻璃罐装坚果与调味品，悬挂的木铲与硅胶铲增添生活质感，窗台绿植在光影中若隐若现，营造出温馨治愈的居家氛围。\n\n画面采用中近景构图，人物占据视觉中心，构图稳定而富有呼吸感。光线从左侧窗户柔和倾泻，形成明暗对比，人物面部与手臂被暖光勾勒，锅具边缘与食材表面反射出细腻高光，背景则略显虚化，突出主体。整体色调以暖黄、米白、卡其为主，辅以食材的橙红与青绿，色彩和谐统一，营造出宁静、治愈、充满烟火气的日常氛围。光影柔和，氛围温暖，仿佛能听见锅铲轻碰锅壁的轻响，闻到饭菜的香气，唤起观者对家常美食与平凡幸福的共鸣。画面具有真实感与生活美学，如同业余设备拍摄的自然瞬间，却饱含细腻情感与艺术温度。"], "inputs": [{"shape": 7, "name": "anything", "link": 395, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 258, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 20}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [530], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [384.34149169921875, 106], "pos": [856.96728515625, 699.9063110351562], "widgets_values": ["qwen_3_4b.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"nam