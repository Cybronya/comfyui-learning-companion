ionery aesthetic, pinterest scrapbook, clean lighting, high resolution.\""], "inputs": [{"name": "ref_image", "link": 29, "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {"collapsed": false}, "id": 30, "type": "RH_Captioner", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Captioner"}, "order": 4}, {"mode": 0, "outputs": [{"name": "image", "links": [21, 27], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [414.2779541015625, 564.716796875], "pos": [994.221435546875, 504.55224609375], "widgets_values": ["", 837533563, "randomize", "3:4", "1k", "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 20, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 30, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"nam