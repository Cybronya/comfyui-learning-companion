get": {"name": "cfg"}, "name": "cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 321, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 26}, {"mode": 0, "outputs": [{"name": "output", "links": [397], "label": "output", "type": "*", "localized_name": "output"}], "size": [379.5164794921875, 311.8501281738281], "pos": [-306.2706298828125, 551.9632568359375], "widgets_values": ["一位年轻女性坐在阳光洒落的咖啡馆内，她身着米白色高领针织毛衣，发丝柔顺自然垂落肩头，眉眼清澈，神情专注地凝视镜头，右手轻握一杯拉花咖啡，杯口奶泡细腻如云朵。前景是木质桌面与洁白瓷碟，碟面干净无物，光影在桌面上投下柔和的暖色斑驳。中景聚焦于人物上半身，毛衣纹理清晰可见，袖口微微卷起，耳畔垂坠一枚小巧金色耳环，增添精致感。背景虚化处理，隐约可见咖啡馆内部陈设：黑板菜单、陈列糕点的玻璃柜、悬挂绿植与木质桌椅，暖黄吊灯从上方洒下柔光，营造出温馨宁静的日常氛围。构图采用中近景特写，人物居中偏右，视线直抵观者，引导情感共鸣。光影运用自然光为主，从右上方斜射入窗，照亮人物侧脸与发丝，形成明暗对比，强化立体感与温柔氛围。整体色调以暖棕、米白、浅木色为主，辅以绿植点缀，营造出治愈、慵懒、充满生活气息的午后时光。画面质感细腻，如真实胶片或专业相机拍摄，细节丰富却不喧宾夺主，氛围宁静而富有诗意，仿佛时间在这一刻温柔停驻。"], "inputs": [{"shape": 7, "name": "anything", "link": 395, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": true}, "id": 258, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 20}, {"mode": 0, "outputs": [{"name": "STRING", "links": [395], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [369.8070373535156, 421.6905517578125], "pos": [-507.3238830566406, 552.59326171875], "widgets_values": ["你是一位专业的AI图像生成提示词工程师。请详细描述