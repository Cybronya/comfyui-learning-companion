": "text", "links": [23], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [306.3388366699219, 208.90081787109375], "pos": [881.40771484375, 892.0828857421875], "widgets_values": ["1 苹果手机实拍质感 通用空间渲染"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 12, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 2}, {"mode": 0, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [210, 88], "pos": [1557.5020751953125, 1083.156494140625], "widgets_values": ["把上传的图片做成四宫格图片，一张画布均分 4 格，每一格为同一张室内效果图，**严格锁定原图空间结构、家具布局、物体位置、材质色彩、透视不变，每一格仅光影质感不同，不改动空间造型，不增删物体**。\n左上【第 1 格：苹果手机实拍质感】：苹果手机实拍居家照片，温润自然光，35mm 人眼视角，真实居家生活氛围，材质纹理真实，柔和光斑阴影，明亮通透。\n右上【第 2 格：光影洗图优化】建筑空间摄影，优化自然光影，物理日光，柔和窗影，虚实渐变阴影，提升光影层次，高端写实建筑摄影，材质原色不变。\n左下【第 3 格：午后暖调实景】下午 14-16 点暖调自然光，色温 3500K 暖白光，多层立体室内灯光，细腻通透光影，模型转为真实相机实景照片。\n右下【第 4 格：清冷 PBR 写实】PBR 物理级写实渲染，冷调漫反射自然光，冷暖光影对冲，全画幅相机拍摄，低饱和克制色彩，消除 CG 塑料感，材质细节拉满。\n4 张画面构图完全一致，仅光影、质感风格区分，干净背景排版，四格清晰分割，室内设计效果图对比图，高清，8k。\n\n## 负面提示词\n\n改变构图，改动家具，新增物体，删除物体，物体变形，透视畸变，水印，文字，卡通，手绘，油画，人物，多余杂物，过曝死黑，色彩错乱，格子大小不一致，空间造型改动。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "id": 3, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [578, 474], "pos": [1311.5579833984375, 901.3695678710938], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 17, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 6