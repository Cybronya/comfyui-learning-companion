localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [467.2058410644531, 429.858154296875], "pos": [4397.49658203125, -485.5100402832031], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 45, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 49, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 24}, {"mode": 0, "outputs": [{"name": "text", "links": [48], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [460.5636901855469, 452.11151123046875], "pos": [3720.53173828125, -399.72760009765625], "widgets_values": ["     根据我上传的室内户型平面图，生成一张与原平面方案严格对应的 3D 轴测空间展示图。必须以原图为唯一空间依据，完整保留原有户型轮廓、墙体关系、房间数量、房间位置、门窗开口、门洞方向、家具布局、柜体位置、厨房与卫生间设备位置、阳台结构及主要尺寸比例，不擅自增删房间，不重新规划户型，不改变原始空间功能。\n\n      参考图2的光影及灯光添加逻辑，风格严格参考第二张图的风格，添加暖黄氛围灯（落地灯、床头灯、筒灯），细腻环境光与柔和阴影，线条干净，写实渲染。不改变图1的户型结构\n将原本的二维平面图准确转换为三维轴测 / 等距视角的室内空间模型，采用顶部开放式切墙表现，使各个房间、家具与空间关系清晰可见。墙体需具有真实厚度，门窗、柜体、床、沙发、餐桌、书桌、厨柜、洁具等均按照原平面图中的位置和比例进行立体还原。\n      \n       根据原图已有的设计信息，对不同区域补充合理且克制的室内材质，例如木地板、石材或瓷砖、木饰面柜体、玻璃、金属和布艺家具，使整体具有真实的 3D 室内设计模型质感，但不要改变原方案的设计逻辑。使用柔和自然的建筑空间光照，增加适量环境光、接触阴影和物体投影，使墙体、家具、柜体、地面产生真实的空间层次，避免过度戏剧化光影。整体保持明亮、干净、专业。在 3D 图周围使用简洁中文标注和细线引导，标记主要功能空间，最终画面采用白色背景、专业室内设计方案板风格，构图整洁，空间主体完整，不裁切重要区域，标注清晰易读，整体类似专业建筑 / 室内设计中的 3D 轴测户型展示图，可用于方案汇报、空间说明和设计展示。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true, "collapsed": false}, "id": 51, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 11}, {"outputs": [{"name": "image", "links": [45, 49], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "re