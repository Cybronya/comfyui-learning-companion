e": "图层数据"}], "size": [270, 106], "pos": [3716.434814453125, 824.2598876953125], "widgets_values": ["向下", 0, "#FFFFFF"], "inputs": [{"name": "图层数据", "link": 36, "label": "图层数据", "type": "PSD_LAYERS", "localized_name": "图层数据"}, {"widget": {"name": "排版方式"}, "name": "排版方式", "label": "排版方式", "type": "COMBO", "localized_name": "排版方式"}, {"widget": {"name": "间距"}, "name": "间距", "label": "间距", "type": "INT", "localized_name": "间距"}, {"widget": {"name": "间距颜色"}, "name": "间距颜色", "label": "间距颜色", "type": "STRING", "localized_name": "间距颜色"}], "flags": {}, "id": 33, "type": "HAIGC_CombineUnits", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "HAIGC_CombineUnits"}, "order": 32}, {"outputs": [{"name": "text", "links": [10], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#332922", "widgets_values": ["生成图中产品的详情页，保持产品的一致性，五张图。一枚18K玫瑰金钻石戒指，双带交织成流动的无限结造型，隐现心形负空间；戒圈密镶圆形明亮式小钻，群镶如星河倾泻，火彩璀璨却不刺眼；金属表面高度抛光，暖调粉金色泽柔润温雅，线条圆润流畅，无棱角设计贴合指间；置于纯白柔光台面，浅景深背景虚化出淡雅干花轮廓，左上方自然光勾勒立体高光与细腻阴影，整体呈现高级珠宝静物摄影质感——象征永恒联结、自我珍爱与低调浪漫，兼具现代设计感与情感叙事力，轻奢优雅，适合订婚、纪念日或独立女性日常佩戴"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#593930", "size": [367.0680236816406, 171.51072692871094], "pos": [351.0314025878906, 188.3111114501953], "id": 11, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}, {"mode": 0, "outputs": [{"name": "output", "type": "*", "localized_name": "output"}], "size": [292.7795715332031, 338.3056640625], "pos": [1226.847412109375, 167.61703491210938], "widgets_values": ["一张高级珠宝电商主图海报，画面正中央是一枚18K玫瑰金钻石戒指，双带交织成流动的无限结造型，隐现心形负空间，戒圈密镶圆形明亮式小钻。戒指置于纯白柔光台面上，浅景深背景虚化出淡雅干花轮廓。画面上方带有优雅的衬线体中文标题“无限爱意”，左上方自然光勾勒出戒指的立体高光与细腻阴影。8K分辨率，高级静物摄影，暖调柔和光线，轻奢优雅质感。\n\n一张展示珠宝工艺细节的微距摄影图，极近距离特写18K玫瑰金无限结戒指的局部交织处，清晰展现金属表面的高度抛光与温雅粉金色泽，以及戒圈上群镶如星河倾泻的璀璨小钻。纯净的高级白背景，局部柔和反光。画面侧边排版有精致的中文卖点词“臻致微镶 璀璨如星”。宏大微距镜头，景深极浅，光影通透，极高清晰度，商业珠宝修图标准。\n\n一张充满浪漫氛围的珠宝场景图，18K玫瑰金无限结满钻戒指静静放置在柔软起伏的裸粉色真丝缎面上，背景光影斑驳，营造出低调浪漫的清晨光线。画面留白处包含现代简约的中文文案“悦己之光 优雅随行”。暖调粉金色泽柔润温雅，情感叙事力强，电影级光影，柔焦效果，高端时尚杂志内页风格。\n\n一张聚焦珠宝设计美学的展示图，45度角侧俯拍这枚18K玫瑰金交织钻石戒指，完美呈现双带交织的无棱角圆润线条与隐现的心形负空间。戒指放置在具有细腻纹理的纯白石膏几何底座上，形成视觉对比。画面右侧配有极简的中文排版“隐秘心意 灵动流线”。专业影棚布光，精准的轮廓光勾勒金属边缘，对比度适中，极简现代设计感。\n\n一张极具仪式感的礼遇场景海报，18K玫瑰金无限结钻石戒指半倚在高级的浅米色天鹅绒首饰托盘上，周围散落着几片淡雅的白色干花花瓣与透亮的露珠。画面中心醒目位置带有高级质感的中文标题“奢宠挚爱 见证永恒”。整体画面明亮通透，左上方自然窗光倾洒，火彩璀璨但不刺眼，洋溢着轻奢优雅的纪念日氛围，8K超高清，商业广告大片质感。"], "inputs": [{"shape": 7, "name": "anything", "link": 8, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 7, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 16}, {"mode": 0, "outputs": [], "size": [367.1844482421875, 727.8585815429688], "pos": [902.5923461914062, 727.25146484375], "widgets_values": ["不分层"], "inputs": [{"shape": 7, "name": "图像", "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"shape": 7, "name": "遮罩", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}, {"shape": 7, "name": "图层数据", "link": 35, "label": "图层数据", "type": "PSD_LAYERS", "localized_name": "图层数据"}, {"shape": 7, "name": "背景配置", "label": "背景配置", "type": "HAIGC_BG_CONFIG", "localized_name": "背景配置"}, {"widget": {"name": "文件名前缀"}, "name": "文件名前缀", "label": "文件名前缀", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 32, "type": "HAIGC_SavePSD", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "HAIGC_SavePSD"}, "order": 24}, {"mode": 0, "outputs": [{"name": "图层数据", "links": [35], "label": "图层数据", "type": "PSD_LAYERS", "localized_name": "图层数据"}], "size": [270, 106], "pos": [2348.494140625, 424.5534362792969], "widgets_values": ["向下", 0, "#FFFFFF"], "inputs": [{"name": "图层数据", "link": 3, "label": "图层数据", "type": "PSD_LAYERS", "localized_name": "图层数据"}, {"widget": {"name": "排版方式"}, "name": "排版方式", "label": "排版方式", "type": "COMBO", "localized_name": "排版方式"},