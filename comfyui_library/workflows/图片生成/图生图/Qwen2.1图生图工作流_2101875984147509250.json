widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {"pinned": true}, "id": 505, "type": "UNETLoader", "properties": {"models": [{"directory_invalid": true, "name": "qwen_image_2.1_int8_convrot.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 10}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [481.2332763671875, 269.6382141113281], "color": "#fff0", "pos": [1486.2822265625, 4290.88037109375], "inputs": [], "flags": {"pinned": true, "allow_interaction": true}, "id": 522, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#121212", "borderRadius": 19, "textAlign": "left", "widget_ue_connectable": {}, "fontSize": 18, "backgroundAlpha": 0.25, "lineHeight": 1.2, "text": "保持<image1>中角色的形象和姿势不变，让角色穿上<image2>中的这件浅蓝色牛仔衬衫，同时保留原有的面部特征、发型、体型和姿势\n\n保持<image1>中角色的形象不变，让角色穿上<image2>的深V礼服，图像背景参考<image3>，让角色姿势参考<image4>中角色的姿势。保持图1角色原有的面部特征、发型、体型。\n\n提示词没有固定写法。实在不知道如何写，把图给豆包，提需求让它写。", "stroke": true, "fontColor": "#C8C8C8"}, "order": 11}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [480.2189025878906, 258.24755859375], "color": "#fff0", "pos": [1487.3692626953125, 4576.48291015625], "inputs": [], "flags": {"pinned": true, "allow_interaction": true}, "id": 516, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#121212", "borderRadius": 19, "textAlign": "left", "widget_ue_connectable": {}, "fontSize": 18, "backgroundAlpha": 0.25, "lineHeight": 1.2, "text": "Qwen Image 2.1 原生支持 2K（2048×2048）的直接输出。但时间会变长，建议1024后接放大。或者为0，以图1尺寸输出（最大不超过2048）\n\n## 参考图像\n- 最多 10 张参考图像（image_1 至 image_10）。\n- 在提示词中以 `<image1>`、`<image2>` 等形式提及它们。\n- image_1 是编辑目标，其余均为参考图像。额外的参考图像在尺寸或宽高比上可以不同。尺寸输出只遵循 image_1。可以更改出图尺寸，详情见“采样区”\n", "stroke": true, "fontColor": "#C8C8C8"}, "order": 12}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [848.9730224609375, 48.61853790283203], "color": "#fff0", "pos": [2001.0196533203125, 4728.05615234375], "inputs": [], "flags": {"pinned": true, "allow_interaction": true}, "id": 532, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#850f95", "borderRadius": 19, "textAlign": "left", "widget_ue_connectable": {}, "fontSize": 18, "backgroundAlpha": 0.25, "lineHeight": 1.2, "text": "  图2                                                   图3                                                   图4", "stroke": true, "fontColor": "#C8C8C8"}, "order": 13}, {"outputs": [{"name": "IMAGE", "links": [834], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#323", "widgets_values": ["pasted/10a8ce78d6c37782c6e04dadfdeb4e6e63b35212bf8fbdfefcb4ace10488930d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#535", "size": [274.080078125, 314], "pos": [2574.085205078125, 4829.11083984375], "id": 526, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 14}, {"outputs": [{"name": "IMAGE", "links": [832], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#323", "widgets_values": ["pasted/d6ba5663c79d6ef86f8d705d1f34ad879a24c559f4f19dfa48c90b22749d0df6.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "local