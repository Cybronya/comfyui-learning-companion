nconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"outputs": [{"name": "text", "links": [157, 163], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["一幅写意洒脱的中国水墨画，泼墨间尽显豪迈气象。画面中央，一只神采奕奕的灵猴身着正红色官袍，袍角随疾风猎猎翻飞，帽檐上的翎羽斜挑出几分灵动。它稳稳端坐于一匹奔腾的骏马脊背之上，骏马四蹄腾空，鬃毛与长尾如墨瀑般向后舒展，寥寥数笔便勾勒出风驰电掣的速度感，蹄下似有烟尘滚滚，满纸皆是昂扬的动感。远山以淡墨晕染，留白处恰似辽阔长天，衬得人马身姿愈发挺拔俊朗。画面右上方题四字行书 “马上封侯”，笔力遒劲，与洒脱的画风浑然一体，既点明了封侯拜相的吉祥寓意，更添几分豪迈开阔的气韵，整幅作品宏阔大气，兼具笔墨意趣与祥瑞之美。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#335", "size": [460, 270], "pos": [350, 1640], "id": 61, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 8}, {"outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#223", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 162, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#335", "size": [1160.9090576171875, 827.6968994140625], "pos": [3083.732177734375, 1443.7843017578125], "id": 116, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 22}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": tru