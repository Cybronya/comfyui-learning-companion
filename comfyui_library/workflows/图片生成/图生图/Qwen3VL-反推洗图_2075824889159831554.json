": 2917, "label": "scale_to_length", "type": "INT", "localized_name": "scale_to_length"}, {"widget": {"name": "background_color"}, "name": "background_color", "label": "background_color", "type": "STRING", "localized_name": "background_color"}], "flags": {"disabled": false}, "type": "LayerUtility: ImageScaleByAspectRatio V2", "mode": 0, "bgcolor": "#0e464f", "size": [376.36083984375, 375.0774230957031], "pos": [813.7727661132812, -4274.61474609375], "id": 550, "properties": {"cnr_id": "comfyui_layerstyle", "ver": "90f4bfb38aaf121292f429b20eff07c6c121697e", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: ImageScaleByAspectRatio V2"}, "order": 6}, {"outputs": [], "color": "#322", "widgets_values": ["重要提醒：\n数值0.7就是对于原图的参考幅度，1：代表全部靠提示词去生成，数值越低重绘幅度越低，对于原图的参考就越多。工作流完成后会有声音提示。\n\n"], "inputs": [], "flags": {"disabled": false}, "type": "Note", "mode": 0, "bgcolor": "#533", "size": [371.96099853515625, 134.54403686523438], "pos": [430.6712341308594, -4025.716796875], "id": 538, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}}, "order": 2}, {"outputs": [{"name": "STRING", "links": [2923], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#223", "widgets_values": ["{\n  \"subject\": \"一位年轻女性，拥有柔顺的深棕色长发，自然垂落在肩头，她正低头专注地书写，眼神温柔地注视着纸页，嘴角带着一丝浅浅的微笑，表情宁静而专注。她身穿一件米白色镂空针织毛衣，毛衣的纹理清晰可见，袖口宽松，露出纤细的手腕，左手自然地搭在石墙上，右手握着一支细长的棕色钢笔，笔尖轻触纸面。\",\n  \"foreground\": \"一块粗糙的石墙，表面布满风化的纹理和斑驳的痕迹，石墙的边缘微微翘起，呈现出自然的质感，石墙的表面在阳光下反射出柔和的光泽，石墙的缝隙中隐约可见几片干枯的草叶。\",\n  \"midground\": \"主体正坐在石墙的边缘，石墙下方是一片开阔的草地，草地上点缀着几朵野花，草叶随风轻轻摇曳，远处有一棵粗壮的树干，树干上覆盖着茂密的绿叶，树影斑驳地投射在石墙上，形成明暗交错的图案。\",\n  \"background\": \"背景是一片茂密的森林，树木高大挺拔，枝叶繁茂，树叶在阳光下呈现出深绿色和浅绿色的层次，天空被树叶遮挡，只露出几缕蓝色的缝隙，远处的树冠在阳光下形成柔和的光晕，整个背景呈现出一种宁静而神秘的氛围。\",\n  \"composition\": \"构图采用三分法，主体位于画面的右下角，石墙占据画面的下半部分，形成稳定的视觉基础。背景的树木和天空形成对角线引导线，引导观众的视线从前景延伸至背景。整体画面采用低角度拍摄，突显主体的专注与宁静。\",\n  \"visual_guidance\": \"观众的视线首先被石墙的纹理和主体的双手吸引，然后自然地跟随钢笔的轨迹移动至纸页，接着被主体温柔的眼神和微笑所吸引，最后延伸至背景的森林和天空，形成从近到远的视觉引导。光影在主体的面部和毛衣上形成柔和的对比，突出主体的轮廓。\",\n  \"color_tone\": \"柔和的暖色调，整体画面以米白色、深棕色和绿色为主，点缀着阳光照射下的金色光斑，营造出温暖而宁静的氛围。\",\n  \"lighting_mood\": \"柔和的自然光，光线从画面的左上方斜射而下，形成微妙的背光轮廓光，照亮主体的发丝和毛衣边缘，同时在石墙和草地上投下柔和的阴影，营造出宁静而温馨的氛围。\",\n  \"caption\": \"一位年轻女性坐在粗糙的石墙边缘，身穿米白色镂空针织毛衣，低头专注地用棕色钢笔在纸上书写，她温柔的眼神和浅浅的微笑在柔和的自然光下显得宁静而专注，背景是茂密的森林和斑驳的树影，石墙的纹理和草叶的细节在画面中形成丰富的层次，整体画面采用三分法构图，低角度拍摄，营造出温暖而宁静的氛围。\"\n}", "Qwen3-VL-4B-Instruct", "8bit", false, 0.7, 2048, 200704, 1003520, 294, "randomize", "eager"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 2703, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "min_pixels"}, "name": "min_pixels", "label": "min_pixels", "type": "INT", "localized_name": "min_pixels"}, {"widget": {"name": "max_pixels"}, "name": "max_pixels", "label": "max_pixels", "type": "INT", "localized_name": "max_pixels"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget