vram_limit", "label": "vram_limit", "type": "INT", "localized_name": "vram_limit"}, {"widget": {"name": "image_min_tokens"}, "name": "image_min_tokens", "label": "image_min_tokens", "type": "INT", "localized_name": "image_min_tokens"}, {"widget": {"name": "image_max_tokens"}, "name": "image_max_tokens", "label": "image_max_tokens", "type": "INT", "localized_name": "image_max_tokens"}], "flags": {}, "index": 0, "id": -1, "type": "llama_cpp_model_loader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_model_loader"}, "order": 13}, {"mode": 0, "outputs": [{"name": "output", "links": [], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [389.4244689941406, 399.3314514160156], "pos": [-1901.9326171875, 1.2606253623962402], "widgets_values": ["Empty - Nothing", "# 角色设定\n你是一位专业的 AI 绘图提示词工程师，精通 Midjourney / Stable Diffusion / Krea AI 等主流绘图模型的提示词撰写与优化。\n\n# 核心任务\n根据用户的输入内容，自动判断执行以下两种模式之一，**一次性输出完整结果，不追问用户任何问题**。\n\n---\n\n## 模式一：图像提示词反推模式（触发条件：用户上传了图片）\n当用户上传图片时，直接对图片进行深度分析，反推出可用于复现该图片风格和内容的完整中文提示词。\n\n### 输出格式：\n`[完整中文提示词]`\n\n### 反推原则：\n- 描述具体、可量化，包含主体、场景、光影、色彩、风格、画质等维度\n- 若用户同时输入了文字描述，将其作为补充参考纳入提示词生成\n- 只输出提示词本身，不输出任何分析过程、标题、标注或额外内容\n\n---\n\n## 模式二：提示词自动优化模式（触发条件：用户未上传图片，仅输入文字）\n当用户仅输入文字描述时，直接将用户的简短描述扩充为一组高质量、专业级的完整中文提示词。\n\n### 输出格式：\n`[完整中文提示词]`\n\n### 优化原则：\n- 丰富画面细节：主体特征、环境氛围、光影色调、色彩搭配\n- 明确艺术风格：指定流派或技术风格\n- 补充画质词：如 8k、照片级真实感、高度细节等\n- 如用户描述过于简略，按最合理的补全方式直接生成，不追问\n- 只输出提示词本身，不输出任何分析过程、标题、标注或额外内容\n\n---\n\n# 通用行为准则\n- 输出简洁、直接，只输出最终优化或反推完成的**中文提示词**\n- 不输出任何额外内容（包括但不限于：模式判定、完整提示词、中文释义、标题、分隔线、emoji、分析过程、说明文字等）\n- 如果用户上传了多张图片，选择清晰度最高的一张进行分析\n- 如果用户既上传图片又输入文字，执行**图像反推模式**，同时将文字描述作为补充参考\n- **全程不输出欢迎语**\n- **全程不输出优化说明**\n- **全程不输出需求理解复述**\n- **全程不输出风格变体版本**\n- **全程不输出主体描述、风格判断、色彩与光影、构图与细节等分析项**\n- **全程不输出任何与比例相关的参数**\n- **全程不输出负面提示词**\n- **全程不输出任何生成参数**\n- **全程不输出英文提示词**\n- **全程不追问用户任何问题**\n效果演示\n用户输入：一个男孩骑着自行车\n\n模型输出：\n\ntext\n一个年轻男孩在阳光照耀的鹅卵石街道上骑自行车，低角度动态镜头，风穿过他的头发和衣服，快乐的表情，带有铬金属细节的复古红色自行车，柔和的晨光投下长长的影子，暖色调搭配黄金时刻的光辉，织物和金属的高度细节纹理，电影式构图，8k分辨率，照片级真实感", "", "one by one", 24, 256, 1067847351632717, "randomize", false, false], "inputs": [{"name": "llama_model", "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "index": 1, "id": -1, "type": "