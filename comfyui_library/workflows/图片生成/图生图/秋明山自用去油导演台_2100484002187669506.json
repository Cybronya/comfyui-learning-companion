t\":124,\"durationSec\":5,\"prompt\":\"女孩单人跳舞。动作踩点。音乐动感。\",\"negativePrompt\":\"\",\"taskType\":\"\",\"refs\":[],\"refAudios\":[],\"refVideos\":[],\"genImage\":{\"imageFile\":\"fb7c0e7f423e4f572068760cee01a5d4c4f541ac0ae354895dcb586ab07b8615.png\",\"fileName\":\"\"},\"startImage\":null,\"endImage\":null,\"continuityFromPrev\":false,\"refImageSize\":\"match\"}],\"timelineMode\":\"prompt_batch\",\"width\":576,\"height\":736,\"refMaxSize\":736,\"gen\":{\"defaultFrameCount\":124},\"keyframes\":[],\"durationSec\":5,\"shots\":[],\"liveTaePreview\":true,\"batchDetailMode\":\"solo\",\"videoWorkspaces\":{\"rv2v\":{\"selectedIndex\":0,\"currentFrame\":0,\"editMode\":\"global\",\"runSelectEnabled\":false,\"runSelection\":[],\"totalFrames\":124,\"frameRate\":24,\"storageWidth\":736,\"storageHeight\":32,\"segments\":[],\"video\":{\"fileName\":\"\",\"videoFile\":\"\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[],\"deletedSourceRanges\":[],\"sourceFrameCount\":0,\"width\":0,\"height\":0,\"storageWidth\":736,\"storageHeight\":32},\"videoClips\":[],\"globalCommon\":{\"commonEnabled\":false,\"commonCollapsed\":false,\"prompt\":\"\",\"refs\":[],\"refAudios\":[],\"refVideos\":[]}},\"v2v\":{\"selectedIndex\":0,\"currentFrame\":0,\"editMode\":\"global\",\"runSelectEnabled\":false,\"runSelection\":[],\"totalFrames\":240,\"frameRate\":24,\"storageWidth\":736,\"storageHeight\":416,\"segments\":[{\"id\":\"mu576q8okocfz\",\"start\":0,\"length\":240,\"prompt\":\"\",\"taskType\":\"\",\"refs\":[],\"referenceVideo\":{\"videoFile\":\"\",\"fileName\":\"\",\"type\":\"input\",\"subfolder\":\"\"},\"refAudios\":[],\"refVideos\":[],\"genImage\":{\"imageFile\":\"\",\"fileName\":\"\"},\"frameCount\":240,\"negativePrompt\":\"\"}],\"video\":{\"fileName\":\"akina_previs_1280x720.mp4\",\"videoFile\":\"ebb3e1f54f5feed4a69fa88110ede54275b6d17c885439578abf5ed4028fba58.mp4\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[],\"deletedSourceRanges\":[],\"sourceFrameCount\":240,\"width\":1280,\"height\":720,\"storageWidth\":736,\"storageHeight\":416,\"id\":\"mu576q8ojvs0j\",\"duration\":10,\"nativeFps\":null,\"nativeFrameCount\":null},\"videoClips\":[{\"id\":\"mu576q8ojvs0j\",\"fileName\":\"akina_previs_1280x720.mp4\",\"videoFile\":\"ebb3e1f54f5feed4a69fa88110ede54275b6d17c885439578abf5ed4028fba58.mp4\",\"subfolder\":\"\",\"type\":\"input\",\"width\":1280,\"height\":720,\"duration\":10,\"nativeFps\":null,\"nativeFrameCount\":null,\"sourceFrameCount\":240,\"storageWidth\":736,\"storageHeight\":416,\"frames\":[]}],\"globalCommon\":{\"commonEnabled\":false,\"commonCollapsed\":false,\"prompt\":\"参考视频是夜间山路赛车白模预演。请严格沿用它的镜头结构、运镜方式、时间节奏（10 秒 5 个镜头，每镜 2 秒）以及两台车\\\"红车在前、蓝车在后\\\"的前后顺序；但车辆的走位请在此基础上加强——参考视频里两台车大多相距较远，请在保持前后顺序不变的前提下把追逐感做足，让两车多处进入几乎贴上的近距缠斗，并让车身动作、轮胎打滑与镜头抖动都比参考更激烈。参考视频中两台车都是赛道化改装双门轿跑，前车红色、后车蓝色，低趴宽体、大尾翼高过车顶、前唇分流器、黑色侧裙与尾部扩散器、四条黑色轮胎配金属轮辋、亮白色车头灯与红色尾灯；不要改变车辆数量与前后位置关系。\\n0–1 秒：高空俯拍，广角镜头在盘山公路正上方约 52 米、位于红色赛车前方约 68 米处偏向山谷一侧，镜头沿公路向前推进并开始下降。画面是夜间盘山公路的 S 形走线，湿滑反光的柏油路面被两侧成排护栏夹住，路面反射冷白月光与雾中灯雾，一侧是陡峭山坡密林，另一侧是山谷与浓雾。红色赛车在画面下方沿公路前行约 70 km/h，两枚白色车头灯在雾中切出锥形光柱，车尾红色尾灯拖出短光带；蓝色赛车在它后方约 17 米同向跟随，正在快速接近。\\n1–2 秒：镜头继续前推并加速下降，高度从约 30 米降到约 4 米，从\\\"俯视地图\\\"变成\\\"贴地跟随\\\"，公路由一条线变成占据画面下半幅的实体湿路面，透视从小俯视转到近乎水平。红色赛车保持在画面中央偏下，车身随路面起伏摆动并带轻微侧倾。镜头末尾蓝色赛车已经追到红色赛车正后方约 4 米，两车在画面里几乎连成一体，车队接近第一个发夹弯入口，速度升到约 74 km/h。\\n2–3 秒：切到跟拍，镜头贴在红色赛车左后方约 14 米、离地约 1.95 米处随车同步前移。画面前景是红车正后方：高过车顶的大尾翼、尾部深色面板上两枚亮起的红色尾灯，车头两枚白色头灯把前方湿路面照成两道光斑。赛车进入发夹弯，车尾向外甩出约 27 度，后轮打滑卷起白色轮胎烟雾与水雾，烟雾被尾灯与头灯照亮。​蓝色赛车从后方猛烈逼近到不足 1.5 米，前翼几乎贴到红车的尾部扩散器上，两车像连在一根杆子上一起入弯；镜头里同时能看到红车的两枚红尾灯与蓝车的两枚白头灯紧挨在一起。\\n3–4 秒：车在发夹弯弯心，镜头继续贴红车左后随其走线内切。两台车并排贴住同时过弯，横向间距不到半米，轮毂与轮毂几乎相碰，车尾双双大幅外甩、双层烟雾在弯心叠成一团；红车车身明显向弯外侧倾，两车车门几乎要贴上。速度降到最低约 63 km/h 后开始回升到约 80 km/h，出弯时两台车一起收拢车尾，四枚尾灯扫过画面。成排护栏连续掠过画面边缘形成节奏性遮挡。\\n4–5 秒：切到环绕机位，镜头绕两台车中点做横移环绕，起点在两车正后方，半径约 14 米、高约 1.9 米，从红色车车尾开始向侧面扫。两台车同时漂移过弯，偏航都在 28 度以上，车尾双双甩向外侧。​漂移中蓝车横向摆过来贴近红车侧面，两车间距压到三十厘米以内，蓝车前唇几乎蹭到红车侧裙，车门对车门，后轮各卷起一团白烟，两团烟在中间连成一片。相机横移中画面从\\\"看两台车车尾\\\"转成\\\"看到两台车贴在一起的车身侧面\\\"，红车在前蓝车在后。\\n5–6 秒：镜头继续绕行约 92 度，半径收到约 12 米、高度升到约 3.1 米，落点来到蓝色赛车侧翼，画面主体由红车车尾转到蓝车侧面，蓝车车身与大尾翼贴身掠过镜头占满画面一侧，红车就在它前方半个车身以内。两车漂移幅度回正到约 9 度，车尾烟尘散成薄雾，湿路面反射两车的车灯与尾灯。\\n6–7 秒：切到红色赛车右侧驾驶位车内视角，视点高约 1.26 米位于驾驶位，可见方向盘、仪表台、前风挡与前方道路。车辆高速通过连续弯入口，速度从约 78 km/h 拉到约 109 km/h。​画面剧烈晃动、强烈颠簸：车身随路面接连弹跳，镜头跟着高频抖动、上下抛甩，手持摄影感极强，前风挡与后视镜一起震，雨滴被震开。方向盘快速大幅反打、双手在盘上交叉换手，幅度超过正负八十度；每次换挡车头明显顿挫、车身前后一顿，仪表台换挡指示灯同时闪一次。风挡外是湿滑反光路面与被头灯照亮的树木、护栏和浓雾。\\n7–8 秒：车在左右连续反向弯中走线，速度约 69 到 66 km/h。​画面始终处于剧烈抖动与颠簸中，不要平稳：方向盘继续大幅往复反打，换挡灯持续闪动，车身猛烈侧倾与俯仰、悬架明显起伏，驾驶者身体被甩向两侧；镜头跟着车身一起剧烈摇摆，视角不断被抛动，风挡外护栏与树木快速掠过，尾灯在雾中拉出红色光带。\\n\\n9–10 秒：镜头沿赛道快速后撤并升起，后撤约 130 米、升到约 45 米，从贴地机位变成高空俯瞰；两台车的尾灯在雾中缩小成两点紧紧挨着的红光远去，速度约 136 km/h，画面露出整条盘山公路的多层发夹弯与 S 弯走势，湿路面反射着雾中的光，浓雾吞掉远处山体。\\n全程画面要求：夜晚的日本山路，湿滑反光的柏油路面、成排护栏、两侧山林与浓雾、车头灯强光照亮前方路面、红色尾灯在雾中拖出光带、轮胎摩擦卷起烟雾与水雾；两台车全程保持高速追逐的压迫感，多处近距缠斗、几乎碰撞但始终不接触。摄影风格为 90 年代日系赛车电影，35mm 胶片颗粒、运动模糊、电影感调色、真实车辆动力学（车身侧倾、悬架起伏、轮胎抓地感）；车内镜头尤其要保留剧烈的高频抖动与颠簸，不要电子防抖、不要平滑运镜、不要稳定器效果。车辆为真实车漆、玻璃与碳纤维材质，不要保留白模灰面。4K 高清，画面中不出现任何字幕、水印、Logo 或文字。\",\"refs\":[],\"refAudios\":[],\"refVideos\":[]}}},\"batchWorkspaces\":{\"i2v\":{\"selectedIndex\":0,\"editMode\":\"segment\",\"runSelectEnabled\":false,\"runSelection\":[],\"segments\":[{\"id\":\"mufrnk7nmkoi2\",\"start\":0,\"length\":124,\"frameCount\":124,\"durationSec\":5,\"prompt\":\"女孩单人跳舞。动作踩点。音乐动感。\",\"negativePrompt\":\"\",\"taskType\":\"\",\"refs\":[],\"refAudios\":[],\"refVideos\":[],\"genImage\":{\"imageFile\":\"fb7c0e7f423e4f572068760cee01a5d4c4f541ac0ae354895dcb586ab07b8615.png\",\"fileName\":\"\"},\"previewFps\":24,\"frameRate\":24,\"refImageSize\":\"match\",\"_videoFrameCount\":124,\"imageFile\":\"fb7c0e7f423e4f572068760cee01a5d4c4f541ac0ae354895dcb586ab07b8615.png\",\"previewLive\":true,\"previewStep\":4,\"previewTotalSteps\":4}],\"globalCommon\":{\"commonEnabled\":false,\"commonCollapsed\":false,\"prompt\":\"\",\"refs\":[],\"refAudios\":[],\"refVideos\":[]}}}}", "高级采样", 4, "res_multistep", "simple", 12, 3, false, false, "", "", "7b5803eab11ebbdd3c78172a8b9f1f74", "", "", "644356168460fa47b7ca6ad3584e1dcc"], "inputs": [{"name": "model", "l