on"}], "flags": {"collapsed": false}, "type": "RH_RhartImageG2ImageToImage", "mode": 0, "bgcolor": "#653", "size": [400, 408], "pos": [1801.8572998046875, 55.20847702026367], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2ImageToImage"}, "order": 5}, {"outputs": [{"name": "STRING", "links": [8], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["参考image1中母亲和女儿， 生成一张主体与背景布局：双人物主体（母女）集中分布在画面中下区域，背景为大面积延伸的户外草地，无额外场景元素，既突出人物互动状态，又保留了自然环境的开阔感。 留白方式：画面上半部分为大面积草地留白，营造出户外场景的通透感，人物主体周围无元素遮挡， 前景与后景层次感：采用「前景人物 - 中景草地 - 远景虚化草地」的三层结构，人物为前景视觉核心，近景草地清晰，远景草地做虚化处理，形成自然的空间纵深感。 2. 人物摆放姿势 右侧成年女性（妈妈）：位于画面中下偏右位置，呈放松坐姿；身体略微后仰，面部向上仰起，目光看向画面上方，张嘴大笑；左手（画面右侧）高高向上举起，手掌自然张开，右手撑在身后的草地上，双腿自然弯曲踩在草地上，体态舒展。 左侧小女孩：位于画面中下偏左位置，与妈妈并排就坐且位置略靠前；身体同样后仰，面部向上仰起，与妈妈同步大笑，目光看向画面上方；右手（画面右侧）高高向上举起，手掌张开，与妈妈的手形成呼应动作，双腿分开弯曲，双脚朝向镜头，姿态活泼自然。 互动细节：两人动作同步，表情、抬手动作高度呼应，传递出亲密、欢乐的亲子氛围。 色彩搭配方案 主色调：低饱和度自然草绿色（背景草地主色），奠定清新治愈的户外氛围，色彩柔和不刺眼。 光影与色彩情绪：整体为暖调柔和自然光，类似下午户外的漫射光，光线均匀无硬阴影，画面带有轻微日系胶片质感，色彩清新柔和，传递出温暖、治愈、松弛的亲子情绪。 镜头拍摄角度 拍摄视角：略微俯视的平视视角，镜头高度略高于人物坐姿高度，从上往下轻微俯拍，既完整捕捉人物坐姿动作，又能展现草地的延伸感与环境氛围。 焦距感：标准中焦人像焦距（等效 50mm 左右），无广角畸变、长焦压缩感，人物比例自然写实，动作细节还原清晰。 景深效果：浅景深效果，前景人物主体清晰锐利，背景远处草地做轻微虚化处理，突出人物互动状态，同时保留户外场景的氛围感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true, "collapsed": false}, "type": "Text Multiline", "mode": 0, "bgcolor": "#353", "size": [556.5941772460938, 583.2724609375], "pos": [2206.48486328125, 661.4451293945312], "id": 10, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 4}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-875.6050773283678, 82.23140739993482], "scale": 0.7513148009015777}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 1, "title": "第一张参考图", "bounding": [285.4434509277344, 532.7237548828125, 426.04400634