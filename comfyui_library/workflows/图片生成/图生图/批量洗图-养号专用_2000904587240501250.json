, "bgcolor": "#335", "size": [163.08984375, 166], "pos": [3633.9765625, 555.9429321289062], "id": 76, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy forLoopEnd"}, "order": 37}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [75], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [270, 106], "pos": [2863.039306640625, 119.33032989501953], "widgets_values": ["qwen_3_4b.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 3, "type": "CLIPLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "", "links": [76], "label": "", "type": "CLIP"}], "size": [75, 26], "pos": [3260.518798828125, 43.84437561035156], "inputs": [{"name": "", "link": 75, "label": "", "type": "*"}], "flags": {}, "id": 62, "type": "Reroute", "properties": {"horizontal": false, "widget_ue_connectable": {}, "showOutputText": false}, "order": 13}, {"outputs": [{"name": "output", "links": [68], "label": "output", "type": "*", "localized_name": "output"}], "color": "#223", "widgets_values": ["暖金色的午后阳光透过木质格栅窗棂，在原木餐桌与座椅上投下斑驳的光影，营造出静谧而温暖的东方禅意空间。前景是一张宽厚的实木餐桌，桌面纹理清晰自然，几把弧形木质餐椅围拢，椅垫为素雅浅灰布艺，简约而舒适。桌角放置一只粗陶黑釉花器，静默如诗。中景是温润的木饰面橱柜与台面，台面后方嵌入式暖光灯带柔和地勾勒出橱柜轮廓，柜面陈列着几件陶器与果盘，细节精致却不喧宾夺主。背景是通透的落地玻璃窗，窗外庭院绿意盎然，隐约可见传统瓦顶与芭蕉叶影，与室内木质格栅形成虚实相生的视觉对话。格栅窗由规整的方形木格构成，部分格子内嵌透光玻璃，阳光穿透后形成明暗交错的视觉韵律，与悬挂的藤编吊灯共同构成空间的垂直光影层次。吊灯造型如层叠的云朵，暖黄光晕柔和地洒落，与自然光交织，赋予空间呼吸感。构图采用低角度仰视，强化空间的纵深感与木质结构的庄严感，同时引导视线从前景餐桌自然延伸至背景庭院，形成“由内而外”的视觉流动。光影氛围温暖、宁静、治愈，木质元素与自然光的结合，传达出“家”的温度与东方美学中的“留白”哲学。整体画面如一幅静物油画，细节丰富却不杂乱，色彩以原木棕、暖黄、灰白为主，营造出一种“慢生活”的诗意栖居感，仿佛时间在此刻被温柔地拉长。"], "inputs": [{"shape