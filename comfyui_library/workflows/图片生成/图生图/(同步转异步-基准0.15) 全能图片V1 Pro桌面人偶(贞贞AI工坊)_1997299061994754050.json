crosoft Edge、应用商店、照片、Google Chrome、日历图标，以及 Wi-Fi、扬声器、电池系统托盘图标，时间显示为“2025年11月29日 上午5:25”。\n\n\n\n采用平面视角，如同直接观看屏幕，屏幕漫射光在搜索结果上投射出女性和光标的微妙阴影。着重表现从背部抓握点悬挂的姿势。色彩干净明亮，色调中性，符合现代操作系统美学。逼真的数字元素与超现实的人体融合。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 112, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [296, 300], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314.0000305175781], "pos": [-156.6160430908203, 201.1985321044922], "widgets_values": ["df24dae377e037202c446a46d0730d69d5f6124ef0e061d11dfa3068a2e3c472.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 181, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.65", "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"mode": 0, "outputs": [], "size": [1239.913818359375, 1368.9371337890625], "pos": [1454.9390869140625, 65.12100219726562], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 297, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 114, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.65", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 6}, {"mode": 0, "outputs": [{"name": "apikey", "links": [302], "label": "