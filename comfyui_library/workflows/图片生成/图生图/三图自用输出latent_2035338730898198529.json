{"last_link_id": 552, "nodes": [{"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [482], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "shape": 2, "widgets_values": ["第 1 秒：特写剑刃上的水花与火花炸裂，水珠如碎钻迸射，剑纹在水光火芒中流转，红黑剑柄的银饰被水浪冲刷得发亮，背景水浪的咆哮与剑的破空声如雷贯耳。\n第 2 秒：镜头上移红袍被水浪掀成弧幕，黑发贴在脸颊又被风甩起，水珠顺着臂甲的纹路滚落，剑轨带起的水涡在身后旋出冰蓝与炽红的漩涡，他的瞳孔燃着决绝。\n第 3 秒：中景剑劈开水浪的刹那，水花凝成冰棱，火花却在冰中炸开，水与火的对冲在画面中央绞成混沌，他的动作如游龙穿浪，每一寸发力都让水浪震颤。\n第 4 秒：全景他是水浪中的赤焰，红袍在蓝白水幕里烧出艳痕，剑的银芒与水的冰蓝、火的橙红撕裂黑暗，背景的滔天巨浪似要将他吞噬，却被他的剑势逼退成臣服的浪涛。\n第 5 秒：特写推近剑刃即将刺入水心的瞬间，水花与火花同时凝滞，他的眼神如淬火的锋刃，画面在这水与火的极致碰撞前定格。"], "inputs": [{"name": "clip", "link": 479, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 522, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [587.6572265625, 134.0855712890625], "pos": [3536.216552734375, 6624.1044921875], "id": 169, "properties": {"cnr_id": "comfy-core", "ver": "0.3.46", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 19}, {"outputs": [{"name": "CLIP", "slot_index": 0, "links": [479, 480], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#323", "widgets_values": ["umt5_xxl_fp16.safetensors", "wan", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#535", "size": [408.15313720703125, 106], "pos": [1925.3927001953125, 7598.60693359375], "id": 214, "properties": {"cnr_id": "comfy-c