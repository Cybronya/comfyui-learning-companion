, "size": [389.4248352050781, 394.8299865722656], "pos": [2062.378662109375, 225.6000518798828], "widgets_values": ["Create a photograph of an ancient-style decorated living room in a wide 1928:1088 composition, illuminated by soft daylight entering through carved wooden lattice windows. Center the artwork from the first reference as a large painting enclosed within a substantial black rectangular frame, hanging prominently on the wall of the room. Preserve the painting exactly as shown: the open white folding fan with bamboo, orchid, plum blossoms, black ink branches, gold accents, the large black calligraphy \"清風\", and the small red seal, all contained within the original fan-shaped design. Surround the painting with a deep black border and subtle gold corner ornaments. Set it against dark reddish-brown timber wall panels with carved cloud motifs, flanked by a bronze incense burner and a low dark-wood console table holding a celadon vase with sparse plum branches. Add a traditional carved wooden armchair, a rolled bamboo screen, and a small bronze lantern on the side. Keep the framed artwork level and fully visible, with the black frame casting a restrained contact shadow on the wall and the room’s furnishings arranged symmetrically around it."], "inputs": [{"shape": 7, "name": "anything", "link": 13, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 13, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 21}, {"mode": 0, "outputs": [{"name": "*", "links": [13, 24, 27], "label": "输出", "type": "STRING", "localized_name": "*"}], "size": [270, 78], "pos": [1526.513427734375, 213.90884399414062], "widgets_values": [true], "inputs": [{"name": "tt_value", "link": 23, "label": "真", "type": "STRING", "localized_name": "tt_value"}, {"name": "ff_value", "link": 21, "label": "假", "type": "STRING", "localized_name": "ff_value"}, {"widget": {"name": "cond"}, "name": "cond",