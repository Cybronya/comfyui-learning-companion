e": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartImageG25SunburstImageToImage", "mode": 0, "bgcolor": "#535", "size": [429.8228454589844, 408], "pos": [0, 505.6629943847656], "id": 23, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG25SunburstImageToImage"}, "order": 12}, {"outputs": [{"name": "prompt", "links": [21], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["生成一套人物三视图角色表（Character Sheet）：正面全身、背面全身、脸部特写，整体构图与取景参考图1，人物替换为图2中的人物与服装。\n\n【参考图分工——严格锁定】\n- 图1（脸部特写）：唯一面部信息来源；特写视图的构图、角度、取景与光影风格以图1为准。\n- 图2（正面全身，无头）：正面视图的人物体型、姿态、发型、服装版型与配色来源；此图头部已做无头处理，模型不得从该图推断任何面部特征。\n- 图3（背面全身）：背面视图的服装结构、细节、背部头部轮廓与整体造型来源。\n\n【面部硬约束（无头技巧）】\n- 正面全身视图：头部区域无头处理，不生成面部细节，不生成模糊小脸。\n- 背面全身视图：保留完整背部头部细节——后脑勺轮廓、头发背面、发际线走向、颈部背面，发色发型与特写视图一致；但不得出现正面五官，不得转头露脸。\n- 面部特征只允许出现在脸部特写视图中，且必须严格还原图1：同一张脸、同一五官、同一发型，跨视图不得漂移。\n- 禁止从任何全身视图抓取、推断、补画或脑补面部特征。\n\n【一致性要求】\n- 三视图必须为同一人物：体型、发型（含背部头发形态）、服装版型、配色、图案、饰品跨视图一致。\n- 服装以图2、图3为准，不得篡改版型、颜色、图案与材质。\n\n【负面约束】\n模糊脸，脸部崩坏，多张不同的脸，面部特征漂移，脸型改变，五官错位，从全身图推断出的脸，远景小脸，背面视图露正脸，转头露脸，头部缺失，后脑勺缺失，头发变形，服装变形，图案错乱，配色改变，肢体畸形，额外肢体，透视错误，风格不统一。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [640, 0], "id": 18, "properties": {"cnr_id": "comfyroll", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 2}, {"outputs": [{"name": "IMAGE", "links": [23], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "M