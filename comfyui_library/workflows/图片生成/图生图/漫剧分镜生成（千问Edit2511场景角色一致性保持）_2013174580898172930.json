22", "widgets_values": ["中景镜头聚焦两人并肩而坐的侧影，男孩轻轻将手搭在女孩肩头，女孩微微侧头，嘴角含笑，眼神温柔注视着身旁的他，氛围静谧而亲密。\n\n特写镜头缓缓推近女孩的脸庞，她轻闭双眼，微风拂动发丝，嘴角笑意加深，仿佛沉浸于此刻的宁静，男孩则凝视着她，眼神中满是温柔与守护。\n\n远景镜头拉远，两人身影融入星河下的草甸，萤火虫在四周飞舞，远处村庄灯火渐次亮起，镜头缓慢上移，银河如丝带般横跨天际，两人静坐如画中人，情感升华，画面充满诗意与永恒感。"], "inputs": [{"shape": 7, "name": "anything", "link": 144, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#593930", "size": [218.95791625976562, 96.8568115234375], "pos": [-817.7763671875, 2535.40283203125], "id": 89, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 14}, {"outputs": [{"name": "STRING", "links": [142, 143], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#332922", "widgets_values": ["", "去空行"], "inputs": [{"widget": {"name": "input_string"}, "name": "input_string", "link": 145, "label": "input_string", "type": "STRING", "localized_name": "input_string"}, {"widget": {"name": "option"}, "name": "option", "label": "option", "type": "COMBO", "localized_name": "option"}], "flags": {}, "type": "ProcessString", "mode": 0, "bgcolor": "#593930", "size": [213.36874389648438, 112], "pos": [-815.0780029296875, 2699.6123046875], "id": 88, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ProcessString", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 15}, {"outputs": [{"name": "Filenames", "links": [61], "label": "文件名", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "color": "#332922", "widgets_values": {"save_output": true, "filename_prefix": "AnimateDiff", "loop_count": 0, "videopreview": {"paused": false, "hidden": false, "params": {"score": "0", "filename": "AnimateDiff_00001_p84_qrpkb_1768817002.webp", "cos_url": "https://rh-images-1252422369.cos.ap-beijing.myqcloud.com//e8e576f63cb05db5736c0e6f37fcf406/output/AnimateDiff_0