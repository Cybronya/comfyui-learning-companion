，纯白背景，高清8K，细腻肤质，柔光突出眼部轮廓，无阴影，构图居中\n口鼻局部特写，聚焦唇部及鼻部，细节清晰，纯白背景，高清8K，细腻肤质，柔光均匀，无阴影，构图居中\n左后斜45°半身视角，肩以上构图，头部微转看向镜头，纯白背景，高清8K，细腻肤质，侧逆光，无阴影，构图偏左\n右后斜45°半身视角，肩以上构图，头部微转看向镜头，纯白背景，高清8K，细腻肤质，侧逆光，无阴影，构图偏右\n正面肩颈特写，肩颈线条清晰，半身构图，纯白背景，高清8K，细腻肤质，柔光均匀分布，无阴影，构图居中\n左侧肩颈特写，肩颈线条清晰，半身构图，纯白背景，高清8K，细腻肤质，侧光，无阴影，构图偏左\n右斜60°脸部特写，仅拍摄头部，脸部侧向右，细节清晰，纯白背景，高清8K，细腻肤质，硬光突出轮廓，无阴影，构图偏右\n左斜60°脸部特写，仅拍摄头部，脸部侧向左，细节清晰，纯白背景，高清8K，细腻肤质，硬光突出轮廓，无阴影，构图偏左", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "start_index"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "max_rows"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [883.5098876953125, 395.98028564453125], "pos": [-2230.354736328125, 40.68403244018555], "id": 42, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptLine"}, "order": 5}, {"mode": 0, "outputs": [{"name": "image", "links": [23], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"name": "original_size", "label": "original_size", "type": "BOX", "localized_name": "original_size"}, {"name": "width", "links": [], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [], "label": "height", "type": "INT", "localized_name": "height"}], "size": [363.6851501464844, 330], "color": "rgba(38, 73, 116, 0.7)", "pos": [-98.96756744384766, 570.7180786132812], "widgets_values": ["original", 1, 1, "letterbox", "lanczos", "8", "shortest", 1280, "#000000"], "inputs": [{"shape": 7, "name": "image", "link": 59, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"widget": {"n