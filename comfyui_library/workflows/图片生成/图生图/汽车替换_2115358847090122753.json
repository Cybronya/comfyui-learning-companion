: "MASK"}], "widgets_values": ["ace8416166330d4a7ad6fe84a655b8cefe1e1ee0680b2abb7cec7a417a148412.png [input]", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "title": "原图", "mode": 0, "size": [270, 314.00000000000045], "pos": [-1356.3275420238008, 3647.840821344267], "id": 683, "properties": {"image": "ace8416166330d4a7ad6fe84a655b8cefe1e1ee0680b2abb7cec7a417a148412.png [input]", "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 1, "widgets_values_named": {"image": "ace8416166330d4a7ad6fe84a655b8cefe1e1ee0680b2abb7cec7a417a148412.png [input]", "upload": "image"}}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1411, 1425], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [587.5818330220288, 1069.3784364940234], "pos": [-982.4650204678801, 3689.166988765005], "widgets_values": [0, "将 image1 中的汽车替换为 image2 中的车型。image2 仅提供车型设计、车身比例、灯组、轮毂、车标、车漆本色与材质；不继承 image2 的拍摄光照、明暗分布、背景反射或曝光。\n\n以 image1 为唯一的场景与光照依据，保持原场景、相机视角、车辆停放位置、朝向、透视及合理实车尺度。以 image1 原车作为现场光照参照，使新车对应部位的受光与背光关系、明暗层次、光线软硬、环境色偏和高光强弱与原场景一致，并根据新车的曲面与车漆材质自然调整。\n\n依据 image1 原车车漆和玻璃中可见的环境反射，在新车上重建相同环境来源的反射：保留主要亮反射带与暗反射区的相对分布、延伸方向、宽窄节奏和清晰程度，让反射随新车的引擎盖、翼子板、车门及玻璃曲率自然弯曲、连续衔接。保留现场环境造成的明暗变化，不把车身处理成均匀干净的产品渲染，不添加原场景没有的棚灯条带、轮廓光或额外补光。\n\n保持车底暗部的密度、轮胎接地阴影，以及地面投影的方向和软硬；投影轮廓随新车尺寸合理调整。保持原图整体曝光、白平衡和背景不变，使新车像在同一地点、同一时刻、相同光线下实际拍摄。", "", 1, 25, false, 1024, 1024, "euler", "simple", 1123501984137295, "qwen_image_2.1_int8_convrot.safetensors", "qwen3vl_8b_int8_convrot.safetensors", "qwen_image_2.1_vae_bf16.safetensors", "auto", "default"], "inputs": [{"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "INT"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt",