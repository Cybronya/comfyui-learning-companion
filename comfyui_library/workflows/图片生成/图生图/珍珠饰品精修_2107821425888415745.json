: {"name": "width"}, "name": "width", "link": 1390, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 1391, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "link": 1392, "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "id": 1032, "type": "EmptyFlux2LatentImage", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.3.73", "widget_ue_connectable": {"batch_size": true, "width": true, "height": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "EmptyFlux2LatentImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 31}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["复制一个放在右边，不要重叠，并换成银色 "], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [398.2840881347656, 107.85633850097656], "pos": [5874.400390625, 1213.4468994140625], "id": 1117, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 10}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的3C数码产品，保持产品位置、大小、比例、透视、轮廓、屏幕、摄像头、按键、接口、散热孔、指示灯及连接结构不变。准确保留原有颜色、型号、文字、标识和屏幕显示内容，不新增或重写内容。\n\n分别保留原图中的金属、塑料、玻璃、橡胶及织物材质。金属保留原有抛光、拉丝或磨砂工艺；塑料保持真实光泽与纹理；屏幕和镜头保留玻璃质感、通透感及必要反射，不把黑色屏幕提亮成灰白色，不生成新的界面。仅清除灰尘、指纹、污点、水迹及杂乱倒影，不删除正常接缝和功能细节。\n\n采用专业数码产品影棚柔光布光，轮廓清晰，高光柔和不过曝，黑色部件暗而有细节。将背景修整为干净均匀的白色，保留自然接触阴影。高清写实产品摄影，不改变接口数量、按键位置或产品结构。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "3C 数码类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5567.234375, 1368.7938232421875], "id": 1125, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 11}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的服装，保持原有展示方式、位置、大小、比例、版型、领口、袖型、衣长、下摆、口袋、纽扣及接缝不变。保留原有颜色、印花、刺绣、图案、文字和标识，不改变设计。\n\n准确保留织物的纤维、织纹、针织结构、绒毛、厚度及垂坠感，按照原图保留棉、麻、丝、毛或化纤的真实材质表现。仅清除灰尘、浮毛、污点和影响展示的零碎杂乱褶皱，保留体现版型、垂坠及穿着状态的自然褶皱，不过度熨平，不抹掉织纹，不产生塑料感或金属反光。\n\n采用专业服装影棚大面积柔光布光，颜色准确，光线均匀，纹理清晰但不过度锐化。清理背景污点，背景保持干净白色，保留合理阴影。原图若有模特、衣架或人台，保持其原有展示关系。高清写实服装电商摄影，不新增图案，不改变服装款式。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "服装类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5570.783203125, 1415.3851318359375], "id": 1126, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 12}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的箱包，保持产品位置、大小、比例、透视、包体形状、容量观感、提手、肩带、轮子、拉杆、拉链、搭扣、口袋及装配关系不变，保留原有颜色和款式。\n\n分别保留各部位真实材质：皮革保持皮纹与柔和光泽，织物保持织纹与柔软感，硬壳保持原有纹理和反射，金属配件保持真实金属质感。准确保留针脚、缝线、包边、边油、压纹、拉链齿和品牌标识。仅清除灰尘、污点、水迹和拍摄瑕疵，不抹平纹理，不改变肩带长度，不重画拉链和缝线，不把包体修成僵硬塑料。\n\n采用专业箱包影棚柔光布光，突出真实形状、材质与厚度，高光柔和，暗部有细节。将背景修整为干净均匀的白色，保留包体底部自然接触阴影。高清写实电商产品摄影，不增加、删除或重新设计任何部件。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "箱包类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5571.9140625, 1461.9764404296875], "id": 1127, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的塑胶产品，保持产品位置、大小、比例、透视、轮廓、壁厚、孔位、卡扣、接缝和装配关系不变，保留原有颜色、图案、文字与标识，不改变产品设计。\n\n准确保留原图塑胶的表面工艺：亮面保持干净适度的光泽，磨砂保持细腻颗粒感，哑光保持柔和低反射，半透明部位保持真实透光性。保留正常模具分型线、注塑纹理及功能细节。仅清除灰尘、污点、水迹和杂乱倒影，不抹掉正常纹理，不变成金属、玻璃或硅胶，不产生过强镜面反射。\n\n采用专业产品影棚大型柔光箱布光，高光柔和连续，明暗过渡自然，颜色均匀准确。将背景修整为干净均匀的白色，保留产品底部自然柔和的接触阴影。高清写实电商产品摄影，不增加或删除结构细节。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "塑胶类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5569.6611328125, 1504.2154541015625], "id": 1128, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 14}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的硅胶产品，保持产品位置、大小、比例、透视、轮廓、厚度、孔位、接缝及所有结构细节不变，保留原有颜色，不重新设计产品。\n\n准确保留原图硅胶的表面工艺：哑光产品保持细腻哑光，亮面产品保持柔和光泽，半透明产品保留真实透光性。呈现柔软、细腻、有弹性的硅胶质感，不变成金属、玻璃或硬塑料。仅清除灰尘、污点、水迹和杂乱光影，不抹掉正常纹理、磨砂颗粒、模具分型线及功能结构。\n\n采用大型柔光箱影棚布光，光线均匀柔和，高光适度，明暗过渡自然。清理背景污点，将背景修整为干净均匀的白色，保留产品底部自然柔和的接触阴影。高清写实电商产品摄影，不改变颜色，不增加文字、道具或产品细节。 "], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "硅胶产品类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5567.7861328125, 1206.56201171875], "id": 1122, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的五金工具，保持产品位置、大小、比例、透视、轮廓、刃口、齿形、螺纹、孔位、连接件及装配关系不变。准确保留原有颜色、刻度、型号、文字和标识，不新增、不重写、不改变工具结构。\n\n分别保留各部分真实材质：抛光金属呈现干净连续的反射，拉丝金属保留拉丝方向和加工纹路，喷漆或喷粉部件保留涂层质感，塑料及橡胶手柄保持原有纹理与防滑结构。仅清除灰尘、油污、水迹及拍摄造成的杂乱倒影，不删除正常加工痕迹，不把哑光部件变成镜面金属。\n\n采用专业工业产品影棚柔光布光，金属高光清晰但不过曝，暗部保留细节，边缘自然。将背景修整为干净均匀的白色，保留真实柔和的接触阴影。高清写实产品摄影，不增加、删除或重新设计任何部件。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "五金工具类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5569.14892578125, 1254.956298828125], "id": 1123, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 16}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的皮具产品，保持产品位置、大小、比例、透视、外形、厚度、折边、接缝和装配关系不变，保留原有颜色及材质类型，不改变款式。\n\n准确保留原图皮革或人造革的纹理、颗粒尺度、毛孔、压纹、压印、针脚、缝线和边油。保留符合实物的自然褶皱与使用设计，不把皮纹抹平，不增加不存在的皮纹，不将哑光皮革变成漆皮。金属配件保留原有颜色及真实金属质感。仅清除灰尘、污点、水迹和拍摄瑕疵，保持文字、标识和压印内容不变。\n\n采用专业皮具影棚柔光布光，以柔和侧光呈现纹理与厚度，高光细腻不过曝，暗部自然。将背景修整为干净均匀的白色，保留产品底部柔和的接触阴影。高清写实电商产品摄影，不重画缝线、文字和结构细节。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "type": "JjkText", "title": "皮具类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5578.77783203125, 1304.2889404296875], "id": 1124, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["精修原图中的玻璃或透明产品，保持产品位置、大小、比例、透视、外轮廓、壁厚、开口、底部、接缝和所有结构细节不变。保留原图透明、半透明、磨砂或有色透明材质的真实表现，不改变原有颜色与透明程度。\n\n清除灰尘、指纹、污点、水迹及非必要杂乱倒影，同时保留真实的透射、折射、边缘反射、厚度变化和必要高光。透明区域仍然通透，磨砂区域保留散射质感，不变成乳白色不透明塑料，不抹掉边缘，不生成虚假裂纹、气泡或内部物体。准确保留原有刻度、文字和标识，不新增或重写内容。\n\n采用专业透明产品影棚布光，通过柔和明暗反射呈现清晰自然的边缘，高光不过曝，背景干净白色。保留底部真实接触阴影、透光投影及符合原图的折射表现。高清写实电商产品摄影，产品完整可见，不为增强轮廓而添加粗黑描边。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "JjkText", "title": "玻璃及透明产品类", "mode": 0, "bgcolor": "#353", "size": [432.13751220703125, 254.39329528808594], "pos": [5398.73974609375, 1619.23095703125], "id": 1129, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 18}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [1418], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [396.4932861328125, 262], "shape": 1, "pos": [9360.2724609375, 1303.570068359375], "widgets_v