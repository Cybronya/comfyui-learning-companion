，阳光温和，空气清新\n\n画面中有草坪、树影、远处步道，以及少量轻微虚化处理的行人、小孩玩耍、家庭活动\n\n前景的小狗轻快、可爱，带一点动态感\n\n站在自行车旁边的小狗安静乖巧，神态柔和\n\n自行车自然融入场景，不要摆拍感过强\n\n背景人物和环境不要画得太繁杂，以柔和概括的水彩方式表现\n\n画面整体清新通透，具有春天气息和日常生活感\n\n笔触自然，边缘略微柔化，有适度留白，不要过于厚重\n\n画面像高质量手绘水彩插画，可带一点绘本感或杂志插画感\n\n颜色以草地绿、暖阳黄、奶油白、浅棕、淡蓝、柔和灰绿为主，整体协调自然", "4:3", false, 542156906, "randomize", "2k"], "inputs": [{"name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", 