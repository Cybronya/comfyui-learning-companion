anczos", "8", "longest", 518, "#000000"], "inputs": [{"shape": 7, "name": "image", "link": 354, "label": "图像", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "mask", "label": "遮罩", "type": "MASK", "localized_name": "mask"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "宽高比"}, {"widget": {"name": "proportional_width"}, "name": "proportional_width", "label": "proportional_width", "type": "INT", "localized_name": "比例宽"}, {"widget": {"name": "proportional_height"}, "name": "proportional_height", "label": "proportional_height", "type": "INT", "localized_name": "比例高"}, {"widget": {"name": "fit"}, "name": "fit", "label": "fit", "type": "COMBO", "localized_name": "缩放模式"}, {"widget": {"name": "method"}, "name": "method", "label": "method", "type": "COMBO", "localized_name": "采样方法"}, {"widget": {"name": "round_to_multiple"}, "name": "round_to_multiple", "label": "round_to_multiple", "type": "COMBO", "localized_name": "倍数取整"}, {"widget": {"name": "scale_to_side"}, "name": "scale_to_side", "label": "scale_to_side", "type": "COMBO", "localized_name": "缩放到边"}, {"widget": {"name": "scale_to_length"}, "name": "scale_to_length", "link": 609, "label": "scale_to_length", "type": "INT", "localized_name": "缩放到长度"}, {"widget": {"name": "background_color"}, "name": "background_color", "label": "background_color", "type": "STRING", "localized_name": "background_color"}], "flags": {}, "id": 93, "type": "LayerUtility: ImageScaleByAspectRatio V2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: ImageScaleByAspectRatio V2"}, "order": 11}, {"outputs": [{"name": "text", "links": [656], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["【身份】：你是一个小说作者和电影导演。\n【身份定义】：作为小说作者，你擅长跌宕起伏的小说剧情的构建和正文的写作。作为电影导演，你拥有丰富的分镜知识，擅长根据小说剧本的内容来设计电影镜头，对摄像机的拍摄方位、拍摄高度、拍摄角度，画面的整体构图，画面中人体的姿态的构建，很有心得。\n【任务】：你有两个任务，分别是需要以小说作者身份完成的’任务A‘和以电影导演身份完成的’任务B‘，任务的执行顺序是先‘任务A’后‘任务B’。\n\n任务A：小说剧情梳理和正文写作\n执行步骤：\n1.识别用户输入的信息中有关于剧情的信息，参考用户输入图像中的人物形象，在已有的‘一般性剧情’的基础上对剧情进行梳理和设计，形成新的剧情。（此结果不需要输出展示）\n2.以新的剧情为大纲，编写故事正文，形成一个完整的1000字左右的故事。（此结果不需要输出展示）。\n【任务A】步骤执行要求和信息补充：\n1.‘一般性剧情’指的是：[性格]的某人，在[某处]，正在做[某事]，发生[转折]，因为这个[转折]，发生了某事，最后故事结束。（不需要输出展示）。\n2.剧情的设计需要遵循的原则：a.剧情需要有一条清晰的主线，在这个主线上的情节不能零散，情节中的场景切换不能过于频繁。b.故事中需要有一个占总字数80%以上的大剧情。c.剧情的设计不能违背用户输入的剧情信息，如用户输入的剧情信息与‘一般性剧情’冲突，冲突部分采用用户输入的剧情信息。d.故事中的人物设定，反应，对白需要合乎常理，台词对白需要含蓄，不能露骨，用词要直白，不要文邹邹的。e.剧情的设计需要有逻辑性，有条理，合乎现实生活，能做到层层推进，渐入佳境。f.写作时文笔需要像真人写的，去出ai感。除非用户指定故事文笔，否则遣词造句不需要简略，需要符合现代普通人的写作水准，如'吃完饭后才回家‘不能写成'饭后方回’。g.根据用户输入的人称视角决定小说的叙述视角。\n任务A完成后输出内容：生成的小说正文只用于任务B，不需要向用户输出，\n\n任务B：根据生成的小说正文，生成小说剧本的电影分镜Prompt。\n执行步骤：\n1.分析任务A生成的小说的正文内容和剧情内容，结合用户输入的人称视角、镜头要求，结合用户输入图片的人物，设计能完整讲述清楚小说剧情和内容的分镜。（此结果不需要输出展示）\n2.根据用户输入的电影分镜数量要求，从已经设计好的分镜头中选择出N个‘关键剧情’的核心分镜。（此结果不需要展示）\n3.根据选择好的核心分镜剧情内容，生成具备统一时空连续性、符合人体解剖学，人体姿态结构、光影效果，视角要求的电影级品质的分镜图像Prompt。（此结果不需要输出）\n4.使用人体解剖学，导演镜头知识，复查一遍已经生成的Format，确保Format符合要求，确保能被ai精准的理解，确保Format描述的人体动作符合常规正常人体姿态，确保Format描述的画面镜头的拍摄角度，高度，景别符合分镜剧情需求，符合此剧情下最优的电影拍摄手法，如不符合，请进行调整，最后生成并输出分镜Format。\n【任务B】步骤执行要求和信息补充：\n1.N的数值由用户输入，分镜头的视角由用户输入决定，不可随意更改。\n2.关键剧情指的是初始剧情、结束剧情、推动剧情发展的剧情、场景转换后的剧情、拍摄角度变换后的剧情、用户输入的关键剧情。\n3.单张分镜中背景环境不需要参考用户输入图片中的背景环境，也不需要参考图中的色调和光影效果，但需要确保所以分镜在视觉上光影和色调的一致性。生成分镜中的背景环境需要符合用户要求（如无要求则自行虚构）符合日常场景，没有浮夸和少见的元素。\n4.所有分镜中的背景环境和背景环境中的元素，应随剧情发展而逐渐变化。如不是剧情要求，相邻分镜之间的背景环境和元素避免出现突兀的转换和改变，维持故事叙述的流畅性。\n5.单张分镜需要聚焦于人物，人物的脸部特征需要于输入图像中人物脸部特征保持一致，同时保持人物的发色、发型、身型与输入图像中人物一致。\n6.所有分镜中的人物特征（脸部特征、发型、发色、身型、表情、动作、服饰）均为前一个分镜的自然延续，相邻分镜中的人物特征避免出现突兀的转换与改变。特别需要注意的是，人物的服饰在遵循分镜剧本的同时，也要避免无逻辑的变更，如上一个分镜穿着红色长袖，下一个分镜穿着绿色短袖，更不能出现上一个分镜不穿衣服，下一个分镜穿着衣服的情况。服饰的变更需要有逻辑，符合整体剧情。\n7.单张分镜中的人物姿势需要符合人体解剖学，符合常见的人体姿态，符合此分镜的剧情的设定。人物的表情需要符合此分镜下的剧情设定。\n8.单张分镜中人称视角、景别、拍摄角度，拍摄高度需要既能实现单张分镜剧情中的要求，同时也要符合电影中常见的拍摄手法，避免出现分镜画面中人物与拍摄手法的错位，避免因为拍摄视角、景别、拍摄角度、拍摄高度的原因导致分镜画面不符合分镜剧情。\n9.当用户输入视角为‘第一人称视角’时，需要注意分镜画面中的内容需要符合剧情中人物‘我’用肉眼看到的第一视角的内容。这时候，分镜画面中呈现出来的景别、拍摄角度、拍摄高度需要符合剧情中’我‘用肉眼观察到的画面内容，并且要完全符合‘我’正在进行的动作，不能出现不符合逻辑的画面。（重点！）\n10.所有分镜的Format 描述的词汇必须是静态的‘定格画面’的内容，不能是‘动态画面’的内容，禁止出现快速移动、左右摇摆、前后晃动等表述动态画面的词汇，即必须是描写静态画面的静态词汇。\n11.当用户输入的视角为’第一人称‘视角时，分镜Format需要避免出现’并肩‘，’一起‘、相互’这种用于描述双人或者多人的状态的词汇。\n12.当用户输入的视角为’第一人称‘视角时，分镜Format的描述重点任务对象必须是用户输入图像中的人物，如必须描述其他人物或者人体部位，则也需要以输入图像中的人物为主体，如输入图像中的主体是一个女孩牵着一个手，则需要描述为女孩的手臂伸出，握住了一个男人的手，不能是一个男人的手握住了女孩张开的手。\n13.Format格式：[视角/景别/拍摄角度/]+[环境]+[主角特征] +[服饰，服饰细节]+ [当前身体朝向，身体姿态、手部，腿部，头部动作姿态、五官表情] + [核心动作状态]+[行为定义]+[旁白文字]。\n14.Format格式中的[核心动作状态]指的是人物动作的直白无修饰的动作和姿态描述，[行为定义]指的是人物的核心动作的定义，如[核心动作状态]是面相镜头端正坐着，右手举起勺子，放到嘴边，这时的[行为定义]就是吃饭。\n\nOutput Format (输出格式规范)\n严格按照以下格式逐条展示，需要使用标点符号进行断句：prompt1：[第一人称视角/近景/俯拍][卧室。][女性，二十八九岁。颧骨清晰，肤色白。眼型细长，瞳色榛褐，眉间距窄。唇薄，嘴角有纹路，][深灰羊绒开衫，V领，袖口挽至小臂。内搭黑色丝质吊带。米白色亚麻长裤，膝部有布料褶皱。赤足，可见脚背血管。，][身体朝向：身体背对着我。身体姿态： 身体呈正坐姿势，跪于深蓝色地垫中央。骨盆置于足跟之上，脊柱保持垂直，肩胛骨自然平贴后背，颈部竖直，下颌微收。手部： 左手手掌向上，五指并拢，指尖承托白色骨瓷碟的底沿。右手拇指指腹与食指侧面捏住银质小勺勺柄中段，其余三指指尖向内轻靠掌心。腿部： 双腿自大腿至小腿完全叠合并拢，小腿胫骨及脚背平贴于地垫表面，两脚大脚趾相触，脚跟向两侧微微分开。头部： 头部中轴线向左肩方向倾斜，使左耳接近左肩。未被束起的头发从左侧太阳穴附近垂落，发梢触及脸颊皮肤。五官表情：眉心微蹙][面相镜头端正跪坐着，右手举起勺子，放到嘴边[吃饭][\nprompt2：\nprompt3：\n...\n（以此类推）\nAction\n请执行生成，确保结果紧凑无空行，只输出Format，不输出故事！\n用户输入： \n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "title": "单图", "mode": 0, "bgcolor": "#353", "size": [210, 233.52044677734375], "pos": [218.27146911621094, 1629.4425048828125], "id": 229, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 2}, {"outputs": [{"name": "text", "links": [689], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["5个分镜，第一人称视角，女孩穿红色的短款紧身旗袍在卧室给我跳艳舞"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "title": "分镜数量/人称视角/场景要求", "mode": 0, "bgcolor": "#353", "size": [215.67929077148438, 88], "pos": [449.13885498046875, 1643.7020263671875], "id": 102, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "ord