7227478027344]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 15, "title": "CFG与步数调整", "bounding": [4068.59423828125, 3112.285400390625, 355.741943359375, 838.3124389648438]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 16, "title": "Group", "bounding": [3318.591552734375, 3822.28466796875, 320, 324.7591552734375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 17, "title": "加速LORA", "bounding": [3258.591796875, 3102.285400390625, 445.0699768066406, 197.85964965820312]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 18, "title": "Qwen-Image-Edit 的一大亮点在于其强大的语义和外观编辑功能。", "bounding": [3220.75634765625, 9.065135955810547, 1156.0780029296875, 80]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 19, "title": "语义编辑是指在保留原始视觉语义的同时修改图像内容。", "bounding": [3222.384765625, 109.30903625488281, 1158.949951171875, 80]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 20, "title": "为了直观地展示这一功能，我们以 Qwen 的吉祥物——水豚为例：", "bounding": [3220.4794921875, 225.31170654296875, 1182.5091552734375, 1718.98876953125]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 21, "title": "Qwen-Image-Edit 支持对物体进行 90° 和 180° 旋转，从而生成背面视图。", "bounding": [4435.37841796875, 211.842529296875, 1292.89501953125, 1739.8800048828125]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 22, "title": "风格转换是语义编辑的又一应用。Qwen-Image-Edit 可为人像应用多种艺术风格（如吉卜力）。", "bounding": [5761.20751953125, 214.21258544921875, 1699.9107666015625, 891.7457885742188]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 23, "title": "外观编辑要求在修改部分内容时保持画面其余部分不变。", "bounding": [5764.09521484375, 1185.544677734375, 1028.220947265625, 80]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 24, "title": "如图案例所示，Qwen-Image-Edit 不仅能插入招牌，还能生成逼真反射，细节处理出色。", "bounding": [5768.9267578125, 1289.18798828125, 1701.9620361328125, 889.9573974609375]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 25, "title": "下面是另一个有趣的例子，演示了如何从图像中去除细发丝和其他小物体。", "bounding": [5770.3623046875, 2219.461181640625, 1697.4520263671875, 941.3406982421875]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 26, "title": "此外，图像中特定字母“n”的颜色可以修改为蓝色，从而实现对特定元素的精确编辑。", "bounding": [5768.78271484375, 3199.334716796875, 1701.5125732421875, 891.60986328125]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 27, "title": "外观编辑在调整人物背景或更换服装等场景中也有广泛的应用。下面的三幅图分别展示了这些实际用例。", "bounding": [1315.424560546875, 189.3975067138672, 1837.798095703125, 1756.6116943359375]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 28, "title": "Qwen-Image-Edit 的另一大亮点在于其精准的文本编辑能力，这源于 Qwen-Image 在文本渲染方面的深厚功底。", "bounding": [3304.77734375, 1971.11962890625, 2421.86376953125, 828.1543579101562]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 29, "title": "Qwen-Image-Edit 还可以直接编辑中文海报，不仅可以修改大标题文本，还可以对细小复杂的文本元素进行精确调整。", "bounding": [7509.80322265625, 3674.294677734375, 2093.91943359375, 893.4234619140625]}, {"color": "#3f789e", "font_size": 100, "flags": {}, "id": 30, "title": "千问官方演示案例👇：", "bounding": [3217.843505859375, -199.17218017578125, 975.5258178710938, 137.22779846191406]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 31, "title": "我们通过一个具体的图像编辑示例来演示如何使用链式编辑方法逐步纠正 Qwen-Image 生成的书法作品中的错误：", "bounding": [7496.0302734375, 220, 2021.131103515625, 1004.6608276367188]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 32, "title": "在这幅作品中，几个汉字存在生成错误。我们可以利用 Qwen-Image-Edit 逐步纠正这些错误。", "bounding": [7506.0302734375, 1239.9998779296875, 2011.5595703125, 1254.4007568359375]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 33, "title": "例如，我们可以在原始图像上绘制边界框来标记需要校正的区域，并指示 Qwen-Image-Edit 修复这些特定区域。", "bounding": [7516.0302734375, 1329.9998779296875, 1956.4251708984375, 96.35079956054688]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 34, "title": "在这里，我们希望“稽”字能够正确地写在红色框内，而“亭”字能够准确地呈现在蓝色区域内。", "bounding": [7516.0302734375, 1449.9998779296875, 1608.5989990234375, 81.48643493652344]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 35, "title": "然而，在实际操作中，“稽”字相对模糊，模型未能一次性将其正确纠正。“稽”字的右下角部分应该是“旨”，而不是“日”。", "bounding": [7507.1123046875, 2517.572265625, 2056.652587890625, 1127.009521484375]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 36, "title": "此时，我们可以进一步用红框突出显示“日”部分，指示 Qwen-Image-Edit 微调此细节，将其替换为“旨”。", "bounding": [7507.1123046875, 2627.572265625, 1842.1181640625, 80]}, {"color": "#3f789e", "font_size": 40, "flags": {}, "id": 37, "title": "通过这种链式、循序渐进的编辑方法，我们可以不断地纠正字符错误，直到达到理想的最终结果。", "bounding": [9591.8427734375, 199.3605194091797, 2218.48828125, 4830.537109375]}], "links": [[778, 425, 0, 417, 0, "IMAGE"], [779, 427, 0, 419, 0, "MODEL"], [780, 447, 0, 419, 1, "CONDITIONING"], [781, 428, 0, 419, 2, "CONDITIONING"], [782, 429, 0, 419, 3, "LATENT"], [784, 422, 0, 421, 0, "IMAGE"], [785, 425, 0, 421, 1, "IMAGE"], [786, 419, 0, 422, 0, "LATENT"], [787, 416, 0, 422, 1, "VAE"], [788, 420, 0, 426, 0, "MODEL"], [789, 426, 0, 427, 0, "MODEL"], [790, 423, 0, 428, 0, "CLIP"], [791, 416, 0, 428, 1, "VAE"], [792, 417, 0, 428, 2, "IMAGE"], [793, 417, 0, 429, 0, "IMAGE"], [794, 416, 0, 429, 1, "VAE"], [795, 422, 0, 431, 0, "IMAGE"], [796, 423, 0, 447, 0, "CLIP"], [797, 416, 0, 447, 1, "VAE"], [798, 417, 0, 447, 2, "IMAGE"], [799, 459, 0, 420, 0, "MODEL"]], "id": "140bf715-d6a7-44f5-8526-56b8ca4019bf", "config": {}, "version": 0.4, "last_node_id": 459, "revision": 0}