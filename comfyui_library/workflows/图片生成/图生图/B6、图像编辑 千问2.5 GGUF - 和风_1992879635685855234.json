r": "#353", "size": [417.6200256347656, 68.88998413085938], "pos": [-992.6771850585938, 42.42852020263672], "id": 2, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UnetLoaderGGUF"}, "order": 3}, {"outputs": [{"name": "CONDITIONING", "links": [5], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#223", "widgets_values": ["将图中的人物，制作成一个精致的动漫手办模型。具体要求如下：\n大师级作品，最佳画质，超高细节，8K分辨率，一个精致的动漫手办模型，人物优雅地站立，微微侧身面向观众，一只手轻轻搭在腰间。\n脸部特征：必须是图像里的面容，精致的妆容，棕色盘发并有几缕发丝自然垂落，明亮的眼睛，红唇。\n服装：身穿白色抹胸礼服，礼服上绣有色彩柔和（蓝色、粉色）的花朵图案并点缀亮钻，下身是蓝色裙摆。佩戴华丽的项链和精美的耳饰。\n风格：PVC手办模型，光滑的塑料质感，细节锐利，专业的摄影棚灯光。\n背景：虚化的柔和背景，暖色调光线，简单的手办展示底座。"], "inputs": [{"name": "clip", "link": 4, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "TextEncodeQwenImageEdit", "mode": 0, "bgcolor": "#335", "size": [400, 200], "pos": [-120.0177993774414, 195.82757568359375], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEdit"}, "order": 9}, {"outputs": [{"name": "CLIP", "links": [4, 6], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#432", "widgets_values": ["qwen_2.5_vl_7b_fp8_scaled.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#653", "size": [499.9023132324219, 106], "pos": [-991.4887084960938, 195.47750854492188], "id": 5, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 4}, {"outputs": [], "color": "#323", "widgets_values": ["🌈 千问的优点擅长理解和推理，并完美支持中文语义，在千变万化的图形中展现出你想要的物体，尤其是在文字方面的展示。\n\n🦋 缺点是画质相对Flux和XL版本较弱一些。\n\n✍ 本工作流初次制作于2025年8月，目前没有后续更新，想要官版，直接修改模型节点和采样器即可，用这个版本是因为超过200字的复杂文本，最长时间也能控制在3分钟内。\n---\n\n和风工作流节点颜色简易区分：\n-\n\n- 💎蓝色为需求输入和结果获取；\n\n- ✅绿色为根据需求更换；\n\n- 💜紫色为注意参考；\n\n- ☝黄色为尽量不更改；\n\n- ❌红色为绝对不要更改；\n\n- 🔗灰色为其他默认链接框架。\n\n---\n\nq4和q8区别不大，但时间能相差几十秒；同理clip加载器不建议更改的原因提取的效果区别不大，但时间会更长。\n\n该工作流主要是依赖图文信息推理结果，需要对要修改的部分描述准确。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "工作流概览", "mode": 0, "bgcolor": "#535", "size": [388.40386962890625, 408.6056213378906], "pos": [-1486.365478515625, -98.63750457763672], "id": 16, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}}, "order": 5}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1853], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [140, 46], "pos": [776.8546752929688, 175.0802764892578], "inputs": [{"name": "samples", "link": 14, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 12, "type": "VAEDecode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 14}, {"mode": 0, "outputs": [], "size": [556, 704.7999267578125], "pos": [944.4945068359375, 174.2338104248047], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 1853, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 18, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 15}], "extra": {"links_added_by_ue": [1866, 1867, 1868, 1869], "ue_links": [{"controller": 13, "upstream": "8", "downstream_sl