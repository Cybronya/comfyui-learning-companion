nd and leg openings, subtle white text \"ARSLIN&AGUN\", \"FASHION DESIGN\" printed on waistband, soft studio lighting, directional key light from front-left, gentle highlights on left hip, subtle shadows on right, fill light to soften shadows, subtle rim light on right side, shallow depth of field, blurred modern bedroom background, dark wooden dresser with brass knobs, neutral tones, minimalist decor, calm and sophisticated mood, understated luxury aesthetic, sharp focus on fabric texture, natural skin texture, realistic skin details"], "inputs": [{"name": "clip", "link": 759, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 764, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"name": "configs", "link": 738, "label": "configs", "type": "LIST", "localized_name": "configs"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 774, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "return_full_refs_cond"}, "shape": 7, "name": "return_full_refs_cond", "label": "return_full_refs_cond", "type": "BOOLEAN", "localized_name": "return_full_refs_cond"}, {"widget": {"name": "instruction"}, "shape": 7, "name": "instruction", "label": "instruction", "type": "STRING", "localized_name": "instruction"}], "flags": {}, "id": 284, "type": "TextEncodeQwenImageEditPlusCustom_lrzjason", "properties": {"ver": "6c4107f5d154f700d166caa1c74675f4e40aadb0", "widget_ue_connectable": {"instruction": true, "return_full_refs_cond": true, "prompt": true}, "aux_id": "lrzjason/Comfyui-QwenEditUtils", "Node name for S&R": "TextEncodeQwenImageEditPlusCustom_lrzjason"}, "order": 30}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [453], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [398.6180114746094, 810.3177490234375], "pos": [-2977.96435546875, 160.95523071289062], "widgets_values": [1091359629774736, "fixed", 8, 1, "euler", "beta57", 1], "inputs": [{"name": "model"