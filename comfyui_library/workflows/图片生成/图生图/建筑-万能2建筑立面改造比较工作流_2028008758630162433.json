 "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "ref_image1", "label": "ref_image1", "type": "IMAGE", "localized_name": "ref_image1"}, {"shape": 7, "name": "ref_image2", "label": "ref_image2", "type": "IMAGE", "localized_name": "ref_image2"}, {"shape": 7, "name": "ref_image3", "label": "ref_image3", "type": "IMAGE", "localized_name": "ref_image3"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "link": 320, "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 311, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 193, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 12}, {"mode": 0, "outputs": [{"name": "output", "links": [], "type": "*", "localized_name": "output"}], "size": [444.4012756347656, 795.5498046875], "pos": [493.7780456542969, -293.6378173828125], "widgets_values": ["我将严格保留原图的建筑轮廓、透视角度、层高和体积感，仅对立面进行现代化翻新设计。以下是中文提示词：\n\n---\n\n## 建筑立面翻新设计提示词\n\n**【核心约束 - 严格保留】**\n- 三层骑楼建筑结构，底层商铺+上两层住宅的经典比例\n- 正面对称构图，微仰视角，35mm等效焦距的透视关系\n- 建筑总高与街道宽度的空间尺度不变\n- 顶层天台护栏轮廓、各层窗台水平线位置保持原状\n\n---\n\n**【立面翻新设计】**\n\n**整体风格**：当代岭南新中式 / 精致市井美学\n\n**材质系统**：\n- 主墙面：暖灰色水磨石肌理涂料，替代原有斑驳水泥\n- 窗框系统：深咖色阳极氧化铝合金，窄边框设计，保留格扇比例但升级为双层中空玻璃\n- 二层木质百叶：替换为碳化防腐木电动百叶，同色但质感提升\n- 三层露台：锈蚀钢板雨棚改为穿孔铝板遮阳系统，保留工业记忆\n\n**细部重构**：\n- 腰线装饰：原几何镂空花砖图案提取，以3D打印混凝土复刻，表面做旧处理\n- 一层商铺：卷帘门改为折叠式胡桃木格栅门，\"商平维修店\"招牌以黄铜立体字重现，保留手写体韵味\n- 线缆管理：全部入地或隐藏于定制金属线槽，立面整洁\n\n**色彩策略**：灰褐基调（#8B8680）+ 原木点缀（#A0522D）+ 黄铜细节，克制而温暖\n\n---\n\n**【环境氛围】**\n晴朗上午侧光，街道保留生活气息，行人可更新为现代着装，但保留电动车等市井元素\n\n---\n\n**技术参数**：建筑摄影级写实渲染，8K，V-Ray/ Corona 质感，长焦压缩感，f/8景深\n\n如需英文版或针对特定AI模型优化，请告知。"], "inputs": [{"shape": 7, "name": "anything", "link": 314, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 170, "type": "easy showAnything", "properties": {"hasSecondTab": false, "cnr_id": "comfyui-easy-use", "ver": "e900c2ca9c0d90b0896881910ca7f3f02d88ebd8", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "easy showAnything", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 14}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [794.8097534179688, 983.9780883789062], "pos": [2017.857421875, -408.5699768066406], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 318, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "文件名前缀", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 31, "type": "SaveImage", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.11.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"filename_prefix": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "SaveImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 16}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "links": [], "la