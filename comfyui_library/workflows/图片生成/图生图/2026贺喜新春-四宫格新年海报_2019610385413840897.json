nectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"batch_size": true, "width": true, "height": true}, "Node name for S&R": "EmptySD3LatentImage"}, "order": 5}, {"outputs": [{"name": "prompt_list", "label": "prompt_list", "type": "LIST", "localized_name": "prompt_list"}, {"shape": 6, "name": "prompt_strings", "links": [54], "label": "prompt_strings", "type": "STRING", "localized_name": "prompt_strings"}], "color": "#233", "widgets_values": ["图1中人物位于前景，面对镜头，表情开心，穿着喜庆的唐装，笑容满满，头戴繁复金冠缀红绒球，双手抱拳的姿势拜年。背景是元旦海报，海报上写着“2026新年快乐”，色彩鲜艳，充满节日气氛，照片级真实感，高保真，8K分辨率", "图1中人物身着华丽传统红色婚服，面对镜头，表情开心，头戴繁复金冠缀红绒球，手持“马到成功”红绸卷轴，背景为中式婚庆场景，红灯笼、金元宝、骏马装饰与“福”“财”字样营造喜庆氛围。服饰绣有龙凤图案，象征吉祥圆满，整体构图庄重喜庆，色彩浓烈。", "图1人物穿着中国传统新年鲜艳的红色丝绸长袍，面对镜头，表情开心，上面装饰着精致的金色刺绣，双手持有一幅红底金字的竖幅，上书“恭喜发财”，字体工整，边框饰以金线花纹，象征吉祥与财富。精致的头饰装饰着红色的绒球、金色的细节和珍珠装饰。背景以红色和金色的中国灯笼、传统图案和金色仪式物品为特色，包括金狮雕像和珍珠项链，色彩浓烈。", "图1人物身着华丽传统红色婚服，面对镜头，表情开心，服装上刺绣着金色马，头戴繁复金冠缀红绒球，在右方手持“吉祥如意”红绸卷轴，背景为中式婚庆场景，红灯笼、金元宝、骏马装饰与“福”“财”字样营造喜庆氛围。服饰绣有龙凤图案，象征吉祥圆满，色彩浓烈。", "新年，图中人物位于前景，面对镜头，表情沉稳，身着红色灯芯绒外套，双手抱拳作拜年姿势。背景是红色灯笼墙，两侧印有金色祝福语（左：吃好喝好 好满福满 口福；右：福气运气 满元气），海报设计风格，高分辨率。"], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "optional_prompt_list", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {"collapsed": false}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [468.37799072265625, 324], "pos": [-752.9990844726562, 10