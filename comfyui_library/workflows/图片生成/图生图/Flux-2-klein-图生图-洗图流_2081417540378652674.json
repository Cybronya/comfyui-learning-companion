2109375], "id": 64, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 4}, {"outputs": [{"name": "model", "links": [76], "label": "model", "type": "MODEL", "localized_name": "model"}], "color": "#223", "widgets_values": ["flux-2-klein-9b-Q4_K_M.gguf"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}], "flags": {}, "type": "UnetLoaderGGUF", "mode": 0, "bgcolor": "#335", "size": [323.0045166015625, 58], "pos": [-785.8760986328125, 591.7661743164062], "id": 55, "properties": {"cnr_id": "ComfyUI-GGUF", "ver": "01f8845bf30d89fff293c7bd50187bc59d9d53ea", "ue_properties": {"widget_ue_connectable": {"unet_name": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"unet_name": true}, "Node name for S&R": "UnetLoaderGGUF"}, "order": 5}, {"outputs": [{"name": "output", "links": [68, 69, 81], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "color": "#233", "widgets_values": ["Normal - Describe", "你是文生图大模型的prompt撰写大师，把这张图片的prompt用英文给我写出来。", "你是一名专业的AI绘画领域文生图提示词生成专家。\n\n你的核心任务是对用户提供的任何图片进行详尽、准确的反向工程分析，并生成可直接用于文生图模型的全中文高质量大众化合法合规的提示词。\n\n请从以下五个维度进行系统化分析：\n\n主体：明确画面中的主要对象，包括人物（性别、年龄、种族、姿态、表情、服装细节、配饰）、动物、物体或抽象元素，描述其特征、数量、位置及相互关系。\n环境：详细说明主体所处的空间或场景，包括室内/室外、自然/人造、具体地点（如森林、城市街道、实验室、日式庭院）、天气、时间（清晨、黄昏、夜晚等）及背景细节。\n氛围：捕捉画面整体情绪与感官基调，如梦幻、阴郁、温馨、科幻感、神秘、宁静、紧张、浪漫等，并结合光影（柔光、高对比、逆光、霓虹照明等）和色彩倾向（冷色调、暖色调、单色、高饱和等）强化氛围表达。\n风格：精准识别艺术或视觉风格，如写实摄影、赛博朋克、水墨国画、浮世绘、皮克斯3D、蒸汽波、油画质感、动漫插画、极简主义、超现实主义等，并注明参考艺术家或流行模型风格（如Greg Rutkowski、Makoto Shinkai等，若适用）。\n拍摄方式：模拟图像的成像视角与技术参数，包括镜头类型（广角、长焦、鱼眼）、景别（特写、中景、全景）、视角（俯视、仰视、平视）、景深（浅景深、大景深）、构图（对称、三分法、引导线）以及是否具有摄影/渲染特效（动态模糊、胶片颗粒、景深虚化、HDR等）。\n最终输出要求：\n\n使用纯中文，不含任何Markdown格式、标题、编号或自然段落；\n以关键词密集、结构紧凑的短语形式呈现，各要素间用逗号分隔；\n优先使用文生图模型常用术语，确保提示词可直接复制用于主流AI绘画工具；\n不添加解释性文字、问候语或总结句，仅输出最终提示词文本。", "one by one", 24, 256, 532301318951784, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 70, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 71, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 73, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "