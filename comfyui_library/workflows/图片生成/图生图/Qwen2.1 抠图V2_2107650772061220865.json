色保持原样。保持所有未被上述操作涉及的主体属性与输入图一致，不重新设计、不改变原有风格。适度修复提取过程中可见的模糊边缘和锯齿，使轮廓清晰、连续，同时保持原有线条粗细和细节层级。最终仅保留完整目标 UI 主体，主体之外为真正透明区域，保留 Alpha 通道。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 488, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.53.6", "VHS_latentpreview": false, "ds": {"offset": [139.66688262391466, -1732.0783102138525], "scale": 1.0610764609500063}}, "groups": [], "links": [[729, 478, 0, 480, 1, "VAE"], [731, 481, 0, 480, 0, "LATENT"], [732, 482, 0, 481, 3, "LATENT"], [734, 476, 0, 483, 0, "MODEL"], [735, 483, 0, 481, 0, "MODEL"], [736, 484, 0, 481, 1, "CONDITIONING"], [737, 484, 1, 481, 2, "CONDITIONING"], [750, 477, 0, 484, 0, "CLIP"], [752, 478, 0, 484, 2, "VAE"], [766, 13, 0, 479, 0, "INT"], [767, 13, 1, 479, 1, "INT"], [768, 470, 0, 484, 1, "IMAGE"], [770, 484, 2, 482, 1, "LATENT"], [771, 479, 0, 482, 0, "LATENT"], [772, 480, 0, 485, 0, "IMAGE"], [775, 488, 0, 484, 3, "STRING"]], "id": "54bb395d-3e60-4c94-b525-85523901575b", "config": {}, "version": 0.4, "last_node_id": 489, "revision": 0}