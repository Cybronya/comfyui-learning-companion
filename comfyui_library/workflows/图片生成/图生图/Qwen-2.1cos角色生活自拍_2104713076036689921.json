ties": {"cnr_id": "comfy-core", "ver": "0.36.0", "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 15}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [688], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [444.24755859375, 94.41840362548828], "pos": [1396.10546875, 254.84109497070312], "widgets_values": ["qwen_image_2.1_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 451, "type": "UNETLoader", "title": "① 加载 Qwen Image 2.1 扩散模型", "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen_image_2.1_bf16.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_bf16.safetensors"}], "ver": "0.36.0", "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 4}, {"mode": 0, "outputs": [{"name": "CLIP", "links": [721], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [405.6150207519531, 106], "pos": [1414.8287353515625, 418.23828125], "widgets_values": ["qwen3vl_8b_int8_convrot.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 453, "type": "CLIPLoader", "title": "② 加载 Qwen3-VL 图文编码器", "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen3vl_8b_bf16.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_bf16.safetensors"}], "ver": "0.36.0", "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 5}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [704, 744], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [300, 314], "pos": [520, 300], "widgets_values": ["234c4d20eb0fcb3a0c29fb7ba2dfb763de78d558560f71f74fe8dcd36f1539f0.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 470, "type": "LoadImage", "title": "图1 · 编辑目标（固定启用）", "properties": {"cnr_id": "comfy-core", "ver": "0.36.0", "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 6}, {"mode": 0, "outputs": [{"name": "STRING", "links": [746], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [400.716064453125, 549.0195922851562], "pos": [2065.377685546875, 1106.8865966796875], "widgets_values": [], "inputs": [{"name": "source", "link": 745, "label": "source", "type": "*", "localized_name": "source"}], "flags": {}, "id": 499, "type": "PreviewAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 12}, {"outputs": [{"name": "RESPONSE", "links": [745], "label": "RESPONSE", "type": "STRING", "localized_name": "RESPONSE"}], "color": "#28403f", "widgets_values": ["Qwen3-VL-4B-Instruct", "None (FP16)", "🖼️ Detailed Description", "参考图片，生成四宫格图片提示词，无框，无水印，\n将图片游戏人物变为真实人物COSER，保持整体服饰、妆造一致，服饰人物有头套就要保留，如果是玩偶服也尽量保留，，也尽量写实还原。\n*整体设定：** 手机原生实拍质感，各种角度，4K，手持拍摄轻微自然抖动，生活化随手记录风，无专业打光，自然光真实氛围感，色调偏原生直出、轻微暖调，无过度美颜。\n人物参考图像。\n随意展示人物生活日常，写实风格，无边框，无文字，全流程第二视角手机随手拍感，从生活化场景任意挑选一个生成一张照片，可以是足球馆、广场、超市、逛街、学校、公园、食堂等任何生活场景的一个，最好是生活化的场景，具有真实感。\n人物清晰，高分辨率，整体画面必须干净，平滑，统一，强调大色块叙事与整体轮廓，不要细碎噪点，不要高频纹理，不要脏污颗粒，不要密集小装饰，边缘清晰利落，颜色过渡平滑柔和有光晕，线条连续利落。\n严格示例格式双输出，禁止无关回复内容。\n示例格式：\n以图像中的女性角色为人物参考，生成一幅竖版2×2四宫格生活随拍图。严格保持图像中角色的银白色长发向后梳拢、露出额头、发长及背，清冷面容与深色眼妆，以及白色立领绣花旗袍（梅花花枝刺绣纹样、一字盘扣）、肩部浅色披风等服饰妆造完全一致，由真实COSER写实还原为真人质感。画面分为四个无框格子：左上格为她在超市货架前手推购物车低头挑选商品；右上格为她在城市步行街上撑一把浅色伞缓步前行；左下格为她坐在公园长椅上侧身眺望；右下格为她在食堂窗口前端着餐盘取餐。四个画面均为第二视角他人随手拍摄的手机原生实拍质感，手持轻微自然抖动，无专业打光，自然光真实氛围，色调原生直出、轻微暖调，无过度美颜，人物清晰、高分辨率，四格之间无分隔边框、无水印、无任何文字，画面干净平滑统一，颜色过渡柔和有光晕，边缘清晰利落。\n", 2048, true, 15455403806569, "randomize", "auto"], "inputs": [{"shape": 7, "name": "image", "link": 744, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "max_tokens"}, "name": "max_tokens", "label": "max_tokens", "type": "INT", "localized_name": "max_tokens"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention_mode"}, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}], "flags": {}, "type": "AI