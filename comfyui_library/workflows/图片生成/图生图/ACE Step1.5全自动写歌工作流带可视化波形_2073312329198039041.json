灵魂去疯狂\n这世界锁不住渴望\n\n[Instrumental Break]\n\n[Chorus - Layered Vocals]\n冲破那无边黑暗\n光束驱散悲伤酸\n虚伪遮眼无需问\n黑夜是我唯一的吻\n\n[Outro - Synth Melody Fades Out]", 90, 120, "C major", "4"], "inputs": [{"widget": {"name": "caption"}, "name": "caption", "link": 32, "label": "caption", "type": "STRING", "localized_name": "caption"}, {"widget": {"name": "lyrics"}, "name": "lyrics", "link": 33, "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}, {"widget": {"name": "bpm"}, "name": "bpm", "link": 43, "label": "bpm", "type": "INT", "localized_name": "bpm"}, {"widget": {"name": "duration"}, "name": "duration", "link": 44, "label": "duration", "type": "FLOAT", "localized_name": "duration"}, {"widget": {"name": "keyscale"}, "name": "keyscale", "link": 48, "label": "keyscale", "type": "STRING", "localized_name": "keyscale"}, {"widget": {"name": "timesignature"}, "name": "timesignature", "label": "timesignature", "type": "STRING", "localized_name": "timesignature"}], "flags": {}, "id": 25, "type": "RunningHub ACE-Step GenerationParams", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RunningHub ACE-Step GenerationParams"}, "order": 22}, {"mode": 0, "outputs": [{"name": "", "links": [48], "type": "*"}], "size": [75, 26], "pos": [1580.28515625, 947.722412109375], "inputs": [{"widget": {"name": "value"}, "name": "", "link": 47, "type": "*"}], "flags": {}, "id": 31, "type": "Reroute", "properties": {"horizontal": false, "widget_ue_connectable": {}, "showOutputText": false}, "order": 14}, {"mode": 0, "outputs": [{"name": "any", "links": [47], "label": "any", "type": "*", "localized_name": "any"}], "size": [216.08160400390625, 88], "pos": [-466.3190002441406, 978.9732666015625], "widgets_values": ["C major"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 37, "type": "1hew_TextToAny", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "1hew_TextToAny"}, "order": 10}, {