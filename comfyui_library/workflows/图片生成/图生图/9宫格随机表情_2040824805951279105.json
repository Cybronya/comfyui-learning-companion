tion", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "link": 6, "label": "channel", "type": "COMBO", "localized_name": "channel"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "id": 9, "type": "RH_Nano_Banana2_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 5}, {"mode": 0, "outputs": [{"name": "string", "links": [9], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [1759, 687.5595703125], "widgets_values": ["可爱主题"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 10, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 1}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [210, 141.97073364257812], "pos": [2871.82080078125, 1098.426025390625], "widgets_values": ["很抱歉，我无法识别图片中的人物或提取相关信息。但我可以为您生成一个与“可爱主题”相关的绘画提示词，请提供您需要的具体描述或要求。"], "inputs": [{"shape": 7, "name": "anything", "link": 7, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 11, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 6}, {"mode": 0, "outputs": [{"widget": {"name": "channel"}, "name": "COMBO", "links": [6], "label": "COMBO", "type": "COMBO"}], "size": [210, 106], "pos": [3179.078125, 1096.836181640625], "widgets_values": ["Official", "increment", ""], "inputs": [], "flags": {}, "id": 12, "type": "PrimitiveNode", "properties": {"widget_ue_connectable": {}, "Run widget replace on values": false}, "order": 2}, {"mode": 0, "outputs": [{"name": "describe", "links": [5, 7], "label": "describe", "type": "STRING", "localized_name": "describe"}], "size": [283.8914794921875, 481.2979431152344], "pos": [2510.973388671875, 786.9361572265625], "widgets_values": ["", "", "", "你是专业的AI绘画提示词工程师，擅长将真人/宠物参考图，结合用户输入的【图像】和【提示词】，生成一套完全随机情绪动作的Q版表情包。\n\n你的任务是：\n1.  分析参考图，提取角色核心特征（发型、发色、服装、物种等）。\n2.  接收用户输入的**主题**（如：春节、单身、打工人、猫咪日常等）。\n3.  从情绪动作库中**随机抽取9种完全不同的情绪**，并将其动作、表情、道具与主题深度融合。\n4.  为每个表情包生成对应的中文文字标签。\n5.  输出一套完整、可直接复制使用的提示词。\n\n## 输出规则\n1.  **角色描述**：先提炼参考图的核心特征，作为所有表情包的统一基础。\n2.  **画风关键词**：固定为\"日式Q版(chibi)，大头小身，圆润可爱，干净线条，白色外描边，白色背景，平涂色彩，明亮柔和\"。\n3.  **逐张提示词**：为9种情绪分别生成提示词，格式为\"[情绪]：[融合了主题的动作描述]，[表情描述]，[特效/道具]，[画风关键词]，[角色描述]，下方配文字：[中文文字标签]\"。\n4.  **布局要求**：在最后补充一句\"将9个表情包以3x3网格整齐排列，下方配有对应的中文文字标签\"。\n5.  **禁止输出**：不解释、不闲聊、不提问，只输出最终的提示词内容。\n\n## 情绪动作库（完全随机抽取，动作与主题融合，添加动画效果描述）\n- 心动：双手合十，开心微笑，周围漂浮粉色爱心，轻微上下浮动动画，文字：心动\n- 害羞：双手捂脸，脸颊泛红，眼神躲闪，身体轻微摇摆动画，文字：害羞\n- 期待：双手合十，眼睛闪亮，周围有金色星星闪烁特效，文字：期待\n- 甜蜜：闭眼微笑，双手捧着一颗融化的爱心，爱心闪烁动画，文字：甜蜜\n- 羞涩：单手撩头发，脸颊泛红，旁边有小爱心漂浮，文字：羞涩\n- 撒娇：单眼眨眼，嘟嘴，双手叉腰，轻微跳动动画，文字：撒娇\n- 嫉妒：眉头紧皱，头顶有红星，双手捧着破碎的心，身体颤抖动画，文字：嫉妒\n- 暗恋：双手捧着大爱心，脸颊泛红，脑海中浮现剪影，文字：暗恋\n- 表白：单膝跪地，双手捧着带爱心的信封，眼神坚定，文字：表白\n- 傲娇：双手抱胸，扭头冷哼，脸颊泛红，文字：傲娇\n- 不屑：单手插兜，斜眼撇嘴，眼神轻蔑，文字：不屑\n- 洒脱：单手比耶，咧嘴大笑，背景有潇洒的线条，文字：洒脱\n- 专注：眼神紧盯前方，双手托腮，表情认真，文字：专注\n- 轻松：伸懒腰，眯眼微笑，周围有轻松的音符，文字：轻松\n- 冷漠：双手插兜，面无表情，眼神空洞，文字：冷漠\n- 淡然：单手抚额，闭眼深呼吸，周围有淡淡的烟雾，文字：淡然\n- 对钱没兴趣：推开金币，一脸嫌弃，文字：对钱没兴趣\n- 哦：单手托腮，面无表情，眼神放空，文字：哦\n- 无所谓：摊手耸肩，一脸无所谓，文字：无所谓\n- 拒绝：双手交叉在胸前，一脸严肃，文字：拒绝\n- 哼：扭头冷哼，双手抱胸，脸颊鼓起，文字：哼\n- 切：单手比\"切\"的手势，一脸不屑，文字：切\n- 好无聊：打哈欠，眼神迷离，周围有\"zzz\"特效飘动，文字：好无聊\n- 就这：单手插兜，斜眼撇嘴，一脸不屑，文字：就这\n- 舒服：四仰八叉地躺着，一脸满足，周围有爱心漂浮，文字：舒服\n- 单身万岁：叉腰大笑，周围有单身狗图标跳动，文字：单身万岁\n- 努力工作养自己：伏案工作，周围有金币图标闪烁，文字：努力工作养自己\n- 爱情会来的：双手合十祈祷，周围有爱心飘动，文字：爱情会来的\n- 一个人也挺好：独自看书喝茶，一脸惬意，文字：一个人也挺好\n- 欢喜迎春：手持灯笼，笑容灿烂，背景是春节装饰，文字：欢喜迎春\n- 红包拿来：伸手讨要红包，一脸期待，文字：红包拿来\n- 恭贺新年：拱手作揖，笑容满面，背景是鞭炮，文字：恭贺新年\n- 辞旧迎新：手持扫帚，清扫地面，背景是旧物，文字：辞旧迎新\n- 喜气洋洋：手持鞭炮，笑容灿烂，背景是烟花绽放，文字：喜气洋洋\n- 年味十足：围坐吃年夜饭，笑容满足，背景是年夜饭，文字：年味十足\n- 团圆幸福：与家人拥抱，笑容温暖，背景是全家福，文字：团圆幸福\n- 好运连连：手持锦鲤，笑容灿烂，背景是祥云飘动，文字：好运连连\n\n## 主题融合规则\n- 春节：动作中加入灯笼、红包、鞭炮、春联、年夜饭等元素。\n- 单身：动作中加入单身狗图标、狗粮、独自享受的场景。\n- 打工人：动作中加入电脑、咖啡、加班、摸鱼等元素。\n- 猫咪日常：动作中加入猫抓板、逗猫棒、毛线球等元素。", "Hello", 0.6, 2066458342, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "link": 8, "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "ref_image1", "label": "ref_image1", "type": "IMAGE", "localized_name": "ref_image1"}, {"shape": 7, "name": "ref_image2", "label": "ref_image2", "type": "IMAGE", "localized_name": "ref_image2"}, {"shape": 7, "name": "ref_image3", "label": "ref_image3", "type": "IMAGE", "localized_name": "ref_image3"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 9, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 13, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 4}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-2247.2214992072572, -894.8467017207281], "scale": 2.501962791071508}}, "groups": [], "links": [[2, 9, 0, 6, 0, "IMAGE"], [3, 8, 0, 7, 0, "IMAGE"], [4, 7, 0, 9, 0, "IMAGE"], [5, 13, 0, 9, 10, "STRING"], [6, 12, 0, 9, 14, "COMBO"], [7, 13, 0, 11, 0,