", "links": [38], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 200], "pos": [-790.6204223632812, -587.0407104492188], "widgets_values": ["这是一张高级质感产品主图编辑效果图，画面以单个高客单价商品为视觉核心，完整保留原产品的外观结构、品牌特征、颜色、材质纹理和真实比例，对产品进行商业级主图美化与高端视觉升级；背景被替换为有质感的高端场景背景，采用奢华极简风、轻奢电商风、品牌广告大片风的构图方式，画面空间层次清晰，产品居中突出或略微黄金分割摆放，具有强烈的首页首屏吸引力；灯光经过精细优化，包含柔和主光、边缘轮廓光、顶部高光、环境反射光和自然阴影，使产品表面更有高级材质质感，整体明暗对比自然，细节清晰锐利；画面色调统一，高级、克制、干净，背景不抢主体，突出产品价值感、品质感、昂贵感和品牌感，适用于电商广告投放主视觉；最终图像具有商业摄影棚拍质感、高清细节、真实光影、精致阴影、专业构图、高转化率视觉效果"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 41, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 1}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [2164.34711978479, 919.2506653833717], "scale": 1.0610764609500014}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Group", "bounding": [-1455.6392822265625, -788.2730712890625, 3321.50341796875, 916.0418090820312]}], "links": [[32, 3, 0, 37, 0, "IMAGE"], [33, 37, 1, 32, 0, "IMAGE"], [38, 41, 0, 37, 1, "STRING"]], "id": "4f42da33-2346-4dd3-bda8-69237afd8ce6", "config": {}, "version": 0.4, "last_node_id": 41, "revision": 0}