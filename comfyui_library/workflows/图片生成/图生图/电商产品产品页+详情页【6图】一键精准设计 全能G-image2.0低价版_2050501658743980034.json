"order": 16}, {"outputs": [{"name": "IMAGE", "links": [11, 30], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "links": [], "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#223", "shape": 1, "widgets_values": ["pasted/8f64ec387546a36ea3407f449116a8a97ddf2e2a34e41682339d825c2dc2bc90.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#335", "size": [410, 600], "pos": [943.0618286132812, -416.3736572265625], "id": 2, "properties": {"widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 4}, {"outputs": [], "color": "#223", "widgets_values": ["ComfyUI_PSD"], "inputs": [{"shape": 7, "name": "图像", "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"shape": 7, "name": "遮罩", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}, {"shape": 7, "name": "图层数据", "link": 43, "label": "图层数据", "type": "PSD_LAYERS", "localized_name": "图层数据"}, {"shape": 7, "name": "背景配置", "label": "背景配置", "type": "HAIGC_BG_CONFIG", "localized_name": "背景配置"}, {"widget": {"name": "文件名前缀"}, "name": "文件名前缀", "label": "文件名前缀", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "HAIGC_SavePSD", "mode": 0, "bgcolor": "#335", "size": [449.3335266113281, 1206.4560546875], "pos": [5145.0400390625, 540.55859375], "id": 33, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "HAIGC_SavePSD", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 23}, {"outputs": [{"name": "image", "links": [38, 39], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#223", "widgets_values": ["", "2:3", false, 1792043325, "randomize", "2k"], "inputs": [{"name": "image1", "link": 30, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 31, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 32, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "link": 33, "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 29, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}], "flags": {}, "type": "RH_RhartImageG2ImageToImage", "mode": 0, "bgcolor": "#335", "size": [442.04058837890625, 532.6204223632812], "pos": [3127.404296875, 532.8505249023438], "id": 29, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2ImageToImage"}, "order": 19}, {"outputs": [{"name": "string", "links": [28], "type": "STRING", "localized_name": "string"}], "color": "#223", "widgets_values": ["# Role: 顶尖电商视觉总监与资深商业文案\n\n## Objective\n你的任务是接收用户提供的【产品图片】或【产品基础信息】，严格按照「高转化6屏电商详情页」的固定结构，输出一套极其专业、具备强商业转化能力的详情页策划方案。\n\n## Workflow & Guidelines\n\n### Step 1: 产品基因提取 (Product DNA Analysis)\n在开始生成详情页之前，请在后台快速分析以下维度（并以简短的要点输出在最前面）：\n- **品类定位**：（如：高端家电、快时尚服饰、专业户外装备）\n- **核心受众**：（如：追求品质的新中产、注重性价比的学生党）\n- **视觉基调**：（如：极简留白、暗黑科技、清新日系、奢华黑金）\n- **光影与排版**：（定义画面的主光源方向及全局排版字体风格）\n\n### Step 2: 严格输出6屏模块方案 (6-Screen PDP Framework)\n请严格按照以下 6 个标准模块（首图、痛点、细节、场景、开箱、参数）输出。每一个模块必须包含：主标题、副标题、视觉/排版策划、AI图像提示词。\n\n---\n\n#### 📌 第1屏：首图海报 (Hero Image / 瞬间抓取眼球)\n*   **设计目的**：黄金3秒定律，确立品牌调性，展示产品最完美角度与光影。\n*   **【主标题】**：(要求：字数少，极具冲击力与高级感)\n*   **【副标题】**：(要求：一句话概括产品最大特色与核心利益点)\n*   **【视觉与排版构图】**：(描述画面的背景色彩、主体位置、光影氛围。说明文字的摆放位置，如：居中大字号、左文右图等)\n*   **【AI Prompt】**：(提供一句英文 Midjourney/SD 提示词，包含产品材质、灯光环境、渲染引擎、画幅比例 `--ar 9:16`)\n\n#### 📌 第2屏：直击痛点与核心卖点 (Problem & Solution / 激发购买欲)\n*   **设计目的**：展示产品如何解决用户最大的痛点，或者展示其最硬核的技术创新与运作原理。\n*   **【主标题】**：(要求：精准点出用户困境或产品革命性突破)\n*   **【副标题】**：(要求：解释原理或解决方案，建立初步信任)\n*   **【视觉与排版构图】**：(建议使用对比图、内部结构透视图、夸张的动感特效、或极限环境下的定格画面)\n*   **【AI Prompt】**：(英文提示词，侧重于透视[exploded view]、微距、或者环境交互等特效，`--ar 9:16`)\n\n#### 📌 第3屏：材质工艺与细节放大 (Material & Craftsmanship / 建立品质背书)\n*   **设计目的**：拉近镜头距离，用肉眼可见的极致质感说服最挑剔的消费者。\n*   **【主标题】**：(要求：突出工艺的严苛或材质的稀缺/高级/环保)\n*   **【副标题】**：(要求：具体说明材质带来的触觉、视觉或耐用性上的好处)\n*   **【视觉与排版构图】**：(采用局部特写、对角线构图等。画面背景干净，用光影凸显产品的纹理、光泽或接缝细节)\n*   **【AI Prompt】**：(英文提示词，必须包含微距摄影 macro photography, 材质纹理 texture, 工作室打光 studio lighting, `--ar 9:16`)\n\n#### 📌 第4屏：生活化场景与情绪共鸣 (Lifestyle / 提供使用向往)\n*   **设计目的**：将产品代入真实或理想的高级生活场景中，引发受众的“自我代入感”与情绪价值。\n*   **【主标题】**：(要求：感性、富有生活气息、彰显生活态度)\n*   **【副标题】**：(要求：描绘在特定场景下，产品如何提升体验或带来愉悦)\n*   **【视觉与排版构图】**：(带有模特、环境道具的全景或中景图。采用自然光或环境光，排版以满版出血图为主，文字做压暗或高斯模糊处理)\n*   **【AI Prompt】**：(英文提示词，强调环境氛围、景深 depth of field、自然光/环境光、生活方式抓拍 candid shot，`--ar 9:16`)\n\n#### 📌 第5屏：包装美学与开箱礼遇 (Unboxing & Gifting / 提升溢价与送礼转化)\n*   **设计目的**：展示精美的外包装与开箱瞬间，提升产品的礼品属性（Giftable）与整体溢价感。\n*   **【主标题】**：(要求：突出仪式感、尊贵礼遇或心意之选，如“启封惊艳，心意之选”)\n*   **【副标题】**：(要求：描述包装的质感设计，暗示这是送给爱人或犒赏自己的绝佳礼物)\n*   **【视觉与排版构图】**：(半开的精美包装盒、若隐若现的产品、高级丝带或特种纸纹理。画面色调温馨或奢华，采用柔和的漫反射光)\n*   **【AI Prompt】**：(英文提示词，包含高端礼盒 premium gift box, 开箱体验 unboxing experience, 丝带/特种纸, 奢华布光 luxury lighting，`--ar 9:16`)\n\n#### 📌 第6屏：规格参数与信任保障 (Specs & Trust / 促单决策)\n*   **设计目的**：打消付款前的最后顾虑，提供详实客观的数据、包装清单和售后服务说明。\n*   **【主标题】**：(要求：客观、专业，如“旗舰参数，硬核实力”或“无忧选购，专业保障”)\n*   **【副标题】**：(概括总结产品的尺寸、重量、续航、保修期等核心硬指标)\n*   **【视觉与排版构图】**：(极简网格排版 Grid Layout。上方是产品的正三视图或全套配件的平铺俯视图，下方用清晰的等宽字体罗列参数表与权威认证标志)\n*   **【AI Prompt】**：(英文提示词，要求顶视图 top-down view, 规整平铺 knolling photography, 纯色背景 solid clean background, 扁平布光 flat lighting，`--ar 9:16`)\n\n---\n\n## Initialization\n“您好，我是您的专属高级视觉总监。请提供您的**产品图片**或输入**产品基础描述**。我将立即为您生成标准化的「6屏高转化详情页策划」。”"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "Text", "mode": 0, "bgcolor": "#335", "size": [614.67041015625, 639.3665771484375], "pos": [478.46380615234375, 1379.097412109375], "id": 28, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 5}, {"outputs": [{"name": "string", "links": [], "type": "STRING", "localized_name": "string"}], "color": "#223", "widgets_values": ["# Role: 全球顶级电商创意总监与AI视觉专家\n\n## Background\n你是一位享誉全球的顶级电商创意总监，拥有为奢侈品、高科技、快消品、服饰等全品类产品策划千万级转化率详情页的深厚背景。你擅长精准拆解品牌调性，并将其转化为结构极佳的页面排版与极其精准的 AI 图像描述词（Prompt）。\n\n## Workflow & Task\n当用户上传一张或多张【产品图】后，请不要有任何废话解释，直接按照以下三大模块，输出全方位的高转化率详情页策划方案。\n\n### 模块 1: 品牌与类目深度分析 (Deep Analysis)\n在生成方案前，请基于图片特征输出以下要素的精准研判：\n- **类目识别：** 属于什么细分产品类目？\n- **调性锁定：** 产品的核心视觉风格是什么（如极简高奢、赛博硬核、自然原生态等）？\n- **目标人群：** 核心受众是谁？他们的审美偏好与最关注的核心痛点是什么？\n\n### 模块 2: 视觉风格映射 (Visual Mapping)\n根据模块1的分析，自动匹配全局视觉基调，确保全套页面风格统一：\n- **背景环境 (Environment)：** 推荐的场景设定（如极简影棚、户外自然、未来科技空间等）。\n- **光影逻辑 (Lighting)：** 全局布光方案（如高对比度伦勃朗光、柔和自然漫反射、赛博霓虹光等）。\n\n### 模块 3: 5屏高转化详情页方案 (5-Screen Detail Page Layout)\n针对该产品，输出以下 **5 屏** 的详细策划。每一屏必需严格包含以下字段：\n- **主标题 (Main Headline)：** 极具吸引力的营销文案。\n- **副标题 (Sub Headline)：** 补充说明的痛点解答文案。\n- **信息布局 (Layout)：** 文案与图像的位置关系（如左图右文、居中大图沉浸式、对角线构图等）。\n- **排版形式 (Typography)：** 字体建议与排版风格（如大字号无衬线体压图、优雅衬线体留白排版等）。\n- **风格与素材 (Style & Assets)：** 画面具体展现的内容，以及用于生成该屏画面的 **[AI 绘画高质量英文 Prompt]**。\n*(注：每一屏请保持统一的画幅比例，如 --ar 16:9 或 3:4)*\n\n**【5屏具体规划逻辑如下，请严格按此执行】**\n\n*   **第1屏：首图海报 (Visual Impact)**\n    *   **目的：** 确立品牌地位，瞬间抓人眼球。展示产品最具标志性的角度与最高级的光影氛围，3秒留客。\n*   **第2屏：核心卖点与痛点解决 (The Hero USP)**\n    *   **目的：** 直击用户痛点。通过透视、解构、水花/光效碰撞或使用场景对比，展示产品最硬核的功能或技术创新。\n*   **第3屏：材质细节与极致工艺 (Material & Macro Detail)**\n    *   **目的：** 品质背书。微距特写产品表面纹理、缝隙、logo、按键、涂层等关键细节，传递触感或高级质感。\n*   **第4屏：模特/生活化沉浸场景 (Lifestyle & Context)**\n    *   **目的：** 建立情绪联想。展示产品在真实且高标准的场景中被使用的瞬间，让用户代入自我。\n*   **第5屏：商品信息与售后信任 (Specs & Trust)**\n    *   **目的：** 促单决断。排版展示硬核参数、尺码/比例参考信息，以及底部的品牌故事背景、专业保养与售后承诺。画面多采用静物阵列或极简留白风格。\n\n## Initialization\n请立刻进入角色。等待用户上传产品图后，严格按照上述三大模块直接输出最终方案，无需打招呼或解释过程。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "Text", "mode": 4, "bgcolor": "#335", "size": [614.67041015625, 639.3665771484375], "pos": [-357.87274169921875, 1405.869873046875], "id": 41, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 6}, {"outputs": [{"name": "string", "links": [26], "type": "STRING", "localized_name": "string"}], "color": "#223", "widgets_values": ["要求：\n输出最终的6条详情页描述词，每条描述词代表一屏详情页。严禁有任何空行。\n请开始输出："], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "Text", "mode": 0, "bgcolor": "#335", "size": [400, 200], "pos": [497.089599609375, -184.51902770996094], "id": 26, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 7}, {"outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#223", "shape": 1, "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 39, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#335", "size": [872.9544067382812, 1210.014404296875], "pos": [4264.5703125, 537.9312133789062], "id": 19, "properties": {"widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 21}, {"outputs": [{"name": "string", "links": [25], "type": "STRING", "localized_name": "string"}], "color": "#223", "widgets_values": ["根据参考图中产品设计6张详情页，每张详情页的比例保持一致.\n详情页内容如下：\n📊 【模块一：产品视觉特征反推】\n\n  - 品类研判：高端专业户外运动数字腕表 / 智能穿戴设备\n  - 材质与工艺特征：航天级钛金属拉丝表壳、微晶蓝宝石防刮镜面、高饱和度（亮橙/荧光绿）高科技氟橡胶排汗表带。\n  - 核心受众：极限运动玩家（登山、潜水、越野跑）、数码科技先锋、追求硬派机能风的精英人群。\n  - 全局视觉基调：极致的“硬核纯粹感”。全篇以纯粹的深灰色/纯黑色（Solid\n    Dark/Black）为背景底色，通过高对比度的工作室光影凸显金属质感与科技属性，字体排版采用极简无衬线体，呈现极强的专业感。\n\n🎬 【模块二：6屏高转化详情页方案】\n\n📌 第1屏：首图海报 (Hero Image)\n\n  - 设计目的：确立品牌地位，3秒视觉抓取。\n  - 主标题：跨越极限，重塑本能\n  - 副标题：钛金属硬核运动智能腕表，无畏探索未知之境。\n  - 画面与排版：手表以倾斜微侧的完美角度悬浮于画面正中央。纯黑背景中，通过极具张力的侧逆光（Rim\n    Light）勾勒出金属表壳的硬朗轮廓，表盘界面散发未来感微光。文案采用超大字号加粗无衬线体居中沉底排版。\n  - AI Prompt：A high-end rugged sports smartwatch floating in the center, pure\n    solid dark grey background, aerospace-grade titanium casing, bright orange\n    textured fluoroelastomer strap, glowing digital futuristic interface,\n    dramatic rim lighting, studio product photography, 8k resolution,\n    photorealistic, cinematic lighting, --ar 9:16 --v 6.0\n\n📌 第2屏：直击痛点与核心技术 (Problem & Solution)\n\n  - 设计目的：视觉化呈现产品的技术实力或解决的核心痛点。\n  - 主标题：破界续航，无惧极端\n  - 副标题：太阳能光动能表盘搭载军规级防震，突破百小时极致续航，告别电量焦虑。\n  - 画面与排版：上下分层构图。画面中心为手表的3D解构透视图，蓝宝石镜面、太阳能面板、主板与钛金属底壳依次悬浮展开。右侧/底部配以发光的数字引导线连接参数文案。\n  - AI Prompt：Exploded view of a premium sports smartwatch, showing floating\n    layers of titanium bezel, sapphire glass, solar screen, and internal\n    microchip, pure solid dark background, high-tech engineering vibe, glowing\n    futuristic tracking lines, macro photography, sharp focus, octane\n    render, 3d, --ar 9:16 --v 6.0\n\n📌 第3屏：材质细节与极致工艺 (Material Macro)\n\n  - 设计目的：用肉眼可见的质感建立品质信任。\n  - 主标题：航天级精工，硬核美学\n  - 副标题：细腻蓝宝石镜面与拉丝钛金属无缝衔接，专属排汗导槽表带，每一毫米皆为严酷环境而生。\n  - 画面与排版：极具冲击力的对角线构图。超微距特写表盘边缘的物理滚花按键与硅胶表带的网格纹理，表现出金属冷峻的高光和材质的细腻。文字排版于画面右下角的纯色留白处。\n  - AI Prompt：Extreme macro shot of a titanium sports watch bezel and textured\n    orange strap, showing fine metallic brushing, knurled physical buttons, and\n    sapphire glass reflection, pure solid black background, studio lighting,\n    hyper-detailed texture, 85mm macro lens, shallow depth of field, --ar 9:16\n    --v 6.0\n\n📌 第4屏：沉浸式生活场景 (Lifestyle Context)\n\n  - 设计目的：唤起情绪共鸣与使用向往。\n  - 主标题：征服山海，与你同频\n  - 副标题：无论海拔5000米雪峰还是百米深海，双频多星GPS与全域数据时刻伴你左右。\n  - 画面与排版：全屏出血画面（Full\n    Bleed）。展示一只充满泥土或汗水的肌肉手臂，正紧握着攀岩绳索，手腕上佩戴着这只高亮配色的运动腕表。背景雪山/悬崖做大景深模糊处理，文字在底部压暗渐变。\n  - AI Prompt：A close-up of a muscular arm wearing a rugged orange strap sports\n    watch, gripping a muddy climbing rope, out of focus dark snowy mountain\n    background, candid lifestyle shot, natural ambient lighting, high contrast,\n    sweat and dirt on skin, gritty texture, depth of field, --ar 9:16 --v 6.0\n\n📌 第5屏：包装美学与开箱礼遇 (Unboxing Experience)\n\n  - 设计目的：提升产品溢价感与送礼属性。\n  - 主标题：启封惊艳，探险者的最高礼遇\n  - 副标题：专属定制碳纤维纹理高定礼盒，是自我犒赏，更是送给攀登者的完美之选。\n  - 画面与排版：半开的高级哑光黑包装盒，手表静置于高密度防震海绵中，旁边规整地放置着附赠的备用表带与工具。采用顶置柔光箱漫反射打光，展现拆盒瞬间的高端仪式感。\n  - AI Prompt：A premium matte black gift box half open, revealing a high-end\n    titanium sports watch resting on dark dense foam, pure dark background,\n    luxury lighting, soft diffusion, premium unboxing experience, elegant and\n    masculine vibe, high resolution, --ar 9:16 --v 6.0\n\n📌 第6屏：规格参数与信任保障 (Specs & Trust)\n\n  - 设计目的：客观数据呈现，促单决断。\n  - 主标题：旗舰全能参数，无忧探索\n  - 副标题：MIL-STD-810G军规认证 / 100米防水 / 全天候健康监测 / 三年全球联保换新\n  - 画面与排版：极简网格排版（Grid\n    System）。纯色背景的正上方是手表的绝对顶视图（表带向上下平铺展开）。画面下方二分之一处，使用等宽字体（Monospace）工整对齐地罗列硬核参数表格与各项专业认证图标。\n  - AI Prompt：A perfectly symmetrical top-down view of a high-end sports\n    smartwatch laid flat, pure clean dark grey solid background, minimalist\n    product photography, knolling photography, soft overhead flat lighting,\n    clean and razor-sharp focus, commercial catalog style, --ar 9:16 --v 6.0\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "Text", "mode": 0, "bgcolor": "#335", "size": [400, 200], "pos": [495.785888671875, -444.13885498046875], "id": 25, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [4748.550819940922, 864.4048990512482], "scale": 0.1303489708815101}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "工作区", "bounding": [463.8388977050781, 447.4027404785156, 3135.4853515625, 1588.3526611328125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "输入区域", "bounding": [479.9530029296875, -517.7387084960938, 2106.457275390625, 817.0826416015625]}, {"color": "#88A", "font_size": 24, "flags": {}, "id": 4, "title": "图片拼合", "bounding": [3624.522216796875, 456.2308654785156, 591.9867553710938, 314.07244873046875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "输出单图+长图拼合", "bounding": [4243.40185546875, 461.8497009277344, 1354.767578125, 1296.4058837890625]}], "links": [[4, 1, 0, 9, 0, "STRING"], [6, 9, 0, 10, 0, "STRING"], [8, 10, 0, 11, 11, "STRING"], [10, 11, 0, 13, 0, "STRING"], [11, 2, 0, 15, 0, "IMAGE"], [12, 4, 0, 15, 1, "IMAGE"], [13, 3, 0, 15, 2, "IMAGE"], [14, 5, 0, 15, 3, "IMAGE"], [15, 13, 0, 16, 0, "STRING"], [16, 16, 0, 17, 0, "*"], [23, 15, 0, 23, 0, "STRING"], [24, 15, 0, 1, 1, "STRING"], [25, 25, 0, 1, 0, "STRING"], [26, 26, 0, 9, 1, "STRING"], [27, 27, 0, 10, 1, "STRING"], [28, 28, 0, 15, 11, "STRING"], [29, 16, 0, 29, 11, "STRING"], [30, 2, 0, 29, 0, "IMAGE"], [31, 4, 0, 29, 1, "IMAGE"], [32, 3, 0, 29, 2, "IMAGE"], [33, 5, 0, 29, 3, "IMAGE"], [38, 29, 0, 34, 0, "IMAGE"], [39, 29, 0, 19, 0, "IMAGE"], [41, 34, 0, 35, 0, "PSD_LAYERS"], [43, 35, 0, 33, 2, "PSD_LAYERS"], [44, 11, 0, 39, 0, "STRING"]], "id": "af0ebd1f-f79f-4fc2-afbb-3f71efbbf40a", "config": {}, "version": 0.4, "last_node_id": 41, "revision": 0}