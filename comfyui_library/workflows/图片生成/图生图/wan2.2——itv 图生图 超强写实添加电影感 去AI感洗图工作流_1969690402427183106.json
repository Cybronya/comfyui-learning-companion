75], "widgets_values": ["图片中人物拥有深色长发，发质柔顺，略有蓬松感，几缕发丝垂落在周围。头部侧面饰有精致的羽毛与珠串点缀，增加优雅和古典气息。耳饰为银质垂吊形耳坠，其上镶嵌闪亮的宝石，与整体风格相协调。人物服装以蓝色和金属银色为主，肩部带有盔甲装饰，呈现精致的雕刻纹理，洋溢着古典与英气。项链由多种颜色的珠子串联而成，包括棕色、青色和金色，并以一个复杂的银质挂坠为中心，挂坠上装饰红色宝石和流苏，显得庄重而典雅。整体风格侧重东方韵味，带有些许古风元素。"], "inputs": [{"name": "text", "link": 30, "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 27, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 14}, {"outputs": [{"name": "text", "links": [72], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["image in an early 2010s amateur photo artstyle with washed out colors"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [387.67724609375, 108], "pos": [366.56268310546875, 2407.1689453125], "id": 61, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [34], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [140, 46], "pos": [829.6365356445312, 2284.548095703125], "widgets_values": [], "inputs": [{"name": "pixels", "link": 37, "label": "图像", "type": "IMAGE", "localized_name": "像素"}, {"name": "vae", "link": 33, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 28, "type": "VAEEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEEncode"}, "order": 12}, {"outputs": [{"name": "MODEL", "links": [23], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#223", "widgets_values": ["WAN2.2-LowNoise_SmartphoneSnapshotPhotoReality_v3_by-AI_Characters.safetensors", 0.8000000000000002], "inputs": [{"name": "model", "link": 7, "label": "模型", "type": "MODEL", "localized_n