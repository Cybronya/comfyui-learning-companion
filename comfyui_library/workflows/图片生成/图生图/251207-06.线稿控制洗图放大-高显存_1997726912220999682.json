": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 27}, {"outputs": [{"name": "CONDITIONING", "links": [209, 214], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["极简主义风格呈现，主体为一张低矮床铺，床头靠墙，两侧对称摆放简约床头柜，柜面置物区隐约可见几何形体。床铺后方墙面为垂直条纹装饰，营造视觉延伸感，与左侧整面落地式衣柜形成空间对称。房间中央偏左设有一张单人椅与配套小桌，构成静谧休憩角落。地面以平行线表现木质地板纹理，延伸至画面边缘，强化空间纵深。天花板为多层嵌入式吊顶结构，线条错落，暗示现代建筑细节。\n\n构图采用中心透视法，床铺与视线轴线正对，引导观者目光沿地板线向纵深推进，最终聚焦于房间尽头的虚化区域，形成视觉张力。无明确光源，但通过线条粗细与密度变化暗示光影方向：床头柜与衣柜立面线条较细，暗示受光面；而床铺与地板线条较粗，暗示阴影或反光面，形成“无光有影”的抽象氛围。\n\n视觉引导完全依赖线条走向与空间结构。从床铺两侧的床头柜延伸出的垂直线，与地板平行线形成“X”型交叉，引导视线回环至房间中心；天花板的斜线与墙角线构成“V”型收敛，强化空间压迫感与秩序感。无任何色彩或明暗过渡，一切依赖线条的疏密、粗细、走向，构建“纯粹的结构美学”。\n"], "inputs": [{"name": "clip", "link": 253, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 254, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [350, 460], "pos": [-450, 380], "id": 160, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 30}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "OPT_CONNECTION", "type": "*"}], "bgcolor": "#353", "size": [550, 240], "color": "#232", "pos": [770, 30], "inputs": [], "flags": {}, "id": 161, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "showAllGraphs"