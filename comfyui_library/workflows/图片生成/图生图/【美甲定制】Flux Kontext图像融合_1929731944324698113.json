iny gem-like decorations. The overall design contrasts matte and glossy nail polish textures. Make no changes other than to the nails."], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 111, "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 49, "type": "ShowText|pysssss", "properties": {"Node name for S&R": "ShowText|pysssss"}, "order": 35}, {"mode": 0, "outputs": [{"name": "*", "label": "输出", "type": "*"}], "size": [210, 60], "pos": [-281.6573486328125, 1345.98046875], "widgets_values": ["文本组合一"], "inputs": [{"name": "STRING", "link": 122, "type": "STRING"}], "flags": {}, "id": 102, "type": "SetNode", "properties": {"previousName": "文本组合一"}, "order": 39}, {"mode": 0, "outputs": [], "size": [628.4271240234375, 651.9552612304688], "pos": [154.10618591308594, 1880.02734375], "widgets_values": [], "inputs": [{"name": "images", "link": 120, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 77, "type": "PreviewImage", "properties": {"Node name for S&R": "PreviewImage"}, "order": 23}, {"mode": 0, "outputs": [{"name": "image", "links": [95, 97, 125], "label": "图像", "type": "IMAGE", "localized_name": "image"}, {"name": "mask", "label": "遮罩", "type": "MASK", "localized_name": "mask"}], "size": [315, 150], "pos": [-1050.05126953125, 2751.390869140625], "widgets_values": ["RMBG-2.0", "Preview", "ComfyUI", false, "none", false], "inputs": [{"name": "images", "link": 124, "label": "图像", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 82, "type": "easy imageRemBg", "properties": {"Node name for S&R": "easy imageRemBg"}, "order": 22}, {"mode": 0, "outputs": [], "size": [227.40594482421875, 258], "pos": [-1008.0479736328125, 3172.25048828125], "widgets_values": [], "inputs": [{"name": "images", "link": 95, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 62, "type": "PreviewImage", "properties": {"Node name for S&R": "PreviewImage"}, "order": 29}, {"mode": 0, "output