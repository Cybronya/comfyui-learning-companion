os": [-74.01429748535156, 1027.3975830078125], "widgets_values": ["**【（原图顶部模块）】**\n·布局占比：全屏 100% 宽度，高度适配设备\n·元素排版：\n--背景层：随产品主体色调变化色彩背景全屏平铺，搭配产品适配元素点缀（放大至边缘自然延伸）；\n--产品图：原图对戒交叠图居中放大，占区域宽度 70%，底部添加轻微投影贴合背景；\n--文字层（居中叠加）：\n   ---主标题「时尚情侣对戒 925 纯银」：放大字号（24px），深黑色加粗，位于产品图上方；\n   ---副文案「简约设计、精湛工艺、镶嵌锆石、送礼佳品」：小字号（移动端 14px），浅黑色，位于主标题下方。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {"collapsed": true}, "id": 41, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 12}, {"mode": 0, "outputs": [{"name": "prompt", "links": [158], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [468.9172668457031, 818.8133544921875], "widgets_values": ["根据该产品，设计商品详情图。符合以下要求：\n1.全屏布局，背景会随产品主体色调变化而发生变化，同时需要一些元素点缀产品；\n2.采用 **“通栏全屏 + 垂直分层”** 结构，每模块占满屏幕宽度，保留原图的 “标题 - 主图 - 细节 - 价值” 顺序，强化视觉沉浸感；\n3.顶部模块为产品全屏海报展示，适当文字修饰，主标题深黑色加粗，位于产品图上方；中间为产品细节图组：原图 3 张细节图（分别从不同方面入手）横向通栏排列，每张占全屏宽度 1/3；移动端自动转为竖向堆叠，每张占 100% 宽度，每张细节图正下方，对应添加文字；底部文字层布局，文字居中，分为主文案和副文案，主文案深黑色加粗，副文案浅黑色，位于主文案下方。\n4.中文字体"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 47, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 13}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-346.9846043729466, -560.2039723428846], "scale": 1.1671841070450062}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "qwen-free", "bounding": [159.4404296875, 1104.2984619140625, 1713.50244140625, 924.0347900390625]}], "links": [[75, 2, 0, 42, 14, "IMAGE"], [76