ilter": "", "guhai_ig_disable": false, "guhai_ig_ui_scale": 1}, "order": 10}, {"outputs": [{"name": "IMAGE", "links": [70, 84], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#232", "widgets_values": ["178f095d535508cf6a9e181bb7715d9c0d439809b43350e26326bdda8e7400ff.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#353", "size": [347.9018859863281, 498.7344970703125], "pos": [-1198.5775146484375, -581.6397094726562], "id": 12, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"outputs": [{"shape": 6, "name": "text", "links": [71], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#223", "widgets_values": ["自然，贴切。在阳光洒落的庭院石阶上，一位身着米白水手领校服、深蓝百褶裙的少女蹲坐于青苔斑驳的砖石之间，长发垂肩，神情温柔专注，指尖轻抚着身旁一只造型可爱的星形海星玩偶——玩偶上嵌着一张稚气未脱的动漫少年面孔，发髻高挽，眉眼含笑，仿佛正与少女进行无声的对话。少女脚边散落着几片粉红玫瑰花瓣，身旁石砌花坛里，一丛盛开的粉玫瑰如云霞般簇拥，绿叶繁茂，花枝蜿蜒攀爬，与身后斑驳的砖墙和铁艺栏杆共同勾勒出复古庭院的静谧轮廓。右侧砖柱上嵌着一块刻有“日十更”字样的石牌，增添一丝古韵与叙事感。画面右上角悬浮着一枚鎏金边框的装饰性告示牌，内书“瓜娃子，再不更新给你舔我脚底哦~”，字迹俏皮，与整体温柔氛围形成反差萌趣。构图以少女与玩偶为视觉中心，采用低角度仰视视角，使观者仿佛置身于她身后，自然引导视线从少女的指尖流向玩偶，再延展至背景的花墙与石阶，形成层次丰富的纵深感。暖金色的午后阳光从左上方倾泻而下，柔和地打在少女发梢、裙摆与玩偶表面，形成明暗交织的立体光影，同时在砖石缝隙间投下细碎斑驳的影子，强化了场景的真实质感。整体氛围如电影镜头般细腻，兼具日系动漫的精致与生活化的日常感，既有童话般的梦幻色彩，又透出青春校园的温柔气息，仿佛定格了一幅充满情感张力与微妙互动的午后私语瞬间，令人不禁想象背后的故事与情感羁绊。"], "inputs": [{"name": "text", "link": 69, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#335", "size": [375.5136413574219, 464.1505126953125], "pos": [-201.45843505859375, -450.7059631347656], "id": 58, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"wi