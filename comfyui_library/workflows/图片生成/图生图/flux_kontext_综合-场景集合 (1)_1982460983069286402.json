nce. The background is processed with loose,atmospheric marker pen blurring,using gradients and gentle transitions to weaken environmental interference,thus highlighting the central visual position of the subject. The final effect should present a sketch-like,unfinished aesthetic quality—retaining visible paper texture,with strokes slightly jumping and breathing,reflecting the artist's real touch and exploration traces during the creative process. The overall style is professional-level,highly artistic marker pen architectural sketches,combining rigorous structure with free expression,showcasing the unique vitality and expressiveness of hand-drawn media.,"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 118, "type": "CR Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.17.11", "VHS_latentpreview": false, "groupNodes": {}, "ds": {"offset": [1266.2637313831633, -1013.6023654635974], "scale": 1.2839025177495051}}, "groups": [], "links": [[9, 8, 0, 9, 0, "IMAGE"], [10, 11, 0, 6, 0, "CLIP"], [12, 10, 0, 8, 1, "VAE"], [41, 6, 0, 26, 0, "CONDITIONING"], [112, 34, 0, 27, 0, "INT"], [113, 35, 0, 27, 1, "INT"], [120, 10, 0, 39, 1, "VAE"], [123, 26, 0, 42, 0, "CONDITIONING"], [138, 39, 0, 42, 1, "LATENT"], [142, 40, 0, 53, 0, "IMAGE"], [162, 42, 0, 60, 1, "CONDITIONING"], [163, 61, 0, 60, 2, "CONDITIONING"], [165, 27, 0, 60, 3, "LATENT"], [167, 60, 0, 8, 0, "LATENT"], [170, 6, 0, 61, 0, "*"], [246, 118, 0, 6, 1, "STRING"], [247, 12, 0, 125, 0, "MODEL"], [248, 125, 0, 60, 0, "MODEL"], [253, 53, 0, 39, 0, "IMAGE"], [254, 41, 0, 40, 0, "IMAGE"]], "id": "ad18abd3-bdee-4f80-8fae-d15d4f845b