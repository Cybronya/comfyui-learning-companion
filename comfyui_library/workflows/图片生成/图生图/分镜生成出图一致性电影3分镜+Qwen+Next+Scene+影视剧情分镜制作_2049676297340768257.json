": "api_baseurl", "label": "api_baseurl", "type": "STRING", "localized_name": "api_baseurl"}, {"widget": {"name": "api_key"}, "name": "api_key", "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 3921, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 95, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 8}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [345.7489318847656, 1976], "pos": [488.9071350097656, 2.260284900665283], "widgets_values": ["很抱歉，我无法直接为您生成12张图片，但我可以为您提供详细的影视广告宣传片分镜描述。以下是基于参考图片的12个镜头描述：", "---", "**镜头1**  ", "特写镜头：主角双手握剑，剑身发出耀眼蓝光，光芒映照在面庞上，眼神坚定。背景云雾环绕，山峰隐约可见，剑气微微震荡。镜头慢推近。", "---", "**镜头2**  ", "中景镜头：主角站于山巅，衣袂随风飘扬，流光剑气在周身环绕。远处山峦叠嶂，云海翻腾。镜头从左侧缓慢环绕，展现壮丽背景和主角气势。", "---", "**镜头3**  ", "俯拍镜头：主角从山峰一跃而下，剑刃划破云层，带起一道光弧。镜头快速下拉，追随主角的动作，展现凌厉的下坠速度。", "---", "**镜头4**  ", "近景镜头：主角单膝跪地，手握剑插入地面，剑气震开周围尘土，形成一道冲击波。镜头从地面向上仰拍，凸显力量感。", "---", "**镜头5**  ", "远景镜头：主角与对手对峙，剑气在两人之间交错，周围树林被剑气削断，树叶飞舞。镜头缓慢拉远，展现紧张氛围。", "---", "**镜头6**  ", "侧移镜头：主角挥剑冲向敌人，剑气如虹。镜头从侧面快速移动，捕捉剑光轨迹和主角的凌厉动作。", "---", "**镜头7**  ", "特写镜头：剑尖直指敌人，剑身刻纹清晰可见，光芒愈发耀眼。背景虚化，聚焦于剑与主角的眼神交汇。", "---", "**镜头8**  ", "中景镜头：主角运功，周身气流旋转，蓝色光环逐渐扩散。镜头从正面缓慢推近，展现气势攀升。", "---", "**镜头9**  ", "俯拍镜头：主角在树林间穿梭，剑气割裂树干，木屑飞溅。镜头从高处俯视，展现复杂的环境与流畅的动作。", "---", "**镜头10**  ", "近景镜头：主角拔剑回鞘，剑身光芒渐隐，衣袖一挥，转身离开。镜头从后侧跟拍，展现潇洒身影。", "---", "**镜头11**  ", "远景镜头：主角站在悬崖边，身后云海翻腾，前方是敌人大军。镜头缓缓拉远，展现一人独对千军的壮阔场景。", "---", "**镜头12**  ", "特写镜头：主角的眼神充满战意，剑身再度亮起，光芒刺破云层。镜头快速拉近，定格在剑尖与光芒的交汇处。", "---", "这些镜头通过不同的运镜和视角，展现了主角的武力、气势和环境的壮丽，非常适合作为动作片的宣传片分镜。"], "inputs": [{"shape": 7, "name": "anything", "link": 3064, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 99, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 17}, {"mode": 0, "outputs": [{"name": "INT", "links": [5789], "label": "INT", "type": "INT", "localized_name": "INT"}], "size": [210, 58], "pos": [167.56787109375, 800.1489868164062], "widgets_values": [1024], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "id": 104, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 0}, {"mode": 0, "outputs": [], "size": [295.2300720214844, 82], "pos": [-520.5179443359375, 173.45326232910156], "widgets_values": ["", "output_text"], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 9203, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "output_name"}, "name": "output_name", "label": "output_name", "type": "STRING", "localized_name": "output_name"}], "flags": {}, "id": 132, "type": "ShellAgentPluginOutputText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShellAgentPluginOutputText"}, "order": 13}, {"outputs": [{"name": "MODEL", "links": [9612], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#322", "widgets_values": ["Qwen-Image-Edit-2509_fp8_e4m3fn.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLo