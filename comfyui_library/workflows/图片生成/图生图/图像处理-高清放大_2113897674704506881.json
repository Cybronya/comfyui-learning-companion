calized_name": "cache_model"}, {"shape": 7, "name": "torch_compile_args", "label": "torch_compile_args", "type": "SEEDVR2_TORCH_COMPILE", "localized_name": "torch_compile_args"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "encode_tiled"}, "shape": 7, "name": "encode_tiled", "label": "encode_tiled", "type": "BOOLEAN", "localized_name": "encode_tiled"}, {"widget": {"name": "encode_tile_size"}, "shape": 7, "name": "encode_tile_size", "label": "encode_tile_size", "type": "INT", "localized_name": "encode_tile_size"}, {"widget": {"name": "encode_tile_overlap"}, "shape": 7, "name": "encode_tile_overlap", "label": "encode_tile_overlap", "type": "INT", "localized_name": "encode_tile_overlap"}, {"widget": {"name": "decode_tiled"}, "shape": 7, "name": "decode_tiled", "label": "decode_tiled", "type": "BOOLEAN", "localized_name": "decode_tiled"}, {"widget": {"name": "decode_tile_size"}, "shape": 7, "name": "decode_tile_size", "label": "decode_tile_size", "type": "INT", "localized_name": "decode_tile_size"}, {"widget": {"name": "decode_tile_overlap"}, "shape": 7, "name": "decode_tile_overlap", "label": "decode_tile_overlap", "type": "INT", "localized_name": "decode_tile_overlap"}, {"widget": {"name": "tile_debug"}, "shape": 7, "name": "tile_debug", "label": "tile_debug", "type": "COMBO", "localized_name": "tile_debug"}, {"widget": {"name": "offload_device"}, "shape": 7, "name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}], "flags": {}, "id": 3, "type": "SeedVR2LoadVAEModel", "title": "VAE 模型（ema_vae_fp16，分块编解码省显存）", "properties": {"widget_ue_connectable": {"encode_tiled": true, "encode_tile_overlap": true, "encode_tile_size": true, "decode_tiled": true, "decode_tile_size": true, "tile_debug": true, "offload_device": true, "model": true, "decode_tile_overlap": true, "device": true}, "Node name for S&R": "SeedVR2LoadVAEModel"}, "order": 0}, {"outputs": [], "color": "#432", "widgets_values": ["# 图像处理-高清放大（SeedVR2）\n\n## 用法\n1. **① 上传图片**（任何尺寸、JPEG/PNG/WebP 均可）\n2. 调 **② resolution**：这是「短边目标像素数」，不是倍率\n   - 1080 → 高清｜1600 → 约 2K（默认）｜2560 → 约 4K\n3. 运行 → ③ 保存结果，右侧可拖动对比原图\n\n## 原理\nSeedVR2 是扩散式超分：不是简单插值放大，而是**重新生成细节**——\n放大后皮肤纹理、发丝、文字边缘、材质颗粒都会补出真实感，同时保持原图构图与身份不变。\n一张图按「帧批」处理（batch_size=5 只对视频有意义，单图没有影响）。\n\n## 常用调整\n| 想要 | 怎么做 |\n|---|---|\n| 更大尺寸 | resolution 提到 2560（显存要够，3B 模型约 12GB 起） |\n| 显存不够 | VAE 已开分块编解码；仍爆就把 resolver 降到 1080，或 DiT 开 blocks_to_swap |\n| 颜色偏了 | color_correction 默认 `lab`（对齐原图色调），改 `none` 保留模型原始观感 |\n| 换 7B 模型 | DiT 节点改成 seedvr2_ema_7b_fp8，质量更好、更吃显存 |\n| 结果发糊 | 输入帧几乎不会糊，通常是分母太小：把 resolution 顶到 2000+ |\n\n## 模型（均已在你本地）\n- DiT：seedvr2_ema_3b_fp16.safetensors\n- VAE：ema_vae_fp16.safetensors（encode/decode 分块 1024 + 128 重叠）\n- 注意力后端：sdpa\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "使用说明", "mode": 0, "bgcolor": "#653", "size": [560, 440], "pos": [-1600, -1000], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 1}, {"mode": 0, "outputs": [{"name": "image", "links": [5, 6, 16], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [440.0210876464844, 495.96875], "pos": [-134.44741821289062, -384.947265625], "widgets_values": [2206337981, "randomize", 1600, 0, 5, false, "lab", 0, 0, 0, 0, "cuda:0", false], "inputs": [{"name": "image", "link": 7, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "dit", "link": 2, "label": "dit", "type": "SEEDVR2_DIT", "localized_name": "dit"}, {"name": "vae", "link": 3, "label": "vae", "type": "SEEDVR2_VAE", "localized_name": "vae"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "INT", "localized_name