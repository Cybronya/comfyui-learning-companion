室内，少量木质或素纸元素。融合克制的古风 Editorial 构图与轻微 CCD 直闪质感，人物清晰，肤质自然，避免过度磨皮和塑料感。\n使用竖向双人半身构图，保留头顶与肩部边距；双手自然置于画面外，避免复杂手势。保持正常人体比例和自然表情。\n只输出一张完整照片；不要拼版、前后对比、标题、字幕、水印、标识或额外人物。", "", "gpt-image-2.5-flare", "auto", "1024x1536", 1024, 1536, 1, "auto", "auto", false, 0, "fixed", true, 5, 3600], "inputs": [{"shape": 7, "name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "image11", "label": "image11", "type": "IMAGE", "localized_name": "image11"}, {"shape": 7, "name": "image12", "label": "image12", "type": "IMAGE", "localized_name": "image12"}, {"shape": 7, "name": "image13", "label": "image13", "type": "IMAGE", "localized_name": "image13"}, {"shape": 7, "name": "image14", "label": "image14", "type": "IMAGE", "localized_name": "image14"}, {"shape": 7, "name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "api_key"}, "shape": 7, "name": "api_key", "link": 3, "label": "api_key", "type": "STRING", "localized_name": "api_key