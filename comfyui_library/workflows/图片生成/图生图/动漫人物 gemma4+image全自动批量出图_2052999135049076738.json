形成了荒芜与神异的极致混搭。天空呈现出浓郁的深靛蓝色，被一道巨大的锯齿状闪电劈开，云层厚重且呈现出深浅不一的紫色反差，视野极其辽阔空旷，产生出强烈的视觉压迫感。\nUzumaki Naruto双腿分开，重心下移，一只手指向天空，另一只手紧握成拳置于腰间，眼神坚定且充满热血气息，身体呈现出一种极具爆发力的准备姿态。整个画面展现了磅礴的建筑美感与热血的动感，低视角增强了人物的英雄感，背景与构图充满力量感，展现了一种粗犷与精致交织的暗黑美学。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 235, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 71, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 21}, {"outputs": [{"name": "llama_model", "links": [129], "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}], "color": "#223", "widgets_values": ["gemma-4-31B-it-abliterated-Q8_0.gguf", "gemma-4-31B-it-abliterated-mmproj-F16.gguf", "Gemma4", 8192, -1, 0, 0], "inputs": [{"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "mmproj"}, "name": "mmproj", "label": "mmproj", "type": "COMBO", "localized_name": "mmproj"}, {"widget": {"name": "chat_handler"}, "name": "chat_handler", "label": "chat_handler", "type": "COMBO", "localized_name": "chat_handler"}, {"widget": {"name": "n_ctx"}, "name": "n_ctx", "label": "n_ctx", "type": "INT", "localized_name": "n_ctx"}, {"widget": {"name": "vram_limit"}, "name": "vram_limit", "label": "vram_limit", "type": "INT", "localized_name": "vram_limit"}, {"widget": {"name": "image_min_tokens"}, "name": "image_min_tokens", "label": "image_min_tokens", "type": "INT", "localized_name": "image_min_tokens"}, {"widget": {"name": "image_max_tokens"}, "name": "image_max_tokens", "label": "image_max_tokens", "type": "INT", "localized_name": "image_max_tokens"}], "flags": {}, "type": "llama_cpp_model_loader", "mode": 0, "bgcolor": "#335", "size": [368.2429504394531, 202], "pos": [-1925.9996337890625, -1393.52294921875], "id": 77, "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "widget_ue_connectable": {}, "aux_id": "lihaoyun6/Com