ed_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 29, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}], "flags": {"pinned": true, "collapsed": false}, "type": "RH_Nano_Banana2_Image2Image", "mode": 0, "bgcolor": "#3f5159", "size": [400, 388], "pos": [7009.935546875, 1564.780029296875], "id": 15, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 7}, {"outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#2a363b", "widgets_values": ["Cam_"], "inputs": [{"name": "images", "link": 7, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {"pinned": true}, "type": "SaveImage", "mode": 0, "bgcolor": "#3f5159", "size": [663.0523681640625, 1011.5916137695312], "pos": [7458.140625, 1561.3834228515625], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 8}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#2a363b", "widgets_values": ["你好！我是专业影视分镜设计师。针对你提供的《卜大器奇遇记》小说剧本片段及人设图，我为你设计了以下连续分镜。\n\n**设计说明：**\n1.  **风格定位**：虽然人物着装偏古风/玄幻，但镜头语言将采用**“中国现代都市动漫”**的叙事节奏（快节奏、表情夸张、运镜动感），渲染出轻喜剧与奇幻结合的“潮流都市”感。\n2.  **角色映射（请在绘图时严格对应）**：\n    *   **人物A（卜大器）**：参考左图。年轻男性，黑色乱发，身穿灰色破烂乞丐服，赤脚，身形消瘦但眼神灵动。\n    *   **人物B（土地公）**：参考中左图。白发白须老者，头戴高帽，身穿米色镶红边道袍，手持挂葫芦的木杖，神情傲娇。\n    *   **人物C（土地婆）**：参考中右图。慈祥老妇人，灰白发盘髻，身穿橙褐色长袍，手持木杖，神情和蔼。\n    *   **场景**：参考右图。破败的小土地庙，杂草丛生，石阶斑驳，背景有古旧的庙宇建筑。\n\n以下是结构化分镜描述：\n\n---\n\n### 第一场：庙前清理与意外（对应剧本：卜大器嘟囔至踉跄）\n\n**分镜 1-01**\n*   **镜头类型**：中景 (Medium Shot)\n*   **镜头角度**：平视\n*   **场景细节**：破败的小土地庙前，阳光透过树叶洒下斑驳光影。空气中漂浮着灰尘。\n*   **人物动作与表情**：**人物A（卜大器）**正用袖口擦拭着面前的空气（暗示刚擦完神像），脸上带着无奈和自嘲的苦笑，嘴里嘟嘟囔囔。\n*   **画面构图重点**：聚焦在人物A的面部表情和上半身破烂的衣着细节，体现落魄感。\n\n**分镜 1-02**\n*   **镜头类型**：全景 (Full Shot)\n*   **镜头角度**：侧后方视角\n*   **场景细节**：可以看到庙宇的全貌，荒凉的院落。\n*   **人物动作与表情**：**人物A（卜大器）**退后一步，对着正前方的虚空（神像方向）恭敬地作了一个揖，动作虽然标准但透着一股随性。\n*   **画面构图重点**：人物A的背影与巨大的、破败的庙宇形成对比，突显人物渺小。\n\n**分镜 1-03**\n*   **镜头类型**：特写 (Close-up)\n*   **镜头角度**：低角度/地面视角\n*   **场景细节**：地面杂草丛生，一块凸起的青石板。\n*   **人物动作与表情**：**人物A（卜大器）**赤裸的脚在转身瞬间，脚趾狠狠踢到了地上的石头。\n*   **画面构图重点**：脚部撞击石头的瞬间，可增加漫符（撞击特效线）增强动漫感。\n\n**分镜 1-04**\n*   **镜头类型**：中全景 (Medium Full Shot)\n*   **镜头角度**：微俯视（强调失衡感）\n*   **场景细节**：庙宇庭院。\n*   **人物动作与表情**：**人物A（卜大器）**失去平衡，身体夸张地向前踉跄，双手在空中乱抓试图保持平衡。\n*   **画面构图重点**：捕捉人物A滑稽的动态姿势，同时画面背景两侧开始隐约出现两股青色的烟雾旋涡。\n\n---\n\n### 第二场：神明现身（对应剧本：两道青烟冒出至土地公说话）\n\n**分镜 1-05**\n*   **镜头类型**：全景 (Full Shot)\n*   **镜头角度**：仰视（广角镜头，增强气势）\n*   **场景细节**：两股浓郁的青烟瞬间炸开，光影变得奇幻。\n*   **人物动作与表情**：青烟散去，**人物B（土地公）**和**人物C（土地婆）**凭空出现。两人双手叉腰，姿态神气地并排站立。**人物A（卜大器）**跌坐在地，抬头仰望，满脸惊恐。\n*   **画面构图重点**：人物B和C居高临下，占据画面上方主导位置，人物A在画面下方角落，形成强烈的压迫感与反差。\n\n**分镜 1-06**\n*   **镜头类型**：近景 (Close-up)\n*   **镜头角度**：平视（带一点推镜头的冲击感）\n*   **场景细节**：背景虚化，集中在人物面部。\n*   **人物动作与表情**：**人物A（卜大器）**瞳孔地震，嘴巴张大，手指颤抖地指着前方，冷汗直流。\n*   **画面构图重点**：极致刻画人物A“吓了一跳”的夸张动漫表情。\n\n**分镜 1-07**\n*   **镜头类型**：中景 (Medium Shot)\n*   **镜头角度**：平视\n*   **场景细节**：庙宇背景。\n*   **人物动作与表情**：**人物B（土地公）**身体前倾，吹胡子瞪眼，一手叉腰一手挥舞着葫芦木杖，表情傲娇且带点愤怒。**人物C（土地婆）**站在旁边掩嘴偷笑。\n*   **画面构图重点**：突出人物B的动态和胡子飞起的细节，表现老顽童般的性格。\n\n---\n\n### 第三场：解释与怀疑（对应剧本：土地婆笑骂至结尾）\n\n**分镜 1-08**\n*   **镜头类型**：中景 (Medium Shot)\n*   **镜头角度**：侧视（双人关系镜头）\n*   **场景细节**：温暖的阳光照在土地婆身上。\n*   **人物动作与表情**：**人物C（土地婆）**轻轻拍了一下**人物B（土地公）**的肩膀（似在责怪），然后转头看向镜头方向，面带慈祥的微笑，眼神柔和。\n*   **画面构图重点**：展示人物C的和蔼气质，与刚才的紧张气氛形成反差。\n\n**分镜 1-09**\n*   **镜头类型**：近景 (Close-up)\n*   **镜头角度**：平视\n*   **场景细节**：**人物A（卜大器）**已经从地上站起，拍打身上的灰尘。\n*   **人物动作与表情**：**人物A（卜大器）**眯着眼睛，一脸狐疑地上下打量对方，一只手抬起挠着乱蓬蓬的头发。\n*   **画面构图重点**：刻画人物A“不信任”的微表情，眼神中透着市井小民的精明。\n\n**分镜 1-10**\n*   **镜头类型**：过肩镜头 (Over the Shoulder)\n*   **镜头角度**：以人物A的视角看对面二神\n*   **场景细节**：**人物B**和**人物C**站在对面，背景是破庙。\n*   **人物动作与表情**：**人物A（卜大器）**摊开双手，肩膀耸起，一副“你逗我呢”的姿态。\n*   **画面构图重点**：通过背影展示人物A的肢体语言，同时看到对面二神听到“骗子”一词时错愕的反应。"], "inputs": [{"shape": 7, "name": "anything", "link": 50, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": false}, "type": "easy showAnything", "mode": 0, "bgcolor": "#3f5159", "size": [418.00732421875, 739.8447875976562], "pos": [6157.01806640625, 1855.1788330078125], "id": 19, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 5}, {"outputs": [{"name": "STRING", "links": [28], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#322", "widgets_values": ["请根据我上传的小说人设图生成动漫小说分镜图，并保持人物一致性。中国漫画风格，画面比例16:9,分镜保持人物画风。反向提示词（不要出现文字）\n分镜图提示词要求如下：\n采用**“2D动漫风格”**来进行分镜设计。这种风格保留古风设定的同时，运用现代2D动漫的犀利线条、高对比度光影和特效（UI界面等），符合“潮流”的视觉定义。画面比例16:9,分镜保持人物画风。生成3×3，保持人物、场景、道具一致，保持人物、场景细节，不要出现镜头标注，不要出现文字。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true}, "type": "TextInput_", "mode": 0, "bgcolor": "#533", "size": [504.8764953613281, 163.13720703125], "pos": [6720.52392578125, 2128.722900390625], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInput_"}, "order": 0}, {"mode": 0, "outputs": [{"name": "STRING", "links": [31], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [543.6825561523438, 575.8109130859375], "pos": [5463.37939453125, 1590.286865234375], "widgets_values": ["卜大器（左）、土地公（中左）、土地婆（中右）、小土地庙（右）\n卜大器（小声嘟囔）：唉，真是一个比一个惨，我看这神仙也是自身难保啊。\n△卜大器刚擦完，对着神像作了个揖，转身时踢到了石头，踉跄了一下。就在这时，两道青烟从神像两侧冒出，一道变成白发白须的老者，一道变成满脸皱纹却精神矍铄的老妇人，两人叉着腰站在他面前。\n卜大器（吓了一跳）：我去，你，你们是人是鬼啊！怎么凭空出现了！\n老者（吹胡子瞪眼）：喊啥喊！我们是这方土地公土地婆！要不是你擦了神像，还懒得理你呢！\n土地婆（笑骂）：老东西，人家救了咱们的脸面，你还凶人家！后生别怕，我们不是恶鬼！\n△卜大器眯着眼打量两人，满脸怀疑，挠了挠头：土地公土地婆？我才不信呢！这年头骗子花样多，再说真有神明，咋不救救我这苦命人？"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true}, "id": 21, "type": "TextInput_", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInput_"}, "order": 1}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [35], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [361.2281188964844, 617.402587890625], "pos": [4977.490234375, 1588.6553955078125], "widgets_values": ["2c077da65d7f89152ac8857c2fee3ee5e2ad62d8e1b6cda0ed636481828863ce.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 22, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-4864.569929678757, -1257.5843034918255], "scale": 0.9646149645000008}}, "groups": [{"color": "#8AA", "font_size": 100, "flags": {}, "id": 3, "title": "小说剧本生成动漫分镜图工作流V1版（Nano Banana Pro+gemini3pro）（by方块）", "bounding": [4395.13525390625, 1297.01025390625, 3757.99560546875, 137.25680541992188]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 4, "title": "人物", "bounding": [4948.54638671875, 1503.948364