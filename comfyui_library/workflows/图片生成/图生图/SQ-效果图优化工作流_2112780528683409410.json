}], "color": "#232", "widgets_values": ["【核心约束】：强制几何保真，固定空间结构、墙体轮廓、门窗位置、家具尺寸与摆放位置，保持透视、比例、形状完全一致，严禁任何结构修改、形变、位移或重构。所有物体保持完整一致，原样保留，禁止新增、删除、替换任何物件。材质质感为PBR写实材质质感，100%还原模型贴图颜色纹理，禁止修改。100%识别贴图颜色纹理。\n\n【效果图优化】:专业室内摄影，柔和自然日光漫入室内，真实光影渐变，深胡桃木格栅悬浮浴室柜，白色大理石洗手台面，壁挂哑光陶瓷坐便器，窄边超白玻璃淋浴隔断，入墙式镀铬色水龙头，无边框背光浴室镜，墙体内嵌置物壁龛，米白微水泥质感墙地一体，简约艺术装饰挂画，真实材质质感，清晰格栅木纹，低饱和暖米色调，静谧自然氛围，对焦清晰，高细节\n\n【光源唯一且绝对定义】 ：来自画面正左侧的纯自然光，无任何其他光源。光线呈水平方向从左向右均匀扩散，无直射阳光，无硬光斑。\n\n【最高优先级指令】 ：本图所有光线100%只能从画面左侧水平向右照射，没有任何其他光源。所有物体的右侧和背面会形成柔和的阴影，空间亮度从左到右自然衰减，左侧最亮，右侧最暗。\n\n【天气】: 外部为晴天，无直射阳光。\n\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [402.1085510253906, 274.3922119140625], "pos": [1610.43603515625, 1617.5809326171875], "id": 281, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.33.10", "VHS_latentpreview": false, "ds": {"offset": [-910.7941210517631, -1526.0289630872119], "scale": 0.8769226950000045}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 24, "title": "V2", "bounding": [1035.0855712890625, 2162.495361328125, 3519.96533203125, 706.9213256835938]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 25, "title": "Group", "bounding": [1023.9996337890625, 1386.7939453125, 3526.704833984375, 743.715087890625]}], "links": [[412, 266, 0, 252, 0, "CONDITIONING"], [413, 256, 0, 252, 1, "LATENT"], [414, 266, 0, 253, 0, "CONDITIONING"], [415, 253, 0, 254, 0, "CONDITIONING"], [416, 256, 0, 254, 1, "LATENT"], [417, 277, 0, 255, 0, "NOISE"], [418, 257, 0, 255, 1, "GUIDER"], [419, 285, 0, 255, 2, "SAMPLER"], [420, 287, 0, 255, 3, "SIGMAS"], [421, 259, 0, 255, 4, "LATENT"], [42