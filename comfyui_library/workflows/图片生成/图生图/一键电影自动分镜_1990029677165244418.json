widgets_values": ["Next Scene: 身着深蓝色水手服，站立于星球大战风格的高科技摩托旁，画面中摩托散发出蓝色荧光，背景为宇宙战舰的远景，侧光勾勒出人物轮廓。", "Next Scene: 她骑上摩托，双手握住车把，身体微微前倾，摩托开始启动，蓝色荧光轨迹划过画面，背景星空中隐约可见敌方飞船。", "Next Scene: 摩托加速冲出，镜头跟拍，背景从静止的战舰逐渐变为流动的星空，人物的头发随着风轻微扬起，展现速度感。", "Next Scene: 侧移镜头捕捉摩托飞掠过陨石带，陨石在摩托光轨的映射下呈现出不同的色彩，人物专注驾驶，眼神坚定。", "Next Scene: 她左手快速操作摩托上的控制面板，右手稳握车把，摩托突然改变轨迹，以灵巧的弧线躲避迎面而来的敌方飞船。", "Next Scene: 镜头拉远，摩托在星际战斗中穿梭，背景中多艘飞船彼此交火，激光束划破星空，摩托的蓝色光轨与战斗场面形成鲜明对比。", "Next Scene: 她从摩托后座拿出一把星际武器，单手持枪，身体稍微侧转，精准射击敌方飞船，画面中爆炸的光影与摩托荧光交织。", "Next Scene: 摩托冲向敌方飞船的主控室，她快速跳下摩托，身体翻滚至飞船平台，身形矫健，动作干净利落，背景为逼近的星际战场。", "Next Scene: 她站立于飞船主控室门前，双手握住武器，身体微微前倾，战斗姿态准备迎接敌人，背景为摩托停靠在平台，荧光逐渐熄灭。"], "inputs": [{"shape": 7, "name": "anything", "link": 36, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"pinned": true}, "id": 31, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 23}, {"outputs": [{"name": "text", "links": [14], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["一个女人，星球大战，拿着激光剑，大战机器人终结者\n9个分镜头\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [275.0052185058594, 178.36476135253906], "pos": [1018.5589599609375, 884.3394775390625], "id": 32, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-794.3374562633754, -768.7040854367663], "scale": 4.432379704113481}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 1, "title": "Group", "bounding": [1008.4728393554688, 603.7056274414062, 3282.150146484375, 2531.164794921875]}], "links": [[1, 19, 0, 6, 0, "STRING"], [2, 19, 0, 7, 0, "STRING"], [3, 7, 0, 8, 0, "STRING"], [4, 13, 0, 9, 0, "MODEL"], [5, 20, 0, 9, 1,