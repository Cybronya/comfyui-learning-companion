腻、富有弹性的材质感；随后平滑切换到牛仔短裤的缝线与蓝色水洗质感细节。光影通过侧向自然光强调面料的立体感。画面极其清晰，能够看清纤维纹路。背景完全虚化为绿色的色块。8K 超清，商业时装摄影，微距镜头，极浅景深，极致细节表现，稳定运镜，流畅视频，无扭曲手脚，画面无水印。"], "inputs": [{"shape": 7, "name": "anything", "link": 261, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 150, "type": "easy showAnything", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 18}, {"mode": 0, "outputs": [{"name": "positive", "links": [237], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [235], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "size": [369.88458251953125, 499.82147216796875], "pos": [-2184.373291015625, 4943.2470703125], "widgets_values": ["", 1344, 768, 73], "inputs": [{"name": "clip", "link": 240, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 241, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 259, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 268, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 244, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 245, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 243, "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "id": 131, "type": "MiniMaxH3ImageToVideo", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"width