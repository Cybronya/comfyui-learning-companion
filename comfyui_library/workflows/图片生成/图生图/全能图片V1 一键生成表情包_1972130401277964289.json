{"last_link_id": 22, "nodes": [{"mode": 0, "outputs": [{"name": "image", "links": [14], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [441.9779968261719, 563.4666137695312], "pos": [697.8623657226562, 419.0929870605469], "widgets_values": ["a commercial 1/7 scale figurine of the character in the picture was created, depicting a realistic style and a realistic environment. The figurine is placed on a computer desk with a round transparent acrylic base. There is no text on the base. The computer screen shows the Zbrush modeling process of the figurine. Next to the computer screen is a BANDAI-style toy box with the original painting printed on it.", 1785731051, "randomize"], "inputs": [{"shape": 7, "name": "images", "link": 13, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 21, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 13, "type": "RH_Nano_Banana_Image2Image", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana_Image2Image"}, "order": 2}, {"mode": 0, "outputs": [], "size": [397.8070373535156, 563.6203002929688], "pos": [1181.905517578125, 417.3287048339844], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 14, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_