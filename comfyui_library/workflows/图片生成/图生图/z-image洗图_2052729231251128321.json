没有人物，描述中绝不能出现“男人、女人、行人”等词汇。**\n* 字数控制在500字以内。\n* 内容详尽细致，不要出现无关的说明和符号，仅输出最终提示词。", "根据这张图像，生成提示词，内容详尽细致，不要出现无关的说明和符号，仅输出最终提示词。", "images", 24, 256, 1024757944922315, "randomize", true, false], "inputs": [{"name": "llama_model", "link": 326, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 327, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 334, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "type": "llama_cpp_instruct_adv", "mode": 0, "bgcolor": "#355", "size": [531.4027709960938, 488.17327880859