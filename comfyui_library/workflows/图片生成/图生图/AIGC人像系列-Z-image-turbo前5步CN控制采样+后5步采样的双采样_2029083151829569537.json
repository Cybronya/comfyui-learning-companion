InNpZ25FeHBpcmUiOjE3NzMyMTE4MzE2MTYsInRzIjoxNzcyNjA3MDMxNjE2LCJzaWduIjoiODI1Nzc1NGI4ZTkxZWMzZTVhYTk2MGZlYzI0YmIyZjAifQ==&Rh-Identify=1e89a59e2cc471b1dfd8d6b09e3599b4"}]], "inputs": [{"name": "image_a", "link": 255, "label": "image_a", "dir": 3, "type": "IMAGE"}, {"name": "image_b", "link": 256, "label": "image_b", "dir": 3, "type": "IMAGE"}], "flags": {}, "id": 180, "type": "Image Comparer (rgthree)", "properties": {"comparer_mode": "Slide", "widget_ue_connectable": {}}, "order": 26}, {"outputs": [{"name": "CONDITIONING", "links": [157, 178, 180, 251], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["一位年轻女性倚靠米色织物墙面站立，身穿宽松灰色针织毛衣，内搭白色翻领衬衫与红色下摆露出的衬裙，搭配深灰打底裤及黑色漆皮玛丽珍鞋；头戴同色系贝雷帽，耳饰小巧精致，双手轻握一颗红棕色板球，球面有金色玫瑰刺绣纹样——其左臂袖口处亦缝有一块白布补丁，绘着相同图案，并缀以“19 26”字样数字。她长发自然垂落肩侧，目光柔和凝视镜头方向，神情宁静略带思索。画面采用全身直立式构图，人物居于中央偏右位置，形成稳定而富有张力的空间结构；地面为浅棕木质地板，右侧可见一扇原木门框线条简洁利落，强化空间纵深感。整体光线均匀柔亮，来自正面稍上方，在面部轮廓与衣物褶皱间营造微妙立体层次，阴影过渡细腻不突兀，色调偏向冷暖交融的低饱和度温柔风格，赋予场景一种静谧文艺又不失生活气息的独特氛围。服装材质纹理清晰可辨，从粗针编织到丝滑皮革均有细致呈现，凸显质感对比之美。整幅影像似由专业相机在室内棚拍环境中捕捉，却暗含手作般随性的真实温度，兼具学院风穿搭美学与复古运动元素碰撞之趣，传递出沉静优雅且充满故事性的当代青年形象。"], "inputs": [{"name": "clip", "link": 166, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [515.7149047851562, 240.30340576171875], "pos": [2251.19384765625, -602.2242431640625], "id": 121, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 9}, {"outputs": [], "color": "#432", "widgets_values": ["推荐的做法：\n反推单独运行，拿到结果后手动粘贴到CLI