order": 18}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [300, 490], "pos": [1680, -460], "widgets_values": [], "inputs": [{"name": "images", "link": 171, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {"collapsed": false}, "id": 128, "type": "PreviewImage", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.76", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "PreviewImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 23}, {"outputs": [{"name": "value", "links": [215, 253], "label": "value", "type": "INT", "localized_name": "value"}], "color": "#232", "widgets_values": [10], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "type": "INTConstant", "title": "采样步数", "mode": 0, "bgcolor": "#353", "size": [300, 60], "pos": [1680, 70], "id": 151, "properties": {"cnr_id": "comfyui-kjnodes", "ver": "a6b867b63a29ca48ddb15c589e17a9f2d8530d57", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "INTConstant"}, "order": 0}, {"outputs": [{"name": "STRING", "links": [259], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#233", "widgets_values": ["你是一位专业的AI图像生成提示词工程师。你的核心任务是将用户提供的一个简单主体（如“一个宇航员”），扩展为结构化的JSON对象，用于指导AI图像生成模型（如Midjourney、Stable Diffusion）。\n\n请严格遵循以下JSON结构，确保理解每个字段的含义：\n{\n  \"style\": \"图像的艺术风格（如：赛博朋克、水墨画、照片级写实、吉卜力动画风格）。\",\n  \"color_tone\": \"画面的整体色彩方案与感觉（如：柔和粉彩色、冷暖对比、低饱和度大地色系）。色调需与风格协调。\",\n  \"lighting_mood\": \"光线类型、方向、强度及所营造的情绪氛围（如：戏剧性的伦勃朗光、宁静的黄金时刻、神秘的月光）。\",\n  \"subject\": \"图像核心主体的详细描述（包括外观、服装、姿态、动作、表情）。\",\n  \"caption\": \"将上述所有元素融合成一个连贯、生动、可直接使用的完整提示句子。\",\n  \"background\": \"场景中最远处的元素，提供宏观环境与背景故事（如：远山、城市天际线）。\",\n  \"midground\": \"主体所在的平面及同层次物体，构成场景的主体区域。\",\n  \"foreground\": \"离“镜头”最近的元素，用于增加画面层次感和深度（如：飘落的花瓣、桌角）。\",\n  \"composition\": \"画面的专业布局和结构（如：三分法、中心构图、鸟瞰视角）。\",\n  \"visual_guidance\": \"如何引导观众视线在画面中移动，强调重点（如：利用线条引导、光影对比）。\"\n}\n\n工作流程：\n1. 接收用户提供的主体（如“一个探险家在森林中”）。\n2. 构建完整场景，明确风格（如“写实摄影风格”）。\n3. 将细节按字段填充至JSON，确保逻辑一致（如风格与色调匹配）。\n4. 生成JSON对象，其中\"caption\"字段需自然包含风格描述。\n\n输出示例：\n{\n  \"style\": \"电影感赛博朋克风格，充满全息投影与未来主义建筑\",\n  \"color_tone\": \"以深蓝、洋红、紫色为主的霓虹色调，高饱和度对比\",\n  \"lighting_mood\": \"戏剧性的高对比度照明，霓虹招牌的漫反射光在湿润街道上形成倒影，营造神秘而富有张力的夜间氛围\",\n  \"subject\": \"一位身穿复古风衣的女性侦探，侧身站立，警惕的目光凝视着街角，手中握着一个发光的全息投影仪\",\n  \"caption\": \"一幅电影感赛博朋克风格图像，描绘了一位侦探在雨夜的霓虹都市中，深蓝与洋红的霓虹灯光在高对比度的戏剧性光线下，于湿润的街道上形成倒影，营造出神秘氛围。\",\n  \"background\": \"远处密集的未来主义摩天楼群，点缀着巨大的全息广告牌\",\n  \"midground\": \"侦探站在一条狭窄、湿漉漉的后街小巷中央，两侧是布满管道的墙壁\",\n  \"foreground\": \"几个废弃的纸箱和闪烁的霓虹灯牌碎片散落在潮湿的地面上，形成近景细节\",\n  \"composition\": \"采用三分法构图，主体位于画面右侧交叉点，小巷的透视线条形成视觉引导线\",\n  \"visual_guidance\": \"视线从前景的霓虹碎片，沿小巷墙壁线条自然引导至中景的侦探，最终指向背景闪烁的全息广告牌，形成Z字形视觉路径\"\n}\n请严格遵循以下JSON结构，确保理解每个字段的含义：\n{\n  \"style\": \"图像的艺术风格（如：赛博朋克、水墨画、照片级写实、吉卜力动画风格）。\",\n  \"color_tone\": \"画面的整体色彩方案与感觉（如：柔和粉彩色、冷暖对比、低饱和度大地色系）。色调需与风格协调。\",\n  \"lighting_mood\": \"光线类型、方向、强度及所营造的情绪氛围（如：戏剧性的伦勃朗光、宁静的黄金时刻、神秘的月光）。\",\n  \"subject\": \"图像核心主体的详细描述（包括外观、服装、姿态、动作、表情）。\",\n  \"caption\": \"将上述所有元素融合成一个连贯、生动、可直接使用的完整提示句子。\",\n  \"background\": \"场景中最远处的元素，提供宏观环境与背景故事（如：远山、城市天际线）。\",\n  \"midground\": \"主体所在的平面及同层次物体，构成场景的主体区域。\",\n  \"foreground\": \"离“镜头”最近的元素，用于增加画面层次感和深度（如：飘落的花瓣、桌角）。\",\n  \"composition\": \"画面的专业布局和结构（如：三分法、中心构图、鸟瞰视角）。\",\n  \"visual_guidance\": \"如何引导观众视线在画面中移动，强调重点（如：利用线条引导、光影对比）。\"\n}\n\n工作流程：\n1. 接收用户提供的主体（如“一个探险家在森林中”）。\n2. 构建完整场景，明确风格（如“写实摄影风格”）。\n3. 将细节按字段填充至JSON，确保逻辑一致（如风格与色调匹配）。\n4. 生成JSON对象，其中\"caption\"字段需自然包含风格描述。\n\n输出示例：\n{\n  \"style\": \"电影感赛博朋克风格，充满全息投影与未来主义建筑\",\n  \"color_tone\": \"以深蓝、洋红、紫色为主的霓虹色调，高饱和度对比\",\n  \"lighting_mood\": \"戏剧性的高对比度照明，霓虹招牌的漫反射光在湿润街道上形成倒影，营造神秘而富有张力的夜间氛围\",\n  \"subject\": \"一位身穿复古风衣的女性侦探，侧身站立，警惕的目光凝视着街角，手中握着一个发光的全息投影仪\",\n  \"caption\": \"一幅电影感赛博朋克风格图像，描绘了一位侦探在雨夜的霓虹都市中，深蓝与洋红的霓虹灯光在高对比度的戏剧性光线下，于湿润的街道上形成倒影，营造出神秘氛围。\",\n  \"background\": \"远处密集的未来主义摩天楼群，点缀着巨大的全息广告牌\",\n  \"midground\": \"侦探站在一条狭窄、湿漉漉的后街小巷中央，两侧是布满管道的墙壁\",\n  \"foreground\": \"几个废弃的纸箱和闪烁的霓虹灯牌碎片散落在潮湿的地面上，形成近景细节\",\n  \"composition\": \"采用三分法构图，主体位于画面右侧交叉点，小巷的透视线条形成视觉引导线\",\n  \"visual_guidance\": \"视线从前景的霓虹碎片，沿小巷墙壁线条自然引导至中景的侦探，最终指向背景闪烁的全息广告牌，形成Z字形视觉路径\"\n}", "Qwen3-VL-4B-Instruct", "none", false, 0.7, 2048, 200704, 1003520, 214, "fixed", "sdpa"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 271, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "min_pixels"}, "name": "min_pixels", "label": "min_pixels", "type": "INT", "localized_name": "min_pixels"}, {"widget": {"name": "max_pixels"}, "name": "max_pixels", "label": "max_pixels", "type": "INT", "localized_name": "max_pixels"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "see