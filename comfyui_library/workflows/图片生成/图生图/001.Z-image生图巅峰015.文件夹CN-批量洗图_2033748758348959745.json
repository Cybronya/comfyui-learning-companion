h": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 25}, {"mode": 0, "outputs": [{"name": "MODEL", "slot_index": 0, "links": [], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [210, 58], "pos": [2030, 200], "widgets_values": [3], "inputs": [{"name": "model", "link": 182, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "shift"}, "name": "shift", "label": "shift", "type": "FLOAT", "localized_name": "shift"}], "flags": {"collapsed": true}, "id": 131, "type": "ModelSamplingAuraFlow", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.64", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"shift": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ModelSamplingAuraFlow", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 11}, {"outputs": [{"name": "CONDITIONING", "links": [157, 178], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#2a363b", "widgets_values": ["一位穿着牛仔套装的女性模特，黑色长直发披肩，表情自信从容。她身穿蓝色牛仔外套和牛仔短裤，脚穿白色高跟鞋，一只手叉腰，另一只手下垂，双腿交叉站立在明亮的工作室环境中。房间内有大窗户，透过窗户可以看到外面的光线洒进来，地面是光滑的浅色瓷砖。整体画面采用写实风格，光影效果自然，色彩真实还原，高质量摄影风格，注重细节刻画，高分辨率拍摄。"], "inputs": [{"name": "clip", "link": 166, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 261, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#3f5159", "size": [230, 150], "pos": [1990, 240], "id": 121, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 24}, {"outputs": [{"shape": 6, "name": "text", "links": [261], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#2a363b", "widgets_values": ["{\n  \"style\": \"照片级写实风格，带有时尚摄影的精致质感\",\n  \"color_tone\": \"柔和的冷暖对比色调，以白色上衣和深色百褶裙形成鲜明对比，背景采用中性灰调，突出主体\",\n  \"lighting_mood\": \"自然光从左侧斜射入，形成柔和的侧光与明暗对比，营造清新、干净且富有立体感的氛围\",\n  \"subject\": \"一位年轻女性，拥有深色长发，佩戴精致耳环，身穿白色细肩带露脐上衣和深色格纹百褶短裙，站立姿态优雅，目光直视镜头，表情沉静自信\",\n  \"caption\": \"一张照片级写实风格的时尚摄影图像，描绘了一位年轻女性在柔和自然光下，身穿白色细肩带露脐上衣与深色格纹百褶短裙，姿态优雅，眼神直视镜头，背景为简约现代室内空间，光线从左侧斜射，营造出干净、精致的视觉效果。\",\n  \"background\": \"简约现代的室内环境，背景为浅灰色墙面与模糊的门框结构，暗示空间的开放性与通透感\",\n  \"midground\": \"女性站立于室内地面，脚下为浅色瓷砖，背景墙面与门框形成层次感，强化主体与环境的分离\",\n  \"foreground\": \"女性脚边地面有轻微光影过渡，暗示光线从左侧照射，形成自然的明暗过渡与层次感\",\n  \"composition\": \"中心构图，主体位于画面正中，头部与脚部对称分布，视觉焦点集中于人物上半身与面部表情\",\n  \"visual_guidance\": \"视线从前景的地面光影自然引导至人物面部，再延伸至背景的门框与墙面，形成稳定而聚焦的视觉路径\"\n}"], "inputs": [{"name": "text", "link": 266, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#3f5159", "size": [230, 280], "pos": [1990, -460], "id": 188, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 21}, {"outputs": [{"name": "LATENT", "links": [255], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#232", "widgets_values": ["enable", 178196125462648, "randomize", 10, 1, "euler", "FlowMatchEulerDiscreteScheduler", 0, 5, "enable"], "inputs": [{"name": "model", "link": 177, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 178, "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "link": 179, "label": "negative