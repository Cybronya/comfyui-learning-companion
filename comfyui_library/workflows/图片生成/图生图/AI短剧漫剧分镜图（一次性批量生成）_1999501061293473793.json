青石铺地草木丛生，真实自然，写实风格\n逆光中景人物伫立函谷关城楼之下远眺远方，微风扬起衣袍鬓发，真实自然，写实风格\n群像平视镜头人物席地而坐向山野百姓讲授道义，众人围坐静心聆听，真实自然，写实风格\n侧俯视角人物俯身伫立河畔静观流水奔涌，两岸草木繁茂清幽，真实自然，写实风格\n夜景全景人物独坐在山野孤亭中望月沉思，皓月当空夜色静谧，真实自然，写实风格\n电影场景镜头，参考图片，帮我生成12张关于上述故事的分镜图片，不同运镜和角度，不同的视角和景别。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [583.8230590820312, 871.3518676757812], "pos": [-1001.46630859375, 413.35205078125], "id": 70, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 6}, {"outputs": [{"name": "IMAGE", "links": [49, 57], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#232", "widgets_values": ["e1a7a60c03b8f88fe5769316a5405739036353eff286522ac0dfbaf5b5c5a51d.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#353", "size": [562.4000244140625, 879.7955322265625], "pos": [-337.2154235839844, 408.3051452636719], "id": 61, "properties": {"cnr_id": "comfy-core", "ver": "0.3.64", "ue_properties": {"widget_ue_connectable": {"image": true, "upload": true}, "version": "7.0.1"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 7}], "extra": {"links_added_by_ue": [6000, 6001, 6002, 6003, 6004, 6005, 6006], "VHS_KeepIntermediate": true, "ue_links": [{"controller": 69, "upstream": "67", "downstream_slot": 0, "downstream": 77, "upstream_slot": 0, "type": "CLIP"}, {"controller": 69, "upstream": "68", "downstream_slot": 1, "downstream": 77, "upstream_slot": 0, "type": "VAE"}, {"controller": 69, "upstream": "67", "downstream_slot