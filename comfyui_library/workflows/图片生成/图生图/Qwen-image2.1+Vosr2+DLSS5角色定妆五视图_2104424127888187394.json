cfg", "label": "cfg", "type": "FLOAT", "localized_name": "cfg"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 31, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 8}, {"mode": 0, "outputs": [{"name": "prompt", "links": [38], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [1640.6884765625, 996.2696533203125], "widgets_values": ["生成3:4竖版角色设定参考板，纯白背景，影棚柔光，高清细腻，干净留白，排版整齐。\n\n逻辑兼容文生图与图生图：\n当提供参考图时，严格完全遵循参考图里角色的全部外观，角色、脸型、五官、肤色、年龄气质、发型发色、头饰、服饰款式、配色、纹样、配饰、体型比例、身上所有装饰元素，全部以参考图为准，不额外新增任何参考图不存在的装饰、结构、部件。参考图里有什么就画什么，参考图没有的元素一律不添加。所有视图必须是参考图里同一个角色，不能换脸、换造型、改动服装。\n当不提供参考图时，根据文字描述生成全新角色。\n\n整体版面结构：\n画面分为上下两个独立区域，区域之间用清晰留白或极细分隔线区分，所有子图边界清楚，主体之间不互相融合。\n上方为头部参考区，占画面高度约80%，作为绝对主视觉，放置2张在当前画幅允许范围内尽可能最大化的头部特写：正面头像、三分之二侧脸头像。\n下方为无头主体全身参考区，占画面高度约20%，必须明显缩小，放置3张无头主体三视图：正面全身、三分之二侧面全身、背面全身。\n\n头部参考区硬性规范：\n两张头部特写必须尽可能放大，撑满上方可用空间，仅保留最小安全留白。\n仅保留脖子或主体连接段以上区域，底端平整裁切。\n正面头像完整展示参考图角色的脸型、五官比例、眼睛、鼻子、嘴唇、肤色、发际线、发型轮廓和全部头部装饰。\n三分之二侧脸头像完整展示参考图同一角色的侧脸轮廓、头部结构、发型侧面、头饰和全部标志性头部细节。\n头部及所有突出配饰必须完整入画，仅预留最小安全留白，不得贴边、压缩、裁切或缺失。\n\n无头主体三视图硬性规范：\n下方三张全身图必须100%无头，绝对不允许出现头部。每张全身图的颈部顶端必须平整截断，截断位置统一在锁骨下方或主体连接段顶端，形成干净水平切口。切口以上严禁出现脸部、五官、眼睛、鼻子、嘴唇、下巴、嘴部、脸颊、额头、头发、发丝、发梢、头饰残片、脖子上段或任何头部暗示。下方区域只能展示无头身体和服饰结构，不能通过缩小头部、隐藏头部、背面不露脸等方式变相保留头部。\n三张全身图允许明显缩小，但身体结构必须完整。\n服饰、披风、配饰等由完整身体支撑，呈现真实穿戴状态，不是空挂成衣、服装假人、静态道具。\n保留自然躯干、胸背、腰腹、骨盆、四肢比例、关节连接、站立重心，肢体结构连续；材质、褶皱、投影符合物理逻辑，底部存在真实接触阴影。\n三张全身视图，主体的身体结构、材质、颜色、纹样、外部装备，严格与参考图角色保持一致。\n\n多视图一致性规范：\n上方头部参考与下方无头全身参考必须属于同一个角色。主体类型、头部轮廓、脸型、五官、发型发色、头饰、装饰、服装款式配色纹样、身形比例全程统一。\n正面、侧面、背面视图之间体型比例、结构、材质分布、配色、标志性细节保持一致，不出现不同角色、不同造型。\n人体、动物、植物、怪兽、拟人超自然物体结构比例自然，肢体完整，遮挡、投影、重力关系合理。\n画面保持纯净，不添加说明文字、标签、编号、水印、边框、多余道具或背景杂物。\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {"collapsed": true}, "id": 11, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "图像", "links": [42, 43], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [270, 130], "pos": [2381.4072265625, 505.0814514160156], "widgets_values": [2, false, "VOSR2 + DLSS", "图像"], "inputs": [{"name": "image", "link": 41, "label": "image", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "upscale"}, "name": "upscale", "label": "upscale", "type": "INT", "localized_name": "放大倍数"}, {"widget": {"name": "preview"}, "name": "preview", "label": "preview", "type": "BOOLEAN", "localized_name": "预览开关"}, {"widget": {"name": "dlss5"}, "shape": 7, "name": "dlss5", "label": "dlss5", "type": "COMBO", "localized_name": "处理模式"}, {"widget": {"name": "dlss5_mode"}, "shape": 7, "name": "dlss5_mode", "label": "dlss5_mode", "type": "COMBO", "localized_name": "批次模式"}], "flags": {}, "id": 28, "type": "WujiUpscaler2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "WujiUpscaler2"}, "order": 10}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "KKvideo_latentpreview": false, "ue_links": [], "KKvideo_latentpreviewrate": 0, "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-303.8146339699074, 256.5852152506509], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "勿动区", "bounding": [1083.535888671875, 226, 2176.73193359375, 859.458740234375]}, {"color": "#3f789e", "font_size": 24, "flags