ocalized_name": "字符串"}], "size": [400, 348], "pos": [-274.4646911621094, 501.45977783203125], "widgets_values": ["你现在是一个图片背景更换提示词撰写大师，根据图片内容，只改变图片背景，让背景换成一个全新的的背景，新背景为高度真实、生活化、有场景叙事感的短视频带货常用环境（例如：温馨厨房台面+咖啡机+晨光、北欧风梳妆台+绿植+自然窗光、现代办公室桌面+笔记本+咖啡杯、户外露营餐桌+野餐布+山景远景）；\n背景需具备清晰景深层次（前景虚化物件 + 中景产品 + 背景环境），光照方向与原产品高光一致，避免阴影断裂；整体风格为高清摄影实拍质感，8K细节，无AI合成痕迹；\n禁止添加文字、水印、边框或非请求道具。保留产品细节，让产品完美融入环境，从以下八个方面分析图片，最终只输出中文文生图提示词，描述改变的背景细节，说明保留的内容：\n1. 主体明确：清晰描述核心对象，包括肢体动作，表情，面部  \n2. 风格指定：如写实/动漫/油画等  \n3. 构图提示：视角、比例、布局  \n4. 色彩氛围：色调、光影、情绪  \n5. 细节强化：材质、纹理、特殊效果  \n6. 排除干扰：避免无关元素  \n7. 参考风格/艺术家（可选）  \n8. 质量要求：高清/超精细/4K等 \n输出格式为“将背景替换为……，背景风格与人物画风协调，保持整体为高清写实风格，背景透视与人物视角匹配，避免畸变，保持自然景深，高清细节，8K分辨率，无模糊、无拼接痕迹”", "Qwen3-VL-8B-Instruct-FP8", "none", false, 0.7, 2048, 3136, 3136, 257, "randomize", "eager"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 238, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "link": 242, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "min_pixels"}, "name": "min_pixels", "label": "min_pixels", "type": "INT", "localized_name": "min_pixels"}, {"widget": {"name": "max_pixels"}, "name": "max_pixels", "label": "max_pixels", "type": "INT", "localized_name": "max_pixels"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention"}, "name": "attention", "label": "attention", "type": "COMBO", "localized_name": "attention"}], "flags": {}, "id": 119, "type": "Qwen3_VQA", "properties": {"ver": "55595c07b4c29e652084994007b10148735d382b", "widget_ue_connectable": {}, "aux_id": "T8mars/ComfyUI_Qwen3-VL-Instruct-abliterated", "Node name for S&R": "Qwen3_VQA"}, "order": 11}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [238, 243, 246, 249], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "frame_count", "links": [], "label": "帧计数", "type": "INT", "localized_name": "frame_count"}, {"name": "audio", "label": "音频", "type": "AUDIO", "localized_name": "audio"}, {"name": "video_info", "label": "视频信息", "type": "VHS_VIDEOINFO", "localized_name": "video_info"}], "size": [253.279296875, 659.0390625], "pos": [-547.3565673828125, -223.27987670898438], "widgets_values": {"custom_height": 0, "force_rate": 25, "custom_width": 0, "select_every_nth": 1, "frame_load_cap": 1, "videopreview": {"paused": false, "hidden": false, "params": {"custom_height": 480, "filename": "eccf22f0c07cda9812a58a5ab517f6891253c4db20a1261747bab3c440e7bf66.mp4", "force_rate": 25, "select_every_nth": 1, "frame_load_cap": 1, "format": "video/mp4", "skip_first_frames": 0, "type": "input"}}, "format": "Wan", "video": "eccf22f0c07cda9812a58a5ab517f6891253c4db20a1261747bab3c440e7bf66.mp4", "skip_first_frames": 0, "force_size": "Disabled", "choose video to upload": "image"}, "inputs": [{"shape": 7, "name": "meta_batch", "label": "批次管理", "type": "VHS_BatchManager", "localized_name": "meta_batch"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "video"}, "name": "video", "label": "video", "type": "STRING", "localized_name": "视频"}, {"widget": {"name": "force_rate"}, "name": "force_rate", "label": "force_rate", "type": "INT", "localized_name": "强制帧率"}, {"widget": {"name": "force_size"}, "name": "force_size", "type": "COMBO", "localized_name": "强制尺寸"}, {"widget": {"name": "custom_width"}, "name": "custom_width", "label": "custom_width", "type": "INT", "localized_name": "custom_width"}, {"widget": {"name": "custom_height"}, "name": "custom_height", "label": "custom_height", "type": "INT", "localized_name": "custom_height"}, {"widget": {"name": "frame_load_cap"}, "name": "frame_load_cap", "label": "frame_load_cap", "type": "INT", "localized_name": "帧数读取上限"}, {"widget": {"name": "skip_first_frames"}, "name": "skip_first_frames", "label": "skip_first_frames", "type": "INT", "localized_name": "跳过前X帧"}, {"widget": {"name": "select_every_nth"}, "name": "select_every_nth", "label": "select_every_nth", "type": "INT", "localized_name": "模选"}, {"widget": {"name": "format"}, "shape": 7, "name": "format", "label": "format", "type": "COMBO", "localized_name": "format"}], "flags": {}, "id": 124, "type": "VHS_LoadVideo", "properties": {"cnr_id": "comfyui-videohelpersuite", "ver": "8e4d79471bf1952154768e8435a9300077b534fa", "ue_properties": {"widget_ue_connectable": {"custom_height": true, "custom_width": true}, "version": "7.0.1"}, "widget_ue_connectable": {"custom_height": true, "force_rate": true, "custom_width": true, "select_every_nth": true, "frame_load_cap": true, "format": true, "video": true, "skip_first_frames": true}, "aux_id": "Kosinkadink/ComfyUI-VideoHelperSuite", "Node name for S&R": "VHS_LoadVideo"}, "order": 4}, {"mode": 0, "outputs": [{"name": "STRING", "links": [242], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [577.6937255859375, 313.5621032714844], "pos": [-868.7951049804688, 521.7740478515625], "widgets_values": ["【绝对锁定】\n请将原图中“前景主体”（含人物手部/产品/产品与台面接触区域）视为不可触碰的锚点——\n包括：姿态、位置、大小、角度、标签文字、材质质感（玻璃/金属/塑料反光）、液体透明度、高光点、阴影投射形状与强度、皮肤/织物纹理。\n这些元素必须像素级一致，禁止任何位移、缩放、旋转、模糊或删减。\n\n【背景替换策略】\n仅替换背景为一个“与原图同类型但更简洁、更具设计感与生活美学的场景”，按以下规则生成：\n\nStep 1：识别原背景类型并升级\n• 若为 居家场景（卧室/客厅/梳妆台）→ 新背景仍为居家，替换为：极简北欧/日式居家场景（如：浅橡木地板 + 米白亚麻窗帘 + 极简胡桃木矮柜）\n• 若为 办公场景（桌面/笔记本旁）→ 新背景仍为办公，替换为：现代简约办公场景（如：浅灰水泥纹桌面延伸 + 柔焦书架轮廓 + 一盆低饱和绿植虚化）\n• 若为 户外/咖啡馆 → 新背景仍为同类，替换为：极简户外/咖啡馆场景（如：木质露台 + 柔焦远山/窗景 + 低对比度绿植剪影）\n• 若为 室内场景（非特指）→ 新背景仍为同类，替换为：极简室内（如：浅灰艺术涂料墙 + 一道自然光投影 + 微纹理亚麻布垂落）\n• 若为单一具体物品（如纯色背景）→ 新背景仍为同类，替换为：同功能但更高质感的物品组合（如：原为白桌 → 升级为微水泥台面 + 浅灰毛毡垫 + 一道木纹肌理延伸）\n\nStep 2：统一优化原则（背景美学强化版）\n• 背景元素总数 ≤ 3 个（如：墙面 + 地面延伸 + 1件虚化陈设），每件元素需具真实材质细节（如：木纹走向、织物褶皱、涂料颗粒感）；\n• 所有背景物件做 50%–60% 高斯+散景混合虚化（bokeh柔和过渡），保留背景自身光影层次（如：窗帘褶皱受光、木纹反光过渡）；\n• 色彩系统：主色为低饱和中性色（灰白/燕麦/浅灰褐/雾蓝），辅以1种低明度点缀色（如：灰绿、陶土棕、烟粉），整体与原图产品主色协调；\n• 光照系统（关键升级）：\n – 显式构建物理一致主光源（如45°侧逆自然窗光），确保产品高光点、接触阴影、台面反射位置/形状/强度严格继承原图；\n – 增强产品受光表现：提升高光锐度（+25%）、加深接触阴影5–8% opacity、强化材质反射（玻璃→清晰倒影，金属→锐利光斑，塑料→柔和辉光）；\n – 背景自身带光影叙事：如墙面有自然光投影渐变、地面有微弱环境反射光，避免“平涂感”；\n – 整体光色：主光为5500–6500K暖金自然光（午后阳光感），暗部保留青灰环境光细节，产品明暗对比度 ≥ 原图；\n• 构图：产品视觉占比 ≥ 65%，采用“负空间呼吸构图”——背景留白但有材质/光影引导线，实现“生活感升级，焦点更强”。\n\n【禁止项】\n禁止添加文字、水印、边框、多层叙事、多人/宠物/动态元素、过度装饰；\n禁止背景出现荧光色、高饱和色、重复图案、塑料感材质。\n\n【输出格式】\n将背景替换为……，保留人物手部姿态、产品标签、玻璃/金属反光、液体通透感、接触阴影形状等前景锚点，新背景具备真实材质细节与光影层次（如木纹走向、织物褶皱受光），采用50%–60%自然景深虚化，主光源与产品光影物理一致并增强高光与阴影表现，背景风格与人物画风协调，保持整体为高清写实风格，背景透视与人物视角匹配，避免畸变，高清细节，8K分辨率，无模糊、无拼接痕迹。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 122, "type": "Text Multiline", "properties": {"cnr_id": "was-ns", "ver": "3.0.1", "widget_ue_connectable": {"text": true}, "Node name for S&R": "Text Multiline"}, "order": 5}, {"mode": 0, "outputs": [{"name": "width", "label": "宽度", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "高度", "type": "INT", "localized_name": "height"}, {"name": "upscale_factor", "label": "放大系数", "type": "FLOAT", "localized_name": "upscale_factor"}, {"name": "batch_size", "label": "批次大小", "type": "INT", "localized_name": "batch_size"}, {"name": "empty_latent", "links": [247], "type": "LATENT", "localized_name": "empty_latent"}, {"name": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [261.1458435058594, 304.6614685058594], "pos": [331.5298156738281, 112.46159362792969], "widgets_values": [1536, 2688, "3:4 portrait 896x1152", "Off", 1, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "type": "COMBO", "localized_name": "宽高比"}, {"widget": {"name": "swap_dimensions"}, "name": "swap_dimensions", "type": "COMBO", "localized_name": "切换宽高"}, {"widget": {"name": "upscale_factor"}, "name": "upscale_factor", "type": "FLOAT", "localized_name": "upscale_factor"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "type": "INT", "localized_name": "批次大小"}], "flags": {}, "id": 125, "type": "CR SDXL Aspect Ratio", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"aspect_ratio": true, "batch_size": true, "upscale_factor": true, "width": true, "swap_dimensions": true, "height": true}, "Node name for S&R": "CR SDXL Aspect Ratio"}, "order": 6}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.28.1", "VHS_latentpreview": false, "ds": {"offset": [959.0708948260594, 480.0525355545126], "scale": 0.6588450000000046}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "模型加载", "bounding": [-270, -170, 370, 570]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "提示词", "bounding": [130, -170, 570, 570]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "图片反推", "bounding": [-613.7588500976562, 439.3435363769531, 747.7135620117188, 731.122314453125]}, {"color": "#3f789e", "font_size": 