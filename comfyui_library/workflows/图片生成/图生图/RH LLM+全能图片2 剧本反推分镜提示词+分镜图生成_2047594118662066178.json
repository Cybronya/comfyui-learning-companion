ize": [657.9896240234375, 384.73846435546875], "pos": [6772.216796875, -87.90617370605469], "id": 47, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 13}, {"outputs": [{"name": "IMAGE", "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#332922", "widgets_values": ["pasted/afd6eca97b88c9a5469c954b6bb0b01642c76e1627616cb4b7623373a68bb22e.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#593930", "size": [657.9896240234375, 384.73846435546875], "pos": [7446.01708984375, -86.35139465332031], "id": 48, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 14}, {"outputs": [{"shape": 6, "name": "文本", "links": [37], "label": "文本", "type": "STRING", "localized_name": "文本"}], "color": "#232", "widgets_values": ["参考图片的场景与人物造型并结合提示词生成视频分镜图，漫剧风格。纯分镜图，画面中不要出现文字或符号。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {}, "type": "MuyeTextEditOutput", "mode": 0, "bgcolor": "#353", "size": [387.45611572265625, 185.17543029785156], "pos": [4362.52490234375, 1309.739501953125], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MuyeTextEditOutput"}, "order": 15}, {"outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "output"}], "color": "#432", "widgets_values": ["Next Scene:【场景1-宫殿露台】在这段分镜中，采用【景别】特写结合【构图】三分法构图。画面中心聚焦于一位身着华丽明代宫装的老妇人，她身躯颓然地斜靠在雕花紫檀木椅上，呈现出一种力竭后的虚弱感。正午时分的冬日阳光穿过宫殿檐角的缝隙，形成一道锐利的斜向光束，精准地打在她布满皱纹且苍老的半边脸庞上，形成强烈的【光影】明暗对比。光线中可以清晰见到漂浮的微尘。老妇人的双眼通红，泪水顺着深陷的沟壑滑落，并在下巴处汇聚滴落，每一处皮肤纹理都透着极致的哀恸与绝望。背景中宫殿的红墙略微虚化，以此强化人物内心世界的崩塌感，画面整体呈现出一种沉重且肃穆的电影级质感，色彩饱和度略低，以冷暖色调的冲突暗示时代的动荡，细节纹理达到8K超高清标准。", "Next Scene:【场景2-汉白玉阶梯】画面转入【景别】全景，采用【构图】对角线构图，展现皇宫阶梯的宏大与紧迫感。一名身穿锦绣华服的少年正急促地奔跑在汉白玉台阶上，他的身体前倾，右手愤怒地挥动，面部肌肉因嘶吼而显得狰狞。而在阶梯之下，一名身披耀眼金甲的武将猛然越众而出，金甲在【光影】直射的阳光下反射出刺眼的金属冷光。武将面色铁青，双膝重重地砸在石阶上，双手抱拳，其背部肌肉线条在盔甲下紧绷，呈现出一种坚毅的跪姿。远景处是密密麻麻、面露惊惶的文武百官，形成了压抑的人群背景。阳光从高处俯冲而下，在地面拉出长长的影子，构图极具视觉冲击力，充分还原了剧本中剑拔弩张的政治博弈氛围。", "Next Scene:【场景3-宫廷内场】此镜头设定为【景别】中景，运用【构图】动态平衡构图，捕捉冲突爆发的瞬间。画面视觉中心是少年皇子愤怒之下猛然挥出的右腿，其足尖由于发力而绷直，狠狠地踢在金甲武将柳昂天的脸侧。柳昂天的头颅受力侧歪，但双膝依然如同钉子般死死抵住地面，身体纹丝不动，这种动态的“踢”与静态的“承”形成了极强的视觉张力。阳光从侧面斜射，将脚影投射在柳昂天坚毅的脸庞上，【光影】强调了撞击瞬间的阴影轮廓。武将低垂的眼睑遮住了眼神，仅露出紧咬的牙关。周围大臣们的表情惊愕且模糊，视觉焦点完全锁定在这一记带有屈辱色彩的踢击动作上，画面细节精细到靴底的布料纹理与武将盔甲上的细微划痕。", "Next Scene:【场景4-群臣阵列前缘】分镜采用【景别】中景结合【构图】框式构图。一名文官服饰的大臣越过人群，身体略微前倾呈禀告状，他的面部表情冷峻而深沉，双眼中闪烁着算计的光芒，与前几个场景的混乱形成鲜明对比。画面利用周围大臣的肩膀作为前景框，将观众的视线引向这位说话的官员，增强了政治阴谋的沉浸感。【光影】设计上，殿内的环境光转为柔和但略显阴冷的漫反射，光线勾勒出他官服上复杂的补子图案。画面背景是肃穆且幽深的宫廷长廊，色彩基调偏向灰蓝色，以此烘托出国家动乱、皇权更迭时的波诡云谲。每一个动作细节，如官员微微颤动的胡须和指向地面的手指，都严格遵循电影级叙事逻辑。"], "inputs": [{"shape": 7, "name": "anything", "link": 43, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#653", "size": [484.1827697753906, 441.3128356933594], "pos": [5521.5498046875, -156.03118896484375], "id": 50, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 24}, {"outputs": [{"shape": 6, "name": "STRING", "links": [2, 38], "label": "字符串", "type": "STRING", "localized_name": "字符串"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#432", "widgets_values": ["", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "link": 5, "label": "prompt", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"