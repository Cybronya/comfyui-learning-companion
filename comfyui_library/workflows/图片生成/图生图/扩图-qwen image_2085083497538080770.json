景构图均衡，利用光影营造了强烈的氛围——一种午后慵懒时光里的静谧美感，充满了故事性和诗意。照片通过细腻的细节捕捉了一个平凡却动人的瞬间。"], "inputs": [{"name": "text", "link": 227, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#535", "size": [369.5860595703125, 340.2419128417969], "pos": [736.2893676757812, 1917.62451171875], "id": 136, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ShowText|pysssss", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"outputs": [{"name": "MODEL", "links": [226], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#232", "widgets_values": ["Qwen-Image-Edit-Lightning-4steps-V1.0.safetensors", 1], "inputs": [{"name": "model", "link": 248, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {"collapsed": false}, "type": "LoraLoaderModelOnly", "mode": 0, "bgcolor": "#353", "size": [352.94158935546875, 82], "pos": [279.1216125488281, 1399.4525146484375], "id": 158, "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.3.56", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoraLoaderModelOnly", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 15}, {"mode": 0, "outputs": [{"name": "positive", "links": [250], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "negative", "links": [251], "label": "negative", "type": "CONDITIONING", "localized_name": "negative"}], "size": [278