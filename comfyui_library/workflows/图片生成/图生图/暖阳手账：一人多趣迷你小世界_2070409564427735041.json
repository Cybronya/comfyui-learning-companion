{"last_link_id": 3, "nodes": [{"mode": 0, "outputs": [{"name": "text", "links": [2], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400, 200], "pos": [178, 510.66668701171875], "widgets_values": ["以提供的参考原图为基底改造，打造温柔治愈手账拼贴构图，严格完整保留原图主体人物、五官样貌、原有姿势、原生光影与背景环境，不改动基础画面场景；\n在画面各处自然散落多个同人物迷你Q 版小人（3D 潮玩手办质感），分布在桌面、摆件、人物肩头、画面边角等位置，所有迷你小人五官、发型、穿搭、气质和原图人物完全统一，每个小人动作各不相同：看书、摆拍、举相机拍照、慵懒休憩等；\n画面叠加手写手绘涂鸦装饰：指引箭头、爱心、五角星、闪光星光、简约小图标，搭配趣味手写小字注解，线条装饰一一对应画面内景物；\n整体柔和马卡龙浅淡配色，以纯白为基底，搭配粉、桃杏、浅蓝低饱和点缀色；\n画面元素饱满丰富，构图均衡干净不杂乱；\n整体风格：温暖柔和柔光、梦幻ins 复古手账氛围感，柔和浅景深，超高细节精致画质，精致又灵动可爱；\n最终成品视觉基底和原图完全一致，仅新增迷你人偶与手绘装饰元素，不重构、不替换原有场景。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 3, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 0}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [270, 78], "pos": [1283.33349609375, 238], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 3, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 4, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 3}, {"outputs": [{"name": "image", "links": [3], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "9:16", false, 1905242187, "randomize", "1k"], "inputs": [{"name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMA