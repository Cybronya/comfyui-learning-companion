age_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [270, 290.00006103515625], "pos": [2088.236328125, 999.9953002929688], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 22, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 8, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 5}, {"mode": 0, "outputs": [{"name": "Any", "label": "字符串", "type": "STRING", "localized_name": "Any"}], "size": [1226.379638671875, 1451.751708984375], "pos": [1987.030517578125, 325.0325927734375], "widgets_values": ["STRING"], "inputs": [{"shape": 7, "name": "Any", "link": 4, "label": "字符串", "type": "STRING", "localized_name": "Any"}], "flags": {}, "id": 4, "type": "GoohaiDisplayAny", "properties": {"gh_text_style_customized": false, "widget_ue_connectable": {}, "gh_font_size": 16, "gh_font_color": "#B2B7BD", "gh_display_preview": {"images": [], "text": "### 正向视频提示词：\n\n15 秒，16:9，写实现代极简客厅装修生长动画，PBR 物理材质与真实光影，8K 渲染。全程固定机位，严格锁定尾帧参考图的相机位置、焦距、构图、透视消失点与画面边界；客厅墙体、落地窗、门窗位置、层高和户型轮廓始终不变。所有装修构件按照真实施工顺序连续生长，已生成物件永久保留，不消失、不回退、不换形，最终成品的材质、数量、尺度及摆放位置与参考图完全一致。\n\n**0～0.5s｜纯毛坯起始状态：**  \n保持参考图完全相同的正面客厅透视与户型结构，空间为未经装修的灰色水泥毛坯房：裸露水泥墙面、裸露水泥顶面、粗糙水泥地面，保留正前方大面积落地窗及两侧原有窗体轮廓；无吊顶、无墙面饰面、无地面铺装、无柜体、无灯具、无家具和软装。\n\n**0.5～3.2s｜墙顶面施工：**  \n从基层到饰面连续施工。墙面依次生成找平层、细腻腻子与暖灰色哑光墙漆；左侧墙面形成现代极简竖向木饰面与灰色墙板组合，生成细窄金属收边和竖向线性暖光槽，墙体结构不发生变化。顶面生成简洁白色平吊顶及局部跌级造型，靠左侧顶面形成黑色长条风口，顶面依照参考图生成纤细线性灯槽和小型嵌入式筒灯孔位。右侧电视背景区域生成深灰色大板墙面与深棕木饰面框架基层，只生长固定墙面饰面，不出现家具。\n\n**3.2～5.3s｜地面施工：**  \n灰色毛坯地面由远到近铺装为大规格浅灰色哑光地砖，准确生成规整拼缝、墙边收口及踢脚线；地砖尺度、灰度、反射强度和接缝方向匹配参考图。所有已完成的墙面、吊顶和窗体保持稳定，不闪烁、不改变。\n\n**5.3～7.8s｜固定硬装安装：**  \n右侧电视背景墙依次长出完整的深灰黑色模块化固定墙板、深棕木饰面包覆、黑色竖向开放格柜、嵌入式黑色电视屏及下方悬浮式超长木质电视柜台面和黑色基座，所有板缝、比例与位置匹配参考图。生成落地窗顶部窗帘盒。左墙固定安装两幅上下排列的黑框抽象装饰画。吊顶安装黑色线性风口、纤细嵌入式线性灯和小型筒灯；墙侧线性灯带安装完成但暂不完全点亮。活动家具区域继续保持空白，不提前出现沙发、茶几、边几、座椅、地毯、窗帘或摆件。\n\n**7.8～12.3s｜软装家具进场：**  \n首先在客厅中央由远到近平整生长出一张大面积浅米灰色矩形地毯，边缘贴地、无卷曲。随后所有活动家具在各自最终位置上方短距离垂直缓慢下落并稳定落地，不从画外远距离飞入：左侧生成一张低矮宽大的橘红色现代模块沙发，黑色细脚落地，靠背与扶手造型准确；沙发上依次生成深灰、浅灰及黑白条纹抱枕和搭毯。后方窗前生成一盏黑色拱形落地灯。空间后部生成一张酒红棕色弧形单人休闲椅及旁侧黑色小边几。地毯中央生成前低后高的组合茶几：前方浅色不规则石材台面、黑色竖纹圆锥底座茶几，后方小型黑色椭圆茶几。左前方生成黑色圆柱边几及透明玻璃圆形台面，右前方生成透明亚克力圆凳。电视柜台面生成书本与黑色小摆件，茶几和边几生成与参考图一致的杯具、书本、果盘等少量摆件。最后，正面落地窗生成通高白色竖向柔纱帘，帘褶均匀并自然垂落；补全抱枕及小型装饰物。所有家具数量、尺寸、朝向和相互距离严格匹配参考图，不额外添加绿植。\n\n**12.3～14s｜灯光调试：**  \n顶面线性灯、嵌入式筒灯、左墙竖向灯带及黑色拱形落地灯依次柔和点亮；结合落地窗外自然漫射光，逐渐统一为高级暖中性色照明。校准金属、木饰面、深灰墙板、玻璃、亚克力、布艺和石材的 PBR 反射与粗糙度；阴影方向、亮度层次和高光位置平滑过渡至参考图效果，保持窗帘明亮通透、沙发橘红色饱和而自然、电视背景墙深沉有层次。\n\n**14～15s｜成品定格：**  \n完整呈现参考图中的现代极简客厅：暖灰墙面、白色平吊顶、浅灰大砖地面、深灰与深木色电视背景墙、嵌入式电视和悬浮电视柜、橘红色模块沙发、酒红色单椅、组合茶几、透明圆凳、黑色边几、拱形落地灯、白色通高纱帘、浅米灰地毯及全部对应摆件。画面完全静止至结束，构图、透视、物件数量、材质、造型、位置和最终光影与上传效果图一致；无文字、无水印。\n\n### 全局负面提示词：\n\n人物，人影，人体局部，宠物，施工人员，镜头推拉，镜头缩放，镜头旋转，环绕运镜，平移镜头，机位晃动，手持抖动，切镜头，焦距变化，透视变化，构图漂移，户型改动，墙体位移，拆墙，新增墙体，新增洞口，门窗变化，落地窗变形，层高变化，施工顺序错误，家具提前出现，活动家具远距离飞入，物体漂浮，悬空，穿墙，物件穿插融合，碰撞重叠，比例错误，数量错误，位置错误，材质突变，颜色跳变，物体变形，畸变拉伸，边缘融化，画面闪烁，纹理闪烁，灯光频闪，阴影漂移，物体消失，物体回退，构件替换，已生成构件改动，多余家具，多余绿植，多余装饰，杂乱施工材料，工具，灰尘烟雾，夸张粒子，魔法特效，卡通画风，插画感，低模，塑料质感，过曝，死黑，噪点，模糊，低清晰度，文字，字幕，标志，水印。", "audio": [], "video": [], "type": "STRING"}, "Node name for S&R": "GoohaiDisplayAny"}, "order": 6}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [], "type": "IMAGE", "localized_name": "images"}], "size": [472.6810302734375, 384.7473449707031], "pos": [751.539306640625, 976.1231079101562], "widgets_values": [], "inputs": [{"name": "images", "link": 21, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 9, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 4}, {"mode": 0, "outputs": [{"name": "text", "links": [2], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [273.2396240234375, 195.40003967285156], "pos": [1329.80908203125, 516.76123046875], "widgets_values": ["你是装修生长动画脚本导演。接收用户上传的**装修效果图（尾帧图）**，自动生成一套 15 秒装修生长动画完整提示词，动画逻辑：从毛坯空间，按真实施工工序一步步生长，最终变成图里的成品装修。\n\n> \n> 输入：1 张装修效果图\n> 输出：①15 秒分段生长视频正向提示词 ②全局负面提示词\n\n## 【硬性固定规则（不可修改）】\n\n1. 视频规格：15 秒，16:9，**固定机位，禁止推拉、环绕、镜头晃动、切镜头**。锁定原图相机机位、焦距、透视消失点；墙体、门窗、户型轮廓全程不变，不拆墙、不开新洞口。\n2. 动画逻辑：按真实装修施工顺序逐步生长，已经生成出来的构件永久保留，不会消失、回退、改动。\n3. 画面要求：写实 PBR 物理光影，8K 渲染，无水印、无文字，全程**不能出现人物、人影、宠物**。物体不能漂浮、穿插、变形闪烁。\n4. 时间分段固定，严格遵守这个时间轴：\n\n- 0～0.5s：起始状态，纯毛坯水泥空间（同透视，户型和效果图完全一致，无任何装修）\n- 0.5～3.2s：墙顶面施工，逐步长出墙面腻子、墙面漆、吊顶、顶面造型，只修改饰面，建筑墙体结构不变\n- 3.2～5.3s：地面施工，地面慢慢生成地砖 / 木地板 / 石材，还原效果图地面材质、拼缝与收边\n- 5.3～7.8s：固定硬装安装，依次长出固定墙体柜体、门套门扇、嵌入式设备、筒灯 / 灯带等固定灯具；家具摆放区域保持空白，不提前生成活动家具\n- 7.8～12.3s：软装家具进场，先生地毯，由远到近依次生成沙发、桌椅，摆件等家具；家具垂直缓慢下落就位，不远距离飞进来；最后生成窗帘、抱枕、绿植装饰\n- 12.3～14s：灯光调试，灯具慢慢点亮，统一全屋光影质感，阴影对齐效果图\n- 14～15s：成品静态定格，完整装修效果图画面，保持不动直到视频结束\n\n## 【可变部分（AI 读取上传图片自动识别填充）】\n\n读取效果图识别：空间类型、墙面材质、地面材质、吊顶样式、固定柜体样式、家具清单、软装、灯具、主色调，全部填入到上面对应的时间分段描述内，所有物件数量、造型、摆放位置完全匹配上传效果图。\n\n## 【输出格式】\n\n### 正向视频提示词：\n\n（自动填充识别到的装修元素，套入上面 15 秒时间轴完整描述）\n\n### 全局负面提示词：\n\n人物，人影，宠物，镜头推拉旋转，机位晃动，户型改动，拆墙，新增洞口，物体漂浮，物件穿插融合，画面闪烁，畸变拉伸，水印，文字，噪点，卡通画风，夸张特效，物体消失"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 2, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 1}, {"outputs": [{"name": "response", "links": [4, 5], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "raw_response", "label": "raw_response", "type": "STRING", "localized_name": "raw_response"}], "color": "#432", "widgets_values": ["openai/gpt-5.6-sol", "You are a helpful assistant", "Hello", 0.6, 4096, 1, 0, 0, "none", 630498795, "randomize", false], "inputs": [{"shape": 7, "name": "image1", "link": 3, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name