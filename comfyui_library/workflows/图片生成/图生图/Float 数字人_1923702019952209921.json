40625, -1258.30859375], "widgets_values": [0], "inputs": [{"widget": {"name": "a"}, "name": "a", "link": 95, "label": "A", "type": "INT"}], "flags": {}, "id": 65, "type": "CM_IntToBool", "properties": {"Node name for S&R": "CM_IntToBool"}, "order": 11}, {"mode": 0, "outputs": [{"name": "", "links": [108], "type": "*"}], "size": [75, 26], "pos": [1965.341552734375, -1601.8648681640625], "inputs": [{"name": "", "link": 114, "type": "*"}], "flags": {}, "id": 74, "type": "Reroute", "properties": {"horizontal": false, "showOutputText": false}, "order": 22}, {"outputs": [], "color": "#223", "widgets_values": ["3. e_cfg_scale（表情自然度，默认 1.0，最低 1.0）\n作用：调整表情的夸张程度与自然过渡，受用户约束限制（最低值 1.0）。\n\n调高（>1.0）：\n\n正向影响：强化情感表现（如 emotion=surprise 时瞳孔放大、嘴角上扬更明显），适用于戏剧性场景。\n\n负向影响：表情僵硬（如持续瞪眼）、与音频驱动冲突（如平静语音搭配夸张表情）6。\n\n推荐范围：1.2-1.5（游戏NPC或儿童教育内容）。\n\n调低（仅可至 1.0）：\n\n正向影响：表情更中性自然，减少“表情漂移”（如无意义的眉毛抖动），适合专业场景16。\n\n负向影响：情感传达模糊（如 emotion=sad 仅轻微皱眉），可能削弱角色个性6。\n\n推荐范围：固定为 1.0（需通过其他参数补偿情感强度，如增强音频情感或调整 emotion 标签）。\n\n典型场景：\n\n医疗咨询：( e_cfg_scale=1.0 ) + ( emotion=neutral ) ，保持专业感。\n\n虚拟偶像表演：( e_cfg_scale=1.3 ) + ( a_cfg_scale=3.0 ) ，平衡情感与同步性。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#335", "size": [433.4852294921875, 383.9865417480469], "pos": [1490, -780], "id": 69, "properties": {}, "order": 1}, {"outputs": [], "color": "#223", "widgets_values": ["2. r_cfg_scale（渲染质量，默认 1.0）\n作用：控制渲染细节与画面质量，直接影响光影、纹理和动态模糊效果。\n\n调高（>1.0）：\n\n正向影响：增强皮肤纹理、毛发细节（如发丝清晰度），改善光影层次感（如高光反射更自然）。\n\n负向影响：显存占用和渲染时间显著增加，可能导致噪点或过度锐化。\n\n推荐范围：1.5-2.0（适用于电影级预渲染）。\n\n调低（<1.0）：\n\n正向影响：提升渲染速度，生成风格化效果（如模糊背景或油画质感），适合实时交互67。\n\n负向影响：细节丢失（如瞳孔模糊、衣物褶皱扁平化），动态模糊可能不自然。\n\n推荐范围：0.5-0.8（移动端或低功耗设备）。\n\n典型场景：\n\n4K视频生成：( r_cfg_scale=2.0 ) + 高分辨率输入。\n\n手机APP实时生成：( r_cfg_scale=0.6 ) + ( crop=true ) 以降低负载。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#335", "size": [433.4852294921875, 383.9865417480469], "pos": [1030, -780], "id": 68, "properties": {}, "order": 2}, {"outputs": [], "color": "#223", "widgets_values": ["1. a_cfg_scale（音频驱动强度，默认 2.0）\n作用：控制音频信号对口型、表情、动作的驱动强度。\n\n调高（>2.0）：\n\n正向影响：增强口型与语音的同步精度（如辅音爆破帧的唇形闭合更准确），同时提升音频情感（如愤怒、惊讶）对表情的映射强度。\n\n负向影响：可能导致动作僵硬（如头部转动不连贯）或表情“过拟合”（如持续张嘴），同时背景渲染可能因资源分配失衡而模糊。\n\n推荐范围：3.0-4.0（适用于高精度同步需求，如虚拟主播）。\n\n调低（<2.0）：\n\n正向影响：动作更自然流畅，适合柔和表情场景（如诗歌朗诵），降低对硬件性能的要求。\n\n负向影响：口型可能出现延迟或错位（如元音发音时唇形未完全张开），情感表现力减弱。\n\n推荐范围：1.5-2.0（适用于实时交互或低性能设备）。\n\n典型场景：\n\n直播场景：( a_cfg_scale=3.5 ) + ( fps=30 )，优先保证同步性。\n\n背景音乐动画：( a_cfg_scale=1.8 ) ，允许更多自由动作生成。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#335", "size": [433.4852294921875, 383.9865417480469], "pos": [580, -780], "id": 67, "properties": {}, "order": 3}, {"mode": 0, "outputs": [{"name": "INT", "links": [95], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [210, 58], "pos": [574.0969848632812, -1369.2984619140625], "widgets_values": [1], "inputs": [], "flags": {}, "id": 64, "type": "Int", "properties": {"Node name for S&R": "Int"}, "order": 4}, {"mode": 0, "outputs": [{"name": "images", "links": [94, 121], "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [315, 266], "pos": [1078.7843017578125, -1138.5201416015625], "widgets_values": [2, 1.5, 1, 25, "none", false, 10900462585462, "randomize"], "inputs": [{"name": "ref_image", "link": 129, "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"name": "ref_audio", "link": 115, "label": "ref_audio", "type": "AUDIO", "localized_name": "ref_audio"}, {"name": "float_pipe", "link": 57, "label": "float_pipe", "type": "FLOAT_PIPE", "localized_name": "float_pipe"}, {"widget": {"name": "crop"}, "name": "crop", "link": 96, "label": "crop", "type": "BOOLEAN"}, {"widget": {"name": "fps"}, "name": "fps", "link": 137, "label": "fps", "type": "FLOAT"}], "flags": {}, "id": 52, "type": "FloatProcess", "properties": {"Node name for S&R": "FloatProcess"}, "order": 23}, {"mode": 0, "outputs": [{"name": "Filenames", "label": "文件名", "type": "VHS_FILENAMES", "localized_name": "File