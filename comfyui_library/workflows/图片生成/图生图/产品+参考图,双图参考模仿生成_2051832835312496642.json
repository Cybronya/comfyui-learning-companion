d_name": "initial_timeout"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "id": 42, "type": "Comfly_gpt_image_2_official_ratio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Comfly_gpt_image_2_official_ratio"}, "order": 8}, {"mode": 0, "outputs": [{"name": "text", "links": [28], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [346.17474365234375, 823.57275390625], "pos": [-2514.375244140625, -6108.0400390625], "widgets_values": ["# 电商KV视觉系统提示词模板\n\n你是一个专业的电商视觉设计师。请根据用户上传的两张图片，生成电商主图视觉提示词。\n\n---\n\n## 输入图片\n\n**图1（白底产品图）：** [用户上传产品白底图]\n**图2（场景参考图）：** [用户上传场景参考图]\n\n---\n\n## 分析任务\n\n### 一、分析图1（白底产品图）\n\n请提取以下信息：\n\n**产品识别：**\n- 品牌名称：[中文 / 英文]\n- 产品类型：[具体产品]\n- 产品规格：[容量/尺码/数量]\n\n**包装细节：**\n- 主体颜色：[色值 + 颜色名称]\n- LOGO样式：[字体/图标/位置]\n- 包装设计元素：[图案/纹理/材质质感]\n- 文字信息：[正面主文案 / 侧面卖点 / 底部规格]\n\n**视觉卖点（按重要程度列举3-5个）：**\n1. [卖点1 - 中英文]\n2. [卖点2 - 中英文]\n3. [卖点3 - 中英文]\n\n### 二、分析图2（场景参考图）\n\n请提取以下信息：\n\n**布局结构：**\n- 产品排列方式：[居中/偏左/偏右/对角线/三角形/散落式]\n- 构图比例：[黄金比例/中心对称/三分法]\n\n**设计风格：**\n- 整体调性：[极简/杂志风/自然风/科技风/复古/艺术]\n- 参考品牌：[如：Aesop / Glossier / 兰蔻等]\n\n**色调系统：**\n- 主背景色：[色值 + 颜色名称]\n- 辅助色：[色值 + 颜色名称]\n- 点缀色：[色值 + 颜色名称]\n\n**光影氛围：**\n- 光线类型：[自然光/柔光/硬光/逆光]\n- 光源方向：[左/右/上/下]\n- 阴影强度：[重阴影/轻阴影/无阴影]\n\n---\n\n## 输出：电商KV视觉提示词（GPT Image 2.0格式）\n\n### 英文Prompt（200字以内，GPT Image 2.0规则）\n\n```\n[风格关键词] product photography, 1:1 vertical, [白底/浅色/纯色背景]. [产品组合描述], [精确排列方式], [LOGO位置]. [光线描述], [色调系统], [参考风格描述]. [其他细节要求].\n```\n\n**Prompt规则（GPT Image 2.0）：**\n- 以风格词开头\n- 用具体颜色替代色值描述\n- 精确的布局方位词\n- 简洁无冗余\n- 200字以内\n\n### 中文辅助说明（用于核对）\n\n- 构图：[排列方式 + 位置]\n- 光线：[类型 + 方向 + 阴影]\n- 色调：[主色 + 辅色 + 点缀色]\n- 风格：[参考风格]\n- 产品保留：[必须还原的包装细节]\n\n---\n\n## 关键约束\n\n1. **产品还原**：严格保留白底产品的所有设计细节（颜色、LOGO位置、包装文字、图案元素）\n2. **场景融合**：只借鉴场景的排列方式、构图比例、色彩系统、光影风格\n3. **格式限制**：英文Prompt ≤ 200字符（GPT Image 2.0限制）\n4. **白底特征**：背景保持纯白或极浅色调，不使用场景图的背景元素\n\n---\n\n## 使用示例\n\n**图1输入**：白色背景下的3瓶精华液组合，透明磨砂瓶身，金色泵头，白色标签正面黑字\"精华素\"，侧边有产品成分说明\n**图2输入**：Aesop风格场景，银色托盘，极简白色大理石台面，自然侧窗光，暖白色调\n\n**输出Prompt：**\n`Minimalist studio product photography, 1:1 vertical, pure white background. Premium serum set (3 bottles) in triangular arrangement, center-left composition. Transparent matte bottles with gold pumps, white labels, black Chinese text. Soft natural lighting from upper left, subtle shadow. Aesop-inspired warm white and silver tone palette. Clean, editorial aesthetic. Logo on top left, product details below each bottle. High contrast, professional finish.`\n\n（≤200字 ✅）"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 9, "type": "CR Text", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 2}, {"outputs": [{"name": "text", "links": [17], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#322", "widgets_values": ["图1产品参考图2出图风格、场景搭配与摆放方式；文案与参考图一致"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#533", "size": [353.16802978515625, 787.6951293945312], "pos": [-3066.558349609375, -6121.6728515625], "id": 15, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}, {"mode": 0, "outputs": [{"name": "apikey", "links": [51], "label": "apikey", "type": "STRING", 