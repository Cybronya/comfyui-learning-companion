l_7b_fp8_scaled.safetensors", "lumina2", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#533", "size": [380, 106], "pos": [10050, 19690], "id": 27, "properties": {"cnr_id": "comfy-core", "ver": "0.3.49", "ue_properties": {"widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 0}, {"mode": 0, "outputs": [{"name": "", "links": [31], "type": "MODEL"}], "size": [75, 26], "pos": [10820, 19520], "inputs": [{"name": "", "link": 170, "label": "", "type": "*"}], "flags": {}, "id": 1, "type": "Reroute", "properties": {"horizontal": false, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "showOutputText": false}, "order": 16}, {"outputs": [{"name": "prompt", "links": [37], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#432", "widgets_values": ["Next Scene：正面半身人像。年轻女性身穿一件剪裁合体的深红色丝绒旗袍，领口处有精致的金色盘扣装饰，展现出优雅的东方韵味。她面带灿烂笑容，双手在胸前行标准的“作揖”拜年。背景是一个布置得喜气洋洋的中国传统春节室内场景，背景虚化，可见悬挂的红灯笼和对联，光线温暖。画面正下方有金色立体楷书文字：“恭喜发财”。\nNext Scene：亲切的半身特写。女性穿着质感高级的酒红色丝绒旗袍，丝绒面料在暖光下泛着柔和细腻的光泽。她身体前倾，双手递出一个印有金烫金图案的厚红包。背景保持统一的春节喜庆氛围，有模糊的红灯笼、年花和春节装饰，光影温馨。画面正下方有金色立体楷书文字：“大吉大利”。\nNext Scene：充满活力的半身照。女性身着复古风的红色丝绒旗袍，袖口有金色的滚边设计。她单手将一个精致的小红灯笼高高举起在脸庞一侧，歪头甜笑，神态活泼。背景是统一的虚化春节室内场景，她手中的灯笼与背景中悬挂的红灯笼遥相呼应。画面正下方有金色立体楷书文字（只有文字没有标点符号）：“鸿运当头”。\nNext Scene：端庄大气的半身人像。女性身穿喜庆的红色丝绒旗袍，搭配简约的珍珠耳饰，显得雍容华贵。她双手各展开一副小巧的红色迷你春联展示在身体两侧，直视镜头微笑。背景是一致的中国新年室内装饰，模糊的红色背景元素衬托出前景人物。画面正下方有金色立体楷书文字：“迎春接福”。\nNext Scene：趣味十足的半身照。女性穿着深红色丝绒旗袍，旗袍贴合身形，勾勒出优美的曲线。她双手捏着一张菱形的“福”字斗方，故意将其倒过来拿放在胸口，俏皮地眨眼（Wink）。背景是统一的暖色调春节场景，有虚化的桃花和灯笼装饰。画面正下方有金色立体楷书文字（只有文字没有标点符号）：“恭贺新春”。\nNext Scene：寓意富贵的半身特写。女性身着优雅的红色丝绒旗袍，深红色的衣料与手中的金色道具形成鲜明对比。她双手捧着一个金光闪闪的大金元宝托在下巴前方，眼神亮晶晶地看着镜头。背景保持高度一致，是充满年味儿的室内布置。画面正下方有金色立体楷书文字：“财源广进”。\nNext Scene：温暖治愈的半身照。女性身穿红色丝绒旗袍，领口的珍珠扣显得温润典雅。她双手在胸前比出一个大大的爱心手势，透过手指缝隙可以看到她甜美的笑容。背景是统一的春节室内场景，柔焦的红灯笼营造出浪漫温馨的节日氛围。画面正下方有金色立体楷书文字：“岁岁平安”。\nNext Scene：清新雅致的半身人像。女性穿着经典的红色丝绒长款旗袍，发型梳成温婉的半扎发。她手中托着两个红彤彤的柿子，侧身回头看镜头，笑容恬淡。背景是一致的中国新年装饰，暖光源让环境充满节日气息。画面正下方有金色立体楷书文字：“事事如意”。\nNext Scene：喜气洋洋的正面半身照。女性身着鲜艳的红色丝绒旗袍，映衬得肤色白皙透亮。她双手提着一个巨大的红色中国结展示在身前，笑得合不拢嘴，感染力极强。背景是统一的喜庆春节室内场景，红色的背景元素增强了新年的热闹感。画面正下方有金色立体楷书文字：“五福临门”。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "提示词", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#653", "size": [390, 630], "pos": [10940, 19550], "id": 37, "properties": {"cnr_id": "comfyroll", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 2}, {"outputs": [{"name": "CONDITIONING", "links": [32], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": [""], "inputs": [{"name": "clip", "link": 6, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "link": 7, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image1", "link": 164, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"widget": {"na