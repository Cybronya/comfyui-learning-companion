ise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 3, "type": "KSampler", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {"scheduler": true, "denoise": true, "seed": true, "cfg": true, "sampler_name": true, "steps": true}, "Node name for S&R": "KSampler"}, "order": 15}, {"mode": 2, "outputs": [{"name": "STRING", "links": [72], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [422.9827575683594, 428.402587890625], "pos": [1065.5919189453125, 729.2529907226562], "widgets_values": ["你是一位专业的 AI 图像提示词工程师与视觉分析师。你的任务是根据用户提供的图片，生成结构极致完整、细节高度丰富、逻辑完全自洽、可直接用于顶级文生图模型（如 Midjourney、SD3、DALL·E 3）的专业提示词。\n\n请严格遵循以下的分析与输出框架，确保每个部分都得到深入刻画且彼此和谐统一：\n\n图像分析框架\n主体）\n\n要求：详细刻画图像核心角色。必须包括：性别、年龄、国籍/特征、外貌（发型、脸型、五官、身材）、服装（材质、颜色、款式、新旧）、姿态、动作（动作的方向）、表情和视线方向。\n\n禁忌：避免“一个人”、“一个女孩”等笼统表述。示例：“一位18岁德国男性，银白色短发，冷峻的蓝色眼睛，穿着深灰色羊绒高领针织衫，侧身站立，下颌微收，凝视画面外的远方，表情若有所思。”\n\n（前景）\n\n要求：描述最靠近镜头的元素，用于增强画面层次与沉浸感。例如：地面纹理、散落物品、近处植物/枝叶、水面涟漪、门窗框等。\n\n逻辑检查：必须与主体和中景环境逻辑一致（如室内场景的前景不应出现沙滩贝壳）。\n\n（中景）\n\n要求：描述主体所处的直接环境及同层空间的物体。明确空间关系和场景类型。例如：“主角站在一个老旧书店的木质梯子上”、“她坐在咖啡馆临窗的斑驳皮制卡座里”、“他立于被积雪覆盖的松林小径中央”。\n\n核心：此部分是连接主体与背景的叙事核心区。\n\n（背景）\n\n要求：描述远景环境，提供整体氛围与叙事背景。如城市天际线、远山、黄昏天空、雨林深处、繁忙街景虚化等。\n\n注意：需注意景深层次与透视关系合理，符合物理规律。\n\n（构图）\n\n要求：使用专业摄影/绘画术语说明画面布局。如：三分法构图（主体位于交点）、中心对称构图、引导线构图（道路、光线）、框架式构图（透过门窗）、低角度仰拍/高角度俯拍、特写镜头、全景镜头等。\n\n禁忌：避免与画面内容冲突（如“特写镜头”不应包含“广阔的远景背景”）。\n\n（视觉引导）\n\n要求：描述观众的视线如何被画面元素引导与聚焦。例如：“强烈的侧光在人物脸部形成明暗对比，成为第一视觉焦点”、“蜿蜒的小路线条将视线引向远方的灯塔”、“人物仰望的目光自然引导观众看向夜空中绚烂的极光”。\n\n（色调）\n\n要求：定义整体色彩情绪与配色方案。如：柔和粉彩、冷调青灰、暖金色黄昏、高饱和赛博霓虹、低饱和莫兰迪色系、黑白色调等。\n\n进阶：可加入点缀色说明，如“在一片冷灰基调中，人物唇上的一抹哑光正红色成为视觉焦点”。\n\n（光影氛围）\n\n要求：描述光源性质、方向与所塑造的情绪氛围。如：黄金时刻的柔光、阴天漫射光、戏剧性的伦勃朗式侧光、清冷的月光、逆光形成的明亮轮廓、室内台灯温馨的光晕等。\n\n关键：需与时间、天气、场景情绪完美匹配。\n\n最终输出要求\n请将以上所有八项分析（从“主体”到“光影氛围”）的精华，融合为一个最终产出：总述标题。\n\n形式：一段流畅、优美、叙事性强、语法完整的中文描述句。\n\n本质：这不是关键信息的简单罗列，而是一段高度整合、可直接投入文生图模型使用的自然语言提示词。它必须有机包含：主体刻画、环境层次（前景/中景/背景）、构图意图、视觉引导、色调情绪与光影氛围。\n\n要求：确保所有元素逻辑自洽，空间关系合理。若原图具有动漫、插画等风格化特征，请将其“翻译”为符合现实世界物理与光影规律的描述，比如“一张高度写实风格的数字插画”要改成“一张真实的写真照片”\n注意事项：\n1. 使用具体而非抽象的描述\n2. 包含AI模型能够理解的标准术语\n3. 按照\"主体 > 场景 > 风格 > 效果\"的顺序组织描述\n4. 确保每个重要视觉元素都有明确描述\n5. 适当添加技术参数和质量标签\n\n示例格式：\n一张真实照片，描绘了[融合主体与神态的描述]，他/她正置身于[中景环境描述]中，前景可见[前景元素描述]。背景处是[背景氛围描述]。画面采用[构图术语]构图，通过[视觉引导描述]来引导观众视线。整体呈现为[色调描述]的色调，在[光影氛围描述]的映照下，流露出一种[整体情绪]的氛围。", "Qwen3-VL-4B-Instruct", "4bit", false, 0.7, 800, 937, "randomize", ""], "inputs": [{"shape": 7, "name": "image", "link": 71, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "video_path"}, "shape": 7, "name": "video_path", "label": "video_path", "type": "STRING", "localized_name": "video_path"}], "flags": {}, "id": 44, "type": "Qwen2.5VL", "properties": {"cnr_id": "ComfyUI_QwenVL", "ver": "56f28865ff100c3cf8472abb9af4686c2230f086", "widget_ue_connectable": {"keep_model_loaded": true, "seed": true, "max_new_tokens": true, "video_path": true, "temperature": true, "model": true, "text": true, "quantization": true}, "aux_id": "alexcong/ComfyUI_QwenVL", "Node name for S&R": "Qwen2.5VL"}, "order": 10}, {"mode": 2, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [449.7574462890625, 277.0223388671875], "pos": [1521.211181640625, 723.4557495117188], "widgets_values": [], "inputs": [{"name": "text", "link": 72, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 45, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 14}, {"mode": 2, "outputs": [{"name": "IMAGE", "links": [71], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [270, 314], "pos": [766.343017578125, 728.4683227539062], "widgets_values": ["ComfyUI_13484_.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 43, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.76", "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 4}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [4, 63], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["realistic，photo，8k，best_quality,masterpiece,\n一张真实照片，描绘了一位约20岁的东亚女性女仆，拥有乌黑柔顺的及腰长发，脑后的高马尾用白色缎带束起，额前垂落几缕自然弧度的刘海，脸型为柔和的鹅蛋脸，深棕色杏仁眼微微低垂，目光温柔聚焦于手中托盘，鼻梁挺直，唇色淡粉，表情专注而宁静；她身着一套质感细腻的深海军蓝棉质长袖女仆装，领口与袖口饰有宽幅白色荷叶边，胸前及腰间系着蓬松立体的纯白围裙，布料褶皱清晰、光泽柔和，略带日常使用痕迹；她身体微倾，双手稳稳托举一只洁白瓷盘，盘中放置一块心形巧克力蛋糕，表面用奶油写着“Cafe”字样，动作方向为向前递送，姿态优雅而充满服务感。\n\n前景可见深棕色实木桌面光滑反光，边缘微带磨损纹理，盘子边缘在桌面上投下柔和阴影，强化空间纵深。中景为一间温馨复古的咖啡馆角落，她立于靠窗的木质吧台前，身后是浅薄荷绿墙面，墙上悬挂一幅装裱在白色画框中的淡雅百合花水彩画，画框右上角略带磨损；左侧墙角可见深色木质置物架，架上摆放一盆小型绿植与相框，营造生活气息。背景处是明亮的落地窗，窗外阳光倾泻而入，形成柔和的逆光轮廓，窗框木质纹理清晰，玻璃反射出室外模糊的街景光斑，营造出温暖宁静的午后氛围。\n\n画面采用三分法构图，主体位于右侧交点，左侧留白平衡画面，窗框与吧台边缘形成自然引导线，将视线引向人物面部与托盘上的蛋糕；强烈的侧逆光从右后方洒落，在人物发丝与肩部形成明亮高光，面部受光柔和，形成自然的明暗过渡，成为第一视觉焦点，同时目光与蛋糕上的文字形成二次引导，强化叙事性。整体呈现为暖调奶油色系与薄荷绿背景的柔和对比，在黄金时刻柔光与室内漫射光交织的映照下，流露出一种温柔的气氛。"], "inputs": [{"name": "clip", "link": 62, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [423.83001708984375, 177.11770629882812], "pos": [478.31512451171875, -231.583984375], "id": 6, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 8}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [65], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [187.81341552734375, -322.1791076660156], "widgets_values": ["2a87508c9251e7d6b47f8212dfe26deefa44da0531bddae7ef79b10488441ba3.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 30, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 5}, {"mode": 0, "outputs": [{"name": "VAE", "links": [45, 56], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [270, 58], "pos": [-100.5126724243164, -65.99547576904297], "widgets_values": ["z_image_turbo-vae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "f