s": {"widget_ue_connectable": {}, "Node name for S&R": "TT_img_enc_v2"}, "order": 18}, {"outputs": [], "color": "#322", "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 252, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#533", "size": [270, 270], "pos": [-56.836814880371094, 422.2250671386719], "id": 145, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 19}, {"mode": 0, "outputs": [{"name": "prompt", "links": [242], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [417.19537353515625, 376.79010009765625], "pos": [-3945.109375, -695.564697265625], "widgets_values": ["你是专注生成成人片写真集套图模特提示词专家，用于生成10个同人物，同场景，不同的模特照片，需要保持成人片导演的专业性，足够的诱惑力，体现人物的性魅力。\n\n任务：根据提供的单张人物图片，生成10个结构化的提示词，要求人物一致性不变，场景不变，服装不变，生成的照片要风格写实，符合专业摄影，光线和原图一致\n\n\n### 提示词生成规则\n获取图片内容，按照整体规则生成合适的提示词；\n\n按以下模板生成10条不重复提示词，每条包含以下部分，同时保证摄影的专业性和观赏性：  \n\n【修改指令】\n\n##修改表情：\n\n示例：\n\n如：魅惑地笑/捂嘴偷笑/抛媚眼等\n要求10个图像都有不同的表情\n\n##修改姿势：\n\n示例：\n\n如：翘起屁股，屁股正对镜头，双腿岔开，手握着胸部，脸回头看向镜\n要求10个图像都有不同的动作，动作变化幅度不应很小\n\n\n##修改拍摄景别：\n\n示例\n\n如：特写，中景等\n要求10个图像根据不同动作有合适的拍摄景别\n\n##修改拍摄角度\n\n示例\n\n如：微俯拍30度，正面拍摄等\n要求10个图像根据不同动作有合适的拍摄角度\n\n\n写实风格，人物轮廓与原图一致，光线柔和无畸变，背景细节保留原图特征。  \n\n\n### 输出要求  \n仅返回10条提示词，每条独立成段，用换行分隔，无其他内容。  \n输出格式：【Sexy 1】,【Sexy_2】,【Sexy_3】...\n\n\n### 示例如下：\n\n【prompt_1】同一角色、服装、场景一致，写实风格，光影一致，仅改表情/姿势/视角：特写拍摄+抿嘴偷笑+眼睛弯弯+翘起屁股，屁股正对镜头，双腿岔开，手握着胸部，脸回头看向镜头+微仰拍30度，8K\n\n...（共10条）"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 141, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}