 [{"name": "IMAGE", "links": [28], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [-332.9287414550781, -52.942874908447266], "widgets_values": ["bcfaf7ee94335216727b410e6acc999e846b9c2ac3045894bca40d1b1f799197.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 10, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 1}, {"mode": 0, "outputs": [{"name": "string", "links": [19], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [420.9058837890625, 338.24407958984375], "pos": [-423.752685546875, 362.40765380859375], "widgets_values": ["  \"layout_strategy\": \"尺寸图采用上方标题、中部正面产品与尺寸线、右侧包装数量卡片、底部三枚卖点卡片的网格结构，产品和尺寸标注占画面约70%，信息层级清晰克制。\",\n    \"prompt\": \"系列视觉锚点描述：唯一主色名称为黑色，唯一点缀色名称为浅灰色，统一整体视觉风格为简约高级风现代商业摄影，统一背景渐变方向为左上高亮至右下极浅暖白灰，统一背景明暗层次为中心明亮、边缘轻灰、底部柔和承托，统一细腻材质感为洁净棚拍微雾面空间，统一标题位置为画面正上方居中，统一英文字体气质为粗体 Sans Serif 且带轻微斜体张力，统一主标题字重为 Heavy Bold，统一主色与点缀色撞色方式为黑色主体字配浅灰色关键词切线，统一标题下方装饰细线为浅灰色一像素水平线，统一极简线性小图标为浅灰色细线图标，统一卡片圆角为二十四像素，统一点缀色细描边为浅灰色一像素线，统一柔和投影为低透明短距离灰影，统一光线方向为左上方柔和主光配正面漫射辅光，统一阴影软硬为短而软的贴地阴影，统一商业摄影精修标准为真实材质、精确边缘、清晰英文排版和亚马逊电商信息图品质。本图视觉目标为制作亚马逊产品尺寸信息图，准确传达车内调节儿童观察镜的单体尺寸、正面比例和一个装数量。产品为黑色纵向夹持式婴儿观察镜，整体轮廓接近上窄下宽的 T 形悬挂结构，最上方是短而宽的黑色圆角夹头，夹头内侧露出浅灰色锯齿状软质防滑垫；中部是一根细长黑色竖向圆柱支撑柱，垂直连接顶部夹头与下方镜体；支撑柱下端连着黑色横向支撑锁紧结构，位置贴近镜体上缘；下方主体为横向宽幅圆角矩形镜面，厚实黑色外框包围四周，底边中央带清晰半圆形内凹缺口，镜面呈浅灰白柔和反射，边缘较深、中心较亮。产品居中放置在极浅暖白哑光影棚地面上，正面完全朝向镜头，顶部夹头朝上，产品和尺寸线区域占画面面积约70%，主产品占画面面积约48%，尺寸线围绕产品外轮廓留出均匀间距。版式为1:1宽高比，采用三层网格：顶部标题区占15%，中部测量区占70%，底部信息卡区占15%。英文主标题固定置于画面正上方，采用粗体 Sans Serif 斜体气质，深炭黑大写字母，字号为画面宽度的7%，字距紧凑，标题关键词以浅灰色细线切分形成黑色与浅灰色撞色，标题下方居中放置一条浅灰色装饰细线和一个极简线性小图标。主标题文字为 PRODUCT SIZE，画面中文字仅包含英文。尺寸标注使用三条明确测量边：产品总宽下方标注 6 in，产品总高左侧标注 5.1 in，产品厚度信息以右侧独立细线标注 2.4 in；三组数字均为深炭黑，单位均为 in，尺寸线为黑色细线，箭头为黑色，节点圆点为浅灰色，线条与产品边缘保持8%画面宽度距离，线条平直清楚。右下角设置包装数量卡片，卡片底色白色，描边色浅灰色，文字颜色深炭黑，卡片内放置1个完整缩小产品正面图，旁边英文短语 ONE PACK。底部三张卖点卡片分别为 Shake-Free Hold、Easy Assembly、Clear Rear View，每张卡片底色白色，描边色浅灰色，文字颜色深炭黑，图标为浅灰色极简线性图标，图标线宽一致。背景为左上高亮至右下极浅暖白灰渐变，底部有极淡水平承托面和柔和接触阴影。主光来自左上方45°，辅光来自正前方，轮廓光从右后方轻扫支撑柱和镜框外缘，黑色硬质塑料在圆角边缘形成细窄高光，浅灰防滑垫呈低反光哑光，镜面反射控制为均匀浅灰白渐变。相机高度为产品高度的1.25倍，相机光轴与水平面成约5°俯角，85mm焦段感，近正交透视，景深覆盖产品全厚度和尺寸线，边缘无广角变形。黑色外框包边连续圆润，镜框与镜面之间的细窄缝隙清晰，顶部夹头与竖向支撑柱连接处圆滑，浅灰锯齿垫纹理逐齿可辨。画面留白集中在标题两侧和尺寸线外侧，视觉动线由 PRODUCT SIZE 指向完整产品，再沿尺寸线进入底部卖点卡片。输出为8K商业摄影级清晰度，高分辨率产品细节，精确边缘，真实材质表现，自然阴影，克制高光，高级商业精修，清晰英文排版，准确产品比例，真实空间关系，亚马逊电商信息图品质，国际品牌产品目录质感。产品一致性保护要求：始终保持单个黑色夹持式婴儿观察镜，顶部夹头、浅灰锯齿防滑垫、竖向支撑柱、横向锁紧结构、圆角矩形镜框、底部半圆内凹缺口完整一致。AVOID：1. 无中文字符；2. 无乱码英文；3. 无水印；4. 无品牌标志；5. 无产品变形；6. 无卡通插画感；7. 无死板纯白背景；8. 无廉价电商模板感；9. 无产品粘连；10. 无多余零件；11. 无缺失零件；12. 无错误透视；13. 无错误尺寸；14. 无错误单位；15. 无镜像结构错误。\"\n  },"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 11, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 2}, {"mode": 0, "outputs": [{"name": "STRING", "links": [29], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [270, 82], "pos": [100.21818542480469, 262.70697021484375], "widgets_values": ["参考图1图2，图1是正面，图2是细节特写图请生成尺寸图。", ""], "inputs": [{"widget": {"name": "a"}, "name": "a", "label": "a", "type": "STRING", "localized_name": "a"}, {"widget": {"name": "b"}, "name": "b", "link": 19, "label": "b", "type": "STRING", "localized_name": "b"}], "flags": {}, "id": 12, "type": "JWStringConcat", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JWStringConcat"}, "order": 3}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [855.6024063271154, 458.16868989642126], "scale": 0.7247295000000004}}, "groups": [], "links": [[1