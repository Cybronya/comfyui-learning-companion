", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [274.080078125, 314.0000305175781], "pos": [3764.73974609375, 363.76190185546875], "widgets_values": ["c5ac0657ad2f3912c55106172e277cd26fe8f0ee7d2b409bc1df1911cf747282.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 15, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 0}, {"mode": 0, "outputs": [{"name": "image", "links": [18], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [596.7393188476562, 1087.365234375], "pos": [5232.0732421875, 359.78021240234375], "widgets_values": ["建筑立面修缮效果图，广州传统骑楼建筑南立面，严格遵循“修旧如旧”原则：不改变原有结构、形体、开窗比例、阳台位置与装饰构件样式。\n标准正交正立面视角，纯平视，无透视变形、无倾斜、无侧偏；建筑轮廓横平竖直，线条规整清晰，符合建筑测绘精度要求。\n\n色彩与材质严格匹配实景参考图：\n主体墙面：低饱和度红砖墙（烧结黏土砖，非涂料饰面），保留自然风化痕迹与轻微色差，砖缝为浅灰 beige 色水泥砂浆，整体干净但非崭新，无大面积黑斑、黄渍或过度清洗导致的“假新”感；\n\n立柱、线脚、栏杆：米白色/浅灰白水泥饰面，带细微泛黄与微裂纹做旧质感，与墙面协调统一；栏杆为铸铁花格（菱形+卷草纹），修复后保持原样，非黑色、非纯白、非现代喷涂漆面；\n\n门窗构件：窗框为深枣红色实木（非黑漆、非棕色喷漆），玻璃为蓝绿色调菱形铅条花格（与线稿及现存残片一致），窗扇分格比例、开启方式、五金样式完全复原；\n\n顶部构件：女儿墙为灰白色水泥抹面，山花（三角楣饰）保留菱形浮雕与卷涡纹饰，屋面为红褐色陶土瓦（非琉璃瓦、非金属瓦），仅修复破损瓦片，不改造型与色泽；\n首层商铺：左侧为橄榄绿波纹金属卷帘门（保留使用痕迹），中间#113–115为原木板条门（竖向格栅+铜质拉手），右侧为砖砌门洞配木门；彻底清除杂乱招牌、空调外机、晾衣架、电线、藤蔓、污渍与涂鸦，仅呈现原始建筑结构本体。\n\n修缮细节要求：\n墙面仅做清洁与局部补缺，不重抹灰、不换砖、不统一色调，保留历史层积与肌理差异；\n所有阳台栏杆、立柱、窗套线脚按原尺寸、样式、间距修复，材质质感一致；\n门窗洞口位置、高宽比、排列关系100%忠实于线稿与现状；破损玻璃替换为同款铅条花格玻璃；\n屋顶瓦片、山花浮雕、檐口线脚仅加固修复，禁止简化、现代化或风格混搭；\n首层门脸结构零改动，仅去除后期附加物，呈现“整洁而真实”的保护后状态——有岁月痕迹，但无破败感。\n\n渲染风格： 写实建筑可视化，照片级真实感，PBR物理材质表现——红砖颗粒感、水泥微孔、木纹纤维、玻璃反光与漫反射均精确还原；8K超高清分辨率；柔和均匀自然光（阴天漫射光），无强阴影、无人工光源；纯白背景，无环境干扰元素。专业建筑遗产保护成果展示级别。\n\n 负面提示词\n透视变形、建筑歪斜、镜头畸变、仰视/俯视/侧视、线条弯曲、结构错位；\n色彩失真、偏黄/偏粉/偏蓝/偏绿、高饱和、霓虹光、滤镜感；\n卡通、手绘、线稿填充、平涂、低多边形、塑料质感、CG假感；\n纯白雪白墙面、黑色窗框、白色栏杆、深灰金属门；\n过度翻新（如全新油漆、统一色块）、严重剥落、大面积霉斑、墙体坍塌、碎砖裸露；\n杂乱招牌、广告贴纸、空调外机、晾晒衣物、电线缠绕、野草藤蔓、垃圾杂物；\n现代材料（铝合金窗、塑钢门、不锈钢栏杆）、新增构件、加建楼层、改变屋顶形式。", 69317556, "randomize", "auto", "2k", false, "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 14, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "link": 29, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_err