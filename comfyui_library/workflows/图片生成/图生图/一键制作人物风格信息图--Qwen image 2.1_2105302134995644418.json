n_p": true, "frequency_penalty": true, "state_uid": true, "mirostat_tau": true, "top_k": true, "temperature": true, "repeat_penalty": true, "typical_p": true}, "Node name for S&R": "llama_cpp_parameters"}, "order": 7}, {"mode": 0, "outputs": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [342.3187255859375, 169.05938720703125], "pos": [-192.30699157714844, 3147.181396484375], "widgets_values": [], "inputs": [{"name": "source", "link": 795, "label": "source", "type": "*", "localized_name": "源"}], "flags": {}, "id": 515, "type": "PreviewAny", "properties": {"cnr_id": "comfy-core", "ver": "0.36.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewAny"}, "order": 18}, {"mode": 0, "outputs": [{"name": "string", "links": [777], "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [-1543.6685791015625, 2271.09716796875], "widgets_values": ["一张16:9横向构图的高级感人物风格分析海报，整体色调为低饱和度的莫兰迪色系，背景采用带有纹理的米白色亚麻质感底纹。画面左侧35%区域为人物视觉主体，右侧65%区域为排版清晰的信息模块，整体设计风格呈现极简主义、新中式美学与杂志排版风格。\n\n人物一致性：严格保持输入图片中人物的面容、五官、脸型、肤色、年龄感、发型特征和整体气质。人物为年轻亚洲女性，黑色长直发中分，右侧耳后别着一朵白色小雏菊发饰，面容清秀温婉，肤色白皙细腻，妆容清淡自然，红唇点缀。身着米白色V领交领薄纱长袖连衣裙，面料轻盈通透，带有细微褶皱纹理。人物保持侧坐姿态，左手轻抚胸口，右手支撑在深色木质地板上，神情低垂，流露出静谧、内敛的气质。\n\n版面与构图：\n1. 左侧主视觉：保留原图的水面背景，但在边缘进行羽化渐隐处理，使人物自然融入米色背景中。\n2. 右侧信息区：从上至下垂直排列四个模块，使用深灰色细线条进行分隔。\n3. 顶部标题区：位于画面右上角，主标题文字为“东方温婉·新中式美学”，采用纤细的宋体字，颜色为深褐色。副标题文字为“PERSONA STYLE PROFILE”，采用无衬线英文字体，字号较小，颜色为浅灰色。\n\n右侧信息模块详细设计：\n\n模块一：风格关键词（位于右侧顶部）\n标题文字为“STYLE KEYWORDS”，下方横向排列四个米色圆角矩形标签，标签内文字分别为“清冷感”、“知性优雅”、“静谧禅意”、“东方韵味”，字体为黑色黑体，背景色为淡米黄。\n\n模块二：色彩偏好分析（位于右侧中部）\n标题文字为“COLOR PALETTE”。下方排列五个圆形色块，从左至右依次为：\n1. 米白色圆圈，下方标注文字“主色·米白”\n2. 浅青色圆圈，下方标注文字“点缀·青瓷”\n3. 深木色圆圈，下方标注文字“基调·深木”\n4. 墨绿色圆圈，下方标注文字“背景·墨绿”\n5. 纯黑色圆圈，下方标注文字“发色·乌黑”\n每个圆圈下方有细线连接至文字说明。\n\n模块三：服饰与细节（位于右侧中下部）\n标题文字为“DETAILS”。左侧为竖排文字列表，右侧为对应的微缩图片剪影（使用原图局部）：\n- 第一行文字“轻薄纱质”，对应图片为衣袖的薄纱纹理特写。\n- 第二行文字“交领设计”，对应图片为领口细节。\n- 第三行文字“青瓷酒具”，对应图片为左下角的青瓷酒瓶与酒杯。\n- 第四行文字“木作托盘”，对应图片为深色木托盘纹理。\n\n模块四：气质雷达图（位于右侧底部）\n标题文字为“AURA CHART”。绘制一个五边形雷达图，线条为细线，填充色为半透明淡青色。\n五个顶点标签分别为：\n- 顶部：“温婉 90”\n- 右上：“典雅 85”\n- 右下：“内敛 95”\n- 左下：“自然 80”\n- 左上：“清冷 88”\n雷达图中心标注文字“气质指数”。\n\n光影与材质：\n整体光线柔和漫射，模拟自然光下的阴影效果。文字排版清晰锐利，无阴影干扰。色块边缘整齐。人物边缘有轻微的高光勾勒，使其从背景中分离出来。海报整体留白充足，视觉动线从人物面部引导至右侧标题，再向下浏览信息。无多余装饰，保持极简高级感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 494, "type": "Text", "properties": {"ver": "495f9773dd3651a366ebac664fc4b0f301e9b1b3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "aux_id": "TFL-TFL/ComfyUI_Text_Translation", "Node name for S&R": "Text"}, "order": 8}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [736], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [270, 474], "pos": [378.64776611328125, 2378.6201171875], "widgets_values": [485494017043212, "randomize", 30, 1, "euler", "simple", 1], "inputs": [{"name": "model", "link": 791, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"name": "positive", "link": 741, "label": "正面条件", "type": "CONDITIONING", "localized_name": "正面条件"}, {"name": "negative", "link": 742, "label": "负面条件", "type": "CONDITIONING", "localized_name": "负面条件"}, {"name": "latent_image", "link": 737, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "label": "随机种", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "label": "步数", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "label": "CFG", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "采样器", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "调度器", "type": "COMBO", "localized_name