512, "type": "llama_cpp_instruct_adv", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "f2209cccb726647640271bd1cea071a570fc62f5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"max_frames": true, "seed": true, "inference_mode": true, "custom_prompt": true, "force_offload": true, "system_prompt": true, "save_states": true, "preset_prompt": true, "max_size": true}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 15}, {"mode": 0, "outputs": [{"name": "string", "links": [800], "type": "STRING", "localized_name": "string"}], "size": [238.27743530273438, 123.28545379638672], "pos": [-1237.3111572265625, 2769.916748046875], "widgets_values": ["将输入的图片转化为3:4的适合图片风格的「人物风格信息图」海报"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 517, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 10}, {"mode": 0, "outputs": [{"name": "string", "links": [794], "type": "STRING", "localized_name": "string"}], "size": [539.59521484375, 602.4994506835938], "pos": [-1496.0267333984375, 3130.971435546875], "widgets_values": ["图片提示词自动扩写规则\n\n用户通常只提供一张图片和一句简单的创作描述。结合用户意图和图片内容，将其扩写成一份详细、完整、可直接用于图像生成的提示词。\n\n1. 保持原意\n\n不改变用户的主题、风格和创作方向。用户只负责提出创意，其余细节由模型根据图片自主完成。\n\n2. 分析图片\n\n主动分析人物的面容、五官、发型、妆容、服装、配饰、姿态、气质，以及图片的构图、色彩、光线和整体风格，并将分析结果具体写入提示词。\n\n3. 自主完成设计\n\n根据用户指定的风格，自主设计完整的构图、版面、信息模块、字体、色彩、装饰、光影、材质和空间关系。\n\n4. 自主生成文字\n\n根据图片和主题，自主生成海报中需要出现的标题、副标题、人物信息、风格分析、服饰细节、色卡、标签、关键词、场景推荐等内容。\n\n所有需要生成的文字必须在提示词中逐项明确写出，不能只写“添加人物信息”“加入相关关键词”等模糊描述，也不能使用“若干”“类似”“等”代替具体内容。\n\n5. 具体化视觉元素\n\n涉及色卡、雷达图、时间线、评分、搭配方案等内容时，必须明确写出具体的名称、数值、文字、颜色和排列方式。\n\n6. 保持人物一致\n\n默认严格保持输入人物的面容、五官、脸型、肤色、年龄感、发型特征和整体气质，不改变人物身份。\n\n7. 明确版面关系\n\n明确标题、人物、文字、卡片和装饰元素的位置、大小、层级及避让关系，确保文字清晰完整，人物不遮挡重要信息，整体留白合理。\n\n8. 禁止虚构事实\n\n可以根据图片进行合理的风格分析和内容创作，但不要虚构无法从图片确认的姓名、年龄、身高、职业、身份等具体事实。\n\n9. 最终提示词要求\n\n最终提示词不能只是对用户原文进行简单改写，而应扩写成完整的视觉设计执行稿。\n\n提示词至少应包含整体视觉、人物一致性、版面与构图、人物主体、各信息模块、每个模块的具体文字、字体、色彩、装饰、光影、材质、空间关系和生成约束。\n\n所有需要生成的文字必须明确写出来，所有需要生成的视觉元素必须明确描述，避免使用含糊的概括性表达。\n\n核心原则是：用户提供创意方向，图片提供视觉事实，LLM负责完成视觉分析、版面设计、内容生成和细节扩写。\n\n最终生成的提示词应达到专业视觉设计师根据输入图片编写生图方案的详细程度，只输出最终的提示词内容即可，不要输出分析过程，解释,多余的符号如“*、#”等内容。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 499, "type": "Text", "properties": {"ver": "495f9773dd3651a366ebac664fc4b0f301e9b1b3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "aux_id": "TFL-TFL/ComfyUI_Text_Translation", "Node name for S&R": "Text"}, "order": 11}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.53.6", "VHS_latentpreview": false, "ds": {"offset": [1487.8822891148868, -2670.0963835668313], "scale": 0.9646149645000208}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 38, "title": "Models", "bounding": [-955.95751953125, 2165.2333984375, 530, 590]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 39, "title": "Image Size", "bounding": [-957.7972412109375, 2783.3935546875, 530, 250]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 40, "title": "Conditioning", "bounding": [-413.9311828613281, 2171.973388671875, 700, 860]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 41, "title": "Sampling", "bounding": [334.0424499511719, 2165.2333984375, 470, 860]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 43, "title": "Group", "bounding": [-946.288330078125, 3062.0537109375, 1101.902587890625, 724.4767456054688]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 44, "title": "图片上传", "bounding": [-2221.147705078125, 2170.8759765625, 1254.3138427734375, 864.906494140625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, 