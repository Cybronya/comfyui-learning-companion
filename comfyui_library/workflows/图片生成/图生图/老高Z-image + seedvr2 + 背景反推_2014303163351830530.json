TH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 24, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "min_pixels"}, "name": "min_pixels", "label": "min_pixels", "type": "INT", "localized_name": "min_pixels"}, {"widget": {"name": "max_pixels"}, "name": "max_pixels", "label": "max_pixels", "type": "INT", "localized_name": "max_pixels"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention"}, "name": "attention", "label": "attention", "type": "COMBO", "localized_name": "attention"}], "flags": {}, "id": 24, "type": "Qwen3_VQA", "properties": {"ver": "70cc35edacfd5979cbe7a15caf56bd2f715bc3b5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4"}, "widget_ue_connectable": {}, "aux_id": "IuvenisSapiens/ComfyUI_Qwen3-VL-Instruct", "Node name for S&R": "Qwen3_VQA"}, "order": 7}, {"mode": 0, "outputs": [{"name": "text", "links": [], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [341.35198974609375, 735.428955078125], "pos": [-1928.0999755859375, 663.5187377929688], "widgets_values": ["\n\n环境元素：  \n- 城市后巷/狭窄小巷，两侧为老旧混凝土建筑  \n- 墙面斑驳剥落，贴满褪色海报与涂鸦  \n- 天花板与墙面布满杂乱交错的电线与管道  \n- 地面为破损石板路，中央有积水反光的圆形井盖  \n- 右侧墙角堆放两个黑色塑料垃圾袋  \n- 墙面与建筑外挂多个空调外机  \n- 远处可见一扇木质门与铁栅栏门  \n- 背景有微弱光源与模糊建筑轮廓\n\n光影氛围：  \n- 单光源路灯从巷道上方斜向投射，形成强烈明暗对比  \n- 地面水洼反射灯光，形成镜面高光  \n- 建筑阴影浓重，营造幽深、孤寂、潮湿的夜间氛围  \n- 光线穿透雾气或水汽，产生轻微光晕与散射效果\n\n色彩质感：  \n- 主色调为冷灰蓝与深墨绿，局部点缀暖黄灯光  \n- 墙面与地面呈现粗粝、潮湿、风化质感  \n- 金属与塑料材质反光细腻，石板路纹理清晰  \n- 空气感微浊，带有轻微颗粒感与雾气\n\n构图景别：  \n- 全景广角，采用中心透视构图，巷道向远方延伸  \n- 井盖位于画面中轴线，引导视觉焦点  \n- 两侧建筑对称压迫，形成纵深感与空间压迫感  \n- 画面边缘留白，突出巷道主体\n\n\n\n———  \n【补充说明】  \n本提示词为“无文字信息”纯视觉描述，适用于文生图模型精准还原场景。  \n若需加入“淡灰色背景、纯色、正面打光、全局光照”等要求，可追加：  \n“整体背景为统一淡灰，无杂乱元素，正面柔光均匀铺满，全局光照无硬阴影，保留环境自然反射与材质高光”  \n（此部分已融入原图光影氛围描述中，可作为优化补充）\n\n———  \n【最终提示词整合版】  \n“城市后巷夜景，两侧老旧混凝土建筑，墙面斑驳贴满褪色海报与涂鸦，布满杂乱电线与空调外机，地面破损石板路中央有积水反光的圆形井盖，右侧墙角堆叠黑色塑料垃圾袋，远处可见木质与铁栅栏门，单盏路灯从上方斜投强光，地面水洼镜面反射，建筑阴影浓重，营造幽深潮湿氛围，主色调冷灰蓝与深墨绿，局部暖黄灯光点缀，材质粗粝真实，金属塑料反光细腻，石板路纹理清晰，空气微浊带颗粒感，全景广角中心透视，井盖引导视觉焦点，两侧建筑压迫感强，画面边缘留白突出主体，整体背景统一淡灰，正面柔光均匀铺满，全局光照无硬阴影，"], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 69, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 55, "type": "TextBox", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextBox"}, "order": 12}, {"mode": 0, "outputs": [{"name": "texts", "links": [60, 69], "label": "texts", "type": "STRING", "localized_name": "texts"}], "size": [270, 82], "pos": [-2290.949951171875, 577.2098388671875], "widgets_values": ["", ""], "inputs": [{"widget": {"name": "texts"}, "name": "texts", "link": 67, "label": "texts", "type": "STRING", "localized_name": "texts"}, {"widget": {"name": "prefix"}, "name": "prefix", "link": 58, "label": "prefix", "type": "STRING", "localized_name": "prefix"}], "flags": {}, "id": 51, "type": "AddTextPrefix", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AddTextPrefix"}, "order": 10}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRenderer