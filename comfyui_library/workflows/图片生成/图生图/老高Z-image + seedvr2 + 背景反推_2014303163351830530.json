e for S&R": "UNETLoader"}, "order": 3}, {"mode": 0, "outputs": [{"name": "output", "links": [67], "label": "output", "type": "*", "localized_name": "output"}], "size": [157.38925170898438, 26], "pos": [-2472.06689453125, 373.807861328125], "widgets_values": [], "inputs": [{"name": "anything", "link": 23, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": false}, "id": 23, "type": "easy cleanGpuUsed", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy cleanGpuUsed"}, "order": 9}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [460.666748046875, 646.056396484375], "pos": [-3904.27783203125, -143.0418701171875], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 22, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 21, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 16}, {"mode": 0, "outputs": [{"name": "output", "links": [23], "label": "output", "type": "*", "localized_name": "output"}], "size": [311.6855163574219, 494.29150390625], "pos": [-2673.953125, -170.8614959716797], "widgets_values": ["【专业AI图像生成提示词 · 无文字版】\n\n——【建筑细节】  \n中式传统石质城门结构，门楣横梁上雕刻有祥云纹与回纹装饰，门框两侧立柱粗壮，柱础为方形石墩，门洞内侧有对称的门轴结构，门扉呈半开状态，门缝透出幽蓝雾气，门框边缘有轻微风化与苔藓痕迹。\n\n——【建筑造型】  \n仿古牌楼式城门，屋顶为歇山顶结构，屋脊两端翘起，屋面覆盖青灰色瓦片，屋脊正中设宝瓶式吻兽，屋檐下悬垂斗拱结构，门洞呈对称矩形，整体造型庄重肃穆，带有东方冥界建筑的威严感。\n\n——【环境元素】  \n城门两侧高耸城墙，墙头布满密集的骷髅骨架，部分骷髅手持骨杖或骨刀，城墙外侧有飘动的幽蓝色雾气，地面铺满石板，雾气从门洞中弥漫而出，远处天空有星点闪烁，云层呈暗蓝色流动状，整体场景暗示阴间或亡灵聚集之地。\n\n——【光影氛围】  \n冷色调光源从门洞内透出，形成幽蓝光晕，照亮门前区域，光线呈半透明雾状扩散，骷髅群在光线下呈现剪影与半透明质感，阴影浓重，营造出神秘、压抑、肃杀的氛围，整体光影对比强烈，强调门内与门外的空间分界。\n\n——【色彩质感】  \n主色调为深蓝、灰蓝、暗灰与墨黑，局部点缀幽蓝雾气与微弱星光，材质表现上，石质建筑粗糙斑驳，骷髅骨骼呈现半透明灰白质感，雾气有流动感与粒子感，整体画面质感偏写实与水墨渲染结合，强调阴冷与肃穆的触感。\n\n——【构图景别】  \n中心对称构图，城门位于画面正中，占据视觉焦点，两侧骷髅群呈对称分布，形成压迫感，前景为石板地面与雾气，中景为城门与骷髅群，远景为星空与云层，景别层次分明，采用广角镜头视角，强化空间纵深与仪式感。\n\n——【绘画风格】  \n东方水墨动画风格，线条细腻流畅，人物与建筑轮廓清晰，阴影与色彩过渡柔和，带有手绘质感与传统工笔画的笔触感，同时融合现代数字绘画的光影渲染，整体风格兼具古典东方美学与超现实冥界氛围。\n\n——【补充说明】  \n画面无文字，无现代元素，无色彩鲜艳区域，强调阴冷、肃穆、神秘、压迫感，适合用于冥界、鬼域、亡灵、生死之门等主题的视觉创作。"], "inputs": [{"shape": 7, "name": "anything", "link": 25, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 25, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "125b3a4905ac9367f7aae5c2df67e2282f0a3d37", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 8}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [24], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [300.8353271484375, 592.3099975585938], "pos": [-3373.40771484375, -197.97784423828125], "widgets_values": ["f21982eff8bb00929b87a8f3d2917013a9dbd3b894f5aef2420aede3d8954da7.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 22, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.67", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 4}, {"mode": 0, "