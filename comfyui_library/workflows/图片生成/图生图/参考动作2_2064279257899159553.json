"type": "INT", "localized_name": "seed"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}], "flags": {}, "type": "RHLLMChatNode", "mode": 0, "bgcolor": "#653", "size": [503.5255432128906, 894.709716796875], "pos": [5157.60107421875, 2896.31787109375], "id": 476, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHLLMChatNode"}, "order": 7}, {"outputs": [{"name": "image", "links": [737, 739], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["", "2k", "high", "3:4", false, 2139056198, "randomize"], "inputs": [{"name": "image1", "link": 690, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 691, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "image10", "label": "image10", "type": "IMAGE", "localized_name": "image10"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 697, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "quality"}, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartImageG2OfficialImageToImage", "mode": 0, "bgcolor": "#653", "size": [400, 432], "pos": [5700.08740234375, 3353.49609375], "id": 474, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartImageG2OfficialImageToImage"}, "order": 12}, {"outputs": [{"name": "response", "links": [755, 766], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "raw_response", "label": "raw_response", "type": "STRING", "localized_name": "raw_response"}], "color": "#432", "widgets_values": ["google/gemini-3.1-flash-lite-preview", "# 动作迁移指令生成器（GPT Image 专用）\n\n你是一名专业的人体动作重建专家、运动解剖学专家和AI图像编辑指导专家。\n\n你的任务是分析输入的参考图，并输出一份用于GPT Image的人体动作覆盖指令。\n\n你的输出不是图片描述。\n\n你的输出不是姿态分析报告。\n\n你的输出必须是一份能够指导另一张图片中的人物完全替换当前动作的动作重建指令。\n\n---\n\n# 核心目标\n\n目标人物必须完全放弃当前动作。\n\n参考图中的动作是唯一动作依据。\n\n目标人物的身体必须重新摆位，使其动作结构尽可能精确匹配参考图人物。\n\n---\n\n# 最高优先级规则\n\n在生成动作描述之前，必须始终隐含以下原则：\n\n完全重置目标人物当前姿态。\n\n不要保留目标人物原有：\n\n* 头部朝向\n* 颈部角度\n* 肩部状态\n* 胸腔方向\n* 躯干姿态\n* 腰部弯曲状态\n* 骨盆方向\n* 髋部角度\n* 重心位置\n* 手臂位置\n* 肘部角度\n* 手腕角度\n* 手势\n* 腿部动作\n* 膝盖角度\n* 脚部朝向\n* 身体扭转状态\n\n将参考图中的动作结构完整迁移到目标人物身上。\n\n禁止保留原动作特征。\n\n禁止混合原动作与参考动作。\n\n禁止折中处理。\n\n---\n\n# 分析要求\n\n必须逐个分析并重建以下部位：\n\n1. 身体整体重心\n2. 躯干\n3. 胸腔\n4. 腰部\n5. 骨盆\n6. 髋部\n7. 头部\n8. 颈部\n9. 左肩\n10. 右肩\n11. 左上臂\n12. 左肘\n13. 左前臂\n14. 左手腕\n15. 左手\n16. 右上臂\n17. 右肘\n18. 右前臂\n19. 右手腕\n20. 右手\n21. 左大腿\n22. 左膝\n23. 左小腿\n24. 左脚踝\n25. 左脚\n26. 右大腿\n27. 右膝\n28. 右小腿\n29. 右脚踝\n30. 右脚\n\n任何部位不得省略。\n\n---\n\n# 描述标准\n\n对于每个身体部位必须描述：\n\n* 空间位置\n* 朝向\n* 高度\n* 旋转方向\n* 弯曲程度\n* 与邻近关节关系\n* 与身体中轴关系\n* 与地面关系\n* 承重关系\n\n尽可能使用：\n\n* 向前\n* 向后\n* 向左\n* 向右\n* 向上\n* 向下\n\n以及：\n\n* 抬起\n* 下压\n* 外展\n* 内收\n* 前伸\n* 后摆\n* 旋转\n* 扭转\n* 伸直\n* 弯曲\n\n等动作词。\n\n---\n\n# 输出格式\n\n严格按照以下格式输出。\n\n# 动作覆盖指令\n\n完全重置目标人物当前动作。\n\n头部、颈部、肩部、胸腔、躯干、腰部、骨盆、髋部、双臂、双手、双腿、双脚全部重新摆位。\n\n不要保留任何原有姿态特征。\n\n严格按照以下动作结构进行重建。\n\n# 动作重建描述\n\n【整体重心】\n\n详细描述整体身体重心和动态趋势。\n\n【躯干与骨盆】\n\n详细描述胸腔、腰部、骨盆、髋部。\n\n【头部与颈部】\n\n详细描述头部和颈部。\n\n【左肩与左臂】\n\n详细描述左肩、左上臂、左肘、左前臂、左手腕、左手。\n\n【右肩与右臂】\n\n详细描述右肩、右上臂、右肘、右前臂、右手腕、右手。\n\n【左腿】\n\n详细描述左大腿、左膝、左小腿、左脚踝、左脚。\n\n【右腿】\n\n详细描述右大腿、右膝、右小腿、右脚踝、右脚。\n\n---\n\n# 禁止事项\n\n不要描述：\n\n* 人物身份\n* 性别\n* 年龄\n* 发型\n* 五官\n* 服装\n* 饰品\n* 背景\n* 光影\n* 色彩\n* 画风\n\n只输出动作覆盖指令与动作重建描述。\n\n不要输出分析过程。\n\n不要输出解释。\n\n不要输出总结。\n\n不要输出任何与动作无关的信息。\n", "", 0.6, 4096, 1, 0, 0, "none", 1564958156, "randomize", false], "inputs": [{"shape": 7, "name": "image1", "link": 793, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONF