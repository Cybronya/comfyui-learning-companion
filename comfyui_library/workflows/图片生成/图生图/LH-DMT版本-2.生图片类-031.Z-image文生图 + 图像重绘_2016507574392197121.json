h_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "batch_size"}], "flags": {}, "type": "EmptyLatentImage", "mode": 2, "bgcolor": "#353", "size": [270, 110], "pos": [920, 1070], "id": 13, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "EmptyLatentImage"}, "order": 6}, {"outputs": [{"name": "CONDITIONING", "links": [3, 4], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["在霓虹闪烁的未来都市夜幕下，一位身姿曼妙的粉发女郎傲然伫立于高楼天台边缘——她身穿一件贴合曲线的黑色高光皮质长裙，领口与腰线处缀以精致暗纹装饰，一侧开衩至大腿根部露出光滑修长美腿，在城市灯光映照下泛着丝绸般的柔润光泽；她的双马尾垂坠飘逸，头顶佩戴复古蕾丝头饰并系有轻纱面纱半掩面容，红唇微扬似含笑意又透出几分神秘冷艳；双手优雅搭扶栏杆，身体微微前倾倚靠而立，目光直视镜头仿佛穿透时空凝望观者灵魂深处。背景是灯火辉煌的摩天大楼群，其中一座塔楼顶部清晰可见“Pala”字样标识被暖橙色光芒点亮，整座城市的玻璃幕墙反射星光交织成流动光影之河；天空深邃如墨蓝绸缎，唯有几缕云絮勾勒轮廓，远处楼宇间隐约浮现蓝色广告牌与点状窗灯点缀其间。光线从侧面斜射而来，在她肌肤、衣料及腿部形成强烈明暗对比，营造戏剧性立体雕塑般效果，同时地面倒影模糊呈现镜像虚幻氛围；整体画面弥漫浓郁赛博朋克美学气息却又不失东方古典韵味融合之美：既有《攻壳机动队》式的科技冰冷质感，亦夹杂日式动漫角色设计中的细腻表情刻画与动态张力——这是一幅兼具摄影真实度与数字渲染超现实主义的艺术杰作，宛如好莱坞科幻大片开场定格瞬间或顶级概念插画集封面图，每一寸细节都在召唤观众沉浸进这个充满欲望、力量与未知诱惑的虚拟世界中。"], "inputs": [{"name": "clip", "link": 2, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 2, "bgcolor": "#353", "size": [300, 310], "pos": [1200, 1070], "id": 5, "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 10}, {"outputs": [{"name": "CONDITIONING", "links": [22, 26], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["电影级画质，光线明亮高质量、8K、摄影"], "inputs": [{"name": "clip", "link": 25, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mod