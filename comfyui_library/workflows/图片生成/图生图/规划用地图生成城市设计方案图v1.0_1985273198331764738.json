_properties": {"widget_ue_connectable": {"lora_name": true, "strength_model": true}}, "secondTabOffset": 80, "Node name for S&R": "LoraLoaderModelOnly", "tabWidth": 65, "secondTabWidth": 65, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "tabXOffset": 10}, "order": 14}, {"outputs": [{"name": "STRING", "links": [], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["将规划用地图转化为高品质总平面深化概念图，兼具规划合规性与空间设计美学，突出场所精神、空间序列及设计意境，按用地性质适配建筑布局，地块内建筑避免围合式布局。\n设计核心与空间表达\n\n规划约束继承： 保持原规划的容积率、绿地率、限高、用地性质等指标。\n\n建筑布局： 采用开放、舒展的空间结构，避免围合式建筑群。建筑体量协调、有韵律，形成丰富的空间层次与过渡。\n\n公共空间： 明确展示广场、公园、水系的空间主题，营造有焦点的视觉序列与氛围层次。\n\n慢行系统： 流畅呈现步行与慢跑路径的空间流线，强调体验与材质美感。\n\n配套场景： 情境化表现教育、商业、文化等生活节点，形成多样化生活画面。\n\n车行交通： 简洁示意，以服务功能为主，不强调工程细节。\n\nII. 视觉与美学表现\n\n风格主调： 精致、雅致、艺术感强。以黑白灰素描风为基础，强调光影与结构。\n\n色彩控制： 整体黑白灰，仅在关键要素（建筑、水景、主要绿地）上点缀 2–3 种 低饱和淡彩（如淡松石绿、浅陶土色），透明度＞50%。\n\n光影表现： 统一斜向光源（西北 45°），阴影柔和，层次清晰，自投影略浅于落影，边缘柔化。\n\n肌理表现： 道路、广场、绿地灰度区分明显，纹理自然、线条细腻。\n\n配景点缀： 以少量人物剪影、车辆、树木符号作为比例与场景点景，增强空间叙事与生活气息。\n\n视角设定： 微倾鸟瞰或轴测视角，强调空间深度与设计层次。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "Text Multiline", "mode": 0, "bgcolor": "#353", "size": [642.0921630859375, 541.3350219726562], "pos": [-836.1299438476562, 154.96688842773438], "id": 60, "properties": {"cnr_id": "was-ns", "ver": "3.0.1", "widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 0}, {"outputs": [{"name": "IMAGE", "links": [102], "label": "IMAGE", "type": "IMAGE", "localized_name": "图像"}], "color": "#233", "widgets_values": [], "inputs": [{"name": "image", "link": 88, "label": "image", "type": "IMAGE", "localized_name": "image"}], "flags": {}, "type": "FluxKontextImageScale", "mode": 0, "bgcolor": "#355", "size": [336.4862060546875, 61.36616516113281], "pos": [126.37116241455078, 1311.31591796875], "id": 62, "properties": {"cnr_id": "comfy-core", "ver": "0.3.50", "widget_ue_connectable": {}, "