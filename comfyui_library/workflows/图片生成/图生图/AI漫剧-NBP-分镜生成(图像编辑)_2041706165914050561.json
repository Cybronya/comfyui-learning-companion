OMBO", "links": [12], "type": "COMBO"}], "color": "#432", "widgets_values": ["9:16", "fixed", ""], "inputs": [], "flags": {}, "type": "PrimitiveNode", "mode": 0, "bgcolor": "#653", "size": [474.1236267089844, 106], "pos": [1313.133056640625, 992.8035278320312], "id": 13, "properties": {"widget_ue_connectable": {}, "Run widget replace on values": false}, "order": 10}, {"outputs": [{"name": "text", "links": [14], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#432", "widgets_values": ["图1是林晚晴，图2是刘桂兰，图3是客厅和厨房场景\n生成一张专业故事板风格的2x2四宫格分镜总图，竖版9:16排版，四个画面有清晰分隔。两个角色林晚晴（25岁，黑发，白色连衣裙）和刘桂兰(62 岁中老年)，同一场景（破旧片场角落），同一光线（阴天散射光+侧逆光）。不允许出现风格漂移、人物变形。每个面板严格为 9:16 比例，右下角分别添加统一样式小标签：1、2、3、4。\n\n左上格 1（起）：特写刘桂兰噘起的嘴唇，62 岁中老年女性面部肌肉紧绷，愤怒嘶吼状态，暖光偏暗的客厅餐桌旁背景，写实家庭伦理风，压抑紧张氛围，面部细节清晰，光影突出面部狰狞感，电影级画质，写实细节，\n右上格 2（承）：特写林晚晴泛红的眼眶，眼尾泪珠打转，40 岁女性面露惊慌，眼底含泪，皮肤质感真实，暖光偏暗侧光打在眼部，写实风格，压抑委屈氛围，眼部细节拉满，电影感，自然光，清晰构图，\n左下格 3（转）：中景，暖光偏暗的客厅餐桌旁，4 菜 1 汤整齐摆放，林晚晴后背撞向餐桌，手里盘子倾斜，身体微微发抖，面露惊慌，刘桂兰双手叉腰身体前倾怒吼，写实家庭伦理风，紧张冲突氛围，空间关系清晰，电影级特写，\n右下格 4（合）：特写林晚晴捏着盘子的指尖，指节泛白微微颤抖，指尖皮肤泛红，盘子边缘清晰，暖光偏暗打在手部，写实风格，压抑紧张氛围，手部细节真实，电影感，锐利细节，\n\n整体要求：叙事清晰，构图优秀，角色一致，道具一致，空间一致，无字幕，无水印，无时间码，无多余文字。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#653", "size": [486.2506408691406, 406.41363525390625], "pos": [1303.859375, 316.0955505371094], "id": 18, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 11}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [957.2726440429688, 1066.2847900390625], "pos": [2633.35009765625, 369.28802490234375], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 13, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "locali