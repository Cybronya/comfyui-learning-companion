-406.9945373535156, -1169.5169677734375], "widgets_values": ["【包装设计拆解】  \n主体视觉：Logo“客全”为品牌标识，主图案为凤凰踏云、古塔与热气腾腾的卤鸡锅，象征“长安味”与“大讲究”。产品名“长安卤鸡”醒目居中，辅以“小卤味 大讲究”Slogan，强化风味与匠心。  \n版面结构：信息分层清晰，品牌名+Slogan+图案+产地年份（1998）构成视觉金字塔，底部标注净含量（500g±50g）。  \n视觉元素：主色红金，传递喜庆与传统；辅以青绿波浪、祥云纹，形成视觉张力。字体为仿古楷书+现代无衬线，兼具古典韵味与现代感。材质模拟烫金与丝绒质感，增强高级感。  \n构图逻辑：中心对称，凤凰与锅具为视觉重心，两侧留白搭配祥云与礼盒，营造仪式感与空间层次。  \n风格调性：鲜明“国潮”风，融合长安文化符号与现代设计语言，兼具传统美学与商业表达。\n\n【文案建议】  \n广告语： “一锅卤香，千年长安味。”  \n卖点提炼：非遗工艺 · 三重卤香 · 1998匠心传承  \n成分说明：精选土鸡+秘制卤料，无添加防腐剂，保留原味鲜香。\n\n【图像生成提示词】  \n“国潮风格包装设计，红色主调，金色边框，中央为凤凰踏云图腾，左侧热锅卤鸡，右侧古塔祥云，底部标注‘长安卤鸡’与‘1998’字样，背景为红绸幕布与礼盒点缀，整体呈现高端礼盒质感，尺寸比例1:1，工艺细节包含烫金与丝绒纹理，氛围喜庆复古，光线柔和，3D渲染。”"], "inputs": [{"shape": 7, "name": "anything", "link": 257, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 112, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "1.3.4", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 29}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [218, 228], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [304.826171875, 571.6815795898438], "pos": [-1134.358642578125, 347.4414978027344], "widgets_values": ["pasted/a5c55cfcde2c47bbf809538dfee00ddb2aae8eba2b6ce4b90a54013911ce411b.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 79, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.5.1", "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [190], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": 