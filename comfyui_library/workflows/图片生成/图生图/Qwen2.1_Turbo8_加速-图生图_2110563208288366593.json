保留边缘，请选择接近原图的比例。这是参考图条件编辑，不是通过 denoise 滑块控制强度的传统 VAE 重绘。\n\n## 校验范围\n本文件仅依赖 ComfyUI 原生节点，已移除两个 KJ 注意力补丁。交付前检查 JSON、端口类型、双向连线、采样表和尺寸链路；未在你的 RunningHUB 账户加载模型或实际出图。导入后先以 1 MP 单张运行成功，再保存或发布。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "必读｜模型匹配、输入与上传", "mode": 0, "bgcolor": "#30465b", "size": [750, 580], "pos": [0, 740], "id": 18, "properties": {"cnr_id": "comfy-core", "ver": "0.37.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 5}, {"mode": 0, "outputs": [], "size": [460, 380], "pos": [2481.72119140625, 876.2968139648438], "widgets_values": [], "inputs": [{"name": "compare_view", "label": "compare_view", "type": "IMAGECOMPARE", "localized_name": "compare_view"}, {"shape": 7, "name": "image_a", "link": 18, "label": "image_a", "type": "IMAGE", "localized_name": "image_a"}, {"shape": 7, "name": "image_b", "link": 19, "label": "image_b", "type": "IMAGE", "localized_name": "image_b"}], "flags": {}, "id": 20, "type": "ImageCompare", "title": "预处理参考图 ↔ 生成结果", "properties": {"cnr_id": "comfy-core", "ver": "0.37.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "ImageCompare"}, "order": 18}, {"outputs": [{"name": "MODEL", "links": [20], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#26394c", "widgets_values": ["auto", false], "inputs": [{"name": "model", "link": 21, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "sage_attention"}, "name": "sage_attention", "label": "sage_attention", "type": "COMBO", "localized_name": "sage_attention"}, {"widget": {"name": "allow_compile"}, "shape": 7, "name": "allow_compile", "label": "allow_compile", "type": "BOOLEAN", "localized_name": "allow_compile"}], "flags": {}, "type": "PathchSageAttentionKJ", "title": "KJ SageAttention｜auto｜不编译", 