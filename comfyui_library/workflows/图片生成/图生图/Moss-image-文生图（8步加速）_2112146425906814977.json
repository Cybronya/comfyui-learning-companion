": "INT", "localized_name": "seed"}, {"widget": {"name": "sampling_mode.presence_penalty"}, "shape": 7, "name": "sampling_mode.presence_penalty", "type": "FLOAT", "localized_name": "presence_penalty"}, {"widget": {"name": "thinking"}, "shape": 7, "name": "thinking", "label": "thinking", "type": "BOOLEAN", "localized_name": "thinking"}, {"widget": {"name": "use_default_template"}, "shape": 7, "name": "use_default_template", "label": "use_default_template", "type": "BOOLEAN", "localized_name": "use_default_template"}, {"widget": {"name": "mtp"}, "shape": 7, "name": "mtp", "label": "mtp", "type": "COMBO", "localized_name": "mtp"}], "flags": {}, "id": 16, "type": "TextGenerate", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextGenerate"}, "order": 10}, {"mode": 0, "outputs": [{"name": "STRING", "links": [17], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [486.3302917480469, 628.44970703125], "pos": [794.0228881835938, 1040.478759765625], "widgets_values": ["You turn a user's image idea into one detailed caption for a text-to-image model. The model learned from captions that describe finished images, so write the caption as a description of the image itself, not as instructions.\n\nKeep the request\n- Keep everything the user specified: subjects, counts, actions, relationships, medium, style, mood, colors and anything they excluded. Never contradict or drop it.\n- Fill in what they left open with concrete visual choices: setting, composition and framing, viewpoint, lighting, materials and textures, color palette, and the artistic medium.\n- Describe only what can be seen. Leave out sounds, smells, backstory and intentions.\n- Do not invent real-world facts the user did not give, such as specific dates, prices, names or specifications.\n\nText in the image\n- Quote every piece of visible text exactly, in double quotes. Keep the user's wording, language, spelling, capitalization, punctuation and line breaks; never translate it.\n- If the user asks for a designed image (poster, cover, menu, label, sign, infographic) without giving its text, write short, specific copy that fits instead of placeholders.\n- Describe where each text sits and how it looks: position, reading order, alignment, line breaks, relative size, font style, color and spacing.\n- Do not mention watermarks or artist signatures.\n\nWriting\n- Write in English, in plain prose: one to three paragraphs, usually 80 to 200 words, longer only when there is a lot of text to place.\n- Open with the medium and the main subject, then the setting and composition, then lighting, colors and finer details.\n- Give positions with words such as left, right, top, bottom, foreground and background. No coordinates, lists, headings, JSON or Markdown.\n- No quality keywords such as \"masterpiece\", \"best quality\", \"8k\" or \"highly detailed\", and no negative prompt.\n\nReply with the caption only: no title, introduction, explanation or surrounding quotes."], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "id": 15, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 6}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [-365.0416348992169, -518.507985536428], "scale": 0.6830134553650707}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Group", "bounding": [540.6907958984375, 252.0271759033203, 456.6025085449219, 641.588623046875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Group", "bounding": [1048.929931640625, 225.184814453125, 1907.859619140625, 719.598876953125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Group", "bounding": [784.0228881835938, 966.8786010742188, 773.0764770507812, 712.0496826171875]}], "links": 