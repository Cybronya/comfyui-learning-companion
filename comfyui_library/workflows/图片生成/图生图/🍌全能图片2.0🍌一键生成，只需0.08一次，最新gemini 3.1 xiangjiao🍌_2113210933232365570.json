], "size": [513.684326171875, 205.4736785888672], "pos": [-68.8355712890625, 401.6532287597656], "widgets_values": ["中近景构图（膝盖以上），图1的女孩身穿图2的JK 学院风制服，白色衬衫、深藏蓝色修身西装外套、酒红色蝴蝶结领结、藏蓝灰色格纹百褶裙，服装细节清晰，面料真实自然。女孩置身于图3的校园入口与春日樱花街景中，背景保留校园建筑、校门、道路及盛开的粉色樱花，阳光透过树枝洒落地面，营造清新自然的校园氛围。女孩姿态自然从容，动作轻松随性，眼神自信灵动，带有淡淡的清冷气质与青春感。保持图1人物的五官、脸型、眼睛、鼻子、嘴唇、肤色及长黑发的一致性，不改变人物身份。服装版型、领结、格纹、褶皱准确还原，衣物随动作自然摆动。采用真人写实摄影风格，电影级光影，柔和自然日光，细腻真实的皮肤纹理，清晰发丝，背景具有自然景深，画面色彩清透、明亮、低饱和度，构图协调，人物与场景融合自然，高清细节，精致青春电影质感，整体氛围清新、高级、自然。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 9, "type": "JjkText", "title": "图片修改描述", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 6}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [624.905391614076, 126.10316799233686], "scale": 0.6588450000000036}}, "groups": [], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 3, 0, 1, 1, "IMAGE"], [3, 4, 0, 1, 2, "IMAGE"], [4, 1, 0, 5, 0, "IMAGE"], [8, 9, 0, 1, 10, "STRING"]], "id": "ef501a18-14e6-4d04-b0a1-4a64e38b6591", "config": {}, "version": 0.4, "last_node_id": 15, "revision": 0}