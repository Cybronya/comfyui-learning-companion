r narrative progression.\"\n  ],\n  \"storyboard_panels\": [\n    {\n      \"panel\": \"top_left\",\n      \"shot\": \"wide establishing shot with character present\",\n      \"must_have\": [\n        \"same child explorer clearly visible in the foreground\",\n        \"chocolate river\",\n        \"cake towers and candy hills\"\n      ],\n      \"description\": \"The child explorer enters the magical candy valley for the first time. He must be clearly visible in the foreground, full body or medium full-body, as the central subject. Chocolate rivers, cake towers, sugar paths, candy hills, and cotton candy clouds fill the environment.\"\n    },\n    {\n      \"panel\": \"top_right\",\n      \"shot\": \"medium full-body walking shot\",\n      \"must_have\": [\n        \"same child explorer walking on a sugar road\",\n        \"candy valley still visible\",\n        \"compass and satchel retained\"\n      ],\n      \"description\": \"The same child walks along a glossy sugar road beside a flowing chocolate river. Candy plants and pastel sweets line the path. His cape, satchel, and brass compass remain visible.\"\n    },\n    {\n      \"panel\": \"bottom_left\",\n      \"shot\": \"close medium magical discovery shot\",\n      \"must_have\": [\n        \"same child explorer kneeling or leaning beside a glowing cake doorway\",\n        \"brass compass clearly visible\",\n        \"warm magical light illuminating his face\"\n      ],\n      \"description\": \"The same child discovers a glowing cake doorway hidden inside a dessert tower. He kneels beside it and holds up the brass compass. The glowing doorway is large, bright, and clearly the key magical object of the story.\"\n    },\n    {\n      \"panel\": \"bottom_right\",\n      \"shot\": \"heroic magical reaction wide shot\",\n      \"must_have\": [\n        \"same child explorer reacting to the activated doorway\",\n        \"the glowing cake doorway or sugar-light source still visible\",\n        \"spiral sugar light in the air\"\n      ],\n      \"description\": \"The cake doorway activates and sends a spiral of glowing sugar light into the sky. The same child reacts with wonder and steps forward. The magical source must still be visible so the connection to panel 3 is obvious. This should not be just another generic walking shot; it must show a clear magical consequence.\"\n    }\n  ],\n  \"final_requirement\": \"The four panels must feel like one coherent candy-fantasy storyboard sequence, with strong continuity of character, pastel candy-world environment, magical event progression, and emotional storytelling.\"\n}"], "inputs": [{"name": "clip", "link": 45, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 39, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 22}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [815.6528930664062, 475.39654541015625], "pos": [1436.1724853515625, 2912.634521484375], "widgets_values": [], "inputs": [{"name": "images", "link": 39, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "id": 34, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 35}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-18.073005958839758, -2322.1846460413053], "scale": 0.45}, "info": "Krea2 Turbo basic workflow using RES4LYF registered sampler res_2m and scheduler beta57. Install RES4LYF first."}, "groups": [{"color": "#3f789e