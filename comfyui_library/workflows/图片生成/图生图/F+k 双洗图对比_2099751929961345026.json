: "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#353", "size": [281.2149353027344, 436.6705322265625], "pos": [175.23326110839844, 550.0353393554688], "id": 20, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 12}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [24, 70], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [140, 46], "pos": [2189.9755859375, 353.93212890625], "inputs": [{"name": "samples", "link": 22, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 23, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 22, "type": "VAEDecode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 30}, {"mode": 0, "outputs": [{"name": "STRING", "links": [63], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "size": [400, 274], "pos": [1162.4420166015625, 777.13037109375], "widgets_values": ["append", "yes", "", "", "", "xy25dpaint style, bxyxfg, <style_convert>, 3D Render Style. 3DRenderAF., 深海沉船遗址下，一名肌肉健壮的潜水员身着米色短袖上衣和棕色皮质背带裤，佩戴蓝色护目镜与氧气面罩，右手紧握发光探照灯照亮前方，左手微张似欲拾取；身旁一只橙白相间的小狗同样装备完整潜水设备，在水中欢快跃动吐出气泡；两者目光聚焦于中央沙地上一座华丽金制烟壶——瓶体雕花繁复镶嵌红绿宝石，顶部饰有红色尖顶宝珠，弯曲软管蜿蜒至地面连接金属接口；周围散落木箱与珊瑚礁石，海水澄澈透亮阳光从上方斜射形成光束穿透波纹，鱼群穿梭游弋，远处锈蚀飞机残骸如巨兽骨架横卧海底，舱窗破损座椅依稀可见，整体采用对角线构图以烟壶为视觉中心，人物动作动态自然吸引视线向右延伸，冷暖对比强烈突出金色器物光辉，营造神秘探险与童话奇遇交织的沉浸式海洋考古氛围。, 高品质商业级手游宣传原画，精致的2.5D游戏美术风格，欧美卡通游戏视觉，3D角色与3D场景结合手绘厚涂质感，整体具有高级、精致、饱满、可爱的商业游戏美术完成度。角色采用夸张但合理的卡通比例，人物体型健壮，面部五官清晰立体，表情生动，造型圆润但具有力量感，毛发、皮肤、服装和装备拥有细腻真实的材质表现，同时保持明显的卡通化设计语言。物体具有圆润厚实的体积感，边缘干净柔和，细节经过高度概括与设计，不追求照片级写实。采用精细3D建模结合手绘笔触的渲染方式，表面具有柔和细腻的手绘纹理、轻微笔触变化和丰富但克制的材质层次，金属、玻璃、皮革、布料、木材等材质区分明确。整体色彩鲜艳明快，纯净高饱和但不刺眼，以明亮蓝色、青绿色、暖金色形成鲜明冷暖对比，颜色干净统一，减少灰脏和杂色。采用电影级环境光照，强烈但柔和的主光源，体积光、环境光、轮廓光、柔和反射光共同塑造空间，具有明显的阳光穿透、空气透视、光晕和柔和Bloom效果。阴影柔软，明暗过渡自然，接触阴影清晰但不过重。画面具有明显的前景、中景、背景空间层次，主体突出，背景适度虚化，具有电影镜头般的景深和空间纵深。构图动态、叙事性强，主体比例较大，视觉中心明确，画面充满冒险、探索、欢乐和奇幻氛围。整体效果类似顶级欧美休闲手游宣传图、3D卡通游戏Key Visual，精致、干净、明亮、立体、丰富但不杂乱，高完成度商业游戏原画。"], "inputs": [{"widget": {"name": "action"}, "name": "action", "type": "COMBO", "localized_name": "操作"}, {"widget": {"name": "tidy_tags"}, "name": "tidy_tags", "type": "COMBO", "localized_name": "整理词条"}, {"widget": {"name": "text_a"}, "shape": 7, "name": "text_a", "link": 61, "type": "STRING", "localized_name": "文本_A"}, {"widget": {"name": "text_b"}, "shape": 7, "name": "text_b", "link": 62, "type": "STRING", "localized_name": "文本_B"}, {"widget": {"name": "text_c"}, "shape": 7, "name": "text_c", "link": 64, "type": "STRING", "localized_name": "文本_C"}], "flags": {"collapsed": true}, "id": 50, "type": "StringFunction|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "StringFunction|pysssss"}, "order": 19}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [], "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [270, 290.0000305175781], "pos": [2346.321533203125, 325.9216003417969], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 24, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 23, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 32}, {"mode": 0, "outputs": [{"name": "IMAGE", "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [521.9054565429688, 344.7996520996094], "pos": [1980.0596923828125, 625.3859252929688], "widgets_values": ["checkerboard"], "inputs": [{"name": "imageA", "link": 69, "label": "图像A", "type": "IMAGE", "localized_name": "imageA"}, {"name": "imageB", "link": 70, "label": "图像B", "type": "IMAGE", "localized_name": "imageB"}, {"widget":