 {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 16, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 4}, {"mode": 0, "outputs": [{"name": "string", "links": [8], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [501.97601318359375, 853.8548583984375], "widgets_values": ["高度3.5-4厘米，直径2厘米左右。益生菌瓶子里装的是粉状物（白色掺杂少许红色粉末状），可以干嚼也可以冲泡喝。冲泡之后是粉色。打开方式，不是旋转，**完全分离的直拔盖**，既不用旋转拧开，也不是连在瓶身上的翻盖，盖子和瓶身是彻底分开的，直接垂直往上一拔就能打开；开盖后瓶口还有一层铝箔封口膜，撕掉就可以用。功能是平衡肠道菌群，提高蛋白质的消化吸收。适用人群以便秘、减肥、体重管理人群为主。冲泡后颜色没这么粉，应该是透明状态带一点粉。封口膜最下面字：SYHL晟元活力"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 3, "type": "Text", "title": "产品信息", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "string", "links": [20], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [370.7315368652344, 93.66455078125], "pos": [503.28253173828125, 670.69775390625], "widgets_values": ["产品信息="], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 17, "type": "Text", "title": "产品信息", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 6}, {"mode": 0, "outputs": [{"name": "string", "links": [10], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [525.6351928710938, 416.0007629394531], "widgets_values": ["# 道具排版解析引擎\n## 全局规范\n16:9横向构图，纯白色背景，严谨工业设定图风格；输入产品信息100%对应落地，缺失细节按产品品类合理推演补全，禁止版面留空。\n\n## 版面布局（移除右侧信息面板、底部尺寸比例参考，最大化产品主体展示）\n### 左侧主视觉区（约占画面横向2/3，核心放大区域）\n- 上半段：居中绘制**超大完整产品主视觉图**，占本区约70%高度，为全画面第一视觉重心；精准呈现外形轮廓、主体结构、表面材质、色彩层次与核心识别特征，所有细节严格匹配产品描述。\n- 下半段：固定标题「设计细节 (Design Details)」，标题下方排列两排共4-6个方形网格，每个网格展示一处产品微距局部特写，配对应简短文字标签，覆盖材质纹理、按键接口、纹路工艺、核心构件、边缘处理等关键细节。\n\n### 右侧视图结构区（约占画面横向1/3）\n- 上半段：自左向右等大排列正视图、左侧视图、背视图标准三视图，视图的形状、比例、颜色、材质、组件位置完全一致，正交展示无夸张透视，清晰呈现整体造型比例。\n- 下半段：绘制产品结构拆解/功能原理示意图，包含零件分层、模块连接、可动结构、能量流向或使用状态示意；未明确结构时，根据产品类型补充合理的内部/组件逻辑。\n\n### 底部通栏区（横跨画面底部，均分为两部分）\n- 左侧：产品典型使用场景示意图，以产品为绝对视觉中心，背景极简虚化，不抢夺主体注意力。\n- 右侧：产品不同状态对比展示（如开合、充能、生熟、启停、变形前后等）；无多形态的产品可替换为补充视角展示。\n\n## 全局规则\n产品本体始终为画面第一视觉核心，全图比例统一，材质表现精准；补全内容不与输入信息冲突，无复杂背景、板块错位、核心信息遗漏。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 1, "type": "Text", "title": "布局设置", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 7}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [-294.9185429382508, -374.7553191866854], "scale": 1.7088742511245885}}, "groups": [], "links": [[8, 3, 0, 4, 3, "STRING"], [10, 1, 0, 4, 1, "STRING"], [12, 4, 0, 11, 11, "STRING"], [13, 11, 0, 6, 0, "IMAGE"], [15, 12, 0, 11, 0, "IMAGE"], [16, 13, 0, 11, 1, "IMAGE"], [17, 14, 0, 11, 2, "IMAGE"], [18, 15, 0, 11, 3, "IMAGE"], [19, 16, 0, 11, 4, "IMAGE"], [20, 17, 0, 4, 2, "STRING"]], "id": "d0ba3dee-d917-4cb4-b2c8-6bef6f2f450c", "config": {}, "version": 0.4, "last_node_id": 17, "revision": 0}