{"last_link_id": 2109, "nodes": [{"mode": 0, "outputs": [{"name": "output", "links": [2086], "type": "*", "localized_name": "output"}], "size": [401.244140625, 200.16275024414062], "pos": [-2771.756591796875, 2949.409423828125], "widgets_values": ["这是一幅描绘古代中国城市广场的数字渲染图，画面中心是一座宏伟的多层城楼，其主体由灰色石砖砌成，顶部覆盖着鲜红色的木质飞檐和屋脊，结构对称，层次分明。城楼正面有多个拱形门洞，门洞内隐约可见远处的山峦和人物。城楼两侧有附属建筑，屋顶同样为红色飞檐，与主楼风格统一。\n\n广场地面由巨大的浅灰色石板铺成，石板表面有清晰的纹理和自然的磨损痕迹，阳光照射下，投射出城楼和遮阳伞的长长阴影，形成明暗交错的视觉效果。广场左侧设有一个摊位，配有茅草遮阳伞，伞下摆放着一张铺有条纹布的木桌，旁边站着一位身穿蓝色长袍、头戴高冠的男子，似乎在与顾客交谈或整理货物。他身旁站着两位穿着白色长袍、腰系深色腰带的男子，衣着考究，可能为商人或官员。\n\n广场右侧也有摊位和人群，人们穿着各式古代服饰，有的在交谈，有的在行走，营造出繁忙的市集氛围。远处的城楼后方，隐约可见山峦起伏，天空湛蓝，点缀着几朵白云，整体画面明亮开阔，充满历史感和生活气息。整个场景呈现出中国古代城市繁华的市井景象，细节丰富，色彩鲜明，具有强烈的视觉冲击力。"], "inputs": [{"shape": 7, "name": "anything", "link": 2053, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 786, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 28}, {"outputs": [{"name": "*", "label": "输出", "type": "*"}], "color": "#432", "widgets_values": ["clip加载"], "inputs": [{"name": "CLIP", "link": 2054, "type": "CLIP"}], "flags": {}, "type": "SetNode", "mode": 0, "bgcolor": "#653", "size": [210, 58], "pos": [-1767.18212890625, 2170.576171875], "id": 787, "properties": {"previousName": "", "widget_ue_connectable": {}}, "order": 18}, {"outputs": [{"name": "*", "label": "输出", "type": "*"}], "color": "#322", "widgets_values": ["vae加载"], "inputs": [{"name": "VAE", "link": 2055, "type": "VAE"}], "flags": {}, "type": "SetNode", "mode": 0, "bgcolor": "#533", "size": [210, 58], "pos": [-1760.953125, 1889.69921875], "id": 788, "properties": {"previousName": "", "widget_ue_connectable": {}}, "order": 26}, {"mode": 0, "outputs": [{"name": "CLIP", "slot_index": 0, "links": [2054], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [330, 110], "pos": [-1766.86767578125, 2007.126220703125], "widgets_values": ["qwen_2.5_vl_7b_fp8_scaled.safetensors", "qwen_ima