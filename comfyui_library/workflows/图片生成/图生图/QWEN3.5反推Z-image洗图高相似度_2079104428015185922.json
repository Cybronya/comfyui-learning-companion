e": "presence_penalty"}, {"widget": {"name": "mirostat_mode"}, "name": "mirostat_mode", "label": "mirostat_mode", "type": "INT", "localized_name": "mirostat_mode"}, {"widget": {"name": "mirostat_eta"}, "name": "mirostat_eta", "label": "mirostat_eta", "type": "FLOAT", "localized_name": "mirostat_eta"}, {"widget": {"name": "mirostat_tau"}, "name": "mirostat_tau", "label": "mirostat_tau", "type": "FLOAT", "localized_name": "mirostat_tau"}, {"widget": {"name": "state_uid"}, "name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "flags": {}, "id": 90, "type": "llama_cpp_parameters", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "widget_ue_connectable": {}, "aux_id": "lihaoyun6/ComfyUI-llama-cpp_vlm", "Node name for S&R": "llama_cpp_parameters"}, "order": 7}, {"outputs": [{"name": "STRING", "links": [131], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#233", "widgets_values": ["一个穿着无肩带深v白色抹胸套装短裙的极品高颜值亚洲女性"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "简短提示词", "mode": 0, "bgcolor": "#355", "size": [400, 200], "pos": [-1479.8387451171875, -427.68597412109375], "id": 91, "properties": {"cnr_id": "comfy-core", "ver": "0.24.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 8}, {"mode": 0, "outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "output"}], "size": [402.78863525390625, 463.46417236328125], "pos": [-71.54021453857422, -353.0971984863281], "widgets_values": ["**主体描述**\n画面中心站立着一位极具吸引力的年轻亚洲女性，她拥有精致的五官和鹅蛋脸，皮肤白皙透亮，妆容干净自然，突出清透感。她留着一头乌黑柔顺的长卷发，自然垂落在肩头和背部。她身穿一套设计大胆的纯白色无肩带深V领抹胸套装，上身是修身的吊带背心，紧紧包裹着身体曲线，展现出锁骨和肩部线条；下身是一条极短的超短裙，裙长仅至大腿中部，面料带有微妙的珠光或缎面光泽，在光线下呈现柔和的渐变色泽，从颈部的淡粉色渐变至裙摆的暖金色。\n\n**前景与中景**\n人物位于画面的中景位置，身体微微侧向镜头，左手轻轻扶着一个白色的长方形展示台或立柱的边缘。她的姿态优雅而自信，眼神直视前方，流露出一种冷静而迷人的气质。前景中，除了她手扶的白色物体外，左侧隐约可见黑色支架的一部分，增加了画面的层次感。\n\n**背景与环境**\n背景设定在一个现代简约的室内空间，可能是一个美术馆、画廊或高端时尚秀场。后方是一面浅灰色的墙壁，墙上整齐地悬挂着多幅小型画作或摄影作品，呈现出一种艺术画廊的氛围。地面是浅色的木地板或瓷砖，反射着柔和的光线。背景中还可见黑色的隔离带立柱，进一步强化了活动或展览的场景感。\n\n**构图与视觉引导**\n构图上采用了经典的中景人像布局，人物占据画面主要部分，背景留白适度，突出了主体。视觉引导线通过人物的视线方向、身体的倾斜角度以及扶手的线条，将观众的注意力牢牢锁定在她的面部表情和上半身的轮廓上。背景的垂直线条（画作、立柱）与人物的垂直线条相呼应，增强了画面的稳定性。\n\n**光影与氛围**\n整体光线明亮而柔和，属于典型的室内柔光环境，光源似乎来自人物的前方偏上方，均匀地照亮了她的面部和服装，没有产生强烈的阴影，使得皮肤看起来通透无瑕。服装上的光泽感被光线巧妙捕捉，增添了高级质感。整体氛围既专业又带有一丝日常的随性，仿佛是在一场时尚活动间隙抓拍的瞬间，充满了现代都市的时尚气息和静谧的美感。\n\n**提示词**\n专业人像摄影，一位极品高颜值年轻亚洲女性，身穿白色无肩带深V抹胸上衣和超短裙套装，长卷发，白皙皮肤，精致五官，眼神自信直视镜头，站在现代画廊或时尚秀场环境中，背景有挂画和隔离带，左手扶白色展示台，柔和的室内顶光，清晰的肤质细节，服装呈现细腻的珠光缎面质感，中景构图，现代都市时尚氛围，高分辨率，8k，佳能EOS R5拍摄，色彩还原准确，细节丰富。"], "inputs": [{"shape": 7, "name": "anything", "link": 134, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 55, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 17}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [556.3636474609375, 647.272705078125], "pos": [-871.7548217773438, 257.08203125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 10, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 10, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 22}, {"mode": 