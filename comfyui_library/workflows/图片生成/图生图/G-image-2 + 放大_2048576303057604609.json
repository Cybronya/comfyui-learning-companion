视屏幕的光洁与内容细腻、地毯的柔软织物纹理以及木质支架的温润感都得到充分展现。通过连接线与电视的关联，以及地毯上的“4K”字样，直观传达产品支持超高清传输、提供沉浸式视觉盛宴的核心卖点，整体画面简洁大气，充满现代科技感与专业级品质。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "JjkText", "mode": 0, "bgcolor": "#353", "size": [474.5360412597656, 276.4720458984375], "pos": [-573.9632568359375, -137.91844177246094], "id": 2, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 13}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1264.5656986945773, 508.90491582748535], "scale": 0.7972024500000027}}, "groups": [{"color": "#3f789e", "font_size": 100, "flags": {}, "id": 1, "title": "G-image-2-文生图", "bounding": [-619.787109375, -355.89422607421875, 1718.5897216796875, 798.4606323242188]}, {"color": "#3f789e", "font_size": 100, "flags": {}, "id": 2, "title": "G-image-2-图生图-官方4K", "bounding": [-618.5049438476562, 476.2466125488281, 1818.1917724609375, 960.2913208007812]}, {"color": "#3f789e", "font_size": 100, "flags": {}, "id": 3, "title": "G-image-2-图生图-低价", "bounding": [1256.623291015625, 476.5710144042969, 1818.1917724609375, 960.2913208007812]}, {"color": "#3f789e", "font_size": 100, "flags": {}, "id": 4, "title": "Z-image-放大", "bounding": [-616.7387084960938, 1516.7796630859375, 3674.061279296875, 1263.567138671875]}], "links": [[4, 6, 0, 5, 0, "IMAGE"], [6, 5, 0, 8, 0, "IMAGE"], [7, 6, 0, 9, 0, "IMAGE"], [8, 5, 0, 9, 1, "IMAGE"], [9, 10, 0, 5, 1, "IMAGE"], [10, 2, 0, 12, 1, "STRING"], [11, 12, 0, 4, 0, "IMAGE"], [12, 13, 0, 11, 0, "IMAGE"], [13, 14, 0, 11, 1, "IMAGE"], [14, 11, 0, 15, 0, "IMAGE"], [15, 13, 0, 16, 0, "IMAGE"], [16, 11, 0, 16, 1, "IMAGE"], [17, 35, 0, 21, 0, "*"], [18, 21, 0, 22, 0, "IMAGE"], [19, 22, 0, 23, 0, "*"], [20, 22, 1, 24, 0, "*"], [21, 21, 0, 25, 0, "IMAGE"], [22, 22, 0, 25, 1, "INT"], [23, 22, 1, 25, 2, "INT"], [24, 25, 0, 26, 0, "IMAGE"], [25, 27, 0, 26, 1, "INT"], [26, 27, 1, 