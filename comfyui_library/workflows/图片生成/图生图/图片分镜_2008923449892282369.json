able": {}, "version": "7.5.2"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "INTConstant"}, "order": 3}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [267], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [520.1283569335938, 233.12045288085938], "pos": [6400, 14580], "widgets_values": ["Next Scene：(特写) 身穿白色运动背心与高腰短裤的黑发女子，微微侧身凝视镜头，汗水在肌肤上闪烁，双手自然垂落，位于健身房中央，摄影机位为低角度仰拍，阳光从侧窗斜射，营造温暖而专注的氛围  \nNext Scene：(中景) 她缓缓转身，右手轻触肩带调整姿势，左腿微屈，站在跑步机旁，摄影机位为平视中景，柔和的自然光透过玻璃窗洒在地面，勾勒出她修长的腿部线条与运动服的褶皱细节  \nNext Scene：(全景) 她迈步向器械区走去，步伐轻盈，长发随动作自然飘动，背景中哑铃架与力量训练设备清晰可见，摄影机位为后方跟拍全景，整体色调偏冷灰，光线由窗外投射形成明暗对比  \nNext Scene：(俯拍) 她蹲下身，双手扶膝调整呼吸，汗水在大腿外侧凝结成晶莹水珠，摄影机位为高角度俯拍，地面反光映出她专注的侧影，环境光影由顶部射灯与窗光交织，强化运动后的疲惫与力量感  \nNext Scene：(特写) 她抬手轻抚额前发丝，眼神坚定望向前方，汗水顺着锁骨滑落，摄影机位为肩部特写，逆光勾勒出面部轮廓，背景虚化处理，突出皮肤质感与运动后微喘的呼吸节奏  \nNext Scene：(中景) 她转身背对镜头，双手叉腰，微微挺胸展示运动后紧致的腰腹线条，摄影机位为后侧45度中景，暖色光从背后打亮，形成剪影与半透明肌肤的对比，环境安静而充满张力  \nNext Scene：(全景) 她走向镜子前，双手轻抚运动服边缘，镜面反射出她清晰的倒影，摄影机位为镜前对称全景，光线由两侧灯带均匀分布，营造冷静的自我审视氛围，背景器械模糊处理  \nNext Scene：(俯拍) 她单膝跪地，双手撑地调整短裤下摆，汗水在膝盖与小腿处形成光斑，摄影机位为高角度俯拍，地面阴影拉长，光线从侧面斜射，强调身体线条与运动后的疲惫与坚持并存的瞬间"], "inputs": [{"name": "text", "link": 300, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 208, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 19}, {"mode": 0, "outputs": [{"name": "LATENT", "slot_index": 0, "links": [245], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [300, 474], "pos": [8260, 13180], "widgets_values": [938076916389870, "randomize", 6, 1, "euler_ancestral", "simple", 1], "inputs": [{"name": "model", "link": 247, "label": "model", "type": "MODEL", "localized_name": "model"}, {"name": "positive", "link": 248, "label": "positive", "type": "