": "LoadImage", "mode": 4, "bgcolor": "rgba(24,24,27,.9)", "size": [220, 500], "pos": [-350, -5460], "id": 14, "properties": {"cnr_id": "comfy-core", "ver": "0.19.3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 4}, {"outputs": [{"name": "IMAGE", "links": [17], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#346434", "widgets_values": ["0006.视-12s-0001.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 4, "bgcolor": "rgba(24,24,27,.9)", "size": [220, 500], "pos": [-120, -5460], "id": 15, "properties": {"cnr_id": "comfy-core", "ver": "0.19.3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 5}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#006691", "widgets_values": ["这是一张极高清晰度的商业人像摄影作品，采用中焦段镜头拍摄，具有典型的棚拍质感。画面光影系统由大型柔光箱构成，主光源位于人物斜前方，呈现出极其细腻的漫射光质，在皮肤表面形成平滑的高光过渡，阴影部分极浅且带有微弱的环境补光，整体色调偏向冷白皮的纯净感，背景为深灰色无缝纸，营造出极致的空间纵深与虚化效果。\n\n人物是一名拥有精致五官的亚洲女性，发型为深棕色长直发，顶部带有自然的光泽高光，发丝垂落在肩头，质感顺滑。面部妆容极其细腻：眼影呈现淡雅的肉粉色晕染，睫毛浓密且呈自然的弧度弯曲，瞳孔在柔光下显得清澈明亮，鼻梁挺直，嘴唇涂抹着带有水光感的裸粉色唇釉，人中线条清晰。皮肤呈现出冷白色的细腻质感，几乎看不见毛孔，展现出极高的摄影解析度。体型比例匀称，腰部纤细，双腿修长。\n\n她穿着一件极具设计感的黑色单肩紧身连衣裙，材质为带有微弱光泽的弹性纤维，紧贴身体曲线，在胸部与腰部产生自然的褶皱阴影。领口处有一条黑色的细带连接至肩部，增加了视觉层次感。由于衣物极其贴身，胸部的轮廓被清晰勾勒，呈现出饱满且圆润的形态。她侧身倚靠在黑色木质长桌边缘，左手自然撑在桌面，手指纤长，指甲修剪整齐，身体重心略微向后倾斜，展现出一种优雅而带有轻微挑衅感的姿态。\n\n构图采用中景全身构图，视觉焦点精准锁定在人物的面部与眼神，通过黑色桌面的线条引导观众视线从左下角移向人物中心。整体氛围呈现出一种高级感十足的商业时尚诱惑，既有专业摄影的克制美感，又蕴含着极强的感官张力。\n\n相机参数参考：Sony A7R5, FE 85mm f/1.4 GM, f/2.8, 1/200s, ISO 100。画面无水印。"], "inputs": [{"shape": 7, "name": "anything", "link": 12, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [470, 680], "pos": [510, -6250], "id": 5, "properties": {"cnr_id": "comfyui-easy-use", "ver": "ec4ca6717f539a8b8c48fa88645045846ca47669", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 16}, {"outputs": [{"name": "text", "links": [26], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#346434", "widgets_values": ["详细分析这三张图片的不同"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "文本", "mode": 4, "bgcolor": "rgba(24,24,27,.9)", "size": [680, 330], "pos": [-580, -4920], "id": 31, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 6}, {"outputs": [{"name": "text", "links": [27], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#346434", "widgets_values": ["描述这个图片，输出为中文提示词，不超过100字"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "文本", "mode": 0, "bgcolor": "rgba(24,24,27,.9)", "size": [340, 190], "pos": [-250, -5760], "id": 6, "properties": {"cnr_id": "ComfyUI_Comfyroll_Cus