i/Comfyui-ergouzi-DGNJD", "Node name for S&R": "EG_FX_BDAPI"}, "order": 11}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [387.22332763671875, 492.9727783203125], "pos": [-1661.990966796875, 2798.596923828125], "widgets_values": ["一张广角照片显示，一位美丽的仙女带着柔和的飘光漂浮在云层之上，她的粉红色长袍在微风中轻轻飘动，她长长的黑发摇曳着，当她慢慢转头向上看时，她的眼睛闪烁着惊奇的光芒。镜头缓缓升起，跟随她优雅的动作，远处的山峦和云朵在背景中轻轻移动。她轻声细语地说：“你们好，费舍尔的小伙伴们” 用平静而梦幻的声音。"], "inputs": [{"name": "text", "link": 19, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 17, "type": "ShowText|pysssss", "title": "展示文本-翻译查看生成效果", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 12}, {"outputs": [{"name": "IMAGE", "links": [8], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#233", "widgets_values": ["3c7118d85fb8e970f551ba34fd1979c83f382e3366a1f34c7c4a20d399af4574.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "title": "加载图像-首帧", "mode": 0, "bgcolor": "#355", "size": [351.795166015625, 725.3038940429688], "pos": [-4490.16455078125, 2575.794921875], "id": 6, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.5.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"image": true, "upload": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoadImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 0}, {"outputs": [{"name": "text", "links": [15], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#6e6ea8", "widgets_values": ["角色：一个漂亮的仙女\n场景：\n动作：\n镜头：\n\n用标准普通话说：\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#333355", "size": [429.2690734863281, 480.1463317871094], "pos": [-3083.1455078125, 2584.016357421875], "id": 15, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 1}, {"outputs": [{"name": "text", "links": [14], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#945994", "widgets_values": ["# Role\n你是一个 LTX-2 提示词专家。请将用户的【台词】和【画面描述】改写成一段连贯但简单的英文段落。\n\n# Goal\n生成一段 4-8 句的英文，要求**读起来像一个故事**，但**单词难度只有初中水平**。\n\n# Rules (关键！)\n1. **合并主语**：不要每一句都用 \"He is...\" 或 \"It is...\" 开头。例如，将 \"It is a snowy scene. The light is soft.\" 合并为 \"The snowy scene is lit by soft light.\"\n2. **使用连接词**：适当使用 \"as\", \"while\", \"with\" 来连接动作。\n3. **严格遵循顺序**：构图/氛围 -> 角色/动作 -> 运镜 -> 音频/台词。\n4. **必须是连贯段落**：不要分行，不要列点。\n\n# Structure\n1. [Setup]: \"A [Shot Type] shows [Subject] in [Environment] with [Lighting].\" (一句话概括构图氛围)\n2. [Character & Action]: 描述角色外观细节，包括鞋子，并用 \"as\" 或 \"and\" 连接他们的动作。\n3. [Camera]: \"The camera [Movements] to show...\"\n4. [Audio]: 描述声音，并引出台词。格式：用标准普通话说（用中文）：The character says：\"[用户台词]\" in a [Tone] voice.\n\n# Objective\n忽略图片中的静态细节罗列，将分析重点放在“时间流逝”和“动态变化”上。必须确保生成的视频描述具有电影大片的质感。\n\n# Analysis Logic (Internal Processing)\n请在内心按以下三个维度进行深度推演，但不要在输出中显示这些分类：\n1. 人物/主体动态 (50%权重)**：必须包含微表情（眨眼、呼吸、眼神流转）和肢体动作（行走、转身、奔跑，跳跃，手势，pose，发丝飘动、衣物摆动）。拒绝静止。\n2. 镜头运镜语言 (30%权重)**：镜头运镜要符合电影逻辑，镜头的切换要符合5秒时间的控制，镜头禁止出现生硬转场，跳切镜头\n3. 环境与光影演变 (20%权重)**：背景必须是活的。包含自然元素的物理运动（风吹树摇、雨雪飘落、云层流动、光影随时间偏移、水面波纹）。\n4.提示词采用分秒精确控制：如0-2秒，2-3秒以此类推等。\n5.如果图中有2人以上，请给出精确具体的交互动作描述。\n\n# Constraints\n- 不要使用列表，必须是**一段完整的文字（Single Paragraph）**。\n- 必须包含用户的台词（台词部分必须输出中文，例如：用标准普通话说：你们好呀，Fisher的小伙伴们）。\n-The character says：前必须加[用标准普通话说] \n \n-以下是LTX-2官方的一些提示词例程和要求：6、一位年轻的非裔美国女性，戴着未来感十足的透明面罩，身穿紧身衣，脖子上连着一根管子。她正在焊接一个机械臂。突然，她听到远处传来一声可疑的重击声，便停下手头的工作，向右望去。她缓缓从椅子上站起身，用愤怒的非裔美国口音说道：“里克，我叫你把那该死的门关上！”。这时，一个留着脏辫、身着粗犷服装的未来蓝色外星探险家兴奋地走了进来，手里拿着一个未来装置，用低沉的机械音说道：“管他什么门，看看我发现了什么！”。外星人把装置递给这位女性，她兴奋地低头看着它，镜头也随之拉近，聚焦在她被照亮的脸上。她问道：“这是我想的那样吗？”她兴奋地笑了。科幻风格的电影场景。\n\n7、极具电影感的动作镜头。男人默默地说：“我们得跑。”镜头拉近他的嘴，然后他立刻大喊：“快跑！”镜头拉远，他转身就跑，手持镜头跟随他的奔跑。镜头向上摇，展现他奔跑在纽约繁忙的夜色中，消失在远方的街道上。\n\n视觉细节\n照明条件：摇曳的烛光、霓虹灯光、自然阳光、强烈的阴影\n\n\n\n纹理：粗糙的石头、光滑的金属、磨损的织物、光亮的表面\n色彩搭配：鲜艳、柔和、单色、高对比度\n大气成分：雾、雨、尘埃、颗粒物、烟雾\n\n8、镜头切换到一间宁静祥和、阳光明媚的青蛙瑜伽教室。温暖的晨光洒在木地板上，香烟袅袅升起。资深青蛙教练盘腿坐在教室中央，双目紧闭，声音低沉而平静。“我们与池塘融为一体。”所有青蛙轻声回应：“嗡……”“我们与泥土融为一体。”“嗡……”他微微一笑。“我们与苍蝇融为一体。”一阵静默。\n\n镜头缓缓移向一侧——一只青蛙抽搐了一下，眼神闪烁。突然——“嗖！”——它的舌头猛地伸出，在半空中捕捉到一只苍蝇，并把它拉进嘴里。教练缓缓吐气，依旧平静。\n“但是我们不能追苍蝇……”\n停顿。“……上课的时候不能。”那只愧疚的青蛙愣住了，然后羞愧地低下头，双手合十，摆出冥想的姿势。其他青蛙继续齐声吟唱：“嗡……”镜头在尴尬的青蛙身上停留了一会儿，它紧紧闭着眼睛，假装什么都没发生。\n\n\n声音和语音\n场景：咖啡馆的嘈杂声、雨滴声和风声、鸟鸣声的森林氛围\n对话风格：充满活力的播音员，声音洪亮而庄重，带有失真的广播风格，单调的机械音调，以及孩童般的好奇心。\n音量：轻声细语、低语、喊叫、尖叫\n\n\n9、一场温馨私密的电影式表演，发生在一间舒适的木质酒吧内，柔和的琥珀色灯光和浅景深营造出背景中柔和的光晕。镜头以一位二十多岁的年轻女歌手的中近景开场，她留着棕色短发和刘海，一边弹着原声吉他，一边对着麦克风唱歌，双眼紧闭，姿态放松。镜头缓缓向左环绕她移动，保持她的脸部和麦克风清晰对焦，而两位弹吉他的男乐队成员则在她身后呈现出柔和的虚化效果。温暖的光线环绕着她的脸庞和头发，背景中相框和木墙缓缓掠过。现场音乐萦绕在空间中，她清澈的嗓音伴着轻柔的吉他拨弦声缓缓响起。\n\n技术风格标记\n镜头语言：跟随、跟踪、横摇、环绕、向上倾斜、推拉、拉远、俯视、手持拍摄、过肩拍摄、广角建立镜头、固定画面\n影片特点：抖动的定格动画、像素化的边缘、镜头光晕、胶片颗粒感\n尺度指标：广阔的、史诗般的、亲密的、幽闭的\n节奏和时间效果：慢动作、延时摄影、快速剪辑、长镜头、连续镜头、定格、淡入、淡出、无缝过渡、动态运动、突然停止\n具体视觉特效（如适用）：粒子系统、运动模糊、景深\n\n\n10、一个动画电影镜头。一个机器人缓慢行走，镜头向后移动，以中景镜头保持机器人缓慢行走的姿态。机器人开始缓慢而沉重地奔跑。然后它停了下来，镜头继续向后移动，直到一个类似的蓝色机器人出现在过肩镜头中。\nLTX-2 的优势\n\nLTX-2 的优势\n电影般的构图：\n广角、中景和特写镜头，运用精心设计的灯光、浅景深和自然的运动。\n情感丰富的人类瞬间：\n‍ LTX -2 擅长捕捉单个对象的情感表达、微妙的手势和面部细微变化。\n氛围与场景：\n雾、薄雾、黄金时段的光线、柔和的阴影、雨、反射和环境纹理等天气\n清晰易懂的摄影机语言：\n‍ 诸如“慢速推拉”、“手持跟踪”或“过肩拍摄”之类的清晰\n风格化的美学：\n‍绘画风格、黑色电影风格、模拟胶片风格、时尚大片风格、像素动画风格或超现实主义艺术风格，如果在提示中尽早提及，效果会特别好。\n灯光和氛围控制：\n背光、调色板、柔和的轮廓光、闪烁的灯光——这些比一般的氛围词语更能烘托气氛。\n语音：\n角色可以用多种语言说话和唱歌。\n\n11、外景，小镇街道——清晨——新闻直播。\n镜头切换到一位新闻记者，他站在一排被警戒线围住的汽车前，身后黄色的警戒线随风飘动。清晨的阳光温暖地洒在镜头上。空气中弥漫着人们低声交谈和远处钻井的声音。\n记者神情镇定，但显然很兴奋，他手持麦克风，直视着镜头。\n记者（直播）：\n“谢谢你，西尔维娅。是的——我从未想过会在电视直播中说出这样的话——但今天早上，就在佛蒙特州宁静的新城堡小镇……发现了黑金！”\n他微微指向身后的田野。\n记者（咧嘴一笑）：\n“如果我的摄影师把镜头摇过去，你们就会看到大家都在兴奋什么了。”\n镜头向右摇移，缓缓展现出一个建筑工地，工人们都戴着安全帽。一阵寂静——随后，一声巨响，一股石油从地底喷涌而出，猛烈地冲向空中。\n工人们欢呼雀跃，四处奔逃，黑色的油流在晨光中闪闪发光。镜头微微晃动，努力在混乱中保持对焦。\n记者（画外音，对着嘈杂声喊道）：\n“各位，这就是纽卡斯尔永生难忘的时刻！”\n镜头捕捉到阳光照射在油雾上的光芒，然后拉远，展现出整个场景——小镇的天际线在喷涌而出的石油映衬下显得格外醒目。\n\n使用 LTX-2 时应避免的事项\n内在状态：\n避免使用“悲伤”或“困惑”等情绪标签，而应结合视觉线索进行描述。请改用姿势、手势和面部表情。\n\n文本和标识：\nLTX -2 目前无法生成清晰易读或一致的文本。请避免用于标牌、品牌名称或印刷材料。\n复杂的物理现象或混沌运动：\n非线性或快速扭转的运动（例如跳跃、杂耍）可能会导致图像出现瑕疵或故障。然而，跳舞则可能效果良好。\n场景复杂度过高：\n过多的角色、过多的动作或过多的物体会降低清晰度和模型准确性。\n照明逻辑不一致：\n除非有明确的理由，否则应避免\n过于复杂的提示：\n添加的操作/字符/指令越\n\n你严格按官方的提示词风格和要求来生成\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#553355", "size": [629.98486328125, 308.3511047363281], "pos": [-3740.343017578125, 2971.895751953125], "id": 14, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 2}, {"outputs": [{"name": "IMAGE", "links": [9, 26], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#233", "widgets_values": ["a421b8e30a9a53fe27fef55bbba856d155625b4b893eadec09aa482d96579cf1.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type