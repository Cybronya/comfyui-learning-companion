e\": [\n      \"橙色猫用筷子夹起一片肉，放入火锅中，然后用筷子夹起肉片，送入口中。\",\n      \"老虎用筷子夹起一片肉，放入火锅中，然后用筷子夹起肉片，送入口中。\",\n      \"两只动物同时用筷子夹起肉片，放入火锅中，然后用筷子夹起肉片，送入口中。\",\n      \"橙色猫和老虎同时用筷子夹起肉片，放入火锅中，然后用筷子夹起肉片，送入口中。\",\n      \"橙色猫和老虎同时用筷子夹起肉片，放入火锅中，然后用筷子夹起肉片，送入口中。\"\n    ]\n  },\n  \"cinematography\": {\n    \"lighting\": \"柔和的暖色灯光，来自餐桌上方的吊灯和背景的自然光，营造温馨、舒适的氛围。\",\n    \"tone\": \"幽默、温馨、略带荒诞，通过动物角色的拟人化动作和场景布置，营造轻松愉快的氛围。\"\n  }\n}"], "inputs": [{"name": "clip", "link": 17, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 99, "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [510, 590], "pos": [-371.0098571777344, -1251.864501953125], "id": 12, "properties": {"cnr_id": "comfy-core", "ver": "0.3.45", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 21}, {"mode": 0, "outputs": [{"name": "Filenames", "label": "文件名", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "size": [210, 709.7777709960938], "pos": [2908.888671875, -444.4533996582031], "widgets_values": {"save_output": true, "filename_prefix": "HLAI", "loop_count": 0, "pix_fmt": "yuv420p", "save_metadata": true, "crf": 19, "trim_to_audio": false, "videopreview": {"paused": false, "hidden": false, "params": {"score": "0", "filename": "HLAI_00001_p80_ylidq_1779515794.mp4", "cos_url": "https://rh-images-1252422369.cos.ap-beijing.myqcloud.com//29382663f7eacc0fe9f1e40749915f8c/output/HLAI_00001_p80_ylidq_1779515794.mp4", "workflow": "HLAI_00001_p80.png", "fullpath": "/data/ComfyUI/personal/29382663f7eacc0fe9f1e40749915f8c/output/HLAI_00001_p80.mp4", "format": "video/h264-mp4", "subfolder": "", "label": "Normal", "type": "output", "frame_rate": 16}}, "format": "video/h264-mp4", "no_preview": false, "frame_rate": 16, "pingpong": false}, "inputs": [{"name": "images", "l