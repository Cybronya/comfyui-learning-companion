两个字，表示用户可以选择跳过当前广告。\n\n整体设计风格优雅，色彩搭配柔和，给人一种高端、舒适的感觉。"], "inputs": [{"name": "text", "link": 2, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 4, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [270, 58], "pos": [1440.0477294921875, 261.3760986328125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 3, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 5, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [1, 3], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [468, 179], "widgets_values": ["bb63bfb99884d5f2791728e2fc0702b796a14b1175810a6983fbbf5a39d9b171.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 1, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 0}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-243.04778512396655, 83.62388429752079], "scale": 1}}, "groups": [], "links": [[1, 1, 0, 3, 0, "IMAGE"], [2, 3, 0, 4, 0, "STRING"], [3, 1, 0, 5, 0, "IMAGE"]], "id": "0e3071ee-8a2d-4692-bb58-a46a8f129a12", "config": {}, "version": 0.4, "last_