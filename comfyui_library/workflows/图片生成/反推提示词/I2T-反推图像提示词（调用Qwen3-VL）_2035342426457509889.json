室内照明系统——包括天花板射灯、墙边立式灯具以及镜子映照光源共同作用形成温暖均匀分布的效果，使人物面部轮廓清晰且富有立体层次感，同时地面地毯呈现淡棕色调衬托整个空间舒适氛围。相机视角从稍高位置向下拍摄营造亲切互动之感。", [false, true]], "inputs": [{"name": "text", "link": 25, "label": "文本", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "PreviewTextNode", "mode": 0, "bgcolor": "#355", "size": [347.7359619140625, 375.1911315917969], "pos": [-5041.84521484375, 654.6369018554688], "id": 8, "properties": {"cnr_id": "comfyui_custom_nodes_alekpet", "ver": "1.0.74", "widget_ue_connectable": {}, "Node name for S&R": "PreviewTextNode"}, "order": 3}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "遮罩", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}, {"name": "原始大小", "label": "原始大小", "type": "BOX", "localized_name": "原始大小"}, {"name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"name": "text", "links": [25], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#2a363b", "widgets_values": ["ComfyUI", "#000000", "original", 1, 1, "crop", "lanczos", "8", "longest", 1024, "Qwen3-VL-4B-Instruct", "None (FP16)", "Describe this image in detail.", "", 512, true, 60360755047809, "randomize"], "inputs": [{"name": "图像", "link": 26, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "LayerUtility: ImageScaleByAspectRatio V2 image", "link": 27, "label": "LayerUtility: ImageScaleByAspectRatio V2 image", "type": "IMAGE", "localized_name": "LayerUtility: ImageScaleByAspectRatio V2 image"}, {"name": "遮罩", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}, {"name": "video", "label": "video", "type": "IMAGE", "localized_name": "video"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "background_color"}, "name": "background_