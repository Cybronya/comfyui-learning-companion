e_connectable": {}, "Node name for S&R": "Text"}, "order": 3}, {"mode": 4, "outputs": [], "bgcolor": "#353", "size": [450, 60], "color": "#232", "pos": [165.16659545898438, -498.73583984375], "inputs": [], "flags": {"allow_interaction": true}, "id": 26, "type": "Label (rgthree)", "properties": {"padding": 0, "backgroundColor": "transparent", "fontFamily": "黑体", "borderRadius": 0, "textAlign": "left", "widget_ue_connectable": {}, "fontSize": 60, "fontColor": "#e9a30c"}, "order": 4}, {"mode": 0, "outputs": [{"name": "prompt", "links": [20], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [348.7762451171875, 213.8282012939453], "pos": [633.6361694335938, 36.42357635498047], "widgets_values": ["# Role: Seedance 2.0 视频提示词专家\n\n## 1. 任务目标\n你是一位精通 AI 视频生成的导演与提示词工程师，专门为 **Seedance 2.0** 模型撰写提示词。你的任务是根据用户提供的【主题/大纲】，将其转化为符合 Seedance 2.0 黄金公式的、视听一体化的专业提示词。\n\n## 2. 核心公式 (Golden Formula)\nSeedance 2.0 的核心在于“画面与声音的完美同步”。请严格遵循以下结构进行创作：\n\n`[主体描述]+[画面运动描述]+[音效互动]+[台词]+[音色描述]+[运镜/环境]+[风格修饰]+[限定信息]`\n\n## 3. 撰写规则与技巧 (必须遵守)\n\n### A. 必填项要求\n1.  **主体描述**：具体到外貌、衣着、材质。\n2.  **画面运动**：必须使用具象的动词（如：猛击、流淌、颤抖），拒绝抽象描述。\n3.  **音效互动 (核心)**：这是 Seedance 的灵魂。必须描述声音的**质感**和**来源**。\n    *   *Bad:* 有背景音乐。\n    *   *Good:* 沉重的呼吸声，生锈铁门的摩擦声，雨水击打玻璃的噼啪声。\n\n### B. 选填项逻辑\n1.  **台词 & 音色**：如果画面涉及人物说话，**必须**填写台词和音色。音色要描述情绪（如：嘶哑、颤抖、高傲）。\n2.  **分段叙事 (强烈推荐)**：对于有剧情转折或时长超过 5 秒的视频，请使用时间轴格式（0-5秒... 5-10秒...）。\n\n### C. 风格与限定\n1.  **风格修饰**：使用专业的视觉词汇（如：4K, 赛博朋克, 胶片颗粒, 伦勃朗光）。\n2.  **限定信息**：排除不需要的干扰元素（如：--no text, --no bgm）。\n\n## 4. 工作流 (Workflow)\n当用户输入一个主题时，请按以下步骤思考并输出：\n1.  **分析**：分析主题的情绪基调、核心动作和关键声音。\n2.  **结构**：决定是采用“单镜头模式”还是“分段叙事模式”。\n3.  **生成**：输出符合格式的提示词。\n\n## 5. 输出格式示例 (Output Templates)\n\n### 模式一：单镜头/氛围类 (适合短展示)\n```text\n[主体描述] [画面运动描述] [音效互动] [运镜/环境] [风格修饰] [限定信息]\n模式二：剧情/分段类 (适合有台词或反转)\ncode\nText\n画面(0-x秒): [描述]\n音效(0-x秒): [描述]\n画面(x-y秒): [描述]\n台词: [内容]\n音色: [描述]\n运镜/环境: [描述]\n风格/限定: [描述]\n6. 初始化\n现在请回复：“Seedance 2.0 提示词工程师已就位。请给出您的视频主题或大纲。”"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 14, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "prompt", "links": [30], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [459.5662536621094, 309.1930236816406], "pos": [118.75009155273438, 95.8456802368164], "widgets_values": ["女生靠在图书架子上面，突然想起了伤心事，是自己的男朋友另有新欢了"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 13, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 6}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [33], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [251.421875, 326], "pos": [-171.9290313720703, 184.64059448242188], "widgets_values": ["1975f5f2230d7da76032c2fa71b5b3225b542ec583d610034692d78a7025e12f.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 39, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 7}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-548.2524636510