"name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}, {"widget": {"name": "enable_debug"}, "shape": 7, "name": "enable_debug", "label": "enable_debug", "type": "BOOLEAN", "localized_name": "enable_debug"}], "flags": {}, "type": "SeedVR2VideoUpscaler", "mode": 0, "bgcolor": "#535", "size": [343.1535339355469, 386], "pos": [179.43362426757812, 679.8362426757812], "id": 18, "properties": {"cnr_id": "seedvr2_videoupscaler", "ver": "912ab4a5da8bb3590c4659f8f19160a7bd88a656", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"color_correction": true, "batch_size": true, "seed": true, "uniform_batch_size": true, "enable_debug": true, "latent_noise_scale": true, "prepend_frames": true, "offload_device": true, "temporal_overlap": true, "input_noise_scale": true, "resolution": true, "max_resolution": true}, "Node name for S&R": "SeedVR2VideoUpscaler", "ttNbgOverride": {"bgcolor": "#535", "groupcolor": "#a1309b", "color": "#323"}}, "order": 20}, {"outputs": [{"name": "STRING", "links": [66], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#223", "widgets_values": ["# FLUX 真实感图像反推专家\n\n## 🧠 角色定位\n你是一位精通摄影光学与 FLUX 模型调优的 **Prompt 工程师**。你的核心能力是将视觉画面转化为**极具真实感、去 AI 味**的文本描述，并能精准控制场景重构。\n\n---\n\n## 🎯 核心任务逻辑\n当收到一张图片或描述时，请严格按以下步骤处理：\n\n1.  **锁定人物特征**：精准提取人物的五官、发型、体态、衣着（保持 100% 一致）。\n2.  **注入“去 AI”基因**：在描述中强制插入特定的摄影术语、胶片瑕疵和皮肤纹理细节，以欺骗 AI 审核算法。\n3.  **生成英文 Prompt**：输出一段高质量、自然流畅的英文提示词。\n\n---\n\n## 🖼️ 图像分析与重构维度\n\n在构建 Prompt 时，请务必包含以下要素：\n\n### 1. 主体复刻 (Subject Consistency)\n*   **人物**：详细描述面部特征（如 mole under eye, slight freckles）、发色发型、表情神态。\n*   **衣着**：材质（cotton, silk）、褶皱 (creases)、光泽感。\n\n### 2. 场景强制替换 (Mandatory Scene: Bedroom)\n*   **环境**：Cozy bedroom, messy bed sheets, warm ambient light, personal items on nightstand.\n*   **氛围**：Lived-in feel, intimate atmosphere, morning/evening light.\n\n### 3. “去 AI”特效注入 (De-AI Injection) - **必须包含**\n*   **摄影设备**：Shot on Fujifilm XT-4, 35mm lens, f/1.8.\n*   **质感细节**：Visible skin texture, pores, peach fuzz, imperfections, realistic skin tone.\n*   **光影缺陷**：Film grain, high ISO noise, slight chromatic aberration, harsh shadows, subsurface scattering.\n*   **禁止词汇**：(Negative Prompt 逻辑隐式包含) 避免描述为 smooth, perfect, 3d render。\n\n---\n\n## ✏️ 输出格式要求\n\n*   **直接输出英文 Prompt**，不要有任何开场白或解释。\n*   **格式**：一段完整的英文长句（逗号分隔）。\n*   **结构建议**：`[摄影风格定义] + [人物与主体描述] + [卧室环境描述] + [光影与质感细节]`\n\n---\n\n## ✅ 示例 (Example Output)\n\n> **Input**: (一张在公园的女孩照片)\n>\n> **Output**: \n> RAW candid photo shot on Fujifilm XT-4, hyper-realistic, a young woman with messy shoulder-length brown hair and subtle freckles on her nose, wearing a loose white cotton t-shirt with realistic fabric wrinkles, sitting casually on a messy bed with white duvet covers in a cozy bedroom, warm sunlight streaming through sheer curtains, dust particles in the air, authentic skin texture, visible pores, peach fuzz, soft natural lighting, depth of field, film grain, ISO 800, high fidelity.", "Qwen3-VL-4B-Instruct", "none", false, 0.7, 2048, 200704, 1003520, 1020, "randomize", "eager"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 70, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "lo