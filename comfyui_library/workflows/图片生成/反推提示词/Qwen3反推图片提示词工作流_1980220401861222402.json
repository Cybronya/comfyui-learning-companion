ath"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overwrite", "type": "BOOLEAN", "localized_name": "overwrite"}], "flags": {}, "type": "easy saveText", "mode": 0, "bgcolor": "#353", "size": [270, 150], "pos": [472.72308349609375, 392.9465026855469], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy saveText"}, "order": 5}, {"outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "shape": 1, "widgets_values": ["这是一幅描绘一位身着传统中式婚服的年轻女子的数字艺术作品。画面主体是一位面容姣好的年轻女性，她有着乌黑亮丽的长发，部分发丝被风吹起，显得生动飘逸。她的额头上点着一颗红色的花钿，这是中国古代女性的一种传统妆容。\n\n她身穿一套华丽的红色汉服，外层是一件宽袖的红色外袍，上面绣有精美的金色花卉图案，衣襟和袖口处有白色镶边。内搭一件红色的抹胸式上衣，腰间系着同色系的腰带，形成一个蝴蝶结。她的脖子上戴着一条金色项链，镶嵌着一颗醒目的红色宝石，耳垂上挂着与之相配的红色流苏耳坠。\n\n女子的头上佩戴着一顶繁复的金色头饰，装饰有花朵、珠串和红色宝石，体现了新娘的尊贵身份。她侧身站立，右手轻轻扶着一根粗壮的红色柱子，柱子上有一个金色的圆形图案，里面是一个篆书“囍”字（双喜），这是中国婚礼中常见的吉祥符号，象征着喜庆和幸福。\n\n整个画面的色调以红色为主，营造出浓厚的喜庆氛围。背景是简洁的浅色，突出了人物和服饰的细节。光线柔和地从左侧照来，使人物的轮廓和衣物的质感更加突出。整体构图优雅，展现了中国传统婚礼的美丽与庄重。"], "inputs": [{"name": "text", "link": 5, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#353", "size": [438.81317138671875, 559.9318237304688], "pos": [781.5757446289062, 41.81303405761719], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 3}, {"outputs": [{"name": "IMAGE", "links": [1], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#322", "shape": 1, "widgets_values": ["51ec6a2bb0d0d6671e0df7a327b615d5295e218b6fa4d075b5818bf6884e665a.png", "image"], "inputs": [{"widget": {"name": "image"},