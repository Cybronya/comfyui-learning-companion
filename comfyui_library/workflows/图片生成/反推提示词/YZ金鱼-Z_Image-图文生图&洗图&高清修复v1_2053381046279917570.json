KSampler", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 38}, {"outputs": [{"name": "IMAGE", "links": [2056], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "links": [], "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#537abe", "widgets_values": ["143582cc46cc7ce6163f8d43aac4225745556cedac294597b279f9ba4c791665.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#2f4b7c", "size": [370, 620], "pos": [480, 1400], "id": 143, "properties": {"cnr_id": "comfy-core", "ver": "0.3.52", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 13}, {"outputs": [{"shape": 6, "name": "text", "links": [2156], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#233", "widgets_values": ["主体是一位身着华贵深蓝官袍的古代贵族男性，面容坚毅，眉宇间透着威严与沉思，黑发高束于头顶，佩戴饰有宝石与金纹的高冠，胡须修剪整齐，眼神锐利如刀，红瞳凝视前方，仿佛洞察世事。\n\n前景聚焦于人物面部特写，细节精致：衣襟处银线勾勒出繁复卷云纹，腰带束于丹色，腰间垂挂玉佩，衣摆随风微扬，衣袖宽大，袖口与下摆边缘绣有对称纹样，尽显尊贵身份。肩部与胸襟处的刺绣繁复而对称，暗藏祥瑞之象。\n\n中景为人物三视图——正面、侧身、背面，排列整齐，衣袍纹理、腰带、冠饰在不同角度下呈现立体层次。正面视图中，人物双手垂于身侧，姿态端正；侧视图中，衣袖与腰带线条流畅，衬托出人物身形修长；背面视图中，衣袍后摆自然垂落，纹饰沿脊背延伸，形成视觉引导线。\n\n背景为纯白平面，无任何干扰元素，凸显人物主体，营造出画师设定稿的干净、专业氛围。构图采用对称式布局，左侧三视图与右侧特写形成视觉平衡，引导观众视线从整体到局部，从轮廓到细节。\n\n视觉引导由人物冠饰顶端的金线延伸至面部，再由衣襟纹样自然过渡至腰带，最后收束于脚部，形成闭环式视觉路径。色调以深蓝为主调，辅以银灰、金黄、暗红点缀，营造出沉稳、庄重、神秘的古典氛围。\n\n光影柔和而精准，面部光影过渡自然，突出五官立体感，衣袍褶皱处有微妙明暗变化，增强材质质感。背景无阴影，使人物主体更显突出，整体氛围庄严肃穆，兼具威严与艺术美感，仿佛出自宫廷画师之手，传达出权力、智慧与历史厚重感。\n\n提示词：一位身着深蓝官袍、佩戴金冠宝石、眼神锐利的古代贵族男性，三视图并列展示，面部特写突出红瞳与胡须细节，衣襟绣有卷云纹，腰带束于丹色，背景纯白，构图对称，光影柔和，色调沉稳庄重，氛围威严神秘，充满古典艺术美感。"], "inputs": [{"name": "text", "link": 2081, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#355", "size": [290, 380], "pos": [1770, 1630], "id": 246, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 39}, {"outputs": [{"name": "STRING", "links": [2081], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#4a7b4a", "widgets_values": ["你是一位专业的AI图像生成提示词工程师。请详细描述这张图像的主体、前景、中景、背景、构图、视觉引导、色调、光影氛围等细节并创作出具有深度、氛围和艺术感的图像提示词。\n\n要求：中文提示词，不要出现对图像水印的描述，不要出现无关的文字和符号，不需要总结，限制在800字以内", "Qwen3-VL-4B-Instruct", "none", false, 0.7, 2048, 200704, 1003520, 1989, "fixed", "eager"], "inputs": [{"shape": 7, "name": "source_path", "label": "source_path", "type": "PATH", "localized_name": "source_path"}, {"shape": 7, "name": "image", "link": 2083, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "quantization"}, "name": "quantization", "label": "quantization", "type": "COMBO", "localized_name": "quantization"}, {"widget": {"name": "keep_model_loaded"}, "name": "keep_model_loaded", "label": "keep_model_loaded", "type": "BOOLEAN", "localized_name": "keep_model_loaded"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "max_new_tokens"}, "name": "max_new_tokens", "label": "max_new_tokens", "type": "INT", "localized_name": "max_new_tokens"}, {"widget": {"name": "min_pixels"}, "name": "min_pixels", "label": "min_pixels", "type": "INT", "localized_name": "min_pixels"}, {"widget": {"name": "max_pixels"}, "name": "max_pixels", "label": "max_pixels", "type": "INT", "localized_name": "max_pixels"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "attention"}, "name": "attention", "label": "attention", "type": "COMBO", "localized_name": "attention"}], "flags": {}, "type": "Qwen3_VQA", "mode": 0, "bgcolor": "#335533", "size": [250, 380], "pos": [1510, 1630], "id": 245, "properties": {"ver": "70cc35edacfd5979cbe7a15caf56bd2f715bc3b5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4"}, "widget_ue_connectable": {}, "aux_id": "IuvenisSapiens/ComfyUI_Qwen3-VL-Instruct", "Node name for S&R": "Qwen3_VQA"}, "order": 37}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [1949], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["一位温婉如玉的东方女性，黑发柔顺地盘于脑后，几缕发丝轻拂面颊，眼神清澈温润，嘴角含笑，流露自然恬静的优雅。她身着一袭简约纯白露肩礼服，衣料柔滑垂坠，凸显肩颈线条，耳畔垂落一对精致珍珠耳坠，晶莹剔透，与肌肤光泽相映成辉。镜头聚焦于她半身，构图采用中近景特写，以人物面部与肩颈为视觉中心，背景虚化处理，使主体更加突出。\n\n背景为柔和的室内空间，隐约可见专业美发沙龙的设备轮廓——白色造型机、镜面反射、暖光射灯，暗示场景的精致与专业，却不喧宾夺主。整体色调以暖白与柔灰为主，辅以肌肤自然的淡粉与发丝的深黑，形成温润和谐的视觉平衡。光线从侧上方柔和洒落，勾勒出面部轮廓与肩颈线条，营造出细腻如丝绸般的光影质感，阴影轻柔，不显突兀。\n\n视觉引导从人物眼睛开始，自然延伸至嘴角，再下移至肩部与衣饰，形成流畅的视觉路径，引导观者沉浸于人物的温柔气质。氛围静谧而高雅，仿佛置身于一场私密的美学仪式，既具现代都市的精致感，又蕴含东方女性的内敛柔美。画面充满艺术感，强调人物的自然美与细节的精致呈现，不追求夸张戏剧化，而是以细腻笔触捕捉瞬间的优雅与宁静。\n\n整体提示词应传达一种“静谧优雅的现代东方美学”，强调人物面部表情的自然柔和、服装与配饰的简约精致、背景环境的虚化留白，以及光影在肌肤与织物上细腻的流动感，营造出一种“温柔如诗、静美如画”的视觉意境。"], "inputs": [{"name": "clip", "link": 2721, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 2720, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [380, 350], "pos": [1112.53466796875, 1016.6085205078125], "id": 137, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "ue_properties": {"widget_ue_connectable":