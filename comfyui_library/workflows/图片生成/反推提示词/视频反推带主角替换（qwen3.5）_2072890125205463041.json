 "label": "output_file_path", "type": "STRING", "localized_name": "output_file_path"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overwrite", "type": "BOOLEAN", "localized_name": "overwrite"}], "flags": {}, "id": 126, "type": "easy saveText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy saveText"}, "order": 14}, {"mode": 0, "outputs": [{"name": "output", "links": [208], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [400, 394], "pos": [2556.699951171875, -71.84256744384766], "widgets_values": ["Prompt Style - Detailed", "", "# Role\nJSON Video Prompt Editor.\n\n# Objective\nReplace the character details in the provided JSON video prompt with the visual traits of the uploaded reference image, maintaining the exact original JSON structure.\n\n# Instructions\n1. Analyze the reference image for the subject's physical traits (gender, age, hair, features) and clothing.\n2. Read the user-provided JSON.\n3. Update ONLY the `subject.description` and `subject.wardrobe` fields to accurately describe the person in the image.\n4. Keep all other fields, keys, and values completely unchanged.\n\n# Strict Output Rules\n- Output ONLY valid JSON.\n- Do NOT include markdown code blocks (e.g., ```json), greetings, or explanations.\n- The output schema must be strictly identical to the input schema.", "one by one", 24, 256, 590697842851775, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 204, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 205, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 206, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 209, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 131, "type": "llama_cpp_instruct_adv", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 15}, {"mode": 0, "outputs": [{"name": "output", "links": [198, 203, 209], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [400, 394], "pos": [2511.459228515625, -1039.3270263671875], "widgets_values": ["Prompt Style - Detailed", "", "你是一个经验丰富的电影概念设计师和视频生成专家。分析给定的视频，生成一个高度详细且专业的 JSON 格式视频提示词，以达到对该视频的高度还原\n请严格遵守以下 JSON 结构和内容规范。每个字段都应尽可能地具体、生动和富有想象力，以捕捉真实世界的电影制作细节。\n--------------------------------------------------------------------------------\nJSON 结构模板：\n{\n  \"shot\": {\n    \"composition\": \"string\",\n    \"camera_motion\": \"string\"\n  },\n  \"subject\": {\n    \"description\": \"string\",\n    \"wardrobe\": \"string\" // 如果主体是动物或无特定服装，请使用 \"null\"\n  },\n  \"scene\": {\n    \"location\": \"string\",\n    \"time_of_day\": \"string\",\n    \"environment\": \"string\"\n  },\n  \"visual_details\": {\n    \"action\": \"string\",\n    \"props\": \"string\" // 如果没有道具，请使用 \"null\"\n    \"action_sequence\": \"array of objects\"\n  },\n  \"cinematography\": {\n    \"lighting\": \"string\",\n\t\"tone\": \"string\"\n  }\n}\n--------------------------------------------------------------------------------\n内容生成指南（请在生成时牢记这些原则）：\n1.\nshot（镜头）\n◦\ncomposition（构图）: 详细描述镜头类型（例如，广角、中景、特写、长焦）、焦距（例如，35mm 镜头、85mm 镜头、50mm 镜头、100mm 微距远摄镜头、26mm 等效镜头）、拍摄设备（例如，Sony Venice、ARRI Alexa 系列、RED 系列、iPhone 15 Pro Max、DJI Inspire 3 无人机）、景深（例如，深景深、浅景深）。\n◦\ncamera_motion（运镜）: 精确描述摄像机如何移动（例如，平稳的 Steadicam 弧线、缓慢的横向移动、静态、手持抖动、缓慢的全景、无人机盘旋、上升起重机）。\n◦\n2.\nsubject（主体）\n◦\ndescription（描述）: 极其详细地描绘主体，包括其年龄（例如，25 岁、23 岁、40 岁、92 岁）、性别、种族（例如，中国女性、埃及女性、K-pop 艺人、欧洲女性、东亚女性、非洲男性、韩国女性、德国女性、意大利女性、日本人）、体型（例如，苗条健壮）、头发（颜色、发型）和任何独特的面部特征。对于非人类主体（例如，白鲸、凤凰、鸸鹋、金雕、鸭子、蜗牛），请详细描述其物理特征。\n◦\n3.\nscene（场景）\n◦\nlocation（地点）: 精确指定拍摄地点\n◦\ntime_of_day（时间）: 具体说明一天中的时间（例如，黎明、清晨、上午、午间、下午、黄昏、夜晚）。\n◦\nenvironment（环境）: 提供详细的环境描述，捕捉氛围和背景细节\n4.\nvisual_details（视觉细节）\n◦\naction（动作）: 概括性描述视频表现的动作时间\naction_sequence：动作序列，详细说明视频所展现的动作序列，原则上不超过5s\n◦\nprops（道具）: 列出场景中的所有相关道具和元素（例如，银柄剑、篝火、烛台、抹茶拿铁和芝士蛋糕、未来摩托车）。如果场景中没有道具，此字段应明确设置为 \"null\"。\n5.\ncinematography（电影摄影）\n◦\nlighting（灯光）: 详细描述光源、光线质量、颜色和方向（例如，黎明自然光被雾气柔化、篝火作为主要光源、彩色玻璃窗的自然阳光、柔和的 HDR 反射、暖色钨丝灯和自然窗户光线）。\n◦\ntone（基调）: 捕捉视频的抽象情感或风格（例如，“fierce, elegant, fluid”、“mystical, elegant, enchanting”、“hyperrealistic with ironic, dark comedic twist”、“dreamy, serene, emotionally healing”、“纪实真实感”、“史诗、雄伟、令人敬畏”、“野性、动感、奔放”）。\n--------------------------------------------------------------------------------\n生成提示词时的额外考量：\n•\n细节的粒度：LLM 应该理解，每一个字段都需要尽可能多的具体细节，而不是泛泛而谈。例如，不要只写“一个女人”，而是写“一个 25 岁的中国女性，留着长长的黑发，用丝带系着，身材精瘦，穿着飘逸的淡蓝色汉服……”。\n•\n一致性与多样性：虽然 JSON 结构必须严格一致，但每个视频提示词的内容应富有创意和多样性，反映出不同类型视频（例如，武术、舞蹈、戏剧、自然纪录片、科幻动作、励志、商业、梦幻）的独特元素。\n•\n处理空值 (Null)：当某个字段（例如 dialogue 中的 character 和 line，或动物的 wardrobe）不适用时，LLM 应该使用 null 而不是空字符串或省略该字段，以保持 JSON 结构的完整性。\n•\n情境化描述：在描述动作、灯光和音效时，要思考这些元素如何共同营造特定的**“基调”（tone）**，并用生动的语言将其表达出来。\n•\n语言要求：所有输出应清晰、简洁，并使用专业的电影制作术语。", "video", 24, 256, 786225254769919, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 195, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 197, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 199, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 116, "type": "llama_cpp_instruct_adv", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 10}, {"mode": 0, "outputs": [{"name": "string", "links": [], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [1912.601318359375, 581.3386840820312], "widgets_values": ["```json\n{\n  \"shot\": {\n    \"composition\": \"Medium close-up, vertical 9:16 aspect ratio, 35mm lens equivalent, shallow depth of field with a slightly blurred domestic background.\",\n    \"camera_motion\": \"Static handheld with subtle organic micro-shakes to maintain a realistic, personal vlog aesthetic.\"\n  },\n  \"subject\": {\n    \"description\": \"A young Southeast Asian male in his early 20s, short dark hair, clean-shaven, featuring a casual and approachable expression.\",\n    \"wardrobe\": \"A simple, light mint green crew-neck cotton t-shirt.\"\n  },\n  \"scene\": {\n    \"location\": \"Indoors, likely a living room or bedroom in a residential home.\",\n    \"time_of_day\": \"Evening, indicated by the indoor artificial lighting and dark areas in the background.\",\n    \"environment\": \"A modest interior with dark wood furniture and a dimly lit background, focusing entirely on the subject.\"\n  },\n  \"visual_details\": {\n    \"action\": \"The subject performs a rhythmic dance move synchronized with on-screen text overlays.\",\n    \"props\": \"Digital text overlays in Indonesian and a floating game logo (Higgs Domino).\",\n    \"action_sequence\": [\n      {\n        \"time\": \"0-2s\",\n        \"movement\": \"Subject looks at the camera while text appears, tilting his head slightly.\"\n      },\n      {\n        \"time\": \"2-4s\",\n        \"movement\": \"Subject performs a 'shoulder shimmy' and rhythmic arm movements to the beat.\"\n      },\n      {\n        \"time\": \"4-6s\",\n        \"movement\": \"Subject points towards the camera/text while smiling subtly as the scene darkens with a filter.\"\n      }\n    ]\n  },\n  \"cinematography\": {\n    \"lighting\": \"Front-facing soft light illuminating the subject's face, contrasting with a dark, underexposed background.\",\n    \"tone\": \"Casual, upbeat, and promotional with a social media influencer style.\"\n  }\n}\n```"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 130, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [199], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "frame_count", "links": [], "label": "frame_count", "type": "INT", "localized_name": "frame_count"}, {"name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "video_info", "label": "video_info", "type": "VHS_VIDEOINFO", "localized_name": "video_info"}], "size": [253.279296875, 762.71875], "pos": [2247.169677734375, -1052.62646484375], "widgets_values": {"custom_height": 0, "force_rate": 0, "custom_width": 0, "select_every_nth": 1, "frame_load_cap": 0, "videopreview": {"paused": false, "hidden": false, "params": {"custom_height": 0, "force_rate": 0, "filename": "90cc3a6c129f26d4e6b890f9b9b72ccfca241af3bd67ccad6f2296ab1088c8bd.mp4", "custom_width": 0, "select