兼具东方美学与现代视觉冲击力，呈现一瞬绝杀、天地为证的史诗感。"], "inputs": [{"name": "text", "link": 19, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#004d7a", "size": [290, 400], "pos": [-1320.82763671875, 79.90873718261719], "id": 19, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 2}, {"outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#323", "widgets_values": ["", "反推", "txt", true], "inputs": [{"name": "text", "link": 28, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "output_file_path"}, "name": "output_file_path", "label": "output_file_path", "type": "STRING", "localized_name": "output_file_path"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overwrite", "type": "BOOLEAN", "localized_name": "overwrite"}], "flags": {}, "type": "easy saveText", "mode": 0, "bgcolor": "#535", "size": [270, 150], "pos": [-1016.3345947265625, 75.21395874023438], "id": 23, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy saveText"}, "order": 3}], "extra": {"links_added_by_ue": [], "workspace_info": {"saveLock": false, "id": "ptSgRYP0o0aYH_M2B9gpm"}, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "ds": {"offset":