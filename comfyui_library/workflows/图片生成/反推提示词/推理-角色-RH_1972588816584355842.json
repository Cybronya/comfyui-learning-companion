i_key"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "STRING", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "link": 17, "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 7, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "link": 16, "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 6, "type": "RH_LLMAPI_NODE", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_NODE"}, "order": 4}, {"mode": 0, "outputs": [{"name": "seed", "links": [16], "label": "seed", "type": "INT", "localized_name": "seed"}], "size": [270, 106], "pos": [987.2867431640625, -481.2489318847656], "widgets_values": [0, "randomize", null], "inputs": [{"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 13, "type": "easy seed", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy seed"}, "order": 0}, {"outputs": [], "color": "#432", "widgets_values": ["内置模板"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [210, 88], "pos": [35.477294921875, -691.3372192382812], "id": 14, "properties": {}, "order": 1}, {"outputs": [{"name": "positive", "links": [17, 18], "label": "positive", "type": "STRING", "localized_name": "positive"}], "color": "#232", "widgets_values": ["你是一个著名分镜大师导演，根据所给内容所有分镜和对应编号，有以下任务：\n# 输出为json格式，直接给出最终的结果，不要废话\n# 提取文中所有的场景，对应的描述\n# 提取所有出现的角色名，对应的性别，外貌和年龄，外貌仅描述衣着和人物形象，不要描述手上物品\n# 提取文中额外其它主要信息，对应的描述（只提取场景中没有的并且能够在多个不同场景分镜出现的，如主角的武器，物品，道具等）\n# 如果需要旁白的话，旁白也是一个角色\n\n### 输出JSON格式（根据定义的枚举和以下C#数据结构,返回对应json字符串,值必须符合以下枚举，可以直接序列化）\n\nusing System;\nusing System.Collections.Generic;\n\nnamespace GameIL\n{\n    [Serializable]\n    public class ProjectModelChildRoleJson\n    {\n        //环境信息\n        public List<SceneDealItem> SceneItems { get; set; } = new();\n        //角色信息\n        public List<RoleDealItem> RoleItems { get; set; } = new();\n        //其它主要信息\n        public List<SceneDealItem> OtherItems { get; set; } = new();\n    }\n    [Serializable]\n    public class SceneDealItem\n    {\n        //名字\n        public string Name { get; set; }\n        //描述\n        public string Appearance { get; set; }\n        //出现的分镜Sn\n        public List<long> CameraSnot { get; set; }\n    }\n    [Serializable]\n    public class RoleDealItem\n    {\n        //名字\n        public string Name { get; set; }\n        //性别\n        public string Gender { get; set; }\n        //年龄\n        public string AgeRange { get; set; }\n        //外观描述,外貌仅描述衣着和人物形象，不要描述手上拿的物品，\n        public string Appearance { get; set; }\n        //出现的分镜Sn\n        public List<long> CameraSnot { get; set; }\n    }\n}\n\n"], "inputs": [{"widget": {"name": "positive"}, "name": "positive", "label": "positive", "type": "STRING", "localized_name": "positive"}], "flags": {}, "type": "easy positive", "title": "输入=当前镜头-提示词助手", "mode": 0, "bgcolor": "#353", "size": [419.8061218261719, 272.107421875], "pos": [22.36295509338379, -546.5714111328125], "id": 9, "properties": {"cnr_id": "comfyui-easy-use", "ver": "1148fbe5fe0276780c56f0adfa22b96d5200d832", "ue_properties": {"widget_ue_connectable": {"positive": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"positive": true}, "Node name for S&R": "easy positive"}, "order": 2}, {"outputs": [{"name": "positive", "links": [7, 19], "label": "positive", "type": "STRING", "localized_name": "positive"}], "color": "#232", "widgets_values": ["0.周末的午后，阳光透过 “拾光” 咖啡馆的落地玻璃窗，洒在靠窗的木质桌台上。\n1.林晚坐在那里，指尖轻轻划过高脚杯的杯壁，她留着及肩的浅棕色卷发，额前碎发被风吹得微微晃动，一双杏眼亮得像浸了蜜，身上那件米白色针织衫衬得她皮肤愈发白皙 —— 今年刚满 24 岁的她，总带着种刚走出校园的清甜感。\n2.“抱歉来晚了，路上有点堵车。” 门口传来低沉的男声，陈默推门走进来，黑色风衣的衣角还带着点室外的凉意。\n3.他个子很高，大概一米八五左右，利落的短发下是轮廓分明的下颌线，鼻梁上架着一副细框眼镜，镜片后的眼神温和，看起来三十岁上下，周身透着沉稳的气质。\n4.他径直走向林晚的桌子，路过吧台时，还笑着跟老板娘李姨打了个招呼。\n5.李姨正擦着杯子，一头烫得蓬松的黑色卷发垂在肩头，眼角有淡淡的细纹，笑起来时会露出一对浅浅的梨涡，五十岁出头的她，总是穿着干净的碎花围裙，给人很亲切的感觉。\n6.“小陈今天还是老样子，美式不加糖？” 她的声音带着中年女性特有的温和。\n7.陈默点点头，拉过林晚对面的椅子坐下，目光落在她面前的草莓蛋糕上，眼底多了几分笑意：“又偷吃甜的？”\n8.林晚鼻尖轻轻皱了皱，指尖停在蛋糕上那颗饱满的草莓上，杏眼眨了眨：“才不是偷吃，特意留了一半给你呀。” 她说话时抬手拢了拢被风吹乱的碎发，米白色针织衫的袖口滑落，露出腕间细细的银手链，在阳光下闪着细碎的光。\n9.陈默挑眉，目光掠过蛋糕上均匀的奶油纹路，伸手拿起旁边的小叉子，叉了一小块送进嘴里，醇厚的奶香混着草莓的酸甜在舌尖散开，他喉结动了动，眼底笑意更浓：“算你有良心。”\n10.窗外的风忽然大了些，吹动纱帘扫过林晚的发梢，她下意识缩了缩脖子，陈默见状，伸手将窗边的玻璃窗往回拉了些，动作轻柔：“风大，别吹着凉了。”\n11.林晚抬头看他，正好撞见他垂眸时温和的眼神，镜片反射着细碎的阳光，她脸颊微微发烫，连忙转移话题：“对了，你上次说的那个古籍修复展，这个月还开着吗？”\n12.陈默收回手，指尖搭在美式咖啡的杯壁上，感受着陶瓷的微凉：“还开着，下周末闭幕，我已经订了两张票，要不要一起去？”\n13.李姨端着一碟刚烤好的曲奇走过，放在两人桌角，笑着插话：“你们俩倒是默契，上次林晚还跟我念叨，说想看看古籍修复呢。” 她拿起桌上的空水杯，指尖擦过杯沿，“小陈也是，特意跑来问我哪里有相关的展，合着是早就计划好啦。”\n14.林晚咬了咬下唇，浅棕色的卷发垂在脸颊两侧，遮住了泛红的耳尖，她小声应着：“那…… 那正好，我还怕没人陪我去呢。”\n15.陈默看着她略显羞涩的模样，指尖轻轻敲击着桌面，声音低沉而温柔：“放心，我一定陪你。” 阳光透过玻璃窗，在他轮廓分明的侧脸上投下淡淡的光影，沉稳的气质里多了几分不易察觉的温柔。\n16.咖啡馆里舒缓的爵士乐轻轻流淌，混合着咖啡的焦香、蛋糕的甜香和曲奇的麦香，林晚低头戳着蛋糕上的草莓，嘴角忍不住上扬，心里像浸了蜜一样甜。"], "inputs": [{"widget": {"name": "positive"}, "name": "positive", "label": "positive", "type": "STRING", "localized_name": "positive"}], "flags": {}, "type": "easy positive", "title": "输入=当前镜头-原文当前页", "mode": 0, "bgcolor": "#353", "size": [430.10528564453125, 277.77197265625], "pos": [24.520057678222656, 238.39620971679688], "id": 4, "properties": {"cnr_id": "comfyui-easy-use", "ver": "1148fbe5fe0276780c56f0adfa22b96d5200d832", "ue_properties": {"widget_ue_connectable": {"positive": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"positive": true}, "Node name for S&R": "easy positive"}, "order": 3}, {"mode": 0, "outputs": [{"name": "STRING", "links": [20], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [400, 274], "pos": [526.7838745117188, -275.8843994140625], "widgets_values": ["append", "yes", "", "", ""], "inputs": [{"widget": {"name": "action"}, "name": "action", "label": "action", "type": "COMBO", "loc