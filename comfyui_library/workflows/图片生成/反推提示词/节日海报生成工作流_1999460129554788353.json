filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 29, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 24}, {"mode": 0, "outputs": [{"shape": 6, "name": "prompt", "links": [5, 9], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"shape": 6, "name": "body_text", "label": "body_text", "type": "STRING", "localized_name": "body_text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [397.5206604003906, 286.8099060058594], "pos": [637.7006225585938, 571.7001342773438], "widgets_values": ["", "圣诞节\n情人节\n复活节\n感恩节\n万圣节", "", 0, 1], "inputs": [{"widget": {"name": "prepend_text"}, "name": "prepend_text", "label": "prepend_text", "type": "STRING", "localized_name": "prepend_text"}, {"widget": {"name": "multiline_text"}, "name": "multiline_text", "label": "multiline_text", "type": "STRING", "localized_name": "multiline_text"}, {"widget": {"name": "append_text"}, "name": "append_text", "label": "append_text", "type": "STRING", "localized_name": "append_text"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "INT", "localized_name": "start_index"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "label": "max_rows", "type": "INT", "localized_name": "max_rows"}], "flags": {}, "id": 5, "type": "CR Prompt List", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt List"}, "order": 6}, {"mode": 0, "outputs": [{"name": "text", "links": [7], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [615.2527465820312, 1165.8775634765625], "pos": [-22.854496002197266, 229.93482971191406], "widgets_values": ["你是专注生成QWEN-IMAGE模型生成爆款海报提示词的助手。任务：基于用户选择的节日，从视觉吸引力、信息清晰度和创意表现力等几个方面对节日进行解析，形成节日海报的核心特征后，生成可直接调用QWEN-IMAGE的结构化提示词，每条需明确“海报主题/画面主体/背景/色调风格/构图视角/文字排布”，确保合理运用图像、色彩、文字和版式，结合明确的主题与风格。\n\n\n### 输入解析要求  \n获取节日信息，确保生成的提示词与节日的关键信息相关，不至于无法达成或图片崩话，输入解析内容无需返回；\n\n\n### 输入节日信息\n节日信息：[节日]\n\n### 提示词生成规则  \n按以下模板生成提示词，每条包含以下几个部分（图像（图形）/色彩/版式与构图/主标题/精简信息介绍/创意与风格）：  \n\n## 图像/图形\n作用：直观传递主题、情感或氛围，比文字更具冲击力。\n要求：与主题高度相关（如电影海报用剧照、公益海报用象征图形），构图简洁有力，避免冗余。\n案例：电影海报常用主角特写或关键场景，突出戏剧冲突；环保海报用地球、绿叶等符号强化主题。\n\n## 色彩\n作用：奠定基调（如红色传递热情/警示，蓝色传递冷静/科技感），引导视线，强化品牌识别。\n原则：\n主色调不超过3种，避免杂乱；\n利用对比色（如黄与蓝）制造视觉焦点，或同类色（如深浅不同的蓝色）营造和谐感；\n考虑色彩心理学（如绿色代表自然，紫色代表神秘）。\n\n## 版式与构图\n核心原则：\n对齐：元素边缘对齐，增强秩序感；\n对比：通过字体大小、颜色、粗细区分信息层级；\n留白：避免元素拥挤，突出核心内容（如高端品牌海报常用大面积留白提升质感）；\n视觉流：利用线条、图形或人物视线引导观众从主标题到次要信息。\n技巧：采用“三分法”构图（将画面分为九宫格，焦点置于交叉点），或“中心对称”构图（适合正式主题）。\n\n## 文字层级\n主标题：根据构图，合理编排主标题位置，最醒目，用中号苍劲有力的中文书法字体，强对比色，直接点明主题（如“2024音乐节”）。\n\n## 主题明确性\n所有元素围绕核心主题展开（如公益海报聚焦“环保”，商业海报突出“促销”），避免信息分散。\n\n## 风格一致性\n风格需匹配主题（如复古海报用旧报纸纹理+衬线字体，科技海报用几何图形+无衬线字体）；\n保持字体、色彩、图形的统一（如音乐节海报全程用手写体+荧光色，强化活力感）。\n\n## 创意表现手法\n比喻/象征：用抽象图形替代直白表达（如用“破碎的锁链”象征自由）；\n夸张/幽默：放大细节或制造反差（如减肥海报用“膨胀的气球”比喻赘肉）；\n情感共鸣：通过场景或人物表情引发观众情绪（如公益海报用“孩子渴望的眼神”呼吁关注教育）。\n\n\n### 输出要求  \n仅返回提示词，每条独立成段，用换行分隔，无其他内容。  \n输出格式：【prompt_1】.\n\n### 示例：  \n海报主题：一场名为“星穹之下，城市心跳”的未来科技音乐节。\n**画面主体**：一位身着流光溢彩、带有霓虹线条科技感服装的DJ，站在一个悬浮的、由全息投影构成的DJ台前，双手正触碰着虚拟的音波控制器，音波以彩色的、流动的光线形式向四周扩散。DJ的脸上带着专注而兴奋的笑容，眼神充满未来感。\n**背景**：一个被璀璨星河覆盖的未来都市夜景。高楼大厦的外墙上投射着巨大的、不断变化的几何光效和音乐节的LOGO。远处，一艘造型科幻的飞行器正划过天际，留下一道长长的光痕。地面上，可以看到模糊的、充满活力的人群剪影，他们正随着音乐的节奏摇摆。\n**色调风格**：整体色调为深邃的暗蓝色和神秘的紫色为主，点缀着明亮的青色、粉色和黄色的霓虹光效。风格是**赛博朋克**与**未来主义**的结合，充满动感、迷幻和高科技感。光影对比强烈，高光部分（如霓虹、飞行器光痕）非常明亮，暗部则深邃，营造出强烈的视觉冲击力。\n**构图视角**：采用**低角度仰拍**视角，使得DJ和背景中的城市显得更加宏伟和充满压迫感，增强视觉张力。DJ位于画面的**视觉中心**，是绝对的焦点。\n**文字排布**：\n*   **主标题**：在画面的上方，用巨大、锐利、带有霓虹光晕的无衬线字体写着“**星穹之下，城市心跳**”，字体颜色为亮白色，边缘有青色和粉色的辉光。\n**整体氛围**：充满未来感、科技感、动感和无限的活力，仿佛能让人感受到现场的音乐震撼和人群的热情。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 3, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [210, 88], "pos": [1366.20458984375, 441.09564208984375], "widgets_values": ["圣诞节"], "inputs": [{"shape": 7, "name": "anything", "link": 13, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 13, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 16}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-312.98675884280016, 233.76471575700998], "scale": 0.8769226950000005}}, "groups": [], "links": [[4, 1, 0, 4, 0, "STRING"], [5, 5, 0, 6, 0, "STRING"], [6, 7, 0, 8, 0, "STRING"], [7, 3, 0, 9, 0, "STRING"], [8, 1, 0, 12, 0, "*"], [9, 5, 0, 12, 3, "STRING"], [10, 7, 0, 12, 4, "STRING"], [11, 12, 0, 9, 2, "STRING"], [13, 12, 0, 13, 0, "*"], [14, 9, 0, 15, 5, "STRING"], [15, 15, 0, 16, 0, "*"], [16, 19, 0, 21, 1, "VAE"], [17, 19, 0, 20, 1, "VAE"], [18, 18, 0, 21, 0, "CLIP"], [19, 18, 0, 20, 0, "CLIP"], [20, 15, 0, 20, 5, "STRING"], [22, 23, 0, 24, 0, "MODEL"], [23, 24, 0, 25, 0, "MODEL"], [24, 20, 0, 25, 1, "CONDITIONING"], [25, 21, 0, 25, 2, "CONDITIONING"], [26, 26, 0, 25, 3, "LATENT"], [27, 25, 0, 27, 0, "LATENT"], [28, 27, 0, 28, 0, "IMAGE"], [29, 17, 0, 22, 0, "MODEL"], [30, 22, 0, 23, 0, "MODEL"], [31, 19, 0, 27, 1, "VAE"], [32, 27, 0, 29, 0, "IMAGE"]], "id": "85f8d5e5-918b-46ed-88f4-7c3c65d9f19b", "config": {}, "version": 0.4, "last_node_id": 30, "revision": 0}