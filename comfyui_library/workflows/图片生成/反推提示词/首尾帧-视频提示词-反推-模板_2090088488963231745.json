性，身穿白色紧身背心与灰色抽绳运动短裤，皮肤白皙，妆容精致，眼神温柔。她初始站立，双手自然垂放于身体两侧，随后缓缓前倾身体，膝盖微屈，上半身向前探出，最终俯身靠近镜头，双手撑在身前，头部微微上扬，直视镜头，双唇清晰开合，带着俏皮语气说出「帅哥，你能看清楚吗？」，表情自信而略带挑逗。背景为现代温馨客厅，暖黄色灯光柔和洒落，沙发、绿植、茶几等元素虚化呈现，营造浅景深效果，突出人物主体；光线从侧后方打亮轮廓，增强立体感与肌肤质感，整体氛围轻松暧昧又具生活气息。"], "inputs": [{"shape": 7, "name": "anything", "link": 4, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#10687e", "size": [471.0772705078125, 715.0292358398438], "pos": [3855.47119140625, 855.069580078125], "id": 7, "properties": {"cnr_id": "comfyui-easy-use", "ver": "e94405e610bce3416b6c887d6b70601ab7a32dd7", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 9}, {"mode": 0, "outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [270, 82], "pos": [4438.6201171875, 860.4629516601562], "widgets_values": ["video_prompt", "txt"], "inputs": [{"name": "text", "link": 14, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "format"}], "flags": {}, "id": 21, "type": "SaveText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveText"}, "order": 10}, {"mode": 0, "outputs": [], "size": [270, 270.0000305175781], "pos": [3983.745849609375, 474.935791015625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "图像", "link": 15, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "文件名前缀"}, "name": "文件名前缀", "label": "文件名前缀", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 22, "type": "SaveImageJPG_GH", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImageJPG_GH