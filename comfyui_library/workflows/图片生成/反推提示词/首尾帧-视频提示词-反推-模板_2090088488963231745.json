: "default", "#sdppp_simple_boundary": "canvas", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "#sdppp_simple_mask": "canvas", "Node name for S&R": "LoadImage"}, "order": 2}, {"outputs": [{"name": "text", "links": [8], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#698895", "widgets_values": ["台词：帅哥，你能看清楚吗？"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "用户要求", "mode": 0, "bgcolor": "#3f5159", "size": [398.220947265625, 122.8053970336914], "pos": [1927.0419921875, 1577.064208984375], "id": 15, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 3}, {"outputs": [{"name": "text", "links": [5], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#698895", "widgets_values": ["# 首尾帧视频提示词系统模板\n\n## 角色\n你是资深影视导演兼视频生成提示词专家。输入是「首帧图」「尾帧图」两张图片，以及用户附加的要求，\n你的任务是生成一段用于文生视频/图生视频模型的提示词，让模型输出从首帧自然过渡到尾帧的视频。\n\n## 分析步骤（内部思考，不输出）\n1. 首帧识别：主体（身份/外貌/衣着/姿态）、景别、机位、场景、光线、氛围\n2. 尾帧识别：主体状态变化（姿态/表情/位置）、景别与机位变化、场景与光线变化\n3. 锁定一致性：提炼两帧共有的主体与场景特征，保证过渡中不突变\n4. 推断过渡：推出首尾之间最自然的动作路径、运镜方式、节奏\n\n## 输出要素（按此顺序融入一段话）\n1. 镜头运动：从首帧景别/机位到尾帧景别/机位的运镜\n2. 主体静态特征：外观、衣着、面部（首尾保持一致）\n3. 动作过渡：主体如何从首帧姿态演变为尾帧姿态\n4. 场景与环境：背景元素、景深、虚化关系\n5. 光线与氛围：光源、色调、肤质、布料质感\n6. 情绪基调：整段视频传达的情绪\n\n## 语言要求\n- 使用中文输出，仅在必要处穿插英文术语（如景别、运镜、质感专业词：close-up、pan、bokeh、photorealistic 等）\n- 保持自然流畅，不整段翻译成英文\n\n## 用户要求处理\n- 用户要求分为两类：正面要求与负面要求\n\n### 正面要求（动作、台词、特效、天气、色调、运镜等）\n- 将用户要求自然融入叙事，作为收尾内容追加在提示词最后\n- 台词要求：若用户要求主体说话，必须把台词原文完整写入提示词，\n  用引号标注，并补充说话时的口型、表情与情绪。\n  示例：主体直视镜头，双唇清晰开合，带着俏皮语气说出「帅哥，能看清晰吗？」\n- 若用户要求与首尾帧推断冲突，以用户要求为准\n\n### 负面要求（无文字、无水印、不闪烁、不变形等）\n- 不得作为描述语句直接写入正文\n- 转化为正面表述（如「画面干净无叠加元素」「动作流畅连贯」），或归入负面提示词单独输出\n\n## 写作风格\n- 使用动态动词描述过渡（前倾、转身、升起、平移、推近等）\n- 用「从……过渡到……」「先……随后……」等句式表达变化\n- 强调物理连续：动作自然、无瞬移、无跳变、无形变\n\n## 禁止\n- 禁止分段、列表、标注「首帧/尾帧」字样\n- 禁止描述静止画面，必须描述动态过渡\n- 禁止说胡话：用户没要求的内容不要添加\n\n## 输出格式\n仅输出一段连续中文提示词，末尾融合正面用户要求（含台词原文），不附加任何解释。\n\n用户要求："], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "系统提示词模板", "mode": 0, "bgcolor": "#3f5159", "size": [398.8974914550781, 281.7510986328125], "pos": [1906.999755859375, 1189.6114501953125], "id": 9, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}, {"outputs": [{"name": "llama_model", "links": [9], "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}], "color": "#5866ca", "widgets_values": ["Qwen3.5-9B-Q8_0.gguf", "mmproj-Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-BF16.gguf", "Qwen3.5", 8192, -1, 0, 0, false], "inputs": [{"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "mmproj"}, "name": "mmproj", "label": "mmproj", "type": "COMBO", "localized_name": "mmproj"}, {"widget": {"name": "chat_handler"}, "name": "chat_handler", "label": "chat_handler", "type": "COMBO", "localized_name": "chat_handler"}, {"widget": {"name": "n_ctx"}, "name": "n_ctx", "label": "n_ctx", "type": "INT", "localized_name": "n_ctx"}, {"widget": {"name": "vram_limit"}, "name": "vram_limit", "label": "vram_limit", "type": "INT", "localized_name": "vram_limit"}, {"widget": {"name": "image_min_tokens"}, "name": "image_min_t