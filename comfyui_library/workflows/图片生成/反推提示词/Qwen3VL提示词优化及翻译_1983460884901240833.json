ts": [{"name": "text", "link": 26, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 24, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 28}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [408.076416015625, 241.87644958496094], "pos": [826.9569091796875, 382.5341796875], "widgets_values": ["最高质量 8K 分辨率 电影质感 细节丰富 照片级真实感  \n一只威猛的霸王龙，肌肉线条分明，皮肤呈深灰褐色带粗糙鳞甲纹理，张开巨口露出锋利獠牙，眼神凶狠而充满野性的力量；前肢粗壮有力，后腿强健支撑身体，尾巴高高扬起保持平衡  \n置身于远古热带雨林中，脚下是泥泞沼泽与腐叶覆盖的土地，周围有蕨类植物、巨型棕榈树及低垂藤蔓，在晨曦微光下泛着湿润光泽；远处可见火山烟雾缭绕与飞鸟掠过天空  \n写实主义自然摄影风格，略带史诗感纪录片镜头  \n采用动态三分法构图，主视角从侧面斜前方拍摄突出体型压迫感，光线来自左上方穿透树叶形成斑驳投影，阴影浓重但面部受光清晰勾勒轮廓  \n暖金色阳光洒落大地，搭配深绿、墨褐与土黄色调营造原始荒蛮又庄严神圣的气息，空气中弥漫潮湿泥土味与草木清香，令人感受到史前世界的磅礴生命力"], "inputs": [{"name": "text", "link": 31, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 34, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 27}, {"mode": 0, "outputs": [{"name": "STRING", "links": [29], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [395.5682373046875, 142], "pos": [405.7406005859375, 9.302630424499512], "widgets_values": [".", "true"], "inputs": [{"shape": 7, "name": "text_a", "link": 37, "label": "text_a", "type": "STRING", "localized_name": "text_a"}, {"shape": 7, "name": "text_b", "link": 30, "label": "text_b", "type": "STRING", "localized_name": "text_b"}, {"shape": 7, "name": "text_c", "link": 33, "label": "text_c", "type": "STRING", "localized_name": "text_c"}, {"shape": 7, "name": "text_d", "label": "text_d", "type": "STRING", "localized_name": "text_d"}, {"widget": {"name": "delimiter"}, "name": "delimiter", "label