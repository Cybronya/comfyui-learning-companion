				"r2v — 参考主体生视频(Reference to Video)",
				"<Picture 1> walks into a neon-lit alley at night. Keep identity and outfit of <Picture 1>. Cinematic lighting, light rain, shallow depth of field. Audio: distant city traffic and soft rain. No text or logos.",
				"采样设置",
				1,
				145889992888728,
				"randomize",
				24,
				864,
				480,
				864,
				243,
				"{\"version\":5,\"editMode\":\"segment\",\"timelineMode\":\"prompt_batch\",\"totalFrames\":243,\"frameRate\":24,\"width\":864,\"height\":480,\"refMaxSize\":864,\"output\":{\"mode\":\"fixed\",\"aspectRatio\":\"自定义\",\"megapixels\":0.4,\"multiple\":32,\"longEdge\":864,\"width\":864,\"height\":480,\"maxExportFrames\":0,\"exportMode\":\"all\",\"audioMode\":\"generate\",\"continuityEnabled\":false,\"continuityOverlapFrames\":9},\"videoClips\":[],\"video\":{\"fileName\":\"\",\"videoFile\":\"\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[],\"sourceFrameCount\":124,\"deletedSourceRanges\":[]},\"global\":{\"taskType\":\"r2v — 参考主体生视频(Reference to Video)\",\"prompt\":\"<Picture 1> walks into a neon-lit alley at night. Keep identity and outfit of <Picture 1>. Cinematic lighting, light rain, shallow depth of field. Audio: distant city traffic and soft rain. No text or logos.\",\"refs\":[],\"referenceVideo\":{\"videoFile\":\"\",\"fileName\":\"\",\"type\":\"input\",\"subfolder\":\"\"},\"continuousReference\":false,\"genImage\":{\"imageFile\":\"\"},\"refAudios\":[]},\"segments\":[{\"id\":\"s0\",\"start\":0,\"length\":243,\"frameCount\":243,\"durationSec\":10,\"prompt\":\"保持<Picture 1> 中人物的身份特征与服装造型，完美匹配<Audio 1>的节奏与情绪，并使用<Audio 1>为说话音色，并保持精确的口型同步（Lip-sync）。自然的镜头运动，无字幕，无水印标识。\\n青年学者坐在温暖的小木屋内，面对镜头自然流畅地说““外面的雪好像下得越来越大了。不过没关系，屋里的炉火烧得正旺”。随着说话的语调起伏，他的头部有轻微且自然的点动与晃动，眼神真诚地与镜头交流，说到精彩处嘴角会带有自然的微笑。背景壁炉的火光在他的侧脸和眼镜镜片上映射出极其微弱的、动态的暖色光斑，画面充满真实的Vlog对谈感与生活气息。\\n青年学者音色为<Audio 1>。\",\"negativePrompt\":\"\",\"taskType\":\"\",\"refs\":[{\"index\":0,\"imageFile\":\"9545afad0400ddf6108965f4666d7d0aeedd50117a95f8c42b72d65660bc680a.png\",\"fileName\":\"\",\"type\":\"input\",\"subfolder\":\"\"}],\"refAudios\":[{\"index\":0,\"audioFile\":\"2a091fbe2449cca84561eb8887cecf48fa7cdbf489b4fe7a3af181ab779d69f0.flac\",\"fileName\":\"2a091fbe2449cca84561eb8887cecf48fa7cdbf489b4fe7a3af181ab779d69f0.flac\",\"type\":\"input\",\"subfolder\":\"\",\"durationSec\":17.336875}],\"refVideos\":[],\"genImage\":{\"imageFile\":\"\",\"fileName\":\"\"}}],\"gen\":{\"defaultFrameCount\":124},\"runSelectEnabled\":false,\"runSelection\":[],\"liveTaePreview\":true}",
