: "INT"}], "size": [315, 130], "pos": [572.5, -880], "widgets_values": [1010576246079646, "", "", ""], "inputs": [], "flags": {}, "id": 133, "type": "Seed (rgthree)", "properties": {"cnr_id": "rgthree-comfy", "ver": "944d5353a1b0a668f40844018c3dc956b95a67d7", "randomMin": 0, "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "randomMax": 1125899906842624}, "order": 9}, {"outputs": [{"name": "text_embeds", "links": [300, 301], "label": "text_embeds", "type": "WANVIDEOTEXTEMBEDS", "localized_name": "text_embeds"}, {"name": "negative_text_embeds", "label": "negative_text_embeds", "type": "WANVIDEOTEXTEMBEDS", "localized_name": "negative_text_embeds"}, {"name": "positive_prompt", "links": [], "label": "positive_prompt", "type": "STRING", "localized_name": "positive_prompt"}], "color": "#432", "widgets_values": ["nsfw_wan_umt5-xxl_bf16.safetensors", "bf16", "主角是：一位美丽的女子，身着白色汉服，夜晚在湖畔翩翩起舞，手势间引动光鸟飞舞。\n\n镜头1：近景镜头，镜头轻摇  \n女子站在湖畔，月光洒在她的白色汉服上，风轻抚衣袂。她双手优雅翻转，指尖发出微弱光芒，轻轻一挥，几只光鸟从她的周围浮现，翅膀带着柔和的荧光，伴随她的手势舞动。镜头缓慢摇动，捕捉光鸟与她舞姿的节奏感。\n\n镜头2：中景镜头，镜头推进  \n镜头从远处推近，光鸟数量逐渐增多，飞舞的轨迹在夜空中画出光的涟漪。女子脸上带着自豪的微笑，手势愈发流畅，光鸟在她周围盘旋，与她的舞步完美契合。月光与光鸟交融，形成一片梦幻的光影场景，镜头推进至她的侧脸，捕捉她专注又自信的神情。\n\n镜头3：俯拍镜头，混合光动态  \n镜头从上方俯拍，女子在湖畔的草地上舞动，光鸟从四面八方汇聚而来，形成一个巨大的光环，将她包围。湖水反射着光鸟的荧光，与月光交织出一片流动的光海。女子旋转起舞，衣袖与光环融为一体，光的轨迹如星河般绚丽，镜头缓缓拉远，展现这场光与舞的盛宴。", "内裤，短裤，bad quality video，慢镜头，升格视频，色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走", "disabled", false, "gpu"], "inputs": [{"shape": 7, "name": "extender_args", "label": "extender_args", "type": "WANVIDEOPROMPTEXTENDER_ARGS", "localized_name": "extender_args"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "precision"}, "name": "precision", "label": "precision", "type": "COMBO", "localized_name": "precision"}, {"widget": {"name": "positive_prompt"}, "name"