			"widgets_values":[
				"{\n  \"shot\": {\n    \"composition\": \"中景镜头，使用 50mm 标准镜头，Sony Venice 摄影机拍摄，浅景深，焦点锁定在小女孩身上，背景虚化突出主体，构图居中偏左，营造梦幻氛围。\",\n    \"camera_motion\": \"缓慢推近镜头，相机轻微晃动模拟手持拍摄，增强沉浸感，最后稳定在特写。\",\n    \"frame_rate\": \"24fps，电影级帧率，保持自然流畅的运动感。\",\n    \"film_grain\": \"自然 Kodak 5203D 数字胶片颗粒，轻微颗粒感增强电影质感。\"\n  },\n  \"subject\": {\n    \"description\": \"一个约 6 岁的东亚小女孩，金黄色卷发如阳光般蓬松，眼睛明亮有神，皮肤白皙透亮，身材娇小玲珑，穿着由发光桂花花瓣组成的透明薄纱裙，裙摆随风轻舞，脚踩透明水晶鞋，整体造型如童话中的精灵。\",\n    \"wardrobe\": \"透明薄纱裙由发光的桂花花瓣编织，裙摆边缘点缀微光，脚穿透明水晶鞋，无其他配饰，妆容自然，脸颊泛着柔和的金光。\"\n  },\n  \"scene\": {\n    \"location\": \"古朴的石板小巷，两旁是青砖老墙和木质窗棂，地面湿漉漉的，散落着金黄色桂花花瓣。\",\n    \"time_of_day\": \"黄昏，细雨绵绵，天光微暗，营造朦胧诗意的氛围。\",\n    \"environment\": \"雨滴从枝头滴落，空气中弥漫着桂花香，地面积水倒映着女孩的身影，背景模糊的绿叶和花朵随风轻摆，营造静谧唯美的意境。\"\n  },\n  \"visual_details\": {\n    \"action\": \"小女孩手持透明雨伞，伞面装饰着发光的桂花，她正站在水洼中，轻盈地旋转，裙摆飞扬，雨滴在伞面上跳跃，她抬头微笑，眼神充满纯真与喜悦。\",\n    \"props\": \"透明发光雨伞，伞面装饰桂花；散落的金黄色桂花；湿漉漉的石板地面；背景枝头的桂花与绿叶。\"\n  },\n  \"cinematography\": {\n    \"lighting\": \"柔和的黄昏自然光，从侧面斜射，照亮女孩的轮廓，雨滴反射出微光，背景的桂花与树叶在光线下呈现暖黄色调，整体光线温暖梦幻。\",\n    \"tone\": \"梦幻、治愈、诗意、童话般唯美，充满童真与自然之美。\"\n  },\n  \"color_palette\": \"主色调为暖黄色与深青色，桂花金黄与石板灰绿形成对比，背景雾气增添柔和灰调，整体色彩饱和度适中，营造温暖而梦幻的视觉氛围。\"\n}"
			],
