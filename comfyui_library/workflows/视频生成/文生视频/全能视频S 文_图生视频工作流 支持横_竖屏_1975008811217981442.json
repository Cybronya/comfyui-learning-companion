color": "#233", "widgets_values": ["", "portrait-hd", 115678094, "randomize", 10], "inputs": [{"name": "image", "link": 1, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 13, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "duration_seconds"}, "shape": 7, "name": "duration_seconds", "label": "duration_seconds", "type": "COMBO", "localized_name": "duration_seconds"}], "flags": {}, "type": "RH_Sora2_I2V", "mode": 4, "bgcolor": "#355", "size": [400, 224], "pos": [1063.60546875, 349.0826721191406], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Sora2_I2V"}, "order": 8}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#593930", "size": [296.2474365234375, 106], "color": "#332922", "pos": [544.8299560546875, 107.3338623046875], "inputs": [], "flags": {}, "id": 36, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "视频", "showNav": true, "toggleRestriction": "default"}, "order": 5}, {"outputs": [{"name": "text", "links": [], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#233", "widgets_values": ["导演视觉风格阐述： 整体美学灵感源于王家卫的高光泽、情绪化视觉，并融合现代惊悚片的疯狂节奏。大量使用侵略性的焦点切换、微妙的镜头呼吸感和变形镜头光晕。追求超写实的纹理细节，8K分辨率。剪辑风格是极限频闪式 (Extreme Strobe-Cut)，旨在给观众带来一种信息过载、心跳加速的沉浸体验。\n分镜脚本开始（视觉与声音指令交织）：\n[0-2.5秒] 【第一幕：水晶幻梦的极速破碎】\n视觉指令: 一连串超过10个镜头的、极致奢华与幸福的极限快剪，每个镜头仅持续数帧，如同一场濒死前的回忆闪回：\n水晶杯中优雅升腾的香槟气泡 (极限特写)。\n焦点从一颗闪耀的钻石项链，瞬间切换到女主角幸福、天真的笑眼。\n女主角和闺蜜亲密地碰杯，水晶杯发出清脆的光芒。\n男主角温柔地为她戴上项链的特写。\n她们在私人游艇上迎着海风大笑。\n生日蛋糕上蜡烛被吹灭的瞬间。\n颁奖典礼上闪光灯的爆闪。\n突然，所有幸福画面被一个扭曲的、噩梦般的闺蜜脸部定格打断，她的微笑变得阴险而恶毒，整个画面出现强烈的数字噪点和色彩分离效果。\n声音指令:\n音乐: 背景响起轻快、梦幻的钢琴曲，并随着画面加速而加速。\n画外音 (Voiceover, 天真甜美的女声): “我曾以为，我拥有全世界…”\n音效: 在闺蜜脸变异的瞬间，音乐被一声刺耳的黑胶唱片刮擦声或数字错误音猛烈打断，并伴随一声低沉的“嗡”声。\n[2.5-3.5秒] 【第二幕：雨夜的坠落】\n视觉指令: 一个令人眩晕的荷兰角镜头 (Dutch angle)，女主角的身体被狠狠地撞在上海滩屋顶酒吧的玻璃护栏上，冰冷的暴雨倾盆而下，雨水和她的泪水在脸上混合。她惊恐地看着下方，城市的霓虹灯在她放大的瞳孔中旋转成一个混乱的漩涡。\n声音指令:\n音效: 只有巨大的暴雨声、一声沉闷的撞击声，以及被无限放大的、令人窒息的、充满压迫感的心跳声。\n[3.5-4.5秒] 【第三幕：废墟上的重生】\n视觉指令: 一声急促的吸气声（视觉化表现）。女主角的眼睛猛地睁开，瞳孔剧烈收缩，倒映着一间老旧高中教室里嗡嗡作响的日光灯管。她茫然地看着自己粗糙校服下的年轻双手，嘴唇颤抖着，表演着独白的口型。\n声音指令:\n音效: 所有声音消失，一片死寂。\n现场独白 (On-Screen Monologue, 脆弱且充满气音的耳语): “我……竟然重生了？”\n[4.5-7.5秒] 【第四幕：地狱回廊的疯狂闪回】\n视觉指令: 另一组超过15个镜头的、更黑暗、更压抑的极限快剪，充满监视感、痛苦和阴谋：\n一个快速的冲击变焦 (crash zoom)，镜头穿过图书馆书架，最终定格在闺蜜和心上人亲密的侧脸上。\n继父坐在餐桌对面，画面极度稳定，他唯一的动作是缓慢、刻意地眨了一下眼睛，眼神如鹰隼般锐利。\n手持晃动镜头下，女主角在深夜疯狂地翻阅文件。\n一滴红酒在文件上绽放开来，如同血迹。\n一张被撕碎的合影照片。\n一只黑色的皮鞋踩过一滩雨水。\n医院心电监护仪上波动的线条。\n她躲在门后偷听的紧张眼神。\n继父与闺蜜在一个隐蔽的角落秘密交谈的远景。\n她在浴室镜子前，镜中的倒影分裂成两个——一个哭泣，一个冷笑。\n声音指令:\n音乐: 背景响起快速、紧张、令人不安的弦乐心跳节拍。\n画外音 (Voice-over, 语气急转直下，冰冷绝望): “……但地狱，才刚刚开始。”\n音效: 混合着纸张翻动、时钟滴答、低沉心跳、相机快门、窃窃私语等混乱的声音。\n[7.5-9秒] 【第五幕：女王的加冕】\n视觉指令: 夜晚的车内，镜头是她脸部的极限特写，挡风玻璃上雨刮器的有节奏的刮动成为画面的节拍器。窗外的城市霓虹在她脸上流淌而过，如同战纹。她的表情从悲伤凝固 (solidifies) 成钢铁般的冰冷和决绝。她的嘴唇以低沉、共鸣、控制力极强的语调，表演着最终审判的口型。\n声音指令:\n音效: 所有背景音效减弱，只剩下女主角冰冷的独白和车窗雨刮器有节奏的“唰…唰…”声。\n现场独主 (On-Screen Monologue, 低沉有力，充满压迫感): “这一次，你们欠我的，我会亲手拿回来。”\n[9-10秒] 【最终章：敌蜜】\n视觉指令: 画面切黑。一滴金色的液体墨水在纯黑的屏幕中央猛烈溅开，然后以狂暴、愤怒的笔触，瞬间凝聚成两个充满力量感的狂草汉字：“敌蜜”。笔锋的最后一划，凌厉如刀。\n声音指令:\n音效: 在独白最后一个字落下时，配合一声强劲的鼓点或金属“Stinger”音效。紧接着，片名出现时，响起一声深沉、回响的“Boom”音效，并混合着锐利的毛笔破风声，最终归于寂静。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 4, "bgcolor": "#355", "size": [436.66192626953125, 628.9251708984375], "pos": [-1607.3612060546875, 327.3659362792969], "id": 37, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}, {"outputs": [{"name": "video", "links": [18], "label": "video", "type": "VIDE