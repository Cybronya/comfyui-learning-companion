			"widgets_values":[
				"t2v — 文生视频(Text to Video)",
				"Realistic live-action cinematic look: a post-rain dusk metropolis, anamorphic lens, shallow depth of field, film grain, city volumetric fog, flying-car traffic between towers.\n\nStoryboard:\n[0s-2s] High side angle: protagonist sprinting at a roof edge, wind catching their coat.\n[2s-3.5s] Leap across the gap between buildings, body stretching mid-air.\n[3.5s-5s] Landing and roll, low-angle shot, keep running into fog.\n\nAudio: wind, rapid footsteps, city ambience, low score with accent hits on each leap.\nNo text, logos or watermarks.",
				"采样设置",
				1,
				60807594325192,
				"randomize",
				24,
				480,
				864,
				864,
				124,
				"{\"version\":5,\"editMode\":\"segment\",\"timelineMode\":\"prompt_batch\",\"totalFrames\":124,\"frameRate\":24,\"width\":480,\"height\":864,\"refMaxSize\":864,\"output\":{\"mode\":\"fixed\",\"aspectRatio\":\"9:16 (竖屏)\",\"megapixels\":0.4,\"multiple\":32,\"longEdge\":864,\"width\":480,\"height\":864,\"maxExportFrames\":0,\"exportMode\":\"all\",\"audioMode\":\"generate\",\"continuityEnabled\":false,\"continuityOverlapFrames\":9},\"videoClips\":[],\"video\":{\"fileName\":\"\",\"videoFile\":\"\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[],\"sourceFrameCount\":124,\"deletedSourceRanges\":[]},\"global\":{\"taskType\":\"t2v — 文生视频(Text to Video)\",\"prompt\":\"Realistic live-action cinematic look: a post-rain dusk metropolis, anamorphic lens, shallow depth of field, film grain, city volumetric fog, flying-car traffic between towers.\\n\\nStoryboard:\\n[0s-2s] High side angle: protagonist sprinting at a roof edge, wind catching their coat.\\n[2s-3.5s] Leap across the gap between buildings, body stretching mid-air.\\n[3.5s-5s] Landing and roll, low-angle shot, keep running into fog.\\n\\nAudio: wind, rapid footsteps, city ambience, low score with accent hits on each leap.\\nNo text, logos or watermarks.\",\"refs\":[],\"referenceVideo\":{\"videoFile\":\"\",\"fileName\":\"\",\"type\":\"input\",\"subfolder\":\"\"},\"continuousReference\":false,\"genImage\":{\"imageFile\":\"\"},\"refAudios\":[]},\"segments\":[{\"id\":\"s0\",\"start\":0,\"length\":124,\"frameCount\":124,\"durationSec\":5,\"prompt\":\"[场景] 深夜地下舞室，潮湿水泥地面反射着霓虹光斑，铁质管道裸露在墙壁，空气里有薄雾。[主体] 亚洲女性舞者，黑色短背心与宽松迷彩工装裤，高马尾松散，汗水在锁骨处反光。[动作] 她随节奏自由律动，突然一个甩头，发梢扫过镜头，身体下沉又弹起，即兴 Hip-hop 动作。[镜头] 低角度仰拍，从舞鞋特写缓慢向上摇移，掠过腰肢扭动，最终定格在面部特写，眼神直视镜头，轻微推近。[光线] 紫与青色灯光交替频闪，逆光勾勒出身体轮廓，地面拉出长长的投影。[渲染] 电影感景深，C4D 厚涂质感，轻微胶片颗粒。[音频] 沉重的电子节拍，低音震动感，混合着舞者急促的呼吸声。[约束] 无文字、无标志，保持16:9构图。\",\"negativePrompt\":\"\",\"taskType\":\"\",\"refs\":[],\"refAudios\":[],\"refVideos\":[],\"genImage\":{\"imageFile\":\"\",\"fileName\":\"\"}}],\"gen\":{\"defaultFrameCount\":124},\"runSelectEnabled\":false,\"runSelection\":[],\"liveTaePreview\":true}",
