 "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 97, "type": "CLIPLoader", "properties": {"cnr_id": "comfy-core", "ver": "0.3.60", "ue_properties": {"widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 1}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [127, 128], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "color": "#232", "widgets_values": ["主角是：一位美丽的女子，身着白色汉服，夜晚在湖畔翩翩起舞，手势间引动光鸟飞舞。\n\n镜头1：近景镜头，镜头轻摇  \n女子站在湖畔，月光洒在她的白色汉服上，风轻抚衣袂。她双手优雅翻转，指尖发出微弱光芒，轻轻一挥，几只光鸟从她的周围浮现，翅膀带着柔和的荧光，伴随她的手势舞动。镜头缓慢摇动，捕捉光鸟与她舞姿的节奏感。\n\n镜头2：中景镜头，镜头推进  \n镜头从远处推近，光鸟数量逐渐增多，飞舞的轨迹在夜空中画出光的涟漪。女子脸上带着自豪的微笑，手势愈发流畅，光鸟在她周围盘旋，与她的舞步完美契合。月光与光鸟交融，形成一片梦幻的光影场景，镜头推进至她的侧脸，捕捉她专注又自信的神情。\n\n镜头3：俯拍镜头，混合光动态  \n镜头从上方俯拍，女子在湖畔的草地上舞动，光鸟从四面八方汇聚而来，形成一个巨大的光环，将她包围。湖水反射着光鸟的荧光，与月光交织出一片流动的光海。女子旋转起舞，衣袖与光环融为一体，光的轨迹如星河般绚丽，镜头缓缓拉远，展现这场光与舞的盛宴。"], "inputs": [{"name": "clip", "link": 180, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "title": "CLIP Text Encode (Positive Prompt)", "mode": 0, "bgcolor": "#353", "size": [422.84503173828125, 164.31304931640625], "pos": [420, 280], "id": 6, "properties": {"cnr_id": "comfy-core", "ver": "0.3.45", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 11}, {"mode": 4, "outputs": [{"name": "MODEL", "links": [215], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 82], "pos": [67.99809265136719, -169.43692016601562], "widgets_values": ["3000步zhenzhen.safetensors", 1], "inputs": [{"name": "model", "link": 217, "label": "model", "type":