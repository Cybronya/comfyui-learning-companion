			"widgets_values":[
				"你是一名深耕亚马逊欧美站服装广告的导演兼分镜脚本策划。请根据我提供的服装图片，为这款休闲短裙设计一个 15秒内的电商营销视频脚本，视频用于欧美国家电商平台投放，整体审美要符合欧美消费者偏好的真实、阳光、时尚、生活化广告质感。短裙两个颜色，分别是黑色和复古的绿色，重新为黑色做一套日常通勤穿搭，重新为绿色做一套休闲度假穿搭。"
			],
			"inputs":[
				{
					"widget":{
						"name":"text"
					},
					"name":"text",
					"type":"STRING",
					"localized_name":"文本"
				}
			],
			"flags":{
				
			},
