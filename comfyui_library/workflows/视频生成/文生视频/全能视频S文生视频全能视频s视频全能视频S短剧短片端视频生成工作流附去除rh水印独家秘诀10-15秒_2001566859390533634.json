			],
			"widgets_values":[
				"{\n  \"故事名称\": \"极致拉扯：合作关系下的心跳违约与暧昧绝杀\",\n  \"核心情绪\": \"【拉扯感、暧昧、拆穿、心动、心理博弈、极致张力】\",\n  \"风格设定\": {\n    \"整体风格\": \"**电影质感/都市禁欲系**，氛围**清冷、私密、充满呼吸感与生理性心动**。画质要求**极致细腻**。\",\n    \"画面比例\": \"9:16 竖屏，**大特写、浅景深、微距摄影**。\",\n    \"色调\": \"**冷调背景与人物面部暖光对比**。通过阴影强调两人呼吸交错的狭窄地带。\",\n    \"光照\": \"**微弱的呼吸灯感/局部侧光**，聚焦于两人的眼眸、嘴唇以及她因心跳加快而微微起伏的锁骨。\"\n  },\n  \"角色定义\": {\n    \"主角_防守者 (她)\": {\n      \"角色名\": \"【苏蔓】\",\n      \"外貌\": \"一位**清冷理性的美丽东方女子**，着【职业衬衫/简约高定】，表情【冷静、克制、眼神中有一丝藏不住的慌乱】。\",\n      \"人物设定\": \"试图用“合作协议”作为护身符，却在对方的逼近下生理防线溃败。\",\n      \"初始状态\": \"身体后靠，直视对方，试图用言语维持距离。\"\n    },\n    \"主角_进攻者 (他)\": {\n      \"角色名\": \"【霍言】\",\n      \"外貌\": \"一位**矜贵腹黑的英俊东方男子**，【领带整齐、眼神深邃且带有侵略性】。\",\n      \"人物设定\": \"不破坏规矩（不碰她），却用极近的距离和精准的洞察力玩弄暧昧的人。\",\n      \"初始状态\": \"缓缓俯身，目光锁定她的眼睛。\"\n    }\n  },\n  \"场景环境\": {\n    \"地点\": \"【寂静的办公室/昏暗的车内/深夜书房】\",\n    \"关键视觉\": \"【极近的距离但无接触、颤动的长睫毛、锁骨的起伏、交错的呼吸、深邃的眼神】\"\n  },\n  \"核心看点\": \"【明明没有肢体接触，却通过揭穿“心跳”完成了比亲吻更暧昧的占有。】\",\n  \"视频时长\": \"【10秒】\",\n  \"音效与配乐\": {\n    \"主体配乐\": \"**极简的电子氛围音/重低音脉冲**。在男主说“心跳”时，背景音全消。 \",\n    \"环境音效\": \"**放大的心跳声（咚、咚、咚，逐渐加快）**，**彼此交错的急促呼吸声**，**他富有磁性的气声嗓音**。\"\n  },\n  \"旁白/台词 (不含旁白)\": {\n    \"女主台词\": \"【我们只是合作。】\",\n    \"男主台词_绝杀\": \"【那你别对我心跳这么快。】\"\n  },\n  \"视频片段与提示词\": [\n    {\n      \"片段时间\": \"0-3秒\",\n      \"片段主题\": \"理性的防线\",\n      \"剧情描述\": \"**中景转近景**：她微微后仰，眼神冷淡但倔强，说出提醒台词。镜头捕捉她说话时微微颤动的睫毛。\",\n      \"动作与对话\": {\n        \"女主台词\": \"【（冷静地）我们只是合作。】\"\n      },\n      \"镜头语言\": \"【浅景深镜头】。**聚焦她的面部，背景虚化，强调她的孤立无援。**\"\n    },\n    {\n      \"片段时间\": \"3-7秒\",\n      \"片段主题\": \"不触碰的侵略\",\n      \"剧情描述\": \"**特写镜头**：他缓缓靠近，停在距离她唇尖仅1厘米的位置。**镜头捕捉两人的鼻尖几乎相撞但绝对没有碰到的极限距离。** 她屏住呼吸，锁骨处起伏明显。\",\n      \"动作设计\": \"【他双手插兜或撑在两侧，保持绅士但充满压迫感的姿势。】\",\n      \"镜头语言\": \"【微距对视】。**聚焦于两人眼神之间的火花，加入心跳声SFX。**\"\n    },\n    {\n      \"片段时间\": \"7-10秒\",\n      \"片段主题\": \"生理违约的绝杀\",\n      \"剧情描述\": \"他微微侧头，在她耳边或唇边，用**极其低沉、沙哑的气声（ASMR感）说出台词**。**特写：她瞬间放大的瞳孔。**\",\n      \"动作与对话\": {\n        \"男主台词_绝杀\": \"【（气声）那你别对我心跳这么快。】\"\n      },\n      \"镜头语言\": [\n        \"【极致大特写】。**画面定格在她瞬间羞红的耳根或他得逞后深情的目光。**\",\n        \"音效：**心跳声在最后时刻猛然加速后戛然而止。**\",\n        \"**留白收尾，给观众无限遐想空间。**\"\n      ]\n    }\n  ]\n}"
			],
