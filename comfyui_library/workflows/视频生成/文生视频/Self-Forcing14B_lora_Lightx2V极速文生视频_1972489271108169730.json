的肤色在纯白背景的映衬下形成强烈对比，环境光柔化至f/2.8光圈，氛围慵懒而挑逗，身体随着呼吸微妙起伏。\nmingxing,全景镜头环绕，东方少女（丹凤眼/蜜桃唇釉/锁骨窝深）纯白埃及棉床幔，侧卧时香槟色真丝睡衣（露背交叉带）肩带滑落臂弯，左腿微屈足尖勾绕床单，右手慢捻发梢绕颈三圈，蓦然仰头喉间轻颤，丹凤眼迷离半阖又倏然睁大凝视镜头，下唇轻咬上唇微张。绸缎与暖橙唇色对比，环境光柔化至f/2.8光圈，氛围慵懒而诱惑,身体随着呼吸起伏。\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 20, "type": "Text Multiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text Multiline"}, "order": 7}, {"mode": 0, "outputs": [{"name": "INT", "links": [15], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [-257.3064270019531, 443.543701171875], "widgets_values": [2], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 19, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 8}, {"mode": 0, "outputs": [{"name": "INT", "links": [32], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [-225.5547637939453, 1359.3973388671875], "widgets_values": [5], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 31, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 9}, {"outputs": [{"name": "INT", "links": [33], "label": "整数", "type": "INT", "localized_name": "整数"}, {"name": "FLOAT", "label": "浮点", "type": "FLOAT", "localized_name": "浮点"}, {"name": "STRING", "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#2a363b", "shape": 1, "widgets_values": ["a*b+c", "False", 0, 16, 1], "inputs": [{"widget": {"name": "python_expression"}, "name": "python_expression", "type": "STRING", "localized_name": "python_expression"}, {"widget": {"name": "print_to_console"}, "name": "print_to_console", "type": "COMBO", "localized_name": "print_to_console"}, {"widget": {"name": "a"}, "shape": 7, "name": "a", "link": 32, "type": "INT", "local