0001_p80.png", "format": "video/h264-mp4", "subfolder": "H3_Enhanced", "label": "Normal", "type": "output", "frame_rate": 24, "bucket": "rh-comfyui01", "score": 0, "filename": "02_final_1080p_00001_p80-audio_mftug_1792730330.mp4", "fullpath": "/data/ComfyUI/personal/073db6eb31fe1ae2003a5019a231d83d/output/H3_Enhanced/02_final_1080p_00001_p80-audio.mp4", "objectKey": "073db6eb31fe1ae2003a5019a231d83d/output/H3_Enhanced/02_final_1080p_00001_p80-audio_mftug_1792730330.mp4"}}, "format": "video/h264-mp4", "no_preview": false, "frame_rate": 24, "pingpong": false}}, {"outputs": [], "color": "#354754", "widgets_values": ["## 默认：1080p · 5 秒 · 24fps · 原生声音\n\n改上方提示词、时长、种子即可。首次导入请核对模型下拉框。\n\n同时输出一采对照与最终 MP4。三采、人物 LoRA 均默认旁路。\n\n时长自动限制为 4–15 秒，并四舍五入到整帧；5 秒内部生成 124 帧，最终裁到 120 帧。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "开始使用", "mode": 0, "bgcolor": "#233440", "size": [730, 200], "pos": [50, 620], "id": 38, "properties": {"widget_ue_connectable": {}}, "order": 7, "widgets_values_named": {"text": "## 默认：1080p · 5 秒 · 24fps · 原生声音\n\n改上方提示词、时长、种子即可。首次导入请核对模型下拉框。\n\n同时输出一采对照与最终 MP4。三采、人物 LoRA 均默认旁路。\n\n时长自动限制为 4–15 秒，并四舍五入到整帧；5 秒内部生成 124 帧，最终裁到 120 帧。"}}, {"outputs": [], "color": "#354754", "widgets_values": ["**一采：25 步，res_multistep / simple，CFG=1。**\n\n基础画面为 1376×768；不加载 Turbo 加速 LoRA。首尾帧保持空白，走纯文生路径。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "一采说明", "mode": 0, "bgcolor": "#233440", "size": [640, 115], "pos": [870, 945], "id": 39, "properties": {"widget_ue_connectable": {}}, "order": 8, "widgets_values_named": {"text": "**一采：25 步，res_multistep / simple，CFG=1。**\n\n基础画面为 1376×768；不加载 Turbo 加速 LoRA。首尾帧保持空白，走纯文生路径。"}}, {"outputs": [], "color": "#354754", "widgets_values": ["## 真实二采路径\n\n一采 AV → 分离 → 3D 学习型视频 latent 放大 → 合并锁定音频 → 低噪重采样。\n\n放大到 1952×1088，最终中心裁为 1920×1080。3D 模型用 FP32 推理，结束后卸载。\n\n二采 8 步 + H3SigmaRefiner 额外 2 步。只改二采降噪/步数即可调细节与结构保留程度。\n\n0 值音频遮罩贯穿二、三采；最终声音始终取自一采。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "增强机制", "mode": 0, "bgcolor": "#233440", "size": [620, 345], "pos": [1600, 710], "id": 40, "properties": {"widget_ue_connectable": {}}, "order": 9, "widgets_values_named": {"text": "## 真实二采路径\n\n一采 AV → 分离 → 3D 学习型视频 latent 放大 → 合并锁定音频 → 低噪重采样。\n\n放大到 1952×1088，最终中心裁为 1920×1080。3D 模型用 FP32 推理，结束后卸载。\n\n二采 8 步 + H3SigmaRefiner 额外 2 步。只改二采降噪/步数即可调细节与结构保留程度。\n\n0 值音频遮罩贯穿二、三采；最终声音始终取自一采。"}}, {"outputs": [], "color": "#354754", "widgets_values": ["## 默认关闭，可选轻度精修\n\n只选中上方「三采总开关」采样器，按 **Ctrl+B** 切换旁路。\n\n默认 mode=4：透传二采结果，不执行第三次采样。恢复正常运行 mode=0 后：同分辨率 5 步，降噪 0.12。\n\n三采参数独立可调，不再次放大。不要把旁路改成静音/禁用（mode=2），否则会截断最终输出。\n\n若三采增加闪烁、过锐或改变纹理，保持关闭；采样次数越多并不必然更好。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "三采操作", "mode": 0, "bgcolor": "#233440", "size": [610, 400], "pos": [3000, 550], "id": 41, "properties": {"widget_ue_connectable": {}}, "order": 10, "widgets_values_named": {"text": "## 默认关闭，可选轻度精修\n\n只选中上方「三采总开关」采样器，按 **Ctrl+B** 切换旁路。\n\n默认 mode=4：透传二采结果，不执行第三次采样。恢复正常运行 mode=0 后：同分辨率 5 步，降噪 0.12。\n\n三采参数独立可调，不再次放大。不要把旁路改成静音/禁用（mode=2），否则会截断最终输出。\n\n若三采增加闪烁、过锐或改变纹理，保持关闭；采样次数越多并不必然更好。"}}, {"outputs": [{"name": "MODEL", "slot_index": 0, "links": [5], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "color": "#293a44", "widgets_values": ["h3-realism-people-t2v-i2v-r2v.safetensors", 0.7], "inputs": [{"name": "model", "link": 4, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {}, "type": "LoraLoaderModelOnly", "mode": 0, "size": [730, 120], "pos": [50, 1650], "id": 11, "properties": {"cnr_id": "comfy-core", "ver": "bef11fcbfa8d772678e2ad00b1294c63eb3e5da7", "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 14, "widgets_values_named": {"lora_name": "h3-realism-people-t2v-i2v-r2v.safetensors", "strength_model": 