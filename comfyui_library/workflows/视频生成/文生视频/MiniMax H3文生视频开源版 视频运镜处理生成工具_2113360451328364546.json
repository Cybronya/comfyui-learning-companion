ages"}, {"shape": 7, "name": "audio", "link": 26, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"shape": 7, "name": "meta_batch", "label": "meta_batch", "type": "VHS_BatchManager", "localized_name": "meta_batch"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "frame_rate"}, "name": "frame_rate", "link": 24, "label": "frame_rate", "type": "FLOAT", "localized_name": "frame_rate"}, {"widget": {"name": "loop_count"}, "name": "loop_count", "label": "loop_count", "type": "INT", "localized_name": "loop_count"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "format"}, {"widget": {"name": "pingpong"}, "name": "pingpong", "label": "pingpong", "type": "BOOLEAN", "localized_name": "pingpong"}, {"widget": {"name": "save_output"}, "name": "save_output", "label": "save_output", "type": "BOOLEAN", "localized_name": "save_output"}, {"widget": {"name": "no_preview"}, "shape": 7, "name": "no_preview", "label": "no_preview", "type": "BOOLEAN", "localized_name": "no_preview"}], "flags": {}, "type": "VHS_VideoCombine", "mode": 0, "bgcolor": "#353", "size": [220.3603515625, 358], "pos": [770, 0], "id": 11, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VHS_VideoCombine"}, "order": 26}, {"outputs": [{"name": "conditioning", "links": [17], "label": "conditioning", "type": "MINIMAX_H3_CONDITIONING", "localized_name": "conditioning"}], "color": "#232", "widgets_values": ["深夜，一座美术馆安静无人。镜头沿着昏暗的展厅缓慢向前移动，墙面中央悬挂着一幅巨大的蓝色海洋油画，画中是一头正在游动的蓝鲸。地面光洁如镜，只有展柜灯和月光照亮空间。\n\n镜头逐渐靠近油画，画布表面的海浪开始轻轻流动，蓝鲸缓慢摆动尾鳍。几滴海水从画框边缘落到地面，形成真实的涟漪。蓝鲸随后穿过画布表面，从二维油画自然转化为真实的三维蓝鲸，带着大量海水跃入美术馆上空。\n\n展厅瞬间被清澈的海水包围，但墙上的画作、展柜和建筑结构仍然清晰可见。蓝鲸从镜头上方缓慢游过，阳光般的水下光斑在鲸身、墙壁和地面流动。鱼群围绕蓝鲸旋转，细小气泡缓慢上升。\n\n镜头跟随蓝鲸穿过展厅拱门，空间逐渐从美术馆无缝转变为辽阔深海。墙壁化作海底岩石，吊灯化作发光水母，地面延伸成布满珊瑚的海床。蓝鲸保持相同体型、纹理和游动方向，向远处明亮的海面游去。\n\n结尾镜头快速上升并穿出海面。清晨阳光照亮广阔海洋，蓝鲸跃出水面，在空中划出优美弧线，水珠被逆光照成金色。镜头缓慢拉远，蓝鲸落入海中形成巨大的环形浪花，画面自然淡出。\n\n整体采用电影级写实质感，蓝金色调，镜头运动稳定流畅。油画到真实蓝鲸、美术馆到深海的转换必须连续自然。水流、气泡、鲸鱼运动、水面反射和飞溅符合真实物理规律。\n\n原生音频包含安静的美术馆环境声、轻微脚步回声、画布摩擦声、水滴声、海水涌入声、低沉悠远的鲸鸣、气泡声和海浪声。背景音乐从极弱的钢琴逐渐发展为宏大的电影交响乐，在蓝鲸跃出海面时达到高潮。清晨的海边旅行短片。镜头一：航拍蔚蓝海岸，海浪拍打白色沙滩。镜头二：切换到一位白裙女孩赤脚沿海岸奔跑，长发和裙摆随风飘动。镜头三：人物停下脚步，在夕阳光线中回头微笑。画面转场流畅，生成连续海浪声、脚步声、海风声和逐渐增强的浪漫音乐。"], "inputs": [{"name": "h3_text_encoder", "link": 14, "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "RHMiniMaxH3T2VATextEncode", "mode": 0, "bgcolor": "#353", "size": [400, 200], "pos": [0, 0], "id": 5, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3T2VATextEncode"}, "order": 12}, {"outputs": [{"name": "target", "links": [15], "label": "target", "type": "MINIMAX_H3_TARGET", "localized_name": "target"}, {"name": "shape_info", "label": "shape_info", "type": "STRING", "localized_name": "shape_info"}], "color": "#323", "widgets_values": ["9:16", 5, 736, 1024], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "duration_seconds"}, "name": "duration_seconds", "label": "duration_seconds", "type": "FLOAT", "localized_name": "duration_seconds"}, {"widget": {"name": "width"}, "shape": 7, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "shape": 7, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}], "flags": {}, "type": "RHMiniMaxH3T2VATarget", "mode": 0, "bgcolor": "#535", "size": [336.1910095214844, 150], "pos": [1925.181640625, 478], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3T2VATarget"}, "order": 3}