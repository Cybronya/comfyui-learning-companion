			"widgets_values":[
				"<div class=\"banner\">\n    <div class=\"block\">\n    <h1>根据平台配置节点一键运行</h1>\n            <h4>图</h4>\n            <h1>点击生成</h1>\n            <h3 class=\"author\">@覃小鑫</h3>\n</div>\n<div class=\"startPage\">\n  <div class=\"hoverContainer\">\n    <a href=\"https://qinxiaoxin.flowus.cn/\">\n      <span class=\"size-smallButton style-input\">🌠 我的博客</span>\n    </a>\n    <a href=\"https://t.zsxq.com/7F90A\">\n      <span class=\"size-smallButton style-input\">🌃 我的抖音</span>\n    </a>\n    <a href=\"https://www.douyin.com/user/MS4wLjABAAAAr5f-aa6_nMH7ln-BXQfSNvCzkTEIMnqaJy8j9hkheg1I0XRImTOSDMqM2XSXjyeY?from_tab_name=main\">\n      <span class=\"size-smallButton style-input\">📸虚拟人</span>\n    </a>\n        <a href=\"https://www.xiaohongshu.com/user/profile/64073c7b000000002a0086cb\">\n      <span class=\"size-smallButton style-input\">🎇\n小鑫鑫壁好运</span>\n    </a>\n\n  </div>\n</div></div>",
				"markdown",
				"\r\n.banner {\r\n    display: flex;\r\n    flex-direction: column;\r\n    position: absolute;\r\n    top: 0;\r\n    bottom: 0;\r\n    left:28%;\r\n    right: 0;\r\n    margin: 0;\r\n    color:#FFF2BF;\r\n    overflow: hidden;\r\n    /*font-family: song;*/\r\n}\r\n.banner::after {\r\n    content: '';\r\n    position: absolute;\r\n    width: 100%;\r\n    left: -10%;\r\n    top: -500px;\r\n    font-size: 30px;\r\n    letter-spacing: 50px;\r\n    line-height: 100px;\r\n    opacity:0.1;\r\n    transform: rotate(-30deg);\r\n    font-family: song;\r\n    font-weight: lighter;\r\n    \r\n}\r\n\r\n.block {\r\n    flex: 10;\r\n    border-radius: 200px;\r\n    display: flex;\r\n    align-items: lighter;\r\n    padding: 10px 20px;\r\n}\r\n\r\nh1 {\r\n    font-size: 60px;\r\n    font-weight: bolder;\r\n    font-family: song;\r\n}\r\n\r\nh3 {\r\n    font-size: 42px;\r\n    margin: -20px 20px;\r\n    font-family: song;\r\n}\r\n\r\nh4 {\r\n    font-size: 42px;\r\n    font-family: song;\r\n    font-weight: lighter;\r\n    margin: 20px;\r\n    border: solid 4px currentColor;\r\n    display: flex;\r\n    width: 60px;\r\n    height: 60px;\r\n    justify-content: center;\r\n    align-items: center;\r\n    border-radius: 100%;\r\n}\r\n\r\n\r\n.bar {\r\n    height: 60px;\r\n    display: flex;\r\n    background: #fff1;\r\n    \r\n}\r\n\r\n.bar .item {\r\n    display: flex;\r\n    align-items: center;\r\n    padding: 10px 20px;\r\n    width: 400px;\r\n}\r\n\r\n.bar h2.item {\r\n    font-size: 40px;\r\n    font-weight: bolder;\r\n    font-family: song;\r\n}\r\n\r\n.gap {\r\n    width: 100px;\r\n}\r\n\r\n.f1 {\r\n    flex: 1;\r\n}\r\n\r\n\r\n* {\r\n    font-family: Arial;\r\n  }\r\n\r\n\r\n  .startPage {\r\n    position: absolute;\r\n    top: 8;\r\n    left:10%;\r\n    bottom: 0;\r\n    width:auto;\r\n    z-index: 0;\r\n    transition: transform 0.3s ease;\r\n    align-items: center;\r\n    justify-content: center;\r\n  }\r\n\r\n  .startPage:hover {\r\n    transform: translateY(-1%);\r\n  }\r\n\r\n  .hoverContainer {\r\n    background: gray;\r\n    border-radius: 10px;\r\n    padding:20px;\r\n    display: flex;\r\n    flex-direction: row;\r\n    margin: 10px auto;\r\n    position: center;\r\n    align-items: center;\r\n  }\r\n\r\n  .header {\r\n    padding-bottom: 24px;\r\n    margin-bottom: 24px;\r\n    border-bottom: 1px solid #3e3e3e;\r\n    width: 200%;\r\n    height: 72px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n  }\r\n\r\n  .header_discrip {\r\n    font-size: 21px;\r\n    font-weight: 200;\r\n    \r\n    color: #6f6f6f;\r\n  }\r\n\r\n  .size-smallButton {\r\n    font-size: 21px;\r\n    border-radius: 12px;\r\n    height: 48px;\r\n    min-width: 48px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    width: 100%;\r\n    cursor: pointer;\r\n  }\r\n\r\n  .style-input {\r\n    background: #2a2a2b;\r\n    padding: 12px;\r\n\r\n    transition: background 0.3s;\r\n  }\r\n\r\n  .style-input:hover {\r\n    background: #3b3b3c;\r\n  }\r\na:not(:first-child) {\r\n      margin-left:8px;}\r\n  a {\r\n    color: #b6b6b7;\r\n  }\r\n\r\n  a:hover,\r\n  a:hover .header_discrip {\r\n    color: #dddddd !important;\r\n  }",
