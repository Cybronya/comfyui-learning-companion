"type": "STRING", "localized_name": "text"}], "size": [319.678466796875, 171.08425903320312], "pos": [1268.8311767578125, 3867.974365234375], "widgets_values": ["黄昏时分，混合光（街灯与天光余晖），柔光与侧光结合，暖色调，中高饱和度，中景，平衡构图，中焦距镜头，低角度拍摄，镜头缓慢环绕跟随，写实摄影风格。一位身穿酒红色丝质舞裙的年轻女孩在空旷的城市街道中央忘我起舞，裙摆随旋转飞扬，赤足轻点湿润的柏油路面，眼神专注而愉悦，发丝在微风中飘动；街道两侧是玻璃幕墙与老式砖墙交错的建筑，橱窗灯光映出她的倒影，远处车流模糊成光带，空中飘落几片梧桐叶，营造出都市中诗意而孤独的浪漫氛围。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 319, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 14}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "VHS_latentpreview": false, "ds": {"offset": [-719.9955729811293, -2520.886859867722], "scale": 0.5989500000000022}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Low noise model", "bounding": [1608.3990478515625, 3699.340087890625, 1291.9681396484375, 420.2015380859375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "High noise model", "bounding": [1603.16015625, 3068.39111328125, 1300.2945556640625, 619.8215942382812]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "Prompt", "bounding": [2923.936279296875, 3074.42529296875, 359.9930725097656, 602.6099853515625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "config", "bounding": [1261.9954833984375, 3074.403076171875, 321.4237060546875, 722.6116333007812]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "时长（秒）", "bounding": [1274.3919677734375, 3489.5576171875, 292.832763671875, 282.2245178222656]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 8, "title": "高", "bounding": [1277.4017333984375, 3329.556396484375, 287.70556640625, 143.94073486328125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, 