			"widgets_values":[
				"```json\n{\n  \"title\": \"The Dancing Flower\",\n  \"genre\": \"Fantasy\",\n  \"language\": \"Chinese\",\n  \"description\": \"一个奇妙的幻想短片，讲述一朵鲜花在微风中翩翩起舞的故事，展现自然的灵性与生命的美丽。\",\n  \"frames\": [\n    {\n      \"frame_number\": 1,\n      \"description\": \"镜头从一个静谧的花园开始，清晨的阳光洒满花瓣，露珠闪烁，鸟儿在远处轻声鸣叫，营造出宁静的氛围。\",\n      \"camera_angle\": \"广角镜头\",\n      \"lighting\": \"柔和的自然光，带有晨曦的金色调\",\n      \"sound\": \"轻柔的风声伴随着鸟鸣，远处隐隐传来溪流的声音。\",\n      \"action\": \"镜头缓缓推进，聚焦到一朵娇艳的红色花朵，花瓣随风轻轻摆动。\",\n      \"dialogue\": \"无对话，使用自然音效营造氛围。\",\n      \"visual_effects\": \"露珠在阳光下闪烁，花瓣的颜色随着光线微微变化，充满魔幻感。\"\n    },\n    {\n      \"frame_number\": 2,\n      \"description\": \"花瓣开始微微颤动，仿佛有生命一般，风逐渐变得更有节奏，花朵随着风的韵律开始旋转。\",\n      \"camera_angle\": \"中景镜头，跟随花朵的旋转运动。\",\n      \"lighting\": \"阳光逐渐增强，形成光晕效果，花朵周围的背景开始模糊，突显主体。\",\n      \"sound\": \"背景音乐渐渐响起，轻盈的钢琴旋律与风声交织在一起。\",\n      \"action\": \"花朵的动作变得更加流畅，花瓣像舞者的裙摆一样旋转，周围的花草也开始随之摆动。\",\n      \"dialogue\": \"无对话，音乐和环境音效塑造氛围。\",\n      \"visual_effects\": \"花朵的旋转带动周围空气形成轻微涟漪，阳光在花瓣上跳跃，仿佛为其打光。\"\n    },\n    {\n      \"frame_number\": 3,\n      \"description\": \"镜头拉远，整个花园变成一个舞台，所有的花朵都开始随着风的节奏摇摆，形成一场自然的舞蹈表演。\",\n      \"camera_angle\": \"鸟瞰镜头，俯视整个花园。\",\n      \"lighting\": \"金色阳光充满画面，花园被柔光笼罩，形成梦幻般的场景。\",\n      \"sound\": \"背景音乐逐渐加入弦乐与轻快的打击乐，增强舞蹈的节奏感。\",\n      \"action\": \"镜头缓慢移动，展示花园的全貌，花朵们宛如舞者，形成波浪般的舞动。\",\n      \"dialogue\": \"无对话，音乐为主。\",\n      \"visual_effects\": \"花园的色彩变得更加饱满，花朵的舞动带起的风形成彩色的光线轨迹。\"\n    },\n    {\n      \"frame_number\": 4,\n      \"description\": \"镜头回到红色花朵，它慢慢停下舞动，阳光渐渐变得柔和，花园恢复宁静。\",\n      \"camera_angle\": \"特写镜头，聚焦红色花朵的花瓣，展示细节。\",\n      \"lighting\": \"夕阳的橙红色光线洒在花朵上，形成温暖的收尾氛围。\",\n      \"sound\": \"背景音乐渐渐淡出，风声减弱，鸟鸣再次响起。\",\n      \"action\": \"红色花朵微微颤动，最终停止，镜头缓缓拉远，花园再度静谧。\",\n      \"dialogue\": \"无对话，画面静谧。\",\n      \"visual_effects\": \"夕阳的光线在花瓣上形成渐变效果，周围的景物逐渐模糊，画面慢慢转暗。\"\n    }\n  ]\n}\n```"
