noverall_soundscape\nA soft, natural breeze sound flows continuously throughout the video. Faint, ethereal whooshing sounds occur as the fabric of the Hanfu sleeves flutters in the wind. There is a subtle, delicate sound of hair moving against the skin.\nnon_diegetic_music\nA soft, ambient instrumental track featuring a solo Chinese guzheng and a faint string pad. The tempo is slow and flowing, with gentle, sustained notes that rise and fall like the wind, creating a peaceful and airy atmosphere."], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "提示词", "mode": 0, "bgcolor": "#353", "size": [749.43359375, 648.3685302734375], "pos": [-797.35791015625, 6367.943359375], "id": 159, "properties": {"cnr_id": "comfy-core", "ver": "0.25.0", "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 11}, {"outputs": [{"name": "Filenames", "label": "Filenames", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "color": "#222", "widgets_values": {"save_output": true, "filename_prefix": "MiniMax_H3/t2v", "loop_count": 0, "pix_fmt": "yuv420p", "save_metadata": true, "crf": 19, "trim_to_audio": false, "videopreview": {"paused": false, "hidden": false, "params": {"score": 21, "filename": "t2v_00001_p84-audio_hkpyt_1787322281.mp4", "cos_url": "https://rh-images.xiaoyaoyou.com//b76b121d9fdadfb75d5369595624a407/temp/MiniMax_H3/t2v_00001_p84-audio_hkpyt_1787322281.mp4", "workflow": "t2v_00001_p84.png", "fullpath": "/data/ComfyUI/personal/b76b121d9fdadfb75d5369595624a407/temp/MiniMax_H3/t2v_00001_p84-audio.mp4", "format": "video/h264-mp4", "subfolder": "MiniMax_H3", "label": "Normal", "type": "temp", "frame_rate": 24}}, "format": "video/h264-mp4", "no_preview": false, "frame_rate": 24, "pingpong": false}, "inputs": [{"name": "images", "link": 323, "label": "images", "type": "IMAGE", "localized_name": "imag