ps", "type": "INT", "localized_name": "audio_steps"}, {"widget": {"name": "shift_video"}, "name": "shift_video", "label": "shift_video", "type": "FLOAT", "localized_name": "shift_video"}, {"widget": {"name": "shift_audio"}, "name": "shift_audio", "label": "shift_audio", "type": "FLOAT", "localized_name": "shift_audio"}], "flags": {}, "id": 220, "type": "MiniMaxH3MultiRateSamplerEXPT8", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MiniMaxH3MultiRateSamplerEXPT8"}, "order": 25}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [289], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [385.29571533203125, 360.5064392089844], "pos": [-2741.161865234375, 4943.7236328125], "widgets_values": ["ad883f52ef029561eb81ab0f008e005c14366d63535a3ec6dc0e642ec9e85617.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 139, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.28.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 17}, {"outputs": [{"name": "STRING", "links": [279], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["5秒，16:9，电影级半写实3D动画短剧，一镜到底。\n\n【参考图】\n参考图1是陈默的唯一人物形象，必须保持他的五官、发型、年龄、\n身材比例、蓝色衬衫、深灰色T恤、黑色长裤完全一致。\n\n参考图2是固定公寓场景，保持入户门、玄关柜、餐桌、厨房、\n沙发及所有家具的位置和空间结构不变。\n\n【镜头设计】\n35mm电影镜头，中景跟拍，平视视角。\n摄影机位于客厅靠近沙发的一侧，朝向左侧入户门和后方厨房。\n画面左侧是入户门与玄关，画面右后方能够看见餐桌和厨房。\n\n陈默始终位于画面左侧至中间区域，厨房保留在画面纵深处。\n使用前景玄关、中景人物、后景厨房的三层空间构图。\n\n镜头开始时保持固定；陈默进屋后，摄影机非常缓慢地向后平移，\n同时轻微向右调整构图，始终保持陈默上半身和换鞋动作清楚可见。\n运镜平稳克制，无摇晃、无环绕、无突然推进、无镜头切换。\n\n【动作与运镜节奏】\n0—1秒：\n深棕色防盗门从画面左侧向室内打开。\n陈默拎着通勤包走进屋，摄影机轻微向后平移，让出人物行动空间。\n\n1—2.5秒：\n陈默站在玄关门垫上，反手轻轻带门，\n随手将钥匙放到玄关柜面。\n镜头继续缓慢后移，保持腰部以上的中景构图。\n\n2.5—4秒：\n陈默低头弯腰换鞋。\n摄影机停止后移，保持稳定，通过画面纵深同时带到远处厨房。\n厨房汤锅冒出少量自然热气。\n\n4—5秒：\n远处传来汤锅咕嘟声和汤勺轻碰锅沿的声音。\n陈默换鞋动作突然停住，手悬在鞋边，脊背轻微绷紧。\n他没有立刻站起来，只缓慢抬眼望向厨房。\n\n最后0.5秒，摄影机极其轻微地向陈默推进，\n画面由普通中景自然收紧为中近景，\n突出他从疲惫放松转为警觉疑惑的眼神。\n\n【人物表演】\n陈默刚下班回家，开始时略显疲惫，动作自然随意。\n听见厨房声音后，表情不要突然夸张：\n先是动作停顿，然后眼神凝住，眉头轻微收紧，\n呼吸放缓，身体产生本能警觉。\n\n【灯光与画面】\n室内使用温暖的橙黄色灯光，门外透入微弱冷蓝色走廊光。\n暖色公寓与冷色门外形成自然冷暖对比。\n电影级景深、柔和体积光、真实布料和头发运动。\n厨房位于背景，轻微虚化但仍能辨认汤锅热气。\n\n【声音】\n开门声、轻微脚步声、衣料摩擦声、\n钥匙落在木质柜面的清脆声、远处汤锅咕嘟声、\n汤勺轻碰锅沿的金属声。\n\n最后一秒环境声骤然收窄，只保留轻微锅声和陈默呼吸声。\n陈默的内心独白“家里有人？”后期添加，不在视频中直接说出。\n\n【限制】\n林晚不出现在画面中。\n不要对白、字幕、文字和水印。\n不要人物变脸、换装、多余人物、多余手指。\n不要家具移动、出现多个房门或改变房间结构。\n不要快速推拉、环绕运镜、手持抖动、镜头跳切。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [865.8831787109375, 885.5226440429688], "pos": [-4634.6455078125, 4862.83984375], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.28.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 18}, {"outputs": [{"name": "FLOAT", "links": [261], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "color": "#322", "widgets_values": [5], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "type": "PrimitiveFloat", "title": "Float (Duration)", "mode": 0, "bgcolor": "#533", "size": [270, 70], "pos": [-1461.813232421875, 5729.68017578125], "id": 132, "properties": {"cnr_id": "comfy-core", "ver": "0.28.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R"