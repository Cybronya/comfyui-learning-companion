 "type": "INT", "localized_name": "frame_count"}, {"shape": 6, "name": "source_images", "label": "source_images", "type": "IMAGE", "localized_name": "source_images"}, {"name": "report", "links": [30], "label": "report", "type": "STRING", "localized_name": "report"}, {"shape": 6, "name": "images_pre_refine", "label": "images_pre_refine", "type": "IMAGE", "localized_name": "images_pre_refine"}], "size": [1149.5631103515625, 1834.052490234375], "pos": [-327.2446594238281, 119.46601104736328], "widgets_values": ["i2v — 图生视频(Image to Video)", "", "采样设置", 1, 199664872483180, "randomize", 24, 1216, 672, 1216, 761, "{\"version\":5,\"editMode\":\"segment\",\"totalFrames\":761,\"frameRate\":24,\"video\":{\"fileName\":\"\",\"videoFile\":\"\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[]},\"videoClips\":[],\"global\":{\"taskType\":\"i2v — 图生视频(Image to Video)\",\"prompt\":\"\",\"refs\":[],\"refAudios\":[],\"referenceVideo\":{\"videoFile\":\"\",\"fileName\":\"\",\"type\":\"input\",\"subfolder\":\"\"},\"continuousReference\":false,\"commonEnabled\":false,\"commonCollapsed\":false,\"refVideos\":[],\"genImage\":{\"imageFile\":\"\"},\"sourceWidth\":1186,\"sourceHeight\":994},\"output\":{\"mode\":\"fixed\",\"aspectRatio\":\"16:9 (宽屏)\",\"megapixels\":0.8,\"multiple\":32,\"longEdge\":1216,\"width\":1216,\"height\":672,\"maxExportFrames\":0,\"exportMode\":\"all\",\"audioMode\":\"generate\",\"refImageSize\":\"match\",\"continuityEnabled\":true,\"continuityOverlapFrames\":22},\"runSelectEnabled\":false,\"runSelection\":[],\"liveTaePreview\":true,\"segments\":[{\"id\":\"mt8qvqio0x0ce\",\"start\":0,\"length\":107,\"frameCount\":107,\"durationSec\":4,\"prompt\":\"@图片1：锁定小刚倒酒初始状态（列车包厢，冷峻情绪）。\\n必须保持人物/场景一致性，禁止风格突变。\\n\\n【核心创意】\\n0-4秒，电影感写实风格。\\n小刚在昏暗包厢内独坐倒酒，气氛压抑。\\n\\n【画面过程说明】\\n0-4秒：\\n远景转中景，基于@图片1，小刚神色冷峻，将酒缓缓倒入杯中。镜头慢速向前推进（Push-in），聚焦人物与酒杯。\",\"negativePrompt\":\"\",\"taskType\":\"\",\"refs\":[],\"refAudios\":[],\"refVideos\":[],\"genImage\":{\"imageFile\":\"9a38546d9fc