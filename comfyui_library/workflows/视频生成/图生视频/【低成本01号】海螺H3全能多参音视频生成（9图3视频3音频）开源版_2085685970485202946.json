_name": "height"}], "color": "#14acb7", "widgets_values": ["9:16 (Portrait Widescreen)", 1, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "title": "Resolution Selector (Size)", "mode": 0, "bgcolor": "#0098a3", "size": [336.4831848144531, 175.01751708984375], "pos": [-1465.499755859375, 5644.6748046875], "id": 115, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"aspect_ratio": true, "megapixels": true, "multiple": true}, "Node name for S&R": "ResolutionSelector"}, "order": 11}, {"outputs": [{"name": "AUDIO", "links": [], "label": "音频", "type": "AUDIO", "localized_name": "音频"}], "color": "#322", "widgets_values": ["None", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadAudio", "mode": 4, "bgcolor": "#533", "size": [384.69415283203125, 161.0877227783203], "pos": [-2459.95263671875, 6060.462890625], "id": 155, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio", "ttNbgOverride": {"bgcolor": "#533", "groupcolor": "#A88", "color": "#322"}}, "order": 12}, {"outputs": [], "color": "#432", "widgets_values": ["生成一段 15 秒、9:16 竖屏、真人电影质感的科幻爱情悬疑视频。\n\n整体风格真实、克制、细腻、带悬疑感，画面昏暗，具有复古时间研究气质。画面要像电影场景，人物表演自然，情绪真实，镜头稳定清晰。不要字幕，不要水印，不要屏幕文字。\n\n【最高优先级总规则】\n如果对白、角色一致性、镜头设计之间发生冲突，优先保证：\n1. 对白完整正确\n2. 正确角色说正确台词\n3. 口型自然\n4. 人物外观与参考图一致\n5. 情绪特写和关键动作\n复杂运镜和镜头变化优先级低于对白准确性。\n\nDialogue accuracy is more important than complex camera movement. Prioritize correct spoken lines, correct speaker identity, natural lip sync, emotional close-up shots, and character consistency.\n\n【参考图规则】\n参考图1：Livia（莉维亚）的角色外观参考。只生成一名 Livia。保持固定面容、深棕色短卷发、卡其色工作服、浅蓝色高领内搭、皮革肩带和工具包。\n\n参考图2：Kallus（卡勒斯）的角色外观参考。只生成一名 Kallus。保持固定面容、黑色背梳头发、灰蓝色长风衣、黑色高领衫、皮革肩带、黑裤、棕色靴子。\n\n参考图3：时间陋室场景参考。固定场景是隐藏在地下工作室暗门后的狭窄黑色房间，深色石墙、旧木地板、一张旧木桌或旧木椅、一盏静静燃烧的黄铜油灯、一扇狭窄高窗，空气中有少量灰尘，整体昏暗封闭，带复古时间研究气质。场景布局、空间气质和灯光氛围参考图3。\n\n【道具规则】\n全片只有 Livia 手中的一块蓝色雕花怀表。\nKallus 身上不得出现第二块怀表。\n\n【最高优先级：对白必须完整保留】\n以下 5 句英语台词必须全部完整生成，顺序绝对不能改变，不能删除、不能合并、不能改写，必须由正确角色说出，英语发音清楚，口型自然，不显示字幕：\n\n1. Kallus: \"You came back.\"\n2. Livia: \"I promised I would.\"\n3. Livia: \"I don’t want to lose you again.\"\n4. Kallus: \"You are the reason I keep returning.\"\n5. Off-screen female voice (Margs): \"Livia.\"\n\n绝对不要漏掉任何一句台词。不要添加额外对白。\n\n【声音规则：非常重要】\n全片绝对禁止任何背景音乐、配乐或音乐性声音。\nNO BGM. NO MUSIC. NO SCORE.\n\n全片只能包含以下声音内容：\n1. 角色对白\n2. Margs 的女性画外音\n3. 真实拟音（Foley）\n4. 自然环境声和室内空间声\n\n绝对不要生成：\n- 背景音乐\n- 电影配乐\n- 爱情配乐\n- 悬疑配乐\n- 弦乐、钢琴、电子音乐\n- 合成器铺底\n- 音乐性氛围 Pad\n- 低频音乐 Drone\n- 任何旋律、节奏、和弦、音乐性音垫\n\n允许生成并且希望清楚听到的音效：\n- 暗门开启和关闭声\n- 脚步声\n- 衣料摩擦声\n- 皮革肩带轻微摩擦声\n- 怀表被拿起、握住和移动时的细微金属声\n- 怀表内部轻微机械运转声\n- 油灯火焰燃烧声\n- 两人握手时细微的衣物与皮革摩擦声\n- 接吻时非常轻微、自然、克制的人体动作声和呼吸声\n- 油灯火焰剧烈摇晃时的自然火焰变化声\n- 油灯突然熄灭时轻微“噗”的声音\n- 油灯熄灭后更明显的室内空间回声和寂静感\n\nMargs 最后说 “Livia.” 时，声音冷静、成熟，带一点空间回响，仿佛从四周石墙深处传来，但不要用任何音乐去渲染。\n\nAudio must contain dialogue, realistic Foley and natural room ambience only. No background music at any point.\n\n【剧情内容】\n本段采用独立的新开场，不承接上一段尾帧。允许镜头切换，但不要过度复杂，重点突出人物情绪、对白、关键道具和悬疑氛围。镜头语言清晰、稳定、可读性强。\n\n故事流程如下：\n\n开场，Livia 手中的蓝色雕花怀表轻微震动，表盘浮现抽象坐标光纹。她抬头看向暗门，推门进入时间陋室。油灯在画面深处静静燃烧，房间昏暗、安静、封闭。\n\nLivia 进入后，看见 Kallus 已经站在油灯旁等待。Kallus 原本紧绷的神情缓和，露出很浅的笑意，看向 Livia，说：\n\"You came back.\"\n\nLivia 走到 Kallus 面前，眼神温柔而坚定。她轻轻握住 Kallus 的手，说：\n\"I promised I would.\"\n\nLivia 注视着 Kallus，声音轻但认真，说：\n\"I don’t want to lose you again.\"\n\nKallus 看着她，眼中带着孤独、依赖和克制的爱意，说：\n\"You are the reason I keep returning.\"\n\n随后两人靠近。Livia 眼中闪过心疼，她踮起脚，双手仍握着 Kallus，主动吻上他。Kallus 短暂怔住，随后轻轻回应。这个吻必须短暂、坚定、克制，不热烈，不色情，持续约 1 到 1.5 秒。\n\n两人分开少许，额头距离很近。蓝色怀表在两人之间发出微弱光芒，油灯火焰开始剧烈摇晃。随后火焰被无形力量拉长并突然熄灭。整个时间陋室陷入黑暗，只剩怀表极弱的蓝光和高窗外的微弱冷光。\n\n最后，Livia 在黑暗中侧脸转头，一道冷静、成熟的女性画外音从四周墙体深处传来：\n\"Livia.\"\n\n最后停留在 Livia 警觉转头的表情上，以悬疑感收尾。\n\n【镜头建议】\n可以使用近景、中近景、过肩镜头、手部特写、怀表特写、油灯特写，但不要为了复杂运镜牺牲对白准确性。优先表现人物表情、口型、握手、短暂亲吻、怀表发光、油灯熄灭和最后的警觉转头。\n\n【严格禁止】\n- 删除、改写、打乱任何一句台词\n- 漏掉任何一句台词\n- 错误角色说台词\n- 添加额外对白\n- 字幕、文字、水印\n- 任何背景音乐 BGM\n- 任何电影配乐或情绪配乐\n- 任何旋律、节奏、和弦\n- 任何音乐性 Drone / Pad / Synth ambience\n- Margs 实体出现\n- 额外人物\n- 第二块怀表\n- 过度热烈或色情的亲吻\n- 长时间接吻\n- 人物换脸、换装\n- 多余手指、手臂穿模\n- 普通现代房间\n- 明亮环境\n- 夸张爆炸  "], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [456.8118591308594, 347.8723449707031], "pos": [-3154.99267578125, 5133.646484375], "id": 161, "properties": {"widget_ue_connectable": {}}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["生成15秒、9:16竖屏、真人电影质感的科幻爱情悬疑短剧。\n\n【参考图】\n参考图1：莉维亚。图中所有女性视角都是同一个莉维亚，只生成一名女性，锁定她的人脸、深棕色短卷发、卡其色服装、浅蓝高领内搭、皮革肩带和蓝色雕花怀表。\n\n参考图2：卡勒斯。图中所有男性视角都是同一个卡勒斯，只生成一名男性，锁定他的人脸、黑色背梳发型、灰蓝长风衣、黑色高领衫、体型和皮革配饰。\n忽略参考图2中出现的蓝色怀表小框，卡勒斯不得拥有怀表。\n\n参考图3：时间陋室。只锁定石墙、穹顶结构、木桌、窄窗、金属门、复古材质和整体空间设计。\n注意：参考图3中的油灯虽然点亮，但本段剧情中油灯必须已经熄灭，以剧情提示词为准。\n\n全片只有莉维亚持有的一块蓝色雕花怀表。\n画面中只允许出现莉维亚和卡勒斯两名实体人物。\n玛格丝只有画外音，不出现本人、人影或脸。\n\n【对白】\n以下9句英语对白全部保留，顺序绝对不能改变，不得删除、缩短、合并或改写：\n\n1. Livia: “Margis.”\n2. Margis voice: “Do you know what you are saving?”\n3. Livia: “A person.”\n4. Margis voice: “No.”\n5. Margis voice: “You are saving a mistake.”\n6. Livia: “What do you mean?”\n7. Margis voice: “Your father opened the time fracture to save Callus.”\n8. Margis voice: “And he died because of it.”\n9. Livia: “Is it true?”\n\n英语发音自然清晰，莉维亚说话时口型准确。玛格丝为成熟、冷静、克制的女性画外音。无字幕。\n\n【分镜】\n\n0—1.2秒：\n莉维亚面部近景。黑暗的时间陋室内，她突然听见墙壁深处的声音，迅速转头，警觉说道：\n“Margis.”\n\n1.2—3秒：\n切黑色石墙和熄灭油灯近景。房间昏暗，墙体出现非常轻微的透明时间波纹。\n玛格丝画外音：\n“Do you know what you are saving?”\n\n3—4秒：\n切莉维亚中近景。她立刻握紧卡勒斯的手，身体微微挡在他前方，坚定回答：\n“A person.”\n\n4—4.6秒：\n切熄灭油灯超近景。\n玛格丝画外音：\n“No.”\n\n4.6—6秒：\n切卡勒斯近景。他没有说话，表情迅速变得凝重，微微低下视线。\n玛格丝画外音：\n“You are saving a mistake.”\n\n6—7.1秒：\n切莉维亚正面特写，她皱眉追问：\n“What do you mean?”\n\n7.1—10.2秒：\n快速切换多个特写：\n莉维亚手中的蓝色怀表；\n桌上泛黄的父亲研究档案；\n旧时间研究图纸和手写公式；\n卡勒斯沉默低头的侧脸。\n\n不要生成父亲本人或父亲的清晰照片。\n\n玛格丝画外音连续完整说道：\n“Your father opened the time fracture to save Callus.”\n\n10.2—11.7秒：\n切莉维亚面部极近特写。她听到父亲后瞳孔轻微收缩，呼吸停顿。\n玛格丝继续：\n“And he died because of it.”\n\n11.7—13秒：\n切双人中近景。房间陷入压抑寂静。\n莉维亚仍握着卡勒斯的手，随后缓慢转头看向他。\n卡勒斯避开她的目光，低下头，保持沉默。\n\n13—15秒：\n莉维亚过肩拍卡勒斯近景。\n莉维亚带着震惊、怀疑和受伤，问：\n“Is it true?”\n\n卡勒斯绝对不要回答，只低头沉默。\n最后停留约0.5秒。\n\n【声音】\n绝对不要BGM，不要任何背景音乐。\n\n只允许：\n英语对白；\n玛格丝空间感画外音；\n自然呼吸；\n衣料摩擦；\n怀表轻微机械滴答；\n低沉室内环境声；\n非常轻微的时间共振声；\n油灯熄灭后的安静空间声。\n\n“And he died because of it.”之后，环境声短暂降低，增强冲击感。\n\n【禁止】\nBGM、背景音乐、字幕、文字、水印；\n玛格丝实体出现；\n第三个人出现；\n父亲本人出现；\n生成父亲清晰人脸；\n第二块怀表；\n卡勒斯持有怀表；\n卡勒斯提前说话；\n删除或改变任何对白；\n换脸、换装；\n多人复制；\n爆炸、打斗、夸张魔法；\n多余手指、肢体穿模。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [550.5538940429688, 406.16680908203125], "pos": [-3187.18701171875, 5666.31494140625], "id": 162, "properties": {"widget_ue_connectable": {}}, "order": 14}, {"outputs": [], "color": "#432", "widgets_values": ["生成15秒、9:16竖屏、真人电影质感的科幻爱情悬疑短剧。\n\n【参考图】\n参考图1：莉维亚。图中所有女性视角都是同一个莉维亚，只生成一名女性，锁定她的人脸、深棕色短卷发、卡其色服装、浅蓝高领内搭、皮革肩带和蓝色雕花怀表。\n\n参考图2：卡勒斯。图中所有男性视角都是同一个卡勒斯，只生成一名男性，锁定他的人脸、黑色背梳发型、灰蓝长风衣、黑色高领衫、体型和皮革配饰。忽略参考图2中出现的怀表小框，卡勒斯不得拥有怀表。\n\n参考图3：时间陋室。只锁定石墙、穹顶结构、木桌、窄窗、金属门、复古材质和整体空间设计。\n\n本段开场时油灯仍然熄灭，后半段油灯会重新点亮，以剧情提示为准。\n\n全片只有莉维亚持有的一块蓝色雕花怀表。\n画面中只允许出现莉维亚和卡勒斯两名实体人物。\n玛格丝只有画外音，不出现本人、人影或脸。\n\n【对白】\n以下8句英语对白全部保留，顺序绝对不能改变，不得删除、缩短、合并或改写：\n\n1. Callus: “Your father saved me.”\n2. Livia: “But he lost everything.”\n3. Margis voice: “I tried to stop him.”\n4. Margis voice: “But someone must face the consequence.”\n5. Callus: “Margis, this is not the answer.”\n6. Margis voice: “Callus must return to where time belongs.”\n7. Livia: “I need the truth.”\n8. Livia: “Not someone else’s version.”\n\n英语发音自然清晰，人物说话时口型准确。玛格丝为成熟、冷静、克制的女性画外音。无字幕。\n\n【分镜】\n\n0—1.8秒：\n卡勒斯低头近景。房间昏暗，怀表蓝光从下方微微照亮他的侧脸。他终于承认，带着愧疚和痛苦低声说道：\n“Your father saved me.”\n\n1.8—3秒：\n切莉维亚面部近景。她听完后眼神一震，情绪复杂，心痛又克制，立刻接道：\n“But he lost everything.”\n\n3—4.5秒：\n切桌面与旧档案特写。泛黄研究资料、旧时间研究图纸、纸页边缘在无形气流中轻微颤动。不要生成父亲本人或清晰父亲脸。\n玛格丝画外音：\n“I tried to stop him.”\n\n4.5—6.3秒：\n切黑暗石墙与房间角落近景，墙体深处出现非常轻微的透明时间波纹。\n玛格丝画外音继续：\n“But someone must face the consequence.”\n\n6.3—8秒：\n切卡勒斯侧面近景。他抬起头，第一次直面黑暗中的声音，神情从愧疚转为坚定和反抗，说道：\n“Margis, this is not the answer.”\n\n8—10秒：\n切双人中近景，莉维亚与卡勒斯都处于压抑的沉默中，蓝色怀表微光照亮两人轮廓。\n玛格丝最后施压的画外音从房间四周传来：\n“Callus must return to where time belongs.”\n\n10—11秒：\n玛格丝声音消失后，黄铜油灯突然自己重新点亮。暖黄色火焰瞬间照亮房间，光线从冷蓝转为冷暖混合。莉维亚和卡勒斯都被灯光变化吸引，微微转头。\n\n11—12.7秒：\n切莉维亚正面近景。她看着卡勒斯，没有再让任何人替他说完故事。她清晰坚定地说道：\n“I need the truth.”\n\n12.7—15秒：\n切莉维亚极近特写，再切怀表和她的眼睛交替特写。她低头看一眼蓝色雕花怀表，又抬眼看向卡勒斯，坚定补上一句：\n“Not someone else’s version.”\n\n最后停留在莉维亚清醒、受伤但坚定的表情上约0.5秒，作为下一段承接点。\n\n【声音】\n绝对不要BGM，不要任何背景音乐。\n\n只允许：\n英语对白；\n玛格丝空间感画外音；\n自然呼吸；\n衣料摩擦；\n怀表轻微机械滴答；\n轻微纸张摩擦声；\n低沉室内环境声；\n极轻微时间共振声；\n油灯重新点亮时短促自然的燃烧声。\n\n【表演】\n莉维亚：从震惊、心痛，逐渐转为清醒和坚定。不能夸张哭喊。\n卡勒斯：愧疚、沉重、承认事实，但在玛格丝逼迫时仍然会反驳。\n玛格丝：理性、冷静、克制，不咆哮，不邪恶化。\n\n【禁止】\nBGM、背景音乐、字幕、文字、水印；\n玛格丝实体出现；\n第三个人出现；\n父亲本人出现；\n生成父亲清晰人脸；\n第二块怀表；\n卡勒斯持有怀表；\n删除或改变任何对白；\n换脸、换装；\n多人复制；\n爆炸、打斗、夸张魔法；\n多余手指、肢体穿模。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [653.1511840820312, 88], "pos": [-3200.913818359375, 6397.38232421875], "id": 163, "properties": {"widget_ue_connectable": {}}, "order": 15}, {"outputs": [], "color": "#432", "widgets_values": ["生成15秒、9:16竖屏、真人电影质感的科幻爱情悬疑短剧。\n\n【参考图】\n参考图1：莉维亚。图中所有女性视角都是同一个莉维亚，只生成一名女性，锁定她的人脸、深棕色短卷发、卡其色服装、浅蓝高领内搭、皮革肩带和蓝色雕花怀表。\n\n参考图2：卡勒斯。图中所有男性视角都是同一个卡勒斯，只生成一名男性，锁定他的人脸、黑色背梳发型、灰蓝长风衣、黑色高领衫、体型和皮革配饰。忽略参考图2中出现的怀表小框，卡勒斯不得拥有怀表。\n\n参考图3：时间陋室。只锁定石墙、穹顶结构、木桌、窄窗、金属门、复古材质和整体空间设计。本段中油灯已经重新点亮，以剧情提示为准。\n\n全片只有莉维亚持有的一块蓝色雕花怀表。\n画面中只允许出现莉维亚和卡勒斯两名实体人物。\n\n【关键道具】\n一枚不起眼的银色素圈戒指，简单、无宝石、无复杂雕花、略有磨损、低调复古。\n这一枚银色素圈原本戴在卡勒斯的小指上。\n全片只能有这一枚银色素圈，不能生成钻戒、婚戒盒、宝石戒指或多枚戒指。\n\n【对白】\n以下5句英语对白全部保留，顺序绝对不能改变，不得删除、缩短、合并或改写：\n\n1. Livia: “Why?”\n2. Callus: “No matter how broken time becomes…”\n3. Callus: “I will return here and wait for you.”\n4. Livia: “Then I will find the truth.”\n5. Callus: “Remember me.”\n\n英语发音自然清晰，人物说话时口型准确。无字幕。\n\n【分镜】\n\n0—1.8秒：\n卡勒斯右手超近特写。他缓慢从自己的小指上取下一枚不起眼的银色素圈。戒指必须简单朴素、无宝石。油灯暖光照在他的手指和戒指上。\n\n1.8—3秒：\n切双手微距。卡勒斯托起莉维亚的一只手，把银色素圈轻轻戴到她的手指上。莉维亚低头看着戒指，神情疑惑、动摇、心痛，问：\n“Why?”\n\n3—5秒：\n切卡勒斯正面近景。油灯暖光和怀表蓝光同时照亮他的脸。他认真注视莉维亚，清晰说道：\n“No matter how broken time becomes…”\n\n5—7秒：\n切莉维亚过肩拍卡勒斯近景，或卡勒斯半身近景。卡勒斯继续完整说道：\n“I will return here and wait for you.”\n\n7—8.5秒：\n切莉维亚面部近景。她握住戴着银色素圈的那只手，眼神从受伤转为坚定，回答：\n“Then I will find the truth.”\n\n8.5—10秒：\n快速插入镜头组：油灯火焰轻轻摇晃；蓝色雕花怀表在莉维亚手中轻微震动；两人交握的手；卡勒斯意识到时间正在逼近。远处响起低沉钟声，怀表表针突然跳动。\n\n10—11.5秒：\n切卡勒斯面部近景。他知道自己要离开了，但仍然看着莉维亚，低声说道：\n“Remember me.”\n\n11.5—12.2秒：\n切双人中景。莉维亚本能地更用力抓住他的手。第二声低沉钟声响起。房间空气出现一瞬间轻微时间折射。\n\n卡勒斯必须在一个瞬间被时间直接带走：\n前一帧他还完整站在莉维亚面前，\n后一帧原地只剩空气。\n不能慢慢透明，不能化成光点，不能逐渐消散，不能碎裂，不能爆炸。\n\n12.2—13.5秒：\n切莉维亚中近景。她的手还停留在半空，保持刚才想抓住卡勒斯的姿势。她短暂怔住，看着卡勒斯刚刚消失的位置。背景中的木椅或衣摆轻微晃动，表现空间余波。\n\n13.5—15秒：\n结尾蒙太奇：银色素圈微距；蓝色雕花怀表微距；莉维亚低头看戒指，再看怀表；最后抬起头，眼神从失落转为坚定。镜头缓慢推近她的脸，油灯在她身后燃烧，作为本集结尾。\n\n【声音】\n绝对不要BGM，不要任何背景音乐。\n\n只允许：\n英语对白；\n自然呼吸；\n衣料摩擦；\n戒指轻触手指的细微金属声；\n怀表轻微机械震动声；\n低沉钟声两次；\n油灯燃烧声；\n低沉室内环境声；\n卡勒斯消失瞬间的短暂真空抽离声或时间抽离声，但不能是爆炸声。\n\n【表演】\n莉维亚：疑惑、动摇、心痛，随后重新坚定。卡勒斯消失后不是嚎哭，而是强烈失落后迅速压住情绪。\n卡勒斯：温柔、克制、带不舍，但语气坚定，不拖沓。\n两人的情感要真实、内敛，不夸张。\n\n【禁止】\nBGM、背景音乐、字幕、文字、水印；\n删除或改变任何对白；\n银色素圈变成钻戒、宝石戒指、复杂珠宝；\n生成多枚戒指；\n第二块怀表；\n卡勒斯持有怀表；\n卡勒斯慢慢消散；\n透明渐变、光点飞散、身体碎裂、爆炸消失；\n额外人物；\n换脸、换装；\n多人复制；\n打斗、夸张魔法；\n多余手指、肢体穿模。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [571.5089721679688, 483.7038879394531], "pos": [-3147.801513671875, 6570.14697265625], "id": 164, "properties": {"widget_ue_connectable": {}}, "order": 16}, {"outputs": [{"name": "IMAGE", "links": [278], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "