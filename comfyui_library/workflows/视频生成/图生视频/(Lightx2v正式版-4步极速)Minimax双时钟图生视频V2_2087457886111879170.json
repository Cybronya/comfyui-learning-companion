ors", 1], "inputs": [{"name": "model", "link": 57, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "type": "LoraLoaderBypassModelOnly", "title": "lora only", "mode": 0, "bgcolor": "#653", "size": [380, 106], "pos": [-6.038707256317139, -72.4306640625], "id": 2, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderBypassModelOnly"}, "order": 18}, {"mode": 0, "outputs": [{"name": "FLOAT", "links": [20], "label": "FLOAT", "type": "FLOAT", "localized_name": "浮点"}], "size": [270, 70], "pos": [-795.690185546875, 178.76646423339844], "widgets_values": [15], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "值"}], "flags": {}, "id": 14, "type": "PrimitiveFloat", "title": "Float (duration)", "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 10}, {"mode": 0, "outputs": [{"name": "prompt", "links": [53], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [302.32904052734375, 250.54905700683594], "pos": [-805.3900146484375, 735.541259765625], "widgets_values": ["【参考素材说明】\n@图片1：人物+物品+场景参考（锁定女性的面部特征、黑色长直发造型、白色泡泡袖蕾丝连衣裙；锁定银色金属质感腋下包的外观：褶皱发圈式肩带、白色蕾丝蝴蝶结、珍珠吊饰、压纹纹理；锁定场景的深棕色幕布背景、复古串珠台灯、玻璃首饰展示柜、蕾丝桌布、暖色串灯光斑与整体暖调柔光氛围）\n补充约束：只参考上述指定维度，全片保持人物、包包、场景三者一致，不新增其他人物或物品。\n\n【核心创意】\n15秒，16:9 横版，复古暖调写实人像风格。一位黑长直发、穿白色蕾丝连衣裙的女性（@图片1）在复古室内场景（@图片1）中试背新买的银色蝴蝶结腋下包（@图片1），变换不同姿势展示包包，最后面向镜头微笑询问。暖调柔光，复古胶片质感，多机位切镜，硬切。\n\n【画面过程描述】\n\nShot 1（0-4s）— 侧身背包展示\n- 景别：全景\n- 场景：复古室内（@图片1），深棕色幕布背景，左侧复古串珠台灯亮着暖光，前景蕾丝桌布与首饰展示柜\n- 主体：女性（@图片1）侧身站立，银色包包背在肩下\n- 运镜：固定机位，缓慢推进（dolly in）\n- 动作：女性侧身站定，缓缓转头看向镜头，展示包包侧面轮廓与全身穿搭\n- 音效：柔和衣料摩擦声、极轻的室内环境音\n- 转场：硬切\n\nShot 2（4-8s）— 变换姿势\n- 景别：中景\n- 场景：同上，背景暖色串灯光斑\n- 主体：女性（@图片1）变换姿势展示包包\n- 运镜：小幅度环绕（truck left + pan right），主体保持居中\n- 动作：女性用指尖轻提褶皱肩带，换成正面姿势将包挽在身前，歪头浅笑，裙摆轻微晃动\n- 音效：肩带摩擦声、珍珠轻微碰撞声\n- 转场：硬切\n\nShot 3（8-11s）— 包包细节\n- 景别：特写\n- 场景：浅景深，背景为暖色虚化光斑\n- 主体：银色腋下包（@图片1），金属压纹表面、白色蕾丝蝴蝶结、珍珠吊饰\n- 动作：女性指尖轻抚蝴蝶结，珍珠吊饰微微晃动，包面流过一道柔和高光\n- 运镜：缓慢横移（truck right）并轻微推近\n- 音效：清脆的珍珠碰撞声、指尖轻擦包面的细响\n- 转场：硬切\n\nShot 4（11-15s）— 对镜说话\n- 景别：中近景\n- 场景：同上，台灯暖光从侧前方照亮面部\n- 主体：女性（@图片1）正面面向镜头，肩上的包包微微提起\n- 运镜：固定机位，极轻微手持感\n- 动作：女性注视镜头，嘴角上扬露出微笑，头轻微倾斜，开口说话\n- 台词：女性说：\"怎么样，我的个包好看吗？\"\n- 音效：柔和室内环境音、台词后自然的轻呼吸声\n- 转场：结束\n\n【整体要求补充】\n▍人物与物品一致性（贯穿全片）\n- 女性面容、黑长直发、白色泡泡袖蕾丝连衣裙与@图片1严格一致\n- 包包始终为@图片1的银色金属腋下包，褶皱肩带、蕾丝蝴蝶结、珍珠吊饰细节完整不缺失\n▍光影氛围（贯穿全片）\n- 暖调柔光、深棕幕布背景、串灯光斑，保持复古人像质感\n▍禁止项（贯穿全片）\n- 不换脸、不换造型、不换包款、不换场景\n\n【不想要】\n- 不出现其他人物\n- 不出现额外文字、Logo、水印\n- 不要冷色调打光或强对比硬光\n- 不要快速跳切和剧烈镜头晃动\n- 非叙事性音乐：N/A"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 36, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 12}, {"mode": 0, "showAdvanced": true, "outputs": [{"name": "width", "links": [21], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [22], "label": "height", "type": "INT", "localized_name": "height"}], "size": [270, 170], "pos": [-789.975830078125, -45.763511657714844], "widgets_values": ["16:9 (Widescreen)", 0.9, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "m