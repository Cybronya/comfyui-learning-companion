15s)：特写，抽油烟机油污只是被蹭花，还是一层，与刮痕并存。\n\n【声音】\n<钢丝球刮金属刺耳声>；<喘气声>；(音乐紧张)\n\n【正向稳定约束】\n下午白天光线；婆婆在抽油烟机前的站位；厨房油污状态不变；承接片段6婆婆拿钢丝球状态；结尾油污蹭花状态作为片段8衔接点；禁止字幕文字LOGO水印。", 1344, 768, 124, "auto — 自动判断", "native", 1, false, 0, true, "match", "official_2_to_15s"], "inputs": [{"name": "clip", "link": 3, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "video_vae", "link": 4, "label": "video_vae", "type": "VAE", "localized_name": "video_vae"}, {"name": "audio_vae", "link": 5, "label": "audio_vae", "type": "VAE", "localized_name": "audio_vae"}, {"shape": 7, "name": "drive_audio", "label": "drive_audio", "type": "AUDIO", "localized_name": "drive_audio"}, {"shape": 7, "name": "final_audio", "label": "final_audio", "type": "AUDIO", "localized_name": "final_audio"}, {"shape": 7, "name": "first_frame", "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"shape": 7, "name": "ref_images.ref_image_0", "link": 56, "label": "ref_images.ref_image_0", "type": "IMAGE", "localized_name": "ref_image_0"}, {"shape": 7, "name": "ref_images.ref_image_1", "link": 59, "label": "ref_images.ref_image_1", "type": "IMAGE", "localized_name": "ref_image_1"}, {"shape": 7, "name": "ref_images.ref_image_2", "link": 60, "label": "ref_image_2", "type": "IMAGE", "localized_name": "ref_image_2"}, {"shape": 7, "name": "ref_images.ref_image_3", "label": "ref_image_3", "type": "IMAGE", "localized_name": "ref_image_3"}, {"shape": 7, "name": "ref_videos.ref_video_0", "label": "ref_videos.ref_video_0", "type": "IMAGE", "localized_name": "ref_video_0"}, {"shape": 7, "name": "ref_video_audios.ref_video_audio_0", "label": "ref_video_audios.ref_video_audio_0", "type": "AUDIO", "localized_name": "ref_video_audio_0"}, {"shape": 7, "name": "ref_audios.ref_audio_0", "label": "ref_audios.ref_audio_0", "type": "AUDIO", "localized_name": "ref_audio_0"}, {"widget": {"name": "prompt"}, "name