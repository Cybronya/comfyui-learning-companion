d", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadAudio", "mode": 4, "bgcolor": "#355", "size": [499.7694091796875, 136], "pos": [-929.296142578125, 5355.3603515625], "id": 147, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 11}, {"outputs": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["@图片1 提供了角色的形象参考（人物参考，锁脸）。\n@音频1 作为目标视频的音色复刻素材，台词如下。\n\n一位穿着红白配色中式女仆装的猫耳少女站在科技感桌前，身旁浮动两块半透明面板，向观众展示三种视频生成模式，桌上放着猫爪盆栽和猫爪笔筒，二次元风格，明亮干净，一镜到底。\n\n0–4 秒：中景，少女（@图片1）站在桌前，右手食指向上举起，左手掌心朝上做\"展示\"手势，左侧浮现的半透明面板亮起，面板上显示图片图标和文字线条。音效：面板弹出的\"叮\"声。台词（画外音）：\"H3 有三种生成模式！\"\n4–9 秒：少女用左手食指指向左侧面板，然后转向右侧面板，右侧面板亮起，上面显示视频播放键和音符图标，少女做出\"上传\"的动作，桌上猫爪盆栽微微晃动。音效：面板切换的\"嗖\"声。台词（画外音，从上个 shot 继续）：\"文生视频、图生视频、还有全能参考。\"\n9–14 秒：少女双手张开做\"融合\"的手势，两块面板同时发出柔和光芒，桌上的平板映出光彩，少女开心地眨眼。音效：面板融合发光的\"嗡\"声。台词（画外音，从上个 shot 继续）：\"图片锁脸、视频锁动作、音频定情绪！\"\n非叙事性音乐：N/A。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [371.8848876953125, 347.5902404785156], "pos": [-2016.3365478515625, 6177.58251953125], "id": 150, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 12}, {"outputs": [{"name": "FLOAT", "links": [261], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "color": "#232", "widgets_values": [10], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "type": "PrimitiveFloat", "title": "Float (Duration)", "mode": 0, "bgcolor": "#353", "size": [270, 70], "pos": [-1464.2972412109375, 5886.45361328125], "id": 132, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveFloat"}, "order": 13}, {"outputs": [{"name": "STRING", "links": [279], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["生成一段10秒、16:9、2K、原生立体声的文戏短片，讲述一对高中男女在静谧街道上关于“秘密约定”的微妙时刻。主角是穿着深蓝色校服的男高中生日高悠真（@图片2），以及身穿同款校服配红色领结的女高中生日高结菜（@图片3）。场景设定在夏日午后的日式住宅街道（@图片1）。\n\n**开篇与主体锁定：**\n*   **男主角**：日高悠真（@图片2），黑发，神情冷静但眼神专注。\n*   **女主角**：日高结菜（@图片3），长黑发红蝴蝶结，表情灵动。\n*   **场景**：绿树成荫的街道（@图片1），阳光斑驳。\n\n**时间线与动作表演（0-10秒）：**\n\n*   **0.0s – 2.5s【建立关系】：** 中景镜头。男孩（@图片2）站在街道一侧的树荫下，双手插在校服裤兜里，目光低垂，似乎在思考什么。女孩（@图片3）站在他对面不到一米处，背靠着电线杆，歪着头看着男孩，嘴角挂着一丝促狭的笑意。两人之间隔着无形的空气，气氛安静却充满张力。\n*   **2.5s – 5.5s【触发与互动】：** 女孩（@图片3）突然直起身体，向前迈了半步，打破了两人之间的平衡。她从口袋深处掏出一张折得整整齐齐的纸条，用力在男孩面前晃了晃。男孩（@图片2）抬起头，目光顺着纸条移动，眼神中闪过一丝惊讶和不易察觉的紧张。\n    *   **女孩轻声说（中文普通话）：** “敢不敢打开看看？” 语气带着挑战，眼神直勾勾地盯着男孩的眼睛。\n    *   **男孩回答（中文普通话）：** “……有什么不敢。” 声音低沉，但很坚定。他缓缓伸出手。\n*   **5.5s – 8.5s【情感转折与结果】：** 特写镜头切换至手部。男孩（@图片2）接过纸条，展开的瞬间，他的瞳孔微微放大。女孩（@图片3）凑近了一些，几乎能听到彼此的呼吸声。男孩看着纸条上的字，原本紧绷的嘴角慢慢放松，露出了一个极浅的微笑。\n    *   **男孩低声念道（中文普通话）：** “原来是你…”\n    *   **女孩笑着打断（中文普通话）：** “笨蛋，放学老地方见。”\n*   **8.5s – 10.0s【余波与结束】：** 女孩（@图片3）满意地拍了拍男孩的肩膀，转身跑向街道另一端的阳光里，背影轻快。男孩（@图片2）站在原地，低头看着手中的纸条，又看了看女孩远去的背影，最后将纸条小心翼翼地放进胸口口袋，深吸一口气，迈开步子跟了上去。画面定格在两人追逐的阳光路面上。\n\n**剪辑与动作：**\n剪辑节奏由静转动。前2.5秒固定机位捕捉两人的静态对峙；中间通过推镜头强调纸条的出现和对视；后半段随着女孩的奔跑加入轻微的横移运镜。切点精确落在对话转换和肢体动作（递纸条、转身跑）上，保持叙事的流畅性。\n\n**视觉风格：**\n采用清新明亮的日系动漫厚涂风格。色彩强调夏日的通透感，绿色的树叶要呈现出不同层次的翠绿与墨绿，阳光洒在地面的光斑要有质感。人物皮肤渲染细腻，校服材质要有棉织物的厚重感。整体光影对比强烈，营造出午后特有的慵懒与悸动交织的氛围。\n\n**声音设计：**\n*   **环境声：** 持续的背景蝉鸣，偶尔经过的一阵风吹过树叶的沙沙声，远处隐约的自行车铃声。\n*   **动作音：** 纸张展开的脆响，脚步踩在柏油路上的轻微摩擦声，衣物摩擦声。\n*   **音乐：** 前3秒无音乐，纯环境音衬托紧张感。女孩说话时，切入一段柔和的吉他扫弦配乐，旋律简单温暖。在男孩读出“原来是你”时，音乐音量稍弱，突出人声。最后女孩跑开时，音乐情绪上扬，伴随清脆的风铃声收尾。\n*   **对白：** 清晰的中文普通话。女声活泼俏皮，语速稍快；男声沉稳内敛，语调平缓。口型严格同步。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [371.8848876953125, 347.5902404785156], "pos": [-1473.968017578125, 6058.5498046875], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 14}, {"outputs": [{"name": "output", "links": [290], "label": "output", "type": "*", "localized_name": "output"}], "color": "#223", "widgets_values": [2, "auto", true], "inputs": [{"shape": 7, "name": "anything", "link": 293, "label": "anything", "type": "*", "localized_name": "anything"}, {"widget": {"name": "reserved"}, "name": "reserved", "label": "reserved", "type": "FLOAT", "localized_name": "reserved"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"name": "clean_gpu_before"}, "name": "clean_gpu_before", "label": "clean_gpu_before", "type": "BOOLEAN", "localized_name": "clean_gpu_before"}], "flags": {"collapsed": true}, "type": "PainterVRAM", "mode": 0, "bgcolor": "#335", "size": [213.80349731445312, 106], "pos": [148.4941864013672, 5485.69921875], "id": 146, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PainterVRAM"}, "order": 21}, {"outputs": [{"name": "MODEL", "links": [292], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#223", "widgets_values": ["auto", false], "inputs": [{"name": "model", "link": 287, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "sage_attention"}, "name": "sage_attention", "label": "sage_attention", "type": "COMBO", "localized_name": "sage_attention"}, {"widget": {"name": "allow_compile"}, "sha