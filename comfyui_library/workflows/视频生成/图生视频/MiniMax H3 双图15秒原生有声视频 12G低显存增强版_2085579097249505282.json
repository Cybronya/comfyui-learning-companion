oad_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}, {"widget": {"name": "attention_mode"}, "shape": 7, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}], "flags": {}, "id": 23, "type": "SeedVR2LoadDiTModel", "title": "04 SeedVR2 3B Q8", "properties": {"ver": "690cc39379c1481159ddd451368dbf2295930fc6", "widget_ue_connectable": {"attention_mode": true, "swap_io_components": true, "offload_device": true, "model": true, "device": true, "blocks_to_swap": true}, "aux_id": "ainvfx/ComfyUI-SeedVR2_VideoUpscaler", "Node name for S&R": "SeedVR2LoadDiTModel"}, "order": 10}, {"mode": 0, "outputs": [{"name": "vae", "links": [36], "label": "vae", "type": "SEEDVR2_VAE", "localized_name": "vae"}], "size": [390, 360], "pos": [3520, 370], "widgets_values": ["ema_vae_fp16.safetensors", "cuda:0", true, 512, 128, true, 512, 128, "false", "cpu"], "inputs": [{"shape": 7, "name": "cache_model", "label": "cache_model", "type": "MODEL", "localized_name": "cache_model"}, {"shape": 7, "name": "torch_compile_args", "label": "torch_compile_args", "type": "SEEDVR2_TORCH_COMPILE", "localized_name": "torch_compile_args"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "device"}, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}, {"widget": {"name": "encode_tiled"}, "shape": 7, "name": "encode_tiled", "label": "encode_tiled", "type": "BOOLEAN", "localized_name": "encode_tiled"}, {"widget": {"name": "encode_tile_size"}, "shape": 7, "name": "encode_tile_size", "label": "encode_tile_size", "type": "INT", "localized_name": "encode_tile_size"}, {"widget": {"name": "encode_tile_overlap"}, "shape": 7, "name": "encode_tile_overlap", "label": "encode_tile_overlap", "type": "INT", "localized_name": "encode_tile_overlap"}, {"widget": {"name": "decode_tiled"}, "shape": 7, "name": "decode_tiled", "label": "decode_tiled", "type": "BOOLEAN", "localized_name": "decode_tiled"}, {"widget": {"name": "decode_tile_size"}, "shape": 7, "name": "decode_tile_size", "label": "decode_tile_size", "type": "INT", "localized_name": "decode_tile_size"}, {"widget": {"name": "decode_tile_overlap"}, "shape": 7, "name": "decode_tile_overlap", "label": "decode_tile_overlap", "type": "INT", "localized_name": "decode_tile_overlap"}, {"widget": {"name": "tile_debug"}, "shape": 7, "name": "tile_debug", "label": "tile_debug", "type": "COMBO", "localized_name": "tile_debug"}, {"widget": {"name": "offload_device"}, "shape": 7, "name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}], "flags": {}, "id": 24, "type": "SeedVR2LoadVAEModel", "title": "05 SeedVR2 VAE", "properties": {"ver": "690cc39379c1481159ddd451368dbf2295930fc6", "widget_ue_connectable": {"encode_tiled": true, "encode_tile_overlap": true, "encode_tile_size": true, "decode_tiled": true, "decode_tile_size": true, "tile_debug": true, "offload_device": true, "model": true, "decode_tile_overlap": true, "device": true}, "aux_id": "ainvfx/ComfyUI-SeedVR2_VideoUpscaler", "Node name for S&R": "SeedVR2LoadVAEModel"}, "order": 11}, {"outputs": [{"name": "STRING", "links": [8], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#322", "widgets_values": ["主题与主体：\n以参考图1中的银灰色未来跑车作为全片唯一核心主体，严格保持车身造型、颜色、比例、尾灯结构和整体外观一致。将参考图2中的云端未来浮空城作为目标世界与环境参考，融合成真实、宏大、电影感强烈的未来科幻场景。\n\n15秒分镜：\n0-5秒： 夜晚霓虹城市的湿润道路上，银灰色未来跑车高速向前行驶。镜头从车后方低机位跟拍，路面反射蓝紫色霓虹灯光，轮胎带起轻微水雾，城市灯牌快速掠过，镜头缓慢向车辆靠近，突出尾灯与车身流线。\n\n5-10秒： 跑车驶出密集的霓虹都市，前方空间逐渐开阔。镜头从低位跟拍自然抬升并向侧后方移动，远处云层被明亮蓝白色光线照亮，一座巨大的未来浮空城逐渐从云海中显现。跑车继续沿着通往浮空城的未来高架道路高速行驶，场景从赛博都市自然过渡到宏大的云端科幻世界。\n\n10-15秒： 镜头逐渐拉远并升高，展现跑车、悬空道路、翻涌云海与巨大浮空城的完整空间关系。跑车持续朝浮空城中心驶去，巨大的月球悬挂在天空，城市灯光逐层点亮。最后镜头形成宽阔电影级全景，跑车位于画面下方前景，宏伟浮空城成为远景视觉中心，自然收束。\n\n视觉与运镜：\n电影级真实科幻摄影，蓝色、青色、紫色为主要色调，金属材质真实，湿地反射自然，云层具有明显体积感。车辆运动连续稳定，车身不得变形、换车、改变颜色或结构。镜头运动流畅，三个阶段之间自然过渡，不突然切换场景，不重复动作，不产生闪烁或跳帧。\n\n声音：\n生成与画面同步的原生环境声。前5秒包含低沉的未来跑车电机与引擎声、轮胎划过湿润路面的声音、轻微雨声和远处城市环境声；5-10秒随着场景开阔，城市声音逐渐减弱，加入高空风声和宏大的未来氛围音乐；10-15秒加入更加辽阔的风声、远处飞行器环境声与低频科幻氛围音乐。声音随镜头空间变化自然过渡，无对白。\n\n限制：\n不生成字幕、水印、Logo或额外文字；不要增加新的车辆；不要改变参考图1跑车的核心外观；不要让浮空城突然出现或消失；避免车辆漂移变形、轮胎错位、车身融化、道路断裂、建筑抖动以及不符合物理规律的运动。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "03 双图15秒导演指令", "mode": 0, "bgcolor": "#533", "size": [560, 650], "pos": [390, 80], "id": 3, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 2}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "builder": {"seedvr2_low_vram_profile": {"batch_size": 5, "swap_io_components": true, "internal_h3_resolution": [352, 624], "switch_to_1080": "change SeedVR2VideoUpscaler resolution from 720 to 1080", "vae_tiling": true, "recommended_vram": "12GB+", "blocks_to_swap": 32, "seedvr2_resolution": 720, "vae_tile_size": 512, "offload_device": "cpu", "model": "seedvr2_ema_3b-Q8_0.gguf", "max_resolution": 1920, "recommended_ram": "64GB+"}, "low_vram_profile": {"duration_seconds": 15, "internal_resolution": [352, 608], "note": "Do not use core 旧分块解码节点 on MiniMax H3 joint AV NestedTensor latent.", "post_upscale_resolution": [416, 736], "profile": "12gb_h3_compatible_decode_postscale", "fps": 24, "decode": "VAEDecode (Comfy core ordinary decoder)", "post_scale_resolution": [416, 736], "recommended_gpu_vram": "12GB+", "sampler": {"mode": "res_multistep", "steps": 20}, "compatibility_note": "Official MiniMax H3 R2V uses ordinary VAEDecode and VAEDecodeAudio for the packed joint AV latent.", "memory_actions": ["purge after conditioning", "purge after empty latent", "purge after sampling before VAE decode", "purge after video decode"], "fallback_resolution": [320, 576], "recommended_system_ram": "64GB+"}, "dependencies": [{"role": "video_upscaler", "kind": "custom_node", "name": "ainvfx/ComfyUI-