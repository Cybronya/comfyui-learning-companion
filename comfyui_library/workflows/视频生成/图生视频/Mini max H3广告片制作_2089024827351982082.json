tputs": [{"name": "IMAGE", "links": [278], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#223", "widgets_values": ["938f81846909d3651dc2ccc3c0d91194e900f212b12941333a2f38de20b5c60d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#335", "size": [290, 330], "pos": [-1835.1859130859375, 4473.9814453125], "id": 137, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 9}, {"outputs": [{"name": "STRING", "links": [279], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#223", "widgets_values": ["参考图2的分镜图，是由9张镜头组成，分别对应下面提示词的的分镜头。参考图1是产品图，主要是确定产品一致性不发生改变。\n```text\n综合多模态描述：[分镜1] 实拍、电影感、16:9 横屏。全片保持暖琥珀金色调、障子窗金色午后光线与深色木案一致，24面切割玻璃威士忌瓶始终是画面中心锚点。沉稳低频男声旁白（S1）仅以画外音出现，每个短句在单镜头内说完，全片无人动唇。第一帧已在运动中：镜头穿过虚化梅枝慢速推向酒瓶，焦点由虚转实，尘埃在光束中漂浮。旁白：<d>[中文] 光，落在格子上。</d>（无人动唇）。\n[分镜2] 在 00:01.800，切换至轻微低角度，酒瓶保持中心位置，前推动势无缝流入绕瓶慢速环绕；侧逆光让酒液呈现金黄到深焦糖层次，切割面折射暖色光斑。\n[分镜3] 在 00:03.400，环绕把标签转到正面时切换至同一标签极近特写，保持逼近方向继续极慢推近；侧光扫过米白纹理纸面，\"響\"与\"HIBIKI\"产生立体浮雕感，下方\"JAPANESE HARMONY\"小字浮现。旁白：<d>[中文] 響，时间的和鸣。</d>\n[分镜4] 在 00:05.000，切换至同一微距尺度的手部特写：一位三十余岁、深色短发、米色针织衫的东亚男性，指尖恰从光扫消失的画面右缘入画，抚过瓶身切面棱线；镜头慢速右移跟手，光沿切面流动。\n[分镜5] 在 00:06.600，延续同一手部运动，切换至第一人称视角：他的手张开稳稳握住瓶身，切割玻璃充满画面下方，背景暖色虚化。\n[分镜6] 在 00:08.200，切换至瓶颈紧致微距：指尖从切面上行至瓶盖，镜头慢速上抬跟随，右移顺滑转为上升；拇指食指逆时针旋开瓶盖，金属咔哒一声，一缕酒气从瓶口升起。旁白：<d>[中文] 开启，是一场仪式。</d>\n[分镜7] 在 00:09.800，切换至他手部倾瓶特写，镜头反转为慢速下摇，跟随油亮酒线落入下方等待的切子杯。\n[分镜8] 在 00:11.400，酒线通过叠化延续进入纯黑背景，垂直俯拍静止机位高速升格：同一道酒线击中冰块，酒花气泡飞溅，光透酒体。旁白：<d>[中文] 时间，倒进杯中。</d>\n[分镜9] 在 00:13.200，叠化把酒液旋涡动势带回暖调房间，落定在渐满的酒杯微距；镜头慢速升降，冰块轻移，段落在静默中收束于发光盛满的切子杯。\n\n整体声景：安静房间底噪中有隐约风铃与静止午后空气声。玻璃切面在指尖下轻响，瓶盖金属咔哒声，威士忌浇冰的清脆噼啪声穿过叠化延续到黑场再回来，冰块轻碰。\n\n非叙事音乐：慢速稀疏日本筝与钢琴动机，温暖弦乐在每句旁白下退弱、句间回补，倒酒段落渐强，满杯时柔化。\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#335", "size": [370, 390], "pos": [-1975.7572021484375, 4900.763671875], "id": 138, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 10}, {"outputs": [{"name": "IMAGE", "links": [282], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#223", "widgets_values": ["941120b7daee677745c991807dd0ee75e59aaab3bd1c3ec1c559029b867a4e81.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#335", "size": [290, 330], "pos": [-1526.0048828125, 4473.966796875], "id": 139, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 11}, {"outputs": [{"name": "output", "links": [280, 281], "label": "输出", "type": "LATENT", "localized_name": "Latent"}, {"name": "denoised_output", "links": [], "label": "降噪输出", "type": "LATENT", "localized_name": "降噪Latent"}], "color": "#223", "widgets_values": [], "inputs": [{"name": "noise", "link": 253, "label": "噪波生成", "type": "NOISE", "localized_name": "噪波"}, {"name": "guider", "link": 254, "label": "引导", "type": "GUIDE