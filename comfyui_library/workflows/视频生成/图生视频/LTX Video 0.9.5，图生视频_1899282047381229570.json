				"<div class=\"banner\">\n    <div class=\"block\">\n        <h1>LTX-Video 0.9.5</h1><h4>图</h4><h1>图生视频</h1>\n        <h3 class=\"author\">@YaHaHa</h3><h3>\n    </h3></div>\n    <div class=\"bar\">\n        <h2 class=\"item\">1. 提示词</h2>\n        <h2 class=\"item\">2. 参考图</h2>\n        <h2 class=\"item\">3. 参数</h2>\n        <div class=\"gap\"></div>\n        <h2 class=\"item\">合成结果</h2>\n        <div class=\"f1\"></div>\n    </div>\n</div>",
				"markdown",
				".banner {\n    display: flex;\n    flex-direction: column;\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    margin: 0;\n    color:#FFF2BF;\n    overflow: hidden;\n    /*font-family: song;*/\n}\n\n.banner::after {\n    content: '';\n    position: absolute;\n    width: 120%;\n    left: -10%;\n    top: -500px;\n    font-size: 30px;\n    letter-spacing: 50px;\n    line-height: 70px;\n    opacity:0.1;\n    transform: rotate(-30deg);\n    font-family: song;\n    font-weight: lighter;\n    \n}\n\n.block {\n    flex: 1;\n    border-radius: 20px;\n    display: flex;\n    align-items: center;\n    padding: 10px 20px;\n}\n\nh1 {\n    font-size: 80px;\n    font-weight: bolder;\n    font-family: song;\n}\n\nh3 {\n    font-size: 24px;\n    margin: -20px 20px;\n    font-family: song;\n}\n\nh4 {\n    font-size: 36px;\n    font-family: song;\n    font-weight: lighter;\n    margin: 20px;\n    border: solid 4px currentColor;\n    display: flex;\n    width: 60px;\n    height: 60px;\n    justify-content: center;\n    align-items: center;\n    border-radius: 100%;\n}\n\n\n.bar {\n    height: 60px;\n    display: flex;\n    background: #fff1;\n}\n\n.bar .item {\n    display: flex;\n    align-items: center;\n    padding: 10px 20px;\n    width: 400px;\n}\n\n.bar h2.item {\n    font-size: 30px;\n    font-weight: bolder;\n    font-family: song;\n}\n\n.gap {\n    width: 100px;\n}\n\n.f1 {\n    flex: 1;\n}",
