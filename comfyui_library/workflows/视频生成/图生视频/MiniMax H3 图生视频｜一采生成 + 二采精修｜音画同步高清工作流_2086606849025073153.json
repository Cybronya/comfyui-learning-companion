"type": "LATENT", "localized_name": "LATENT"}], "size": [212.69198608398438, 60], "pos": [650, 6300], "widgets_values": [], "inputs": [{"name": "audio", "link": 438, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "vae", "link": 439, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 158, "type": "VAEEncodeAudio", "title": "Encode original audio latent", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEEncodeAudio"}, "order": 33}, {"mode": 0, "outputs": [{"name": "latent", "links": [452], "label": "latent", "type": "LATENT", "localized_name": "latent"}], "size": [276.9497985839844, 100], "pos": [950, 6230], "widgets_values": [], "inputs": [{"name": "video_latent", "link": 440, "label": "video_latent", "type": "LATENT", "localized_name": "video_latent"}, {"name": "audio_latent", "link": 441, "label": "audio_latent", "type": "LATENT", "localized_name": "audio_latent"}], "flags": {}, "id": 159, "type": "LTXVConcatAVLatent", "title": "H3 AV latent start (must feed sampler)", "properties": {"cnr_id": "comfy-core", "widget_ue_connectable": {}, "Node name for S&R": "LTXVConcatAVLatent"}, "order": 37}, {"outputs": [], "color": "#223344", "widgets_values": ["## RunningHub V2：去 Primitive 防爆版\n\n本版针对 RunningHub 上 `BasicScheduler` 的超大内存报错修复。\n\n### 根因\n二采原本使用外接 `PrimitiveInt / PrimitiveFloat` 控制：\n- steps = 3\n- denoise = 0.2\n\nRunningHub 执行时外接 denoise 被异常解析成极小浮点数。\n而 BasicScheduler 在 denoise < 1 时会计算：\n`total_steps = int(steps / denoise)`\n\n因此 total_steps 被放大到约 1.47e15，NumPy 尝试申请 PiB 级数组。\n\n### V2 修复\n- 一采 steps=20 直接写入 BasicScheduler\n- 二采 steps=3 直接写入 BasicScheduler\n- 二采 denoise=0.20 直接写入 BasicScheduler\n- shared seed 直接写入两个 RandomNoise\n- 删除相关 PrimitiveInt / PrimitiveFloat 外接控制节点\n\n参数仍然可以直接在对应 Scheduler / RandomNoise 节点上修改。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note 1：本工作流目标", "mode": 0, "bgcolor": "#111111", "size": [940, 260], "pos": [-150, 5180], "id": 161, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [], "color": "#223344", "widgets_values": ["## 关键原则\n\n二采必须通过 `MiniMaxH3ReferenceToVideo` 重新生成与目标分辨率匹配的 conditioning。\n\n但禁止使用该节点的 `LATENT` 输出作为二采起点。二采起点必须来自：一采画面 → RTX VSR → VAEEncode；一采音频 → VAEEncodeAudio；随后由 `LTXVConcatAVLatent` 合成为联合 AV latent。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note 2：关键原则", "mode": 0, "bgcolor": "#111111", "size": [1000, 260], "pos": [200, 6500], "id": 162, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"outputs": [], "color": "#223344", "widgets_values": ["## RunningHub V2 参数建议\n\n- 一采 Scheduler：`simple`，20 steps，denoise 1.0\n- 二采 Scheduler：`beta`，3 steps，denoise 0.20\n- 二采 Sampler：`res_multistep`\n- 二采可试：3～4 steps、denoise 0.20～0.25\n- 一采与二采 RandomNoise 当前使用相同固定 seed\n\n**RunningHub 上不要再把二采 steps / denoise 接到 Primitive 节点。**\n需要调参数时，直接修改 `Refine scheduler` 节点内部数值。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note 3：参数建议", "mode": 0, "bgcolor": "#111111", "size": [650, 300], "pos": [-1600, 6410], "id": 163, "properties": {"widget_ue_connectable": {}}, "order": 9}, {"outputs": [], "color": "#223344", "widgets_values": ["## 何时不用这套\n\n本工作流适合“一采已经可用，只需要更清晰、更稳定”的素材。\n\n如果一采已经严重崩脸、动作错误或伪影很多，轻重绘通常无法可靠修复，建议改走 LTX 修复路线。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note 4：何时不用这套", "mode": 0, "bgcolor": "#111111", "size": [1000, 250], "pos": [2600, 6400], "id": 164, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"mode": 0, "outputs": [{"name": "VAE", "links": [410, 418], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [640, 70], "pos": [-2020, 5020], "widgets_values": ["minimax_h3_video_vae_fp16.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 11, "type": "VAELoader", "title": "H3 video VAE", "properties": {"models": [{"directory_invalid": true, "name": "minimax_h3_video_vae