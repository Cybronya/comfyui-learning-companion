, 550], "pos": [138.6134796142578, 5022.869140625], "widgets_values": ["动漫风格，蓝发蓝眼帅气少年，深色外套，蓝天背景，漂浮着蓝橙色发光粒子。固定镜头，中景特写。7秒完整连贯动作：\n\n第一阶段（起势）： 少年原本微侧的脸缓缓转向镜头，微风吹动发丝，目光变得温柔。他嘴角浮现浅笑，开始温和说话：“昨晚的那场梦……”\n\n第二阶段（诉说）： 他轻微歪了一下头，眼神变得明亮且充满回忆，嘴唇持续自然开合，语气轻柔地继续诉说：“……是不是飞过了那片蓝色天际？”\n\n第三阶段（收尾）： 他的声音放缓，眼神转为清澈与安慰，嘴唇缓慢闭合，说完最后一句话：“不要怕，那是个好梦。” 最后定格在温暖平静的浅笑中，光斑缓缓飘动。\n\n4K高清，电影级光影，动作衔接极致流畅，梦幻唯美氛围，无画面扭曲或卡", 1344, 768, 73], "inputs": [{"name": "clip", "link": 241, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 242, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 279, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "link": 298, "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 277, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 304, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 305, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 245, "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "id": 133, "type": "MiniMaxH3ImageToVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"width": true, "length": true, "height": true}, "Node name for S&R": "MiniMaxH3ImageToVideo"}, "order": 27}, {"mode": 0, "outputs": [{"name": "", "links": [298], "type": "*"}], "size": [75, 26], "pos": [1434.6185302734375, 6212.76708984375], "inputs": [{"name": "", "type": "*"}], "flags": {}, "id": 152, "type": "Reroute", "properties": {"horizontal": false, "widget_ue_connectable": {}, "showOutputText": false}, "order": 7}, {