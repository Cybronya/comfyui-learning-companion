io", "slot_index": 1, "links": [36], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [380, 100], "pos": [4389.90966796875, 892.1370849609375], "widgets_values": [], "inputs": [{"name": "h3_vae_bundle", "link": 30, "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BUNDLE", "localized_name": "h3_vae_bundle"}, {"name": "sampled_av_latent", "link": 31, "label": "sampled_av_latent", "type": "MINIMAX_H3_AV_LATENT", "localized_name": "sampled_av_latent"}], "flags": {}, "id": 21, "type": "RHMiniMaxH3DecodeAV", "title": "Decode Video + Audio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3DecodeAV"}, "order": 13}, {"mode": 0, "outputs": [{"name": "VIDEO", "slot_index": 0, "links": [34], "label": "VIDEO", "type": "VIDEO", "localized_name": "视频"}], "size": [300, 102], "pos": [4819.46484375, 892.753662109375], "widgets_values": [24, 8], "inputs": [{"name": "images", "link": 35, "label": "images", "type": "IMAGE", "localized_name": "图像"}, {"shape": 7, "name": "audio", "link": 36, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "fps"}, "name": "fps", "label": "fps", "type": "FLOAT", "localized_name": "帧率"}, {"widget": {"name": "bit_depth"}, "shape": 7, "name": "bit_depth", "label": "bit_depth", "type": "INT", "localized_name": "bit_depth"}], "flags": {}, "id": 23, "type": "CreateVideo", "properties": {"widget_ue_connectable": {"fps": true, "bit_depth": true}, "Node name for S&R": "CreateVideo"}, "order": 14}, {"mode": 0, "outputs": [{"name": "output", "links": [20], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [395.48443603515625, 608.0466918945312], "pos": [1229.2261962890625, 896.1028442382812], "widgets_values": ["Empty - Nothing", "参考文本格式，结合图片，生成一个全新的视频分镜脚本", "结合您提供的“山·隐 RESTAURANT”空间设计图（强调原木、肌理涂料、天然石材、藤编、绿植及温暖松弛的灯光）以及参考文本的POV手绘互动视频格式，我为您设计了一个全新的视频分镜脚本。\n\n这个视频将场景转移到了**“深夜打烊后、充满自然禅意的‘山·隐’餐厅内部”**。以下是全新视频分镜脚本：\n\n---\n\n### **视频策划案：《山隐之夜的松弛精灵》**\n\n**【基本信息】**\n*   **时长：** 15秒\n*   **画幅：** 16:9 横屏\n*   **视觉风格：** 真实的智能手机手持拍摄（轻微抖动、低光噪点、自然的自动曝光过渡），将“山·隐”餐厅充满质感的实景（原木、粗糙石材、藤编灯具、绿植）与粗犷的手绘发光逐帧动画融为一体。仿佛是店员在深夜打烊后，用手机随手记录下的奇幻瞬间。\n\n---\n\n### **分镜脚本**\n\n*   **0-3秒：**\n    *   **画面：** 镜头对准一张质朴的原木餐桌（对应设计图材质）。一只实物拍摄的手在屏幕左侧抬起，拿起一只粗砂质地的灰色石茶杯。随着手指的触碰，金黄色的手绘粗糙线条从杯底蔓延开来，缠绕在手指上，幻化成一圈发光的金色松针叶。线条带有明显的蜡笔涂抹质感，微微颤动。金色松针随即汇聚，化作一只散发着橙光的小松鼠，拖着光尾向右侧的藤编吧台椅飞去。镜头略微滞后，快速跟随移动。\n    *   **音效：** 粗砂茶杯摩擦木桌的沙沙声，轻微的木屐走路声，伴随一声清脆的“叮”声（电子合成合成器音效）。\n\n*   **3-6秒：**\n    *   **画面：** 橙光松鼠钻入了粗糙石材吧台（对应吧台区）上的一盏低矮藤编台灯里。灯罩的藤条缝隙中，瞬间被粗粝的黄色手绘线条涂满，变成了一个发光的黄色小太阳。太阳颤动着，向外拉伸变形，变成了一根紫色的嫩竹笋，顺着吧台旁的一根实木立柱向上攀爬。镜头由于快速向上摇摄（Tilt up），产生了自然的运动模糊。\n    *   **音效：** 藤条干瘪的摩擦声，竹子拔节的“咔哒”声，风吹过竹林的沙沙声。\n\n*   **6-10秒：**\n    *   **画面：** 紫色竹笋在柱头顶部绽放，变成一只半透明的淡紫色发光水母，轻飘飘地游向餐厅中央的实景绿植中庭（对应中庭景观区）。镜头跟随着水母。水母穿过树枝，化作天蓝色的藤蔓线条，沿着粗糙的肌理涂料墙面（对应墙面材质）快速爬行。在墙角一尊石雕茶水罐旁，天蓝色线条旋转缠绕，变成了一个手绘的、有着三只眼睛的绿色“茶叶怪”。怪物转头看了镜头一眼，惊慌地钻进了半开的石罐中。镜头紧跟推进。\n    *   **音效：** 树叶摩擦声，水流潺潺声，茶叶怪发出“咕噜噜”的滑稽叫声。\n\n*   **10-13秒：**\n    *   **画面：** 石罐盖子上出现一圈青色的手绘旋转气旋和指示箭头，罐盖被顶开缝隙。在漆黑的罐子内部，亮起一盏极具温馨感的发光复古手绘灯笼，长着大眼睛和一对小翅膀。但下一秒，灯笼的纸罩破裂，变成了一只大嘴里满是木质尖牙的“枯木怪兽”。镜头因惊吓而剧烈晃动，拍摄者迅速伸出另一只手，“啪”的一声把石罐盖子按了回去。\n    *   **音效：** 罐盖碰撞的清脆石器声，怪物突然变身时的短促怪叫，手掌拍在石盖上的闷响。\n\n*   **13-15秒：**\n    *   **画面：** 镜头惊慌地向后拉开，展现出深夜里只有暖色暗光（对应灯光分析图中的壁灯与灯带）的“山·隐”餐厅全景。在中央中庭大树上方的半空中，凭空画出了一个巨大的绿色手绘年轮漩涡，漩涡中心睁开一只发光的黄色眼睛。年轮转动，化作一张巨大的、带着慵懒笑容的橙色猫咪面孔（宛如山林守护神）。镜头因惊讶而微微倾斜，画面变暗，动画结束。\n    *   **音效：** 悠远古朴的木鱼声或空灵的磬声，风铃在微风中的尾音，归于安静的夜间环境音。\n\n---\n\n### **【动画与技术规格说明】**\n\n1.  **画面质感：**\n    *   **色调：** 契合“山·隐”的暖灰色调。原木的深褐、石材的暖灰、植物的暗绿，与发光的彩色线条形成对比。\n    *   **技术规格：** 16:9，1080p。模拟手机拍摄：允许出现轻微的对焦拉风箱（Focus hunting）和由于光线不足产生的噪点，特别是暗部细节。\n2.  **手绘动画风格：**\n    *   **材质：** 严禁平滑的CG特效。必须是粗糙的逐帧动画，带有粉笔、色粉笔、蜡笔在粗糙纸张上涂抹的颗粒感。\n    *   **发光效果：** 动画线条自带柔和的霓虹发光（Glow）效果，但光晕范围小，仅照亮实景表面（如石台面、木纹）的微小局部，保持低调松弛的氛围。\n    *   **色彩分配：** 金黄（松针）、橙（松鼠）、黄（太阳）、紫（竹笋/水母）、天蓝（藤蔓）、青绿（茶叶怪/年轮）。\n\n### **【负向提示词】**\n请勿使用过于精细的3D渲染、平滑的矢量图形、电影级完美平稳的轨道运镜、商业广告质感的超高饱和度、水印、现代电子流行背景音乐。", "images", 24, 256, 969727060421618, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 17, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 18, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "link": 21, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 12, "type": "llama_cpp_instruct_adv", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 6}, {"mode": 0, "outputs": [{"name": "output", "links": [37], "label": "output", "type": "*", "localized_name": "output"}], "size": [567.8825073242188, 657.5468139648438], "pos": [1741.2623291015625, 894.153076171875], "widgets_values": ["由于您提供的图片展示了一位拥有**紫色长发、佩戴紫色晶体护肩、身着暗色皮质铠甲的幻想风格女性角色**，置身于一个**充满魔幻色彩的森林城堡建筑群**（背景中有蓝色的发光晶体塔、石质城堡和茂密的森林），这与之前的“山·隐”餐厅设计形成了一种“现实与幻想交织”的奇妙对比。\n\n我将参考您要求的**“POV手绘互动视频格式”**（即：真实手机拍摄视角 + 粗犷手绘逐帧动画 + 奇幻生物变身），为您设计一个全新的视频分镜脚本。\n\n---\n\n### **视频策划案：《森林之主的午后漫步》**\n\n**【基本信息】**\n* **时长：** 15秒\n* **画幅：** 9:16 竖屏（更符合手机POV社交媒体传播习惯）\n* **视觉风格：** 真实的智能手机手持自拍视角（略带晃动、自然的阳光过曝感），结合极具颗粒感的粗糙手绘线条（粉笔/蜡笔质感）。\n\n---\n\n### **分镜脚本**\n\n* **0-3秒：**\n    * **画面：** 镜头以第一人称视角（POV）对着正在行走的角色女性（即图片中的主角）。她正侧头对着镜头微微一笑，阳光洒在她紫色的发丝上，背景是宏大的森林城堡。突然，镜头左侧的一根石柱上，出现了一团**黑色粗糙的手绘线条**，线条像墨水一样蠕动，瞬间变幻成一只**手绘的、有着巨大眼睛的紫色小蝙蝠**。小蝙蝠“啾”地一声撞向镜头，画面产生轻微的震动感。\n    * **音效：** 森林中的鸟鸣声、轻微的脚步踩在石板上的声音、小蝙蝠尖锐的“啾”声。\n\n* **3-6秒：**\n    * **画面：** 镜头快速转向背景中那座**闪烁蓝光的晶体塔**。在晶体塔的底部，原本静止的蓝色光芒突然被**亮黄色的手绘线条**缠绕。线条像藤蔓一样疯狂生长，在空气中勾勒出一个**手绘的、圆滚滚的蓝色史莱姆（Slime）**。史莱姆弹跳着撞向晶体塔，撞击处迸发出**粉色粉笔质感的爆炸火花**。\n    * **音效：** 晶体发出的嗡鸣声、史莱姆弹跳的“噗叽”声、粉笔爆炸的“啪”声。\n\n* **6-10秒：**\n    * **画面：** 镜头跟随史莱姆的轨迹快速平移，捕捉到角色女性正伸手试图抓住那团光芒。就在她的指尖触碰空气的瞬间，空气中凭空出现了一圈**天蓝色的手绘漩涡**。漩涡中心长出了一双**手绘的、带有恶作剧神情的眼睛**。漩涡迅速变大，将周围的树木“吸收”并转化成**密密麻麻的绿色线条**，像瀑布一样从空中垂下。\n    * **音效：** 强力的吸气声（Whoosh）、树木变动的沙沙声、诡异的笑声。\n\n* **10-13秒：**\n    * **画面：** 镜头因眩晕而剧烈晃动（模拟拍摄者被吸入感）。画面中心出现了一只**巨大的、手绘的橙色龙爪**，它正试图抓取画面中的蓝色晶体。龙爪在空中划过的轨迹，留下了**深紫色的粗糙笔触**。镜头猛地向后拉开，发现刚才的场景竟然是角色女性手中**一个精致的魔法沙漏**里的微缩世界。\n    * **音效：** 沉重的龙吼声、沙漏翻转的“哗啦”声、快速拉镜的音效。\n\n* **13-15秒：**\n    * **画面：** 镜头定格在角色女性的特写（回到图片状态）。她调皮地眨了一下眼，用手指轻轻敲了敲镜头（屏幕）。随着“咚”的一声，屏幕上出现了一个**巨大的、手绘的绿色“FIN”字样**，字样边缘还在不断滴落墨水。画面渐黑。\n    * **音效：** 清脆的敲击声、沉重的鼓点、森林回归宁静的背景音。\n\n---\n\n### **【动画与技术规格说明】**\n\n1.  **画面质感：**\n    * **色彩对比：** 真实场景使用高饱和度、高亮度的魔幻色彩；手绘动画使用低饱和度、高对比度的粗粝线条。\n    * **物理模拟：** 所有的手绘物体在移动时，必须带有明显的“跳帧感”（每秒仅6-8帧动画），以区别于平滑的CG。\n2.  **手绘风格：**\n    * **材质：** 必须体现出**“在粗糙石壁上涂鸦”**的质感，线条边缘不规则，带有明显的粉笔碎屑效果。\n    * **发光：** 手绘的生物（如小蝙蝠、史莱姆）自带**微弱的霓虹感**，但这种光芒是“脏”的，带有颗粒感。\n\n### **【负向提示词 (Negative Prompts)】**\n请勿使用：平滑的3D模型、完美的矢量线条、电影级的平稳运镜、毫无质感的CG特效、过于现代的电子音乐、高精细度的写实动画。"], "inputs": [{"shape": 7, "name": "anything", "link": 20, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 13, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 8}, {"mode": 0, "outputs": [{"name": "conditioning", "slot_index": 0, "links": [28], "label": "conditioning", "type": "MINIMAX_H3_CONDITIONING", "localized_name": "conditioning"}], "size": [439.3175048828125, 352.4482727050781], "pos": [3073.55029296875, 1164.051025390625], "widgets_values": [""], "inputs": [{"name": "h3_text_encoder", "link": 23, "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"name": "h3_vae_bundle", "link": 24, "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BUNDLE", "localized_name": "h3_vae_bundle"}, {"name": "target", "link": 25, "label": "target", "type": "MINIMAX_H3_TARGET", "localized_name": "target"}, {"name": "keyframes", "link": 26, "label": "keyframes", "type": "MINIMAX_H3_FL_KEYFRAMES", "localized_name": "keyframes"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 37, "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 19, "type": "RHMiniMaxH3FL2VAEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3FL2VAEncode"}, "order": 11}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [210, 204], "pos": [5152.39990234375, 897.3866577148438], "widgets_values": ["minimax_h3/fl2va_first_frame", "mp4", "h264", "auto"], "inputs": [{"name": "video", "link": 34, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": 