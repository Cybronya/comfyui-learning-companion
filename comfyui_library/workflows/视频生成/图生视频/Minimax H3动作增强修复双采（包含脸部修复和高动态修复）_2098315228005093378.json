入弦乐轰鸣，气势凌厉。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#353", "size": [699.8408813476562, 560.5068969726562], "pos": [2419.648193359375, 759.6442260742188], "id": 37, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 9}, {"showAdvanced": true, "outputs": [{"name": "width", "links": [76, 80], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [77, 81], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#232", "widgets_values": ["16:9 (Widescreen)", 0.7000000000000001, 32], "inputs": [{"shape": 7, "name": "preview", "label": "preview", "type": "RESOLUTION_PREVIEW", "localized_name": "preview"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "mode": 0, "bgcolor": "#353", "size": [270, 170], "pos": [3694.25537109375, -153.638427734375], "id": 56, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 10}, {"outputs": [{"name": "FLOAT", "links": [18], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "color": "#232", "widgets_values": [15], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "type": "PrimitiveFloat", "title": "Float (duration)", "mode": 0, "bgcolor": "#353", "size": [317.8947448730469, 87.10527038574219], "pos": [2831.835205078125, -82.01725769042969],