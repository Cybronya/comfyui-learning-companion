e_prefix": true, "audioUI": true, "quality": true}, "Node name for S&R": "SaveAudioMP3"}, "order": 12}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [9], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "size": [270, 136], "pos": [-1400, 760], "widgets_values": ["442adfa10cc1c11ebea148c83b59f4e05661434e12d9220d4857fcc09f4efad7.mp3", null, ""], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "audio"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 6, "type": "LoadAudio", "properties": {"widget_ue_connectable": {"upload": true, "audio": true, "audioUI": true}, "Node name for S&R": "LoadAudio"}, "order": 4}, {"mode": 0, "outputs": [{"name": "frames", "links": [7], "label": "frames", "type": "IMAGE", "localized_name": "frames"}, {"name": "audio", "links": [], "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "av_latent", "links": [], "label": "av_latent", "type": "MINIMAX_H3_AV_LATENT", "localized_name": "av_latent"}], "size": [272.08203125, 520], "pos": [-820, 0], "widgets_values": ["### 【开场序幕｜00:00-01:30｜高能定调·宿命开篇】\n\n**【画面】（水墨写实融合·全景大远景·冷色调）**\n\n漫天黑云压覆金陵皇城，水墨晕染的天际翻涌暗沉，无一丝暖阳。整座紫禁城被严格的对称构图框定，飞檐斗拱如冰冷兽牙，朱红宫墙绵延万里，隔绝内外人间烟火。\n\n**【声音】**风声呜咽，远处皇城钟鼓低沉悠远，节奏缓慢沉重，无半分喜庆，只剩压顶的肃穆。\n\n**【镜头推进】**镜头缓慢推拉下沉，穿透层层宫阙，最终定格于奉天殿内。殿内光线极端割裂，高位龙椅上方一束强光垂直洒落，照亮龙椅鎏金纹路，下半殿宇尽数沉于浓黑阴影中，**封闭式构图**将整座大殿塑造成一座无形囚笼。\n\n**【特写】**一双布满老茧、指节粗大、带着杀伐旧疤的手，悬于一张紫檀木棋盘之上。棋盘黑白棋子泾渭分明，错落排布，如朝野群臣、天下藩王。指尖微动，一枚黑子重重落下，棋子撞击棋盘的脆响，刺破殿内死寂，余音回荡。\n\n**【光影】**落子瞬间，殿内光影剧烈震颤，明暗边界骤然割裂。\n\n**【特写抬镜】**朱元璋端坐龙椅，半张脸沐浴在帝王强光之下，眉眼威严、不怒自威，是君临天下的洪武大帝；另半张脸深埋阴影，眼底深沉莫测，藏尽猜忌、狠戾与孤绝。\n\n**朱元璋（OS·低沉沙哑，语速极缓，字字千钧）**：天下，是棋。众生，是子。朕执黑白，定大明山河。只是这盘棋……终有一子，欲破棋局，逆命而出。", "16:9", 0, 0, 5, 398499297009079, "randomize", 21, 12, 3, "res_multistep", "off", false, "auto"], "inputs": [{"shape": 7, "name": "h3_model", "label": "h3_model", "type": "MINIMAX_H3_DIRECT_MODEL", "localized_name": "h3_model"}, {"shape": 7, "name": "h3_text_encoder", "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"shape": 7, "name": "h3_vae_bundle", "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BUNDLE", "localized_name": "h3_vae_bundle"}, {"shape": 7, "name": "first_frame", "link": 3, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "link": 6, "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"shape": 7, "name": "source_video", "label": "source_video", "type": "VIDEO", "localized_name": "source_video"}, {"shape": 7, "name": "sampler_config", "label": "sampler_config", "type": "MINIMAX_H3_SAMPLER_CONFIG", "localized_name": "sampler_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "duration_seconds"}, "name": "duration_seconds", "label": "duration_seconds", "type": "FLOAT", "localized_name": "duration_seconds"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "video_shift"}, "name": "video_shift", "label": "video_shift", "type": "FLOAT", "localized_name": "video_shift"}, {"widget": {"name": "audio_shift"}, "name": "audio_shift", "label": "audio_shift", "type": "FL