et": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#335", "size": [450, 630], "pos": [-1610, 4860], "id": 114, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 10}, {"outputs": [{"name": "positive", "links": [238], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [236], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#223", "widgets_values": ["人物开车在直行的道路上高速直线行驶，人物的头发被风吹动微微飘起，画面带有轻微晃动。摄影机始终位于副驾驶区域内，以手持跟拍方式进行小范围移动，不离开汽车，不切换镜头。\n视频开始时，摄影机位于副驾驶座椅前方，以稍低的广角侧前方视角拍摄，画面同时包含模特上半身、双手、方向盘、中控台和部分车外道路。摄影机随着车辆行驶产生轻微真实震动，同时缓慢向模特方向推近。随后摄影机从副驾驶右前方小幅向左侧平移并向上抬升，围绕模特进行约10度的轻微弧形移动，镜头逐渐靠近模特面部。方向盘和中控台在前景产生自然视差，焦点从方向盘平滑转移到模特眼睛。模特感受到镜头靠近，在保持双手握住方向盘的同时，眼睛和头部轻微转向摄影机，与镜头短暂对视，嘴角上扬并轻微点头，并对着镜头挥手打招呼，说：你好，一起开车吧。互动结束后，模特将视线重新转回前方道路。摄影机轻微向后拉远并向下移动，重新展现模特双手、方向盘、中控台和快速后退的道路背景。最后镜头稳定在副驾驶侧前方构图，保留轻微车身颠簸和风吹产生的自然晃动。整个运镜连续流畅，由一个完整长镜头完成：缓慢推近、轻微横移环绕、短暂停留、自然拉回。运镜幅度适中，具有汽车广告的沉浸感和现场感，不使用突然变焦，不剧烈旋转，不进行大范围环绕。人物面部始终保持清晰，动态模糊主要出现在窗外快速后退的树木、护栏和道路。", 1344, 768, 73], "inputs": [{"name": "clip", "link": 241, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 242, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 260, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 261, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 262, "label": "height", "t