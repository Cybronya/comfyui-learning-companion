: "SIGMAS", "localized_name": "SIGMAS"}], "size": [359.41900634765625, 119.4367446899414], "pos": [871.4003295898438, 5215.3037109375], "widgets_values": ["simple", 19, 1], "inputs": [{"name": "model", "link": 231, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 126, "type": "BasicScheduler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "BasicScheduler"}, "order": 13}, {"outputs": [{"name": "positive", "links": [238], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [236], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "color": "#14ff14", "widgets_values": ["# 5秒短视频分镜脚本\n整体风格：清新日系日常，轻快BGM，高动态镜头切换，全程搭配自然灵动表情，内置一句人声台词\n总时长：5s\n## 基础信息\n人物：图中穿搭女生（白青果印花T恤+豆绿阔腿裤）\n场景：纯白简约室内影棚\n色调：清爽柔和，高通透光影\n\n### 0-1s｜镜头1：手部+印花近景特写\n运镜：快速推镜定格胸前青梨印花特写，手部轻轻指尖轻点衣服上的梨子图案\n表情：低头温柔浅笑，眼尾微微弯起\n画面动态：轻微镜头微晃增加鲜活感\n\n### 1-2.5s｜镜头2：半身动态拉镜\n运镜：镜头缓缓向后拉至半身画面，身体轻轻侧向一边，抬手随意撩一下耳边卷发，肩膀小幅晃动\n表情：抬眼看向镜头，元气灵动挑眉\n**人声台词（轻快软糯语气）：夏日清爽就位啦～**\n\n### 2.5-4s｜镜头3：全身轻快小律动\n运镜：环绕小角度慢环绕运镜，双脚轻轻原地小踮脚，双手自然搭在裤腰两侧轻轻晃一下身子\n表情：咧嘴清甜笑容，整体松弛活泼\n\n### 4-5s｜镜头4：脸部怼脸近景收尾特写\n运镜：极速推镜锁定面部特写，脑袋轻轻歪头，对着镜头wink单眼眨眼收尾\n表情：俏皮甜笑，眼神灵动俏皮\n收尾定格1帧特写画面\n\n## 配套执行细节\n1. 音频：轻快日系吉他前奏卡点，台词卡在第2秒精准输出\n2. 动态要求：全程肢体小动作连贯不僵硬，镜头推拉环绕制造高动态视觉节奏\n3. 光影：轻微柔光闪动，贴合清新夏日氛围感", 1344, 768, 73], "inputs": [{"name": "clip", "link": 241, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 242, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 264, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"