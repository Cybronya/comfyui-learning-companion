"ref_image_size"}, {"widget": {"name": "timeline_data"}, "name": "timeline_data", "label": "timeline_data", "type": "STRING", "localized_name": "timeline_data"}, {"widget": {"name": "grid_layout"}, "name": "grid_layout", "label": "grid_layout", "type": "COMBO", "localized_name": "grid_layout"}, {"widget": {"name": "grid_border_crop"}, "name": "grid_border_crop", "label": "grid_border_crop", "type": "FLOAT", "localized_name": "grid_border_crop"}, {"widget": {"name": "output_megapixels"}, "name": "output_megapixels", "label": "output_megapixels", "type": "FLOAT", "localized_name": "output_megapixels"}, {"widget": {"name": "resolution_multiple"}, "name": "resolution_multiple", "label": "resolution_multiple", "type": "INT", "localized_name": "resolution_multiple"}, {"widget": {"name": "global_prompt"}, "shape": 7, "name": "global_prompt", "label": "global_prompt", "type": "STRING", "localized_name": "global_prompt"}], "flags": {"collapsed": false}, "type": "SFH3MultimodalDirector", "mode": 0, "bgcolor": "#353", "size": [1372.9298095703125, 1419.73193359375], "pos": [-77.95723724365234, 39.43379211425781], "id": 44, "properties": {"duration_seconds": 14.5, "aspect_ratio": "16:9 横屏", "output_megapixels": 0.9, "global_prompt": "", "timeline_data": "{\"version\":1,\"updatedAt\":1786418645625,\"globalPrompt\":\"\",\"allReferencePrompt\":\"【全局锚定设定】\\n核心场景严格锁定为参考图2（末世废墟），主角为参考图1（人形机器人），反派为参考图3（巨型生化怪兽）。电影级写实摄影，暗调青橙色调，24fps慢动作与实时混合帧率，强烈的体积光与尘埃粒子特效，手持跟拍与机械滑轨运镜结合。\\n\\n【0-5秒：危机降临】\\n\\n事件动作：怪兽（图3）从燃烧的残破立交桥阴影中缓缓站起，背对镜头，厚重的脊背甲壳摩擦发出金属撕裂声。它甩动尾部击碎左侧一栋半塌的写字楼，混凝土碎片四溅。\\n\\n镜头语言：低角度仰拍（Low Angle Tilt Up），镜头从怪兽脚踝处的积水倒影开始，缓慢垂直上摇至其头部剪影。背景中浓烟呈慢速翻滚，营造窒息压迫感。\\n\\n【5-10秒：疾驰应战】\\n\\n事件动作：机器人（图1）从画面右侧的黄色尘暴中破尘而出，采用贴地滑铲姿态，右手臂装甲翻转变形成脉冲刃。滑铲过程中刃口切割地面废铁，拖拽出长达数米的炽热火花带。\\n\\n镜头语言：极速横摇甩镜（Whip Pan）配合侧面跟拍（Tracking Shot），镜头以地面废墟为前景快速横向移动，牢牢咬住机器人的动态。此时帧率略微降低，强化机械运动的重量感与动能。\\n\\n【10-15秒：碰撞终结】\\n\\n事件动作：机器人借滑铲惯性腾空跃起，脉冲刃直刺怪兽咽喉。怪兽挥爪格挡，两者碰撞产生环形冲击波（空气扭曲特效）。机器人空中变招，反手肘击砸中怪兽天灵盖，将其重重击倒在地，激起遮天蔽日的尘埃帷幕。\\n\\n镜头语言：撞击瞬间极速推镜（Crash Zoom） 捕捉刃爪交锋的能量火花，随即急骤后拉为广角大全景（Rapid Dolly Out）。随着尘埃落下，镜头微微右移，以剪影构图展现机器人矗立于怪兽残骸之上，远处夕阳余晖刺破乌云，收尾定格。\",\"gridImage\":null,\"items\":[{\"id\":\"storyboard_0\",\"source\":\"storyboard\",\"gridIndex\":0,\"kind\":\"image\",\"name\":\"宫格分镜 1\",\"start\":0,\"duration\":1.6666666666666667,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"storyboard_1\",\"source\":\"storyboard\",\"gridIndex\":1,\"kind\":\"image\",\"name\":\"宫格分镜 2\",\"start\":1.6666666666666667,\"duration\":1.6666666666666667,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"storyboard_2\",\"source\":\"storyboard\",\"gridIndex\":2,\"kind\":\"image\",\"name\":\"宫格分镜 3\",\"start\":3.3333333333333335,\"duration\":1.6666666666666667,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"storyboard_3\",\"source\":\"storyboard\",\"gridIndex\":3,\"kind\":\"image\",\"name\":\"宫格分镜 4\",\"start\":5,\"duration\":1.6666666666666667,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"storyboard_4\",\"source\":\"storyboard\",\"gridIndex\":4,\"kind\":\"image\",\"name\":\"宫格分镜 5\",\"start\":6.666666666666667,\"duration\":1.6666666666666667,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"storyboard_5\",\"source\":\"storyboard\",\"gridIndex\":5,\"kind\":\"image\",\"name\":\"宫格分镜 6\",\"start\":8.333333333333334,\"duration\":1.666666666666666,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"image_1786417322208_dsrl07\",\"kind\":\"image\",\"file\":\"sf_h3_director/0d8d7816834d7463a412169c099ae887c97d7152ff05b0cbbd7254afe13bca9d.jpg\",\"name\":\"ScreenShot_2026-08-11_110144_677.jpg\",\"width\":669,\"height\":1195,\"mediaDuration\":0,\"hasAudio\":false,\"includeAudio\":false,\"start\":0,\"duration\":3.3333333333333335,\"prompt\":\"\",\"sound\":\"\"},{\"id\":\"image_1786417364562_k84ht1\",\"kind\":\"image\",\"file\":\"sf_h3_director/4230d5e372a760fd9b7a44e931e46b8269dd16284544c6485a6a85c5857a5edf.jpg\",\"name\":\"ScreenShot_2026-08-11_110236_726.jpg\",\"width\":922,\"height\":1234,\"mediaDuration\":0,\"hasAudio\":false,\"includeAudio\":false,\"start\":3.3333333333333335,\"durat