ame": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "title": "09 状态07_绕前转身", "mode": 0, "bgcolor": "#344", "size": [380, 610], "pos": [1440, 900], "id": 26, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 7}, {"outputs": [{"name": "IMAGE", "links": [35], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#233", "widgets_values": ["69f699ce461ba8d3a5179d5b538f32c3cffd865ba375e6d662195cf967590510.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "title": "10 状态08_向左走", "mode": 0, "bgcolor": "#344", "size": [380, 610], "pos": [1880, 900], "id": 27, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 8}, {"outputs": [{"name": "prompt", "links": [27], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#233", "widgets_values": ["制作一段20秒、16:9的连续喜剧短片，720p。画面使用参考图一致的复古像素游戏插画质感，保持色块轮廓、像素细节、暖橙灯笼与冷蓝石板路的配色，避免中途改变画风。两名角色都是成年人、虚构游戏角色：绿衣青年约25岁，蓝衣女子约27岁。严格保持各自脸型、发型、衣服颜色与款式；青年绿色古装、金色腰带与发冠，女子深蓝白条运动服和白鞋。两人始终各只有一个，四肢与双手结构正常。\n固定机位的横幅全身中远景，地面与两人的鞋完整可见，不切镜头，不突然变焦，不跨轴。人物移动在画幅内完成。摊位和兔子奖品固定不动，光照稳定；金圈大小和材质始终不变。青年主动配合扮演木偶奖品，金圈宽松地围住腰部及两侧前臂，有明显空隙，不捆绑、不承重；双手在圈下方可见。女子只是轻扶圈沿示意方向，青年自己小步移动。衣服与圈不穿模，不出现额外圈或肢体。\n声音：生成与动作同步的环境音效，包括轻微夜市风声、远处无语音的摊位杂响、蓝色小圈碰木台的清脆轻响、脚步声、衣料摩擦和金圈的轻微碰响。默认无旁白、无对白、无人声、无笑声、无演唱、无配乐。不要读取或模仿任何参考音频。画面无字幕、无文字、无水印、无签名、无标志。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "title": "11 风格与环境音效", "mode": 0, "bgcolor": "#344", "size": [600, 480], "pos": [2360, 150], "id": 21, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 9}, {"outputs": [{"name": "prompt", "links": [28], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#233", "widgets_values": ["参考图顺序与用途：\n@image1：绿衣青年身份参考，只锁定人物外观，不使用其纯色背景。\n@image2：蓝衣女子身份参考，只锁定人物外观，不使用其纯色背景。\n@image3：状态01，约0秒，青年瞄准兔子奖品，蓝色小圈在手，女子站在右后方，金色大圈挂在摊位木钩。\n@image4：状态02，约2.5秒，小蓝圈落在兔子底座周围；青年摊开双手示意轮到女子，金色大圈仍在木钩。\n@image5：状态03，约4.7秒，女子从木钩取下金色大圈，双手将其水平举到青年头顶上方；木钩变空。\n@image6：状态04，约6.9秒，女子将大圈缓慢降到青年腰部，圈内同时包含腰和两侧前臂；青年低头看圈。\n@image7：状态05，约9秒，青年挺直身体、手臂自然垂下、双手露在圈下，端着一本正经的表情，主动扮演奖品；女子在他右侧轻扶圈沿。\n@image8：状态06，约11.8秒，两人向画面右方移动，女子回头看青年；青年躯干保持直立，用极小的交替碎步跟上。\n@image9：状态07，约15.8秒，女子已从青年右侧绕到他身前再到左侧，转向左方，轻扶圈的手自然换到左手；青年整个身体随之小步转向，面向镜头的中间姿态。\n@image10：状态08，约18秒，女子在青年左侧向画面左方走，左手向后轻扶金圈，回头微笑；青年朝左，用小碎步跟随，仍故作严肃。\n\n连续动作时间安排：\n0–2.5秒：青年投出蓝色小圈，形成短而清楚的弧线，恰好套中兔子底座，随后空手示意女子尝试。小圈此后留在兔子底座，不能再回到手中。\n2.5–4.7秒：女子看向挂着的大金圈，走近并取下它，双手举过青年头顶。动作完整可辨，不瞬移。\n4.7–6.9秒：女子平稳向下降圈；青年配合将双臂靠近身体，让圈从外侧越过双臂，最终宽松停在腰部。衣袖和圈沿不互相穿透。\n6.9–9秒：青年先低头看圈，再抬头收起笑意，挺直身子装成木偶奖品。女子笑着轻扶右侧圈沿。\n9–11.8秒：女子向画面右方迈出自然步伐，青年用非常短的交替碎步跟随；至少一只脚始终着地，上身不能像正常大步走路那样大幅摆动。\n11.8–15.8秒：女子放慢并绕过青年的身前走到左侧，扶圈的手沿前圈沿移动并自然换手；青年用数个小步整体转身，不扭断腰颈，不原地滑行，不悬空。\n15.8–18秒：女子向左迈步，左手轻扶圈沿；青年转为面向左方，脚步很小而连贯，上半身仍像奖品般端正。\n18–20秒：延续向左的小步移动和轻松喜剧节奏，两人保持在画面内，结束时运动自然减缓，禁止突然跳帧或切换姿势。\n\n上述时点是动作节奏目标，参考图是状态锚点，不把它们做成静止幻灯片。用连续自然的中间动作连接状态。兔子、蓝圈、木台、木箱、空木钩等背景物件保持前后因果一致。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "title": "12 剧情与参考图顺序", "mode": 0, "bgcolor": "#344", "size": [600, 1190], "pos": [2360, 750], "id": 13, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order"