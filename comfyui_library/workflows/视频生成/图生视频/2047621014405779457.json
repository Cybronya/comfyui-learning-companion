		{
			"outputs":[
				{
					"name":"text",
					"links":[
						7
					],
					"label":"text",
					"type":"STRING",
					"localized_name":"text"
				}
			],
			"color":"#232",
			"widgets_values":[
				" @image1=老机械厂食堂后巷,@image2=林晚,@image3=冯素芬,@image4=旧饭票,@image5=食堂门口广播区，@image6=林依依，@image7=播音稿。，低\n  饱和，真实纹理，人物面部稳定，动作连贯自然，保留音效，保留对白，不要字幕，不要配乐。\n{\n      \"镜头序列\": 5,\n      \"时长\": \"3秒\",\n      \"场景\": \"老机械厂食堂后巷\",\n      \"人物\": \"林晚_前期\",\n      \"动作描述\": \"林晚抬头，脸上还挂着污水，却把饭票攥得更紧。\",\n      \"主画面描述\": \"中近景只留林晚半身和眼神，85mm，背景人群虚化成一团灰影，镜头轻微俯拍压住她的脆弱，再用抬头瞬间制造反弹力量。\",\n      \"景别\": \"中近景\",\n      \"视角\": \"轻俯角\",\n      \"运镜\": \"定镜后轻推\",\n      \"构图\": \"人物居中，脸部占画面三分之一以上\",\n      \"镜头焦距\": \"85mm\",\n      \"氛围\": \"强忍、冷下来\",\n      \"色调\": \"灰冷偏白\",\n      \"台词\": \"林晚：票不是在我口袋里，是在你们脚边。\",\n      \"音效\": \"人群短暂静默、远处锅炉继续轰鸣\",\n      \"引用资产\": {\n        \"场景\": \"老机械厂食堂后巷\",\n        \"角色\": [\"林晚_前期\", \"冯素芬\"],\n        \"道具\": [\"旧饭票\"]\n      }\n    },\n    {\n      \"镜头序列\": 6,\n      \"时长\": \"3秒\",\n      \"场景\": \"食堂门口广播区\",\n      \"人物\": \"林晚_前期, 工人群众\",\n      \"动作描述\": \"四周工人围成一圈，饭票争执引来更多人停下脚步。\",\n      \"主画面描述\": \"远景把食堂门口和围拢的人群一起纳入画面，35mm，门口的红砖、广播杆、蒸汽白雾形成时代感，林晚被挤在画面左下角，显得渺小却尖锐。\",\n      \"景别\": \"远景\",\n      \"视角\": \"平视\",\n      \"运镜\": \"横向缓慢扫过人群\",\n      \"构图\": \"中心留给围观圈，林晚处于左下压角\",\n      \"镜头焦距\": \"35mm\",\n      \"氛围\": \"围观、起哄\",\n      \"色调\": \"灰蓝\",\n      \"台词\": \"工人甲：临时工不靠谱，这下撞上了吧。\",\n      \"音效\": \"窃窃私语、人群挪动脚步声\",\n      \"引用资产\": {\n        \"场景\": \"食堂门口广播区\",\n        \"角色\": [\"林晚_前期\", \"冯素芬\"],\n        \"道具\": [\"旧饭票\"]\n      }\n    },\n    {\n      \"镜头序列\": 7,\n      \"时长\": \"3秒\",\n      \"场景\": \"食堂门口广播区\",\n      \"人物\": \"林依依\",\n      \"动作描述\": \"林依依抱着播音稿，从食堂台阶上缓步下来，白衬衣一尘不染。\",\n      \"主画面描述\": \"中远景让林依依从广播楼台阶进入画面中心，50mm，人物背后是广播喇叭和门头标牌，白衬衣在灰蒙环境里形成强反差，像把一滴干净的油漆泼进脏水里。\",\n      \"景别\": \"中远景\",\n      \"视角\": \"略仰角\",\n      \"运镜\": \"跟随下台阶缓推\",\n      \"构图\": \"中轴构图，人物从上到下占据视线中心\",\n      \"镜头焦距\": \"50mm\",\n      \"氛围\": \"表面温和、实际冰冷\",\n      \"色调\": \"灰白\",\n      \"台词\": \"林依依：经食堂小组决定，林晚即日起暂停岗位，配合调查。\",\n      \"音效\": \"广播喇叭电流声、台阶脚步声\",\n      \"引用资产\": {\n        \"场景\": \"食堂门口广播区\",\n        \"角色\": [\"林依依\"],\n        \"道具\": [\"播音稿\"]\n      }\n    },\n    {\n      \"镜头序列\": 8,\n      \"时长\": \"3秒\",\n      \"场景\": \"食堂门口广播区\",\n      \"人物\": \"林依依\",\n      \"动作描述\": \"林依依把播音稿贴近嘴边，广播声压过人群。\",\n      \"主画面描述\": \"近景压在林依依和广播喇叭之间，35mm，喇叭占据前景，声波感与人声一起形成压迫，镜头轻微上仰突出她的权威姿态。\",\n      \"景别\": \"近景\",\n      \"视角\": \"仰角\",\n      \"运镜\": \"轻微推近后停住\",\n      \"构图\": \"前景喇叭、后景人物，形成广播权力感\",\n      \"镜头焦距\": \"35mm\",\n      \"氛围\": \"公开宣判\",\n      \"色调\": \"冷白偏灰\",\n      \"台词\": \"林依依：另，因宿舍床位紧张，原床位另作调整，请相关人员知晓。\",\n      \"音效\": \"高音广播电流声、周围人群短促吸气\",\n      \"引用资产\": {\n        \"场景\": \"食堂门口广播区\",\n        \"角色\": [\"林依依\"],\n        \"道具\": [\"播音稿\"]\n      }\n    },\n\n"
