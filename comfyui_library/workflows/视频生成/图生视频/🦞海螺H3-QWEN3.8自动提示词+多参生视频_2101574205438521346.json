w"}, "shape": 7, "name": "no_preview", "type": "BOOLEAN", "localized_name": "no_preview"}], "flags": {}, "type": "VHS_VideoCombine", "mode": 0, "bgcolor": "#535", "size": [687.11767578125, 1532.2047119140625], "pos": [836.3065185546875, 4878.9951171875], "id": 143, "properties": {"cnr_id": "comfyui-videohelpersuite", "ver": "a7ce59e381934733bfae03b1be029756d6ce936d", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "VHS_VideoCombine"}, "order": 32}, {"outputs": [{"name": "STRING", "links": [], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["兰蔻小黑瓶｜肌底微生态修护 8镜影视广告脚本（科技未来风）\n视频总时长：15s（短视频黄金时长，适配全域投放）\n核心风格：科技微生态未来风、冷调高级质感、微距写实+微观特效结合\n核心诉求：可视化呈现「修护肌底、平衡微生态、细腻维稳、焕亮肤质」核心功效，弱化人像氛围感，强化产品力与科技感\n整体视听基调：低饱和暗调基底、冰蓝+银白微光光影、极简留白、轻柔未来感电子氛围音、精准卡点剪辑\n镜头序号\n\t镜头主题\n\t时长\n\t镜头调度\n\t画面内容\n\t光影设计\n\t音效设计\n\t屏幕字幕\n\n1\n\t开篇·氛围入画｜定调\n\t2s\n\t极致慢推空镜，固定机位\n\t纯暗灰渐变极简背景，朦胧水雾缓缓流动，无数细碎银白活性粒子悬浮游离，画面干净通透，无多余元素，铺垫肌底微观宇宙的科技氛围\n\t冷调漫射柔光，无光斑、无硬阴影，整体朦胧高级\n\t轻柔空灵的未来电子起势，细微粒子流动沙沙白噪音\n\t无\n\n2\n\t产品登场｜质感亮相\n\t2s\n\t中近景，缓慢落镜，居中构图\n\t兰蔻小黑瓶轻盈悬浮于微观粒子空间，黑银渐变瓶身通透立体，瓶身金属光泽精准反光，周围微光粒子环绕游走，产品质感拉满，凸显高端科技属性\n\t冰银色轮廓光勾勒瓶身线条，侧逆光穿透玻璃瓶，消解死黑，层次通透\n\t氛围音轻微上扬，加入清脆空灵的质感点睛音\n\t无\n\n3\n\t取液特写｜质地可视化\n\n\t2s\n\t微距特写，定格抓拍\n\t品牌专属滴管深入瓶中吸取精华，缓缓提起，一滴晶莹剔透的蛋清质地精华悬挂于管尖，水润通透、丝滑轻薄，无厚重黏腻感，动态定格精华最佳状态\n\t定点束光穿透精华液，液体自带通透光泽，明暗对比极致，凸显纯净质地\n\t细微液体流动声，干净治愈\n\t无\n\n4\n\t上肤瞬间｜接触渗透\n\t2s\n\t手部局部特写，近距离平视机位\n\t干净细腻的女性手部肌肤，精华液轻落于指腹，瞬间摊开、水润化开，质地轻薄不厚重，肌肤表层瞬间泛起水润柔光\n\t柔肤自然光+冷调补光，保留真实肌肤纹理，不假白、不磨皮，凸显原生肤质质感\n\t轻柔的液体触肤声，氛围音持续递进\n\t无\n\n5\n\t微观特效｜肌底修护原理\n\t2s\n\t微观透视特效，叠层画面\n\t基于真实肌肤表层，透视呈现皮下肌底状态，淡蓝微光流线、活性粒子顺着肌肤纹理层层渗透，紊乱的肌底微生态逐渐趋于规整、平衡，直观演绎修护机理\n\t内发光微光特效，暗光衬亮光源，科技感通透不浮夸\n\t轻微能量涌动音效，节奏渐强\n\t肌底微生态 焕活修护\n\n6\n\t局部护肤｜真实使用场景\n\t2s\n\t侧脸局部特写，跟拍运镜\n\t女性下颌、脸颊局部画面，指腹轻柔打圈按摩上肤，精华快速吸收，肌肤表层黏腻感完全消失，肤质瞬间变得细腻平滑，毛孔隐匿，状态通透干净\n\t冷暖中和柔光，凸显肌肤水润光泽，呈现高级素颜肌质感\n\t舒缓治愈的护肤轻音，节奏平稳\n\t细腻维稳 强韧屏障\n\n7\n\t肤质蜕变｜效果呈现\n\t2s\n\t肌肤微距特写，静态定格\n\t修护后的肌肤微距细节，肤质均匀通透、紧致细腻，自带原生水光肌光泽，无粗糙、暗沉、泛红问题，肌底状态健康稳定，视觉对比强烈\n\t柔焦定光，均匀铺洒肤质光泽，质感高级真实\n\t音效轻微落收，留白蓄力\n\t焕亮原生好肤质\n\n8\n\t收尾定版｜品牌收官\n\t1s\n\t全景定格，居中构图\n\t小黑瓶产品重回画面中心，纯净粒子光影环绕包裹瓶身，画面极简干净，最后定格产品正装+品牌LOGO\n\t全局柔光收尾，微光渐亮，质感高级收官\n\t点睛收尾音效，干净利落\n\t兰蔻小黑瓶肌底精华｜修护肌底 稳驻年轻\n\n|（注：文档部分内容可能由 AI 生成）"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {"collapsed": true}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [370, 390], "pos": [-1186.5767822265625, 5877.38134765625], "id": 155, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 16}, {"outputs": [{"name": "positive", "links": [270], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [271], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "color": "#223", "widgets_values": ["", 1344, 768, 124, "match"], "inputs": [{"name": "clip", "link": 272, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "link": 273, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "audio_vae", "link": 274, "label": "audio_vae", "type": "VAE", "localized_name": "audio_vae"}, {"shape": 7, "name": "ref_images.ref_image_0", "link": 278, "label": "ref_images.ref_image_0", "type": "IMAGE", "localized_name": "ref_image_0"}, {"shape": 7, "name": "ref_images.ref_image_1", "link": 282, "label": "ref_images.ref_image_1", "type": "IMAGE", "localized_name": "ref_image_1"}, {"shape": 7, "name": "ref_images.ref_image_2", "link": 283, "label": "ref_images.ref_image_2", "type": "IMAGE", "localized_name": "ref_image_2"}, {"shape": 7, "name": "ref_images.ref_image_3", "link": 292, "label": "ref_images.re