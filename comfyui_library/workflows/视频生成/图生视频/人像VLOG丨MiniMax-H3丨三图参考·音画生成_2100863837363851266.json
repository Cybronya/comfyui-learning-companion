ptions, logos or watermarks.\nThe image has natural skin texture, soft afternoon sunlight, realistic fabric, stable composition and restrained motion. Keep the complete hat and face within the portrait frame.\n\noverall_soundscape:\nQuiet summer ambience with a gentle breeze and faint distant birds. No speech or narration.\n\nnon_diegetic_music:\nA soft, slow acoustic guitar melody at low volume, beneath the natural ambience.", 768, 1376, 243, "match"], "inputs": [{"name": "clip", "link": 281, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "link": 282, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "audio_vae", "link": 283, "label": "audio_vae", "type": "VAE", "localized_name": "audio_vae"}, {"shape": 7, "name": "ref_images.ref_image_0", "link": 313, "label": "ref_images.ref_image_0", "type": "IMAGE", "localized_name": "ref_image_0"}, {"shape": 7, "name": "ref_images.ref_image_1", "link": 288, "label": "ref_images.ref_image_1", "type": "IMAGE", "localized_name": "ref_image_1"}, {"shape": 7, "name": "ref_images.ref_image_2", "link": 293, "label": "ref_images.ref_image_2", "type": "IMAGE", "localized_name": "ref_image_2"}, {"shape": 7, "name": "ref_images.ref_image_3", "label": "ref_images.ref_image_3", "type": "IMAGE", "localized_name": "ref_image_3"}, {"shape": 7, "name": "ref_videos.ref_video_0", "label": "ref_videos.ref_video_0", "type": "IMAGE", "localized_name": "ref_video_0"}, {"shape": 7, "name": "ref_video_audios.ref_video_audio_0", "label": "ref_video_audios.ref_video_audio_0", "type": "AUDIO", "localized_name": "ref_video_audio_0"}, {"shape": 7, "name": "ref_audios.ref_audio_0", "label": "ref_audios.ref_audio_0", "type": "AUDIO", "localized_name": "ref_audio_0"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 316, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 305, "label": "width", "type": "INT", "local