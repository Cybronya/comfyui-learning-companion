			"color":"#232",
			"widgets_values":[
				"```json\n{\n  \"global_settings\": \"image1是女主李雪，image2是男主韩风，image3是擂台布局图片，image4是视频对应的分镜图片。以提供的分镜、男女主角及擂台图片为参考，生成10秒国风仙侠水墨二次元风格视频，16:9画幅，4K超清；全程保持人设、场景与画风统一，融入角色对话、动作音效与国风BGM，呈现完整比武叙事。\",\n  \"scene1\": {\n    \"time\": \"0-2s\",\n    \"visual\": \"全景：云海浮空擂台，金色阵纹微光流转；白衣男主韩风、粉衣女主李雪分立两侧，气场对冲，衣袂微动。\",\n    \"audio\": \"李雪（冷静）：'韩风，你又突破了。' 韩风（沉稳）：'彼此彼此。'；背景音：风声、法阵嗡鸣。\",\n    \"bgm\": \"低沉古琴+萧声，营造肃穆氛围。\"\n  },\n  \"scene2\": {\n    \"time\": \"2-4s\",\n    \"visual\": \"中景：两人同时蓄力，韩风指尖引动青光，李雪掌心凝聚紫芒，擂台阵纹随灵力亮起。\",\n    \"audio\": \"韩风（低语）：'你的修为也精进了。' 李雪：'今日便分胜负。'；背景音：灵力流转声、衣袂风声。\",\n    \"bgm\": \"节奏渐强，加入轻鼓点。\"\n  },\n  \"scene3\": {\n    \"time\": \"4-6s\",\n    \"visual\": \"近景：韩风拔剑斩出青光，李雪抬手凝聚紫晶结界格挡，能量碰撞迸发细碎火花。\",\n    \"audio\": \"李雪：'接招！' 韩风轻笑：'来得好！'；背景音：拔剑声、剑气破空声、结界碰撞声。\",\n    \"bgm\": \"进入打斗节奏，古筝与弦乐交织。\"\n  },\n  \"scene4\": {\n    \"time\": \"6-8s\",\n    \"visual\": \"全景：两人高速缠斗，韩风剑影翻飞，李雪以紫电反击，青紫光流在擂台交织。\",\n    \"audio\": \"无台词；背景音：剑刃碰撞声、衣袂破空声、能量炸裂声。\",\n    \"bgm\": \"节奏拉满，民乐齐鸣，气势磅礴。\"\n  },\n  \"scene5\": {\n    \"time\": \"8-10s\",\n    \"visual\": \"高潮：两人同时释放大招，青光剑浪与紫电洪流在擂台中央碰撞，强光席卷云海；光芒散去后，两人分立两侧，气息微喘，对峙定格。\",\n    \"audio\": \"无台词；背景音：终招碰撞轰鸣、强光消散声、风声渐息。\",\n    \"bgm\": \"高潮后回落，以悠远萧声收尾。\"\n  }\n}\n```"
