idget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveFloat"}, "order": 9}, {"mode": 0, "outputs": [{"name": "text", "links": [319], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [400.7539367675781, 220.35665893554688], "pos": [-1962.05419921875, 2276.364990234375], "widgets_values": ["生成一段细腻的 Live2D 风格角色循环动画，保持输入图像的原始人物身份、面部结构、服装、背景、构图和色彩完全一致。\n镜头完全固定，无推拉、无摇移、无缩放。人物始终保持原来的位置和姿势。\n局部运动：\n人物自然眨眼一到两次。眨眼动作柔和完整，双眼同步闭合并自然睁开，不要频繁眨眼，不要眼皮抖动，不要改变虹膜形状或视线方向。虹膜高光随眼球产生极轻微而自然的变化。\n人物保持平缓呼吸。肩膀、胸口和身体仅产生非常轻微、连续的呼吸起伏，运动幅度小，不改变身体轮廓和姿势。\n一阵稳定而轻柔的微风从人物后方吹来。只有发梢和少量边缘发丝缓慢飘动，发根保持固定，头发运动柔和、有重量感、无穿模、无拉伸、无发量变化。头发在视频中段达到最大偏移，然后沿连续轨迹缓慢回到初始位置。\n服装主体保持稳定，只允许衣领或衣物边缘产生极轻微的呼吸和风力响应。背景、饰品、身体姿势和画面构图保持稳定。\n循环要求：\n第一帧与最后一帧的面部表情、眼睛状态、头发位置、身体姿势、光照和构图一致。所有运动在视频结束前自然回到初始状态，形成平滑的周期循环。\n禁止静止画面，禁止整体漂移，禁止镜头运动，禁止突然反向，禁止硬切，禁止形变，禁止五官漂移，禁止多余肢体，禁止头发增长或减少，禁止背景变化，禁止闪烁。", true], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "enabled"}, "name": "enabled", "label": "enabled", "type": "BOOLEAN", "localized_name": "enabled"}], "flags": {}, "id": 201, "type": "TextInputNode", "title": "提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInputNode"}, "order": 10}, {"mode": 0, "outputs": [{"name": "STRING", "type": "STRING"}], "size": [210, 60], "pos": [-1540.8050537109375, 2444.823974609375], "widgets_values": ["prompt"], "inputs": [{"name": "STRING", "link": 319, "type": "STRING"}], "flags": {}, "id": 199, "type": "SetNode", "title": "Set_prompt", "properties": {"previousName": "prompt", "aux_id": "kijai/ComfyUI-KJNodes", "Node name for S&R": "SetNode"}, "order": 15}, {"outputs": [], "color": "#432", "widgets_values": ["根据图片的实际情况自定义提示词"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [255.8596649169922, 166.7368927001953], "pos": [-1536.4439697265625, 2214.78125], "id": 205, "properties": {}, "order": 11}, {"mode": 0, "outputs": [{"nam