TRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["正面词：电影感真人摄影，热带丛林实景，奇幻生物，自然光与体积雾，浅景深，35mm镜头质感，无文字无水印无边框。第一个镜头，左上，中景，2秒，承接上一镜头黑影掠过，巨兽自盘根巨木后探身而出，青苔鳞甲覆身、体型压迫，镜头从苏瑶侧前方缓慢横移展示她正面朝向巨兽、渺小却不退缩的对峙姿态，巨兽低吼与枝叶震落声轰然。第二个镜头，右上，近景，4秒，苏瑶正面直视前方，眼神由惊转定，镜头缓慢推近她的面部，呼吸声交叠。第三个镜头，左下，特写，2秒，巨兽獠牙利爪与鳞甲纹理特写、涎液反光，镜头以仰视机位定格其威慑之姿，涎液滴落与鳞甲摩擦声清晰。第四个镜头，右下，近景，4秒，苏瑶横刃于身前摆出防御姿态下颌绷紧，镜头定格在她戒备的侧脸与握刃的手，为下一镜头的对峙爆发留出承接。[苏瑶用标准普通话（冷静）：别过来。]\n音效:巨兽低吼声，枝叶震落声，涎液滴落声，金属刃鸣声"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "宫格分镜文本（可接反推模型）", "mode": 0, "bgcolor": "#353", "size": [556.5672607421875, 248.38365173339844], "pos": [450.80810546875, 0], "id": 138, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 6}, {"outputs": [{"name": "MODEL", "links": [], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#323", "widgets_values": ["minimax_h3_fl2va_pruned_fp8_scaled.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "type": "UNETLoader", "mode": 0, "bgcolor": "#535", "size": [403.44940185546875, 86.5237045288086], "pos": [0, 478], "id": 127, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 7}, {"outputs": [{"name": "MODEL", "links": [41], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "color": "#323", "widgets_values": ["minimax_h3_fl2va_int8_convrot.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "lab