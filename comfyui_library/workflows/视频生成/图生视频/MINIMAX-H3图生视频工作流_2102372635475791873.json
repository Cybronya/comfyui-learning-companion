女剑士站在庞然巨像脚下，辽阔沼泽荒原铺展至远方层叠山峦，薄雾笼罩整片大地，镜头缓慢静止，苍凉宏大世界观氛围定格收尾\n\n负面提示词：卡通，二次元，明亮鲜艳色彩，畸形肢体，崩坏五官，人物扭曲，画面剧烈闪烁抖动，水印文字，塑料质感，高饱和度，阳光暴晒，现代建筑，低画质"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 21, "type": "Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 10}, {"mode": 0, "outputs": [{"name": "INT", "links": [12], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [270, 58], "pos": [190.9124755859375, 425.4059143066406], "widgets_values": [15], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 16, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 11}, {"mode": 0, "outputs": [{"name": "VIDEO", "links": [33], "label": "VIDEO", "type": "VIDEO", "localized_name": "视频"}], "size": [270, 150], "pos": [2018.45166015625, -307.8586730957031], "widgets_values": [24, "auto", "sRGB", "none"], "inputs": [{"name": "images", "link": 28, "label": "images", "type": "IMAGE", "localized_name": "图像"}, {"shape": 7, "name": "audio", "link": 29, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "fps"}, "name": "fps", "label": "fps", "type": "FLOAT", "localized_name": "帧率"}, {"widget": {"name": "bit_depth"}, "shape": 7, "name": "bit_depth", "label": "bit_depth", "type": "COMBO", "localized_name": "bit_depth"}, {"widget": {"name": "color_space"}, "shape": 7, "name": "color_space", "label": "color_space", "type": "COMBO", "localized_name": "color_space"}, {"widget": {"name": "codec"}, "shape": 7, "name": "codec", "label": "codec", "type": "COMBO", "localized_name": "codec"}], "flags": {}, "id": 31, "type": "CreateVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CreateVideo"}, "order": 23}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"nam