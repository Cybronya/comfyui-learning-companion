me": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314.0000305175781], "pos": [-1336.23583984375, -117.84175109863281], "widgets_values": ["89fb5a0023fca908fb6e892ed925f009007a1df4bb093305e4b2518dc929fb93.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 19, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 7}, {"mode": 0, "outputs": [{"name": "conditioning", "slot_index": 0, "links": [14], "label": "conditioning", "type": "MINIMAX_H3_CONDITIONING", "localized_name": "conditioning"}], "size": [448.2731628417969, 546.7102661132812], "pos": [1339.5828857421875, -452.67974853515625], "widgets_values": ["基础设定：严格锁定角色形象，黑色半扎长发，银色镂空发冠，黛蓝发带，白内搭渐变浅蓝薄纱广袖汉服，半透冰蓝外袍，深蓝雕花腰封，银色花形腰扣与垂坠流苏；4K 电影级写实 3D 渲染，清冷仙侠色调，云雾、金色流光法阵特效，悲壮宿命氛围感，镜头流畅动态衔接，拒绝静态 PPT；远景只使用背影 / 侧背影，正脸仅用于特写、近景。\n台词（悲壮赴死基调）：大道漫漫，生死何惧。纵燃此身，亦要为苍生开辟一线生机。\n(00-1.2s) 眼部极端特写缓慢上摇，清冷眼眸直视前方，发丝被狂风拂过面庞，眼底藏决绝，天光微弱落在眼睫，情绪肃穆悲凉。\n男主低沉开口：大道漫漫\n(1.2-2.4s) 柔缓过渡切手部特写，双手结仙侠法印，金色星芒流光自指缝盘旋涌动，纱质衣袖随罡风剧烈飘动。\n男主：生死何惧。\n(2.4-3.4s) 镜头顺势拉出侧颜中景，人物侧身抬手向前延展，长发与薄纱衣袍肆意飞扬，乌云在身后翻涌。\n(3.4-4.6s) 镜头横移切换远景背影，男子立于云海镜面水面，缓步走向巨型金色环形法阵，群山云雾环绕，衣摆随风舒展。\n男主：纵燃此身，\n(4.6-5.6s) 缓慢抬升空镜，浩瀚云海之上，巨大螺旋金色星轨天幕缓缓旋转，残碎流星划过云层。\n(5.6-6.6s) 跟随人物背部跟拍，侧背视角向前行走，漫天云雾碎石漂浮，长发外袍持续向后飞扬。\n男主：亦要\n(6.6-7.4s) 快速下压特写，聚焦腰间银色雕花腰封与流苏，薄纱面料随风猛烈起伏，微光在刺绣纹路间明灭。\n(7.4-8.6s) 环绕慢推面部近景，冷峻侧脸，目光坚定一往无前，冷光勾勒下颌轮廓。\n男主：为苍生开辟\n(8.6-10.0s) 镜头向后拉远，完整背影定格，男子身后骤然爆发巨大金色光翼法阵，碎石四散激荡，宏大史诗光影，画面缓缓沉暗收束。\n男主尾音沉落：一线生机。", "match"], "inputs": [{"name": "h3_text_encoder", "link": 9, "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"name": "h3_vae_bundle", "link": 10, "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BU