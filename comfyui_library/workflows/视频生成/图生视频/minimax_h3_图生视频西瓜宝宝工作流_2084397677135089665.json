ent"}], "size": [430, 550], "pos": [540, 4760], "widgets_values": ["3D皮克斯动画风格，超可爱Q版西瓜水果宝宝坐在木质桌面上。它全身涵盖绿黑条纹西瓜皮质感，圆胖脸颊带有粉红腮红与水珠，头顶长着卷曲的小西瓜藤和绿叶。西瓜宝宝双脚蜷坐，双手紧抱一块带有咬痕的大红西瓜切片。它开心地大口咬下西瓜，笑得大眼睛很是漂亮，嘴唇和下巴滴落着晶莹剔透的西瓜汁，汁液溅落。接着它俏皮地眨了眨一只左边的大眼睛（眨眼），又一大口吃着西瓜，西瓜汁喷溅而出，笑声甜美，整个人体动作极其灵动萌趣。微距视角，柔和工作室暖色光影，两侧背景是模糊的西瓜切片景深虚化，4K超高清渲染，流畅流体物理效果。", 1344, 768, 73], "inputs": [{"name": "clip", "link": 241, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 242, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 260, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 261, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 262, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 247, "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "id": 133, "type": "MiniMaxH3ImageToVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MiniMaxH3ImageToVideo"}, "order": 16}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "KKvideo_latentpreview": false, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-184.79222909187402, -4663.944678359846], "scale": 1.1671841070450018}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "Use Image Size", "bounding": [-1530, 5540, 296.484375, 354]}], "links": [[229, 122, 0, 123, 1, "VAE"], [230, 121, 0, 124, 1, "VAE"], [231, 