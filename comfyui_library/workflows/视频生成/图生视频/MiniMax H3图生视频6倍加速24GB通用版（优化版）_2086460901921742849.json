minimax_h3_nvfp4_awq.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 7}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [645], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [640, 90], "pos": [12841.4912109375, 7436.30224609375], "widgets_values": ["minimax_h3_fl2va_bf16.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 420, "type": "UNETLoader", "properties": {"models": [{"directory_invalid": true, "name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 8}, {"outputs": [{"name": "STRING", "links": [639], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#322", "widgets_values": ["【任务定位】\n图片到视频（I2V）测试，16:9，时长 10 秒，单人可说话测试。以 <Picture 1> 作为起始图。重点测试：舞台人物面部稳定、自然说话、眼神变化、肩颈与上半身自然联动、舞台复杂光线与镜头拉近。\n【说话者】\n<Subject 1> = (S1)，画面中的舞台发言女性。\n【递进式详细提示词】\n以 <Picture 1> 作为精确起始帧。保留参考图人物原有五官、发型、服装、身形比例、整体气质与光影色调，全程保持同一人物身份。视频为 16:9 横版，时长 10 秒，真实舞台拍摄质感，电影感镜头，面部稳定，脸部不崩，不出现眼球错位、嘴型错乱、画面抖动或细节闪烁。\n整体环境为高级简约舞台空间，背景柔和虚化，带有渐变冷暖舞台灯光、细腻光束、轻薄烟雾、柔和聚光灯、暗场反射与轻微环境光呼吸变化。舞台画面干净有层次，不加入杂乱道具，不增加随机饰件。S1 以自然中文口型说话，口型清晰可读，微表情真实，舞台氛围随说话过程逐渐变得更有互动感。\n0.0-2.0s：S1 先维持起始近中景状态，眼神从下方缓慢抬起看向镜头，表情灵动亲和，嘴唇微启，呈现即将开口互动的状态；舞台背景灯带与环境光做低频明暗呼吸变化，画面柔和有氛围感。\n2.0-4.0s：S1 开始说第一句话，头部缓慢偏转到更正面的位置，肩颈和上半身随说话节奏轻微自然联动，舞台互动感十足；镜头向前推进一点，再轻微向左横移，利用舞台光束和背景层次制造空间纵深。\n4.0-6.5s：S1 抬起一只手，手背或指尖从胸前缓慢经过，舞台互动手势，亲和力拉满；眼神在说话时更集中，嘴型清晰，唇形不能乱；背景中若隐若现的舞台光束扫过，冷暖舞台灯光短暂增强，远处舞台灯光逐次点亮。\n6.5-8.5s：S1 说出后半句轻快互动的台词，同时身体微微前倾，拉近与观众距离；发丝、服装只做可控摆动，不能乱闪、乱抖；镜头轻微后撤一点，让人物从极近变成更稳定的中近景，视觉焦点始终保持在人物上半身。\n8.5-10.0s：S1 在说完最后一个词后，温柔注视镜头，神态活泼亲切；舞台灯光小幅提亮后缓缓回落，背景光束和烟雾同步减弱，留下亲切互动的收尾，适合衔接后续表演内容。\n【台词】\n(S1)：“我是 AI 大虾创作的数字人，大家有没有被我的歌声惊艳到？”\n【连续性与约束】\n口型与说话自然，脸部不能崩，保持人物五官稳定。\n舞台细节要丰富，但不可过度闪烁，不可增加随机饰件。\n重点是上半身自然联动和舞台发言互动感，不必突然切远景。\n保持 16:9 横图逻辑与同一人物身份。\n保留参考图人物外貌、发型、服装和整体气质，不要改变人物设定。\n所有动作轻微、人性化，避免大幅度身体晃动、手部畸形、衣服乱抖。\n舞台灯光变化柔和渐变，禁止频闪、忽明忽暗、突然跳变。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "正向提示词 / Positive Prompt", "mode": 0, "bgcolor": "#533", "size": [370, 390], "pos": [12364.884765625, 7105.59765625], "id": 424, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 9}, {"mode": 0, "outputs": [{"name": "positive", "links": [630], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [628], "label": "LATENT", "type": "LATENT", "localized_name": "LATENT"}], "size": [410, 510], "pos": [13511.2998046875, 7209.06884765625], "widgets_values": ["Use the input image as the core visual reference. Preserve the female swordswoman’s exact facial identity, pale and ethereal beauty, long flowing black hair, elegant golden hair ornament, black-and-white ancient Chinese fantasy costume with delicate gold embroidery, translucent layered sleeves, slender body proportions, and the ornate blue-gold sword. Preserve the misty bamboo forest, wet stone and shallow water ground, floating leaves, soft cold moonlit atmosphere, and the enormous white serpent in the background as a mysterious spiritual presence. Keep the overall tone poetic, melancholic, dangerous, romantic, and highly cinematic.\n\nCreate a 10-second image-to-video sequence with refined, poetic wuxia fantasy film language. Do not lock the aspect ratio; naturally inherit the image’s visual composition and vertical elegance. The video should feel like a classic Chinese fantasy martial-arts film scene with lyrical motion, emotional atmosphere, and strong cinematic rhythm. The emphasis is not only on sword action, but on mood, breath, tension, stillness within motion, and the beauty of movement in space.\n\nThe swordswoman is practicing swordsmanship, but not in a rigid or repetitive way. She moves as if the sword, the wind, and her sleeves are one. The scene begins with a brief moment of poised stillness: her body facing forward, sword low, sleeves drifting, wet mist moving through the bamboo. Then she steps forward lightly across the shallow water, turning her waist and shoulders, drawing a long circular sword arc that pulls scattered bamboo leaves into the air. Her robe, hair, ribbons, and sleeves trail behind her with elegant delay and fluidity.\n\nAs the rhythm rises, she shifts into larger dynamic motion. She advances, pivots, and sweeps the blade through the drifting leaves, then suddenly lifts into the air with a light wuxia-style leap, as if carried by inner force rather than physical effort alone. In the air, she rotates gracefully and performs a sharp, decisive slash through falling leaves and thin bamboo shadows. The cut should feel clean, spiritual, and beautiful, with leaves splitting and spinning away in a burst of wind and sword intent. Her body remains graceful and controlled, never stiff, never chaotic.\n\nAfter the airborne strike, she descends lightly and lands on the wet ground with a subtle splash, ripples spreading beneath her feet. She does not freeze after landing. Instead, she flows directly into another connected move: a half turn, a reverse cut, a sleeve-drifting withdrawal, then a final extended finishing posture with the blade angled outward and her gaze lowered but alert. The entire performance should feel like a complete poetic sword-training passage: part martial discipline, part dance, part inner cultivation, part cinematic revelation.\n\nHer facial expression should remain calm, distant, and focused, with faint sadness and cold determination, as if her heart carries an untold story. The performance should express solitude, mastery, restraint, and danger. Her motion must have real martial structure and believable body mechanics, but also the floating elegance of fantasy wuxia cinema. Avoid robotic repetition. Every movement should breathe.\n\nThe white serpent in the background should remain an atmospheric, intelligent, mythic presence. It may subtly shift, coil, or observe through the mist, adding tension and spiritual scale, but it must not overpower the swordswoman or turn the scene into a monster attack. It should feel like a silent witness, guardian, or ominous fate.\n\nVisual style: ultra-detailed cinematic wuxia fantasy, poetic Chinese fantasy film atmosphere, drifting mist, bamboo shadows, cool silver-blue tones, soft highlights, subtle backlight through fog, elegant cloth simulation, realistic water ripples, floating leaves, restrained sword glow, cinematic motion blur, and a hauntingly beautiful sense of movement. The camera language should feel lyrical and immersive, with gentle cinematic drift and emphasis on body lines, sword arcs, fabric motion, and spatial depth.\n\nAudio design: delicate yet powerful Chinese fantasy soundscape. Include bamboo leaves rustling in the wind, soft misty ambience, light water splashes, flowing fabric movement, refined sword-whoosh sounds, and clean blade-cutting accents. Add poetic cinematic music with xiao or bamboo flute, guqin or guzheng textures, low restrained percussion, suspended strings, and slow-building orchestral emotion. The music should begin airy and mysterious, then gradually build as the movement becomes larger, reaching a beautiful, sharp emotional peak during the aerial slash, and settling into a haunting calm at the end.\n\nVoice and spoken performance: include a few short Chinese lines spoken naturally during motion, not while standing still. The voice should be soft, calm, cold, and inward, like someone speaking to the sword, to herself, or to fate. Suggested lines:\n“剑随心起……”\n“竹有影，风有声。”\n“落叶可断，杂念难平。”\n“这一剑，还未到极处。”\nThe lines should be integrated into the breathing and movement, with natural pauses, light exertion, and emotional restraint, never sounding theatrical or noisy.\n\nMaintain strong temporal consistency throughout the full sequence. Keep the woman’s identity, costume, sword design, body proportions, environment, serpent presence, and cinematic tone stable. Avoid face drift, anatomy distortion, stiff动作, repetitive loops, chaotic camera movement, exaggerated magical explosions, costume mutation, or weak sword motion. Prioritize poetic large-scale sword practice, airy leaping motion, leaf-cutting action, smooth landing, emotional stillness, and elegant wuxia cinematic beauty.", 1344, 768, 73], "inputs": [{"name": "clip", "link": 636, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 637, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 638, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 639, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 640, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 641, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 642, "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "id": 413, "type": "MiniMaxH3ImageToVideo", "properties": {"widget_ue_connectable": {}, "Nod