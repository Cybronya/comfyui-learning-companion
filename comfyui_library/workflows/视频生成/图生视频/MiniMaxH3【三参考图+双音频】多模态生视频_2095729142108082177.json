ed_name": "文本"}], "flags": {}, "id": 15, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 11}, {"mode": 0, "outputs": [{"name": "INT", "links": [20], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [398.05755615234375, 63.95621871948242], "pos": [353.67694091796875, -19.34520721435547], "widgets_values": [10], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 16, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 12}], "extra": {"links_added_by_ue": [], "KKvideo_latentpreview": false, "0246.VERSION": [0, 0, 4], "VHS_latentpreview": false, "ds": {"offset": [-139.81462165309577, 111.7629173278413], "scale": 0.3073560549142819}, "VHS_KeepIntermediate": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "VHS_MetadataImage": true, "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "workflow_note": "Ref2VA（图片 + 音频参考）：参考素材严格有序，改动链路顺序会改变多模态提示与条件行顺序。运行前把 Load* 换成已上传到 ComfyUI input/ 的真实素材。", "frontendVersion": "1.23.0"}, "groups": [], "links": [[1, 4, 0, 5, 0, "IMAGE"], [2, 6, 0, 7, 0, "AUDIO"], [4, 10, 0, 11, 2, "MINIMAX_H3_AV_LATENT"], [5, 11, 0, 12, 1, "MINIMAX_H3_AV_LATENT"], [6, 12, 0, 13, 0, "IMAGE"], [7, 12, 1, 13, 1, "AUDIO"], [8, 13, 0, 14, 0, "VIDEO"], [11, 1, 0, 9, 0, "MINIMAX_H3_TEXT_ENCODER"], [12, 3, 0, 9, 1, "MINIMAX_H3_VAE_BUNDLE"], [13, 8, 0, 9, 2, "MINIMAX_H3_TARGET"], [14, 8, 0, 10, 0, "MINIMAX_H3_TARGET"], [15, 2, 0, 11, 0, "MINIMAX_H3_DIRECT_MODEL"], [16, 9, 0, 11, 1, "MINIMAX_H3_CONDITIONING"], [17, 3, 0, 12, 0, "MINIMAX_H3_VAE_BUNDLE"], [18, 15, 0, 9, 4, "STRING"], [19, 22, 0, 8, 2, "FLOAT"], [20, 16, 0, 22, 0, "INT"], [21, 19, 0, 8, 3, "INT"], [22, 18, 0, 8, 4, "INT"], [23, 26, 0, 8, 0, "MINIMAX_H3_REFERENCES"], [24, 26, 0, 9, 3, "MINIMAX_H3_REFERENCES"], [25, 24, 0, 25, 0, "IMAGE"], [26, 5, 0, 25, 1, "MINIMAX_H3_REFERENCES"], [28, 23, 0, 26, 0, "AUDI