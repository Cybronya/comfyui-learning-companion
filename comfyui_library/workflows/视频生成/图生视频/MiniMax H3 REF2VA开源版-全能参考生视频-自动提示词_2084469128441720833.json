 "localized_name": "MASK"}], "size": [290, 330], "pos": [-1844.7589111328125, 5367.54345703125], "widgets_values": ["c0177c8c431bb221fa95f380286ca8ad74b345c83e4b43f2633c98533105b38a.jpeg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 139, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.30.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [306], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [290, 330], "pos": [-1845.460693359375, 5753.13525390625], "widgets_values": ["709d89296880cdfb89e9175f837896d56d542883136f557ed555adefc1fcaada.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 163, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.30.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 12}, {"mode": 0, "outputs": [{"name": "STRING", "links": [305], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [417.6219482421875, 781.4303588867188], "pos": [-2282.2890625, 5305.50341796875], "widgets_values": ["【参考素材说明】\n@图片1：人物参考——\"女子A\"（锁定面部特征、黑色中长直发披发、黄底红花吊带长裙、裸色凉鞋）\n@图片2：人物参考——\"女子B\"（锁定面部特征、圆框金属眼镜、黑色齐刘海+低马尾、姜黄色连帽外套、湖蓝背心、深灰百褶裙、黑色及膝袜、黑色皮鞋、金色项链）\n@图片3：场景参考——锁定湖畔凉亭环境（六角飞檐凉亭、青石板路、湖边绿树垂柳、晴朗白日、树荫斑驳光）\n\n补充约束：@图片1、@图片2 仅提取人物外观，不带入灰色背景；两位人物置于 @图片3 的石板路上，光照统一为白日树荫斑驳光；凉亭柱上楹联仅作不可读虚化呈现。\n\n【核心创意】\n5秒，16:9 横版，清新写实生活风格，手持跟拍质感。穿碎花吊带裙的女子A（@图片1）与穿连帽外套百褶裙的女子B（@图片2）在湖畔凉亭前的石板路上并肩慢跑，近距离捕捉她们相视而笑的瞬间。明亮自然光，树荫光斑掠过面部，手持跟随运镜，一次硬切。\n\n【画面过程描述】\n\nShot 1（0-3s）— 正面跟拍并肩跑\n- 景别：中近景（腰部以上，双人并排）\n- 场景：@图片3 凉亭前石板路，六角凉亭与湖面在背景虚化，树荫光斑洒落\n- 主体：女子A（@图片1）与女子B（@图片2）并肩朝镜头方向慢跑，手臂自然摆动\n- 运镜：正面手持倒退跟拍（dolly out），与人物同速，轻微上下颠簸模拟奔跑节奏\n- 动作：A 的披发随步伐弹跳、裙摆飘动；B 的马尾左右摆动；两人跑动中侧头相视而笑\n- 台词：无\n- 音效：石板路面有节奏的脚步声、两人轻快笑声、树叶沙沙声、远处湖水轻响\n- 转场：硬切\n\nShot 2（3-5s）— 侧面贴近跟随\n- 景别：近景（肩部以上，侧面45°，双人同框）\n- 场景：同石板路，背景绿树与湖面光斑快速流动虚化\n- 主体：女子A（@图片1）与女子B（@图片2）侧脸近距同框，边跑边笑\n- 运镜：侧向平行跟随（truck right），与人物同速，手持轻微颠簸\n- 动作：奔跑起伏带动发丝与衣料持续晃动；斑驳树影从两人面部快速掠过；B 转头朝A笑，A 仰头回应\n- 台词：无\n- 音效：笑声、耳边风声、脚步声\n- 转场：结束，画面停留于两人笑容\n\n【整体要求补充】\n▍人物一致性（贯穿全片）\n- 女子A 始终为 @图片1 造型：黄底红花吊带长裙、披发\n- 女子B 始终为 @图片2 造型：圆框眼镜、齐刘海低马尾、姜黄连帽外套+湖蓝背心+深灰百褶裙+黑色及膝袜\n▍光线（贯穿全片）\n- 晴朗白日自然光，树荫形成移动光斑，面部有明暗掠过变化；色彩清新自然，不过度调色\n▍奔跑节奏（贯穿全片）\n- 轻松慢跑而非全力冲刺，步频一致，身体起伏自然，呼吸感真实\n\n【不想要】\n- 不出现两位主角以外的人物\n- 不出现可读文字、字幕、水印、Logo（凉亭楹联仅作不可读虚化）\n- 不出现肢体扭曲、顺拐跑姿、脚步悬浮\n- 不出现慢动作\n- 不出现快切、环绕运镜、大幅晃镜\n- 不要镜头光晕（lens flare）\n- 非叙事性音乐：N/A"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 150, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 13}, {"outputs": [{"name": "FLOAT", "links": [261], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "color": "#322", "widgets_values": [5], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "type": "PrimitiveFloat", "title": "视频时长", "mode": 0, "bgcolor": "#533", "size": [399.58544921875, 78.56757354736328], "pos": [-2277.318115234375, 5170.01513671875], "id": 132, "properties": {"cnr_id": "comfy-core", "ver": "0.30.1", "ue_properties": {"widget_u