主，搭配清脆的风铃与流水音效点缀；音乐随女子入水动作慢慢铺展，游动时节奏轻快舒展，结尾拉远镜头时逐渐轻柔淡去，整体氛围松弛明亮，充满夏日清爽感。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#0f6625", "size": [560.8394165039062, 448.54248046875], "pos": [-2661.0849609375, 5022.646484375], "id": 134, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 11}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "KKvideo_latentpreview": false, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.47.11", "VHS_latentpreview": false, "ds": {"offset": [5153.99858601888, -3923.2140209056715], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Models", "bounding": [-3276.942138671875, 5482.8818359375, 516.786376953125, 535.2840576171875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Sampling", "bounding": [-1976.7196044921875, 4898.88818359375, 690, 670]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "Conditioning", "bounding": [-2673.470703125, 5489.517578125, 423.71868896484375, 631.0820922851562]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "Decoding and create video", "bounding": [-2052.98974609375, 5686.55908203125, 333.8448791503906, 664.9287109375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "视频时长 分辨率 提示词", "bounding": [-3294.705322265625, 4877.83349609375, 1229.3543701171875, 587.5737915039062]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 8, "title": "图生视频", "bounding": [-4386.5654296875, 4870.99755859375, 1089.167724609375, 841.8046875]}], "links": [[228, 120, 0, 121, 1, "VAE"], [229, 119, 0, 122, 1, "VA