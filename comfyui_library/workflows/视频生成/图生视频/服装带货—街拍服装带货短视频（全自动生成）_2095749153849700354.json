城市夜景，街道两旁高楼林立，霓虹灯牌璀璨夺目。左侧一栋建筑上悬挂着醒目的红色竖排招牌“泰康食品”，字体传统而醒目。右侧则是一个巨大的圆形广告牌，上面印有一位女性模特的广告，文字写着“撒野追光 做自己的光芒”，下方还有“SEM/R”的品牌标识。广告牌下方是一家名为“老庙黄金”的店铺，招牌金光闪闪，十分显眼。街道上车水马龙，一辆银色出租车正缓缓驶过，车身上清晰可见“TAXI”字样。远处还能看到一座高耸的塔楼轮廓，在夜色中若隐若现。整张照片色彩丰富，光影交错，充满都市的喧嚣与活力，同时人物的微笑与轻松姿态为画面注入了温暖与亲和力，营造出一种既现代又充满生活气息的氛围。"], "inputs": [{"shape": 7, "name": "anything", "link": 74, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#353", "size": [480.24310302734375, 543.5933227539062], "pos": [-825.6238403320312, 2144.75634765625], "id": 103, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 20}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [85], "label": "images", "type": "IMAGE", "localized_name": "images"}], "size": [445.7395324707031, 556.7993774414062], "pos": [189.8804931640625, 2143.920166015625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 54, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 80, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 23}, {"outputs": [{"name": "image", "links": [57], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["用 @image2 人物替换（包括人物的全套服饰） @image1中的人物，仅保持人物姿势，其它物体和背景环境保持不变", "2k", "medium", "empty", false, 279152888, "randomize"], "inputs": [{"name": "image1", "link": 85, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 56, "label