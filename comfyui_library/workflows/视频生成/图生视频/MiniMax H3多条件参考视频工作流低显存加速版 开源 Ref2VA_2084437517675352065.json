ocalized_name": "vae"}, {"name": "audio_vae", "link": 337, "label": "audio_vae", "type": "VAE", "localized_name": "audio_vae"}, {"shape": 7, "name": "ref_images.ref_image_0", "link": 349, "label": "ref_images.ref_image_0", "type": "IMAGE", "localized_name": "ref_image_0"}, {"shape": 7, "name": "ref_images.ref_image_1", "link": 350, "label": "ref_images.ref_image_1", "type": "IMAGE", "localized_name": "ref_image_1"}, {"shape": 7, "name": "ref_images.ref_image_2", "link": 351, "label": "ref_images.ref_image_2", "type": "IMAGE", "localized_name": "ref_image_2"}, {"shape": 7, "name": "ref_images.ref_image_3", "link": 352, "label": "ref_images.ref_image_3", "type": "IMAGE", "localized_name": "ref_image_3"}, {"shape": 7, "name": "ref_images.ref_image_4", "label": "ref_images.ref_image_4", "type": "IMAGE", "localized_name": "ref_image_4"}, {"shape": 7, "name": "ref_videos.ref_video_0", "label": "ref_videos.ref_video_0", "type": "IMAGE", "localized_name": "ref_video_0"}, {"shape": 7, "name": "ref_video_audios.ref_video_audio_0", "label": "ref_video_audios.ref_video_audio_0", "type": "AUDIO", "localized_name": "ref_video_audio_0"}, {"shape": 7, "name": "ref_audios.ref_audio_0", "label": "ref_audios.ref_audio_0", "type": "AUDIO", "localized_name": "ref_audio_0"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 343, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 341, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 342, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 340, "label": "length", "type": "INT", "localized_name": "length"}, {"widget": {"name": "ref_image_size"}, "name": "ref_image_size", "label": "ref_image_size", "type": "COMBO", "localized_name": "ref_image_size"}], "flags": {}, "id": 189, "type": "MiniMaxH3ReferenceToVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MiniMaxH3ReferenceToVideo"}, "order": 21}, {"outputs": [{"name": "prompt", "links": [343], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#0C3E0C", "widgets_values": ["超现实主义电影风格，图片1是场景参考以及角色参考，大海中三只西方恶龙以及船队，图片2是角色参考，提供了角色罗伊的形象（中世纪海盗），图片3是场景参考地点龙王岛，图片4是角色参考，提供了角色祖龙的形象（东方龙王）\n故事梗概：罗伊带领船队以及恶龙，在海域中寻找龙王岛的宝藏，然后与祖龙发生冲突，战斗\n环境音：海风撕帆的\"猎猎\"声、船体木肋呻吟、浪拍船舷；祖龙现身时次低频压迫音（infrasound）令画面\"发闷\"；龙吼带金属质感混响；火炮闷雷齐鸣、炮弹击中龙鳞的\"铛铛\"火花声；桅杆断裂的爆裂声。激昂的背景音乐\n对白：罗伊说的是激昂的英式语调中文，祖龙是东方智慧老者的声音\n镜号1 [0秒-2秒]\n背面过肩视角的中景镜头，固定机位带甲板级手持微晃。罗伊三角帽与金珠须辫的背影剪影占画面左下，黄铜望远镜举至眼前；他身前雾幕撕开，龙王岛刀锋巨岩如黑碑刺出铅云，中景红帆灰海层层铺展；他缓缓放下望远镜，压低嗓音沙哑道：\"就是它了……龙王岛。\" 低音弦乐暗涌进入。\n镜号2 [2秒-4秒]\n鸟瞰视角的广角镜头，升降复合运镜快速前推俯冲。七艘红帆战舰楔形犁浪，帆面黑龙纹逆光透血；三头恶龙掠桅而过——赤翼贴海滑翔、翠翼左翼爬升、金翼右翼俯冲，翼影流过云底；岛岩压占画面上半、铅云合围；罗伊画外拔刀怒吼：\"满帆——冲！\" 战鼓骤密。\n镜号3 [4秒-6.5秒]\n贴海视角的仰视全景镜头，升+推复合运镜缓慢上抬。海面隆起\"水山\"，浪壁崩塌、雾墙环形炸开；祖龙玄铁蛇躯盘旋升空——爪撕水、鳞绕云、鹿角龙首高过岛岩，白目俯瞰舰队；它张口一吼，声波压平海面、红帆齐颤，苍古之声碾过：\"西方孽龙，也敢来犯？\" 次低频令画面边缘畸变，铜管合唱轰然进入。\n镜号4 [6.5秒–9.5秒]\n中立观察视角的广角镜头，跟随+环绕复合运镜。纯空中对决：赤翼龙俯冲喷白炽火柱，祖龙侧身避过、火燎云层；尾鞭横扫将翠翼龙拍坠入海，砸起数十米浪柱、水珠慢镜悬空；金翼龙自云底俯冲抓向白目，祖龙鹰爪上撩硬撼，鳞爪交击迸溅金属火花，两躯缠斗旋入云中；火光把海面撕成橙蓝两色，全编制配乐爆至顶点。\n镜号5 [9.5秒–12.0s秒]\n过肩视角的中景转全景镜头，快速拉远+升高，最后0.5秒完全静止定格。前景左下罗伊背影剪影癫狂大笑、举剑指天（无对白）；远景祖龙垂首，龙口白光球爆开，蓝白龙息横扫海面——红帆舰队被吞没，火光与木屑爆散、桅杆折断；闪电劈裂铅云，将大笑的人、喷息的龙、燃烧的海显影成铜版剪影；画面在\"剑尖—龙首—火海\"对角线构图上完全定格，所有声音抽真空，一声炸雷收场。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "title": "总提示词", "mode": 0, "bgcolor": "#255725", "size": [410.54364013671875, 360.9618835449219], "pos": [6.712059497833252, 3106.754638671875], "id": 176, "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 17}], "extra": {"VHS_KeepIntermediate": true, "links