rd the end."], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 149, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 12}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [464.1784362792969, 760.776611328125], "pos": [1932.1268310546875, 4843.85302734375], "widgets_values": ["video/MiniMax_H3", "auto", "auto"], "inputs": [{"name": "video", "link": 243, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "codec"}], "flags": {}, "id": 92, "type": "SaveVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 25}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [271, 272], "label": "MODEL", "type": "MODEL", "localized_name": "模型"}], "size": [494.5739440917969, 86.83304595947266], "pos": [494.3910217285156, 4694.138671875], "widgets_values": ["minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", 1], "inputs": [{"name": "model", "link": 277, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "loca