r": "#535", "size": [270, 170], "pos": [-1766.540283203125, 5701.16259765625], "id": 115, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"aspect_ratio": true, "megapixels": true, "multiple": true}, "Node name for S&R": "ResolutionSelector"}, "order": 12}, {"outputs": [{"name": "text", "links": [260], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["@图片 1 作为人物形象、服饰、妆容发型参考，10 秒短视频，9：16 画幅，2K 分辨率，MiniMax H3，原生立体声\n影片核心概念：古风白衣仙子在古壁画大殿中缓缓起舞，衣袂流光随风飞扬，柔美古典独舞，氛围感仙气缥缈\n固定主体 / 场景道具：参考图中黑发古装女子，银白流光薄纱广袖汉服，精致银质发簪白花头饰，大殿内壁布满古老山水彩绘壁画，古朴石质地面，柔和侧方暖金色天光\n0‑10 秒完整无断点时间线：\n0‑1.8 秒，中全景，女子缓步向前踏出一步，双臂缓缓抬起，广袖向外舒展，衣料随动作泛起银色光泽，发丝轻微飘动\n1.8‑4.2 秒，中景，侧身回旋起舞，广袖大弧度挥展，裙摆大面积飞扬，布料流光反光清晰，身体姿态柔美舒展\n4.2‑6.6 秒，近景推拉，手臂婉转绕腕，腰身轻转，发丝与飘带随风拂动，捕捉衣袖流动的细节\n6.6‑8.4 秒，回到中全景，完成一次优雅旋身，宽大裙摆层层散开扬起，光影在纱衣上流动\n8.4‑10 秒，定格收舞姿态，双臂轻轻落下，衣摆缓缓垂落，眼神沉静望向镜头，预留 0.6 秒完整收尾画面\n镜头剪辑规则：多镜头匹配硬切，全景‑中景‑近景交替切换，不做一镜到底，镜头跟随人物舞蹈运动，稳定运镜，无剧烈抖动\n视觉材质风格：电影级写实古风，PBR 布料材质，薄纱通透，面料带有细腻珠光银色反光，柔和伦勃朗侧光，景深虚化背景壁画，色调温润淡雅，电影质感，高细节人物面部，表情自然，口型无需匹配台词\n音效设计：古典轻柔古筝背景音乐，布料衣袖摩擦沙沙声，轻微裙摆扫过石地的环境音\n收尾完整结局：女子舞蹈结束，伫立原地，衣摆缓缓归于平静，仙气氛围感定格结束"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [451.4298400878906, 221.32456970214844], "pos": [-1965.2705078125, 4745.0419921875], "id": 143, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 13}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.47.11", "VHS_latentpreview": false, "ds": {"offset": [2845.1111433241113, -4282.370943705243], "scale": 0.45}}, "groups": [{"color": "#88A"