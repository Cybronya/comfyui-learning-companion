et": {"name": "weight_dtype"}, "name": "weight_dtype", "type": "COMBO", "localized_name": "剪枝类型"}], "flags": {}, "id": 1, "type": "UNETLoader", "properties": {"models": [{"name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "directory": "diffusion_models"}], "widget_ue_connectable": {"weight_dtype": true, "unet_name": true}, "Node name for S&R": "UNETLoader"}, "order": 4}, {"mode": 0, "outputs": [{"shape": 6, "name": "images", "links": [5], "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 6, "name": "audio", "links": [6], "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "fps", "links": [7, 10], "label": "fps", "type": "FLOAT", "localized_name": "fps"}, {"name": "frame_count", "links": [11], "label": "frame_count", "type": "INT", "localized_name": "frame_count"}, {"shape": 6, "name": "source_images", "label": "source_images", "type": "IMAGE", "localized_name": "source_images"}, {"name": "report", "links": [8], "label": "report", "type": "STRING", "localized_name": "report"}], "size": [1050, 1394], "pos": [-283.67962646484375, 135.19302368164062], "widgets_values": ["r2v — 参考主体生视频(Reference to Video)", "<Picture 1> walks into a neon-lit alley at night. Keep identity and outfit of <Picture 1>. Cinematic lighting, light rain, shallow depth of field. Audio: distant city traffic and soft rain. No text or logos.", "采样设置", 1, 944669889894623, "randomize", 24, 864, 480, 864, 124, "{\"version\":5,\"editMode\":\"segment\",\"timelineMode\":\"prompt_batch\",\"totalFrames\":362,\"frameRate\":24,\"width\":864,\"height\":480,\"refMaxSize\":864,\"output\":{\"mode\":\"fixed\",\"aspectRatio\":\"16:9 (宽屏)\",\"megapixels\":0.4,\"multiple\":32,\"longEdge\":864,\"width\":864,\"height\":480,\"maxExportFrames\":0,\"exportMode\":\"all\",\"audioMode\":\"generate\",\"continuityEnabled\":false,\"continuityOverlapFrames\":9},\"videoClips\":[],\"video\":{\"fileName\":\"\",\"videoFile\":\"\",\"subfolder\":\"\",\"type\":\"input\",\"frames\":[],\"frameMap\":[],\"sourceFrameCount\":124,\"deletedSourceRanges\":[]},\"global\":{\"taskType\":\"r2v — 参考主体生视频(Reference to Video)\",\"prompt\":\"<Picture 1> walks into a neon-lit alley at night. Keep identity and outfit of <Picture 1>. Cinematic lighting, light rain, shallow depth of field. Audio: distant city traffic and soft rain. No text or logos.\",\"refs\":[],\"referenceVideo\":{},\"continuousReference\":false,\"genImage\":{\"imageFile\":\"\"},\"refAudios\":[]},\"segments\":[{\"id\":\"s0\",\"start\":0,\"length\":362,\"frameCount\":362,\"durationSec\":15,\"prompt\":\"主题：拍摄空档自拍 vlog 正午时分摄影棚，拍摄工作短暂停歇。女偶像趁工作人员暂时离开，拿起手机自拍录制幕后日常短片。整体氛围元气鲜活，笑容真挚灵动，表情俏皮多变，全程直视镜头时不时轻笑。全片手持拍摄，节奏轻快灵动，在自拍视角与微单取景视角间切换，捕捉休息时各类细碎日常。八段短镜头连贯衔接，全程场景、时间统一，氛围感轻快活泼。 整套镜头跟随 vlog 叙事节奏推进：打招呼→介绍拍摄场地→转背景纸展示造型→喝水休整→复刻拍摄姿势→把玩柔光灯光→笑着翻车废片→造型师呼唤回归拍摄。结尾她雀跃奔赴拍摄区，画面温柔收尾。 人物介绍 CHASE，二十岁左右韩系女偶像。拥有清秀精致的东方五官，鹅蛋脸，小巧下巴，白皙细腻肌肤，淡雅裸妆，柔和自然的粉色唇色，眼神平静温柔；黑色中长微卷蓬松发型，空气感刘海覆盖额头，发丝自然垂落肩部两侧，具有真实发丝纹理和柔软光泽；身穿高级米白色宽松落肩西装套装，西装外套采用轻薄羊毛质感面料，宽松直筒版型，单排双粒扣设计，浅色木质纽扣，经典翻领结构，肩线自然下落，袖口简洁，左右对称翻盖口袋，衣身长度覆盖臀部；内搭米白色针织圆领上衣，细密竖纹针织纹理，柔软贴身但不过度修身；下身搭配同色系高腰A字西装短裙，简洁廓形，与西装外套形成统一套装效果；腿部穿透明裸色丝袜，肌肤通透自然，脚穿浅米色复古乐福鞋，鞋面皮革质感清晰，金属装饰细节低调；整体呈现韩系极简高级通勤风、日系杂志模特风格；整支 vlog 由她手持手机自拍出镜，是短片核心主角。 分镜脚本 整体环境：正午室内摄影棚，全程手持镜 拍摄空档的摄影棚空间：画面左侧立着巨大卷装纯色背景纸，一旁摆放环形补光灯与柔光箱支架；身后推车放置显示屏，留存上一轮拍摄成品；右侧小桌摆放手机与饮用水。造型妆容完整的她趁空档独自用手机拍 vlog，镜头灵动轻快。 镜头 1（近距离自拍） 手臂举着手机正对自己，凑近镜头灿烂一笑，比出爱心手势，发丝随动作晃入画面，灯光映在眼底。 女主：“各位老公，趁空档来拍个小片段！” 镜头 2（快速横摇手持镜头） 手机镜头快速扫过背景纸、柔光灯具、显示屏推车，随即切回自身特写。 女主（画外俏皮语气）：“这就是我们今天的拍摄棚啦！” 镜头 3（背景前转圈） 她站在纯色背景纸上张开手臂轻快转圈，看着镜头忍不住发笑。 女主：“来试试各种好看角度！” 镜头 4（浅景深微距特写） 特写手指捋开耳边碎发，耳饰在柔光下泛着光泽，无台词，仅有衣物布料轻响。 镜头 5（跟拍中景） 复刻刚刚拍摄的写真姿势，微微抬下巴、手轻贴脸颊定格片刻，随即笑场。 女主：“刚刚拍照就是这个姿势哦！” 镜头 6（紧凑手持近景） 从桌边拿起水瓶快速喝一口，喝完舒心叹气。 女主：“补充水分时间到！” 镜头 7（近距离自拍特写） 视线瞟向一旁显示屏，看到废片忍不住捂嘴大笑。 女主：“天呐，这张拍得也太滑稽了 ——” 镜头 8（收尾自拍） 场外造型师呼唤她回去拍摄，她瞬间满眼雀跃，挥手眨眼比爱心，轻快跳出画面，镜头短暂停留在背景纸上。 女主（轻快起身）：“我要回去拍摄啦，拜拜～”\",\"negativePrompt\":\"\",\"taskType\":\"\",\"refs\":[{\"index\":0,\"imageFile\":\"2ff8b4e9de4f2dbbe885502034148b8b8b15ca7af5bbf8a533c2e499d80317