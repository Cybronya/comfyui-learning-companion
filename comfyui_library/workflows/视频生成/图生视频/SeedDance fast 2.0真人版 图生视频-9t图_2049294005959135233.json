				}
			],
			"color":"#232",
			"widgets_values":[
				"@image1=县轻工比赛礼堂,@image2=林依依,@image3=林晚,@image4=母亲设计原稿。县轻工比赛礼堂，1988年中国北方县城国营轻工系统正式比赛礼堂，写实电影感，35mm胶片质感，低饱和，真实纹理，人物面部稳定，动作连贯自然，保留音效，保留对白，不要字幕，不要配乐。\n {\n      \"镜头序列\": 1,\n      \"时长\": \"4秒\",\n      \"场景\": \"县轻工比赛礼堂\",\n      \"人物\": \"主持人, 林依依\",\n      \"动作描述\": \"礼堂里正要宣布包装设计一等奖，林依依站在台边，等着接奖。\",\n      \"主画面描述\": \"全景建立县轻工比赛礼堂，红绒台布、奖牌、暖白灯光压出正式感，24mm，林依依站在主席台侧边，像已经把奖拿到手。\",\n      \"景别\": \"全景\",\n      \"视角\": \"平视\",\n      \"运镜\": \"缓慢前推\",\n      \"构图\": \"主席台居中，林依依压在画面中上部\",\n      \"镜头焦距\": \"24mm\",\n      \"氛围\": \"体面、得意、风雨将起\",\n      \"色调\": \"橙青色调（Orange & teal）\",\n      \"台词\": \"主持人：本届包装设计一等奖获奖者——\",\n      \"音效\": \"扩音器轻啸、台下低语、纸张翻动\",\n      \"引用资产\": {\n        \"场景\": \"县轻工比赛礼堂\",\n        \"角色\": [\"林依依_后期\"],\n        \"道具\": []\n      }\n    },\n    {\n      \"镜头序列\": 2,\n      \"时长\": \"3秒\",\n      \"场景\": \"县轻工比赛礼堂\",\n      \"人物\": \"林晚_前期\",\n      \"动作描述\": \"礼堂门突然被推开，林晚拎着旧布包站在门口，瞬间压住全场。\",\n      \"主画面描述\": \"中远景林晚逆光站在门口，旧工装、旧布包、眼神冷硬，50mm，门框像一道审判线把她和礼堂里的人隔开。\",\n      \"景别\": \"中远景\",\n      \"视角\": \"平视\",\n      \"运镜\": \"由静到轻推\",\n      \"构图\": \"门框竖向构图，林晚居中\",\n      \"镜头焦距\": \"50mm\",\n      \"氛围\": \"闯入、压场、来者不善\",\n      \"色调\": \"橙青色调（Orange & teal）\",\n      \"台词\": \"林晚：这奖，她也配拿？\",\n      \"音效\": \"大门猛开、全场骤静\",\n      \"引用资产\": {\n        \"场景\": \"县轻工比赛礼堂\",\n        \"角色\": [\"林晚_前期\"],\n        \"道具\": []\n      }\n    },\n    {\n      \"镜头序列\": 3,\n      \"时长\": \"3秒\",\n      \"场景\": \"县轻工比赛礼堂\",\n      \"人物\": \"林依依\",\n      \"动作描述\": \"林依依脸上的笑僵住，下意识攥紧手里的奖状。\",\n      \"主画面描述\": \"近景切林依依脸色发白，手指把奖状边角捏皱，85mm，精致体面在一瞬间裂开。\",\n      \"景别\": \"近景\",\n      \"视角\": \"平视\",\n      \"运镜\": \"定镜后微推\",\n      \"构图\": \"人物居中，奖状压在下方前景\",\n      \"镜头焦距\": \"85mm\",\n      \"氛围\": \"心虚、慌乱、被点穿\",\n      \"色调\": \"橙青色调（Orange & teal）\",\n      \"台词\": \"\",\n      \"音效\": \"纸边被捏皱的轻响\",\n      \"引用资产\": {\n        \"场景\": \"县轻工比赛礼堂\",\n        \"角色\": [\"林依依_后期\"],\n        \"道具\": []\n      }\n    },\n    {\n      \"镜头序列\": 4,\n      \"时长\": \"4秒\",\n      \"场景\": \"县轻工比赛礼堂\",\n      \"人物\": \"林晚_前期\",\n      \"动作描述\": \"林晚走上台，把林依依参赛稿和母亲原稿当众摊开。\",\n      \"主画面描述\": \"中景林晚把两张设计稿拍在桌上，50mm，稿纸在画面中央炸开视觉重心，动作狠得像当众掀桌。\",\n      \"景别\": \"中景\",\n      \"视角\": \"平视\",\n      \"运镜\": \"跟随上前后停住\",\n      \"构图\": \"人物和稿纸上下叠压构图\",\n      \"镜头焦距\": \"50mm\",\n      \"氛围\": \"揭穿、开刀、不给退路\",\n      \"色调\": \"橙青色调（Orange & teal）\",\n      \"台词\": \"林晚：左边，林依依参赛稿。右边，我妈十五年前的原稿。谁抄谁，还用我说吗？\",\n      \"音效\": \"稿纸拍桌声、台下抽气声\",\n      \"引用资产\": {\n        \"场景\": \"县轻工比赛礼堂\",\n        \"角色\": [\"林晚_前期\"],\n        \"道具\": [\"母亲设计原稿\"]\n      }\n    },\n\n整体要求：严格按镜头顺序连续生成，镜头衔接自然，人物服装与脸部保持一致。礼堂空间必须明确为室内颁奖现场，红绒台布、奖牌、暖白灯光、主席台关系清楚，不能拍成门外或走廊场景。画面中严禁出现任何字幕、台词字卡、屏幕贴字、说明文字、水印式文字或歌词文字。对白只能由人物真实说出口，不能以字幕形式替代。\n"
			],
