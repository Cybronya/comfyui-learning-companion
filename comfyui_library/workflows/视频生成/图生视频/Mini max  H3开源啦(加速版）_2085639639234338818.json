get": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "编码器"}], "flags": {}, "id": 92, "type": "SaveVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 23}, {"mode": 0, "outputs": [{"name": "positive", "links": [236], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [234], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "size": [497.7621154785156, 597.3430786132812], "pos": [-1717.61572265625, 4659.2294921875], "widgets_values": ["生成一条 15 秒 16:9 横版韩剧短剧片段。使用图 1 作为 0 秒首帧，使用图 2作为 15 秒尾帧。画面必须保持同一对男女、同一套服装、同一个冬日海边公交站、同一种灰粉色傍晚光线和低饱和韩剧电影感。\n\n人物设定：女生穿深棕色大衣、米色粗针围巾、灰色内搭、格纹裙，黑色长发被风吹动，手里拿着车票，身边有小号深色行李箱。男生穿深灰色宽松外套或西装大衣，黑色内搭，凌乱黑发，克制、温柔、有不舍感。\n\n0-4 秒：从图 1的构图开始。女生站在玻璃候车亭旁，望着远处海面，手里的车票被冷风吹动。男生从右侧慢慢走近，停在她身后几步。环境有海风和远处海浪声。\n\n4-8 秒：镜头轻微推进到双人中景。男生看着女生的背影，轻声用韩语问：“정말 혼자 가려고?” 屏幕底部出现双行字幕，韩文在上，中文在下：“정말 혼자 가려고?” / “你真的要一个人走吗？”\n\n8-12 秒：切女生中近景。女生没有马上回头，只低头看车票，手指轻轻捏紧票角，用韩语说：“늦었어. 이제 곧 버스 와.” 字幕：“늦었어. 이제 곧 버스 와.” / “太晚了，车快来了。”\n\n12-15 秒：切男生近景。男生压着情绪，轻声说：“난 널 붙잡으러 온 게 아니야.” 字幕：“난 널 붙잡으러 온 게 아니야.” / “我不是来拦你的。” 这一段最后让女生慢慢转身，画面逐渐接近图 2 的人物站位和动作。\n\n声音要求：韩语对白清楚自然，口型尽量同步。海风、远处海浪、纸票轻响、脚步声和衣料摩擦声要真实。背景音乐是非常轻的韩剧钢琴和柔和弦乐，不要盖住对白。\n\n字幕要求：只出现这三句双行字幕，韩文在上，中文在下，底部居中，白字轻微阴影。不要生成其他文字，不要水印，不要韩文路牌乱码。", 1344, 768, 73], "inputs": [{"name": "clip", "link": 239, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 240, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 242, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 244