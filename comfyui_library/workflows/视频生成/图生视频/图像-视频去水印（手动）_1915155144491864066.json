			],
			"id":33,
			"properties":{
				
			},
			"order":3
		},
		{
			"outputs":[
				
			],
			"color":"#432",
			"widgets_values":[
				"执行这一步骤时：需暂时关闭其它节点。\n上传视频后，直接运行，然后再预览图像中打开第一张图片，并保存。\n完成这一步骤后，再打开第二和第三步的节点。"
			],
			"inputs":[
				
			],
			"flags":{
				
			},
			"type":"Note",
			"mode":0,
			"bgcolor":"#653",
			"size":[
