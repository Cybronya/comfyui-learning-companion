": "frame_rate"}, "name": "frame_rate", "label": "frame_rate", "type": "FLOAT", "localized_name": "frame_rate"}, {"widget": {"name": "loop_count"}, "name": "loop_count", "label": "loop_count", "type": "INT", "localized_name": "loop_count"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "format"}, {"widget": {"name": "pingpong"}, "name": "pingpong", "label": "pingpong", "type": "BOOLEAN", "localized_name": "pingpong"}, {"widget": {"name": "save_output"}, "name": "save_output", "label": "save_output", "type": "BOOLEAN", "localized_name": "save_output"}, {"widget": {"name": "no_preview"}, "shape": 7, "name": "no_preview", "label": "no_preview", "type": "BOOLEAN", "localized_name": "no_preview"}, {"widget": {"name": "pix_fmt"}, "name": "pix_fmt", "label": "pix_fmt", "type": ["yuv420p", "yuv420p10le"]}, {"widget": {"name": "crf"}, "name": "crf", "label": "crf", "type": "INT"}, {"widget": {"name": "save_metadata"}, "name": "save_metadata", "label": "save_metadata", "type": "BOOLEAN"}, {"widget": {"name": "trim_to_audio"}, "name": "trim_to_audio", "label": "trim_to_audio", "type": "BOOLEAN"}], "flags": {}, "id": 2902, "type": "VHS_VideoCombine", "properties": {"widget_ue_connectable": {"save_output": true, "filename_prefix": true, "loop_count": true, "pix_fmt": true, "save_metadata": true, "crf": true, "trim_to_audio": true, "format": true, "frame_rate": true, "pingpong": true}, "Node name for S&R": "VHS_VideoCombine"}, "order": 27}, {"outputs": [], "color": "#432", "widgets_values": ["# 🎬 一條龍：VOSR2 圖像高清化 → 快速 H3-04 I2V（修正版）\n\n## 怎麼用（三步）\n1. 左邊 **LoadImage** 上傳你的圖（人物參考圖）\n2. 右邊 **PROMPT** 節點貼 H3 提示詞\n3. 按 Run。左邊先 VOSR 放大，右邊接著生成影片\n\n## 資料流\nLoadImage → VOSR2Upscale（4x 高清化）→ ImageScale（對齊生成分辨率）\n→ MiniMaxH3ImageToVideo.first_frame → 取樣 4 step → VHS 出片（含音軌）\n\n## 三個旋鈕（都只有一個地方要改）\n- **ResolutionSelector（megapixels）**：唯一的解析度控制點。\n  1.0 ≈ 768x1376（H3 原生短邊 768，建議值）；想省顯存可降 0.6 / 0.4。\n  ImageScale 跟 I2V 的 width/height 都跟著它走，改一個地方兩邊同步。\n- **影片長度（秒）**：填 5 / 10 / 15 / 20。後面的「秒→幀數」會自動對齊 17k+5 幀格\n  （5→124 幀＝5.17s、10→243 幀＝10.13s、15→362 幀＝15.08s、20→481 幀＝20.04s）。\n- **PROMPT**：六檔長度共用同一支提示詞。\n\n## 兩個開關（最上面那兩顆）\n- **① 圖像高清化**：關掉 = 原圖直接穿過 VOSR 鏈餵給 I2V，等於沒接放大，用來對比畫質\n- **② 快速 H3-04**：關掉 = 只跑放大、不出片\n\n## 幾個提醒\n- VOSR2Upscale 的 **upscale 倍數**：原圖 ≤1K 用 4 沒問題；原圖已 2K 建議改 2，\n  不然 4 倍出來 5K＋，tile 暴增會很慢\n- 放大結果存一份 **SaveImage**，可跟原圖在 **Image Comparer** 上下對比\n- 上傳圖寬高比最好跟 ResolutionSelector 一致（例如 9:16 豎屏），不然會被拉伸\n- 長度越長越吃顯存/時間：15 秒以上建議先確認顯存夠（必要時把 megapixels 降到 0.6）\n- 想接「視頻高清化（級聯 2K）」，把 VHS 出片接到那條鏈的輸入即可\n"], "inputs": [], "flags": {}, "type": "Note", "title": "使用說明", "mode": 0, "bgcolor": "#653", "size": [1020, 620], "pos": [40, 880], "id": 5002, "properties": {"widget_ue_connectable": {}}, "order": 11}, {"mode": 0, "outputs": [{"name": "STRING", "slot_index": 0, "links": [3014], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [451.84375, 471.5], "pos": [2157.08544921875, 199.46047973632812], "widgets_values": ["For the target video, at 0.00 seconds into the target video, <Picture 1> (from [Shot 1]) is fully referenced.\n\nintegrated_multimodal_description: 10-second video.\n[0-3s] Strictly preserve the exact facial features, long dark brown hair, black wide-brimmed straw hat, black sheer lace romper with V-neck and short sleeves, and body of the woman from the reference image. She stands outdoors near a cafe with wooden chairs and large glass windows, right hand raised in a salute pose near her forehead, left hand resting by her side, looking at the camera with a soft smile.\n[3-6s] She opens her mouth in a gentle smile, slightly lifts one leg as if bouncing lightly, still holding the salute pose while looking at the camera.\n[6-8s] She lowers her hand and points directly at the camera with a playful expression, body leaning slightly forward.\n[8-10s] She forms a heart shape with both hands in front of her chest, then switches to waving at the camera with a bright, cheerful smile.\n\noverall_soundscape: Soft outdoor ambient sounds, light fabric movement of the lace outfit, natural breathing. No talking, no narration, no voiceover.\n\nnon_diegetic_music: N/A"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 2001, "type": "PrimitiveStringMultiline", "title": "PROMPT (feeds every stage)", "properties": {"widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 12}, {"mode": 0, "outputs": [{"name": "SAMPLER", "slot_index": 0, "links": [2016], "label": "SAMPLER", "type": "SAMPLER", "localized_name": "SAMPLER"}], "size": [400, 98], "pos": [3088.988525390625, 494.6867370605469], "widgets_values": ["res_multistep"], "inputs": [{"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}], "flags": {}, "id": 2135, "type": "KSamplerSelect", "properties": {"widget_ue_connectable": {"sampler_name": true}, "Node name for S&R": "KSamplerSelect"}, "order": 13}], "extra": {"links_added_by_ue": [], "KKvideo_latentpreview": false, "0246.VERSION": [0, 0, 4], "VHS_latentpreview": false, "ds": {"offset": [-2556.9054963396648, -205.44996721189807], "scale": 0.6588450000000011}, "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "KKvideo_latentpreviewrate": 0, "pixaromaGroups": [], "zaka_fix": "run through 2026-09-14: fixed VAE routing / removed orphan nodes / wired length+resolution", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0"}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "① VOSR2 圖像高清化（4x 放大 → 歸一）", "bounding": [10, 110, 1345, 740]}, {"color": "#a1309b", "font_size": 24, "flags": {}, "id": 2, "title": "② 快速 H3-04 I2V（4step 加速 · 