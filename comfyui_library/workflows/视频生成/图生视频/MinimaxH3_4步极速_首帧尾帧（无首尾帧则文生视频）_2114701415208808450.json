"type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "title": "参考图 · 尾帧（不用就 Ctrl+B 禁用）", "mode": 0, "size": [268.8970703125, 314], "pos": [620, 960], "id": 44, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10, "widgets_values_named": {"image": "1ce32b056124c821f114dc031ba60873113b99ce00b133d8e432bfd4b090bb8d.png", "upload": "image"}}, {"outputs": [{"name": "IMAGE", "links": [67], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "widgets_values": ["lanczos", "center", 512, "disabled"], "inputs": [{"name": "image", "link": 64, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": "width"}, "name": "width", "link": 65, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 66, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "crop"}, "name": "crop", "label": "crop", "type": "COMBO", "localized_name": "crop"}], "flags": {}, "type": "ImageScale", "title": "自动适配尺寸 · 尾帧（等比缩放+中心裁切）", "mode": 0, "size": [312.530859375, 130], "pos": [880, 960], "id": 45, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "ImageScale"}, "order": 15, "widgets_values_named": {"width": "center", "upscale_method": "lanczos", "crop": "disabled", "height": 512}}, {"outputs": [], "color": "#222", "widgets_values": ["## 参考图怎么用（首帧 / 尾帧）\n\n**1. 换图**\n两个 `LoadImage` 节点里选你自己的图片（要先上传到 ComfyUI 的 input 目录）。\n\n**2. 尺寸不用管**\n中间的 `ImageScale` 会把任意比例的图**等比缩放 + 中心裁切**到当前输出尺寸，\n横图、方图、竖图都不会被拉变形。它的宽高直接取自 `ResolutionSelector`，\n你改分辨率，裁切目标会自动跟着变。\n\n**3. 只用首帧**\n保持「尾帧」那一组节点为禁用（选中后 `Ctrl+B`），就是单首帧图生视频。\n\n**4. 回到纯文生视频**\n把两组 `LoadImage` 都禁用（`Ctrl+B`）即可，其余链路完全不受影响。\n\n**5. 建议手动指定 task_type**\n6 号节点的 `task_type` 现在是 `auto — 自动判断`，\n接图后建议手动锁成对应的图生视频模式，避免自动判错。\n\n**6. 注意**\n当前加载的是 FL2VA 权重，只支持首帧/尾帧。\n`ref_images` / `ref_videos` / `ref_audios` 这几个口需要换 Ref2VA 权重才生效。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: 参考图用法（首帧 / 尾帧）", "mode": 0, "bgcolor": "#000", "size": [430, 400], "pos": [1228.012912536438, 946.7591193529255], "id": 46, "properties": {"widget_ue_connectable": {}}, "order": 11, "widgets_values_named": {"text": "## 参考图怎么用（首帧 / 尾帧）\n\n**1. 换图**\n两个 `LoadImage` 节点里选你自己的图片（要先上传到 ComfyUI 的 input 目录）。\n\n**2. 尺寸不用管**\n中间的 `ImageScale` 会把任意比例的图**等比缩放 + 中心裁切**到当前输出尺寸，\n横图、方图、竖图都不会被拉变形。它的宽高直接取自 `ResolutionSelector`，\n你改分辨率，裁切目标会自动跟着变。\n\n**3. 只用首帧**\n保持「尾帧」那一组节点为禁用（选中后 `Ctrl+B`），就是单首帧图生视频。\n\n**4. 回到纯文生视频**\n把两组 `LoadImage` 都禁用（`Ctrl+B`）即可，其余链路完全不受影响。\n\n**5. 建议手动指定 task_type**\n6 号节点的 `task_type` 现在是 `auto — 自动判断`，\n接图后建议手动锁成对应的图生视频模式，避免自动判错。\n\n**6. 注意**\n当前加载的是 FL2VA 权重，只支持首帧/尾帧。\n`ref_images` / `ref_videos` / `ref_audios` 这几个口需要换 Ref2VA 权重才生效。"}}], "extra": {"links_added_by_ue": [], "KKvideo_latentpreview": false, "0246.VERSION": [0, 0, 4], "favoritedWidgets": {"favorites": [{"widgetName": "aspect_ratio", "nodeLocatorId": "16"}]}, "VHS_latentpreview": false, "ds": {"offset": [1032.8756150127829, 53.26378112480802], "scale": 0.7972024500000109}, "VHS_KeepIntermediate": true, "xzgGroups": {}, "ue_links": [], "VHS_MetadataImage": true, "KKvideo_latentpreviewrate": 0, "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.57.1"}, "groups": [{"color": "#3f789e", "flags": {}, "id": 1, "title": "H3 loaders + Turbo LoRA (EMA)", "bounding": [-40, -60, 820, 650]}, {"color": "#3f9e64", "flags": {}, "id": 2, "title": "STABLE: video 4 / audio 4", "bounding": [840, -60, 1080, 360]}, {"color": "#9e6d3f", "flags": {}, "id": 3, "title": "Decode + synchronized MP4", "bounding": 