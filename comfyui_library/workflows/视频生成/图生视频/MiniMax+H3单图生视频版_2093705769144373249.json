suite", "ver": "0a75c7958fe320efcb052f1d9f8451fd20c730a8", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"save_output": true, "filename_prefix": true, "loop_count": true, "pix_fmt": true, "save_metadata": true, "crf": true, "trim_to_audio": true, "format": true, "frame_rate": true, "pingpong": true}, "Node name for S&R": "VHS_VideoCombine"}, "order": 22}, {"outputs": [{"name": "FLOAT", "links": [753], "label": "FLOAT", "type": "FLOAT", "localized_name": "浮点"}], "color": "#232", "widgets_values": [10], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "值"}], "flags": {}, "type": "PrimitiveFloat", "title": "视频时长（秒）", "mode": 0, "bgcolor": "#353", "size": [258.4422912597656, 66.4150161743164], "pos": [-9595.998046875, -3678.371337890625], "id": 499, "properties": {"cnr_id": "comfy-core", "ver": "0.30.1", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 11}, {"outputs": [{"name": "text", "links": [770], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["{\n  \"全局风格\": \"电影质感古风仙侠短视频，9:16，8K，写实质感，仙山云海仙境，云雾缭绕，山间亭台楼阁，桃花盛开，仙鹤掠过天际，画面稳定，24fps，总时长10秒\",\n  \"角色设定\": \"古风年轻东方女子，乌黑长发，粉色花朵发饰配流苏步摇，淡粉色绣花古风汉服，身姿妩媚妖娆，眉眼勾人，神态魅惑，花瓣散落发丝与衣袂，气质温婉又勾魂\",\n  \"音色\": \"洒脱魅惑御姐女声，语调轻佻张扬，末尾伴随女人娇媚气声\",\n  \"分镜序列\": [\n    {\n      \"时长\": \"0‑3秒\",\n      \"镜头\": \"镜头快速环绕人物一周，运镜流畅顺滑\",\n      \"画面\": \"云雾缭绕仙山楼阁，漫山桃花盛放，仙鹤高空飞过，女子立于观景木栏平台，衣袂随风轻扬，云海奇峰背景\",\n      \"人物动作\": \"身体微微扭动，身姿妖娆，肩膀轻晃，薄纱衣纱随风飘动，桃花花瓣缓缓飞舞\",\n      \"台词\": \"道友们，一起来快活啊！\"\n    },\n    {\n      \"时长\": \"3‑6秒\",\n      \"镜头\": \"环绕镜头缓缓减速，聚焦锁定人物面部\",\n      \"画面\": \"粉色桃花花瓣缓缓飘落，发丝沾有细碎花瓣，柔和天光勾勒人物面部轮廓，远处云海仙阁若隐若现\",\n      \"人物动作\": \"女子缓缓抬手，指尖慵懒撩动长发，抬手瞬间长发肆意飘起，发丝大幅度飞扬\",\n      \"台词\": \"\"\n    },\n    {\n      \"时长\": \"6‑10秒\",\n      \"镜头\": \"近景面部特写，固定机位\",\n      \"画面\": \"柔和仙光打在脸庞，漫天桃花花瓣飞舞，仙境氛围感强烈\",\n      \"人物动作\": \"头部缓缓后仰抬起，眉眼妩媚，缓缓闭眼，脖颈舒展，发出一声娇媚的轻喘\",\n      \"台词\": \"（娇媚轻喘）嗯～\"\n    }\n  ]\n}\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "文本", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#353", "size": [423.9206237792969, 748.6286010742188], "pos": [-10338.0693359375, -3869.846923828125], "id": 496, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 12}, {"outputs": [{"name": "IMAGE", "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#233", "widgets_values": ["236299f4cb57c4878854fc66934ba96f6b1de8fdc1bc06866bf8f4c331bada9a.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#355", "size": [455.38409423828125, 807.472900390625], "pos": [-11923.49609375, -3227.3662109375], "id": 505, "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoadImage", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [3502.476806640625, 166.33773803710938], "color": "#fff0", "pos": [-12018.30859375, -4176.75244140625], "inputs": [], "flags": {"allow_interaction": true}, "id": 487, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#7b410a", "borderRadius