  \"continuity\": \"Keep the same two fighters throughout. Keep the action continuous and readable as one short intense fight moment.\"\n  },\n  \"storyboard\": [\n    {\n      \"shot\": 1,\n      \"start_seconds\": 0.0,\n      \"end_seconds\": 1.5,\n      \"camera\": \"Open with a dramatic medium-wide shot, then rush inward with a fast handheld or tracking move as the fighters charge toward each other.\",\n      \"action\": \"The two fighters sprint in and collide into combat. One throws the first fast punch or kick, and the other blocks immediately. The opening must feel explosive and instantaneous, with strong body movement and no hesitation.\"\n    },\n    {\n      \"shot\": 2,\n      \"start_seconds\": 1.5,\n      \"end_seconds\": 3.3,\n      \"camera\": \"Cut tighter into the fight with aggressive lateral camera movement and quick reframing to follow the action.\",\n      \"action\": \"Show a rapid exchange of attacks: punch, block, elbow, dodge, spinning kick, or close-range counterattack. The choreography should be clearly more dynamic than simple pose changes. Bodies must shift position, rotate, and move through space. Add a strong impact beat where one fighter lands a powerful hit or forces the other backward.\"\n    },\n    {\n      \"shot\": 3,\n      \"start_seconds\": 3.3,\n      \"end_seconds\": 5.0,\n      \"camera\": \"Finish with a strong hero-action climax using a dramatic angle and slight slow-down feeling at the biggest impact moment, then hold briefly on the aftermath pose.\",\n      \"action\": \"End on the most visually impressive moment: a flying kick, a sweeping takedown, or a powerful final strike that sends the opponent stumbling back. The winner lands in a strong action pose while the other fighter recoils or regains balance. The ending should feel like a clean action highlight, not a complete fight resolution.\"\n    }\n  ],\n  \"audio\": {\n    \"overall_soundscape\": \"Punchy cinematic fight impacts, cloth movement, footwork, sharp whooshes, body hits, environmental debris sounds, and dramatic action trailer energy.\",\n    \"non_diegetic_music\": \"A fast high-intensity cinematic action score around 140 BPM with heavy percussion, trailer hits, and strong rhythmic accents matching the fight beats.\",\n    \"sync_basis\": {\n      \"type\": \"planned_beat\",\n      \"bpm\": 140,\n      \"phase_seconds\": 0.0\n    }\n  },\n  \"exclusions\": [\n    \"Do not make the scene slow or static.\",\n    \"Do not reduce the fight to just posing or staring.\",\n    \"Do not include blood, gore, or graphic injury.\",\n    \"Do not introduce extra fighters or unrelated comedy elements.\",\n    \"Do not let the camera stay locked without reacting to the action.\"\n  ]\n}"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [638.9404907226562, 972.035400390625], "pos": [-2342.7177734375, 358.3031921386719], "id": 39, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 10}, {"outputs": [{"name": "IMAGE", "links": [84], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#233", "widgets_values": ["cc361bc5390de3a89d4bbec81dd91d80de3b2a768ad0ad47557f095e0ab75d7a.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 4, "bgcolor": "#355", "size": [433.9790344238281, 571.63330078125], "pos": [-1670.7135009765625, 407.3990173339844], "id": 57, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unco