 "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "codec"}], "flags": {}, "id": 9, "type": "SaveVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 5}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [7], "label": "音频", "type": "AUDIO", "localized_name": "音频"}], "size": [270, 136], "pos": [1621.0819091796875, 1353.1959228515625], "widgets_values": ["9d207f4b53e097ecc3f39214fed665ff1af8e09ab566f83fe16473124309ab84.mp3", null, ""], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 11, "type": "LoadAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 2}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [2], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314.0000305175781], "pos": [1242.8524169921875, 569.9168090820312], "widgets_values": ["56e690a9f4c21300af94d4dfeb5c9ea3332f63dab7ee52a2ca85afc9e9800f9d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 6, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 3}, {"outputs": [{"name": "video", "links": [5], "label": "video", "type": "VIDEO", "localized_name": "video"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["15秒，16:9，一镜到底，单一连续长镜头，全程无剪切无转场，真实1990年代末至2000年初中国城市生活实拍旧影像，不是现代画面套复古滤镜，低饱和暖灰色调，画面轻微褪色，有限动态范围，柔和边缘，轻微曝光溢出，原生胶片颗粒，自然运动拖影，画面不过度锐利，粗糙真实材质，墙面木材金属纸张衣物带有长期使用的磨损、污渍、褶皱，生活化非布景空间，人物普通真实，不美化不摆拍。\n镜头连续跟随一张边角磨损泛黄的老式黑白旧照片，镜头运动带有自然惯性、轻微焦点迟疑，拒绝机械稳定。旧照片受真实空气气流影响，缓慢漂浮、轻微倾斜、失衡下坠、被气流托起，无机械旋转，无突然加速，没有轨道牵引。\n全片海报、书籍、票面、招牌全部无可辨识文字、数字、logo、水印。\n\n【0‑3s】起始旧照相馆暗房，镜头近距离对准浸泡在浅塑料显影盘边缘的一张刚洗出的老旧黑白照片（参考图片一），相纸边缘卷曲发潮，表面有水渍细小划痕，旁边散落相纸、镊子、红色暗房安全灯，老式放大机安静待机，暗房小窗微微开启，空气持续流入，照片先微微颤动，边角缓缓翘起，慢慢脱离显影盘，在桌面上方短暂漂浮，气流自然将照片带向暗房出口，镜头跟随移动。\n【3‑6s】飘出照相馆进入清晨老巷，照片穿过半开木门来到照相馆前厅，老式木质柜台，墙上挂满褪色相框，落地老式台灯昏黄发光，一名老师傅低头整理相纸没有注意漂浮的照片，穿堂风带动照片不规则缓慢漂移，穿过敞开玻璃店门进入外部清晨老街，街边早点铺升腾热气，老式二八大杠（参考图片三）自行车驶过，室内外切换带来自然曝光变化，街道横风推动照片小幅偏移继续向前漂浮。\n【6‑9s】掠过老街与路边修鞋摊，老旧斑驳居民楼，墙面水渍旧广告残痕，空中交错老旧电线，老式摩托车缓缓驶过，车辆驶过带来空气扰动，照片被气流轻微抬升，阳光穿过楼体缝隙扫过相纸表面，随即划入建筑阴影，街角路边老旧修鞋摊，皮具工具散落，修鞋老人低头忙碌，几张旧牛皮纸被风吹翻动，照片受同一气流向前飘移，顺着楼间上升气流缓慢抬升到二层高度，镜头平滑跟随，无剧烈俯仰加速。\n【9‑12s】飘入老公寓开放式阳台，阳台墙面涂层剥落潮湿印记，摆放旧脸盆竹编筐，晾晒多件洗旧衣物随穿堂风摆动，中间留有通行空间，照片沿通道向前漂浮，与衣物保持距离，住户正在晾晒被褥并未留意照片，楼道吹来的风推动照片前进，前方木窗完全敞开，照片顺着气流飘进屋内，进入房间后气流减弱，照片漂浮速度自然放缓。\n【12‑15s】落于老式房间书桌，普通陈旧居家房间，磨损木书桌，桌上摆放老式磁带录音机、堆叠旧相册、玻璃茶杯，墙上贴着老旧挂历。五十多岁普通中年女人坐在桌边，穿着洗褪色的确良衬衫，侧身低头，双手慢慢整理一沓老相片，不看镜头，神态沉静。漂浮的旧照片气流消散，缓缓减速，轻轻晃动，自然下坠，轻飘飘落在女人手边书桌。女人整理相片的手停顿，低头看向桌面飘落的旧照片，短暂静止，伸手轻轻拾起这张照片，镜头保持侧面固定距离，不推近不切换镜头，窗边薄窗帘随风微动，磁带录音机传出微弱沙沙底噪，画面安静收尾。\n\n避免现代数字摄影感，广告质感，3D CG塑料感，过度锐化，HDR，戏剧化电影布光，完美美化人物，AI畸形人脸，过度复古滤镜，VHS磁带故障噪点，扭曲肢体，画面闪烁。", "720P", "4:3", "14", "", "", true, 550685383, "randomize", false], "inputs": [{"shape": 7, "name": "image1", "link": 1, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 2, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 3, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAG