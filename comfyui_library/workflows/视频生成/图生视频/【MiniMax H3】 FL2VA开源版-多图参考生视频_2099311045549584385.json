e": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "format"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "codec"}, {"widget": {"name": "format.codec"}, "name": "format.codec", "label": "format.codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "format.codec"}, {"widget": {"name": "format.codec.encoding"}, "name": "format.codec.encoding", "label": "format.codec.encoding", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "encoding mode"}], "flags": {}, "id": 12, "type": "SaveVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 16}, {"mode": 0, "outputs": [{"name": "conditioning", "slot_index": 0, "links": [14], "label": "conditioning", "type": "MINIMAX_H3_CONDITIONING", "localized_name": "conditioning"}], "size": [448.2731628417969, 546.7102661132812], "pos": [1114.482177734375, 276.3094787597656], "widgets_values": ["现在根据以下提示词结构，帮我重新编写一段详细完整版视频提示词，围绕Image1 的内容进行生成。\n\n使用故事板参考 Image3 作为 15 秒视频的完整视觉和情感叙事来源。从左到右、从上到下依次遵循所有 12 个节拍。不要重新诠释动作、构图、镜头角度或神秘且充满冒险感的氛围递进。保留故事板的镜头顺序、探索寻路的逻辑、特写与宏大远景的构图多样性以及最终的启程定格。\n\n影片风格和色调严格复刻Image1 ，要背景音乐，保留正常的音效。\n\n将完整的 12 节拍序列压缩到 15 秒内。每个节拍必须清晰呈现为充满节奏感与公路片史诗感的动作快照。使用如风沙般自然且流畅的动作转场、极具质感的特写匹配剪辑（如粗糙的纸质地图纹理无缝衔接女孩迎风凝视的坚定眼神，再到视线越过肩膀望向远方城市的空间转换）。在最终节拍之前，保持探索未知的悬疑感与向着科幻之城进发的决心之间的紧凑情绪交替。\n\n保持与角色参考相同的主体身份：一位留着浓密卷发、穿着复古废土风的坚韧女性探险家Image2 。不要改变她的外貌特征。整个过程中持续展现极具故事性的探索动作流：在沙漠狂风中肆意飞舞的长发、指尖展开地图的细微动作、仰望天空中奇异飞碟的震撼神情、以及从原地迷茫查阅地图到坚定踏上未知旅途的公路片冒险感升级。\n\n环境：广袤荒凉的复古科幻沙漠、风化斑驳的巨型广告牌、远处矗立着高耸尖塔的复古未来主义城市、天空中隐约可见的异星轮廓，充满颗粒感与漫天飞舞的风沙（强烈的沙漠日光与侧逆光）。电影艺术风格镜头能量：极具质感的地图主观视角（POV）特写、顺滑的视线跟随推进、表现人在广袤荒野中渺小感的上帝视角（高空俯拍）、女孩迎风挺立的中景特写，以及突显粗野废土环境与复古机械金属感的高级对比。\n\n最终节拍（未知的启程）在苍茫的沙漠烈日余晖下，悬浮汽车扬起滚滚沙尘，沿着笔直的荒野公路向着地平线尽头的宏大科幻之城全速驶去，画面保持静谧且充满余韵的 1 秒，展现极致的史诗感、孤独与对未知探索的渴望。 [images: 3, 