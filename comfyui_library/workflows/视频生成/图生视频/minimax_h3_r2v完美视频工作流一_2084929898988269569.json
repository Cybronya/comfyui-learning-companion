d_int8_convrot.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 9}, {"mode": 0, "outputs": [{"name": "output", "links": [280, 281], "label": "output", "type": "LATENT", "localized_name": "output"}, {"name": "denoised_output", "links": [], "label": "denoised_output", "type": "LATENT", "localized_name": "denoised_output"}], "size": [230, 140], "pos": [155.0395965576172, 5114.81591796875], "widgets_values": [], "inputs": [{"name": "noise", "link": 253, "label": "noise", "type": "NOISE", "localized_name": "noise"}, {"name": "guider", "link": 254, "label": "guider", "type": "GUIDER", "localized_name": "guider"}, {"name": "sampler", "link": 255, "label": "sampler", "type": "SAMPLER", "localized_name": "sampler"}, {"name": "sigmas", "link": 256, "label": "sigmas", "type": "SIGMAS", "localized_name": "sigmas"}, {"name": "latent_image", "link": 271, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}], "flags": {}, "id": 125, "type": "SamplerCustomAdvanced", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SamplerCustomAdvanced"}, "order": 19}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [278], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [290, 330], "pos": [-1178.4815673828125, 5802.46630859375], "widgets_values": ["829e4d126e67fe634c76b00843520127c726238998b0404fc624c9a6f6b80448.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 137, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [282], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [290, 330], "pos": [-837.5756225585938, 5799.8681640625], "widgets_values": ["22c3109db365f5d265f56181e0f4747498b1c8c3519d39d886b48d590e5b5394.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 139, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 11}, {"outputs": [{"name": "STRING", "links": [279], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#322", "widgets_values": ["<Picture 1>\nA quiet ancient Chinese wooden study room at night. The room is dark and peaceful, illuminated by cold blue moonlight entering through an open lattice window and a small warm oil lamp on a wooden desk. The floor is covered with soft moonlight shadows. A simple wooden bed, aged shelves filled with books, scrolls, ink brushes, and traditional furniture create a lonely scholar's chamber atmosphere. Outside the window are distant mountains, drifting clouds, and a bright full moon in the night sky.\n\n<Picture 2>\nA young Chinese poet wearing a loose white traditional robe sits quietly on the edge of a simple wooden bed inside an ancient room at night. His hair is tied in a traditional bun, his expression is thoughtful and calm, and his body is illuminated by a mixture of blue moonlight from the window and warm lantern light from the room. The open lattice window reveals a bright full moon, dark mountains, and quiet night scenery outside. The wooden desk with scrolls and writing tools remains nearby, creating a peaceful and emotional nighttime atmosphere.\n\nCreate a cinematic 10-second continuous shot transitioning naturally from <Picture 1> to <Picture 2>.\n\nThe camera begins inside the empty ancient room, slowly moving forward through the dim space toward the moonlit window. The cold moonlight spreads across the wooden floor, while the warm oil lamp flickers softly on the desk. The camera gradually reveals subtle movement in the room: gentle wind flows through the open window, causing the curtain and paper scrolls to move slightly.\n\nAs the camera continues pushing forward, the viewpoint slowly turns toward the bed. A young poet is gradually revealed sitting quietly on the edge of the bed, looking toward the moon outside the window. The transition from an empty room to the presence of the poet happens naturally, without a cut or sudden appearance.\n\nMaintain the exact architecture, lighting, color tone, clothing style, and nighttime atmosphere from the reference images. The camera movement is slow and cinematic, with realistic depth, natural motion, and smooth visual continuity.\n\nOnly natural environmental sounds:\nsoft night wind through the window,\nsubtle wooden house creaks,\ngentle oil lamp flame movement,\nquiet distant night insects.\n\nNo background music.\nNo voice.\nNo narration.\n\nThe final frame should smoothly match <Picture 2>, holding on the poet sitting beside the moonlit window, creating a seamless connection for the next video shot."], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#533", "size": [308.940185546875, 396.4956970214844], "pos": [-1501.1312255859375, 6216.63720703125], "id": 138, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 12}, {"showAdvanced": false, "outputs": [{"name": "width", "links": [276], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [277], "label": "height", "type": "INT", "localized_name": "height"