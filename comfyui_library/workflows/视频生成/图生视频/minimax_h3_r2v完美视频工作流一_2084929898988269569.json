me": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 277, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 275, "label": "length", "type": "INT", "localized_name": "length"}, {"widget": {"name": "ref_image_size"}, "name": "ref_image_size", "label": "ref_image_size", "type": "COMBO", "localized_name": "ref_image_size"}, {"shape": 7, "name": "ref_images.ref_image_3", "label": "ref_images.ref_image_3", "type": "IMAGE", "localized_name": "ref_image_3"}, {"shape": 7, "name": "ref_images.ref_image_4", "label": "ref_images.ref_image_4", "type": "IMAGE", "localized_name": "ref_image_4"}], "flags": {}, "id": 136, "type": "MiniMaxH3ReferenceToVideo", "properties": {"widget_ue_connectable": {"width": true, "length": true, "prompt": true, "height": true}, "Node name for S&R": "MiniMaxH3ReferenceToVideo"}, "order": 17}, {"mode": 0, "outputs": [{"name": "VIDEO", "links": [260], "label": "VIDEO", "type": "VIDEO", "localized_name": "VIDEO"}], "size": [270, 110], "pos": [790, 5090], "widgets_values": [24, 8], "inputs": [{"name": "images", "link": 258, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "audio", "link": 259, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "fps"}, "name": "fps", "label": "fps", "type": "FLOAT", "localized_name": "fps"}, {"widget": {"name": "bit_depth"}, "shape": 7, "name": "bit_depth", "label": "bit_depth", "type": "INT", "localized_name": "bit_depth"}], "flags": {}, "id": 130, "type": "CreateVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CreateVideo"}, "order": 22}, {"mode": 0, "outputs": [{"name": "NOISE", "links": [253], "label": "NOISE", "type": "NOISE", "localized_name": "NOISE"}], "size": [360, 90], "pos": [-260, 4940], "widgets_values": [390178162371417, "randomize"], "inputs": [{"widget": {"name": "noise_seed"}, "name": "noise_seed", "label": "noise_seed", "type": "INT", "localized_name": "noise_seed"}], "flags": {}, "id": 129, "type": "RandomNoise", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RandomNoise"}, "order": 2}, {"mode": 0, "outputs": [{"name": "SAMPLER", "links": [255], "label": "SAMPLER", "type": "SAMPLER", "localized_name": "SAMPLER"}], "size": [370, 70], "pos": [-260, 5190], "widgets_values": ["res_multistep"], "inputs": [{"widget": {"name": "sampler_name"}, "name": "sampler_name", "label": "sampler_name", "type": "COMBO", "localized_name": "sampler_name"}], "flags": {}, "id": 123, "type": "KSamplerSelect", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSamplerSelect"}, "order": 3}, {"outputs": [], "color": "#222", "widgets_values": ["你是一名专业的中国古诗词AI电影短片导演，请根据我提供的古诗词名称和作者，使用 MiniMax H3 Ref2VA 视频生成工作流，为我设计完整的视频制作方案。\n\n我的制作要求：\n\n1. 视频目标：\n将中国古诗词制作成电影级AI短视频，表现诗词意境、人物情感和中国传统文化美学。\n\n2. 使用模型：\nMiniMax H3 Ref2VA（reference-to-video）\n\n工作方式：\n- 每次生成一个5秒视频\n- 每次上传两张参考图片\n- 使用前后两张图片作为动作连续参考\n- 多个5秒视频拼接成完整短片\n\n3. 图片要求：\n- 图片全部按照手机竖屏比例生成（9:16）\n- 适合抖音、视频号、Shorts观看\n- 电影级真实摄影风格\n- 中国古代历史场景\n- 写实风格，不要动漫\n- 光影具有电影质感\n- 保持人物、服装、场景连续一致\n\n4. 人物要求：\n根据诗歌作者设计年轻化影视形象：\n- 符合现代年轻人的审美\n- 年轻帅气、有气质\n- 保留历史人物特点\n- 古代服饰真实\n- 不要生成衰老、普通、丑化形象\n\n5. 分镜要求：\n请根据诗词内容自动进行电影化分镜设计：\n\n规则：\n- 每一句诗作为主要情绪节点\n- 根据剧情增加片头和结尾镜头\n- 每个镜头对应一个5秒视频\n- 设计人物动作、表情、环境变化和镜头运动\n\n6. 图片数量计算：\n请按照：\n\n视频数量 + 1 = 图片数量\n\n进行设计。\n\n例如：\n5个视频，需要6张关键图片。\n\n图片关系必须是：\n\n图片1 → 图片2：\n第一个5秒视频\n\n图片2 → 图片3：\n第二个5秒视频\n\n图片3 → 图片4：\n第三个5秒视频\n\n以此类推。\n\n上一张图片代表当前状态，\n下一张图片代表目标状态。\n\n7. 图片生成提示词：\n请为每一张图片输出英文Prompt。\n\n格式：\n\n图片编号：\n剧情说明：\n\nImage Prompt:\n\n英文提示词\n\n要求Prompt包含：\n- 人物外貌\n- 服装\n- 动作\n- 表情\n- 场景\n- 时间\n- 光影\n- 摄影风格\n- 镜头构图\n\n统一加入：\n\ncinematic,\nphotorealistic,\nChinese historical film,\nancient China,\nrealistic lighting,\nbeautiful composition,\nvertical 9:16\n\n8. MiniMax H3视频提示词：\n请为每一个5秒视频输出：\n\n视频编号：\n\n上传图片：\n\nPicture 1：\n（对应图片编号）\n\nPicture 2：\n（对应图片编号）\n\n\nVideo Prompt：\n\n必须严格使用：\n\n<Picture 1>\n<Picture 2>\n\n格式引用参考图。\n\n提示词必须包含：\n\n- 两张图片之间的动作变化\n- 人物动作\n- 镜头运动\n- 环境变化\n- 情绪表达\n- 光影变化\n\n格式：\n\n<Picture 1> shows...\n\n<Picture 2> shows...\n\nCreate a cinematic transition between these two images.\n\nCamera:\n描述镜头运动。\n\nCharacter:\n描述人物动作。\n\nEnvironment:\n描述环境变化。\n\nEmotion:\n描述情绪。\n\nAudio:\n加入：\n- 中国传统乐器\n- 环境声音\n- 古诗朗诵声音\n\n\n9. MiniMax H3参数建议：\n请同时给出：\n\nResolution：\nDuration：\nSampler：\nScheduler：\nref_image_size：\n\n推荐：\n\nResolution:\n手机竖屏比例\n\nDuration:\n5 seconds\n\nSampler:\nres_multistep\n\nScheduler:\nbeta\n\nref_image_size:\nmax\n\n\n10. 输出格式：\n\n请严格按照以下结构：\n\n# 一、诗词解析与视频主题\n\n# 二、整体视频规划\n\n# 三、人物设定\n\n# 四、需要生成的图片数量\n\n# 五、图片生成Prompt\n\n图片1：\nPrompt：\n\n图片2：\nPrompt：\n\n……\n\n# 六、MiniMax H3视频生成方案\n\n视频1：\n上传：\nPicture 1：\nPicture 2：\n\nVideo Prompt：\n\n……\n\n# 七、最终剪辑顺序\n\n\n现在开始制作：\n\n诗词：\n《这里填写诗名》\n\n作者：\n这里填写作者"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: MiniMax H3", "mode": 0, "bgcolor": "#000", "size": [450, 876.703125], "pos": [-3044.98974609375, 4834.50244140625], "id": 146, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"mode": 0, "outputs": [{"name": "SIGMAS", "links": [256], "label": "SIGMAS", "type": "SIGMAS", "localized_name": "SIGMAS"}], "size": [370, 130], "pos": [-259.3333740234375, 5328], "widgets_values": ["normal", 25, 1], "inputs": [{"name": "model", "link": 252, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "label": "scheduler", "type": "COMBO", "localized_name": "scheduler"}, {"widget": {"name": "steps"}, "name": "steps", "label": "steps", "type": "INT", "localized_name": "steps"}, {"widget": {"name": "denoise"}, "name": "denoise", "label": "denoise", "type": "FLOAT", "localized_name": "denoise"}], "flags": {}, "id": 124, "type": "BasicScheduler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "BasicScheduler"}, "order": 15}, {"outputs": [], "color": "#222", "widgets_values": ["| megapixels | Aspect | Output (multiple=32) |\n|---|---|---|\n| 0.2 | 16:9 | 608 x 352 |\n| 0.3 | 16:9 | 736 x 416 |\n| 0.4 | 16:9 | 864 x 480 |\n| 0.5 | 16:9 | 960 x 544 |\n| 0.6 | 16:9 | 1056 x 608 |\n| 0.7 | 16:9 | 1152 x 640 |\n| 0.8 | 16:9 | 1216 x 672 |\n| 0.9 | 16:9 | 1280 x 736 |\n| 0.98 | 16:9 | 1344 x 768 |\n| 1.0 | 16:9 | 1376 x 768 |\n| 1.2 | 16:9 | 1504 x 832 |\n| 1.5 | 16:9 | 1664 x 928 |\n| 1.8 | 16:9 | 1824 x 1024 |\n| 2.0 | 16:9 | 1920 x 1088 |\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: Size Settings Reference", "mode": 0, "bgcolor": "#000", "size": [300, 512], "pos": [-1890, 5830], "id": 140, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"outputs": [], "color": "#222", "widgets_values": ["## MiniMax H3\n\n[MiniMax H3](https://www.minimax.io/blog/minimax-h3) is MiniMax's general-purpose, omni-modal generation model. It jointly understands text, image, video, and audio, and generates video with **native stereo audio**: voice, sound effects, and music are modeled jointly in a single forward pass, not layered on afterward. Output is up to 2K resolution, 24fps, and up to about 15 seconds.\n\n## ComfyUI links\n- [ComfyUI#15224](https://github.com/Comfy-Org/ComfyUI/pull/15224)\n- [🤗 Comfy-Org/MiniMax-H3](https://huggingface.co/Comfy-Org/MiniMax-H3)\n\n## About this workflow\n\nThis template runs the **reference-to-video (ref2va)** task using the `MiniMaxH3ReferenceToVideo` node. It takes any mix of reference images, videos, and standalone audio, and weaves them into the generation to lock in a character's identity, a style, a motion, a camera move, or a voice.\n\n**Key inputs**\n\n- **ref_images / ref_videos / ref_video_audios / ref_audios**: up to 9 reference images, 3 reference videos (each may carry its own paired soundtrack), and 3 standalone reference audio clips\n- **prompt**: reference the inputs by tag, in the exact order they were connected, for example `<Picture 1>`, `<Video 1>`, `<Audio 1>`, then describe the target scene, motion, and audio\n- **ref_image_size**: `match` scales references down to the generation's resolution (faster); `max` keeps up to a 2048px short edge for stronger identity fidelity, at the cost of speed since reference tokens ride along every sampling step\n- **width / height**: set via Resolution Selector.\n- **duration (seconds)**: converted to a valid frame `length` by the Math Expression node\n\n**Sampling and decode**\n\n- Sampler: `res_multistep`. `beta` or `normal` scheduler tends to outperform `simple` for reference-heavy prompts like this one\n- The sampler's joint audio+video `LATENT` output feeds directly into both `VAEDecode` (video, `minimax_h3_video_vae_fp16`) and `VAEDecodeAudio` (audio, `minimax_h3_audio_vae_fp32`); each decode node automatically pulls its own half out of the packed latent. `CreateVideo` then muxes the two into a single MP4 with synced sound\n- The diffusion model here is `minimax_h3_ref2va_pruned_int8_convrot.safetensors`, a different set of weights from the `fl2va` model used by the t2v/i2v templates\n\nRef2va's output is very sensitive to prompt wording; matching the reference tags precisely and being explicit about which reference drives which part of the shot tends to work best."], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: MiniMax H3", "mode": 0, "bgcolor": "#000", "size": [450, 876.703125], "pos": [-2030, 4850], "id": 116, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"mode": 0, "outputs": [{"name": "VAE", "links": [251, 273], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [640, 70], "pos": [-1490, 5270], "widgets_values": ["minimax_h3_video_vae_fp16.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 119, "type": "VAELoader", "properties": {"models": [{"directory_invalid": true, "name": "minimax_h3_video_vae_fp16.safetensors", "directory": "vae", "url": "https://hug