ized_name": "字符串"}], "color": "#232", "widgets_values": ["\n图生视频，15秒，参考右侧实拍人物形象，人物外貌、服装保持不变，严格按照左侧16格街舞分镜动作顺序依次完成整套breaking动作：①起始律动 →②身体wave传导 →③单腿Balancing →④Pop+滑步 →⑤重心下沉 →⑥双手支撑 →⑦地板高难度旋转 →⑧接步缓冲 →⑨弹射起身180°转体 →⑩高抬腿定格 →⑪碎步锁定(Lock) →⑫肩部离地滑动 →⑬背旋发力 →⑭头部倒立雏形 →⑮全身腾空大跨步 →⑯霸气落地谢幕。\n\n场景：赛博朋克街舞舞台，宽敞表演场地，深色防滑舞台地面，地面霓虹几何发光线条，背景巨型全息大屏展示雨夜赛博都市，金属桁架，舞台频闪射灯，青蓝洋红霓虹撞色体积光，空气中丁达尔光束，硬核工业金属材质，舞台中心预留大片空地供舞者跳舞，\n\n人物在画面中心，动作流畅连贯，自然真实，人物面部、外形全程保持和参考图一致，光影统一，运动平滑，无画面闪烁，写实摄影，自然日光。\n负面提示词:人物变形，面部崩坏，肢体扭曲，画面闪烁，镜头剧烈晃动，人物换脸，服装改变，动作跳步，画面撕裂，模糊，低画质，多余物体，卡通，手绘，文字，水印\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [410, 640], "pos": [-2385.054443359375, 5955.26611328125], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.33.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 17}], "extra": {"VHS_KeepIntermediate": false, "links_added_by_ue": [], "VHS_MetadataImage": false, "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.53.6", "VHS_latentpreview": true, "ds": {"offset": [2687.257227718574, -5905.33119542288], "scale": 1.879761676237083}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "参数1", "bounding": [-2610, 4900, 1088.482177734375, 966.0245971679688]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 7, "title": "采样", "bounding": [-1510, 4900, 2265.45703125, 964.0286865234375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 8, "title": "参数2", "bounding": [-2613.794677734375, 5885.2666015625, 1090, 730]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 9, "title": "结果", "bounding": [-3110, 4900, 483.7945251464844, 970.5780639648438]}], "links": [[250, 120, 0, 121, 1, "VAE"], [251, 119, 0, 122, 1, "VAE"], [253, 129, 0, 125, 0, "NOI