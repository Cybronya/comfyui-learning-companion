ontact sheet for a high-end smartphone commercial. Each of the 6 frames is 16:9. The style is minimalist luxury, featuring a beautiful East Asian woman in a black off-shoulder dress and sleek back hair, and sleek smartphones in purple, orange, and white. The color palette is dominated by deep red, black, and metallic textures. Frame 1: ECU of the woman's eye. Frame 2: Macro of a finger touching an orange metallic phone edge. Frame 3: The woman leaning on a red reflective table. Frame 4: Macro of a purple phone camera lens. Frame 5: Low angle of the woman with golden earrings holding a phone. Frame 6: A wide shot of three phones on a red surface. Pure cinematic images, no text, no numbers, no borders, consistent lighting and color grading.\\\", \\\"size\\\": \\\"1024x1024\\\" }\"\n}\n![](https://files.oaiusercontent.com/file-K1bXvWv7Yq9p5mXm2Z3z7A?se=2024-10-27T10%3A00%3A00Z&sp=r&sv=2024-08-04&sr=b&rscc=max-age%3D604800%2C%20immutable%2C%20private&rscd=attachment%3B%20filename%3Dstoryboard.png&sig=...)"], "inputs": [{"shape": 7, "name": "anything", "link": 728, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 405, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "b6bb4a3055adc718ec98befee233f8b05c778465", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 22}, {"mode": 0, "outputs": [{"name": "image", "links": [682, 683, 742], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [396.87396240234375, 226], "shape": 1, "pos": [2903.521240234375, 12459.12890625], "widgets_values": ["FlashVSR-v1.1", "tiny", 2, true, true, false, 933437695113527, "randomize"], "inputs": [{"name": "frames", "link": 725, "label": "frames", "type": "IMAGE", "localized_name": "frames"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": 