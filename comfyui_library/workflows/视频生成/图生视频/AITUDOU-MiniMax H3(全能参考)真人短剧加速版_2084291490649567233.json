it Widescreen)", 0.4, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "id": 44, "type": "ResolutionSelector", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 26}, {"mode": 0, "outputs": [{"name": "FLOAT", "links": [25], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "size": [270, 70], "pos": [2129.64111328125, 1594.5732421875], "widgets_values": [10], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "id": 20, "type": "PrimitiveFloat", "title": "Float (duration)", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 27}, {"mode": 0, "outputs": [{"name": "string", "links": [24], "label": "string", "type": "STRING", "localized_name": "string"}], "size": [400, 200], "pos": [835.34130859375, 1575.1455078125], "widgets_values": ["总时长10秒，竖屏9:16室内家庭争吵短剧，真人实拍感，手机短剧质感，现实主义表演，暖黄色室内灯光，中式家庭小饭馆环境，背景有生活化餐桌、红色装饰和书法字幅，浅景深，中近景与近距离正反打为主，人物面部和口型清晰，情绪从压抑争执逐步升级为强烈对峙。男主秦皓瑄，年轻男性，普通居家短剧造型，表情愤怒、委屈、急切，语气强硬但带被误解后的焦躁；中老年女性老婆婆，居家服饰，表情尖锐强势，眼神逼视，语气咄咄逼人、带质问和讥讽；两人保持明确视线关系和空间轴线，不夸张舞台腔，动作符合真实家庭争吵节奏。 【镜头1｜0.0—2.5秒】中近景双人构图，从餐桌一侧开始，秦皓瑄站在画面左侧，老婆婆站在画面右侧，桌上有一盘刚做好的鸡肉菜肴；秦皓瑄身体前倾，手掌指向餐桌，眉头紧锁、嘴角绷紧，带着愤怒和委屈快速反驳：“放屁，这个鸡是我给我女儿做的，”声音急切，口型精准同步；老婆婆在对面冷笑、抬下巴逼视他，背景暖光和红色装饰保持稳定，声音桥接下一镜。 【镜头2｜2.5—5.4秒】切至秦皓瑄胸部以上中近景，50mm镜头，摄影机轻微向前推进但不抖动；他眼神先扫过桌上的鸡，又猛地抬眼看向老婆婆，手指收紧，继续压着怒气说：“什么时候是给你们做的。”说到最后几个字时下颌发力、呼吸变重，眼神从委屈转为不耐烦；立即动作匹配硬切到老婆婆反应。 【镜头3｜5.4—8.6秒】切至老婆婆中近景，保持与秦皓瑄相反的正反打方向，老婆婆身体微微前压，嘴角带讥讽，眉峰上挑，连续逼问：“秦浩轩，你哪天不是给我们家屁颠屁颠做饭。”语气尖锐、强势、咄咄逼人，句中故意加重“哪天不是”和“屁颠屁颠”，说完后保持挑衅眼神半秒；秦皓瑄在画面边缘虚焦处明显吸气、肩膀绷紧，形成声音和视线桥接。 【镜头4｜8.6—10.0秒】切回秦皓瑄近景，85mm镜头，面部占画面主体；他被彻底激怒，嘴唇紧抿后突然抬眼，短促爆发式地说：“滚犊子！”说完立即闭嘴，保持怒视和急促呼吸，老婆婆在背景虚焦中仍保持强硬姿态，画面停在两人僵持的情绪余韵上。剪辑节奏紧凑，使用正反打硬切、动作匹配切、视线匹配切和声音桥接；对白必须完整保留、正常快速争吵语速、口型精准同步，不添加字幕；声音包含室内环境声、餐具轻响、衣料摩擦、急促呼吸和清晰人声，音乐不得盖住台词。严格保持中式家庭／小饭馆室内空间、暖色灯光、红色装饰、书法字幅、生活化背景和浅景深；不出现科幻、古装、动画感、游戏CG感、舞台腔、夸张表演、额外人物、额外道具、字幕、可读新增文字、平台水印、贴片或品牌标识；不出现脸部变形、口型错位、声音与台词不同步、人物换位、空间轴线混乱、手指错误、额外肢体、物体穿模、瞬移、悬浮、无故改变餐桌或鸡肉菜肴位置；不出现远景、人物过小、无理由镜头抖动、镜头旋转、焦点漂移、画面闪烁、突然变焦、慢动作或重复动作；不使用淡入淡出、溶解、叠化或变形转场。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 43, "type": "Text", "title": "提示词", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Text"}, "order": 28}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [49], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [640, 90], "pos": [825.4588623046875, 872.2783203125], "widgets_values": ["minimax_h3_ref2va_int8_convrot.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 12, "type": "UNETLoader", "properties": {"models": [{"name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "directory": "diffusion_models", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors"}], "widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 29}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [50], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 130], "pos": [1462.51025390625, 911.9442749023438], "widgets_values": [0.12000000000000002, 0.15, 0.95, false], "inputs": [{"name": "model", "link": 49, "label": "model", "type": "MODEL", "localized_name": "mod