89.0966796875, -562.615234375], "widgets_values": ["角色绑定：画面中的少女——黑色齐肩短发配空气刘海，头戴紫色与黄色小花花环，身穿米白色露肩蕾丝荷叶边上衣，肩头抱着一只奶油色虎斑长毛猫，形象与首帧完全一致，全程不换装、不变脸、不加人物。\n\n场景绑定：晴天户外，湛蓝天空，左上角一道彩虹横跨，少女撑着一把洒满闪片的透明雨伞，背景有虚化的白色花丛与阳光光斑，场景与首帧完全一致，不切换镜头、不换背景。\n\n动作（10秒）：少女仰头望向天空，张嘴用日语欢快地唱歌，口型随旋律自然开合，唱到开心处眯起眼睛露出灿烂笑容；怀里的猫咪耳朵轻轻抖动，尾巴缓缓摇摆；她随歌声轻轻左右摇晃身体，透明伞微微转动，伞上闪片随光折射流动；发丝和花环在微风中轻轻飘动。\n\n镜头：固定机位中景，缓慢轻微推近，浅景深，电影感柔和自然光。\n\n画面规格：16:9 横幅，时长10秒，实拍质感，色调明亮通透。\n\n硬性要求：人物只以歌声口型呈现，画面中绝对不得出现任何字幕、歌词文字、注音、字母、LOGO、水印；角色不泛红，肤色与首帧一致；无分身、无多余人物。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 164, "type": "CR Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 11}, {"mode": 0, "outputs": [{"name": "INT", "links": [304], "label": "整数", "type": "INT", "localized_name": "整数"}], "size": [409.6423645019531, 60.03083801269531], "pos": [-2390.562255859375, -870.449462890625], "widgets_values": [720], "inputs": [{"widget": {"name": "value"}, "name": "value", "type": "INT", "localized_name": "值"}], "flags": {}, "id": 163, "type": "ImpactInt", "properties": {"cnr_id": "comfyui-impact-pack", "ver": "705698faf242851881abd7d1e1774baa3cf47136", "widget_ue_connectable": {}, "Node name for S&R": "ImpactInt"}, "order": 12}, {"mode": 0, "outputs": [{"name": "Filenames", "links": [332], "label": "文件名", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "size": [419.2117004394531, 1037.352783203125], "pos": [-1529.24365234375, -898.7496337890625], "widgets_values": {"save_output": true, "filename_prefix": "VX-paolaoshiAICG", "loop_count": 0, "pix_fmt": "yuv420p", "save_metadata": true, "crf": 12, "trim_to_audio": false, "videopreview": {"paused": false, "hidden": false, "params": {"storageProvider": "tos", "cos_url": "https://rh-comfyui01.tos-cn-beijing.volces.com/a9c1193cda443ab7c340af0fcc15960a/output/VX-paolaoshiAICG_00002_p8