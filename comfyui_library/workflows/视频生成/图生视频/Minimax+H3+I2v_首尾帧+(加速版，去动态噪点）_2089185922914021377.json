ht"}, "name": "height", "link": 305, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 245, "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "id": 133, "type": "MiniMaxH3ImageToVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"width": true, "length": true, "height": true}, "Node name for S&R": "MiniMaxH3ImageToVideo"}, "order": 38}, {"mode": 0, "outputs": [{"name": "", "links": [298], "label": "", "type": "*"}], "size": [75, 26], "pos": [1434.6185302734375, 6212.76708984375], "inputs": [{"name": "", "label": "", "type": "*"}], "flags": {}, "id": 152, "type": "Reroute", "properties": {"horizontal": false, "widget_ue_connectable": {}, "showOutputText": false}, "order": 9}, {"mode": 0, "outputs": [{"name": "image", "links": [280], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"name": "original_size", "label": "original_size", "type": "BOX", "localized_name": "original_size"}, {"name": "width", "links": [266, 304], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [267, 305], "label": "height", "type": "INT", "localized_name": "height"}], "size": [303.6851501464844, 330], "color": "rgba(38, 73, 116, 0.7)", "pos": [331.3731689453125, 6291.16650390625], "widgets_values": ["original", 1, 1, "letterbox", "lanczos", "32", "longest", 1024, "#000000"], "inputs": [{"shape": 7, "name": "image", "link": 261, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"shape": 7, "name": "mask", "label": "mask", "type": "MASK", "localized_name": "mask"}, {"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "proportional_width"}, "name": "proportional_width", "label": "proportional_width", "type": "INT", "localized_name": "proportional_width"}, {"widget": {"name": "proportional_height"}, "name": "proportional_height", "label": "proportional_height", "type": "INT", "localized_name": "proportional_height"}, {"widget": {"name": "fit"}, "name": "fit", "label": "fit", "type": "COMBO", "localized_name": "fit"}, {"widget": {"name": "method"}, "name": "method", "label": "method", "type": "COMBO", "localized_name": "method"}, {"widget": {"name": "round_to_multiple"}, "name": "round_to_multiple", "label": "round_to_multiple", "type": "COMBO", "localized_name": "round_to_multiple"}, {"widget": {"name": "scale_to_side"}, "name": "scale_to_side", "label": "scale_to_side", "type": "COMBO", "localized_name": "scale_to_side"}, {"widget": {"name": "scale_to_length"}, "name": "scale_to_length", "label": "scale_to_length", "type": "INT", "localized_name": "scale_to_length"}, {"widget": {"name": "background_color"}, "name": "background_color", "label": "background_color", "type": "STRING", "localized_name": "background_color"}], "flags": {}, "id": 142, "type": "LayerUtility: ImageScaleByAspectRatio V2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: ImageScaleByAspectRatio V2"}, "order": 31}, {"outputs": [], "color": "#432", "widgets_values": ["\n##流泪\n动漫风格，蓝发蓝眼帅气少年，深色外套，灰蓝色阴云密布的天空背景，快速流动的冷白色发光粒子。高动态镜头，带轻微动态模糊。\n\n第一阶段（急促低头掩饰，0-2.5秒）： 少年站在狂风中，猛地低头避开镜头，单手用力按在额前，手指抓住发根。碎发剧烈飞舞，肩膀开始轻微颤抖。\n\n第二阶段（抬头落泪，2.5-5秒）： 他缓缓抬起头，眼眶已经完全泛红，泪水顺着脸颊滑落。睫毛上挂着泪珠，他哽咽着嘴唇开合，声音沙哑地说：“那片蓝色天际……原来早就碎了……”\n\n第三阶段（泪流收尾，5-7秒）： 泪水继续从眼中滑落，嘴角却勉强扯出一个苦涩的微笑。他抬起手，用力擦了一下眼角的泪水，随后目光脆弱地看向镜头，慢慢闭上了眼睛。粒子像碎冰一样从画面中划过，定格在悲伤的剪影。\n\n高动态，高对比度光影，电影质感，悲伤氛围，动作流畅连贯，眼泪轨迹清晰，4K。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-2474.81689453125, 8234.0517578125], "id": 182, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"outputs": [], "color": "#432", "widgets_values": ["\n##忧伤\n动漫风格，蓝发蓝眼帅气少年，深色外套。天空转为黄昏或阴云密布的灰蓝色调，空中漂浮着快速流动的白色和冷蓝色发光粒子。高动态镜头，带轻微动态模糊。\n\n第一阶段（急促动作，0-2.5秒）： 少年站在风中，突然急促地低下头，抬起手用力按在自己的额头上，碎发被狂风猛烈吹乱。他微微皱起眉头，眼眶微红，神情显得极度挣扎和悲伤。\n\n第二阶段（痛苦诉说，2.5-5秒）： 他缓缓放下手，抬起头，眼神充满失落与破碎感，嘴唇在微颤中艰难开合，声音沙哑地低语：“那片蓝色天际……原来早就碎了……”\n\n第三阶段（崩溃收尾，5-7秒）： 他勉强扯出一个苦涩的微笑，目光脆弱地看向镜头，随后像是无法承受一般，缓缓垂下眼帘，将脸侧向阴影处。狂风吹过，身后的光斑如同碎屑般快速划过画面。镜头最终定格在他落寞的侧脸剪影上。\n\n高动态，高对比度光影，电影质感，伤感氛围，动作流畅自然，4K。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-2473.304443359375, 7874.138671875], "id": 183, "properties": {"widget_ue_connectable": {}}, "order": 11}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [584.2317504882812, 503.77960205078125], "pos": [-2498.31201171875, 6912.35693359375], "widgets_values": ["719b2e403887a109396457312b46ec1051ffa1e91ec993fac4e482bc75d4d00d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 181, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 12}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [239], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [230, 60], "pos": [1410.135986328125, 4959.75927734375], "widgets_values": [], "inputs": [{"name": "samples", "link": 249, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 230, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {"collapsed": false}, "id": 124, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 41}, {"outputs": [], "color": "#432", "widgets_values": ["\n##高冷\n动漫风格，红发绿眼的高冷御姐，身穿黑色细吊带背心，逆光环境，空中飘动闪烁光斑。中景固定镜头，高情绪张力。\n\n第一阶段（0-2.5秒）： 她微微皱起眉头，眼帘微垂，目光在逆光中透着一种压抑的烦躁和不耐烦。红发在风中微微拂动，她的嘴唇抿成一条线。\n第二阶段（2.5-5秒）： 她猛地抬起眼，目光带着锐利、倔强与几分不屑，直直地盯向镜头。嘴唇带着强烈的情绪化快速开合，语气带着讥讽与愠怒，开口说道：“别以为我看不透你的把戏，省省吧。”\n第三阶段（5-7秒）： 话音落下，她嘴角勾起一抹带着情绪化的冷笑。随后她略显烦躁地抬起手，将吹散的红发撩到肩后，别过脸侧向一边，眼神疏离，定格在冷傲绝美的侧颜上。\n\n4K高清，电影级逆光光影，情绪饱满，动作连贯自然，无画面扭曲"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-1810.8116455078125, 7503.2978515625], "id": 188, "properties": {"widget_ue_connectable": {}}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["\n##流泪\n第一阶段（0-2.5秒）： 她微微低着头，红发凌乱地垂落遮挡住半张脸。她眉头紧紧蹙起，眼眶迅速发红，泪水在眼眶中打转，睫毛微微颤抖，下嘴唇因极力克制悲伤而轻轻咬住。\n\n第二阶段（2.5-5秒）： 她猛地抬起湿润的眼眸，眼神中带着破碎的倔强与绝望，直视镜头。两颗泪水顺着苍白的脸颊滑落。她的嘴唇带着剧烈的哽咽和颤抖开合，声音沙哑绝望地说道：“所以……我就只是个笑话吗？”\n\n第三阶段（5-7秒）： 她的话语戛然而止，眼神中最后一点光芒黯淡下去。她用力抬手胡乱抹了一把眼泪，随即猛地低下头，将脸埋进阴影里，长发完全垂下遮住了表情，肩膀微微抽动，定格在无声崩溃的侧影中。\n\n4K高清，电影级逆光光影，泪水滑落轨迹清晰，五官微表情动态极为丰富生动，情绪极度真实强烈，无画面扭曲变形"], "inputs": [], "flags": {}, "type": "Note", "title": "流泪", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-1813.1356201171875, 7873.65576171875], "id": 186, "properties": {"widget_ue_connectable": {}}, "order": 14}, {"outputs": [], "color": "#432", "widgets_values": ["\n##狂笑\n第一阶段（0-2.5秒）： 她双手无力地垂下，身体微微向后仰，红色的发丝在空中肆意飞舞。她嘴角缓缓上扬，幅度越来越大，绿色眼眸中闪烁着疯狂又张扬的光芒，喉间发出低沉的笑声。\n\n第二阶段（2.5-5秒）： 她猛地仰起头，笑声瞬间放大，肩膀剧烈颤抖，五官舒展开来呈现出近乎失控的狂喜。她猛地转头直视镜头，眼睛里带着三分嘲弄和七分狂妄，大笑着开口：“你以为你赢了？……真是太可笑了！”\n\n第三阶段（5-7秒）： 她的狂笑渐渐收敛，转为嘴角一抹带着危险气息的冷笑。她慢条斯理地抬手，将凌乱散落的红发勾到耳后，眼神依然锐利如刀，定格在不可一世的自信神情上。\n\n4K高清，电影级逆光光影，表情转换极具张力，动作嚣张连贯，无画面扭曲变形。"], "inputs": [], "flags": {}, "type": "Note", "title": "狂笑", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-1804.7147216796875, 8242.42578125], "id": 187, "properties": {"widget_ue_connectable": {}}, "order": 15}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [584.2317504882812, 503.77960205078125], "pos": [-1838.83349609375, 6925.70458984375], "widgets_values": ["37d609d3c78fc24ca4782bd7f8de8d2e1f531c7055de399134c0efd1cd02742d.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 189, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 16}, {"outputs": [], "color": "#222", "widgets_values": ["## MiniMax H3\n\n[MiniMax H3](https://www.minimax.io/blog/minimax-h3) is MiniMax's general-purpose, omni-modal generation model. It jointly understands text, image, video, and audio, and generates video with **native stereo audio**: voice, sound effects, and music are modeled jointly in a single forward pass, not layered on afterward. Output is up to 2K resolution, 24fps, and up to about 15 seconds.\n\n## About this workflow\n\nThis template runs the **Image to Video** task (`MiniMaxH3ImageToVideo` node), which covers both:\n\n- **t2va** (text-to-video), when no images are connected\n- **fl2va** (first/last-frame image-to-video), when `first_frame` and/or `last_frame` are connected\n\n**Key inputs**\n\n- **first_frame / last_frame**: optional keyframes; the model generates the motion between them\n- **prompt**: describe the shots, motion, and the accompanying audio (dialogue, SFX, music) in one block\n- **width / height**: set via Resolution Selector. H3's native canvas is a 768px short edge, capped at 768x1344 pixels, rounded to a multiple of 32\n- **duration (seconds)**: converted to a valid frame `length` by the Math Expression node, snapping up to the model's 17-frame-per-block (17k+5) grid at 24fps"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: MiniMax H3", "mode": 0, "bgcolor": "#000", "size": [450, 630], "pos": [-1995.19384765625, 5992.74951171875], "id": 116, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}}, "order": 17}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [210, 180], "pos": [1813.4454345703125, 6262.28173828125], "widgets_values": ["video/MiniMax_H3", "auto", "auto"], "inputs": [{"name": "video", "link": 243, "label": "video", "type": "VIDEO", "localized_name": "video"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "format"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "codec"}], "flags": {}, "id": 92, "type": "SaveVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 44}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [584.2317504882812, 503.77960205078125], "pos": [-1171.51708984375, 6915.52734375], "widgets_values": ["15ab13b710ad94aefd5a554a3a10bf0cc0863ff039a0c16f52a8d54279faaa7e.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 191, "type": "LoadImage", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 18}, {"outputs": [], "color": "#432", "widgets_values": ["\n##情绪转换\n动漫高精度画风，白发蓝眼元气少女，蓝白水手服短上衣，深蓝色百褶裙，肩挎黑色双肩包，背包侧边挂着一只白色毛绒小熊。背景是蓝天白云，阳光强烈的夏日街头，有白色花瓣随风飘散。动态中景，强调人物情绪与五官转换。\n\n第一阶段（0-2秒）- 吃惊与无奈： 她正大步走在路上，突然被什么绊了一下，身体微微向前踉跄。她猛地睁大眼睛，蓝色的眼眸里闪过一丝惊愕，微张着嘴巴发出一声无声的惊叹。她下意识地抓紧了背包肩带，眉头微微皱起。\n\n第二阶段（2-4.5秒）- 抱怨与撒娇： 她站稳后，立刻鼓起脸颊，眉头微蹙，嘴里嘟嘟囔囔起来。她转过头，用一种带着点委屈和不满的眼神看着镜头（或旁边的人），嘴唇快速开合，像是在埋怨：“哎呀！真是的，这条路怎么这么多坑啊！”\n\n第三阶段（4.5-7秒）- 释然与惊喜： 她话刚说完，一阵清凉的夏风吹来，将她的白发吹得飞扬。她顺势抬起头，深深吸了一口清新的空气。随即，她眼中的抱怨瞬间消散，换上了充满惊喜的光亮。她转过头，嘴角绽放出极度灿烂、毫无保留的笑容，开心地说道：“不过……这里的风也太舒服了吧！” 她迎着阳光，头发和裙摆随风舞动，定格在极致的青春与惬意中。\n\n4K超清，夏日阳光高饱和色彩，发丝与衣摆动态自然，从惊愕到抱怨再到惊喜的笑容转换生动细腻，充满生活气息，无画面扭曲变形。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-1176.337890625, 7507.1572265625], "id": 192, "properties": {"widget_ue_connectable": {}}, "order": 19}, {"outputs": [], "color": "#432", "widgets_values": ["\n##可爱\n动漫高精度画风，灰棕色短发少女，头顶毛茸茸猫耳，戴着黑色项圈，穿着粉白水手领校服，胸前系着黑色蝴蝶结。画面明亮柔和，粉白色花瓣在光线下缓缓飘落。中近景特写，强调治愈感与元气笑容。\n\n第一阶段（0-2.5秒）： 少女歪着头，双手轻轻捧在自己脸颊两侧，头顶的猫耳好奇地向前竖起。她微眯起一只眼睛，另一只蔚蓝色的眼眸亮晶晶地注视着镜头，嘴角挂着俏皮又灿烂的坏笑，身体微微前后摇晃，一副准备哄人的可爱模样。\n\n第二阶段（2.5-5秒）： 她放下手，身体向前凑近半步，像个小猫一样探头看向镜头。她眼神变得无比温柔真诚，轻轻歪了歪脑袋，用甜甜的、带着一点点撒娇和央求的语气开口：“好啦好啦，大家都不要生气啦~”\n\n第三阶段（5-7秒）： 她说完后，自己先忍不住笑了起来，脸颊微微泛红。她随即抬起一只手，在脸侧比了一个可爱的“小剪刀手”（耶），同时对着镜头俏皮地眨了一下左眼。最后定格在一个让人看到就忍不住嘴角上扬的治愈系笑容上，周围的粉色花瓣缓缓飘落。\n\n4K高清，明亮治愈的顺光环境，花瓣飘落自然流畅，五官生动活泼，气氛温暖轻松，无画面扭曲变形"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-1162.669189453125, 8252.4599609375], "id": 193, "properties": {"widget_ue_connectable": {}}, "order": 20}, {"outputs": [], "color": "#432", "widgets_values": ["\n##愤怒\n动漫高精度画风，黑发橙金瞳少年，黑色连帽卫衣，橙色内搭，银色项链。身处烈火之中，火星四溅，逆光高动态火焰特效。中景特写。\n\n第一阶段（0-2.5秒）：他抬起右手，猛地将卫衣领口的拉链用力向下扯开，动作粗暴。黑发散乱垂在眼前，他缓缓抬头，眉头紧锁，眼中的橙金光芒在火光中闪烁。他咬紧牙关，下颚线条紧绷，胸口随着急促的呼吸剧烈起伏。\n\n第二阶段（2.5-5秒）：他猛地向前迈出一步，右手狠狠抡起并握拳砸向身侧的空气，伴随着手臂挥动的动作，周围的火星被劲风卷起，四散炸裂。他侧过头，充满怒意的目光直逼镜头，嘴角微微抽搐，喘着粗气愤然开口，话声带着压抑的怒意：“为了这些东西……值得吗？！”\n\n第三阶段（5-7秒）：他话音刚落，一把抓起脖颈上的银色项链用力扯断，项链在空中甩出一道弧线，落入脚边的火海中。他双眼通红，额角青筋暴起，死死盯着镜头的双眼仿佛能喷出火来。最终他抬起手用力梳理了一把乱发，眼神中充满不甘与怒火，定格在火光映照下的决绝侧脸。\n\n4K高清，动作大开大合，情绪极具爆发力和渲染力，火焰交互极强，五官表情生动，无扭曲变"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-1162.382080078125, 7877.6591796875], "id": 194, "properties": {"widget_ue_connectable": {}}, "order": 21}, {"outputs": [], "color": "#432", "widgets_values": ["\n##温暖\n动漫风格，蓝发蓝眼帅气少年，深色外套，湛蓝天空背景，漂浮蓝橙色发光粒子。固定镜头，中景特写。7秒完整帅气连贯动作：\n\n第一阶段（抬手/撩发，0-2.5秒）： 少年微微眯起眼睛，抬手随意地撩了一下额前的碎发，动作帅气潇洒。他放下手后，嘴角勾起自信又温柔的浅笑，目光明亮地看向镜头。\n\n第二阶段（歪头说台词，2.5-5秒）： 他微微歪了一下头，眼神专注，嘴唇自然开合，用一种略带慵懒和自信的温和语气开口说：“昨晚梦里的那片蓝色天际……”\n\n第三阶段（单手插兜/收尾，5-7秒）： 他帅气地把左手插进外套口袋，头微微扬起，眼神从自信转为清澈。他嘴唇缓缓闭合，说出最后一句：“别担心，那只是个温柔的好梦。”随后定格在一个阳光帅气的微笑。\n\n4K高清，电影级光影，动作自然潇洒，无画面扭曲，梦幻唯美氛围。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [547.3372192382812, 294.4119567871094], "pos": [-2474.36474609375, 7493.2802734375], "id": 184, "properties": {"widget_ue_connectable": {}}, "order": 22}, {"mode": 0, "outputs": [{"name": "FLOAT", "links": [248], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "size": [270, 70], "pos": [-1230, 6260], "widgets_values": [7], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "value"}], "flags": {}, "id": 135, "type": "PrimitiveFloat", "title": "Float (duration)", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 23}, {"outputs": [], "color": "#222", "widgets_values": ["## Model Links\n\n**vae**\n\n- [minimax_h3_video_vae_fp16.safetensors](https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_video_vae_fp16.safetensors)\n- [minimax_h3_audio_vae_fp32.safetensors](https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_audio_vae_fp32.safetensors)\n\n**diffusion_models**\n\n- [minimax_h3_fl2va_int8_convrot.safetensors](https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_int8_convrot.safetensors)\n\n**text_encoders**\n\n- [qwen3vl_32b_minimax_h3_int8_convrot.safetensors](https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors)\n\n\n## Model Storage Location\n\n```\n📂 ComfyUI/\n├── 📂 models/\n│   ├── 📂 vae/\n│   │   ├── minimax_h3_video_vae_fp16.safetensors\n│   │   └── minimax_h3_audio_vae_fp32.safetensors\n│   ├── 📂 diffusion_models/\n│   │   └── minimax_h3_fl2va_int8_convrot.safetensors\n│   └── 📂 text_encoders/\n│       └── qwen3vl_32b_minimax_h3_int8_convrot.safetensors\n```\n\n## Report Issue\n\nNote: Please update ComfyUI first ([guide](https://docs.comfy.org/installation/update_comfyui)) and prepare required models. Desktop/Cloud updates follow stable releases, so some nightly-supported models may not be available yet.\n\n- Cannot run / runtime errors: [ComfyUI/issues](https://github.com/comfyanonymous/ComfyUI/issues)\n- UI / frontend issues: [ComfyUI_fron