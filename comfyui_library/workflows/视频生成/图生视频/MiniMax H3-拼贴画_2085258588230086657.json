, "label": "frames", "type": "IMAGE", "localized_name": "frames"}, {"name": "audio", "slot_index": 1, "links": [17], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "size": [380, 100], "pos": [5573.5927734375, 612.0140380859375], "inputs": [{"name": "h3_vae_bundle", "link": 14, "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BUNDLE", "localized_name": "h3_vae_bundle"}, {"name": "sampled_av_latent", "link": 15, "label": "sampled_av_latent", "type": "MINIMAX_H3_AV_LATENT", "localized_name": "sampled_av_latent"}], "flags": {}, "id": 15, "type": "RHMiniMaxH3DecodeAV", "title": "Decode Video + Audio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3DecodeAV"}, "order": 20}, {"mode": 0, "outputs": [{"name": "VIDEO", "slot_index": 0, "links": [18], "label": "VIDEO", "type": "VIDEO", "localized_name": "视频"}], "size": [300, 102], "pos": [5977.78271484375, 608.9436645507812], "widgets_values": [24, 8], "inputs": [{"name": "images", "link": 16, "label": "images", "type": "IMAGE", "localized_name": "图像"}, {"shape": 7, "name": "audio", "link": 17, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "fps"}, "name": "fps", "label": "fps", "type": "FLOAT", "localized_name": "帧率"}, {"widget": {"name": "bit_depth"}, "shape": 7, "name": "bit_depth", "label": "bit_depth", "type": "INT", "localized_name": "bit_depth"}], "flags": {}, "id": 16, "type": "CreateVideo", "properties": {"widget_ue_connectable": {"fps": true, "bit_depth": true}, "Node name for S&R": "CreateVideo"}, "order": 21}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [210, 552], "pos": [6307.50537109375, 610.1524047851562], "widgets_values": ["minimax_h3/ref2va_image", "mp4", "h264", "auto"], "inputs": [{"name": "video", "link": 18, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "编码器"}, {"widget": {"name": "codec.encoding"}, "shape": 7, "name": "codec.encoding", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "encoding"}], "flags": {}, "id": 17, "type": "SaveVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 22}, {"mode": 0, "outputs": [{"name": "output", "links": [9], "label": "output", "type": "*", "localized_name": "output"}], "size": [567.8825073242188, 657.5468139648438], "pos": [3184.4013671875, 591.0530395507812], "widgets_values": ["由于您提供的图片内容呈现出一种**极简主义（Minimalism）**、**工业风（Industrial）**与**运动数据可视化（Data Visualization）**的结合，这与之前的Y2K风格完全不同。\n\n为了匹配这张图片的视觉质感，我为您构建了一个全新的、充满**高级感**与**力量感**的视频分镜脚本。风格定位于**“现代极简运动风 (Modern Minimalist Sport)”**，强调高对比度、快速剪辑与数据流的动态感。\n\n---\n\n### **15秒 极简工业运动风视频分镜脚本**\n\n**【镜头 1】**\n* **时间段**：00:00 - 00:02（时长：2.0秒）\n* **景别**：大特写 (Extreme Close-up)\n* **镜头运动**：快速拉近 (Snap Zoom)\n* **画面风格**：硬核工业/数据感\n* **画面内容**：屏幕中心出现黑色的“RUNNING HUB”字样，背景是极速滚动的白色数字与坐标轴（模拟图片右侧的Data Block）。文字伴随轻微的震动感，仿佛被重力击中。\n* **光影色调**：纯黑背景，极高对比度的白/绿文字，冷峻的工业色调\n* **台词 (画面文字)**：\"RUNNING HUB\", \"SYSTEM ACTIVE\"\n* **音效配乐**：沉重的低音冲击声 (Cinematic Boom) + 快速的数据扫描音\n\n**【镜头 2】**\n* **时间段**：00:02 - 00:04（时长：2.0秒）\n* **景别**：中景 (Medium Shot)\n* **镜头运动**：侧向平移 (Pan)\n* **画面风格**：人物写实/高级感\n* **画面内容**：快速切入模特（图片左侧女性）的侧脸特写。她眼神坚定，皮肤质感清晰可见。画面边缘叠加半透明的绿色线条与“DISTANCE: 10.24KM”等动态数据流，仿佛她在进行实时监测。\n* **光影色调**：柔和但高对比度的自然光，强调人物轮廓，整体色调偏冷灰\n* **台词 (画面文字)**：\"FOCUS\", \"PERFORM\"\n* **音效配乐**：有节奏的呼吸声 + 快速的心跳声 (Heartbeat monitor)\n\n**【镜头 3】**\n* **时间段**：00:04 - 00:06（时长：2.0秒）\n* **景别**：远景 (Long Shot)\n* **镜头运动**：快速切片式跳剪 (Jump Cut)\n* **画面风格**：电影感景观\n* **画面内容**：画面切换为图片右侧07号位的景观图：一个孤独的奔跑者在荒凉的雾气景观中奔跑。画面呈现黑白灰的电影质感，通过快速切片处理，让动作看起来极具张力。\n* **光影色调**：黑白/灰阶，极低饱和度，雾气带来的朦胧感与奔跑者的清晰感形成对比\n* **台词 (画面文字)**：\"MOVE BEYOND LIMITS\"\n* **音效配乐**：风声掠过 + 沉稳的脚步踏地声\n\n**【镜头 4】**\n* **时间段**：00:06 - 00:08（时长：2.0秒）\n* **景别**：特写 (Close-up)\n* **镜头运动**：微距旋转 (Macro Rotation)\n* **画面风格**：纹理/细节感\n* **画面内容**：快速切换至图片右侧06号位的纹理图（Texture/Scan）。画面展示运动鞋底与地面摩擦产生的微小颗粒，或者皮肤上的汗水。画面上叠加快速闪过的“SCANNING...”字样。\n* **光影色调**：高对比度的颗粒感，强调材质的粗糙与真实\n* **台词 (画面文字)**：\"SCAN & ANALYZE\"\n* **音效配乐**：机械扫描的电子嗡鸣声 + 摩擦声\n\n**【镜头 5】**\n* **时间段**：00:08 - 00:11（时长：3.0秒）\n* **景别**：中特写 (Medium Close-up)\n* **镜头运动**：向后拉开 (Dolly Out)\n* **画面风格**：动态数据流\n* **画面内容**：模特再次出现，但这次是正面对着镜头，眼神直视观众。画面周围被无数绿色的“ENERGY/PACE/CADENCE”数据框环绕并快速跳动，营造出一种“超级人类/运动大脑”的视觉感。\n* **光影色调**：黑色背景，亮绿色数据流作为点缀，极具科技感\n* **台词 (画面文字)**：\"EVERY STEP COUNTS\", \"ACTIVE SYSTEM\"\n* **音效配乐**：节奏感极强的工业电子鼓点 (Industrial Techno) 逐渐推向高潮\n\n**【镜头 6】**\n* **时间段**：00:11 - 00:13（时长：2.0秒）\n* **景别**：全景 (Wide Shot)\n* **镜头运动**：快速闪烁切换 (Flicker Edit)\n* **画面风格**：快节奏剪辑\n* **画面内容**：将图片中的所有元素（数据、模特、景观、文字）进行0.1秒级别的超快速跳剪。给观众一种视觉过载的感觉，展示品牌的全貌。\n* **光影色调**：黑、白、绿的极致循环\n* **台词 (画面文字)**：\"RUN. FOCUS. PERFORM.\"\n* **音效配乐**：极快的鼓点 + 电子脉冲声\n\n**【镜头 7】**\n* **时间段**：00:13 - 00:15（时长：2.0秒）\n* **景别**：特写 (Close-up)\n* **镜头运动**：瞬间静止 (Instant Freeze)\n* **画面风格**：品牌定格\n* **画面内容**：屏幕瞬间变黑。中心出现洁白的“RUNNING HUB”Logo，下方是细小的绿色字样“SYSTEM ACTIVE”。背景隐约可见极其微弱的网格线。\n* **光影色调**：极简黑白，绿色作为唯一的视觉焦点\n* **台词 (画面文字)**：\"RUNNING HUB\", \"JOIN THE SYSTEM\"\n* **音效配乐**：音乐戛然而止，只留下一个深沉的低音回响 (Deep Echo)"], "inputs": [{"shape": 7, "name": "anything", "link": 19, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 18, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 17}, {"mode": 0, "outputs": [{"name": "output", "slot_index": 0, "links": [23], "label": "图像", "type": "*", "localized_name": "output"}], "size": [315, 102], "pos": [1836.4898681640625, 557.5262451171875], "widgets_values": ["right"