utputs": [{"name": "positive", "links": [259], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [260], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "size": [410, 510], "pos": [8167.5986328125, -1988.029052734375], "widgets_values": ["10秒、16:9横版第三人称动作游戏实机画面。银发女战士在雨中的废墟广场与一台双足机械守卫战斗，完成侧向闪避、快速反击和技能收尾。镜头始终位于角色后方偏右，动作反馈清晰。\n\n【画面过程说明】\n\n0–3秒：机械守卫挥动右臂横向攻击。女战士向左侧翻滚闪避，披风和银发跟随动作摆动。镜头保持第三人称跟随，不切换为电影镜头。\n\n3–7秒：女战士起身后连续挥剑两次，剑刃击中机械守卫腿部，出现少量金属火花和清晰碰撞声。右下角技能图标逐渐点亮。\n\n7–10秒：女战士释放一次蓝色弧形剑气，机械守卫向后退半步但不倒地。左上角玩家绿色生命条保持稳定，敌人红色生命条减少约三分之一。\n\n【禁止项】\n\n不得出现其他角色；HUD位置保持稳定；角色、武器和敌人结构不能变化；不出现血液、断肢、字幕和Logo；避免攻击穿透、瞬移、镜头乱转及生命条乱码。", 1344, 768, 73], "inputs": [{"name": "clip", "link": 256, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "vae", "link": 264, "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "first_frame", "link": 266, "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "link": 267, "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 265, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 261, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 262, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 263, "label": "length", "type": "INT", "localized_name": "length"}], "flags": {}, "id": 199, "type": "MiniMaxH3ImageToVideo", "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"width": true, "length": true, "height": true}, "Node name for S&R": "MiniMaxH3ImageToVideo"}, "order": 16}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [267], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "size": [270, 314], "pos": [8168.1572265625, -1229.617919921875], "widgets_values": ["example.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 201, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 10}, {"showAdvanced": false, "outputs": [{"name": "width", "links": [261], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [262], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#322", "widgets_values": ["9:16 (Portrait Widescreen)", 1, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "type": "ResolutionSelector", "title": "Resolution Selector (Size)", "mode": 0, "bgcolor": "#533", "size": [270, 170], "pos": [6850.7099609375, -2058.3359375], "id": 176, "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 11}, {"outputs": [{"name": "STRING", "links": [265], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#322", "widgets_values": ["请使用参考深度视频@视频1的运镜，人物动态\n人物设定图@image1和产品图@image2，生成一支 15 秒、9:16 竖屏、720P 的现代夏日轻运动饮料广告。人物与四套服装严格使用人物设定图，饮料与包装严格使用「文气·青柚乌龙气泡茶」产品图。\n\n整体为年轻、写实的 2026 亚洲运动时装广告。固定正面机位，人物始终位于画面中央；镜头、景别、动作、节奏、硬切、蒙版和道具运动方式与参考视频一致。主色为奶油白、浅玉绿、奶油黄、银色和炭灰，配合现代电子鼓点、轻快低频、开瓶声、气泡声和清脆运动音效。\n\n0—2 秒：\n奶油白影棚背景带浅玉绿运动光轨。@image人物穿白色不对称运动上衣、浅玉绿内搭和围裹式运动短裙，拿起产品，旋开瓶盖，再展开浅玉绿半透明运动毛巾扫过画面。加入开瓶声、气泡声和面料掠过声。\n\n2—4 秒：\n背景硬切为高饱和浅玉绿，中央出现巨大的白色瓶形运动跑道蒙版。人物在鼓点上快速切换侧身手扶腰、举瓶轻饮、转身回眸三个动作。\n\n4—6.5 秒：\n人物换成无袖拉链上衣、象牙白降落伞工装裤和银白跑鞋。周围漂浮透明运动计时牌、银色口哨、浅玉绿跑道标记与气泡贴纸，人物旋身举起产品。动态中文显示“轻装上线”。\n\n6.5—9 秒：\n人物换成白色透气网眼短上衣、象牙白及膝短裤、腰间系浅玉绿薄外套和绿白板鞋，挥动浅玉绿半透明运动毛巾。周围漂浮透明秒表、弧形跑道牌、银色速度线和绿白运动贴纸。动态中文显示“状态切换”。\n\n9—12 秒：\n人物换成浅玉绿无袖连帽风衣、白色背心、象牙白灯笼运动长裤和白色厚底运动鞋。背景为炭灰与浅玉绿，发光补水计时盘、液体折射弧线和白色运动鞋底纹剪影出现。人物腾空定格，中央蒙版收拢并变形成产品瓶。动态中文显示“清爽开场”。\n\n12—15 秒：\n人物与道具退场。产品居中完整展示，背景为浅玉绿渐变和银白圆形高光，瓶身带冷凝水珠和气泡。产品轻微旋转后正面定格，标签显示“文气”“青柚乌龙气泡茶”，收尾文案显示“灵感，有气泡”。\n\n全程保持同一人物@image1、年龄、短层次黑色短发、妆容和身体比例，四套服装不得混穿。产品不得变形、改标或出现多个瓶子。固定机位，不使用摇镜、手持抖动、快速推拉或环绕运镜。音乐和音效直接生成在视频中，不需要旁白。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#533", "size": [370, 390], "pos": [7171.61181640625, -1302.853515625], "id": 178, "properties": {"cnr_id": "comfy-core", "ver": "0.29.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 12}], "extra": {"links_added_by_ue": [], "KKvideo_latentpreview": false, "0246.VERSION": [0, 0, 4], "VHS_latentpreview": false, "ds": {"offset": [-6453.897322165684, 1911.7032206606502], "scale": 0.7972024500000008}, "VHS_KeepIntermediate": true, "xzgGroups": {}, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "pixaromaGroups": [], "codex_high_low_sigma": {"shift_audio": 3, "high_sampler": "euler", "shift_video": 12, "low_sampler": "res_multistep", "base_steps": 16, "low_sigma_extension": {"spacing": "cosine", "start": 0.8, "end": 0, "steps": 2}, "base_s