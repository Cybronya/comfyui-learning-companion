落地时左脚前迈、右膝点地半跪，左手撑地、右手向后扬起宽袖，头部微抬直视镜头，油纸伞暖光从右后方勾勒全身轮廓，地面水花在落点处向四周扩散定格。\n\n【禁止项】\n文字 / UI / 水印 / Logo / 角标 / 可读文字 / 真实 UI\n\n【强制声明】\n无背景音乐，仅保留环境音与人声和音效；画面禁字幕 / 文字 / 水印 / Logo; 禁止可读文字 (指画面字幕文字，不含人声台词)"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {"collapsed": false}, "type": "PrimitiveStringMultiline", "title": "统一输入｜Prompt / 提示词", "mode": 0, "bgcolor": "#533", "size": [368.1416015625, 437.387939453125], "pos": [763.0794677734375, -518.5277709960938], "id": 138, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 15}, {"outputs": [{"name": "FLOAT", "links": [8], "label": "FLOAT", "type": "FLOAT", "localized_name": "浮点"}], "color": "#322", "widgets_values": [10], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "值"}], "flags": {"collapsed": false}, "type": "PrimitiveFloat", "title": "统一输入｜Duration / 时长(s)", "mode": 0, "bgcolor": "#533", "size": [270, 70], "pos": [1156.7431640625, -309.5957336425781], "id": 132, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 16}, {"showAdvanced": false, "outputs": [{"name": "width", "links": [20], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [21], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#322", "widgets_values": ["2:3 (Portrait Photo)", 0.6000000000000001, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {"collapsed": false}, "type": "ResolutionSelector", "title"