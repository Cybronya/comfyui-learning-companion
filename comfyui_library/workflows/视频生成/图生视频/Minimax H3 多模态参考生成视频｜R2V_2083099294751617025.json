ame": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"shape": 7, "name": "video1", "label": "video1", "type": "VIDEO", "localized_name": "video1"}, {"shape": 7, "name": "video2", "label": "video2", "type": "VIDEO", "localized_name": "video2"}, {"shape": 7, "name": "video3", "label": "video3", "type": "VIDEO", "localized_name": "video3"}, {"shape": 7, "name": "audio1", "label": "audio1", "type": "AUDIO", "localized_name": "audio1"}, {"shape": 7, "name": "audio2", "label": "audio2", "type": "AUDIO", "localized_name": "audio2"}, {"shape": 7, "name": "audio3", "label": "audio3", "type": "AUDIO", "localized_name": "audio3"}, {"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "duration"}, "name": "duration", "label": "duration", "type": "COMBO", "localized_name": "duration"}, {"widget": {"name": "ratio"}, "shape": 7, "name": "ratio", "label": "ratio", "type": "COMBO", "localized_name": "ratio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_MinimaxHailuoH3MultimodalToVideo", "mode": 0, "bgcolor": "#653", "size": [445.4545593261719, 796.4628295898438], "pos": [341.8873596191406, 245.64266967773438], "id": 2, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_MinimaxHailuoH3MultimodalToVideo"}, "order": 5}, {"outputs": [{"name": "IMAGE", "links": [1], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "color": "#2a363b", "widgets_values": ["ba0862fd88e2095e3e4fdeb89ac9691dcf70a59107d67af60fd2a010b45c6fdd.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#3f5159", "size": [274.080078125, 314], "pos": [-135.28562927246094, -12.108671188354492], "id": 4, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}, {"mode": 0, "outputs": [], "size": [562.6074829101562, 752.3765258789062], "pos": [-1044.7254638671875, 120.17927551269531], "widgets_values": ["# MiniMax H3 Multimodal Reference to Video（多模态参考生成视频｜R2V）简介\n## 一、功能定义\nMultimodal Reference to Video 是 MiniMax H3（Hailuo-03）核心生成能力，区别于传统**单一图生视频(I2V)**、视频到视频(V2V)。\n它支持**一次性混合传入多类参考素材 + 文本提示词**，模型统一解析图像、短视频、音频多模态上下文，生成一段全新、时序连贯、自带原生双声道立体声的2K视频。\n不再将人物锁定、动作迁移、风格参考、音频匹配拆分为独立任务，单轮请求即可完成多条件约束生成。\n\n## 二、输入上限（官方标准）\n单次任务最多上传 **12份参考素材**\n- 参考图像：最多9张（锁定人物形象、场景、美术风格、角色五官一致性）\n- 参考视频：最多3段（迁移镜头语言、动作节奏、运镜方式、肢体运动）\n- 参考音频：最多3条（匹配音效韵律、人声音色、节奏节拍）\n> 硬性规则：**必须至少上传一张图片/一段视频；不可仅传入音频单独生成视频**。\n提示词最大支持7000字符，可以在Prompt内按序号引用对应参考素材，指定每个参考承担的作用。\n\n## 三、核心能力亮点\n1. **人物形象持续锁定（商用核心优势）**\n多张角色参考图输入，可长时间稳定保留五官、服饰、外形，大幅缓解人物漂移，适配口播带货、连续多镜头人物短片（可配合你LTX-2.3多镜头工作流串联素材）。\n\n2. **动作&镜头语言迁移**\n参考视频提供运镜、动作范式；参考图片固定角色；文本定义新场景。\n例：沿用参考视频的轨道推镜节奏，参考图人物，在全新科幻场景完成一套连贯动作。\n\n3. **音画原生协同生成**\n可参考音频的节奏、音色，AI自动同步画面动态；输出视频自带立体声，不需要分开生成画面与配音，天然适配口播、剧情短片。\n\n4. **灵活构图规格**\n时长区间：5～15秒；原生2K（1440p）直出，无后期硬超分；\n支持比例：21:9 /16:9 /1:1 /4:3 /3:4 /9:16竖屏短视频。\n\n5. **强指令遵循，擅长材质、文字、品牌LOGO渲染**\n相比多数视频模型，更容易实现清晰产品纹理、文字不扭曲，适合电商广告、品牌宣传片。\n\n## 四、典型使用范式（官网Demo逻辑）\n> Prompt示例模板：\n> 使用【图片1】的人物形象，沿用【视频1】缓慢向前推进的镜头运动；将场景更换为巨型宇宙星际传送门环境，人物保持静态剪影，雾气持续流动，动态渐变景深；音效跟随参考音频低频脉冲节奏。\n\n"], "inputs": [], "flags": {}, "id": 12, "type": "MarkdownNote", "properties": {}, "order": 4}, {"outputs": [], "color": "#fff0", "inputs": [], "flags": {"allow_interaction": true}, "type": "Label (rgthree)", "title": "Minimax H3 多模态参考生成视频｜R2V", "mode": 0, "bgcolor": "#fff0", "size": [1575.17578125, 90], "pos": [-37.74650955200195, -373.7333068847656], "id": 10, "properties": {"padding": 0, "backgroundColor": "transparent", "fontFamily": "Arial", "borderRadius": 0, "textAlign": "left", "widget_ue_connectable": {}, "fontSize": 90, "fontColor": "#ffffff"}, "order": 3}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1721.0774529028229, 546.9985508763693], "scale": 0.3186308177103567}}, "groups": [], "links": [[1, 4, 0, 2, 0, "IMAGE"], [3, 6, 0, 2, 2, "IMAGE"], [5, 7, 0, 2, 1, "IMAGE"], [6, 2, 0, 8, 0, "VIDEO"]], "id": "5f65642f-3a0e-4f1b-ba98-6bf7dad61d99", "config": {}, "version": 0.4, "last_node_id": 12, "revision": 0}