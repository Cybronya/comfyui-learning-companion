度曝光造成曝光过度，营造电影与情绪氛围感，同时因快门速度不足产生运动模糊，模拟随意抓拍效果，虽无清晰主体与明显构图，但尽显生活绚丽日常。保留轻微噪点，确保高光不过曝、阴影有细节，突出冷白皮通透自然的肌肤状态，展现美白透亮的皮肤。以大焦距特写，呈现如单反相机拍摄的高质量超高清图，让画面栩栩如生，充满唯美、慵懒松弛的独特韵味，以写实摄影风格，非商业修图手法，定格这充满故事感的瞬间。"], "inputs": [{"name": "h3_text_encoder", "link": 14, "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 5, "type": "RHMiniMaxH3T2VATextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3T2VATextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "av_latent", "links": [18], "label": "av_latent", "type": "MINIMAX_H3_AV_LATENT", "localized_name": "av_latent"}], "size": [303.4322204589844, 26], "pos": [648.3065185546875, 329.00726318359375], "widgets_values": [], "inputs": [{"name": "target", "link": 15, "label": "target", "type": "MINIMAX_H3_TARGET", "localized_name": "target"}], "flags": {}, "id": 6, "type": "RHMiniMaxH3EmptyAVLatent", "title": "Empty AV Latent", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3EmptyAVLatent"}, "order": 5}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "ds": {"offset": [-260.21558473589624, 39.62294000684664], "scale": 1.2839025177495011}}, "groups": [], "links": [[14, 1, 0, 5, 0, "MINIMAX_H3_TEXT_ENCODER"], [15, 4, 0, 6, 0, "MINIMAX_H3_TARGET"], [16, 2, 0, 7, 0, "MINIMAX_H3_DIRECT_MODEL"], [17, 5, 0, 7, 1, "MINIMAX_H3_CONDITIONING"], [18, 6, 0, 7, 2, "MINIMAX_H3_AV_LATENT"], [19, 3, 0, 8, 0, "MINIMAX_H3_VAE_BUNDLE"], [20, 7, 0, 8, 1, "MINIMAX_H3_AV_LATENT"], [21, 8, 0, 9, 0, "IMAGE"], [22, 8, 1, 9, 1, "AUDIO"], [23, 9, 0, 10, 0, "VIDEO"], [24, 10, 2, 11, 4, "FLOAT"], [25, 10, 0, 11, 0, "IMAGE"], [26, 10, 1, 11, 1, "AUDIO"]], "id": "00000000-0000-0000-0000-000000000000", "config": {}, "version": 0.4, "last_node_id": 11, "revision": 0}