散开扬起，光影在纱衣上流动\n8.4‑10 秒，定格收舞姿态，双臂轻轻落下，衣摆缓缓垂落，眼神沉静望向镜头，预留 0.6 秒完整收尾画面\n镜头剪辑规则：多镜头匹配硬切，全景‑中景‑近景交替切换，不做一镜到底，镜头跟随人物舞蹈运动，稳定运镜，无剧烈抖动\n视觉材质风格：电影级写实古风，PBR 布料材质，薄纱通透，面料带有细腻珠光银色反光，柔和伦勃朗侧光，景深虚化背景壁画，色调温润淡雅，电影质感，高细节人物面部，表情自然，口型无需匹配台词\n音效设计：古典轻柔古筝背景音乐，布料衣袖摩擦沙沙声，轻微裙摆扫过石地的环境音\n收尾完整结局：女子舞蹈结束，伫立原地，衣摆缓缓归于平静，仙气氛围感定格结束"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 51, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 6}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.48.6", "VHS_latentpreview": false, "ds": {"offset": [1272.468354761366, 34.574685100194046], "scale": 0.4500000000000007}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "H3 loaders + Turbo LoRA (EMA)", "bounding": [-357.9132385253906, -45.71015167236328, 868.9210815429688, 1158.0264892578125]}, {"color": "#3f9e64", "font_size": 24, "flags": {}, "id": 5, "title": "STABLE: video 4 / audio 4", "bounding": [522.0866088867188, -45.71015167236328, 441.745361328125, 1151.6319580078125]}, {"color": "#9e6d3f", "font_size": 24, "flags": {}, "id": 6, "title": "Decode + synchronized MP4", "bounding": [979.48974609375, -39.78032302856445, 524.9998779296875, 1134.2984619140625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 9, "title": "Group", "bounding": [-847.8258666992188, -41.67801284790039, 478.34222412109375, 1158.4302978515625]}], "links": [[57, 50, 0, 43, 0, "LATENT"], [58, 60, 0, 43, 1, "VAE"], [59, 57, 0, 43, 2, "VAE"], [60, 48, 0, 44, 0, "FLOAT,INT,BOOLEAN"], [61, 43, 0, 46, 0, "IMAGE"], [62, 43, 1, 46, 1, "AUDIO"], [63, 53, 0, 49, 0, "MODEL"], [64, 54, 0, 49, 1, "CONDITIONING"], [65, 42, 0, 50, 0, "NOISE"], [66, 49, 0, 50, 1, "GUIDER"], [67, 53, 1, 50,