401123046875], "widgets_values": ["32c0cf93da0321c0badd4c00bec87bdef1d12ae0325931af0d7a51af1fcf56f9.m4a", null, null], "inputs": [{"widget": {"name": "audio"}, "name": "audio", "label": "audio", "type": "COMBO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "AUDIOUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 6, "type": "LoadAudio", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadAudio"}, "order": 1}, {"mode": 0, "outputs": [{"name": "VIDEO", "slot_index": 0, "links": [8], "label": "VIDEO", "type": "VIDEO", "localized_name": "视频"}], "size": [300, 102], "pos": [1747.1029052734375, 93.64569091796875], "widgets_values": [24, 8], "inputs": [{"name": "images", "link": 6, "label": "images", "type": "IMAGE", "localized_name": "图像"}, {"shape": 7, "name": "audio", "link": 7, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "fps"}, "name": "fps", "label": "fps", "type": "FLOAT", "localized_name": "帧率"}, {"widget": {"name": "bit_depth"}, "shape": 7, "name": "bit_depth", "label": "bit_depth", "type": "INT", "localized_name": "bit_depth"}], "flags": {}, "id": 13, "type": "CreateVideo", "properties": {"widget_ue_connectable": {"fps": true, "bit_depth": true}, "Node name for S&R": "CreateVideo"}, "order": 12}, {"mode": 0, "outputs": [{"name": "conditioning", "slot_index": 0, "links": [16], "label": "conditioning", "type": "MINIMAX_H3_CONDITIONING", "localized_name": "conditioning"}], "size": [495.7996826171875, 345.27203369140625], "pos": [461.6219482421875, 576.1199340820312], "widgets_values": ["视频时长：10秒，4K高清，商业广告级真实摄影风格\n\n基于原始图片生成视频，严格保持原始人物身份一致：\n人物脸部五官、面部轮廓、肤色、年龄特征、发型、服装、西装颜色、配饰完全不变，不进行任何美化、换脸、瘦脸、磨皮或AI重塑。保持真实人物摄影效果。\n\n保持原始浴室环境完全一致：\n浴室空间布局、墙面材质、灯光环境、白色巨晴摩雅水疗设备的位置、尺寸、比例、结构细节全部保持不变，不移动、不改变设备外观。\n\n### 镜头设计：\n0‑2秒：保持原始图片构图开始。人物自然站立于浴室内，身体微微朝向设备方向，保持45度面对镜头姿态。人物表情生动自然，全程带轻微微笑，眼神自信看向镜头。右手保持原自然姿态，左手缓慢抬起并自然伸直，手掌打开，五指自然展开，精准指向墙上的白色巨晴摩雅水疗设备。手掌不遮挡设备主体，动作缓慢优雅。\n\n2‑10秒：镜头开始缓慢向水疗设备方向推进。稳定推进，轻微景深变化；人物与设备始终保持清晰；突出设备高级材质和科技感。人物保持自然讲解状态，看向镜头，嘴型跟随中文语音微动。\n\n### 人物表演要求：\n人物表情随口播内容轻微变化，不是固定面瘫微笑。说话时眼神有自然聚焦，轻微点头，眉峰随语气有细微起伏，嘴角保持放松上扬，像真实高端品牌顾问在亲切、自信、专业地介绍产品。\n人物面部肌肉有轻微自然动态，说话时嘴角、眼神、眉峰有细微变化，像真实人在说话，而不是AI照片在动。\n\n说到“臭氧净化水质”时，眼神更坚定，轻微点头；\n说到“远红外促进循环恢复”时，表情更专业沉稳；\n说到“搭配精油浴盐”时，语气更亲和，嘴角微笑更明显；\n说到“打造专属健康水疗体验”时，自然点头，眼神更有信任感。\n\n动作幅度克制，表情自然，不夸张，不做大幅度手势，不改变人物身份特征。\n\n### 语音设定\n口播台词：“这款巨晴水疗设备，臭氧净化水质，远红外促进循环恢复，搭配精油浴盐，打造专属健康水疗体验。”\n\n标准流利普通话，每个汉字咬字清晰完整，无吞字，音节不重叠，专业沉稳品牌顾问男声，语速适中，人声干净，语气亲切但高级。\n\n画面风格：真实摄影质感，高端商业广告风格，奢华浴室空间氛围，自然柔和灯光，真实材质反射，高清4K，电影级镜头运动，稳定运镜，高级品牌宣传片效果。\n\n负面提示词：\n不要改变人物身份，不要改变脸型五官，不要换发型，不要改变西装颜色，不要增加饰品，不要修改浴室布局，不要移动水疗设备，不要改变设备尺寸比例，不要遮挡设备，不要出现额外人物，不要卡通化，不要AI塑料脸，不要过度磨皮，不要夸张表情，不要快速动作，不要手指畸形，不要嘴型错误，不要中文字幕，不要水印，不要低清晰度，不要失真变形，普通话发音错乱，音节挤压，吞字，日语口音，含糊不清，口齿不清，面瘫脸，无表情，僵硬微笑，机械说话", "match"], "inputs": [{"name": "h3_text_encoder", "link": 11, "label": "h3_text_encoder", "type": "MINIMAX_H3_TEXT_ENCODER", "localized_name": "h3_text_encoder"}, {"name": "h3_vae_bundle", "link": 12, "label": "h3_vae_bundle", "type": "MINIMAX_H3_VAE_BUNDLE", "localized_name": "h3_vae_bundle"}, {"name": "target", "link": 13, "label": "target", "type": "MINIMAX_H3_TARGET", "localized_name": "target"}, {"name": "references", "link": 10, "label": "references", "type": "MINIMAX_H3_REFERENCES", "localized_name": "references"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "ref_image_size"}, "shape": 7, "name": "ref_image_size", "label": "ref_image_size", "type": "COMBO", "localized_name": "ref_image_size"}], "flags": {}, "id": 9, "type": "RHMiniMaxH3Ref2VAEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RHMiniMaxH3Ref2VAEncode"}, "order": 8}, {"mode": 0, "outputs": [{"name": "target", "slot_index": 0, "links": [13, 14], "label": "target", "type": "MIN