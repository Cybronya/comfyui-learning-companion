idget_ue_connectable": {"fps": true, "bit_depth": true}, "runninghub_builder": {"api_widget_names": ["fps", "bit_depth"], "widget_names": ["fps", "bit_depth"]}, "Node name for S&R": "CreateVideo"}, "order": 20}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [406.96978759765625, 572], "pos": [5222.0732421875, 325.66192626953125], "widgets_values": ["minimax_h3/minimax-h3-ai-polished-couple-microdrama-15s", "mp4", "h264", "auto"], "inputs": [{"name": "video", "link": 17, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "编码器"}, {"widget": {"name": "codec.encoding"}, "shape": 7, "name": "codec.encoding", "label": "codec.encoding", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "encoding"}], "flags": {}, "id": 14, "type": "SaveVideo", "title": "02 保存 MP4/H.264 视频", "properties": {"widget_ue_connectable": {}, "runninghub_builder": {"api_widget_names": ["filename_prefix", "format", "codec"], "widget_names": ["filename_prefix", "format", "codec"]}, "Node name for S&R": "SaveVideo"}, "order": 21}, {"outputs": [{"name": "STRING", "links": [18], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#5e2f78", "widgets_values": ["你是 MiniMax H3 双角色原生有声微短剧导演。请把用户很简单的一句话剧情和可选的“对白与风格”润色为可直接送入 H3 Ref2VA 的完整导演提示词。\n\n固定映射：<Picture 1> 是年轻成年女性，定义为 <Subject 1>、女友、全局说话人 S1；<Picture 2> 是年轻成年男性，定义为 <Subject 2>、男友、全局说话人 S2。两人是明确成年的年轻情侣。始终保留两张参考图中的真实脸部、发型、服装、体型和身份；不得互换身份、换装、复制脸或增加第三个人。\n\n必须输出且只输出以下六个英文小节，顺序与拼写完全一致：\nsubject_definitions:\nsummary:\nretention_analysis:\ndetailed_description:\noverall_soundscape:\nnon_diegetic_music:\n\n编写规则：\n1. 总时长严格为 15 秒，竖屏 9:16，恰好 3 个镜头；使用清晰时间点衔接，故事在 15 秒内完成起因、误会或推进、反转与收尾。\n2. 画面、动作、机位、灯光和环境声用简洁英文描述；所有中文对白必须逐句写成 <d>[Chinese] 对白</d>。如果用户写了准确对白，逐字保留；如果用户只给剧情，自动代写 2 至 4 句自然、短促、可在 15 秒内说完的中文对白。\n3. 每句对白前后明确说话人 S1 或 S2；说话者开口时，另一人的嘴保持闭合；对白不重叠。保持屏幕方向、视线与空间连续。\n4. 只使用用户给出的剧情事实；可补充中性的镜头、表演、光线、音效与合理场景细节，不得擅自增加品牌、商品参数、身份、旁白或新角色。\n5. 默认真实电影摄影、自然表演、清晰人脸与克制镜头运动。明确禁止字幕、标题、可见文字、Logo、水印、伪文字、身份交换、重复人物和额外路人。\n6. overall_soundscape 要写连续环境声、贴近人物的清晰对白和不重叠规则；non_diegetic_music 默认写 restrained light romantic comedy underscore，如用户要求无配乐则写 N/A。\n7. 不要输出解释、Markdown 代码块、提示语、分析过程或六个小节以外的任何内容。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "02 内置导演规则", "mode": 0, "bgcolor": "#22102d", "size": [520, 820], "pos": [1432.21435546875, 386.29510498046875], "id": 17, "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 8}, {"outputs": [], "color": "#432", "widgets_values": ["视频超分工作流\nhttps://www.runninghub.cn/post/2085551958399741953"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [429.7632751464844, 222.81936645507812], "pos": [5218.5771484375, 963.0422973632812], "id": 22, "properties": {}, "order": 9}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "runninghub_builder": {"function_label": "Qwen3-VL AI提示词润色＋双角色原生有声微短剧", "reference_order": ["01:image:02_角色图｜年轻成年女友.png", "02:image:03_角色图｜年轻成年男友.png"], "builder_version": "4.0", "platform_verified": false, "dependencies": [{"role": "minimax_h3_plugin", "kind": "custom_node", "name": "HM-RunningHub/ComfyUI_RH_MinMaxH3@89d3a0222aff3a88df5d7ac3e4faedfcb967187a", "source": "runninghub_template", "resolved": true}, {"role": "model.model_root", "kind": "model_package", "nam