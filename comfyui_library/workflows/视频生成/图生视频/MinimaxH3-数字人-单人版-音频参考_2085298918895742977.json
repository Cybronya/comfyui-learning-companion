_name": "ref_audio_1"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 279, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 276, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 277, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "length"}, "name": "length", "link": 275, "label": "length", "type": "INT", "localized_name": "length"}, {"widget": {"name": "ref_image_size"}, "name": "ref_image_size", "label": "ref_image_size", "type": "COMBO", "localized_name": "ref_image_size"}, {"shape": 7, "name": "ref_audios.ref_audio_2", "label": "ref_audios.ref_audio_2", "type": "AUDIO", "localized_name": "ref_audio_2"}], "flags": {}, "type": "MiniMaxH3ReferenceToVideo", "mode": 0, "bgcolor": "#355", "size": [410, 384], "pos": [1648.9852294921875, 724.564697265625], "id": 136, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {"width": true, "length": true, "prompt": true, "height": true}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {"width": true, "length": true, "prompt": true, "height": true}, "Node name for S&R": "MiniMaxH3ReferenceToVideo"}, "order": 20}, {"outputs": [], "color": "#432", "widgets_values": ["| megapixels | Aspect | Output (multiple=32) |\n|---|---|---|\n| 0.2 | 16:9 | 608 x 352 |\n| 0.3 | 16:9 | 736 x 416 |\n| 0.4 | 16:9 | 864 x 480 |\n| 0.5 | 16:9 | 960 x 544 |\n| 0.6 | 16:9 | 1056 x 608 |\n| 0.7 | 16:9 | 1152 x 640 |\n| 0.8 | 16:9 | 1216 x 672 |\n| 0.9 | 16:9 | 1280 x 736 |\n| 0.98 | 16:9 | 1344 x 768 |\n| 1.0 | 16:9 | 1376 x 768 |\n| 1.2 | 16:9 | 1504 x 832 |\n| 1.5 | 16:9 | 1664 x 928 |\n| 1.8 | 16:9 | 1824 x 1024 |\n| 2.0 | 16:9 | 1920 x 1088 |\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: Size Settings Reference", "mode": 0, "bgcolor": "#653", "size": [300, 520], "pos": [-1567.62548828125, 644.0042724609375], "id": 140, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}}, "order": 8}, {"outputs": [], "color": "#432", "widgets_values": ["## Exact source-audio path\n\n1. The same **Load Audio** output feeds MiniMax **ref_audio_0** and **VRGDG MiniMax H3 Audio Drive**.\n2. Prompt with the exact tags: <Picture 1> and <Audio 1> (for example: <Picture 1> sings and lip-syncs exactly to <Audio 1>).\n3. The purple node locks the encoded audio latent while the sampler generates video.\n4. Its **original_audio** output goes directly to every final video combine node. H3's decoded/generated audio is intentionally not used.\n5. Keep the Duration value matched to the selected audio clip. Video Combine has **trim_to_audio** enabled as a final safeguard.\n\n同一份音频输入要同时喂给两个地方\nLoad Audio 读进来的同一个音频文件\n一路给 MiniMax 的 ref_audio_0\n一路给 VRGDG MiniMax H3 Audio Drive\n意思是：参考音频和驱动音频必须一致，不能分成两份不同音源。\n\n提示词里必须用精确标签\n要写成 <Picture 1> 和 <Audio 1>\n例如：<Picture 1> sings and lip-syncs exactly to <Audio 1>\n意思是：模型要明确知道“第1张图”对应“第1段音频”，而且要按这个标签绑定。\n\n紫色节点是在锁定音频潜变量\n你可以理解成：它把“音频特征”固定住\n这样采样生成视频时，视频会跟着这段音频走，不会乱跑\n“紫色节点”通常就是工作流里负责音频驱动/约束的关键节点。\n\n最终合成视频时，直接用原始音频\noriginal_audio 要直接接到所有最终的 Video Combine 节点\n不要用 H3 解码后或生成出来的音频\n意思是：最终成片里保留你最开始那条音频，避免嘴型和声音不一致。\n\n时长要和音频匹配\nDuration 要和选中的音频长度一致\nVideo Combine 勾上 trim_to_audio\n意思是：就算视频稍微长一点，最后也会按音频长度裁掉，防止多出空白段。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [798.935546875, 768.434326171875], "pos": [-2413.925048828125, 646.29541015625], "id": 195, "properties": {}, "order": 1}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.47.12", "VHS_latentpreview": true, "ds": {"offset": [2227.1964591133546, 1487.9674786609414], "scale": 0.3719008264462821}}, "groups": [{