，烛火燃烧时的轻微爆裂声。\n\nnon_diegetic_music: 古琴与箫的合奏，慢板，旋律悠扬婉转，以五声音阶铺陈出古典东方浪漫氛围，弦乐组在两人对视时渐强推向一个小高潮后缓缓收尾。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {"disabled": false}, "id": 24, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 8}, {"mode": 0, "outputs": [{"name": "av_latent", "links": [35], "label": "av_latent", "type": "LATENT", "localized_name": "av_latent"}, {"name": "width", "links": [90], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [89], "label": "height", "type": "INT", "localized_name": "height"}, {"name": "report_json", "label": "report_json", "type": "STRING", "localized_name": "report_json"}], "size": [337.1675720214844, 387.63153076171875], "pos": [5147.53369140625, 859.1087036132812], "widgets_values": ["minimax_h3_latent_upscaler_3d_fp16.safetensors", "scale_by", 1.5000000000000002, 1, 1280, 704, "preserve_source", 1.05, "fp16", "offload_after"], "inputs": [{"name": "av_latent", "link": 34, "label": "av_latent", "type": "LATENT", "localized_name": "av_latent"}, {"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "size_mode"}, "name": "size_mode", "label": "size_mode", "type": "COMBO", "localized_name": "size_mode"}, {"widget": {"name": "scale_by"}, "name": "scale_by", "label": "scale_by", "type": "FLOAT", "localized_name": "scale_by"}, {"widget": {"name": "target_megapixels"}, "name": "target_megapixels", "label": "target_megapixels", "type": "FLOAT", "localized_name": "target_megapixels"}, {"widget": {"name": "target_width"}, "name": "target_width", "label": "target_width", "type": "INT", "localized_name": "target_width"}, {"widget": {"name": "target_height"}, "name": "target_height", "label": "target_height", "type": "INT", "localized_name": "target_height"}, {"widget": {"name