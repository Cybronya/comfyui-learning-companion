ties": {"widget_ue_connectable": {}, "Node name for S&R": "GetImageSize"}, "order": 14}, {"mode": 0, "outputs": [{"name": "video_url", "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}], "size": [210, 180], "pos": [2424.204345703125, 4928.61279296875], "widgets_values": ["video/MiniMax_H3", "auto", "auto"], "inputs": [{"name": "video", "link": 259, "label": "video", "type": "VIDEO", "localized_name": "视频"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMBO", "localized_name": "格式"}, {"widget": {"name": "codec"}, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "编码器"}], "flags": {}, "id": 92, "type": "SaveVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 26}, {"mode": 0, "outputs": [{"name": "positive", "links": [238], "label": "positive", "type": "CONDITIONING", "localized_name": "positive"}, {"name": "LATENT", "links": [236], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "size": [430, 550], "pos": [540, 4760], "widgets_values": ["以海报为唯一首帧，制作15秒高动态国潮科技对决片头，16:9；锁定T8的脸、发冠、墨绿长袍、折扇与单人身份，锁定全部文字、数字和排版。0—2秒从旧纸网点微距开始，镜头伴随低频脉冲高速拉远，左右多模态引擎同时通电，中央“VS”被点燃。2—5秒甩镜至左侧H3，红蓝光流化为文字纸页、图像画框、电影胶片和立体声波，围绕引擎高速旋转；“2K、15秒、原生立体声”只做描边发光。5—8秒T8猛然展开折扇，扇风形成圆形冲击波，镜头借扇面遮挡穿越VS，红绿粒子在身后剧烈碰撞。8—11秒进入右侧FLUX 3 DEV引擎，图像帧、视频胶片、同步声波和机械行动箭头从传送门涌出，卷成具有重量感的螺旋轨道；“最长20秒、原生音频、EARLY ACCESS”始终清晰。11—13秒高速绕T8半圈，两股能量各占半屏，衣摆、发梢、折扇受风摆动，脸和手指稳定。13—15秒镜头急升俯拍再俯冲回正面，两块开放权重信息牌同时重击落位，底部问题横幅被朱红油墨扫亮，放射线爆开，海报归位定格。配乐为150BPM无主唱史诗国风电子：战鼓、失真贝斯、铜管、琵琶扫弦、合成器上升音；音效包含机器启动、电流、胶片掠过、声波、折扇破风、能量碰撞、印章重击和低频刹停。全程无台词、旁白、歌词、吟唱和口型；无第二人物、Logo、水印、新文字或胜负排名，不改数值，避免人物漂移、文字融化和无意义抖动。", 1344, 768, 73], "inputs": [{"name": "clip", "link": 241, "label": "clip", "type": "CLIP", "localiz