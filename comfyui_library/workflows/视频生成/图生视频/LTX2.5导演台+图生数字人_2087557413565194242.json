 "type": "LATENT", "localized_name": "video_latent"}, {"name": "audio_latent", "links": [455], "label": "audio_latent", "type": "LATENT", "localized_name": "audio_latent"}, {"name": "guide_data", "links": [428], "label": "guide_data", "type": "GUIDE_DATA", "localized_name": "guide_data"}, {"name": "motion_guide_data", "links": [429], "label": "motion_guide_data", "type": "MOTION_GUIDE_DATA", "localized_name": "motion_guide_data"}, {"name": "frame_rate", "links": [439, 465], "label": "frame_rate", "type": "FLOAT", "localized_name": "frame_rate"}, {"name": "combined_audio", "label": "combined_audio", "type": "AUDIO", "localized_name": "combined_audio"}], "color": "#2a363b", "widgets_values": [0, 30, 30, 0, 720, 720, "{\"mainTrackEnabled\":true,\"audioTrackEnabled\":true,\"motionTrackEnabled\":true,\"propHeight\":309,\"globalPropHeight\":176,\"showFilenames\":true,\"manualOutputRange\":false,\"useICVideoSize\":false,\"overrideAudio\":false,\"inpaint_audio\":true,\"global_prompt\":\"女孩在深情歌唱\",\"retake_global_prompt\":\"\",\"retakeMode\":false,\"retakeStart\":24,\"retakeLength\":48,\"retakePrompt\":\"\",\"retakeStrength\":1,\"retakeVideo\":null,\"normalStartFrame\":0,\"normalDurationFrames\":720,\"segments\":[{\"id\":\"1786547692040x3ill\",\"start\":0,\"length\":720,\"prompt\":\"女孩在唱歌，姿态优雅，表情温婉\\n\\n0-4s｜静启：半身近景，柔光侧逆光，浅米纯色干净背景。少女微微垂眸，指尖轻抵下颌，眼帘轻颤，呼吸放缓，酝酿情绪，唇角微松，安静入歌，神情沉静温婉\\n4-12s｜主歌演唱：头部微微轻侧，下颌柔和微抬，眼神微微抬起，目光悠远放空，似入禅意意境；唇瓣随歌词轻柔开合，咬字舒缓，眉眼松弛，眉峰柔和微垂，眼尾轻落淡淡的柔绪，没有夸张表情，只有内敛清愁温柔感；搭在下巴的手轻轻虚托，手肘微收，肩颈柔和舒展，一字肩针织随细微呼吸轻动，发丝随微弱气流轻轻晃动\\n12-20s｜情绪递进：视线轻轻回落，眼帘半敛，睫毛轻垂，唇放缓收音，面颊淡腮红衬得温润，唇角含一丝浅淡释然浅笑；头部极慢轻轻颔首，指尖缓缓从下颌松开，手臂小幅轻放，体态松弛安静，余韵绵长，氛围感清雅国风禅意\\n20–25s｜渐生释然：下颌轻收，眼帘半敛，长睫垂落遮住部分瞳孔，唇瓣放缓收音。短暂一瞬柔和看向镜头，随即视线轻轻下移，眼尾微微弯起，面部肌肉松弛，唇角慢慢漾开极淡的释然浅笑，不夸张，不露齿。头部极缓慢轻点颔首。微风趋于轻柔，仅刘海碎发微微浮动。整体氛围从淡淡清愁转为温柔释然。\\n表情关键词： 半垂眼帘，短暂望镜头，眼尾微弯，淡释然浅笑\\n姿势关键词： 轻颔首，体态稳静，肩颈放松下沉\\n动态关键词： 刘海微浮，头部轻颔首，情绪柔和\\n25–30s｜余韵留白：尾音缓缓消散，唇轻轻闭合，笑意浅浅留在唇角，眼眸温柔低垂，然后睁眼看向镜头浅笑。保持安静沉静姿态，手轻搭下颌侧边，上半身缓缓回正。微风渐弱，发丝微动渐停。画面安静下来，人物浅笑，留下清雅禅意的余韵。\\n表情关键词： 浅笑留存，垂眸