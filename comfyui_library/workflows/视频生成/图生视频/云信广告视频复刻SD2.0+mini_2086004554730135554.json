stom_width"}, "name": "custom_width", "label": "custom_width", "type": "INT", "localized_name": "custom_width"}, {"widget": {"name": "custom_height"}, "name": "custom_height", "label": "custom_height", "type": "INT", "localized_name": "custom_height"}, {"widget": {"name": "frame_load_cap"}, "name": "frame_load_cap", "label": "frame_load_cap", "type": "INT", "localized_name": "帧数读取上限"}, {"widget": {"name": "skip_first_frames"}, "name": "skip_first_frames", "label": "skip_first_frames", "type": "INT", "localized_name": "跳过前X帧"}, {"widget": {"name": "select_every_nth"}, "name": "select_every_nth", "label": "select_every_nth", "type": "INT", "localized_name": "模选"}, {"widget": {"name": "format"}, "shape": 7, "name": "format", "label": "format", "type": "COMBO", "localized_name": "format"}], "flags": {}, "id": 55, "type": "VHS_LoadVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VHS_LoadVideo"}, "order": 4}, {"outputs": [], "color": "#432", "widgets_values": ["节点识别与基础参数解读\n\n该节点为 **ComfyUI RH插件封装的Seedance 2.0（即梦2.0）多模态图生视频调用节点**\n## 1. 输入端口\n|端口分组|端口明细|作用说明|\n| ---- | ---- | ---- |\n|图像输入|image1~image9|支持最多9张参考底图，对应分镜分段底图传入，`conversionSlots=all`会全部读取生效|\n|音视频资源|video1~video3、audio1~audio3|可导入参考视频/音频做动作、音色参考，本次audio1为激活接入状态|\n|配置项|api_config|存放即梦2.0接口密钥、接口地址等鉴权配置|\n|文本输入|prompt|填写我们之前编写的**即梦2.0合成总提示词**（三段镜头合并完整prompt）|\n\n\n\n-----\n\n## 2. 已固化运行参数（当前配置）\n|参数|数值|参数释义&适配我们仙侠MV方案说明|\n| ---- | ---- | ---- |\n|resolution|720p|输出视频分辨率，720p满足线上预览，商用可改为1080p|\n|duration|15|视频总时长15s，完全匹配本次三段式镜头总时长|\n|generateAudio|false|关闭AI自动生成音频，外部接入自备古风BGM+环境音效，符合我们无内置配音的需求|\n|ratio|9:16|竖屏画幅，适配短视频MV分发|\n|realPersonMode|true|开启真人写实保真模式，锁定人物五官、汉服形象不畸变，保证全程人脸/造型统一|\n|conversionSlots|all|全部传入的image图片都会参与视频生成，适配分镜多底图分段生成逻辑|\n|returnLastFrame|false|不单独返回视频末帧图片|\n|seed|123|固定随机种子，锁定画面画风、人物长相不变，多轮重绘画面不会跑偏|\n|control_after_generate|fixed|种子固定不变，每次运行使用同一个seed数值|\n|skip_error|false|关闭错误自动跳过，报错直接终止运行便于排查问题|\n---\n## 3. 输出端口\n- video：输出生成后的视频数据流\n- url：返回云端生成视频的在线访问链接\n- response：接口完整返回日志，用于排查报错、查看计费、渲染状态"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Markdown Note（RH Seedance 2.0 Mini Multimodal Video）", "mode": 4, "bgcolor": "#653", "size": [481.3197937011719, 888.4747314453125], "pos": [2229.748779296875, -483.2330322265625], "id": 51, "properties": {"widget_ue_connectable": {}}, "order": 5}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#ffb9d7", "size": [590.3021240234375, 58], "color": "#ffcdeb", "pos": [1630.6529541015625, -703.1925048828125], "inputs": [], "flags": {}, "id": 10, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "RH Seedance 2.0 Mini Multimodal Video", "showNav": true, "toggleRestriction": "default"}, "order": 6}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#ffb9d7", "size": [550.2425537109375, 58], "color": "#ffcdeb", "pos": [1661.6109619140625, 1134.8140869140625], "inputs": [], "flags": {}, "id": 11, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "RH Seedance2.0 Multimodal Video", "showNav": true, "toggleRestriction": "default"}, "order": 7}, {"outputs": [{"name": "video", "links": [32], "label": "video", "type": "VIDEO", "localized_name": "video"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#432", "widgets_values": ["", "480p", "15", true, "16:9", false, 355551121, "randomize", true, "all", false], "inputs": [{"shape": 7, "name": "image1", "link": 41, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 47, "