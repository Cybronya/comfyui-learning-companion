，构图、光影、场景、视角与原图保持一致，仅改表情：中景拍摄+愤怒：它眼睛上方的两个特征性白色椭圆圆点急剧向下向内倾斜，紧紧皱在一起以示愤怒，眼周肌肉收紧显怒意，嘴唇紧绷呈直线状，8K\n...（共6条）"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 32, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 7}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-1703.9751824273003, -556.920396592882], "scale": 0.45}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "模特图", "bounding": [1377.192626953125, 1267.932861328125, 473.5458984375, 865.1266479492188]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "Group", "bounding": [2938.389892578125, 1256.3438720703125, 2321.6982421875, 1791.3583984375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "放大", "bounding": [5665.42041015625, 1280.6202392578125, 1063.673095703125, 688.5311279296875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "最终", "bounding": [1891.9449462890625, 1254.30517578125, 1022.8529052734375, 1800.09619140625]}], "links": [[1, 2, 0, 1, 0, "IMAGE"], [2, 7, 0, 2, 0, "LATENT"], [3, 13, 0, 2, 1, "VAE"], [4, 5, 0, 3, 0, "UPSCALE_MODEL"], [5, 9, 0, 3, 1, "IMAGE"], [6, 8, 0, 4, 0, "IMAGE"], [7, 13, 0, 4, 1, "VAE"], [8, 10, 0, 7, 0, "MODEL"], [9, 28, 0, 7, 1, "CONDITIONING"], [10, 21, 0, 7, 2, "CONDITIONING"], [11, 4, 0, 7, 3, "LATENT"], [12, 3, 0, 8, 0, "IMAGE"], [13, 14, 0, 9, 0, "LATENT"], [14, 13, 0, 9, 1, "VAE"], [15, 11, 0, 10, 0, "MODEL"], [16, 16, 0, 11, 0, "MODEL"], [17, 10, 0, 14, 0, "MODEL"], [18, 28, 0, 14, 1, "CONDITIONING"], [19, 21, 0, 14, 2, "CONDITIONING"], [20, 26, 0, 14, 3, "LATENT"], [21, 12, 0, 15, 0, "MODEL"], [22, 18, 0, 16, 0, "MODEL"], [23, 15, 0, 17, 0, "M