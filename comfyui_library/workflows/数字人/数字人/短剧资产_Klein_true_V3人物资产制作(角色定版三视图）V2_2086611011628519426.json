*：背景设置为干净的纯白色画布。使用均匀柔和的摄影棚灯光照明，旨在清晰展示模型细节，避免产生生硬或杂乱的阴影。\n4. **风格**：保持高保真的写实摄影质感。"], "inputs": [{"name": "clip", "link": 128, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#3f7cac", "size": [365.9390563964844, 304.8465576171875], "pos": [3752.100830078125, 2293.282470703125], "id": 99, "properties": {"cnr_id": "comfy-core", "ver": "0.28.2", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 14}, {"outputs": [{"name": "image_urls", "links": [], "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [114], "label": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#0b161e", "widgets_values": [], "inputs": [{"name": "images", "link": 121, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#3f7cac", "size": [506.52496337890625, 454.829345703125], "pos": [5251.41064453125, 1626.5120849609375], "id": 95, "properties": {"cnr_id": "comfy-core", "ver": "0.28.3", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 38}, {"outputs": [{"name": "image_urls", "links": [], "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [111], "label": "images", "type": "IMAGE", "localized_name": "images"}], "color": "#0b161e", "widgets_values": [], "inputs": [{"name": "images", "link": 113, "label": "images", "type": "IMAGE", "localized_name": "images"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#3f7cac", "size": [270.3934631347656, 299.20538330078