puts": [{"name": "text", "links": [143], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["[Intro]\nYeah—\n从小镇出来的打工人\n2026\n不靠运气 靠执行\n\n[Verse 1]\n从出租屋的清晨 到写字楼电梯口\n咖啡当作燃料 把困意全带走\n别人谈背景 我谈 KPI 够不够\n银行卡余额 是我唯一的对手\n\n加班到凌晨 霓虹还在闪\n会议室灯光 亮过月光晚\n方案改到第三版 第四版\n没人给我捷径 只能自己闯关\n\n职场不是试卷 却更残酷\n没人给标准答案 只有算数\n绩效表像战书 一页页记录\n工资到账 才算真正进步\n\n小镇出身 没有退路\n没资源 就把时间压缩成速度\n你说命运 我说态度\n每一次努力 都算数\n\n[Hook]\n2026 我要翻盘\n马上有钱 不是空谈\n心诚则灵 但更靠实干\n一单一单 把未来点燃\n\n2026 不再平凡\n野心写进时间表上\n福报不是许愿的光\n是我拼命换来的账\n\n[Verse 2]\n别人周末旅行 我在做复盘\n别人聊理想 我在算资产\n不是不浪漫 是现实太宽\n要站稳脚跟 先学会硬扛\n\n项目压顶 也得笑着接\n压力来袭 也不能退\n升职加薪 不靠感觉\n靠执行力 一步步堆\n\n合同签下 那一刻安静\n奖金到账 才算回应\n心诚则灵 不是迷信\n是你真的 拼到极限才会应\n\n[Hook]\n2026 我要翻盘\n马上有钱 不是空谈\n心诚则灵 但更靠实干\n一单一单 把未来点燃\n\n2026 不再平凡\n野心写进时间表上\n福报不是许愿的光\n是我拼命换来的账\n\n[Bridge]\n没人天生站在高峰\n没人能替你冲锋\n职场就是修行的路程\n汗水才配叫成功\n\n[Outro]\n从小镇 到城市中央\n从新人 到独当一方\n2026 不再观望\n我要把名字 写在账上\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#335", "size": [378.67864990234375, 378.5122985839844], "pos": [360, 5570], "id": 66, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 5}, {"outputs": [{"name": "lyrics", "links": [148], "label": "lyrics", "type": "STRING", "localized_name": "lyrics"}], "color": "#223", "widgets_values": ["[Verse 1]\n老墙角的旧信箱 藏着泛黄的愿望\n你写的未来地址 是否已变了模样\n那年蝉鸣的盛夏 单车后座的风凉\n我们约好的远方 被谁寄错了方向\n\n[Pre-Chorus]\n邮票上褪色的邮戳 像句点停在承诺\n时光的墨水太浓 晕开所有如果\n\n[Chorus]\n我把思念写成信 投递给过去的自己\n却忘了写收件人 该怎么退回伤心\n邮差是迷路的云 淋湿了所有日期\n而你的签名 在回忆里 慢慢模糊成雨滴\n\n[Verse 2]\n钢笔划过的信纸 折成纸鹤飞不高\n你爱的薄荷味道 在抽屉里过期了\n教室后排的涂鸦 被粉笔擦成雪花\n而那句“一起长大” 只剩回声在回答\n\n[Bridge]\n砚台里墨色未干 临摹离别的形状\n宣纸上的枫叶 飘不进你的窗\n\n[Chorus]\n我把遗憾写成信 盖上月亮的邮章\n寄给青春的地址 却查无此人的光\n时光的邮局太忙 弄丢了我的勇敢\n而你的背影 在邮票上 永远停格那年盛夏\n\n[Outro]\n信封里没有答案 只有风铃在摇晃\n叮咚—— 像你笑着说 遗忘是最后一张"], "inputs": [{"widget": {"name": "multi_l