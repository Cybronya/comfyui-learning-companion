向都值得期待\n\n[Final Chorus]\n夏天晚风 吹呀吹\n吹开一路盛放的花蕊\n迎着月光 自由地追\n所有热爱都不会被浪费\n夏天晚风 吹呀吹\n唱着我们向前飞\n不问终点 不问错对\n此刻的快乐最珍贵\n\n[Outro]\n风从很远的地方来\n又向更远的地方而去\n", "", "", false, 1459526556, "randomize"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "title"}, "name": "title", "link": 26, "label": "title", "type": "STRING", "localized_name": "title"}, {"widget": {"name": "tags"}, "name": "tags", "link": 27, "label": "tags", "type": "STRING", "localized_name": "tags"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartAudioSunoV55Custom", "mode": 0, "bgcolor": "#535", "size": [395.54888916015625, 537.6900024414062], "pos": [-452.9461975097656, 666.1517333984375], "id": 38, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_RhartAudioSunoV55Custom"}, "order": 13}], "extra": {"links_added_by_ue": [], "KKvideo_latentpreview": false, "0246.VERSION": [0, 0, 4], "VHS_latentpreview": false, "ds": {"offset": [1979.563884144813, -653.656514516614], "scale": 0.7972024500000015}, "VHS_KeepIntermediate": true, "xzgGroups": {}, "ue_links": [], "VHS_MetadataImage": true, "KKvideo_latentpreviewrate": 0, "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0"}, "groups": [{"color": "#3f789e", "font_size": 49, "flags": {}, "id": 9, "title": "1.Suno V5.5自定义版本。支持自定义歌曲的歌词，音乐风格等，只要你自己定义歌词，就可以写一首自己的歌", "bounding": [-1177.1812744140625, 548.7694702148438, 1778.847900390625, 704.7525024414062]}, {"color": "#3f789e", "font_size": 49, "flags": {}, "id": 11, "title": "2.Suno V5.5 简易版本。输入歌曲描述，例如主题，音乐风格，标题，自动为您创作歌曲。AI 会根据描