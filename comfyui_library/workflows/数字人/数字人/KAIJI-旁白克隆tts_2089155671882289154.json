BO", "localized_name": "quality"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "audioUI"}], "flags": {}, "id": 4, "type": "SaveAudioMP3", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveAudioMP3"}, "order": 6}, {"mode": 0, "outputs": [{"name": "STRING", "links": [4], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [343.6363525390625, 153.63636779785156], "pos": [171.27427673339844, 586.949462890625], "widgets_values": ["假设这个世界上，大多数人都是理智的。\n那么一个理智的人，一定会做一件事：\n追求幸福，避开不幸福。\n如果你知道A会让你幸福，B会让你痛苦，\n你根本不需要别人教，\n你会本能地选择A，避开B。\n那么问题来了——\n为什么有些人明明想幸福，却一直在做让自己痛苦的事？\n比如嫉妒。\n一个人看到别人过得比自己好，就难受。\n他当然也想幸福，\n可他为什么停不下来？\n因为他没有看见自己的嫉妒。\n他只看见了“别人比我好”，\n却没有看见：\n原来我现在正在嫉妒。\n而当一个人真正看见自己的嫉妒时，\n他就开始意识到：\n这正在让我不幸福。\n于是，那个最原始的本能就会再次启动——\n避开它。\n所以，幸福有时候不是得到什么。\n而是先学会看见，什么，正在让你不幸福。\n我把这种能力，叫做——\n元幸福。\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 6, "type": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 2}, {"outputs": [{"name": "AUDIO", "links": [3], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "color": "#222", "widgets_values": ["0:00", "0:15"], "inputs": [{"name": "audio", "link": 1, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "start_time"}, "name": "start_time", "label": "start_time", "type": "STRING", "localized_name": "start_time"}, {"widget": {"name": "end_time"}, "name": "end_time", "label": "end_time", "type": "STRING", "localized_name": "end_time"}], "flags": {}, "type": "AudioCrop", "mode": 0, "bgcolor": "#000", "size": [270, 82], "pos": [549.684326171875, 295.21636962890625], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "AudioCrop"}, "order": 3}, {"outputs": [{"name": "AUDIO", "links": [5], "label": "AUDIO