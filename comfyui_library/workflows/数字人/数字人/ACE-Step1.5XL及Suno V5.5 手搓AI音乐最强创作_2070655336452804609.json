widgets_values": ["male vocal\n《还在路上》\n主歌一\n凌晨的灯还亮着\n桌上是没收完的碗\n手机里几条消息\n我都看了 又都没回完  \n大街上的人很多\n每张脸都走得匆忙\n我把领口拉高一点\n假装今天也不一样  \n预副歌\n我不是没想过\n是不是我哪里慢了半拍\n可窗外那一点光\n还是让我舍不得停下来  \n副歌\n我还在路上\n还没把自己弄丢\n把昨天收好\n把明天握在手头\n我没有答案\n但我还想往前走\n这一点点心跳\n够我撑到最后  \n主歌二\n白天把自己撑住\n晚上才敢松一松\n镜子里那个人\n有点累 也没那么从容  \n朋友都在往前走\n各有各的归属和忙碌\n我偶尔会羡慕\n也偶尔怀疑自己是不是太普通  \n预副歌\n可我还是会想\n会不会有一天我也能\n不靠硬撑着笑\n也能把生活过得像样  \n副歌\n我还在路上\n还没把自己弄丢\n把昨天收好\n把明天握在手头\n我没有答案\n但我还想往前走\n这一点点心跳\n够我撑到最后  \n桥段\n如果现在还不够好\n那就慢慢来\n如果我还没学会爱自己\n那就先别急着说拜拜\n我知道我有很多地方\n还没长成想要的模样\n可我也知道\n天总会亮  \n最后副歌\n我还在路上\n还没把自己弄丢\n把孤单收好\n把希望握在手头\n我没有答案\n但我还想往前走\n这一点点心跳\n够我撑到最后\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 9, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 4}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [692.4715603921622, -188.61540222627335], "scale": 0.7247295000000056}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "设置区", "bounding": [-254.67356872558594, 229.7974395751953, 920.8160400390625, 708.6583251953125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "时长（秒）", "bounding": [-186.42430114746094, 637.5635375976562, 290, 141.60000610351562]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "勿动区", "bounding": [1009.5918579101562, 242.1376495361328, 469.3946838378906, 1118.0377197265625]}, {"color": "#8A8", "font_size": 24, "flags": {}, "id": 4, "title": "免费（ACE-Step1.5XL）", "bounding": [1020.00732421875, 536.04248046875, 420, 345.6000061035156]}, {"color": "#8A8", "font_size": 24, "flags": {}, "id": 5, "title": "收费（SunoV5.5）", "bounding": [1024.34716796875, 898.0830688476562, 420, 431.5999450683594]}, {"colo