erties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "showAllGraphs": true, "sort": "position", "matchTitle": "I2V|R2V", "showNav": true, "toggleRestriction": "always one"}, "order": 16}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "OPT_CONNECTION", "type": "*"}], "bgcolor": "#533", "size": [280, 106], "color": "#322", "pos": [-1734.425048828125, 5744.1669921875], "inputs": [], "flags": {}, "id": 139, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "showAllGraphs": true, "sort": "position", "matchTitle": "图生视频|首|尾", "showNav": true, "toggleRestriction": "default"}, "order": 17}, {"outputs": [{"name": "STRING", "links": [253, 294], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["在仰拍的全景镜头中，一男一女正在踢足球。随着镜头缓缓右移，可以看到男子身着格子衬衫和牛仔裤，女子穿着绿色上衣和黑色裤子。他们动作敏捷，男子正准备踢球，女子则全神贯注地盯着球。他们站在一座白色建筑前，建筑上装饰着蓝色的木制窗户和门。在他们的身后，一棵光秃秃的树矗立着，周围还有一些其他的房屋。天空呈现出灰蓝色调，远处的房屋则被虚化处理。纪实摄影风格，画面充满动感与活力。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [400, 530], "pos": [-2194.425537109375, 5725.81787109375], "id": 137, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 18}, {"showAdvanced": false, "outputs": [{"name": "width", "links": [246, 275], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [247, 276], "label": "height", "type": "INT", "localized_name": "height"}], "color": "#232", "widgets_values": ["16:9 (Widescreen)", 0.4, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "m