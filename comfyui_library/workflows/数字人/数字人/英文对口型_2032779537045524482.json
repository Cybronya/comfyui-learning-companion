{"last_link_id": 10, "nodes": [{"outputs": [{"name": "prompt", "links": [], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#223", "widgets_values": ["家人们！有没有跟我一样的？白天上班没精神，爬个三楼都喘得不行，晚上睡觉还盗汗，腰膝酸软，整个人虚得不行!我之前也以为是单纯累，后来才知道是气阴两虚、阴虚火旺！试了好多方法，直到挖到北京同仁堂这款铁皮石斛西洋参胶囊！百年老字号，蓝帽认证，吃着贼放心！铁皮石斛和西洋参，专门补气血、滋阴降火！每天几粒，不用煮不用泡，揣包里就能吃，我吃了快一个月，真的不一样了！白天精力足，搬砖都有劲，晚上睡得香，盗汗也少了，腰膝酸软的毛病都缓解了！打工人、熬夜党、体质虚的宝子，别再硬扛了！对自己好点，精力满格才是搞钱的底气！赶紧冲！"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "type": "CR Prompt Text", "mode": 0, "bgcolor": "#335", "size": [393.62738037109375, 192.21124267578125], "pos": [898.63427734375, 1521.509521484375], "id": 8, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 0}, {"outputs": [{"name": "audio", "links": [8, 10], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#223", "widgets_values": [30, 0.8, 0.8, 3, 1500, 120, false, true, false, 1.0000000000000002, "", false, "", false, 1, "[0, 0, 0, 0, 0, 0, 0, 0]", false, "", false], "inputs": [{"name": "audio", "link": 9, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"name": "text", "link": 7, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "dialogue_audio_s2", "label": "dialogue_audio_s2", "type": "AUDIO", "localized_name": "dialogue_audio_s2"}, {"shape": 7, "name": "emo_audio_prompt", "label": "emo_audio_prompt", "type": "AUDIO", "localized_name": "emo_audio_prompt"}, {"shape": 7, "name": "emo_audio_prompt_s2", "label": "emo_audio_prompt_s2", "type": "AUDIO", "localized_name": "emo_audio_prompt_s2"}, {"widget": {"name": "top_k"}, "name": "top_k", "label": "top_k", "type": "INT", "localized_name": "top_k"}, {"widget": {"name": "top_p"}, "name": "top_p", "label": "top_p", "type": "FLOAT", "localized