erties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "BasicGuider"}, "order": 32}, {"mode": 0, "outputs": [{"name": "model", "links": [313], "label": "model", "type": "MODEL", "localized_name": "model"}], "size": [357.1148376464844, 30], "pos": [-438.2902526855469, 4462.04248046875], "widgets_values": [], "inputs": [{"name": "model", "link": 321, "label": "model", "type": "MODEL", "localized_name": "model"}], "flags": {}, "id": 184, "type": "MiniMaxH3MemoryEfficientSageAttentionPatch", "properties": {"cnr_id": "comfyui-kjnodes", "ver": "8692bc8ef8beaaeee80fd52ba80477dc9e61547b", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "MiniMaxH3MemoryEfficientSageAttentionPatch"}, "order": 18}, {"outputs": [], "color": "#fff0", "inputs": [], "flags": {"allow_interaction": true}, "type": "Label (rgthree)", "title": "添柴Ai", "mode": 0, "bgcolor": "#fff0", "size": [164.68212890625, 57], "pos": [1047.0760498046875, 4089.2763671875], "id": 157, "properties": {"padding": 0, "backgroundColor": "transparent", "fontFamily": "Arial", "borderRadius": 20, "textAlign": "left", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "angle": 0, "fontSize": 57, "fontColor": "#ffffff"}, "order": 5}, {"outputs": [], "color": "#222", "widgets_values": ["## MiniMax H3\n\n[MiniMax H3](https://www.minimax.io/blog/minimax-h3) MiniMax 的通用多模态生成模型，能够同时理解文本、图像、视频和音频，并生成带有**原生立体声音频**的视频：语音、音效和音乐在一次前向传播中联合建模，而非后期叠加。输出分辨率最高可达 2K，帧率 24fps，时长最长约为 15 秒。\n## 关于此工作流\n此模板运行 **图像转视频** 任务（`MiniMaxH3ImageToVideo` 节点），涵盖以下两个方面：\n- **t2va**（文本到视频），当未连接图像时使用  \n- **fl2va**（首/尾帧图像到视频），当连接了 `first_frame` 和/或 `last_frame` 时使用\n**关键输入**\n- **first_frame / last_frame**：可选的关键帧；模型将生成两者之间的运动  \n- **prompt**：在一段文字中描述镜头、动作以及伴随的音频（对白、音效、音乐）  \n- **width / height**：通过分辨率选择器设置。H3 的原生画布短边为 768 像素，最大尺寸限制为 768×1344 像素，并四舍五入至 32 的倍数  \n- **duration（秒）**：由数学表达式节点转换为有效的帧数 `length`，向上对齐至模型在 24fps 下每块 17 帧（17k+5）的网格"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "Note: MiniMax H3", "mode": 0, "bgcolor": "#000", "size": [448.7900085449219, 685.6599731445312], "pos": [-2962.865966796875, 4708.60009765625], "id": 116, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [210, 88], "pos": [-1386.2017822265625, 5322.72900390625], "widgets_values": ["124"], "inputs": [{"shape": 7, "name": "anything", "link": 271, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 166, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "595e0738a9e3f8d0d9c4d875461b2d2c9e7559c7", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 22}, {"mode": 0, "outputs": [{"name": "VAE", "links": [305, 315, 406], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [435.0260009765625, 70], "pos": [-1550.3546142578125, 5222.29443359375], "widgets_values": ["minimax_h3_audio_vae_fp32.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 122, "type": "VAELoader", "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "minimax_h3_audio_vae_fp32.safetensors", "directory": "vae", "url": "https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_audio_vae_fp32.safetensors"}], "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "VAELoader"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [416], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [274.080078125, 314], "pos": [-1972.0936279296875, 4940.72216796875