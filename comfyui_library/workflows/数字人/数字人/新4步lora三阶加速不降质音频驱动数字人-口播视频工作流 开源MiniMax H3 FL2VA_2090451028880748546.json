 approximately  es 140 BPM, driven by tight kick drums, sharp hi-hats, and a pulsing bass synth. The rhythm intensifies during the jump and drops slightly on the final landing.", 1344, 768, 124, "Ref2VA — 参考生音视频", "lock_source", 1, true, 0, true, "match", "official_2_to_15s"], "inputs": [{"name": "clip", "link": 303, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"name": "video_vae", "link": 304, "label": "video_vae", "type": "VAE", "localized_name": "video_vae"}, {"name": "audio_vae", "link": 305, "label": "audio_vae", "type": "VAE", "localized_name": "audio_vae"}, {"shape": 7, "name": "drive_audio", "link": 413, "label": "drive_audio", "type": "AUDIO", "localized_name": "drive_audio"}, {"shape": 7, "name": "final_audio", "label": "final_audio", "type": "AUDIO", "localized_name": "final_audio"}, {"shape": 7, "name": "first_frame", "label": "first_frame", "type": "IMAGE", "localized_name": "first_frame"}, {"shape": 7, "name": "last_frame", "label": "last_frame", "type": "IMAGE", "localized_name": "last_frame"}, {"shape": 7, "name": "ref_images.ref_image_0", "link": 416, "label": "ref_images.ref_image_0", "type": "IMAGE", "localized_name": "ref_image_0"}, {"shape": 7, "name": "ref_images.ref_image_1", "label": "ref_image_1", "type": "IMAGE", "localized_name": "ref_image_1"}, {"shape": 7, "name": "ref_videos.ref_video_0", "label": "ref_videos.ref_video_0", "type": "IMAGE", "localized_name": "ref_video_0"}, {"shape": 7, "name": "ref_video_audios.ref_video_audio_0", "label": "ref_video_audios.ref_video_audio_0", "type": "AUDIO", "localized_name": "ref_video_audio_0"}, {"shape": 7, "name": "ref_audios.ref_audio_0", "label": "ref_audios.ref_audio_0", "type": "AUDIO", "localized_name": "ref_audio_0"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 308, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "width"}, "name": "width", "link": 310, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"