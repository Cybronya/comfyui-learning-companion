, "order": 43}, {"outputs": [{"name": "IMAGE", "label": "输出", "type": "IMAGE"}], "color": "#323", "widgets_values": ["姿态图"], "inputs": [{"name": "IMAGE", "link": 315, "label": "输入", "type": "IMAGE"}], "flags": {"collapsed": true}, "type": "SetNode", "mode": 0, "bgcolor": "#535", "size": [210, 60], "pos": [-439.5841979980469, 903.1468505859375], "id": 198, "properties": {"previousName": "姿态图", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "aux_id": "SetNode", "Node name for S&R": "SetNode"}, "order": 37}, {"outputs": [{"name": "IMAGE", "links": [315], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#2a363b", "widgets_values": ["1cdfe9f88bfae13cf5619bdc765b61ecee9f0815f95c7d42ddf07cf96bf44c93.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#3f5159", "size": [365.52264404296875, 604.8532104492188], "pos": [-579.140625, 812.4617309570312], "id": 141, "properties": {"cnr_id": "comfy-core", "ver": "0.18.2", "ue_properties": {"widget_ue_connectable": {"image": true, "upload": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 24}, {"outputs": [{"name": "CONDITIONING", "links": [311], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["一位年轻亚洲女孩微笑拍照，齐刘海微卷黑长发向后梳理成高马尾，用红色蝴蝶结发饰固定，马尾末端自然垂落至肩部，圆润鹅蛋脸庞，大而圆的杏仁眼眸黑亮有神，细长柳叶眉微微上挑，樱桃小嘴自然微笑露齿，鼻梁高挺鼻翼精致，皮肤白皙细腻光滑无瑕，脸颊微微粉嫩自然红晕，颈部修长优雅，肩膀匀称对称。\n\n穿着露肩红色针织毛衣，V领设计露出锁骨和肩部肌肤，毛衣材质柔软厚实有弹性，长袖宽松延伸至手腕略微下垂，袖口自然卷边，毛衣主体鲜艳大红色均匀染色无褶皱，搭配白色泡泡裙，裙长至大腿中部，层层叠叠的白色棉质褶边荷叶设计，每层褶皱均匀对称蓬松蓬起，裙摆自然微翘，腿部修长笔直，小腿肌肉线条柔和匀称，脚部穿浅色室内拖鞋脚趾整齐。\n\n\n背景纯白墙面光滑平整无纹理，墙上悬挂三幅红色春节对联纸饰，中央横幅金色隶书福字“福”居中醒目，上方金边装饰，下方微卷纸边自然悬挂，两侧对称竖幅金色篆书对联文字“恭贺新禧 阖家欢乐”，每幅长约80厘米宽15厘米，底部绘金色祥云马匹图案，马匹动态奔腾四蹄扬起鬃毛飘逸，纸饰边缘微卷质感真实，墙面与纸饰间距均匀营造节日氛围。\n\n自然柔和顶光照明从上方45度角均匀洒落，光源色温温暖偏黄3200K，脸部高光集中在额头鼻梁颧骨形成细腻渐变光晕，阴影柔软落在下巴颈部和手臂内侧无硬边，红色毛衣表面微弱反光增强织物质感，白色裙摆边缘柔光晕染蓬松体积感，整体画面明亮高饱和色彩鲜艳对比强烈。\n\n写实摄影风格，佳能EOS R5相机拍摄，85mm定焦镜头f/1.8大光圈浅景深，脸部和上身极致锐利对焦细节丰富，背景墙面适度虚化保持清晰层次，8K超高分辨率像素级精细纹理，皮肤毛孔毛发丝缕分明，毛衣针织线头清晰可见，裙褶层层纤维纹路真实，纸饰金粉颗粒感和纸张褶皱高度逼真，构图居中对称黄金分割，画面整体干净无水印无噪点，纹理密度极高材质反射自然流畅，节日喜庆氛围浓厚温暖和谐。"], "inputs": [{"name": "clip", "link": 305, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [398.3274230957031, 348.0176086425781], "pos": [-594.75537109375, 412.62786865234375], "id": 136, "properties": {"cnr_id": "comfy-core", "ver": "0.17.0", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CLIPTextEncode"}, "order": 36}, {"outputs": [], "color": "#432", "widgets_values": ["注意：\n提示词不要和姿势图有冲突，\n\n如果提示词让人家站着，姿势图让人家坐着。\n\n那指定是不成的啊"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [314.77789306640625, 297.3299560546875], "pos": [-984.2969970703125, 458.6759033203125], "id": 230, "properties": {}, "order": 25}, {"outputs": [{"name": "IMAGE", "links": [353], "label": "输出", "type": "IMAGE"}], "color": "#2a363b", "widgets_values": ["解码输出"], "inputs": [], "flags": {"collapsed": true}, "type": "GetNode", "title": "Get_解码输出", "mode": 0, "bgcolor": "#3f5159", "size": [210, 58], "pos": [-862.4124145507812, 842.1739501953125], "id": 193, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "aux_id": "GetNode", "Node name for S&R": "GetNode"}, "order": 26}, {"mode": 0, "outputs": [], "size": [338.5731506347656,