al/server`。根目录 Wails 程序主要是桌面容器和本地能力适配层，不应被当作真实业务数据库或业务 API 的实现。\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 8, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 3}], "extra": {"links_added_by_ue": [], "t8_node_version": "0.2.5", "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "frontendVersion": "1.24.4", "ds": {"offset": [757.9090562203093, 17.183842911390798], "scale": 1.4122927695244523}, "t8_example_kind": "ui_workflow"}, "groups": [{"color": "#ff6f9f", "font_size": 22, "flags": {}, "id": 1, "title": "Breeze TTS 2 声音设计｜先在①中阅读并勾选 accept_model_license", "bounding": [-30, 20, 1610, 750]}], "links": [[1, 1, 0, 4, 0, "BREEZE_T8_MODEL"], [2, 2, 0, 4, 1, "BREEZE_T8_REQUEST"], [3, 3, 0, 4, 2, "BREEZE_T8_SETTINGS"], [4, 4, 0, 6, 0, "AUDIO"], [5, 4, 0, 5, 0, "AUDIO"], [6, 8, 0, 2, 0, "STRING"], [7, 9, 0, 2, 1, "STRING"]], "id": "533675ed-0775-4ccd-a730-49b085a2b910", "config": {}, "version": 0.4, "last_node_id": 9, "revision": 0}