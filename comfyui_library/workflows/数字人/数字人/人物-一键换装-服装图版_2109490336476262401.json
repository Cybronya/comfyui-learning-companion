ts_values": ["【人物-一键换装】使用说明\n1. ① 人物图 + ② 服装图 → Queue，完事。输出两张：换装图 + 左右对比图。\n2. 换装后脸/发型/姿势/背景自动保持原图不变（latent 就来自原图，已实测验证）。\n3. 不用服装图：右键 ② Bypass，③ 里把「图2中的服装」改成文字描述。\n4. 想只换上衣/下装：在 ③ 里写清楚，如「只把外套换成图2的外套，内搭和下装保持原图不变」。\n5. 服装还原度不够：④ 补充要求里点名材质，如「保留图2的蕾丝花纹细节」。\n6. 多试几次挑最好：KSampler seed 已设 randomize，每次 Queue 结果不同。\n7. 输出尺寸≈原图等比缩放到 1MP 档（竖图约 752×1392）。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [640, 300], "pos": [18.143569946289062, 2379.75537109375], "id": 22, "properties": {"widget_ue_connectable": {}}, "order": 6}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [1, 4, 5], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "slot_index": 1, "links": [], "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [457.96875, 446.078125], "pos": [47.45105743408203, 4.247598648071289], "widgets_values": ["4579ac8e61595a9f796eb7dd13870e1c216221a8399e5e739681c94d554df02a.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 1, "type": "LoadImage", "title": "① 人物图（保持这张的脸和背景）", "properties": {"widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 7}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [6, 7], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "slot_index": 1, "links": [], "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [456.71875, 427.4375], "pos": [48.69289779663086, 517.77734375], "widgets_values": ["55dbd0acbc25a0e2dcb56b5335ab92d0ac821db14485856f5d92688425f02092.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": 