 "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "id": 53, "type": "JjkText", "properties": {"hasSecondTab": false, "widget_ue_connectable": {"text": true}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "JjkText", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 1}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "KKvideo_latentpreview": false, "ue_links": [], "VHS_MetadataImage": true, "KKvideo_latentpreviewrate": 0, "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-4533.246070700549, 983.151960488522], "scale": 0.658845000000001}}, "groups": [], "links": [[100, 53, 0, 52, 0, "STRING"], [102, 49, 0, 54, 0, "IMAGE"], [103, 54, 0, 50, 0, "IMAGE"], [104, 52, 0, 54, 10, "STRING"]], "id": "06becadb-88b7-4f1c-81cc-8fab16af3165", "config": {}, "version": 0.4, "last_node_id": 54, "revision": 0}