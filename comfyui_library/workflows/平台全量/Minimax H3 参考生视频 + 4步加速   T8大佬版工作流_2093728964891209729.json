frames"}, {"name": "generated_audio", "links": [18], "label": "generated_audio", "type": "AUDIO", "localized_name": "generated_audio"}, {"name": "video_latent", "links": [], "label": "video_latent", "type": "LATENT", "localized_name": "video_latent"}, {"name": "audio_latent", "links": [], "label": "audio_latent", "type": "LATENT", "localized_name": "audio_latent"}], "size": [280, 120], "pos": [1342.9329833984375, -273.4165954589844], "widgets_values": [], "inputs": [{"name": "av_latent", "link": 14, "label": "av_latent", "type": "LATENT", "localized_name": "av_latent"}, {"name": "video_vae", "link": 15, "label": "video_vae", "type": "VAE", "localized_name": "video_vae"}, {"name": "audio_vae", "link": 16, "label": "audio_vae", "type": "VAE", "localized_name": "audio_vae"}], "flags": {}, "id": 11, "type": "MiniMaxH3AVDecodeT8", "properties": {"ver": "788cacae3699910d04c927e2082b9d44c197ed9b", "widget_ue_connectable": {}, "aux_id": "T8mars/minimax-h3-audio-T8", "Node name for S&R": "MiniMaxH3AVDecodeT8"}, "order": 22}, {"mode": 0, "outputs": [{"name": "prompt", "links": [91], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [312.1238708496094, 545.493408203125], "widgets_values": ["生成一段15秒、16:9、2K、原生立体声的末日惊悚告别短片，核心概念为绝望中的最后告白与捕食者的无情终结。固定人物与场景锁定：深色夹克男士（@图片1）面容憔悴、神情惊恐，身处末日城市街道；巨型多足虫怪物（@图片2）具备灰白甲壳、密集赤红关节肢足与狰狞口器；街道废墟、破碎地面与残破高楼（@图片3）作为连续空间载体。\n\n0.0–4.0秒：中近景正面镜头，深色夹克男士（@图片1）站在混乱街道中央，周围人群惊恐奔逃形成动态模糊的人流，他身体僵直不动，双手微颤握着手机举在面前，眼神绝望却努力保持镇定，嘴唇发抖对着手机说：\"亲爱的，我可能回不去了……\"声音颤抖，背景传来怪物远处的低沉嚎叫，他深吸一口气，语气忽然变得无比温柔坚定：\"我非常非常爱你。\"\n4.0–4.8秒：切至男士（@图片1）脸部特写，泪水在眼眶中打转却强忍未落，嘴角勉强扯出一个苦涩的微笑，手机贴在耳边，身后怪物的嚎叫声骤然拉近变响，他的瞳孔微微收缩，但握着手机的手依然没有放下。\n4.8–5.2秒：0.4秒黑屏过渡，伴随一声沉闷的脚步声切换。\n5.2–8.8秒：硬切至第一人称视角（男士主观镜头），画面剧烈晃动，视线急促上下起伏，双手在画面下方摆动，前方是破碎的街道与四散奔逃的人群，呼吸声粗重急促，身后传来密集肢足敲击地面的金属刮擦声越来越近，视线不时快速回头瞥见灰白甲壳与赤红肢足在视野边缘闪烁逼近。\n8.8–10.5秒：第一人称视角继续奔跑，突然一根粗壮的赤红关节尖刺肢足从画面正中央猛地穿刺而过，肢足表面沾着深色液体，画面剧烈震颤后开始倾斜，视线急速下坠，天空与街道在视野中旋转翻转。\n10.5–11.8秒：视角继续下坠，地面急速放大逼近，画面边缘变暗模糊，最终重重撞击地面，视角歪斜贴地，画面剧烈一震后趋于静止，边缘渗出暗色阴影，呼吸声骤然中断。\n11.8–15.0秒：硬切至低角度仰拍，巨型多足虫怪物（@图片2）占据画面中央，灰白甲壳在逆光中呈现冰冷质感，密集赤红关节肢足在空中张合挥舞，狰狞口器大张发出震耳欲聋的咆哮声，两根长须剧烈抖动，身后是破碎的城市天际线与弥漫的尘雾，画面在咆哮的最高点定格0.8秒，怪物的红眼亮度骤增，宣告猎物的终结。\n\n剪辑与动作：全片分为三段式结构——告别、逃亡、终结，切点落在告白完成帧、黑屏过渡帧、肢足穿体帧、坠地帧与咆哮定格帧；前段用静止机位拍摄不动的男士与流动人群的对比，中段手持第一人称视角制造沉浸慌乱，末段用低角度仰拍放大怪物压迫感；连续感由怪物的嚎叫声从远到近、肢足的赤红色彩与城市废墟环境贯穿；动作因果依次为：男士原地告别—怪物逼近嚎叫—男士开始奔跑—怪物肢足穿体—男士倒地—怪物咆哮宣告终结。\n\n视觉风格：延续三张原图的末日冷灰基调与高对比度光影；告别段保持男士面部柔光与环境混乱形成对比，突出温情与绝望的撕裂感；第一人称段使用强烈手持晃动与动态模糊，肢足穿体瞬间画面短暂过曝后急速变暗；咆哮段采用低角度逆光，怪物甲壳边缘泛冷白光，赤红肢足与红眼作为画面唯一暖色锚点，与整体冷灰基调形成压迫性对撞。\n\n声音设计：0.0–4.8秒环境混乱人声与脚步为底层，男士颤抖告白声清晰突出，远处怪物嚎叫由低渐强，手机对面传来微弱的女声回应但听不清内容；4.8–5.2秒黑屏期间所有声音骤停只剩一声沉闷心跳；5.2–8.8秒第一人称段以粗重喘息、急促脚步、心跳加速与身后肢足刮擦声构成沉浸式音墙，怪物嚎叫持续逼近；8.8–10.5秒肢足穿体瞬间叠加肉体穿刺的沉闷撞击声与骨骼碎裂声，呼吸声戛然而止；10.5–11.8秒坠地瞬间低频轰鸣后归于短暂死寂；11.8–15.0秒怪物咆哮声从低频震动攀升至高频嘶吼，在定格瞬间达到最高点，随后0.3秒内所有声音切断归于寂静。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 36, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 10}, {"mode": 0, "showAdvanced": true, "outputs": [{"name": "width", "links": [88], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [89], "label": "height", "type": "INT", "localized_name": "height"}], "size": [270, 170], "pos": [11.019998550415039, 549.4533081054688], "widgets_values": ["16:9 (Widescreen)", 0.6000000000000001, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "id": 16, "type": "ResolutionSelector", "propertie