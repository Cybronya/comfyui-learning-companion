的黑白基底上以不同色彩区分——左侧的粉+红暖调系与右侧的绿+粉冷调系形成冷暖互补；衣摆的黑底回旋纹镶边作为统一元素贯穿两套服装。背景的蓝白色天空与山脉提供了清冷的氛围框架，前景的绿色草地注入生机活力。日光明亮均匀，使色彩饱和度高、云层立体、整体视觉效果清新开阔且富有民族美学的诗意韵味。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 114, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 1}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-4234.800812445746, -3133.2666642930776], "scale": 0.371900826446281}}, "groups": [], "links": [[148, 93, 0, 86, 0, "IMAGE"], [220, 116, 0, 123, 0, "IMAGE"], [242, 125, 0, 93, 0, "IMAGE"], [243, 125, 1, 116, 0, "IMAGE"], [244, 125, 2, 93, 1, "IMAGE"], [245, 125, 3, 116, 1, "IMAGE"], [246, 125, 4, 93, 2, "IMAGE"], [247, 125, 5, 116, 2, "IMAGE"], [248, 125, 6, 93, 3, "IMAGE"], [249, 125, 7, 116, 3, "IMAGE"], [250, 125, 8, 93, 4, "IMAGE"], [251, 125, 9, 116, 4, "IMAGE"], [252, 125, 10, 93, 5, "IMAGE"], [253, 125, 11, 116, 5, "IMAGE"], [254, 125, 12, 93, 6, "IMAGE"], [255, 125, 13, 116, 6, "IMAGE"], [256, 125, 14, 93, 7, "IMAGE"], [257, 125, 15, 116, 7, "IMAGE"], [258, 125, 16, 93, 8, "IMAGE"], [259, 125, 17, 116, 8, "IMAGE"], [260, 125, 18, 93, 9, "IMAGE"], [261, 125, 19, 116, 9, "IMAGE"], [262, 114, 0, 126, 1, "STRING"], [263, 126, 0, 93, 11, "STRING"], [264, 126, 1, 116, 10, "STRING"]], "id": "06becadb-88b7-4f1c-81cc-8fab16af3165", "config": {}, "version": 0.4, "last_node_id": 127, "revision": 0}