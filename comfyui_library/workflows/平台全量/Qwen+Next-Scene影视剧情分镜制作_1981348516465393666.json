e": "prompt"}, "name": "prompt", "link": 3063, "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {"collapsed": false}, "id": 68, "type": "TextEncodeQwenImageEditPlus", "properties": {"cnr_id": "comfy-core", "ver": "0.3.59", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "TextEncodeQwenImageEditPlus"}, "order": 17}, {"outputs": [{"shape": 6, "name": "STRING", "links": [3063, 3064], "label": "字符串", "type": "STRING", "localized_name": "字符串"}, {"shape": 6, "name": "COMBO", "label": "COMBO", "type": "*", "localized_name": "COMBO"}], "color": "#233", "widgets_values": ["Next Scene: 左手举至胸前，比出 “中指”\nNext Scene: 单腿站立（右腿支撑），左腿向后弯曲抬起，双手向后轻触左脚脚踝，裸足，身体形成优美的弧线，融入柔美感\nNext Scene: 面对大桥栏杆，双手张开平贴在栏杆上，身体微微倾斜，头部靠近手臂，眼神透过手臂间隙看向镜头，为画面增添故事感\nNext Scene: 面朝镜头，坐于大桥地面上，裸足，双腿伸直并拢，身体向后仰、以手掌支撑地面，头部微微后仰，展现背部线条，与街头地面、环境形成互动\nNext Scene: 动态迈步，裸足，左腿向前迈出，身体略微向侧前方倾斜，手臂自然摆动，盘发因走动带起轻微弧度，捕捉 “行走中” 的潮流瞬间\nNext Scene: 侧身倚靠桥头栏杆，裸足，左腿伸直、右腿弯曲，左臂搭在栏杆上，手腕的手镯随动作轻晃，慵懒又具时尚范儿。\nNext Scene: 保持半蹲姿态，双手撑在膝盖上，头部抬起，眼神坚定直视镜头，裸足稳稳扎根地面，融合力量感与性感。\nNext Scene: 背对镜头，双手抬至脑后整理盘发，腰部轻轻扭转，露背旗袍的线条充分展现。\nNext Scene: 单膝微微屈膝、身体前倾，右手抓握旗袍裙摆，左手自然垂落，头部转向身体侧面，仿佛即将迈步，带出动感张力。\nNext Scene: 站立于上海滩的夜景前，身体侧身，左手掀起旗袍露出臀部，右手轻搭栏杆，头部微侧，眼神慵懒凝视镜头。", 0, 1000, ""], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "link": 3744, "label": "提示词", "type": "STRING", "localized_name": "提示词"}, {"widget": {"name": "start_index"}, "name": "start_index", "type": "INT", "localized_name": "起始索引"}, {"widget": {"name": "max_rows"}, "name": "max_rows", "type": "INT", "localized_name": "最大行数"}], "flags": {}, "type": "easy promptLine", "mode": 0, "bgcolor": "#355", "size": [367.310791015625, 404.1109619140625], "pos": [1614.66748046875, -601.6578979492188], "id": 76, "properties": {"cnr_id": "comfyui-easy-use", "ver": "8ecc929cd41cf0f7ef6fcc45d4bbc5729c6f287f", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.2.