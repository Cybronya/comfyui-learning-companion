[0.7000000000000002, "fixed"], "inputs": [], "flags": {}, "type": "PrimitiveNode", "mode": 0, "bgcolor": "#353", "size": [210, 82], "pos": [378.0634460449219, 416.0515441894531], "id": 67, "properties": {"widget_ue_connectable": {}, "Run widget replace on values": false}, "order": 5}, {"outputs": [{"shape": 6, "name": "text", "links": [71], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#223", "widgets_values": ["一名温柔清冷的古典美人一位年轻女性站在户外阶梯旁，侧身回眸凝视镜头，长发随风轻扬，阳光从她身后斜射，勾勒出柔和的轮廓光。她身穿一件紧身的酒红色长袖上衣，搭配高腰橙色运动短裤，裤侧印有白色字母“QYC”，凸显修长身形与运动感。她双手轻握一束饱满的橙色玫瑰花束，花朵层层叠叠，色彩温暖，与裤子色调呼应，形成视觉焦点。她的表情恬静自然，眼神温柔，嘴角微扬，流露出不经意的优雅与从容。\n\n前景中，花束与她的手部占据画面左侧，引导视线向主体延伸；中景是她完整的身体姿态，阶梯与扶手作为结构元素，增强画面层次；背景是深蓝灰色的建筑墙面与楼梯，墙面质感粗糙，与人物的柔美形成对比，右侧有明亮窗框结构，阳光透过形成光晕与明暗过渡，营造空间纵深。构图采用三分法，人物位于画面右侧，留白左侧形成呼吸感，身体曲线与阶梯线条形成动态平衡。视觉引导线由花束、手臂、腿部线条自然延伸至画面中心，引导观众目光聚焦于人物面部与姿态。\n\n光影方面，逆光处理使人物边缘发光，发丝与衣角透出金边，同时保留面部与身体细节，形成“剪影+高光”的戏剧效果。氛围温暖而宁静，阳光洒落如诗如画，带有一丝慵懒的午后感，整体色调偏暖，橙与红的暖色系与冷灰背景形成对比，强化视觉冲击力。画面风格兼具时尚与自然，既具专业摄影的精致感，又保留日常拍摄的随性与真实，仿佛捕捉了某个不经意的瞬间，充满生活气息与艺术美感。"], "inputs": [{"name": "text", "link": 69, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#335", "size": [375.5136413574219, 464.1505126953125], "pos": [-1021.5703125, 121.4501724243164], "id": 58, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 17}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "size": [459.0924072265625, 274], "pos": [-2808.107177734375, 570.3922729492188], "inputs": [], "flags": {}, "id": 81, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "widget_ue_connectable": {}, "sort": "position", "matchTitle": "", "showNav": true, "toggleRestriction": "