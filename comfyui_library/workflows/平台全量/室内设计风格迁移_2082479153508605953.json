 for S&R": "PrimitiveFloat"}, "order": 10}, {"outputs": [{"name": "text", "links": [640], "label": "text", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#232", "widgets_values": ["将图1的装修风格替换为图2的风格，严格保持图1的家具位置、空间比例和透视结构完全不变\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "title": "⑦ ✏️ 写迁移指令的地方（核心！）", "mode": 0, "bgcolor": "#353", "size": [598.1216430664062, 375.084228515625], "pos": [2495.41748046875, 2510.75634765625], "id": 410, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 11}], "extra": {"links_added_by_ue": [], "KKvideo_latentpreview": false, "0246.VERSION": [0, 0, 4], "VHS_latentpreview": false, "ds": {"offset": [-3148.7557937087117, -2524.684373118501], "scale": 1.7088742511246}, "VHS_KeepIntermediate": true, "VHS_MetadataImage": true, "ue_links": [], "KKvideo_latentpreviewrate": 0, "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "workflow_guide": "📖 万物迁移工作流 · 使用说明\n━━━━━━━━━━━━━━━━━━━━\n【三步使用】\n1. 图1上传你的效果图 → 2. 图2上传风格参考图 → 3. 在⑦写指令\n\n【prompt写法示例】\n· 整体换风格：将图1的装修风格替换为图2的风格，保留布局和结构\n· 换材质：将图1的墙面材质替换为图2的材质\n· 换配色：将图1的配色方案替换为图2的风格\n· 换软装：将图1的家具改为图2的风格，布局不变\n\n【不用改的参数】\n· CFG=1（Flux2最佳值）、采样器Euler、4步\n\n【可以动的参数】\n· ⑧ 放大倍数（1=1MP，4=4MP，越大细节越好但越慢）\n· ㉑ 步数（4步出轮廓，8步出细节，15步出极致）\n· ⑲ 种子（随机=每次不同，固定=可复现）\n\n【底层逻辑】\n这个工作流不用ControlNet，而是用Flux2原生ReferenceLatent\n把图1的结构和图2的风格特征注入到生成条件里\n所以结构保持靠的是写prompt强调，而不是ControlNet硬拉\nprompt越强调'保持布局'，结构越稳"}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 25, "title": "⬅️ 模型加载区 ➡️ 参考图特征注入 ➡️ 采样生成 ➡️ 结果展示", "bounding": [1484.193115234375, 3049.526123046875, 2393.067626953125, 922.8324584960938]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 26, "title": "📥 输入：你的效果图", "bounding": [1462.53393554687