690a4ba460d02cd431.png", "upload": "image"}}, {"outputs": [{"shape": 6, "name": "text", "links": [88], "label": "字符串", "type": "STRING", "localized_name": "text"}], "color": "#4b5563", "widgets_values": ["产品是一个玻璃茶壶，壶身、壶嘴、滤胆和壶盖均为**透明**材质；壶盖顶部的圆形提钮和侧边的长手柄为**不透明**的红棕色木质材质；壶内装有琥珀色茶汤（透明液体）以及茶叶（不透明固体）。\n\n由于玻璃边缘的菲涅尔反射效应，壶身、壶嘴及壶盖的玻璃边缘均呈现实心完整的状态。整体呈现边缘实心、中间通透的状态。"], "inputs": [{"name": "text", "link": 98, "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "rgba(21, 23, 27, 0.96)", "size": [428.17578125, 264.2230224609375], "pos": [-641.1533813476562, 564.58251953125], "id": 62, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "609f3afaa74b2f88ef9ce8d939626065e3247469", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 27, "widgets_values_named": {"text": "产品是一个玻璃茶壶，壶身、壶嘴、滤胆和壶盖均为**透明**材质；壶盖顶部的圆形提钮和侧边的长手柄为**不透明**的红棕色木质材质；壶内装有琥珀色茶汤（透明液体）以及茶叶（不透明固体）。\n\n由于玻璃边缘的菲涅尔反射效应，壶身、壶嘴及壶盖的玻璃边缘均呈现实心完整的状态。整体呈现边缘实心、中间通透的状态。"}}, {"mode": 0, "outputs": [{"name": "output", "links": [98], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [474.2799987792969, 829.5046997070312], "pos": [-1136.0570068359375, 558.94921875], "widgets_values": ["Normal - Describe", "帮我描述图片中的主体的材质，最重要的是讲明白，哪些材质是半透明，哪些材质是不透明的，最后说明边缘一定实心的，因为边缘的反射菲尼尔现象，边缘一定呈现实心完整的状态，如果产品内部有物体，也要说明内部的物体是实心还是透明的，比如说玻璃杯内部有一个水果，那么玻璃杯是透明，但是水果是不透明，格式如“产品是一副浅琥珀色透明材质的眼镜，镜框整体为半透明材质，镜片为半透明琥珀色镜片，镜腿为半透明材质，镜框边缘因菲涅尔反射效应呈现实心完整的状态，内部无额外物体，整体材质通透，边缘实心中间半透明。”", "", "one by one", 24, 256, 354784661026046, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 94, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 95, "label": "parameters", "type": "L