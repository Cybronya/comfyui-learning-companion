type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [1064.6126708984375, 1535.5677490234375], "widgets_values": ["这是一幅以文字为主要表现内容的图片，背景为纯黑色，突出了中央的文字效果。画面中央的文字为\"枪战王者\"四个大字，文字采用了立体化设计，整体为金黄色，呈现出金属质感，同时具有光影效果，使其显得极为霸气和强调力量感。字体棱角分明，每个字的边缘还嵌有银色的描边，增加了层次感和科技感，整体风格偏向现代化与游戏气息。\n\n文字中的\"枪战王者\"很可能是某款射击类游戏或电竞赛事的名称，充满张力和竞争氛围，能够吸引玩家的注意力。设计上简洁而不失华丽，彰显作品的核心主题。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 123, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 22}, {"mode": 4, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [643.0833740234375, 997.4999389648438], "widgets_values": ["\n\n\n主标题“花信风至 春事阑珊”线条流畅,白色粉色渐变立体字,红色厚度，带有橙色渐变字体描边,粗线体，可爱生动、笔画大圆弧转折，文字上有花朵、信封、气球点缀，白色背景。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 88, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 23}, {"mode": 4, "outputs": [{"name": "text", "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [635.9845581054688, 735.935791015625], "widgets_values": ["主标题是“618购物嘉年华”，金色金属立体字，副标题“爆款直降限时抢购\"多层描边厚度，正面标题字，电商促销字体，以立体醒目的 3D字体呈现,整体设计洋溢着浓厚的节日电商氛围,数字和文字边缘带有红橙色渐变高光效果，电商大促标题，丝带装饰，白色背景。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 85, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 24}, {"mode": 4, "outputs": [{"name": "text", "links": [], "label": "文本", "type": "*"