{"last_link_id": 18, "nodes": [{"mode": 0, "outputs": [{"name": "text", "links": [12, 15, 18], "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "language", "links": [13], "label": "language", "type": "STRING", "localized_name": "language"}], "size": [233.4072265625, 78], "pos": [-288.9977111816406, 413.8377685546875], "widgets_values": ["Auto"], "inputs": [{"name": "model", "link": 10, "label": "model", "type": "QWEN3ASR_MODEL", "localized_name": "model"}, {"name": "audio", "link": 11, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "language"}, "shape": 7, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "id": 11, "type": "Qwen3ASRTranscribe", "properties": {"widget_ue_connectable": {"language": true}, "Node name for S&R": "Qwen3ASRTranscribe"}, "order": 3}, {"mode": 0, "outputs": [{"name": "model", "links": [10], "label": "model", "type": "QWEN3ASR_MODEL", "localized_name": "model"}], "size": [336.5584411621094, 82], "pos": [-314.0823059082031, 611.314697265625], "widgets_values": ["Qwen3-ASR-1.7B", false], "inputs": [{"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "unload_after"}, "shape": 7, "name": "unload_after", "label": "unload_after", "type": "BOOLEAN", "localized_name": "unload_after"}], "flags": {}, "id": 10, "type": "Qwen3ASRLoader", "properties": {"widget_ue_connectable": {"model_name": true}, "Node name for S&R": "Qwen3ASRLoader"}, "order": 0}, {"mode": 0, "outputs": [{"name": "aligner", "links": [14], "label": "aligner", "type": "QWEN3_ALIGNER", "localized_name": "aligner"}], "size": [337.7712097167969, 82], "pos": [-329.76483154296875, 17.631330490112305], "widgets_values": ["Qwen3-ForcedAligner-0.6B", false], "inputs": [{"widget": {"name": "model_name"}, "name": "model_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "unload_after"}, "shape": 7, "name": "unload_after", "label": "unload_after", "type": "BOOLEAN", "localized_name": "unload_after"}], "flags": {}, "id": 16, "type": "Qwen3ForcedAlignerLoader", "properties": {"widget_ue_connectable": {"model_name": true}, "Node name for S&R": "Qwen3ForcedAlignerLoader"}, "order": 1}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [279.9638977050781, 333.4961853027344], "pos": [551.35986328125, -31.272340774536133], "widgets_values": ["我叫陈明\t0.480\t1.200\n因为庄大运来到这个平行世界\t1.440\t3.200\n好在及时觉醒了系统\t3.920\t5.520\n穿越后保住一命\t5.840\t6.800\n可代价却是\t7.920\t8.960\n我反手欠了系统整整一百个亿\t10.080\t12.720\n嗯\t17.440\t17.600\n啊啊啊\t18.720\t21.520\n系统\t28.720\t29.600\n你除了讨债\t29.760\t30.800\n就没有别的能力了吗\t31.280\t33.040\n啊啊啊\t36.000\t36.000\n只要得到足够的打赏还账\t43.440\t45.120\n就不用变植物人了\t45.440\t46.560\n要是运气好\t47.120\t48.000\n能多赚几笔\t48.080\t48.960\n还能彻底翻身\t49.040\t50.320\n好好享受人生\t50.400\t51.680\n不过想要赚足打赏\t52.560\t54.080\n最直接的路子就是从皇帝那薅钱\t54.240\t56.960\n可怎么才能让皇帝心甘情愿的打赏\t57.520\t59.840\n溜须拍马\t60.160\t60.880\n吹捧他们的功绩\t60.880\t61.600\n不行不行\t62.240\t62.720\n哎对了\t63.200\t63.680\n古代奸臣多的是\t64.080\t65.200\n我帮皇帝揪出这些蛀虫\t65.600\t67.120\n他们不得乖乖给我打赏\t67.360\t68.800\n嗯\t69.360\t69.920\n合理\t70.000\t70.400\n太合理了\t70.640\t71.360\n不知道这些自命不凡的帝王\t71.840\t73.840\n看到朝中蛀虫\t73.840\t74.960\n会是什么反应呢\t75.280\t76.400\n各位帝王们\t77.200\t78.080\n你们准备好了吗\t78.480\t79.600\n投放\t80.160\t80.880"], "inputs": [{"name": "text", "link": 17, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 17, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 8}, {"mode": 0, "outputs": [{"name": "timestamps", "links": [17], "label": "timestamps", "type": "STRING", "localized_name": "timestamps"}, {"name": "text_list", "label": "text_list", "type": "STRING", "localized_name": "text_list"}, {"name": "start_times", "label": "start_times", "type": "STRING", "localized_name": "start_times"}, {"name": "end_times", "label": "end_times", "type": "STRING", "localized_name": "end_times"}], "size": [230, 196], "pos": [202.72836303710938, -2.1036629676818848], "widgets_values": ["", "Chinese", true], "inputs": [{"name": "aligner", "link": 14, "label": "aligner", "type": "QWEN3_ALIGNER", "localized_name": "aligner"}, {"name": "audio", "link": 16, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "text"}, "name": "text", "link": 15, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}, {"widget": {"name": "segment_by_sentence"}, "name": "segment_by_sentence", "label": "segment_by_sentence", "type": "BOOLEAN", "localized_name": "segment_by_sentence"}], "flags": {}, "id": 15, "type": "Qwen3ForcedAlign", "properties": {"widget_ue_connectable": {"language": true, "text": true}, "Node name for S&R": "Qwen3ForcedAlign"}, "order": 5}, {"mode": 0, "outputs": [{"name": "text", "label": "text", "type": "STRING", "localized_name": "text"}, {"name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 150], "pos": [185.07896423339844, 260.3858337402344], "widgets_values": ["", "", "txt", true], "inputs": [{"name": "text", "link": 18, "label": "text", "type": "STRING", "localized_name": "text"}, {"shape": 7, "name": "image", "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "output_file_path"}, "name": "output_file_path", "label": "output_file_path", "type": "STRING", "localized_name": "output_file_path"}, {"widget": {"name": "file_name"}, "name": "file_name", "label": "file_name", "type": "STRING", "localized_name": "file_name"}, {"widget": {"name": "file_extension"}, "name": "file_extension", "label": "file_extension", "type": "COMBO", "localized_name": "file_extension"}, {"widget": {"name": "overwrite"}, "name": "overwrite", "label": "overwrite", "type": "BOOLEAN", "localized_name": "overwrite"}], "flags": {}, "id": 18, "type": "easy saveText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy saveText"}, "order": 6}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [445.4691162109375, 233.0816650390625], "pos": [121.10491180419922, 509.2370300292969], "widgets_values": ["我叫陈明，因为庄大运来到这个平行世界，好在及时觉醒了系统，穿越后保住一命。可代价却是，我反手欠了系统整整一百个亿。嗯。啊啊啊！系统，你除了讨债，就没有别的能力了吗？啊啊啊！只要得到足够的打赏还账，就不用变植物人了。要是运气好，能多赚几笔，还能彻底翻身，好好享受人生。不过想要赚足打赏，最直接的路子就是从皇帝那薅钱。可怎么才能让皇帝心甘情愿的打赏？溜须拍马，吹捧他们的功绩？不行不行。哎对了，古代奸臣多的是，我帮皇帝揪出这些蛀虫，他们不得乖乖给我打赏？嗯，合理，太合理了。不知道这些自命不凡的帝王，看到朝中蛀虫，会是什么反应呢？各位帝王们，你们准备好了吗？投放。"], "inputs": [{"name": "text", "link": 12, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 13, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 4}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [210.87765502929688, 88], "pos": [683.8947143554688, 410.9035339355469], "widgets_values": ["Chinese"], "inputs": [{"name": "text", "link": 13, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 14, "type": "ShowText|pysssss", "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 7}, {"mode": 0, "outputs": [{"name": "AUDIO", "links": [11, 16], "label": "AUDIO", "type": "AUDIO", "localized_name": "AUDIO"}], "size": [270, 136], "pos": [-305.71142578125, 188.678955078125], "widgets_values": ["5cb0e2477bb6cab9aa4d74