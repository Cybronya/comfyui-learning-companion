{"last_link_id": 3, "nodes": [{"outputs": [{"name": "image", "links": [1, 3], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "url", "label": "url", "type": "STRING", "localized_name": "url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "color": "#432", "widgets_values": ["超写实治愈人像摄影，画面主体是一位年轻白人少女，有着柔软的金色短发，头发侧边佩戴淡紫色、鹅黄色、奶白色雏菊组成的小花发饰，身穿米白色露肩荷叶边上衣，衣身带有精致镂空蕾丝花纹，面料轻薄飘逸，通透有垂感。少女双手环抱着一只长毛小猫，小猫底色奶白，带有柔和浅橘虎斑，绒毛蓬松丰厚，长着圆润浅绿色眼睛，内耳粉嫩。少女头顶斜上方撑着一把透明 PVC 雨伞，黑色细伞骨，伞面布满晶莹透亮的水珠。少女微微仰头，双眼轻闭，嘴唇微张，嘴角带着松弛温柔的浅笑，神情恬静治愈；她双臂弯曲，把小猫稳稳托在胸前，小猫端正抬头向前凝望，姿态安稳乖巧，一人一猫亲密依偎，氛围柔和温暖。雨伞隔在少女和后方光源之间，背景是开阔澄澈的淡蓝色晴空，空中飘着蓬松绵软的白云，一道柔和的彩虹斜跨天空，无数细碎闪光粒子漂浮在空气当中。光源来自雨伞后上方，为逆光顶光，太阳藏在透明伞后方，暖金色轮廓光勾勒出发丝、肩膀、猫毛与伞沿的光晕，画面底色是清冷干净的浅蓝，和暖金色柔光相互融合，冷暖平衡协调。空气中布满朦胧圆形散景光斑，水珠折射光线，光点闪闪发亮，光线过渡柔和顺滑，无生硬厚重阴影。清新日系梦幻氛围感，电影柔光镜头质感，细腻柔焦效果，8K 超高清晰度，精细刻画自然真实的皮肤肌理、根根清晰的猫咪绒毛，低饱和度干净配色，浅景深虚化背景，突出前景人物与小猫，画面空灵浪漫，童话感十足，构图柔和，4:3 画幅，无文字、无 logo、无水印，干净通透，整体温柔治愈，充满轻盈美好的梦幻气息。", "1k", "2:3", false, 1493268849, "randomize"], "inputs": [{"shape": 7, "name": "api_config", "label": "api_config", "type": "RH_OPENAPI_CONFIG", "localized_name": "api_config"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "resolution"}, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "skip_error"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "type": "RH_RhartImageNNb21TextToImage", "mode": 0, "bgcolor": "#653", "size": [473.2789387131053, 637.8656496034946], "pos": [727.4666748046875, 362.4000244140625], "id": 1, "properties":