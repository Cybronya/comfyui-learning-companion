tion": true, "model": true, "prompt": true}, "aux_id": "T8mars/Comfyui-zhenzhen", "Node name for S&R": "Comfly_gpt_image_2_official_ratio"}, "order": 9}, {"mode": 0, "outputs": [{"name": "prompt", "links": [23, 31], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [588.6959838867188, 475.4845886230469], "pos": [1322.323486328125, 528.7747802734375], "widgets_values": ["生成一张他/她的高端专业肖像照片。让他/她自信地看着镜头，保持角色不变。略带LinkedIn商务风格的商业摄影，腰腹以上半身中景构图，尺寸3:4。\n\n主体：用户上传的角色形象，保留精准的人物面部特征。人物一致性要达到能通过人脸验证的级别。表情从容自信，目光炯炯有神。姿态自然而得体，体现人物的精英感和一部分自身气质。\n\n发型：以原图的发型为基础衍生，尽量自然、精致、整齐。如果原图过于邋遢可以适当发挥重新设计发型。不要戴帽子。\n\n妆容：女性适用职场妆（自然眉形 + 大地色眼影 + 适配的唇色），肤质细腻。男性则弱化妆感，整洁干净即可。\n\n修图：工作室肖像风格精修图，强调真实、自然、无瑕的广告级皮肤纹理、肤色过渡自然，对比光泽适中，不要过度磨皮。移除瑕疵但保留标志性的痣或痦子。\n\n服装：基于角色气质设计，正式感与自然感并存的精英穿搭，材质高级，版型服帖精致。\n\n氛围：光线为柔和且讨喜的专业工作室照明，主光从侧前方45度打亮面部，形成细腻明暗层次与自然阴影过渡。辅光带有一点色相勾勒轮廓，色温可基于人物气质稍稍变通。专业、睿智、亲和、整洁。体现人物的精英感与权力感。\n\n背景：中性色调，纯净影棚背景，略带一些渐变。平静，精致和永恒。\n\n类型：高级定制肖像照。专业摄影质感。使用哈苏相机拍摄的高分辨率照片。\n\n画质：高清8K，超写实、细节清晰。浅景深，85mm镜头效果，f1.8光圈，\n\n--no 过度美颜, 卡通风, AI感, 五官畸形, 杂乱背景, 文字, logo\n"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 17, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "apikey", "links": [32], "label": "apikey", "type": "STRING", "localized_name": "apikey"}], "size": [599.2124633789062, 159.27505493164062], "pos": [-219.62728881835938, 643.2557983398438], "widgets_values": ["zhenzhen", "000", "", false], "inputs": [{"widget": {"name": "api_base"}, "name": "api_base", "label": "api_base", "type": "CO