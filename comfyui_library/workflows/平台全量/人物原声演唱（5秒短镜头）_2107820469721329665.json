_soundscape\nOnly the separately supplied original audio interval, with its original vocal. No extra speech, applause, handling noise or ambience.\n\nnon_diegetic_music\nKeep the original instrumental accompaniment once as part of that same locked recording. Add no music.\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 138, "type": "PrimitiveStringMultiline", "title": "PrimitiveStringMultiline", "properties": {"widget_ue_connectable": {"value": true}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 8}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [19], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "slot_index": 1, "links": [], "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [340, 300], "pos": [380, 1020], "widgets_values": ["INPUT_CHARACTER.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 139, "type": "LoadImage", "title": "LoadImage", "properties": {"widget_ue_connectable": {"image": true}, "Node name for S&R": "LoadImage"}, "order": 9}, {"mode": 0, "outputs": [{"name": "av_latent", "slot_index": 0, "links": [11], "label": "av_latent", "type": "LATENT", "localized_name": "av_latent"}, {"name": "source_audio", "slot_index": 1, "links": [27], "label": "source_audio", "type": "AUDIO", "localized_name": "source_audio"}], "size": [340, 300], "pos": [760, 1020], "widgets_values": ["lock", 0], "inputs": [{"name": "av_latent", "link": 20, "label": "av_latent", "type": "LATENT", "localized_name": "av_latent"}, {"name": "source_audio", "link": 21, "label": "source_audio", "type": "AUDIO", "localized_name": "source_audio"}, {"name": "audio_vae", "link":