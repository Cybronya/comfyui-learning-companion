佳能单反拍摄，柔和无影棚内柔光，肤色自然通透，服装纹理清晰，色彩真实还原，极简低饱和纯色背景，画面干净无杂物无道具。\n\n人物淡妆，无夸张表情，电商商品展示图质感，高细节，无文字无水印无logo。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": true}, "id": 4, "type": "JjkText", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "JjkText"}, "order": 1}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [663.790283203125, 889.490478515625], "pos": [1862.408203125, 387.6005859375], "widgets_values": ["换装"], "inputs": [{"name": "images", "link": 3, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 5, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.8.2", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 3}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-79.9381977900008, -18.47952506000115], "scale": 0.5131581182307069}}, "groups": [], "links": [[1, 3, 0, 1, 0, "IMAGE"], [2, 4, 0, 1, 10, "STRING"], [3, 1, 0, 5, 0, "IMAGE"]], "id": "5e583f76-ba27-4c8e-bc18-6bec009533b1", "config": {}, "version": 0.4, "last_node_id": 6, "revision": 0}