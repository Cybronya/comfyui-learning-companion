e": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 15}, {"mode": 4, "outputs": [{"name": "images", "links": [], "label": "images", "type": "IMAGE", "localized_name": "images"}, {"name": "response", "links": [], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "image_urls", "links": [], "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [397.2602844238281, 921.9723510742188], "pos": [903.6655883789062, -46.28958511352539], "widgets_values": ["请对这张破损老照片进行专业级高清修复。\n\n任务目标:\n将原始老照片修复为一张完整、自然、清晰、高清的彩色照片，同时尽可能保留原照片中人物的真实五官、神态、年龄感、发型、服装轮廓和时代气质。\n\n修复要求:\n1. 去除照片中的破损、污渍、霉斑、划痕、褪色、泛黄、水渍、纸张裂痕和大面积脱落痕迹。\n2. 对缺失区域进行合理补全，但不要随意改变人物身份特征，不要把人物修成完全不同的人。\n3. 增强人像，保留可见人物的脸型、眼睛、鼻子、嘴巴、发型、表情和服装结构，修复后仍应像原照片中的人。\n4. 对严重缺失的人物或背景区域，根据原图残留信息进行自然、可信的重建，使画面完整协调。\n5. 将黑白或褪色照片自然上色，肤色真实，头发、衣服、背景颜色符合旧时代人像照片的质感。\n6. 提升照片清晰度、细节、对比度和光影层次，移除模糊，高清RAW级别细节重置，带来令人惊叹的质感细节提升。\n7. 保持照片的年代感和真实摄影质感，不要过度磨皮，不要变成现代网红写真。\n8. 背景保持简洁自然，还原原照片中的朴素背景。\n9. 输出高清、高分辨率、自然真实的彩色修复照片。\n\n风格要求:\n真实照片风格，老照片修复，高清彩色化，细节自然，柔和光线，真实皮肤纹理，保留年代感，专业影像修复效果。\n\n避免:\n不要卡通化，不要油画化，不要动漫风，不要过度美颜，不要改变人物年龄，不要改变五官结构，不要让人物看起来像现代写真，不要生成夸张表情，不要添加无关物体，不要让背景杂乱，", "edit", "", "medium", "custom", 3840, 3840, 1, "png", "image_url", 14202077, "fixed", 10, 300, true], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "mask", "label": "mask", "type": "IMAGE", "localized_name": "mask"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"n