fl2va_int8_convrot.safetensors"}}, {"outputs": [{"name": "STRING", "links": [342], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["### 8 秒竖版立冬 MG 动画提示词（简化版）\n\n8 秒竖版国风 MG 动画，暖橙与秋黄色调，磨砂纸张和叶片肌理背景，整体节奏舒缓、干净、克制。\n\n画面采用分层淡入动效：\n背景先由朦胧逐渐清晰，暖光轻微呼吸变化；品牌标识缓慢浮现；“立冬” 书法标题从淡墨中逐字显现；英文小字同步柔和淡入；副标题随后渐显；雪花从上方缓慢飘落；底部项目信息栏轻轻上移落版。\n所有元素移动幅度小，无复杂转场，无夸张弹跳，保持平稳流畅。\n\n最后 2 秒完整定格，画面稳定清晰，营造温润雅致的冬日节气氛围。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [370, 390], "pos": [799.3755739210281, 198.34710743801602], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 4, "widgets_values_named": {"value": "### 8 秒竖版立冬 MG 动画提示词（简化版）\n\n8 秒竖版国风 MG 动画，暖橙与秋黄色调，磨砂纸张和叶片肌理背景，整体节奏舒缓、干净、克制。\n\n画面采用分层淡入动效：\n背景先由朦胧逐渐清晰，暖光轻微呼吸变化；品牌标识缓慢浮现；“立冬” 书法标题从淡墨中逐字显现；英文小字同步柔和淡入；副标题随后渐显；雪花从上方缓慢飘落；底部项目信息栏轻轻上移落版。\n所有元素移动幅度小，无复杂转场，无夸张弹跳，保持平稳流畅。\n\n最后 2 秒完整定格，画面稳定清晰，营造温润雅致的冬日节气氛围。"}}, {"outputs": [{"name": "IMAGE", "links": [340], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#232", "widgets_values": ["0bd1b181d57e91f8b26feba29a741abec960637b6a43cb330662ce7019ef4815.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#353", "size": [290, 350], "pos": [40.40404040404029, 218.54912764003615], "id": 137, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 5, "widge