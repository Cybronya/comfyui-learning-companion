: "swap_io_components"}, {"widget": {"name": "offload_device"}, "shape": 7, "name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}, {"widget": {"name": "attention_mode"}, "shape": 7, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}], "flags": {}, "type": "SeedVR2LoadDiTModel", "mode": 0, "bgcolor": "#3f5159", "size": [297.5392761230469, 198.77886962890625], "pos": [1935.294677734375, -2030.4014892578125], "id": 45, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SeedVR2LoadDiTModel"}, "order": 8}, {"outputs": [{"name": "IMAGE", "links": [16, 24, 44], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#232", "widgets_values": ["bf8bab165b98cd043605c3a5ad9f4a1329fbd7d7871be65119e9838d512f3379.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#353", "size": [440, 650], "pos": [-760, -2020], "id": 12, "properties": {"cnr_id": "comfy-core", "ver": "0.3.50", "ue_properties": {"widget_ue_connectable": {"image": true, "upload": true}, "version": "7.0.1"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 9}, {"outputs": [], "color": "#891458", "widgets_values": ["# 🐛米大🐛🍺 使用说明 🍺\n\n## 版本：SeedVR2.5.1 最新版双重采样高清放大\n\n版本介绍：本版本是2.5.1双重采样高清放大版本，针对我上一版本只能通过单一规格参数模型放大，本版本多添加了二次采样，使用了低像素用3b+高像素用7b的放大思路，最大限度利用不同参数模型的优势以获得更好的放大效果。\n   本版本对人像高还原放大、多人合照像素修复、大量文字放大（含中英文）、矢量平面设计高清化等效果明显，放大后完全保持原对象的所有特征，解决了其他放大手段过分重绘对象细节的缺点。\n### 模型介绍\n| 模型名称 |显存要求 |模型特性 |\n|---|---|---|\n| seedvr2 ema 3b fp8 e4m3fn |12-16g |生图后画面更为柔和，适合低像素的图放大|\n| seedvr2 ema 3b-Q4 K M.gguf |8-12g |对比fp8模型，细节会有轻微下降，但大幅度降低显存要求|\n| seedvr2 ema 7b-Q4 K M.gguf |12-16g  |生图后细节更多，适合高像素的图放大|\n| seedvr2 ema 7b-Q8 0.gguf | 16g |与fp8模型基本相同，对显存有一定要求|\n| seedvr2 ema 7b fp8 | 16g | 画面会出现方格纹，不建议使用|\n| seedvr2 ema 7b fp16 | 24g | 细节最好，但在本二次采样方案中使用会爆显存|\n\n注意：\n\n1、第一阶段：新版本对于原图尺寸较大（但成像质量不高的图）图片（2k左右的图）第一次通过开启图像按像素缩放节点，把原图尺寸缩小到20万像素左右通过使用3b模型首次放大（3b模型对低像素的图效果更好），生图尺寸范围上设置为1680-2480像素间（最长边尺寸，即可初步获得初步方法修正的效果。\n\n2、第二阶段：设置3280以上像素，并使用7bfp16模型进行放大（7b模型对高像素图片的放大效果更好，即可获得优秀的生图效果（若电脑配置不够的，可以使用7b_Q4_K_m.gguf量化版本模型）\n\n3、若对生图要求不高可以适当调高第一阶段生图尺寸，并自行禁用第二阶段\n\n4、（SeedVR2 (Down)Load DiT Model）节点中的（blocks to swap）选项指的是分块数量，对于3b模型填写0-32（建议直接填32），7b模型填写0-36（建议直接填32），其余参数建议不要修改\n\n5、（SeedVR2 Video Upscaler (v2.5.10)）节点中的max resolution选项指的是，生图后最长边的尺寸限制在多少像素，默认填写4500（若不限制，个别图片尺寸放大尺寸太大仍会爆显存。\n"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "title": "米大 SeedVR2.5.1 最新版双重采样高清放大", "mode": 0, "bgcolor": "#750044", "size": [570, 730], "pos": [-1360, -2090], "id": 32, "properties": {"widget_ue_connectable": {}}, "order": 10}], "extra": {"links_added_by_ue": [], "workspace_info": {"id": "0d0ec3a5-d4d8-4b88-9407-f164b83a9c90"}, "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [897.7649644037479, 2022.690348390593], "scale": 1.5535220464768966}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "第一阶段放大", "bounding": [1550.52685546875, -2117.71923828125, 1450, 760]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "缩小处理", "bounding": [1570.52685546875, -2067.71923828125, 317.7845458984375, 575.640869140625]}, {"color": "#bd004b", "font_size": 35, "flags": {}, "id": 12, "title": "操作区", "bounding": [-770, -2120, 2130, 760]}, {"color": "#8A8", "font_size": 20, "flags": {}, "id": 5, "title": "图像放大后最短边尺寸", "bounding": [-300, -1910, 252.99874877929688, 142.2727508544922]}, {"color": "#b58b2a", "font_size": 24, "flags": {}, "id": 7, "title": "第二阶段放大", "bounding": [3030, -2120, 710, 760]}, {"color": "#8A8", "font_size": 20, "flags": {}, "id": 11, "title": "图像放大后最短边尺寸", "bo