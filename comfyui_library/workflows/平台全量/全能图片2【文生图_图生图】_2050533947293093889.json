ets_values": ["image为参考图，生成一张纯白人物角色三视图：正面全身照、侧面全身照、背面全身照，最左侧放大脸部细节展示；要求服装、发型、配饰等所有细节在三个视角中完全一致，高度保持与参考图一致。画面要求：纯白背景，无阴影。服装剪裁合身。角色描述:一位58岁中国老人，里看上去比实际年龄更苍老。他身形佝偻消瘦，双肩向前蜷缩。暴露在外的前臂和脖颈皮肤黝黑粗糙，可见老年斑。头发花白稀疏且凌乱，两鬓全白。脸上布满深深的皱纹，皮肤因日晒而黝黑粗糙，眼窝凹陷，法令纹如沟壑般深刻，浑浊的双眼透出一生的艰辛。表情中性，嘴角微微下垂，目光沉重。身穿一件严重褪色的薄款深蓝色短袖旧工装衬衫，衣领和袖口边缘因多年穿着已磨损发白起毛，面料因洗过多次而松软，在他瘦削的身躯上微微塌垂。下身是深灰色薄棉长裤，膝盖处有已固定的褶皱痕迹。脚穿黑色旧布鞋，鞋底边缘已磨平，鞋头有灰白色污渍，未穿袜子。双手粗糙变形，骨节粗大，指甲缝有黑色污渍。他面向镜头站立，双臂微向前垂，姿态沉重而颓丧。柔和的侧前散射光，带有暖黄色底色，高光柔和过渡，阴影柔软羽化，干净而略带忧郁的炎热夏夜氛围。真人写实风格，日系治愈电影风格的光影与色调。 真人写实风格，电影级质感，35mm胶片感。无标注。\n为人物脸部增加细节：皮肤毛孔、老年斑清晰可见，T区略有油光。伦勃朗光，从左侧打来暖黄主光，右脸形成柔和三角形阴影。双眼有真实的泪膜反光，虹膜有细微纹理。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "type": "CR Text", "mode": 0, "bgcolor": "#335", "size": [430.08001708984375, 401.7066345214844], "pos": [940.0747680664062, 602.2720947265625], "id": 5, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 1}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-205.32701243090446, -173.69945163983095], "scale": 0.9090909090909091}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "NanoBanana2   【4K0.2元一次/2K0.16元一次】", "bounding": [352.3308410644531, 16.084850311279297, 1584.25634765625, 1048.0001220703125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "Group", "bounding": [1421.2452392578125, 145.07089233398438, 140, 80]}], "links": [[1, 2, 0, 6, 0, "IMAGE"], [2, 4, 0, 2, 0, "IMAGE"], [3, 5, 0, 2, 10, "STRING"]], "id": "cd10240f-32ab-4ea4-9c63-f2d41a5d6a1f", "config": {}, "version": 0.4, "last_node_id": 7, "revision": 0}