e": "offload_device"}, {"widget": {"name": "attention_mode"}, "shape": 7, "name": "attention_mode", "label": "attention_mode", "type": "COMBO", "localized_name": "attention_mode"}], "flags": {}, "type": "SeedVR2LoadDiTModel", "mode": 0, "bgcolor": "#3f5159", "size": [334.5099182128906, 202], "pos": [-811.0419921875, -978.6513061523438], "id": 129, "properties": {"cnr_id": "seedvr2_videoupscaler", "ver": "2.5.10", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "SeedVR2LoadDiTModel"}, "order": 1}, {"outputs": [], "color": "#432", "widgets_values": ["模型地址：\nhttps://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler\n\n型号：选择您的 DiT 型号\n\n3B 型号：速度更快，显存需求更低\nseedvr2_ema_3b_fp16.safetensorsFP16（最佳质量）\nseedvr2_ema_3b_fp8_e4m3fn.safetensorsFP8 8位（高质量）\nseedvr2_ema_3b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\nseedvr2_ema_3b-Q8_0.ggufGGUF 8 位量化（高质量）\n\n7B 型号：画质更高，显存需求更高\nseedvr2_ema_7b_fp16.safetensorsFP16（最佳质量）\nseedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors：FP8，最后一个数据块使用FP16，以减少伪影（质量良好）\n\nseedvr2_ema_7b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\nseedvr2_ema_7b_sharp_*：锐化版本，增强细节\n设备：用于 DiT 推理的 GPU 设备（例如，cuda:0）\n\noffload_device：当 DiT 模型不处于活跃处理状态时，用于卸载 DiT 模型的设备\n\nnone：将模型保存在推理设备（速度最快、显存最大的设备）上\ncpu：卸载到系统内存（减少显存）\ncuda:X：将负载转移到另一块GPU（如果可用，则可获得良好的负载均衡）\ncache_model：在工作流运行之间，保持卸载设备上的 DiT 模型加载状态\n\n适用于批量处理，避免重复加载\n需要设置 offload_device\nblocks_to_swap：块交换内存优化\n\n0：已禁用（默认）\n1-32：需要替换为 3B 型号的变压器模块数量\n1-36：需要更换为 7B 型号的变压器模块数量\n数值越高，节省的显存越多，但处理速度越慢。\n需要设置 offload_device 并且使其与 device 不同。\nswap_io_components：卸载输入/输出嵌入和归一化层\n\n结合 blocks_to_swap 可进一步节省 VRAM\n需要设置 offload_device 并且使其与 device 不同。\nattention_mode：注意力计算后端\n\nsdpa: PyTorch scaled_dot_product_attention（默认值，稳定，始终可用）\nflash_attnFlash Attention 2（在支持的硬件上速度更快，需要 flash-attn 软件包）\ntorch_compile_args：连接到 SeedVR2 Torch 编译设置节点，可提升 20-40% 的速度。\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [620.6390380859375, 641.826171875], "pos": [-1503.04638671875, -1018.6102905273438], "id": 183, "properties": {"widget_ue_connectable": {}}, "order": 2}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#2a363b", "widgets_values": ["SeedVR2/Image/"], "inputs": [{"name": "images", "link": 342, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "type": "SaveImage", "mode": 0, "bgcolor": "#3f5159", "size": [254.7951202392578, 308.7230529785156], "pos": [622.3799438476562, -131.8981475830078], "id": 182, "properties": {"cnr_id": "comfy-core", "ver": "0.18.1", "widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 15}, {"outputs": [{"name": "IMAGE", "links": [291], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "color": "#2a363b", "widgets_values": ["lanczos", 2], "inputs": [{"name": "image", "link": 255, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": "scale_by"}, "name": "scale_by", "link": 344, "label": "scale_by", "type": "FLOAT", "localized_name": "scale_by"}], "flags": {}, "type": "ImageScaleBy", "mode": 0, "bgcolor": "#3f5159", "size": [210, 82], "pos": [-1955.1981201171875, -65.9725570678711], "id": 142, "properties": {"cnr_id": "comfy-core", "ver": "0.3.67", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.4.1"}, "widget_ue_connectable": {}, "Node name for S&R": "ImageScaleBy"}, "order": 5}, {"mode": 0, "outputs": [{"name": "FLOAT", "links": [344], "label": "FLOAT", "type": "FLOAT", "localized_name": "FLOAT"}], "size": [270, 58], "pos": [-2333.31396484375, 204.47142028808594], "widgets_value