e": "text"}], "flags": {}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#355", "size": [272.8364562988281, 252.51779174804688], "pos": [1307.0975341796875, 1159.1541748046875], "id": 44, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "f2838ed5e59de4d73cde5c98354b87a8d3200190", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 10}, {"mode": 0, "outputs": [{"name": "response", "links": [72, 73], "label": "response", "type": "STRING", "localized_name": "response"}], "size": [305.9986877441406, 318], "pos": [895.2568359375, 1123.044189453125], "widgets_values": ["gemini-3-flash-preview", "“请为我生成1组用于 AI 绘画的提示词。主题是‘2026 农历新年’，请基于以下框架进行创作：\n\n1.角色一致性：保持‘图 1’的引用，设定为身穿华丽的中式传统服装（如婚服、旗袍或唐装）。\n\n2.视觉细节： 必须包含精致的细节描述，例如：头戴‘繁复金冠缀红绒球’、衣服上有‘金色龙凤刺绣’。\n\n3.互动道具： 每一组提示词需设计不同的互动，如手持卷轴（写有具体吉祥话）、双手抱拳或持有灯笼。\n\n4.文字要求： 明确要求在背景或道具中出现‘2026’、‘新年快乐’或‘招财进宝’等中文/数字内容。\n\n5.环境渲染： 背景需设定为极具中式美学的场景，包含红金配色、灯笼、元宝等元素，强调‘色彩浓烈’和‘节日氛围’。\n\n画质规范： 统一添加‘照片级真实感、高保真、8K分辨率、精致细节’等后缀。”\n直接给出提示词Prompt内容，不用多余的思考过程", "Hello", 0.6, 321850908, "randomize"], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"nam