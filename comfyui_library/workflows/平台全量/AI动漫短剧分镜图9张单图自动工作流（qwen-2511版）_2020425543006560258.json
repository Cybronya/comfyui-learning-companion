d": 109, "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "models": [{"name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "directory": "loras", "url": "https://huggingface.co/lightx2v/Qwen-Image-Edit-2511-Lightning/resolve/main/Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors"}], "ver": "0.5.1", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "LoraLoaderModelOnly", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 8}, {"mode": 0, "outputs": [{"name": "prompt", "links": [281], "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [511.00628662109375, 608.1180419921875], "pos": [-4062.363037109375, 297.28070068359375], "widgets_values": ["你是一个图像分镜提示词专家，根据图片以及用户提供的提示词，按照下面内容，生成图片九分镜提示词。\n\n核心格式：主视觉主题 + 分镜序号 + 画面景别 + 镜头动作 + 内容细节 + 风格 / 光影 / 画质\n通用基础模板（可直接替换【】内内容）：\n【核心主题】，九分镜系列，电影级分镜，连贯叙事\n全景，固定镜头，【开篇场景 / 核心主体出场】，环境氛围铺垫，柔和自然光，8K，超写实\n中景，缓慢推镜，【主体互动 / 关键动作起始】，细节刻画，侧光，高对比度，电影质感\n近景，跟拍镜头，【主体表情 / 局部动作】，情绪强化，顶光，细腻光影，高清细节\n特写，固定镜头，【核心道具 / 关键细节】，视觉聚焦，硬光，锐化处理，极致清晰\n中全景，摇镜，【场景转换 / 主体移动】，空间延伸，漫射光，色彩统一，叙事衔接\n中近景，拉镜头，【主体与环境关系】，氛围烘托，逆光，光晕效果，氛围感拉满\n特写，慢动作镜头，【关键瞬间 / 情绪爆发点】，动态捕捉，频闪光，高速摄影质感\n中景，固定镜头，【情节转折 / 对话 / 反应】，人物互动，平光，自然色彩，真实感\n全景，固定镜头，【结尾画面 / 主题升华】，收尾氛围，渐暗光影，留白构图，余韵感\n\n\n### 输出要求  \n仅返回9条提示词，每条独立成段，用换行分隔，无其他内容。  \n输出格式：【1】,【2】,【3】...\n\n\n### 示例如下：\n\n【1】：全景，固定镜头，【开篇场景 / 核心主体出场】，详细描述场景，环境氛围铺垫，柔和自然光，8K，超写实\n\n...（共9条）"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 127, "type": "CR Prompt Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 5}, {"mode": 0, "outputs": [{"name": "text", "links": [284], "label": "文本", "type": "*", "localized_name": "text"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [400, 200], "pos": [-3223.856201171875, 585.621826171875], "widgets_values": ["left side view, eye level, medium shot (horizontal: 270, vertical: 0, zoom: 5.0)，人物暴怒"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {}, "id": 132, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 6}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "links": [283], "label": "text", "type": "STRING", "localized_name": "text"}], "size": [515.7296142578125, 1114], "pos": [-2669.090087890625, 739.9185180664062], "widgets_values": ["【1】：全景，固定镜头，【开篇场景 / 核心主体出场】，夕阳映照山峦与古道，松柏苍劲，红日熔金，云雾缭绕，营造史诗对决前的肃穆氛围，柔和暖光渲染全局，8K，超写实", "【2】：中景，缓慢推镜，【主体互动 / 关键动作起始】，黑衣魔修挥舞赤链蓄势，白衣剑士凌空出招，剑刃蓝芒划破空气，火花四溅，侧光勾勒肌肉线条，高对比度增强戏剧张力，电影质感", "【3】：近景，跟拍镜头，【主体表情 / 局部动作】，黑袍者冷眸凝视对手，嘴角微扬带杀意；白衣修士眉目坚毅，双臂舒展如风，顶光照亮面庞轮廓，细腻光影突出神情变化，高清细节", "【4】：特写，固定镜头，【核心道具 / 关键细节】，红色锁链缠绕飞旋，末端骷髅徽章闪烁寒光；青玉剑鞘嵌绿宝石，在月牙纹饰腰带上折射光芒，硬光突显材质纹理，极致清晰", "【5】：中全景，摇镜，【场景转换 / 主体移动】，镜头从地面裂痕缓缓上移至两人对峙之巅，石阶崩塌、岩浆蔓延，背景群峰隐现于霞光之中，漫射光融合橙红调色板，色彩统一推动剧情节奏", "【6】：中近景，拉镜头，【主体与环境关系】，白衣战士腾跃半空，脚下碎石翻滚，热浪蒸腾形成朦胧烟幕；身后悬崖峭壁若隐若现，逆光塑造剪影美感，光晕环绕周身，氛围感拉满", "【7】：特写，慢动作镜头，【关键瞬间 / 情绪爆发点】，剑锋与铁链即将相撞的一瞬——气流撕裂虚空，火星炸裂迸发，尘土悬浮定格，频闪特效模拟高速碰撞冲击波，高速摄影质感凸显力量美学", "【8】：中景，固定镜头，【情节转折 / 对话 / 反应】，双方目光交汇刹那静止，黑白对立意志在空气中无声交锋，黑袍人低语未言而袖口血花绽放，白衣人瞳孔收缩似有所悟，平光还原现实肌理，真实感十足", "【9】：全景，固定镜头，【结尾画面 / 主题升华】，落日沉入远山尽头，两身影残存于焦灼战场中央，地脉符文仍在燃烧发光，天地寂静唯有回响，渐暗光影制造悲壮余音，留白构图引观众遐思"], "inputs": [{"name": "text", "link": 278, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"collapsed": false}, "id": 130, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 17}, {"mode": 0, "outputs": [{"shape": 6, "name": "list", "links": [278], "label": "list", "type": "STRING", "localized_name": "list"}], "size": [158.67083740234375, 26], "pos": [-2709.927734375, 10.326272010803223], "widgets_va