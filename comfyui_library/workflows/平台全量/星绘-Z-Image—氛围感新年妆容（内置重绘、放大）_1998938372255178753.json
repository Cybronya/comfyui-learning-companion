。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 162, "type": "CR Text", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "CR Text"}, "order": 2}, {"mode": 4, "outputs": [{"name": "CLIP", "links": [186], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "size": [370.35845947265625, 106], "pos": [1247.7059326171875, 1677.791748046875], "widgets_values": ["qwen_3_4b.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "clip_name"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "type"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "device"}], "flags": {}, "id": 165, "type": "CLIPLoader", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 3}, {"mode": 4, "outputs": [{"name": "VAE", "links": [191, 195, 211], "label": "VAE", "type": "VAE", "localized_name": "VAE"}], "size": [210, 59.48643493652344], "pos": [1252.7216796875, 1824.6544189453125], "widgets_values": ["ae.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {}, "id": 166, "type": "VAELoader", "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader"}, "order": 4}, {"mode": 4, "outputs": [{"name": "IMAGE", "links": [192, 196], "label": "IMAGE", "type"