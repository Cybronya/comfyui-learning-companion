de name for S&R": "EmptyLatentImage"}, "order": 7}, {"mode": 0, "outputs": [{"shape": 3, "name": "SEED", "links": [260], "label": "随机种", "dir": 4, "type": "INT"}], "size": [241.40927124023438, 130], "pos": [1464.6448974609375, 1809.7965087890625], "widgets_values": [535515562074938, "", "", ""], "inputs": [], "flags": {}, "id": 120, "type": "Seed (rgthree)", "properties": {"cnr_id": "rgthree-comfy", "ver": "8ff50e4521881eca1fe26aec9615fc9362474931", "randomMin": 0, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "randomMax": 1125899906842624}, "order": 8}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [137], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "size": [405.5103759765625, 453.7420349121094], "pos": [656.6793823242188, 1863.638916015625], "widgets_values": ["一位古风年轻女子，以慵懒而富有张力的斜倚姿态侧卧于低矮木案旁：左肘轻撑于案面，指尖微屈，右臂自然垂落，掌心轻贴地面，身体呈优雅S形曲线；头部微微后仰，颈线修长，目光如丝线般直刺镜头，眼波流转，带一丝狡黠与挑逗；银质小铃铛悬于唇间，舌尖若隐若现轻触铃舌，似正欲轻摇却凝滞于刹那——铃铛随呼吸微微颤动，营造“将响未响”的悬停张力。\n发型为高耸饱满的堕马髻，一侧垂落一缕青丝拂过锁骨，随动作微扬；发间错落插着多支银质发簪：扇形镶红宝石簪斜贯发髻顶端，鸟雀造型簪衔于鬓角，简约圆头簪稳压后髻，蝴蝶步摇随体态轻晃，缀有细链与蓝珠；一朵硕大蓝色绢花盛放于耳畔，搭配同色流苏垂至肩头，在光线下泛出柔润光泽。\n妆容为精致古典桃花妆：眼睑以暖棕与灰粉晕染出深邃层次，上眼线纤细上扬如新月；颧骨处大面积扫以粉橘色珠光腮红，如醉霞晕染；唇部为饱满正红色咬唇妆，唇峰清晰，唇珠微润，与铃铛形成视觉焦点联动。\n身着深藏青色真丝交领汉服，衣料垂坠感强、光泽内敛；衣身遍布银灰色写意花卉枝叶刺绣（藤蔓舒展、叶片翻卷），非对称分布，富于呼吸感；领口、袖缘及前襟镶宽幅银灰织锦边（卷草纹与云气纹交织），袖口下方另有一道银色回纹窄边收束；广袖外层覆浅蓝渐变半透薄纱，随动作飘逸起伏，透出内衬肌理；腰间系银灰暗纹刺绣腰封，缀一排细小银铃，与口中铃铛遥相呼应。\n背景为深褐色老榆木墙面与雕花木门，左侧虚化处可见青瓷花瓶中插着白菊与淡紫小花；一束侧逆光从左上方洒落，勾勒发丝轮廓与衣褶高光，营造电影级柔焦氛围；超高清8K写实摄影风格，皮肤纹理、丝绸反光、金属錾刻、刺绣针脚均纤毫毕现，浅景深突出主体，整体氛围静谧中暗涌情愫，古典雅致与现代叙事感交融。"], "inputs": [{"name": "clip", "link": 727, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 759, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": true}, "id": 71, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.75", "ue_properties": {"widget_ue_connectable":