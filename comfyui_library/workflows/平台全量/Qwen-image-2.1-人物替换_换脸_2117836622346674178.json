ength", "label": "max_length", "type": "INT", "localized_name": "最大长度"}, {"widget": {"name": "sampling_mode"}, "name": "sampling_mode", "label": "sampling_mode", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "采样模式"}, {"widget": {"name": "sampling_mode.temperature"}, "name": "sampling_mode.temperature", "label": "sampling_mode.temperature", "type": "FLOAT", "localized_name": "温度"}, {"widget": {"name": "sampling_mode.top_k"}, "name": "sampling_mode.top_k", "label": "sampling_mode.top_k", "type": "INT", "localized_name": "Top K"}, {"widget": {"name": "sampling_mode.top_p"}, "name": "sampling_mode.top_p", "label": "sampling_mode.top_p", "type": "FLOAT", "localized_name": "Top P"}, {"widget": {"name": "sampling_mode.min_p"}, "name": "sampling_mode.min_p", "label": "sampling_mode.min_p", "type": "FLOAT", "localized_name": "最小概率"}, {"widget": {"name": "sampling_mode.repetition_penalty"}, "name": "sampling_mode.repetition_penalty", "label": "sampling_mode.repetition_penalty", "type": "FLOAT", "localized_name": "重复惩罚"}, {"widget": {"name": "sampling_mode.seed"}, "name": "sampling_mode.seed", "label": "sampling_mode.seed", "type": "INT", "localized_name": "种子"}, {"widget": {"name": "sampling_mode.presence_penalty"}, "shape": 7, "name": "sampling_mode.presence_penalty", "label": "sampling_mode.presence_penalty", "type": "FLOAT", "localized_name": "presence_penalty"}, {"widget": {"name": "thinking"}, "shape": 7, "name": "thinking", "label": "thinking", "type": "BOOLEAN", "localized_name": "思考模式"}, {"widget": {"name": "use_default_template"}, "shape": 7, "name": "use_default_template", "label": "use_default_template", "type": "BOOLEAN", "localized_name": "use_default_template"}, {"widget": {"name": "mtp"}, "shape": 7, "name": "mtp", "label": "mtp", "type": "COMBO", "localized_name": "mtp"}], "flags": {}, "type": "TextGenerateLTX2Prompt", "mode": 0, "bgcolor": "#335", "size": [341.0334167480469, 456], "pos": [1028.31663862036, 5379.103533930548], "id": 35, "properties": {"cnr_id": "comfy-core", "ver": "0.36.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "TextGenerateLTX2Prompt", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 19, "widgets_values_named": {"sampling_mode.top_p": 0.95, "sampling_mode.presence_penalty": 0, "mtp": "auto", "use_default_template": false, "sampling_mode.repetition_penalty": 1.05, "thinking": true, "sampling_mode.temperature": 0.7, "sampling_mode.seed": 666, "sampling_mode.top_k": 64, "prompt": "参照图片风格构图以及色彩生成一张巨大的中式古代宫殿的图片", "sampling_mode": "on", "sampling_mode.min_p": 0.05, "max_length": 4096}}, {"outputs": [{"name": "CLIP", "links": [42], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#223", "widgets_values": ["qwen3.5_9b_w4a8_gptq.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#335", "size": [336.38262939453125, 106], "pos": [663.4801730348961, 5454.849720940738], "id": 36, "properties": {"cnr_id": "comfy-core", "models": [{"name": "qwen3vl_8b_int8_convrot.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors"}], "ver": "0.36.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 9, "widgets_values_named": {"clip_name": "qwen3.5_9b_w4a8_gptq.safetensors", "type": "qwen_image", "device": "default"}}, {"outputs": [{"name": "output", "links": [], "label": "output", "type": "*", "localized_name": "输出"}], "color": "#223", "widgets_values": ["{\n  \"全局编辑指令\": \"将图1中的女性人物形象完整替换到图2的场景中，保留图1人物的面部特征、服装款式和神态气质，同时将人物的肢体动作调整为图2的姿势，并置于图2的背景环境中。\",\n  \"光影\": \"光源来自人物正前方略偏上方的位置，光线柔和且均匀，呈现出典型的摄影棚柔光箱效果。光线明亮而不刺眼，大面积地照亮了人物的面部和上半身。光线在人物额头、鼻梁、下巴以及锁骨处形成自然的高光，增强了面部的立体感和皮肤的光泽感。光线打在米白色的礼服面料上，顺着衣服表面的纹理产生细腻的反射，突出了丝绸般的质感。颈部和肩部的轮廓光清晰，与背景形成柔和的分离，整体光影色调偏向暖白，营造出清新、明亮且高级的视觉氛围。\",\n  \"背景\": \"使用图2的背景。背景是一面干净的白色墙面，上面绘制或张贴着蓝天白云的图案，色彩明快，增加了画面的空间感。背景深处模糊地呈现出一些彩色的物体，看起来像是室内的货架或展示架，上面摆放着各种小物件，处于焦外虚化状态。背景整体干净简洁，通过浅景深处理突出了前景的人物主体。\",\n  \"人物\": [\n    {\n      \"位置\": \"画面正中央\",\n      \"姿势\": \"双手抬起，手掌轻扶在头部两侧，手臂自然向上伸展，做出类似佩戴飞行头盔的动作，身体端正直立，微微面向镜头\",\n      \"服装\": \"身穿一套米白色的露肩礼服，面料具有明显的光泽感，肩部设计宽大，有着自然的垂坠褶皱，领口呈心形剪裁，完美露出圆润的肩头和修长的颈部线条，耳朵上佩戴着细长的金属流苏耳坠\",\n      \"发型\": \"留着黑色的短发，发质柔顺有光泽，刘海部分略显凌乱地垂在额前，几缕碎发自然地散落在脸颊两侧，显得干练而时尚\",\n      \"表情\": \"神情端庄且自信，眼神清澈明亮，直视镜头，嘴唇涂抹着浓郁的深红色口红，嘴角微微抿起，展现出一种优雅的气质\"\n    }\n  ]\n}"], "inputs": [{"shape": 7, "name": "anything", "link": 56, "label": "输入任何", "type": "*", "localized_name": "输入任何"}], "flags": {}, "type": "easy showAnything", "mode": 0, "bgcolor": "#335", "size": [492.11846923828125, 439.6435241699219], "pos": [1483.4700714524913, 5382.937734313055], "id": 37, "properties": {"cnr_id": "comfyui-easy-use", "ver": "d9c2072a2de5f51ef9898ec50ccd4dda82e16126", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 21, "widgets_values_named": {"text": "{\n  \"全局编辑指令\": \"将图1中的女性人物形象完整替换到图2的场景中，保留图1人物的面部特征、服装款式和神态气质，同时将人物的肢体动作调整为图2的姿势，并置于图2的背景环境中。\",\n  \"光影\": \"光源来自人物正前方略偏上方的位置，光线柔和且均匀，呈现出典型的摄影棚柔光箱效果。光线明亮而不刺眼，大面积地照亮了人物的面部和上半身。光线在人物额头、鼻梁、下巴以及锁骨处形成自然的高光，增强了面部的立体感和皮肤的光泽感。光线打在米白色的礼服面料上，顺着衣服表面的纹理产生细腻的反射，突出了丝绸般的质感。颈部和肩部的轮廓光清晰，与背景形成柔和的分离，整体光影色调偏向暖白，营造出清新、明亮且高级的视觉氛围。\",\n  \"背景\": \"使用图2的背景。背景是一面干净的白色墙面，上面绘制或张贴着蓝天白云的图案，色彩明快，增加了画面的空间感。背景深处模糊地呈现出一些彩色的物体，看起来像是室内的货架或展示架，上面摆放着各种小物件，处于焦外虚化状态。背景整体干净简洁，通过浅景深处理突出了前景的人物主体。\",\n  \"人物\": [\n    {\n      \"位置\": \"画面正中央\",\n      \"姿势\": \"双手抬起，手掌轻扶在头部两侧，手臂自然向上伸展，做出类似佩戴飞行头盔的动作，身体端正直立，微微面向镜头\",\n      \"服装\": \"身穿一套米白色的露肩礼服，面料具有明显的光泽感，肩部设计宽大，有着自然的垂坠褶皱，领口呈心形剪裁，完美露出圆润的肩头和修长的颈部线条，耳朵上佩戴着细长的金属流苏耳坠\",\n      \"发型\": \"留着黑色的短发，发质柔顺有光泽，刘海部分略显凌乱地垂在额前，几缕碎发自然地散落在脸颊两侧，显得干练而时尚\",\n      \"表情\": \"神情端庄且自信，眼神清澈明亮，直视镜头，嘴唇涂抹着浓郁的深红色口红，嘴角微微抿起，展现出一种优雅的气质\"\n    }\n  ]\n}"}}, {"outputs": [{"name": "text", "links": [45], "label": "text", "type": "STRING", "localized_name": "text"}], "color": "#232", "widgets_values": ["你是图像编辑指令的优化助手。根据用户的编辑指令和用户提供的图像，把指令补全成直白、精准的描述，只写画面中要呈现的内容，不添加修饰性词语。\n\n【输入】\n- 图1：提供替换进来的人物。\n- 图2：被替换的图像，提供背景、姿势和光影。\n\n【描述要求】\n1. 光影：完全沿用图2的光影。详细描述光源方向、光斑位置、明暗分布、光影色调，以及光影落在人物身上的效果。\n2. 背景：明确写出\"使用图2的背景\"，并具体描述图2的背景内容。\n3. 姿势：明确写出\"使用图2的姿势\"，并具体描述每个人物的姿势。\n4. 人物：按照用户要求逐个描述替换后每个人物的位置、服装、发型、表情。\n5. 服装完整度：\n   - 图1是半身、图2是全身：补全缺失部分，搭配与已有服装协调的款式，完整描述整套服装。\n   - 图1和图2都是半身：只描述半身服装。\n   - 图1是全身、图2是半身：只描述半身服装。\n6. 表述方式：全部使用肯定句，直接写出要呈现的效果，禁止使用\"不要\"\"不能\"\"避免\"等否定表达。\n\n【输出格式】\n只输出一个 JSON 对象，不输出任何其他文字。JSON 的值用自然语言书写，字段顺序固定如下：\n{\n  \"全局编辑指令\": \"\",\n  \"光影\": \"\",\n  \"背景\": \"\",\n  \"人物\": [\n    {\"位置\": \"\", \"姿势\": \"\", \"服装\": \"\", \"发型\": \"\", \"表情\": \"\"}\n  ]\n\n总共不少于400字"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "type": "LayerUtility: TextBox", "title": "系统提示词（我自用的，挺好用的）", "mode": 0, "bgcolor": "#353", "size": [326.2659869223436, 171.81720649857925], "pos": [-432.84629335346256, 4500.781050716766], "id": 38, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: TextBox"}, "order": 10, "widgets_values_named": {"text": "你是图像编辑指令的优化助手。根据用户的编辑指令和用户提供的图像，把指令补全成直白、精准的描述，只写画面中要呈现的内容，不添加修饰性词语。\n\n【输入】\n- 图1：提供替换进来