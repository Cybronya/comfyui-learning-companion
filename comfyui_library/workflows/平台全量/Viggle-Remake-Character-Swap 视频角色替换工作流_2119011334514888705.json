AE", "type": "VAE", "localized_name": "VAE"}], "color": "#432", "widgets_values": ["minimax_h3_audio_vae_fp32.safetensors"], "inputs": [{"widget": {"name": "vae_name"}, "name": "vae_name", "label": "vae_name", "type": "COMBO", "localized_name": "vae_name"}], "flags": {"collapsed": false}, "type": "VAELoader", "title": "Audio VAE", "mode": 0, "bgcolor": "#653", "size": [400, 82], "pos": [800, 880], "id": 32, "properties": {"cnr_id": "comfy-core", "ver": "0.44.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {"vae_name": true}, "Node name for S&R": "VAELoader", "ttNbgOverride": {"bgcolor": "#653", "groupcolor": "#b58b2a", "color": "#432"}}, "order": 11, "widgets_values_named": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Viggle Remake — character swap, one segment at a time\n\n**Before you start — Frame Grabber:** drop your video in, it converts it to 24 fps. Scrub to the frame you want, note the frame number, download the still and the 24 fps video.\n\n1. **Edit the still** with an image tool (e.g. ChatGPT): **change only the person** — keep everything else identical, same aspect ratio.\n2. **Load the 24 fps video** in *Load the 24 fps video* and type the frame number into *Frame to edit*.\n3. **Upload the edited still** into *Edited frame* and describe *The new character* (optionally *What he does*).\n4. **Run.** The result is saved to `ViggleRemake/swap`. Want another take? Change the *Seed*.\n\n**Limits (handled automatically)**\n- Length is snapped to 17n+5 frames (*Frames used* shows it).\n- 736p: up to ~7 s (≤ 175 frames) on a 32 GB GPU. 480p: up to ~14 s.\n- For 480p, set `short_edge` to 480 in *Conditioning*; *Max frames* can then go up to 345.\n- The clip needs at least 90 frames (≈ 3.75 s)."], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "How to use", "mode": 0, "bgcolor": "#653", "size": [980, 380], "pos": [0, -420], "id": 33, "properties": {"widget_ue_connectable": {}}, "order": 12, "widgets_values_named": {"text": "## Viggle Remake — character swap, one segment at a time\n\n**Before you start — Frame Grabber:** drop your video in, it converts it to 24 fps. Scrub to the frame you want, note the frame number, download the still and the 24 fps video.\n\n1. **Edit the still** with an image tool (e.g. ChatGPT): **change only the person** — keep everything else identical, same aspect ratio.\n2. **Load the 24 fps video** in *Load the 24 fps video* and type the frame number into *Frame to edit*.\n3. **Upload the edited still** into *Edited frame* and describe *The new character* (optionally *What he does*).\n4. **Run.** The result is saved to `ViggleRemake/swap`. Want another take? Change the *Seed*.\n\n**Limits (handled automatically)**\n- Length is snapped to 17n+5 frames (*Frames used* shows it).\n- 736p: up to ~7 s (≤ 175 frames) on a 32 GB GPU. 480p: up to ~14 s.\n- For 480p, set `short_edge` to 480 in *Conditioning*; *Max frames* can then go up to 345.\n- The clip needs at least 90 frames (≈ 3.75 s)."}}, {"outputs": [], "color": "#fff0", "inputs": [], "flags": {"allow_interaction": true}, "type": "Label (rgthree)", "title": "Viggle-Remake-Character-Swap 视频角色替换工作流", "mode": 0, "bgcolor": "#fff0", "size": [2838.515625, 120], "pos": [1026.4276763715047, -175.198435894586], "id": 36, "properties": {"padding": 0, "backgroundColor": "transparent", "fontFamily": "Arial", "borderRadius": 0, "textAlign": "left", "widget_ue_connectable": {}, "fontSize": 120, "fontColor": "#ffffff"}, "order": 13}], "extra": {"links_added_by_ue": [], "anomalous_hashes": {"32_minimax_h3_audio_vae_fp32.safetensors": {"size": 605254808, "hash": "", "url": ""}, "28_viggle_remake_swap_pruned_int8_convrot.safetensors": {"size": 20970379616, "hash": "", "url": ""}, "31_minimax_h3_video_vae_fp16.safetensors": {"size": 5207808496, "hash": "", "url": ""}, "30_qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors": {"size": 156