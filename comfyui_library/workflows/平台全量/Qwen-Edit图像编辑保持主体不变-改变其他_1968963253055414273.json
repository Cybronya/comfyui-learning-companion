lized_name": "比例宽"}, {"widget": {"name": "proportional_height"}, "name": "proportional_height", "type": "INT", "localized_name": "比例高"}, {"widget": {"name": "fit"}, "name": "fit", "type": "COMBO", "localized_name": "缩放模式"}, {"widget": {"name": "method"}, "name": "method", "type": "COMBO", "localized_name": "采样方法"}, {"widget": {"name": "round_to_multiple"}, "name": "round_to_multiple", "type": "COMBO", "localized_name": "倍数取整"}, {"widget": {"name": "scale_to_side"}, "name": "scale_to_side", "type": "COMBO", "localized_name": "缩放到边"}, {"widget": {"name": "scale_to_length"}, "name": "scale_to_length", "type": "INT", "localized_name": "缩放到长度"}, {"widget": {"name": "background_color"}, "name": "background_color", "type": "STRING", "localized_name": "background_color"}], "flags": {"collapsed": true}, "id": 202, "type": "LayerUtility: ImageScaleByAspectRatio V2", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LayerUtility: ImageScaleByAspectRatio V2"}, "order": 9}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [1506], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "条件"}], "size": [398.2400207519531, 238.7200164794922], "pos": [-2356.712890625, 1234.9215087890625], "widgets_values": [""], "inputs": [{"name": "clip", "link": 1493, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"shape": 7, "name": "image", "link": 2081, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 220, "type": "TextEncodeQwenImageEdit", "properties": {"cnr_id": "comfy-core", "ver": "0.3.50", "widget_ue_connectable": {}, "Node name for S&R": "TextEncodeQwenImageEdit"}, "order": 13}, {"outputs": [{"name": "describe", "links": [2145, 2196, 2378], "label": "describe", "type": "STRING", "localized_name": "describe"}], "color": "#233", "widgets_values": ["", "", "", "一、核心定位与目标\n角色是 “专业编辑指令重写器”，任务是将用户的原始指令（可能存在模糊、矛盾、信息缺失等问题）优化为 “精准、简洁、视觉可实现” 的编辑指令，且必须贴合待编辑图片的整体场景逻辑与风格，不改变用户原始指令的核心意图。\n二、三大核心重写规则\n1. 通用原则（所有重写都需遵守）\n精简优先：避免长句和多余描述，保持指令简洁。\n修正补全：若原始指令矛盾（如 “删所有树又留所有树”）、模糊（如只说 “加动物”）或不可实现，需合理推断修正，必要时补充关键细节（如类别、颜色、位置等）。\n贴合场景：新增 / 修改的内容必须符合待编辑图片的整体逻辑（比如给 “室内书桌图” 加 “台灯” 合理，加 “大树” 则不合理）。\n2. 分任务类型处理规则（针对 4 类常见编辑需求）\n（1）增减 / 替换任务（如 “加杯子”“删背景”“把椅子换成沙发”）\n指令清晰：若原始指令已包含 “任务类型（加 / 删 / 换）+ 目标物体 + 位置 / 数量 / 属性”，则保留意图，仅优化语法。\n指令模糊：补充最少但足够的细节，比如原始 “加动物”→ 重写 “在右下角加一只浅灰色坐着、面朝镜头的猫”。\n无效指令剔除：如 “加 0 个物体”，直接忽略或标记为无效。\n替换任务格式：需明确 “用 X 替换 Y”，并简要描述 X 的视觉特征（如 “用深棕色贝雷帽替换男士的帽子”）。\n（2）文本编辑任务（如 “加文字”“改标题”）\n文本标识：所有文本内容需用英文双引号包裹（但你后续要求 “不要双引号”，需忽略此标识要求），且不翻译、不改变原文本的语言和大小写。\n替换模板：文本替换必须用固定句式 ——“Replace 'xx' to 'yy'”（或 “Replace the xx bounding box to 'yy'”，即 “把 xx 文本框换成 yy”）。\n信息补全：若用户没指定文本内容（如只说 “给海报加一行字”），需结合图片场景推断（如重写 “在顶部中央加文本‘限量版’，带轻微阴影”），同时明确文本的位置、颜色、布局。\n（3）人物编辑任务（如 “改衣服”“换发型”“变背景”）\n保持核心一致性：不改变人物的核心视觉特征（种族、性别、年龄、发型、表情、穿搭风格等）。\n外观修改原则：改衣服 / 发型等时，新元素需贴合原风格（如给 “穿休闲装的人” 换 “运动外套” 合理，换 “晚礼服” 则不合理）；表情变化必须自然、不夸张。\n主体优先：若未明确要求 “删除人物”，需保留图片核心主体（如人、动物）；改背景时，优先强调 “保持主体不变”（例：原始 “改人的帽子”→ 重写 “用深棕色贝雷帽替换男士的帽子，保留其微笑、短发和灰色夹克不变”）。\n（4）风格转换 / 增强任务（如 “改成迪斯科风”“修复老照片”）\n指定风格：用关键视觉特征描述风格，如原始 “迪斯科风格”→ 重写 “1970 年代迪斯科风：带闪光灯、迪斯科球、镜面墙、多彩色调”。\n参考 / 保持风格：若指令是 “用参考风格” 或 “保持当前风格”，需先分析待编辑图片，提取核心特征（颜色、构图、质感、光线、艺术风格），再简洁整合到指令中。\n上色 / 老照片修复：有固定模板 ——“修复老照片，去除划痕，降低噪点，增强细节，提升分辨率，保证真实感，自然肤色，清晰面部特征，无变形，符合老照片修复质感”。\n其他改动：若同时有 “改内容 + 改风格”，风格描述放最后。\n3. 合理性与逻辑检查（避免指令无效）\n解决矛盾：如原始指令 “删除所有树但保留所有树”，需按逻辑修正（如 “删除背景中的杂树，保留主体旁的景观树”）。\n补充缺失信息：若原始指令没说 “位置”，则选图片中合理区域（如主体附近、空白处、边缘 / 中心），确保不破坏构图。\n三、输出格式与你的额外要求\n原指南示例：要求用 JSON 格式输出（键为 “Rewritten”，值为重写后的指令）。\n你的特殊要求：需输出简体中文文本，不使用 JSON 格式，也不使用双引号包裹文本。", "石头改成有苔藓的石头，石头上有草作为点缀", 0.6, 1668, "randomize"], "inputs": [{"shape": 7, "name": "ref_image", "link": 2099, "label": "ref_image", "type": "IMAGE", "localized_name": "ref_image"}, {"widget": {"name": "api_baseurl"}, "name": "api_baseurl", "label": "api_baseurl", "ty