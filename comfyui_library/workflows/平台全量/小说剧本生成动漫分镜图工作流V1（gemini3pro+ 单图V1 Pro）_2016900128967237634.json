uts": [{"name": "选择的图像", "links": [36, 37], "label": "选择的图像", "type": "IMAGE", "localized_name": "选择的图像"}], "size": [270, 162], "pos": [6697.13232421875, 1562.1553955078125], "widgets_values": [1, false], "inputs": [{"name": "图像1", "link": 35, "label": "图像1", "type": "IMAGE", "localized_name": "图像1"}, {"shape": 7, "name": "图像2", "label": "图像2", "type": "IMAGE", "localized_name": "图像2"}, {"shape": 7, "name": "图像3", "label": "图像3", "type": "IMAGE", "localized_name": "图像3"}, {"shape": 7, "name": "图像4", "label": "图像4", "type": "IMAGE", "localized_name": "图像4"}, {"shape": 7, "name": "图像5", "label": "图像5", "type": "IMAGE", "localized_name": "图像5"}, {"widget": {"name": "索引选择"}, "name": "索引选择", "label": "索引选择", "type": "INT", "localized_name": "索引选择"}, {"widget": {"name": "随机选择"}, "name": "随机选择", "label": "随机选择", "type": "BOOLEAN", "localized_name": "随机选择"}], "flags": {"pinned": true}, "id": 27, "type": "ZML_ImageSelectorNode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ZML_ImageSelectorNode"}, "order": 3}, {"outputs": [{"name": "image", "links": [7], "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#2a363b", "widgets_values": ["", 654276599, "decrement", "16:9", "4k", "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 37, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"shape": 7, "name": "image9", "label": "image9", "type": "IMAGE", "localized_name": "image9"}, {"widget": {"name": "prompt"}, "name": "prompt", "link": 29, "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "resolution"}, "shape": 7, "name": "resolution", "label": "resolution", "type": "COMBO", "localized_name": "resolution"}, {"widget": {"name": "channel"}, "shape": 7, "name": "channel", "label": "channel", "type": "COMBO", "localized_name": "channel"}], "flags": {"pinned": true, "collapsed": false}, "type": "RH_Nano_Banana2_Image2Image", "mode": 0, "bgcolor": "#3f5159", "size": [400, 388], "pos": [7009.935546875, 1564.780029296875], "id": 15, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Nano_Banana2_Image2Image"}, "order": 7}, {"outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "color": "#2a363b", "widgets_values": ["Cam_"], "inputs": [{"name": "images", "link": 7, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {"pinned": true}, "type": "SaveImage", "mode": 0, "bgcolor": "#3f5159", "size": [663.0523681640625, 1011.5916137695312], "pos": [7458.140625, 1561.3834228515625], "id": 6, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 8}, {"outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "color": "#2a363b", "widgets_values": ["你好！我是专业的影视分镜设计师。根据你提供的剧本、人设图（卜大器、土地公、土地婆）以及场景图（小土地庙），我将为你设计一套结构严谨、画面感强且符合“中国现代都市动漫”风格的分镜描述。\n\n为了确保绘图模型能精准还原角色，我将使用以下代号和特征描述：\n\n*   **人物A（卜大器）：** 对应左图。年轻男性，黑色凌乱短发，身穿破烂的深灰色古风短褐（乞丐装），光脚，身形消瘦但结实，表情丰富（痞气、惊讶、怀疑）。\n*   **人物B（土地公）：** 对应中左图。矮个老者，长白胡须，头戴高官帽，身穿米色配红边的宽大官袍，手持龙头拐杖（挂着葫芦），神态威严又带点滑稽。\n*   **人物C（土地婆）：** 对应中右图。慈祥老妇人，灰白发盘髻，身穿棕橙色传统长袍，手持扭曲木杖，面带微笑。\n*   **场景A（小土地庙）：** 对应右图。荒废的古庙庭院，青瓦飞檐，杂草丛生，中央有一尊石雕神像，光线明亮但带有岁月斑驳感。\n\n以下是基于剧本生成的连续分镜描述：\n\n---\n\n### 第一场：神庙奇遇（分镜编号 1-01 至 1-12）\n\n**情节段落1：卜大器抱怨与意外（对应剧本：卜大器嘟囔 -> 转身踢到石头踉跄）**\n\n**分镜 1-01**\n*   **镜头类型：** 中景 (Medium Shot)\n*   **镜头角度：** 平视 (Eye Level)\n*   **场景细节：** 场景A（小土地庙）神像前。空气中漂浮着被擦拭起的灰尘微粒，光线从破败的屋顶缝隙射入（丁达尔效应）。\n*   **人物动作/表情：** **人物A（卜大器）** 手里拿着一块破布，正用力擦拭石像的底座。他眉头紧锁，嘴巴微张，正在发牢骚。\n*   **画面构图：** 人物A位于画面左侧，占据1/3，右侧是斑驳的石像局部。\n*   **备注：** 强调人物A衣服的破旧质感与动漫风格的线条。\n\n**分镜 1-02**\n*   **镜头类型：** 全景 (Full Shot)\n*   **镜头角度：** 微仰视 (Low Angle)\n*   **场景细节：** 庙宇全貌，显得空旷寂寥。\n*   **人物动作/表情：** **人物A** 擦完手，退后一步，对着神像随意地作了一个揖（鞠躬行礼），姿态有些敷衍。\n*   **画面构图：** 人物A背对镜头或侧身，面对高大的神像，体现神像的静默与庄严。\n\n**分镜 1-03**\n*   **镜头类型：** 特写 (Close-up)\n*   **镜头角度：** 俯视 (High Angle)\n*   **场景细节：** 地面青石板缝隙中的杂草，以及一块突出的石头。\n*   **人物动作/表情：** **人物A** 的光脚（脚部特写）在转身时重重地踢在了那块突出的石头上。\n*   **画面构图：** 焦点在脚与石头接触的瞬间，周围带有动漫风格的撞击特效线（Impact lines）。\n\n**分镜 1-04**\n*   **镜头类型：** 中景 (Medium Shot)\n*   **镜头角度：** 侧视，稍倾斜 (Dutch Angle)\n*   **场景细节：** 庙宇背景模糊处理，增加动态感。\n*   **人物动作/表情：** **人物A** 失去平衡，身体夸张地向前踉跄，双手在空中乱抓，表情惊慌。\n*   **画面构图：** 镜头略微倾斜，增强不稳定性，人物处于画面中央，动态模糊。\n\n---\n\n**情节段落2：二神显灵（对应剧本：两道青烟冒出 -> 变成二老 -> 卜大器受惊）**\n\n**分镜 1-05**\n*   **镜头类型：** 全景 (Wide Shot)\n*   **镜头角度：** 正视 (Front View)\n*   **场景细节：** 神像两侧。\n*   **人物动作/表情：** 神像左右两侧突然喷出两道浓郁的青色烟雾（动漫风格的螺旋状烟雾），烟雾正在快速聚形。\n*   **画面构图：** 左右对称构图，神像在中间，青烟占据画面两侧，神秘感十足。\n\n**分镜 1-06**\n*   **镜头类型：** 中全景 (Medium Full Shot)\n*   **镜头角度：** 平视\n*   **场景细节：** 烟雾散去，光芒微闪。\n*   **人物动作/表情：** **人物B（土地公）** 和 **人物C（土地婆）** 凭空出现在神像前。两人双手叉腰，姿态神气。人物B胡子飘动，人物C面带慈祥笑容。\n*   **画面构图：** 两人并排站立，阻挡在刚才踉跄的 **人物A** 面前。\n\n**分镜 1-07**\n*   **镜头类型：** 近景 (Close-up)\n*   **镜头角度：** 仰视 (Low Angle)\n*   **场景细节：** 强调人物A的面部。\n*   **人物动作/表情：** **人物A** 刚站稳脚跟，猛然抬头看到面前多了两个人，吓得向后一缩，瞳孔地震，嘴巴大张喊叫，额头挂着动漫风格的冷汗（Sweat drop）。\n*   **画面构图：** 极具张力的面部特写，背景是虚化的神庙屋檐。\n\n---\n\n**情节段落3：神仙的争执（对应剧本：土地公骂人 -> 土地婆劝解）**\n\n**分镜 1-08**\n*   **镜头类型：** 中景 (Medium Shot)\n*   **镜头角度：** 略俯视 (High Angle - 模拟神仙视角)\n*   **场景细节：** 庙宇庭院。\n*   **人物动作/表情：** **人物B（土地公）** 身体前倾，吹胡子瞪眼，一手叉腰，一手拿着龙头拐杖指着镜头（指着人物A）。\n*   **画面构图：** 人物B占据画面主体，气势汹汹；**人物C（土地婆）** 站在他身后侧，无奈地看着他。\n\n**分镜 1-09**\n*   **镜头类型：** 近景 (Close-up)\n*   **镜头角度：** 平视\n*   **场景细节：** 柔和的光线打在土地婆脸上。\n*   **人物动作/表情：** **人物C（土地婆）** 笑着伸出手，轻轻拍了拍 **人物B** 的肩膀，像是在安抚老伴。\n*   **画面构图：** 侧面构图，展示两人的互动，氛围从紧张转为温馨滑稽。\n\n**分镜 1-10**\n*   **镜头类型：** 过肩镜头 (Over the Shoulder)\n*   **镜头角度：** 平视\n*   **场景细节：** 透过人物B和C的肩膀缝隙看对面。\n*   **人物动作/表情：** **人物C** 对着对面的 **人物A** 露出和蔼的笑容，似乎在解释他们不是恶鬼。\n*   **画面构图：** 前景是二神的背影（能看到官帽和发髻），后景是依然处于惊魂未定状态的 **人物A**。\n\n---\n\n**情节段落4：怀疑与质问（对应剧本：卜大器打量 -> 挠头不信 -> 质问神明）**\n\n**分镜 1-11**\n*   **镜头类型：** 中景 (Medium Shot)\n*   **镜头角度：** 平视\n*   **场景细节：** 庙宇背景。\n*   **人物动作/表情：** **人物A** 站直了身体，原本的恐惧转为怀疑。他眯着眼睛（死鱼眼状），上下打量着面前这两个穿着古怪的老人。\n*   **画面构图：** 人物A双手抱胸或自然下垂，身体语言充满不信任感。\n\n**分镜 1-12**\n*   **镜头类型：** 特写 (Close-up)\n*   **镜头角度：** 正视\n*   **场景细节：** 重点刻画人物A的表情。\n*   **人物动作/表情：** **人物A** 抬起一只手挠了挠乱糟糟的头发，嘴角撇向一边，露出一副“我见多了”的痞气表情。\n*   **画面构图：** 聚焦在人物A的面部和挠头的手部动作，眼神中透露出对世俗的不满和对神明的嘲讽。\n\n---\n\n**给绘图者的建议：**\n1.  **光影风格：** 请保持“现代都市动漫”的高对比度上色风格，虽然场景是古庙，但光感要通透，不要过于阴暗压抑。\n2.  **特效提示：** 在分镜1-05和1-06中，神仙出场时请添加淡青色或金色的粒子特效/烟雾，以体现神力，与破败的环境形成反差。\n3.  **人物一致性：** 请务必锁定 **人物A** 的乞丐装束与 **人物B、C** 的传统神仙服饰，这种视觉冲突是画面的核心趣味点。"], "inputs": [{"shape": 7, "name": "anything", "link": 50, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {"collapsed": false}, "type": "easy showAnything", "mode": 0, "bgcolor": "#3f5159", "size": [418.00732421875, 739.8447875976562], "pos": [6157.01806640625, 1855.1788330078125], "id": 19, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 5}, {"outputs": [{"name": "STRING", "links": [28], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#322", "widgets_values": ["请根据我上传的小说人设图生成动漫小说分镜图，并保持人物一致性。中国漫画风格，画面比例16:9,分镜保持人物画风。反向提示词（不要出现文字）\n分镜图提示词要求如下：\n采用**“2D动漫风格”**来进行分镜设计。这种风格保留古风设定的同时，运用现代2D动漫的犀利线条、高对比度光影和特效（UI界面等），符合“潮流”的视觉定义。画面比例16:9,分镜保持人物画风。生成3×3，保持人物、场景、道具一致，保持人物、场景细节，不要出现镜头标注，不要出现文字。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "type": "TextInput_", "mode": 0, "bgcolor": "#533", "size": [504.8764953613281, 163.13720703125], "pos": [6720.52392578125, 2128.722900390625], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInput_"}, "order": 0}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [35], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}, {"name": "MASK", "label": "MASK", "type": "MASK", "localized_name": "MASK"}], "size": [361.2281188964844, 617.402587890625], "pos": [4977.490234375, 1588.6553955078125], "widgets_values": ["2c077da65d7f89152ac8857c2fee3ee5e2ad62d8e1b6cda0ed636481828863ce.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "image"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "choose file to upload"}], "flags": {}, "id": 22, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 1}, {"mode": 0, "outputs": [{"name": "STRING", "links": [31], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [543.6825561523438, 575.8109130859375], "pos": [5463.37939453125, 1590.286865234375], "widgets_values": ["卜大器（左）、土地公（中左）、土地婆（中右）、小土地庙（右）\n卜大器（小声嘟囔）：唉，真是一个比一个惨，我看这神仙也是自身难保啊。\n△卜大器刚擦完，对着神像作了个揖，转身时踢到了石头，踉跄了一下。就在这时，两道青烟从神像两侧冒出，一道变成白发白须的老者，一道变成满脸皱纹却精神矍铄的老妇人，两人叉着腰站在他面前。\n卜大器（吓了一跳）：我去，你，你们是人是鬼啊！怎么凭空出现了！\n老者（吹胡子瞪眼）：喊啥喊！我们是这方土地公土地婆！要不是你擦了神像，还懒得理你呢！\n土地婆（笑骂）：老东西，人家救了咱们的脸面，你还凶人家！后生别怕，我们不是恶鬼！\n△卜大器眯着眼打量两人，满脸怀疑，挠了挠头：土地公土地婆？我才不信呢！这年头骗子花样多，再说真有神明，咋不救救我这苦命人？"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {"pinned": true}, "id": 21, "type": "TextInput_", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "TextInput_"}, "order": 2}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-4602.831605127713, -616.7519964603464], "scale": 0.27941459537662255}}, "groups": [{"color": "#8AA", "font_size": 100, "flags": {}, "id": 3, "title": "小说剧本生成动漫分镜图工作流V1版（Nano Banana Pro+gemini3pro）（by方块）", "bounding": [4395.13525390625, 1297.01025390625, 3757.99560546875, 137.25680541992188]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 4, "title": "人物", "bounding": [4948.54638671875, 1503.9483642578125, 416.7080383300781, 716.27001953125]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 6, "title": "剧本", "bounding": [5423.7744140625, 1499.289306640625, 615.2737426757812, 723.6572265625]}, {"color": "#A88", "font_size": 24, "flags": {"pinned": true}, "id": 10, "title": "勿动", "bounding": [6648.0576171875, 1462.0560302734375, 1516.9891357421875, 1166.4129638671875]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 11, "title": "分镜提示词", "bounding": [6105.5380859375, 1769.6630859375, 515.0489501953125, 863.0413208007812]}], "links": [[7, 15, 0, 6, 0, "IMAGE"], [28, 24, 0, 23, 0, "STRING"], [29, 23, 0, 15, 10, "STRING"], [31, 21, 0, 25, 2, "STRING"], [33, 25, 1, 23, 1, "STRING"], [35, 22, 0, 27, 0, "IMAGE"], [36, 27, 0, 25, 1, "IMAGE"], [37, 27, 0, 15, 0, "IMAGE"], [50, 25, 0, 19, 0, "*"]], "id": "76df6aca-652e-4fdb-ae58-67d8f225f0f9", "config": {}, "version": 0.4, "last_node_id": 43, "revision": 0}