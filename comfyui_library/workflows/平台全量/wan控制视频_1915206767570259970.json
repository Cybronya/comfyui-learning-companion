e": 30}}, "format": "video/h265-mp4", "frame_rate": 30, "pingpong": false}, "inputs": [{"name": "images", "link": 220, "label": "图像", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "audio", "label": "音频", "type": "AUDIO", "localized_name": "audio"}, {"shape": 7, "name": "meta_batch", "label": "批次管理", "type": "VHS_BatchManager", "localized_name": "meta_batch"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 126, "type": "VHS_VideoCombine", "properties": {"Node name for S&R": "VHS_VideoCombine"}, "order": 24}, {"outputs": [{"name": "CONDITIONING", "slot_index": 0, "links": [213], "label": "条件", "type": "CONDITIONING", "localized_name": "条件"}], "color": "#232", "widgets_values": ["女人的手臂随着闻所未闻的旋律起伏着，她长长的金发像金色的河流一样垂在背上。她目不转睛地盯着镜头，明亮的蓝眼睛闪烁着柔和而神秘的微笑。她的红色粗花呢连衣裙每走一步都发出沙沙的响声。镜头停留在她脖子上复杂的白色蕾丝领子上，精致的图案在柔和温暖的光线下跳舞，沐浴在她的脸上。她身后华丽的镜子反射出微妙的光芒，在画上投下淡淡的光泽，他们的脸现在在清晰的焦点上清晰可见。背景的柔和焦点吸引了人们对女人流畅动作的注意，她苗条的身材映衬着温暖的金色光线。这个场景似乎是从电视节目中截取的。\n"], "inputs": [{"name": "clip", "label": "CLIP", "type": "CLIP", "localized_name": "clip"}], "flags": {"collapsed": false}, "type": "CLIPTextEncode", "mode": 0, "bgcolor": "#353", "size": [860.8893432617188, 1013.0241088867188], "pos": [964.3961181640625, -344.0462646484375], "id": 121, "properties": {"cnr_id": "comfy-core", "ver": "0.3.26", "Node name for S&R": "CLIPTextEncode"}, "order": 6}, {"outputs": [{"name": "value", "links": [254], "label": "值", "type": "INT", "localized_name": "value"}], "color": "#1b4669", "widgets_values": [89], "inputs": [], "flags": {}, "type": "INTConstant", "mode": 0, "bgcolor": "#29699c", "size": [484.011474609375, 155.3842010498047], "pos": [-149.86044311523438, 738.2136840820312], "id": 135, "properties": {"Node name for S&R": "INTConstant"}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["在输入区进行调整即可\n\n最左侧输入视频的起始帧\n\n加载视频区域输入需要参考姿势的视频，不推荐帧数高于200帧\n\n下方蓝色的输入视频的帧数，视频的帧数要求比参考视频的帧数长一点并且满足为8的倍数加1\n\n举例，视频123帧，蓝色框输入的帧数就是129=8*16+1\n\n