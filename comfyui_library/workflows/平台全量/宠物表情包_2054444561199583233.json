e": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "color": "#432", "widgets_values": ["https://ai.t8star.org\n注意，尽量不要用高质量，速度很慢，中质量很快而且便宜\n2K根据输入，大概0.1-0.2积分，速度1分钟左右，实际价格和输入，最终尺寸,quality都有关系！\n2K,4K必须用custom，否则都是1K，务必注意！尺寸自己设置，必须被32整除！\nfal模型特点是先扣3.4币，然后生成完成后会退回多的币，不用担心，你可以在日志里看到比如说先收了3.4，然后生成完-3.2，意思就是用了0.2积分！！\nl"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "type": "CR Prompt Text", "mode": 4, "bgcolor": "#653", "size": [400, 200], "pos": [439.4086608886719, 340.3316345214844], "id": 37, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Prompt Text"}, "order": 5}, {"outputs": [], "color": "#432", "widgets_values": ["全量gpt-image-2，支持异步任务\n\n\n贞贞的AI工坊（注册送0.2刀，各种API）：https://ai.t8star.cn/register?aff=dP7j\n\n左侧令牌，创建令牌，分组选择default分组，随便取个名字，复制API即可使用，支持直接用（聊天模式），也支持各种工具调用 （comfyui,sillytavern,cusor等），每日签到领积分\n\nComfyui调用API节点：https://github.com/T8mars/Comfyui-zhenzhen"], "inputs": [], "flags": {}, "type": "Note", "mode": 4, "bgcolor": "#653", "size": [376.0766296386719, 239.1483917236328], "pos": [0.8859723806381226, 666.7907104492188], "id": 19, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}}, "order": 6}, {"mode": 4, "outputs": [{"name": "images", "links": [], "label": "images", "type": "IMAGE", "localized_name": "images"}, {"name": "response", "links": [], "label": "response", "type": "STRING", "localized_name": "response"}, {"name": "image_urls", "links": [], "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [386.1224060058594, 815.733642578125], "pos": [901.213134765625, -14.11465835571289], "widgets_values": ["请生成一张高质量正方形16宫格拼图，严格按4行×4列等比例排布，每一格尺寸完全相同，格子之间无间隙、无重叠，4K超高清。\n\n拼图展示了同一只动物/宠物（来自用户上传的照片）的16 种不同情绪或生活态度，保持该动物的原始外观特征，仅设计表情、姿态、情绪和配饰。每一格的情绪表达要夸张而生动，有明显反差感，富有网感。\n\n将当前流行的网络热梗/表情包文化融入设计，文字使用美观且易读的综艺感表情包字体，注意不要生成错字和乱码，文字不要崩坏，不要使用带有具体性别指向的称呼和文案（比如哥、姐等等），可以适当添加贴纸、小元素作为装饰，保持画面干净不拥挤。\n\n每一格的背景、色调、光影可以根据该格的情绪自由发挥，但整体要形成一套完整的系列，不能杂乱无章。\n\n最终输出效果追求：高级质感、魔性、有爱、有创意、幽默风趣、极易传播，适合用作微信表情包。不要生成序号。请直接用 4×4 网格输出结果。便于后续我一键裁剪成 16 张独立的方形表情包。\n", "edit", "", "medium", "custom", 3840, 3840, 1, "png", "image_url", 560982702, "randomize", 10, 300, true], "inputs": [{"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "mask", "label": "mask", "type": "IMAGE", "localized_name": "mask"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"name": "api_key"}, "shape": 7, "name": "api_key", "link": 59, "label": "api_key", "type": "STRING", "localized_name": "api_key"}, {"widget": {"name": "quality"}, "shape": 7, "name": "quality", "label": "quality", "type": "COMBO", "localized_name": "quality"}, {"widget": {"name": "image_size"}, "shape": 7, "name": "image_size", "label": "image_size", "type": "COMBO", "localized_name": "image_size"}, {"widget": {"name": "custom_width"}, "shape": 7, "name": "custom_width", "label": "custom_width", "type": "INT", "localized_name": "custom_width"}, {"widget": {"name": "custom_height"}, "shape": 7, "name": "custom_height", "label": "custom_height", "type": "INT", "localized_name": "custom_height"}, {"widget": {"name": "num_images"}, "shape": 7, "name": "num_images", "label": "num_images", "type": "INT", "localized_name": "num_images"}, {"widget": {"name": "output_format"}, "shape": 7, "name": "output_format", "label": "