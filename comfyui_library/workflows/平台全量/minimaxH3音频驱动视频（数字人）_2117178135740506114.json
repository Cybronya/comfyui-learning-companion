"7.5.2"}, "widget_ue_connectable": {"width": true, "length": true, "prompt": true, "height": true}, "Node name for S&R": "MiniMaxH3ReferenceToVideo"}, "order": 22, "widgets_values_named": {"width": 1344, "length": 124, "prompt": "", "ref_image_size": "match", "height": 768}}, {"outputs": [{"name": "IMAGE", "links": [278], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#233", "widgets_values": ["7237b37e6f97b0b72e05301f932e926d41f9b5626c331aee78e15791d05eddbc.jpg", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "label": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "upload"}, "name": "upload", "label": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#355", "size": [391.62713623046875, 326], "pos": [-2.5884556966129444, -429.05587301036246], "id": 137, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 6, "widgets_values_named": {"image": "7237b37e6f97b0b72e05301f932e926d41f9b5626c331aee78e15791d05eddbc.jpg", "upload": "image"}}, {"outputs": [{"name": "NOISE", "links": [253], "label": "噪波生成", "type": "NOISE", "localized_name": "噪波"}], "color": "#322", "widgets_values": [0, "fixed"], "inputs": [{"widget": {"name": "noise_seed"}, "name": "noise_seed", "label": "noise_seed", "type": "INT", "localized_name": "随机种"}], "flags": {}, "type": "RandomNoise", "mode": 0, "bgcolor": "#533", "size": [360, 90], "pos": [1595.8567317504899, -492.0601962715251], "id": 129, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "RandomNoise"}, "order": 7, "widgets_values_named": {"noise_seed": 0, "control_after_generate": "fixed"}}, {"outputs": [{"name": "STRING", "links": [279], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#232", "widgets_values": ["【画面基础】\n沿用参考图的复古热血动漫风格，转化为极致真实的“真人漫改影视”质感。场景设定为带有复古泛黄纸张背景、四周悬挂霓虹灯管的现代音乐演播厅。电影级舞台布光，暖色调与赛博光效交织，光影立体，画面干净通透，细节丰富（如衣物纹理、皮肤质感），8K超高清。\n\n【人物】\n（严格注意：画面中仅包含以下四位角色，绝对唯一。严禁出现任何形式的分身、克隆、残影或人物重叠融合现象。四人站位错落有致，物理空间隔离清晰。）\n\n主唱（图1 孙悟空）：位于画面C位，半身特写。保留标志性黑色刺猬头、橙色无袖武道服（胸前有清晰的“龟”字）、蓝色内搭与腰带、深蓝色护腕。全程跟随音频驱动唱歌，口型精准匹配。神态热血、自信且充满激情，一边高歌一边做出充满力量的舞台动作（如挥舞手臂），头部和身体随节奏有力摇摆。\n\n和声/气氛（图2 克林）：位于主唱侧前方。保留光头戒疤、无鼻特征、同款橙色“龟”字武道服与蓝色腰带。他面带阳光灿烂的笑容，双手或拿着沙锤打节拍，或跟着主唱一起摇摆伴唱，展现出极佳的舞台活力与默契。\n\nDJ/伴奏（图3 布尔玛）：位于主唱侧后方。保留紫蓝色马尾长发、白色T恤、红色短裙、棕色宽皮带、红色高帮帆布鞋，斜挎着带有胶囊公司logo的棕色小包。她站在DJ台前（或怀抱电吉他），手持龙珠雷达作为道具，充满青春活力地配合着音乐节奏，表情俏皮自信。\n\n鼓手/特型乐手（图4 比克）：位于画面另一侧的暗处或高台。保留绿色皮肤、尖耳、白色头巾与披风、紫色武道服。他双手抱胸，神情冷峻，披风在舞台风机的作用下微微飘动，宛如冷酷的暗黑系乐手，用眼神和气场掌控着低音节奏。\n\n【场景细节 & 镜头语言】\nF2.8 固定镜头，焦点牢牢锁定主唱悟空的面部，同时保留其余三人的清晰轮廓，浅景深，背景的复古漫画文字与光影自然虚化。镜头保持绝对稳定，画面保持真实真人实拍质感。舞台追光在悟空橙色武道服、比克的绿色皮肤和布尔玛的红裙上形成绝佳的质感对比与高光反射，充满MV的视觉张力。\n\n【负面规避】\n绝对禁止画面中出现重复的人物面容、双胞胎、残影或分身现象，严格锁定每个人物唯一且独立。严禁多个人物在物理空间上发生融合、重叠或穿模。杜绝画面晃动失焦，杜绝人脸变形、肢体扭曲、手部异常，杜绝CG动漫画风（需真人质感）、模糊噪点。绝对避免改变参考图人物的服饰款式、颜色（如“龟”字服、红裙、比克披风）和发型特征。杜绝恐怖诡异元素。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "Input Text (Prompt)", "mode": 0, "bgcolor": "#353", "size": [370, 390], "pos": [414.99125365962374, -638.52156535998], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 8, "widgets_values_named": {"value": "【画面基础】\n沿用参考图的复古热血动漫风格，转化为极致真实的“真人漫改影视”质感。场景设定为带有复古泛黄纸张背景、四周悬挂霓虹灯管的现代音乐演播厅。电影级舞台布光，暖色调与赛博光效交织，光影立体，画面干净通透，细节丰富（如衣物纹理、皮肤质感），8K超高清。\n\n【人物】\n（严格注意：画面中仅包含以下四位角色，绝对唯一。严禁出现