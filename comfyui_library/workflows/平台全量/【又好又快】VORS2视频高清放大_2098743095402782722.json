688], "pos": [1876.6102294921875, 776.8262939453125], "id": 23, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SeedVR2"}, "order": 16}, {"outputs": [{"name": "extra_args", "links": [37], "label": "extra_args", "type": "extra_args", "localized_name": "extra_args"}], "color": "#323", "widgets_values": [true, 512, 64, true, true, true], "inputs": [{"widget": {"name": "tiled_vae"}, "name": "tiled_vae", "label": "tiled_vae", "type": "BOOLEAN", "localized_name": "tiled_vae"}, {"widget": {"name": "vae_tile_size"}, "name": "vae_tile_size", "label": "vae_tile_size", "type": "INT", "localized_name": "vae_tile_size"}, {"widget": {"name": "vae_tile_overlap"}, "name": "vae_tile_overlap", "label": "vae_tile_overlap", "type": "INT", "localized_name": "vae_tile_overlap"}, {"widget": {"name": "preserve_vram"}, "name": "preserve_vram", "label": "preserve_vram", "type": "BOOLEAN", "localized_name": "preserve_vram"}, {"widget": {"name": "cache_model"}, "name": "cache_model", "label": "cache_model", "type": "BOOLEAN", "localized_name": "cache_model"}, {"widget": {"name": "enable_debug"}, "name": "enable_debug", "label": "enable_debug", "type": "BOOLEAN", "localized_name": "enable_debug"}], "flags": {}, "type": "SeedVR2ExtraArgs", "mode": 4, "bgcolor": "#535", "size": [270, 178], "pos": [2447.394287109375, 1177.807861328125], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SeedVR2ExtraArgs"}, "order": 5}, {"outputs": [{"name": "block_swap_config", "links": [36], "label": "block_swap_config", "type": "block_swap_config", "localized_name": "block_swap_config"}], "color": "#323", "widgets_values": [2, true, false], "inputs": [{"widget": {"name": "blocks_to_swap"}, "name": "blocks_to_swap", "label": "blocks_to_swap", "type": "INT", "localized_name": "blocks_to_swap"}, {"widget": {"name": "use_non_blocking"}, "name": "use_non_blocking", "label": "use_non_blocking", "type": "BOOLEAN", "localized_name": "use_non_blocking"}, {"widget": {"name": "offload_io_components"}, "name": "offload_io_components", "label": "offload_io_components", "type": "BOOLEAN", "localized_name": "offload_io_components"}], "flags": {}, "type": "SeedVR2BlockSwap", "mode": 4, "bgcolor": "#535", "size": [287.873046875, 106], "pos": [2791.80859375, 1196.629638671875], "id": 25, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SeedVR2BlockSwap"}, "order": 6}, {"outputs": [], "color": "#323", "widgets_values": ["型号：选择您的 DiT 型号\n\n3B 型号：速度更快，显存需求更低\n- seedvr2_ema_3b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_3b_fp8_e4m3fn.safetensorsFP8 8位（高质量）\n- seedvr2_ema_3b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_3b-Q8_0.ggufGGUF 8 位量化（高质量）\n\n7B 型号：画质更高，显存需求更高\n- seedvr2_ema_7b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors：FP8，最后一个数据块使用FP16，以减少伪影（质量良好）\n- seedvr2_ema_7b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_7b_sharp_*：锐化版本，增强细节\n\n设备：用于 DiT 推理的 GPU 设备（例如，cuda:0）\n\noffload_device：当 DiT 模型不处于活跃处理状态时，用于卸载 DiT 模型的设备\n- none：将模型保存在推理设备（速度最快、显存最大的设备）上\n- cpu：卸载到系统内存（减少显存）\n- cuda:X：将负载转移到另一块GPU（如果可用，则可获得良好的负载均衡）\n\ncache_model：在工作流运行之间，保持卸载设备上的 DiT 模型加载状态\n- 适用于批量处理，避免重复加载\n- 需要设置 offload_device\n\nblocks_to_swap：块交换内存优化\n- 0：已禁用（默认）\n- 1-32：需要替换为 3B 型号的变压器模块数量\n- 1-36：需要更换为 7B 型号的变压器模块数量\n- 数值越高，节省的显存越多，但处理速度越慢。\n- 需要设置 offload_device 并且使其与 device 不同。\n\nswap_io_components：卸载输入/输出嵌入和归一化层\n\n- 结合 blocks_to_swap 可进一步节省 VRAM\n- 需要设置 offload_device 并且使其与 device 不同。\n\nattention_mode：注意力计算后端\n- sdpa: PyTorch scaled_dot_product_attention（默认值，稳定，始终可用）\n- flash_attnFlash Attention 2（在支持的硬件上速度更快，需要 flash-attn 软件包）\n\ntorch_compile_args：连接到 SeedVR2 Torch 编译设置节点，可提升 20-40% 的速度。\n\nBlockSwap详解：\nBlockSwap 允许在显存有限的 GPU 上运行大型模型，它在推理过程中动态地在 GPU 和 CPU 内存之间交换 Transformer 模块。其工作原理如下：\n\n- 它的作用：仅将当前需要的转换器模块保留在 GPU 上，而将其余模块存储在 CPU 或其他设备上。\n- 何时使用：在放大阶段出现 OOM（内存不足）错误时\n- 如何配置：\n设置offload_device为cpu或其他 GPU\n先从blocks_to_swap=16（一半的积木）开始\n如果仍然出现内存不足的情况，请增加到 24 或 32 (3B) / 36 (7B)。\n启用此功能swap_io_components可最大程度节省显存\n如果显存充足，可以降低或设置为 0 以加快处理速度。"], "inputs": [], "flags": {}, "type": "Note", "mode": 4, "bgcolor": "#535", "size": [414.3453674316406, 715.8207397460938], "pos": [1891.5650634765625, 1222.839599609375], "id": 26, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"outputs": [{"name": "IMAGE", "links": [35], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "color": "#232", "widgets_values": ["lanczos", 0.30000000000000004, 1], "inputs": [{"name": "image", "link": 39, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "缩放方法"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "像素数量"}, {"widget": {"name": "resolution_steps"}, "name": "resolution_steps", "label": "resolution_steps", "type": "INT", "localized_name": "resolution_steps"}], "flags": {}, "type": "ImageScaleToTotalPixels", "mode": 4, "bgcolor": "#353", "size": [295.2969055175781, 106], "pos": [1904.9927978515625, 1073.220947265625], "id": 27, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImageScaleToTotalPixels"}, "order": 14}, {"mode": 4, "outputs": [{"name": "Filenames", "label": "文件名", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "size": [809.808349609375, 358], "pos": [2335.54248046875, 774.0133056640625], "widgets_values": {"save_output": true, "filename_prefix": "AnimateDiff", "loop_count": 0, "pix_fmt": "yuv420p", "save_metadata": true, "crf": 19, "trim_to_audio": false, "videopreview": {"paused": false, "hidden": false, "params": {"score": "0", "filename": "AnimateDiff_00004_p87-audio_ksvyg_1765472959.mp4", "workflow": "AnimateDiff_00004_p87.png", "fullpath": "/data/ComfyUI/personal/4ce092b4570234ca523eb8751a490673/output/AnimateDiff_00004_p87-audio.mp4", "format": "video/h264-mp4", "subfolder": "", "label": "Normal", "type": "output", "frame_rate": 24}}, "for