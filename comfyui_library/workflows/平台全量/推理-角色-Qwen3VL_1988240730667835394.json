nce { get; set; }\n        //出现的分镜Sn\n        public List<long> CameraSnot { get; set; }\n    }\n    [Serializable]\n    public class RoleDealItem\n    {\n        //名字\n        public string Name { get; set; }\n        //性别\n        public string Gender { get; set; }\n        //年龄\n        public string AgeRange { get; set; }\n        //外观描述,外貌仅描述衣着和人物形象，不要描述手上拿的物品，\n        public string Appearance { get; set; }\n        //出现的分镜Sn\n        public List<long> CameraSnot { get; set; }\n    }\n}\n\n"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 30, "type": "Text Multiline", "title": "输入=当前镜头-提示词助手", "properties": {"cnr_id": "was-node-suite-comfyui", "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45", "ue_properties": {"widget_ue_connectable": {"text": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"text": true}, "Node name for S&R": "Text Multiline"}, "order": 2}, {"mode": 0, "outputs": [{"name": "seed", "links": [48], "label": "seed", "type": "INT", "localized_name": "seed"}], "size": [270, 106], "pos": [-360.7602233886719, 1261.57763671875], "widgets_values": [874046637033622, "fixed", null], "inputs": [{"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 25, "type": "easy seed", "properties": {"cnr_id": "comfyui-easy-use", "ver": "a72a4dc40f7fec4df125c3850647fb09851bd04f", "ue_properties": {"widget_ue_connectable": {"seed": true}, "version": "7.0.1"}, "widget_ue_connectable": {"seed": true}, "Node name for S&R": "easy seed"}, "order": 3}, {"outputs": [{"name": "STRING", "links": [47, 53], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "color": "#232", "widgets_values": ["append", "yes", "", "", ""], "inputs": [{"widget": {"name": "action"}, "name": "action", "label": "action", "type": "COMBO", "localized_name": "action"}, {"widget": {"name": "tidy_ta