EUPLOAD", "localized_name": "选择文件上传"}], "flags": {}, "id": 22, "type": "LoadImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadImage"}, "order": 2}, {"mode": 0, "outputs": [], "size": [270, 58], "pos": [2467.23095703125, 720.5260009765625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 23, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "describe", "links": [1], "label": "describe", "type": "STRING", "localized_name": "describe"}], "size": [476.6744689941406, 320.4337463378906], "pos": [922.7449951171875, 1066.54443359375], "widgets_values": ["gemini-3-pro-preview", 1670970451, "randomize", "请帮我优化以下指令，让AI能够理解我的意图，适用于谷歌的nano banana这种对话式的AI图片生成平台，输出中文。\n\n我想让图1转为写实的摄影图，保持图1的动作姿势表情不变，参考图2的人脸，带上图3的耳机（注意这个耳机比较小巧，戴上去刚好覆盖耳朵），背景白底就好。"], "inputs": [{"shape": 7, "name": "image1", "link": 2, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 21, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "link": 22, "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 7, "type": "RH_Captioner_Pro", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_Captioner_Pro"}, "order": 4}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "type": "STRING", "localized_name": "text"}], "size": [946.3734741210938, 425.7825012207031], "pos": [1440.730712890625, 1060.8055419921875], "widgets_values": ["针对像谷歌的这类对话式AI（如果指的是Gemini或类似的具备多模态理解能力的模型），最重要的是明确**每张参考图的作用**。AI需要知道哪张图管动作，哪张图管长相，哪张图管道具。\n\n以下是为您优化的指令（Prompt），分为**“直接指令版”**（适合一次性输入）和**“分步交互版”**（如果AI支持多轮对话）。\n\n### 推荐方案：结构化指令（最精准）\n\n这个指令清晰地分配了三张图的任务，直接复制发送即可：\n\n> **请参考我上传的3张图片，生成一张高品质的写实人像摄影图。具体要求如下：**\n>\n> 1.  **构图与动作（强制参考图1）：** 请严格保持图1线稿中的人物姿势、手部动作（双手调整耳机）以及面部表情（闭眼、享受音乐的神态）。\n> 2.  **人物外貌（参考图2）：** 主角的脸部特征、五官和发型（中长微卷发）请完全替换为图2中的亚洲男性。\n> 3.  **核心道具（参考图3）：** 人物佩戴的耳机必须是图3中的款式。请注意：这是一款**小巧的贴耳式（On-ear）耳机**，不是包耳式大耳机，尺寸要刚好覆盖耳朵，材质为银灰色金属质感，还原耳机上的细节。\n> 4.  **环境与风格：** 背景为干净的纯白底（Studio white background）。画质要求为照片级写实（Photorealistic），皮肤纹理真实，布光柔和自然。\n\n---\n\n### 备选方案：如果AI理解有些偏差，试试这个更“描述性”的写法\n\n> **生成一张亚洲男性的写实摄影照片，背景为白色。**\n> *   **动作描述：** 他正闭着眼睛陶醉地听音乐，双手抬起轻轻扶着耳机，动作和构图请完全复刻**图1**的线稿。\n> *   **人物特征：** 他的长相和发型请基于**图2**及其不同角度的照片生成。\n> *   **物品细节：** 他戴着一副**图3**款式的银灰色无线耳机。请特别注意耳机的比例，它是小巧精致的压耳式设计，不要画得太大。\n> *   **风格：** 高清商业摄影风格，细节丰富。\n\n---\n\n### 给您的额外建议（Tips）：\n\n在使用这类AI生成时，如果出来的图有瑕疵，您可以尝试追加以下指令进行微调：\n\n1.  **如果耳机太大：** \"耳机画得太大了，请参考图3，这是一款‘贴耳式（On-ear）’的小型耳机，不要包住整个耳朵。\"\n2.  **如果脸不像：** \"请增加图2面部特征的权重，保持发型和五官的一致性。\"\n3.  **如果像画而不是照片：** \"请去除二次元或插画风格，我要的是真实的皮肤质感和摄影光影，像是用单反相机拍摄的。\""], "inputs": [{"name": "text", "link": 1, "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 5, "type": "ShowText|pysssss", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ShowText|pysssss"}, "order": 5}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-1254.931898644682, -974.7089085334894], "scale": 2.2745116282468345}}, "groups": [{"color": "#3f789e", "font_size": 50, "flags": {}, "id": 1, "title": "提示词方案", "bounding": [881.8389282226562, 914.215087890625, 1630.7254638671875, 632.5570678710