{"last_link_id": 82, "nodes": [{"mode": 4, "outputs": [{"name": "image", "links": [75, 76], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [310.9989318847656, 358.181884765625], "pos": [-702.368408203125, 224.39187622070312], "widgets_values": ["请严格依据手绘示意图的俯视角度与布局，生成一张顶级3DMAX渲染建筑表现图，必须精准保持原图所有建筑轮廓、相对位置与庭院结构。建筑群由四栋简约矩形体块围合中央庭院，需完全复现其比例与几何关系。材质赋予高级感：建筑外立面采用浅灰色清水混凝土与深灰色金属竖向格栅，窗户为深色Low-E玻璃幕墙，呈现精准的镜面反射。庭院中心圆形水景需精确还原，水面为镜面抛光石材，倒映建筑与天空。景观植物必须严格对应原图位置与形态：中央庭院绿植升级为精致日式枯山水肌理，点缀苔藓与观赏石；背景树木转换为枝干清晰的孤植乔木，树冠形态需保持原轮廓的简约感。场景氛围需达到电影级震撼效果：采用“蓝调时刻”光影，天空为渐变钴蓝色，建筑内透出暖黄色灯光，与冷色调外立面形成对比。地面铺设深灰色石材铺装，接缝处嵌入线性排水灯带。远景可添加极简的远山轮廓与晨雾，增强空间纵深感。加入微量叙事元素：庭院中散布两三个抽象雕塑，建筑入口处有撑伞人物剪影。渲染需使用Corona渲染器，全局照明柔和，材质突出混凝土肌理与玻璃的折射层次，最终输出8K分辨率、拥有摄影级景深与动态模糊的视觉大片，营造静谧而充满科技感的建筑场景。", 1830033584, "randomize", "auto", false], "inputs": [{"shape": 7, "name": "images", "link": 73, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "seed"}, "shape": 7, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "aspectRatio"}, "shape": 7, "name": "aspectRatio", "label": "aspectRatio", "type": "COMBO", "localized_name": "aspectRatio"}, {"widget": {"name": "skip_error"}, "shape": 7, "name": "skip_error", "label": "skip_error", "type": "BOOLEAN", "localized_name": "