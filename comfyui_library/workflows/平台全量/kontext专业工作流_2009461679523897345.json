outputs": [], "color": "#432", "widgets_values": ["将这个水壶放置在清晨阳光漫射的北欧风厨房中岛台上，柔和的自然光透过百叶窗在壶身形成斑驳光影，台面散落着咖啡豆和手冲壶，背景虚化处可见开放式层架上整齐摆放的陶瓷餐具与绿植\n\n\n将这个水壶放置在复古图书馆的胡桃木书桌上，午后阳光从拱形窗外洒入，在壶身镀上温暖金边，桌面散落着古典书籍与铜质台灯，背景深处是布满精装书册的红木书架\n\n\n将这个帐篷放在春日清晨的山坡草甸上，柔和晨光洒落帐篷橙黑立面，四周嫩绿青草沾着露珠，零星野花点缀其间，远处薄雾笼罩的山峦线条柔和，营造宁静而生机的苏醒氛围。\n\n\n将这个帐篷放在春夏之交的高山草甸，帐篷被无垠格桑花海环绕，远处雪山腰际云雾缭绕，湛蓝天空下经幡轻扬，橙黑帐体与紫红花浪形成强烈视觉冲击。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [339.7970886230469, 277.7034606933594], "pos": [-1752.4595947265625, 420.6692199707031], "id": 208, "properties": {"ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}}, "order": 2}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [595.7186279296875, 493.2395935058594], "pos": [-1191.299560546875, 193.76812744140625], "widgets_values": [], "inputs": [{"name": "images", "link": 321, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 206, "type": "PreviewImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.62", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 10}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [293, 305], "label": "Latent", "type": "LATENT", "localized_name": "Latent"}], "size": [240, 50], "pos": [-140, 1310], "widgets_values": [], "inputs": [{"name": "pixels", "link": 314, "label": "图像", "type": "IMAGE", "localized_name": "像素"}, {"name": "vae", "link": 223, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {"collapsed": false}, "id": 124, "type": "VAEEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.39", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {}, "Node name for S&R": "VAEEncode"}, "order": 14}, {"mode": 0, "outputs": [{"name": "text", "links": [319, 320], "label": 