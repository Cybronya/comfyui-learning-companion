ts": [{"name": "FLOAT", "links": [261], "label": "FLOAT", "type": "FLOAT", "localized_name": "浮点"}], "color": "#322", "widgets_values": [5], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "FLOAT", "localized_name": "值"}], "flags": {}, "type": "PrimitiveFloat", "title": "视频时长", "mode": 0, "bgcolor": "#533", "size": [270, 70], "pos": [-955.1268310546875, 4239.72021484375], "id": 132, "properties": {"cnr_id": "comfy-core", "ver": "0.33.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveFloat"}, "order": 12, "widgets_values_named": {"value": 5}}, {"outputs": [{"name": "STRING", "links": [279], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "color": "#322", "widgets_values": ["根据图0生成一个产品TVC广告，产品保持一致参考图2。视频中不要出现字幕和水印。营销级背景纯音乐和音效，有节奏感，轻快。大师级，电影感，镜头切换丝滑自然，无字幕，无水印。\n\n镜头1：极慢的推镜，镜头从全黑中缓缓推进，光线逐渐增强并勾勒出银色皮革的质感，景深极浅，背景纯黑，充满电影摄影机的呼吸感，空气感，无任何廉价特效。\n\n镜头2：微距水平平移，极慢速度，光影在皮革纹理上产生微妙的反光变化，景深极浅，焦点紧锁在皮革表面，电影级灯光，空气感。\n\n镜头3：缓慢推镜，焦点从后方的银色皮革平滑转移到前方的白色蕾丝蝴蝶结上，光线微微闪烁，蕾丝边缘带有微微的透光感，呼吸感，电影级景深。\n\n镜头4：缓慢推镜，光影如呼吸般在金属表面流转，一道高光从拉链头部缓慢滑向吊坠，景深极浅，电影摄影机的微距语言，高级克制。\n\n镜头5：缓慢拉镜，配合微弱的位移，展现包包的立体感与电影纵深，光影在云朵手柄的褶皱处产生柔和的明暗过渡，呼吸感，纯净的背景。\n\n镜头6：微距特写，手持感，缓慢跟拍镜头，手部优雅地提起包包，动作极慢且有张力，背景光影微微变亮，营造出高级的仪式感与陪伴感，电影级运动模糊，克制而高级。"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "值"}], "flags": {}, "type": "PrimitiveStringMultiline", "title": "输入提示词", "mode": 0, "bgcolor": "#533", "size": [370, 390], "pos": [-612.5491333007812, 4091.448974609375], "id": 138, "properties": {"cnr_id": "comfy-core", "ver": "0.33.0", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 13, "widgets_values_named": {"value": "根据图0生成一个产品TVC广告，产品保持一致参考图2。视频中不要出现字幕和水印。营销级背景纯音乐和音效，有节奏感，轻快。大师级，电影感，镜头切换丝滑自然，无字幕，无水印。\n\n镜头1：极慢的推镜，镜头从全黑中缓缓推进，光线逐渐增强并勾勒出银色皮革的质感，景深极浅，背景纯黑，充满电影摄影机的呼吸感，空气感，无任何廉价特效。\n\n镜头2：微距水平平移，极慢速度，光影在皮革纹理上产生微妙的反光变化，景深极浅，焦点紧锁在皮革表面，电影级灯光，空气感。\n\n镜头3：缓慢推镜，焦点从后方的银色皮革平滑转移到前方的白色蕾丝蝴蝶结上，光线微微闪烁，蕾丝边缘带有微微的透光感，呼吸感，电影级景深。\n\n镜头4：缓慢推镜，光影如呼吸般在金属表面流转，一道高光从拉链头部缓慢滑向吊坠，景深极浅，电影摄影机的微距语言，高级克制。\n\n镜头5：缓慢拉镜，配合微弱的位移，展现包包的立体感与电影纵深，光影在云朵手柄的褶皱处产生柔和的明暗过渡，呼吸感，纯净的背景。\n\n镜头6：微距特写，手持感，缓慢跟拍镜头，手部优雅地提起包包，动作极慢且有张力，背景光影微微变亮，营造出高级的仪式感与陪伴感，电影级运动模糊，克制而高级。"}}, {"showAdvanced": false, "outputs": [{"name": "width", "links": [276], "label": "width", "type": "INT", "localized_name": "宽度"}, {"name": "height", "links": [277], "label": "height", "type": "INT", "localized_name": "高度"}], "color": "#322", "widgets_values": ["16:9 (Widescreen)", 0.4, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "宽高比"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "百万像素"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "倍数"}, {"widget": {"name": "preview"}, "shape": 7, "name": "preview", "label": "preview", "type": "RESOLUTION_PREVIEW", "localized_name": "预览"}], "flags": {}, "type": "ResolutionSelector", "title": "选择宽高比分辨率", "mode": 0, "bgcolor": "#533", "size": [270, 170], "pos": [-158.63424682617188, 4076.801025390625], "id": 115, "properties": {"cnr_id": "comfy-core", "ver": "0.33.0", "widget_ue_connectable": {}, "Node name for S&R": "ResolutionSelector"}, "order": 14, "widgets_values_named": {"aspect_ratio": "16:9 (Widescreen)", "megapixels": 0.4, "multiple": 32}}, {"outputs": [{"name": "BOOLEAN", "links": [290, 291], "label": "BOOLEAN", "type": "BOOLEAN", "localized_name": "布尔"}], "color": "#322", "widgets_values": [false], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "BOOLEAN", "localized_name": "值"}], "flags": {}, "type": "PrimitiveBoolean", "title": "是否开启Lora加速（默认是否）", "mode": 0, "bgcolor": "#533", "size": [270, 70], "pos": [-152.92449951171875, 4370.75], "id": 146, "properties": {"cnr_id": "comfy-core", "ver": "0.33.0", "widget_ue_connectable": 