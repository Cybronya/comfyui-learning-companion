l_name", "label": "model_name", "type": "COMBO", "localized_name": "model_name"}, {"widget": {"name": "precision"}, "shape": 7, "name": "precision", "label": "precision", "type": "COMBO", "localized_name": "precision"}, {"widget": {"name": "use_cpu_cache"}, "shape": 7, "name": "use_cpu_cache", "label": "use_cpu_cache", "type": "BOOLEAN", "localized_name": "use_cpu_cache"}], "flags": {}, "id": 75, "type": "WanVideoVAELoader", "properties": {"cnr_id": "comfyui-workflow-encrypt", "ver": "1.0.0", "widget_ue_connectable": {}, "Node name for S&R": "WanVideoVAELoader"}, "order": 11}, {"mode": 0, "outputs": [{"name": "STRING", "links": [148], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [400, 200], "pos": [-1032.641357421875, 2837.533447265625], "widgets_values": ["Sequence 1: 贴地低角度缓慢推进 (Low Angle Slow Dolly In)，极近距离特写龙爪深深抠入沙地，粗粝的指节因发力而剧烈绷紧 (knuckles tightening)，锋利的爪尖刮擦沙粒扬起细密尘雾，腕部金属环随肌肉起伏微微震颤，镜头焦点紧紧锁定在这一抓地发力的微小位移上，保持向前的运镜惯性 (Forward Momentum)。\n\nSequence 2: 继承向前的运镜并平滑向上摇摄 (Continue Dolly In and Tilt Up)，视线顺着龙臂流畅上移至龙首，赤红竖瞳骤然收缩 (pupils constricting sharply)，鼻孔喷出灼热气流带起额前碎沙，獠牙间滴落的涎水在阳光下拉出晶亮丝线 (glistening saliva thread)，喉部鳞片因低吼而层层耸动，镜头动作保持紧迫的跟随感。\n\nSequence 3: 继续向上倾斜并同步后拉 (Continue Tilt Up and Pull Back)，巨龙双翼猛然展开撕裂空气，翼膜血管在强光下暴凸如熔岩脉络，庞大身躯借力腾空离地，沙尘如爆炸般向四周炸开，镜头仰角拉远捕捉其跃升轨迹，保持上升与后退的复合运动 (Rising & Retreating Motion)。\n\nSequence 4: 继承上升后拉趋势并转向水平横移 (Continue Rising & Pulling Back, then Pan Right Horizontally)，龙口大张喷射出炽白火柱，火焰如液态太阳倾泻而下，瞬间吞噬前方沙漠里的一片废墟，岩石在高温中爆燃成橙红火球，浓烟翻滚直冲云霄，镜头横向滑移追踪火势蔓延路径，维持高速平移惯性 (High-Speed Horizontal Pan)。\n"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {}, "id": 116, "type": "PrimitiveStringMultiline", "title": "$prompt.value!", "properties": {"cnr_id": "comfy-core", "ver": "0.3.73", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}}, "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 12}