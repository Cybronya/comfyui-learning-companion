72f6791eced6125"}, {"name": "B", "selected": true, "url": "/view?filename=rgthree.compare._temp_zlppm_00002_nuplq_1743428569.png&type=temp&subfolder=&rand=0.531193498745383&Rh-Comfy-Auth=eyJ1c2VySWQiOiI0ODFkMGIwNGQ1YWNjMTJlODcyZjY3OTFlY2VkNjEyNSIsInNpZ25FeHBpcmUiOjE3NDQwMzMyODY0OTYsInRzIjoxNzQzNDI4NDg2NDk2LCJzaWduIjoiNzAzNmEzYzZiZjJhNjNiODM3OTU3Njc0ZTQ0ZGQ2MTgifQ==&Rh-Identify=481d0b04d5acc12e872f6791eced6125"}]], "inputs": [{"name": "image_a", "link": 338, "label": "图像_A", "dir": 3, "type": "IMAGE"}, {"name": "image_b", "link": 339, "label": "图像_B", "dir": 3, "type": "IMAGE"}], "flags": {}, "id": 197, "type": "Image Comparer (rgthree)", "properties": {"comparer_mode": "Slide"}, "order": 34}, {"outputs": [], "color": "#432", "widgets_values": ["一、搭建及使用方法\n\n1、图片预处理部分\n\n（1）产品图依次经过按宽高比缩放V2节点调整大小，RMBG节点出主体，遮罩裁剪V2将产品裁剪为最大尺寸（给REDUX迁移尽量多的主体像素信息参考），移除ALPHA节点将背\n\n景图填充纯色（防止多余背景信息干扰REDUX迁移效果）。\n\n（2）人物图在遮罩编辑器中绘制需要生成产品位置的蒙版（按照产品图的形状或者透视关系尽可能精确的绘制遮罩区域边缘即可，若产品中间有镂空，则需要将局部重绘\n\n（裁剪）节点中的遮罩填充漏洞关掉）。接着通过局部重绘（剪裁）节点将遮罩区域以及对应的图像裁剪出来放大至1024X1024像素。\n\n（3）利用MAKE IMAGE FOR ICLORA节点将处理后的产品图和人物图以及遮罩信息组合。\n\n2、局部重绘部分\n\n（1）FLUX FILL的局部重绘工作流（这里不作详细介绍，大模型选择FLUX FILL模型）\n\n（2）LORA模型ACE++comfyui subject lora16.safetensors\n\n（3）REDUX风格迁移节点组\n\n3、图片后期处理\n\n（1）生成图片经过图像裁剪将重绘后的图片裁剪出来。\n\n（2）经过局部重绘（接缝）节点将裁剪后的图片与原图拼接，完成最终效果。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [882.998291015625, 369.3543395996094], "pos": [6607.74853515625, 1464.666015625], "id": 199, "properties": {}, "order": 7}, {"mode": 0, "outputs": [], "size": [315, 58], "pos": [10092.251953125, 2588.6220703125], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 345, "label": "图像", "type": "IMAGE", "localized_name": "图片"}], "flags": {}, "id": 200, "type": "SaveImage", "properties": {"Node name for S&R": "SaveImage"}, "order": 35}], "extra": {"ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-7661.100061444786, -2101.116344956134], "scale": 0.3138428376721004}}, "group