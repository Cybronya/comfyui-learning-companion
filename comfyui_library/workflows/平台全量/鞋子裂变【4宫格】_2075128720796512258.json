], "size": [400, 200], "pos": [1107.8740234375, 836.2188720703125], "widgets_values": ["基于用户上传的参考图生成一张 2×2 四宫格鞋子穿搭裂变图。\n四宫格的脚部姿态和鞋子角度严格固定为：左上坐姿双腿前伸、右上站姿单脚前踏、左下站姿双脚并排、右下单脚抬起展示鞋底。\n整体沿用参考图的穿搭、鞋子、袜子、下装、背景、光影、构图和真实实拍风格。\n四个画面保持同景别、同背景、同光影、同一套穿搭，仅按照参考图中的不同脚部姿态和鞋子角度进行产品展示。\n画面干净自然，突出鞋子的鞋面、鞋带、鞋侧、后跟和鞋底细节，真实穿搭实拍质感。"], "inputs": [{"widget": {"name": "编辑文本"}, "name": "编辑文本", "label": "编辑文本", "type": "STRING", "localized_name": "编辑文本"}], "flags": {"collapsed": true}, "id": 5, "type": "MuyeTextEditOutput", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MuyeTextEditOutput"}, "order": 1}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-204.64802400000076, -67.88107100000028], "scale": 0.751314800901578}}, "groups": [], "links": [[1, 4, 0, 1, 0, "IMAGE"], [2, 2, 0, 4, 0, "IMAGE"], [3, 5, 0, 4, 10, "STRING"]], "id": "e538a280-b1b8-4ac7-980e-3c1b9fc949cc", "config": {}, "version": 0.4, "last_node_id": 5, "revision": 0}