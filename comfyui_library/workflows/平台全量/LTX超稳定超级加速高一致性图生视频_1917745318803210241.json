 Kodak 2383 film stock."], "inputs": [{"widget": {"name": "text"}, "name": "text", "link": 2582, "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": true}, "type": "ShowText|pysssss", "mode": 0, "bgcolor": "#353", "size": [1181.41357421875, 279.90252685546875], "pos": [2967.685791015625, -771.9139404296875], "id": 1180, "properties": {"cnr_id": "comfyui-custom-scripts", "ver": "1.2.3", "Node name for S&R": "ShowText|pysssss"}, "order": 23}, {"outputs": [], "color": "#223", "widgets_values": [""], "inputs": [{"name": "images", "link": 2425, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "type": "PreviewImage", "mode": 0, "bgcolor": "#335", "size": [336.5270690917969, 290.04656982421875], "pos": [2645.218017578125, -390.826416015625], "id": 1120, "properties": {"cnr_id": "comfy-core", "ver": "0.3.27", "Node name for S&R": "PreviewImage", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 24}, {"outputs": [{"name": "IMAGE", "slot_index": 0, "links": [2584], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "slot_index": 1, "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#223", "widgets_values": ["48e0d2766d06315d5f7cd9ce84dd9708bc91f298454596deb9c1d6da6870784e.png", "image", ""], "inputs": [], "flags": {}, "type": "LoadImage", "mode": 0, "bgcolor": "#335", "size": [485.93609619140625, 379.1796569824219], "pos": [1333.592041015625, -1205.6827392578125], "id": 952, "properties": {"cnr_id": "comfy-core", "ver": "0.3.26", "Node name for S&R": "LoadImage", "ttNbgOverride": {"bgcolor": "#335", "groupcolor": "#88A", "color": "#223"}}, "order": 13}], "extra": {"VHS_KeepIntermediate": true, "workspace_info": {"id": "Dn68J7dyJHTWUWNmsc8Mz"}, "VHS_MetadataImage": true, "comfy_fork_version": "develop@ffe590c7", "ue_links": [], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "VHS_latentpreview": false, "prompt": {"1187": {"class_type": "Promp