"widget": {"name": "language"}, "shape": 7, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "id": 6, "type": "Qwen3ASRTranscribe", "properties": {"widget_ue_connectable": {"language": true}, "Node name for S&R": "Qwen3ASRTranscribe"}, "order": 3}, {"mode": 0, "outputs": [{"name": "timestamps", "links": [1], "label": "timestamps", "type": "STRING", "localized_name": "timestamps"}], "size": [230, 132], "pos": [1562.983154296875, 1106.1439208984375], "widgets_values": ["", "Chinese"], "inputs": [{"name": "aligner", "link": 6, "label": "aligner", "type": "QWEN3_ALIGNER", "localized_name": "aligner"}, {"name": "audio", "link": 7, "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"widget": {"name": "text"}, "name": "text", "link": 8, "label": "text", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "language"}, "name": "language", "label": "language", "type": "COMBO", "localized_name": "language"}], "flags": {}, "id": 7, "type": "Qwen3ForcedAlign", "properties": {"widget_ue_connectable": {"language": true, "text": true}, "Node name for S&R": "Qwen3ForcedAlign"}, "order": 5}, {"mode": 0, "outputs": [{"shape": 6, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "size": [445.4691162109375, 233.0816650390625], "pos": [1880, 791], "widgets_values": ["清风卷起花影，夜色映落山。一步生年，身环都失了方向。眉似远山，眼似秋水荡漾。谁人能解那一抹浅笑的痴狂？芳华一瞬，惊鸿照影。锦绣山河皆为他凝结，红尘万丈因他而明。一对一笑间却是千分心。他是花，是歌，是人间最美的梦。醉了江山，误了英雄。谁见他心若花？谁忆他梦里烟霞？风情事，倾慕天下。他的身影化作永恒的神话。经过不雨，清城无暇。一眸春水醉尽山川湖沙。人间多少繁华，怎及他风华？他笑视天下皆落下。经过不雨，清城无暇。书成未及了，心何等话？总有千古话，话不过他一刹。他笑视天下皆为他落下。又是情飞，因他素颜。今书难尽，写不尽他的万千。烟雨江南，春风未眠。他身难回梦一瞬，倾覆红尘的眼。谁见他心若花？谁忆他梦里烟霞？风情事，倾慕天下。他的身影化作永恒的神话。经过不雨，清城无暇。一眸春水醉尽山川湖沙。人间多少繁华，怎及他风华？他笑视天下皆为他落下。经过不雨，清城无暇。书成未及了，心何等话？总有千古话，话不过他一刹。他笑视天下皆为他落下。他是月，他是花，他是天下的花。一句为众生，何以慰他潸然？纵是千秋万代，不过他的一声轻叹。"], "inputs": [{"name": "text", "link": 9, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 8, "type": "ShowText|pysssss", "properties