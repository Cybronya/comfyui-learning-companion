83203125], "id": 103, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 8}, {"outputs": [], "color": "#432", "widgets_values": [" 1. 怎么用大白话写编辑指令？\n直接说人话就行，比如：\n“给画面打上暖色调的黄昏金光。”\n“把这个人放到咖啡馆的桌子旁，手里端杯咖啡。”\n“给她换上一件红色雨衣。”\n2. 发现人物脸变“大众脸”、失去个人特征了怎么办？\n在提示词后面加上这句：“保留完全一致的面部特征”，然后具体描述一下这张脸到底哪里特别（比如“左眼角有颗痣”、“高鼻梁”等），帮模型“认脸”。\n3. 关于 grounding_px（模型读取指令时的视野范围）：\n这个参数决定了模型在听你指令时“看”多大范围。384 到 768 是官方训练的最佳区间。\n如果画面总是出现双重影像或拼接感：把这个值调低。\n4. 关于那个折叠的负面提示词节点：\n那个节点只有在 CFG > 1 的时候才生效，平时不用管它，里面的提示词留空就行。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [619.921875, 299.921875], "pos": [1623.1566162109375, 663.8574829101562], "id": 119, "properties": {"ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 9}, {"mode": 0, "outputs": [{"name": "width", "links": [], "label": "width", "type": "INT", "localized_name": "width"}, {"name": "height", "links": [], "label": "height", "type": "INT", "localized_name": "height"}], "size": [269.921875, 189.921875], "pos": [1257.7333984375, 156.959228515625], "widgets_values": ["9:16 (Portrait Widescreen)", 2, 8], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "aspect_ratio"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "multiple"}], "flags": {}, "id": 83, "type": "ResolutionSelector", "properties": {"cnr_id": "comfy-core", "ver": "0.26.0", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "widget_ue_connectable": {"aspect_ratio": true, "megapixels": true, "multiple": t