拥抱状，脸上洋溢着温暖的笑容，头顶文字为“感恩遇见”，背景有轻微动态模糊，表达对过往岁月的感激之情。\n中下格：人物手持一本翻开的日历，日历显示新年日期，正视镜头微笑，头顶文字为“共迎新岁”，字体端正大气，象征新年祝福。\n右下格：人物双手托腮，眼睛望向远方，若有所思的样子，头顶文字为“梦想启航”，周围飞舞着多个银色星星图案，寓意新的一年充满希望与梦想。\n所有画面中人物必须保持相同发型、服装、妆容、五官比例及面部细节，仅动作和道具变化。背景色调统一为浅红+金色系，加入传统春节元素但不喧宾夺主。整体风格温馨喜庆、富有节日气氛，适合用于2026马年新春贺图。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 58, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 1}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [950.22705078125, 1346.3924560546875], "pos": [1715.7998046875, -344.3114929199219], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 30, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 15, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 3}, {"mode": 0, "outputs": [{"name": "image", "links": [30, 70], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [288.9331970214844, 388], "pos": [610.9256591796875, -217.66566467285156], "widgets_values": ["", 721334968, "randomize", "9:16", "1k", "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 46, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "lab