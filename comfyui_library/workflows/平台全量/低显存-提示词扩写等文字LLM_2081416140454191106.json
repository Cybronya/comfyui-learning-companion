lized_name": "mirostat_tau"}, {"widget": {"name": "state_uid"}, "name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "flags": {}, "id": 1, "type": "llama_cpp_parameters", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"mirostat_eta": true, "max_tokens": true, "presence_penalty": true, "mirostat_mode": true, "top_p": true, "min_p": true, "frequency_penalty": true, "state_uid": true, "mirostat_tau": true, "top_k": true, "temperature": true, "repeat_penalty": true, "typical_p": true}, "aux_id": "lihaoyun6/ComfyUI-llama-cpp_vlm", "Node name for S&R": "llama_cpp_parameters"}, "order": 1}, {"mode": 0, "outputs": [{"name": "output", "links": [1, 2], "label": "output", "type": "STRING", "localized_name": "output"}, {"shape": 6, "name": "output_list", "label": "output_list", "type": "STRING", "localized_name": "output_list"}, {"name": "state_uid", "label": "state_uid", "type": "INT", "localized_name": "state_uid"}], "size": [425.0570068359375, 696.0381469726562], "pos": [1055.1978759765625, 972.45556640625], "widgets_values": ["Normal - Describe", "你是文生图大模型的prompt撰写大师，把这张图片的prompt用中文给我写出来。", "你是一名专业的AI绘画领域文生图提示词生成专家。\n\n你的核心任务是对用户提供的任何图片进行详尽、准确的反向工程分析，并生成可直接用于文生图模型的全中文高质量大众化合法合规的提示词。\n\n请从以下五个维度进行系统化分析：\n\n主体：明确画面中的主要对象，包括人物（性别、年龄、种族、姿态、表情、服装细节、配饰）、动物、物体或抽象元素，描述其特征、数量、位置及相互关系。\n环境：详细说明主体所处的空间或场景，包括室内/室外、自然/人造、具体地点（如森林、城市街道、实验室、日式庭院）、天气、时间（清晨、黄昏、夜晚等）及背景细节。\n氛围：捕捉画面整体情绪与感官基调，如梦幻、阴郁、温馨、科幻感、神秘、宁静、紧张、浪漫等，并结合光影（柔光、高对比、逆光、霓虹照明等）和色彩倾向（冷色调、暖色调、单色、高饱和等）强化氛围表达。\n风格：精准识别艺术或视觉风格，如写实摄影、赛博朋克、水墨国画、浮世绘、皮克斯3D、蒸汽波、油画质感、动漫插画、极简主义、超现实主义等，并注明参考艺术家或流行模型风格（如Greg Rutkowski、Makoto Shinkai等，若适用）。\n拍摄方式：模拟图像的成像视角与技术参数，包括镜头类型（广角、长焦、鱼眼）、景别（特写、中景、全景）、视角（俯视、仰视、平视）、景深（浅景深、大景深）、构图（对称、三分法、引导线）以及是否具有摄影/渲染特效（动态模糊、胶片颗粒、景深虚化、HDR等）。\n最终输出要求：\n\n使用纯中文，不含任何Markdown格式、标题、编号或自然段落；\n以关键词密集、结构紧凑的短语形式呈现，各要素间用逗号分隔；\n优先使用文生图模型常用术语，确保提示词可直接复制用于主流AI绘画工具；\n不添加解释性文字、问候语或总结句，仅输出最终提示词文本。", "one by one", 24, 256, 709441146642753, "randomize", false, false], "inputs": [{"name": "llama_model", "link": 3, "label": "llama_model", "type": "LLAMACPPMODEL", "localized_name": "llama_model"}, {"shape": 7, "name": "parameters", "link": 4, "label": "parameters", "type": "LLAMACPPARAMS", "localized_name": "parameters"}, {"shape": 7, "name": "images", "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "queue_handler", "label": "queue_handler", "type": "*", "localized_name": "queue_handler"}, {"widget": {"name": "preset_prompt"}, "name": "preset_prompt", "label": "preset_prompt", "type": "COMBO", "localized_name": "preset_prompt"}, {"widget": {"name": "custom_prompt"}, "name": "custom_prompt", "link": 5, "label": "custom_prompt", "type": "STRING", "localized_name": "custom_prompt"}, {"widget": {"name": "system_prompt"}, "name": "system_prompt", "label": "system_prompt", "type": "STRING", "localized_name": "system_prompt"}, {"widget": {"name": "inference_mode"}, "name": "inference_mode", "label": "inference_mode", "type": "COMBO", "localized_name": "inference_mode"}, {"widget": {"name": "max_frames"}, "name": "max_frames", "label": "max_frames", "type": "INT", "localized_name": "max_frames"}, {"widget": {"name": "max_size"}, "name": "max_size", "label": "max_size", "type": "INT", "localized_name": "max_size"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}, {"widget": {"name": "force_offload"}, "name": "force_offload", "label": "force_offload", "type": "BOOLEAN", "localized_name": "force_offload"}, {"widget": {"name": "save_states"}, "name": "save_states", "label": "save_states", "type": "BOOLEAN", "localized_name": "save_states"}], "flags": {}, "id": 5, "type": "llama_cpp_instruct_adv", "properties": {"cnr_id": "llama-cpp_vllm", "ver": "2d28817e12f912ec9e27ce83cf7610a477152185", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.7"}, "widget_ue_connectable": {"max_frames": true, "seed": true, "inference_mode": true, "custom_prompt": true, "force_offload": true, "system_prompt": true, "save_states": true, "preset_prompt": true, "max_size": true}, "aux_id": "lihaoyun6/ComfyUI-llama-cpp_vlm", "Node name for S&R": "llama_cpp_instruct_adv"}, "order": 5}, {"mode": 4, "outputs": [{"name": "prompt", "label": "提示词文本", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [519.7142944335938, 584.7130126953125], "pos": [1412.41259765625, 1793.53955078125], "widgets_values": ["你是一位顶级的电影摄影师与视觉艺术家，精通摄影技术（光圈、快门、ISO、焦段）、电影语言（构图、景别、运镜、色彩分级）以及视觉叙事。你的任务是将用户输入的任意简单描述，扩写成一段细节丰富、富有情绪和叙事感的中文图片提示词。\n\n扩写时必须植入以下专业知识：\n\n镜头与焦段：根据主体选择合适的焦距（如85mm人像黄金焦段、16mm超广角强调透视、200mm长焦压缩空间）\n\n光圈与景深：决定虚实关系（如T2.8浅景深分离主体、T16全景深展现环境）\n\n快门与动态：凝固或模糊运动（如1/8000s冻结瞬间、1/15s拖曳光轨）\n\n感光度与质感：控制噪点与细腻度（如ISO 100纯净、ISO 3200胶片颗粒）\n\n滤镜与光学效果：添加物理特性（如偏振镜、黑柔滤镜、变形宽银幕炫光）\n\n景别设计：极远景、中景、特写等\n\n构图法则：三分法、对称、引导线、黄金螺旋、负空间\n\n机位角度：低角度、俯拍、荷兰角等\n\n色彩分级：描述色相、饱和度、明度倾向（如青橙色调、低饱和莫兰迪、霓虹赛博朋克）\n\n光影方案：三点布光、伦勃朗光、逆光剪影、黄金时刻、阴天柔光等\n\n氛围元素：雾、雨、尘埃、丁达尔效应、景深渐晕\n\n风格参考：可自动匹配知名摄影师风格（如罗杰·狄金斯、艾曼努尔·卢贝兹基）或经典电影视觉基因（如《银翼杀手2049》《布达佩斯大饭店》）\n\n输出规则（至关重要）：\n\n仅输出一段连贯的中文提示词，不要任何标题、序号、分隔符、英文词汇或括号注释。\n\n不使用“美丽”“漂亮”等空泛形容词，全部替换为可量化的视觉元素。\n\n若用户输入包含矛盾元素，需通过光线或色调统一冲突。\n\n主动拒绝生成暴力、色情或歧视性内容。\n\n示例（仅作格式参考，实际回复时请勿包含此示例）：\n用户输入：“月光下的海”\n你的输出应为：\n\n一艘孤零零的木制渔船在散发着磷光的午夜海面上轻轻摇晃，银色的月光碎裂在轻柔的涌浪之间，使用30秒长曝光将海水虚化成薄雾般的质感，蔡司50mm f/1.4镜头在T2.8光圈下聚焦于船身锈蚀的铁链，整体色调倾向深青色与靛蓝，地平线处微微透出钠蒸气灯的暖橙色轮廓光，画面比例模拟2.39:1变形宽银幕，保留细腻的胶片颗粒感，海水中漂浮的夜光藻发出空灵幽蓝的辉光，营造出塔可夫斯基式静谧而孤独的沉思氛围。\n\n记住：用户每次输入简单描述后，你只需直接输出上述格式的中文段落，不附加任何其他内容。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "type": "STRING", "localized_name": "提示词"}], "flags": {}, "id": 8, "type": "CR Prompt Text", "properties": {"cnr_id": "comfyui-workflow-encrypt", "ver": "1.0.0", "widget_ue_connectable": {"prompt": true}, "Node name for S&R