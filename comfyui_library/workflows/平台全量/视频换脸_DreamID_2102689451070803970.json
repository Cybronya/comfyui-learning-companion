MarkdownNote"}, "order": 1}, {"outputs": [], "color": "#222", "widgets_values": ["## 使用说明\n\n1. 上传驱动视频（#1 LoadVideo）与参考脸图（#2 LoadImage，清晰正脸、光照接近）\n2. 看预览 #11：裁出的脸应正好是参考人脸（裁错 → 调 #5 scale_factor，或换更正面的参考图）\n3. 直接运行：输出时长/分辨率自动跟随输入，5 秒进 5 秒出、15 秒进 15 秒出，无需任何手调\n4. 脸没换/融合差 → 参考图换正脸、光照接近；或把 #12 faster 换更高质量档；表情/动作时脸糊 → 调高 #51 megapixels 或用更高清参考图\n5. 视频越长耗时越久；高帧率输入已自动抽样到 ~16fps 提速，若仍嫌慢可把 #51 megapixels 调小\n6. 输出在右下角 #16（VHS_VideoCombine），音轨/帧率与原视频一致"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "使用", "mode": 0, "bgcolor": "#000", "size": [600, 210], "pos": [1200, 1550], "id": 21, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 2}, {"mode": 0, "outputs": [{"name": "VIDEO", "links": [3], "label": "VIDEO", "type": "VIDEO", "localized_name": "视频"}], "size": [278.21954345703125, 616.612548828125], "pos": [-425.5245056152344, 50.52265167236328], "widgets_values": ["3deb0bc7d210b5865882582c387737ca5f7c4f6920db24f588ff870fcc340557.mp4", true, "0", "image"], "inputs": [{"widget": {"name": "file"}, "name": "file", "type": "COMBO", "localized_name": "文件"}, {"widget": {"name": "keep_audio"}, "name": "keep_audio", "type": "BOOLEAN", "localized_name": "keep_audio"}, {"widget": {"name": "trim_time"}, "name": "trim_time", "type": "STRING", "localized_name": "trim_time"}, {"widget": {"name": "upload"}, "name": "upload", "type": "IMAGEUPLOAD", "localized_name": "选择要上传的文件"}], "flags": {}, "id": 1, "type": "LoadVideo", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoadVideo"}, "order": 3}, {"outputs": [{"name": "IMAGE", "links": [9], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "MASK", "links": [], "label": "遮罩", "type": "MASK", "localized_name": "遮罩"}], "color": "#2a363b", "widgets_values": ["858e7aeb8d77ebd5342a5b825e7bb7867595ac8d1e56c6b786dbe356c7bcc0c8.png", "image"], "inputs": [{"widget": {"name": "image"}, "name": "image", "type": "COMBO", "localized_name": "图像"}, {"widget": {"name": "