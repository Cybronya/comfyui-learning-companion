get_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"image": true, "upload": true}, "Node name for S&R": "LoadImage"}, "order": 1}, {"mode": 0, "outputs": [{"name": "image", "links": [60], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 170], "color": "rgba(20, 95, 121, 0.7)", "pos": [78.0702896118164, -522.2520751953125], "widgets_values": [false, "normal", 0, "#000001"], "inputs": [{"name": "background_image", "link": 58, "label": "background_image", "type": "IMAGE", "localized_name": "background_image"}, {"name": "layer_image", "link": 66, "label": "layer_image", "type": "IMAGE", "localized_name": "layer_image"}, {"shape": 7, "name": "layer_mask", "link": 64, "label": "layer_mask", "type": "MASK", "localized_name": "layer_mask"}, {"widget": {"name": "invert_mask"}, "name": "invert_mask", "label": "invert_mask", "type": "BOOLEAN", "localized_name": "invert_mask"}, {"widget": {"name": "blend_mode"}, "name": "blend_mode", "label": "blend_mode", "type": "COMBO", "localized_name": "blend_mode"}, {"widget": {"name": "opacity"}, "name": "opacity", "label": "opacity", "type": "INT", "localized_name": "opacity"}, {"widget": {"name": "color"}, "name": "color", "label": "color", "type": "STRING", "localized_name": "color"}], "flags": {}, "id": 34, "type": "LayerStyle: ColorOverlay V2", "properties": {"cnr_id": "comfyui_layerstyle", "ver": "89014d833d2ad0998d724090eff1456692692a1d", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"invert_mask": true, "blend_mode": true, "color": true, "opacity": true}, "Node name for S&R": "LayerStyle: ColorOverlay V2"}, "order": 8}, {"mode": 0, "outputs": [{"name": "image", "links": [58], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 106], "color": "rgba(38, 73, 116, 0.7)", "pos": [-220.671142578125, -554.921142578125], "widgets_values": [512, 512, "#FFFFFF"], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 67, "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "link": 68, "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "color"}, "name": "color", "label": "color", "type": "STRING", "localized_name": "color"}], "flags": {}, "id": 33, "type": "LayerUtility: ColorImage", "properties": {"cnr_id": "comfyui_layerstyle", "ver": "89014d833d2ad0998d724090eff1456692692a1d", "ue_properties": {"widget_ue_connectable": {"width": true, "height": true}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {"color": true, "width": true, "height": true}, "Node name for S&R": "LayerUtility: ColorImage"}, "order": 7}, {"outputs": [], "color": "#432", "widgets_values": ["# ComfyUI抠图神器BiRefNet使用指南（超白话版）\n\n**插件地址**：https://github.com/lldacing/ComfyUI_BiRefNet_ll\n\n---\n\n## 一、模型怎么选？新人别慌，我帮你捋捋 🎯\n\n这个插件一口气给了15个模型，刚开始肯定看懵逼。别急，我给你翻译成\"人话\"，对号入座就行：\n\n### **🏆 General系列：万能选手天团**\n\n**General**  \n就是传说中的\"啥都能抠\"基础款！日常99%的图片用它就够了，风景、物品、人物混合场景通吃。  \n💡 举个例子：旅游照里想抠朵小花、路边拍的小野猫，直接甩给它，基本不会出错。\n\n**General-HR**  \n这是General的高清加强版，专门啃2048×2048这种超大图（差不多电脑壁纸那么大），抠出来的边缘更清晰，放大也不糊。  \n💡 举个例子：婚纱照、大幅海报里的人像或物体，用它抠细节保留得贼好。\n\n**General-Lite**  \n轻量级选手，给手机和低配电脑量身定做的。速度飞快，精度虽然比大哥们差一点，但日常简单抠图完全够用。  \n💡 举个例子：手机拍的美食、小物件，想快速抠出来发朋友圈，用它几秒搞定，省电省时间。\n\n**General-Lite-2K**  \n轻量级里的\"高清特派员\"，专门优化了2560×1440分辨率（常见电脑高清屏尺寸），兼顾速度和高清。  \n💡 举个例子：电脑里存的高清风景图，想抠掉里面的云朵，用它又快又清楚。\n\n**General-dynamic**  \n\"变形金钢\"型选手，从256×256（微信头像大小）到2304×2304（超大海报）都能自动适配，不用你手动换模型。  \n💡 举个例子：今天抠手机小截图，明天抠大幅设计图，一个模型全搞定，省心！\n\n**General-reso_512**  \n小图闪电侠，专门啃512×512的小图（普通自拍尺寸），速度超快，精度还不错。  \n💡 举个例子：从聊天记录里抠表情包，用它秒出结果，快如闪电。\n\n**General-legacy**  \n老版本万金油，训练时没加人像数据，所以抠风景、物品更顺手，抠人可能差点意思。  \n💡 举个例子：纯风景照、花草树木，用它比新版更自然。\n\n---\n\n### **🎯 Portrait：人像专用剪刀**\n\n这哥们只干一件事——抠人！不管是全身、半身还是脸部特写，头发丝那种细节都能给你抠得明明白白。  \n💡 举个例子：证件照换背景、人像精修，用它准没错，连根根分明的头发都能保住。\n\n---\n\n### **💎 Matting系列：半透明物体克星**\n\n这个系列的绝招是处理\"无过渡遮罩\"，简单说就是能搞定玻璃、烟雾、婚纱纱裙这类半透明东西，抠出来不会硬邦邦的。\n\n**Matting**  \n基础半透明款，专门抠蕾丝边、玻璃杯这种。  \n💡 举个例子：抠婚纱的蕾丝边、玻璃杯里的水，边缘不会像被\"一刀切\"。\n\n**Matting-HR**  \n高清半透明版，处理2048×2048大图里的半透明物体，比如大幅婚纱海报里的纱裙。  \n💡 举个例子：高清婚纱海报，裙子上的薄纱透明效果用它抠最自然。\n\n**Matting-Lite**  \n轻量半透明版，手机上用也不卡，适合快速抠小图里的半透明物体。  \n💡 举个例子：手机拍的带雾气的窗户，用它快速处理不卡顿。\n\n---\n\n### **🔍 特殊场景专用模型**\n\n**DIS**（二分图像分割）  \n简单粗暴，只把图分成\"目标\"和\"背景\"两部分，非黑即白。适合那种界限特别明确的图。  \n💡 举个例子：一张图里只有一只狗和草地，它能精准把狗（目标）和草地（背景）分开。\n\n**HRSOD**（高分辨率显著目标检测）  \n在高清大图里自动找到最显眼的那个\"显眼包\"并抠出来。  \n💡 举个例子：高清街拍照里最显眼的是穿红衣服的人，用它能快速抠出这个人。\n\n**COD**（隐蔽目标检测）  \n专门找那些和背景长得像、不容易发现的\"隐身\"物体。  \n💡 举个例子：草丛里的蛇、雪地中的兔子，颜色跟背景融为一体，它能把它们揪出来。\n\n**DIS-TR_TEs**（数据大户版）  \n用了超多数据集训练的二分分割模型，不管抠啥都比普通DIS更精准。  \n💡 举个例子：复杂场景（比如菜市场一堆菜里只想抠出西红柿），用它不容易出错。\n\n---\n\n## 二、节点功能：你的抠图工具箱 🔧\n\n这个插件提供了6个功能节点，就像工具箱里的不同扳手：\n\n**AutoDownloadBiRefNetModel**  \n全自动懒人福音，模型会自动下载到 `${comfyui_rootpath}/models/BiRefNet` 文件夹，啥也不用你操心。\n\n**LoadRembgByBiRefNetModel**  \n手动选模型，支持从新模型到老模型（比如BiRefNet-DIS_ep580.pth和BiRefNet-ep480.pth）通吃。  \n⚠️ 小提示：参数`use_weight`设为True时，Lite系列用`swin_tiny...`权重，其他模型用`swin_large...`权重。\n\n**RembgByBiRefNet**  \n基础输出节点，给你透明前景图+遮罩，直接拿去用。\n\n**RembgByBiRefNetAdvanced**  \n进阶版，提供微调参数让你调效果，适合追求完美的人。\n\n**GetMaskByBiRefNet**  \n只要遮罩不要图，速度更快，适合只需要做选区的情况。\n\n**BlurFusionForegroundEstimation**  \n高级货！用\"快速前景预估\"算法优化边缘，抠出来更自然，难搞的图交给它。\n\n---\n\n## 三、总结一句话 🎉\n\n日常抠图用 **General**，高清大图用 **General-HR**，人像用 **Portrait**，半透明用 **Matting**，搞不定的冷门需求看看特殊专用模型。节点一拖一连，模型自动下，小白也能变抠图大师！"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [574.3701782226562, 688.2299194335938], "pos": [-1806.1234130859375, -559.1859741210938], "id": 38, "properties": {}, "order": 2}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "workspace_info": {"id": "NJmIRhEJZURv5BtjSUZ3a"}, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.25.11", "VHS_latentpreview": false, "ds": {"offset": [2277.823012289244, 695.8446815748081], "scale": 0.9646149645000006}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "图片预览区", "bounding": [-767.4578247070312, -315.1029968261719, 1122.0216064453125, 536.1405639648438]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "模型加载区", "bounding": [-763.687744140625, -635.5320434570312, 1120.13671875, 303.35809326171875]}], "links": [[49, 27, 0, 26, 0, "BIREFNET"], [50, 28, 0, 26, 1, "IMAGE"], [54, 26, 0, 31, 0, "IMAGE"], [56, 26, 0, 30, 0, "IMAGE"], [57, 28, 0, 30, 1, "IMAGE"], [58, 33, 0, 34, 0, "IMAGE"], [60, 34, 0, 35, 0, "IMAGE"], [64, 26, 1, 34, 2, "MASK"], [66, 26, 0, 34, 1, "IMAGE"], [67, 37, 0, 33, 0, "INT"], [68, 37, 1, 33, 1, "INT"], [69, 28, 0, 37, 0, "IMAGE"]], "id": "5ae5b56d-3efc-4c34-b128-02886607c9e5", "config": {}, "version": 0.4, "last_node_id": 38, "revision": 0}