"fps"}, "name": "fps", "label": "fps", "type": "FLOAT", "localized_name": "fps"}, {"widget": {"name": "bit_depth"}, "shape": 7, "name": "bit_depth", "label": "bit_depth", "type": "COMBO", "localized_name": "bit_depth"}, {"widget": {"name": "color_space"}, "shape": 7, "name": "color_space", "label": "color_space", "type": "COMBO", "localized_name": "color_space"}, {"widget": {"name": "chroma_subsampling"}, "shape": 7, "name": "chroma_subsampling", "label": "chroma_subsampling", "type": "COMBO", "localized_name": "chroma_subsampling"}, {"widget": {"name": "codec"}, "shape": 7, "name": "codec", "label": "codec", "type": "COMBO", "localized_name": "codec"}], "flags": {}, "type": "CreateVideo", "title": "合成视频（24fps）", "mode": 0, "size": [340, 210], "pos": [1820, 3298], "id": 32, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CreateVideo"}, "order": 35, "widgets_values_named": {"codec": "none", "fps": 24, "chroma_subsampling": "auto", "bit_depth": "auto", "color_space": "sRGB"}}, {"outputs": [{"name": "video_url", "slot_index": 0, "links": [], "label": "video_url", "type": "STRING", "localized_name": "video_url"}, {"name": "video", "slot_index": 1, "links": [], "label": "video", "type": "VIDEO", "localized_name": "video"}], "widgets_values": ["MiniMax_H3_带货三图", "auto", "auto", "auto"], "inputs": [{"name": "video", "link": 29, "label": "video", "type": "VIDEO", "localized_name": "video"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}, {"widget": {"name": "format"}, "name": "format", "label": "format", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "format"}, {"widget": {"name": "format.codec"}, "name": "format.codec", "label": "format.codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "codec"}, {"widget": {"name": "codec"}, "shape": 7, "name": "codec", "label": "codec", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "codec"}], "flags": {}, "type": "SaveVideo", "title": "保存视频 SaveVideo", "mode": 0, "size": [340, 768], "pos": [1820, 3558], "id": 33, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveVideo"}, "order": 36, "widgets_values_named": {"codec": "auto", "filename_prefix": "MiniMax_H3_带货三图", "format": "auto", "format.codec": "auto"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Ⅰ 输入区｜三图 + 音色\n\n**连接顺序决定提示词编号**（从 1 开始）：\n\n- `ref_image_0` → `<Picture 1>` 模特图\n- `ref_image_1` → `<Picture 2>` 产品图\n- `ref_image_2` → `<Picture 3>` 背景图\n- `ref_audio_0` → `<Audio 1>` 模特音色\n\n> 编号就是连接顺序。改接线或增删参考图，提示词里的 `<Picture N>` 要同步改，否则会张冠李戴。\n\n### 节点属性\n**LoadImage**\n- `image`：从 input 目录选图，点节点上的 upload 也可直接上传\n- 输出 IMAGE 接参考槽；MASK 本流程不用\n\n**LoadAudio**\n- `audio`：input 目录里的音频文件\n- `audioUI`：节点上的播放/波形条，只是预览\n- 输出 AUDIO 接 `<Audio 1>`，只取音色，不取内容\n\n### 素材要求\n- 模特图：正脸或 3/4 侧脸，脸部占画面 ≥25%，半身/全身都可以；不要多人合照\n- 产品图：纯色背景、正面单图，logo 与文字要清晰，最好是实拍图而不是渲染图\n- 背景图：与成品同比例（竖版），构图里留出人物站立的位置\n- 音色：3~15 秒干净人声，不要有背景音乐，不要混响过重"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "说明｜Ⅰ 输入区｜三图 + 音色", "mode": 0, "bgcolor": "#653", "size": [420, 500], "pos": [1120, 56], "id": 100, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 16, "widgets_values_named": {"text": "## Ⅰ 输入区｜三图 + 音色\n\n**连接顺序决定提示词编号**（从 1 开始）：\n\n- `ref_image_0` → `<Picture 1>` 模特图\n- `ref_image_1` → `<Picture 2>` 产品图\n- `ref_image_2` → `<Picture 3>` 背景图\n- `ref_audio_0` → `<Audio 1>` 模特音色\n\n> 编号就是连接顺序。改接线或增删参考图，提示词里的 `<Picture N>` 要同步改，否则会张冠李戴。\n\n### 节点属性\n**LoadImage**\n- `image`：从 input 目录选图，点节点上的 upload 也可直接上传\n- 输出 IMAGE 接参考槽；MASK 本流程不用\n\n**LoadAudio**\n- `audio`：input 目录里的音频文件\n- `audioUI`：节点上的播放/波形条，只是预览\n- 输出 AUDIO 接 `<Audio 1>`，只取音色，不取内容\n\n### 素材要求\n- 模特图：正脸或 3/4 侧脸，脸部占画面 ≥25%，半身/全身都可以；不要多人合照\n- 产品图：纯色背景、正面单图，logo 与文字要清晰，最好是实拍图而不是渲染图\n- 背景图：与成品同比例（竖版），构图里留出人物站立的位置\n- 音色：3~15 秒干净人声，不要有背景音乐，不要混响过重"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Ⅱ 文案区｜动作 / 台词 / 模板\n\n三块内容按顺序拼成最终提示词：\n\n`模板头` → `动作提示词` → `台词` → `尾部要求`\n\n### 节点属性\n**PrimitiveStringMultiline**\n- `value`：唯一参数，多行文本，改这里就是改提示词\n\n**StringConcatenate**（A / B / C 三个）\n- `string_a`：前半段（通常是上一级拼接结果）\n- `string_b`：后半段\n- `delimiter`：\n  - 拼接 A = 空\n  - 拼接 B = `(S1) 用 <Audio 1> 的音色…` 那句引导语\n  - 拼接 C = `</d>` 收尾标签\n\n### 台词写法\n直接写汉字，**不要自己加引号、书名号、`<d>` 标签**——标签由拼接②自动加。\n\n字数参考：每秒 4~5 个汉字。10 秒的片子别超过 45 字，超了会被截断或语速飙快。\n\n### 动作提示词写法\n写「身体在干什么」，不要写「画面很好看」：\n拿起来 → 转向镜头 → 手指点产品 → 前倾 → 递近。\n一段里 3~5 个动作最稳，太多会糊。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "说明｜Ⅱ 文案区｜动作 / 台词 / 模板", "mode": 0, "bgcolor": "#653", "size": [420, 522], "pos": [2940, 56], "id": 101, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 17, "widgets_values_named": {"text": "## Ⅱ 文案区｜动作 / 台词 / 模板\n\n三块内容按顺序拼成最终提示词：\n\n`模板头` → `动作提示词` → `台词` → `尾部要求`\n\n### 节点属性\n**PrimitiveStringMultiline**\n- `value`：唯一参数，多行文本，改这里就是改提示词\n\n**StringConcatenate**（A / B / C 三个）\n- `string_a`：前半段（通常是上一级拼接结果）\n- `string_b`：后半段\n- `delimiter`：\n  - 拼接 A = 空\n  - 拼接 B = `(S1) 用 <Audio 1> 的音色…` 那句引导语\n  - 拼接 C = `</d>` 收尾标签\n\n### 台词写法\n直接写汉字，**不要自己加引号、书名号、`<d>` 标签**——标签由拼接②自动加。\n\n字数参考：每秒 4~5 个汉字。10 秒的片子别超过 45 字，超了会被截断或语速飙快。\n\n### 动作提示词写法\n写「身体在干什么」，不要写「画面很好看」：\n拿起来 → 转向镜头 → 手指点产品 → 前倾 → 递近。\n一段里 3~5 个动作最稳，太多会糊。"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Ⅲ 模型区｜MiniMax H3\n\n四个加载器 + 两个加速节点，串成一条 MODEL 链交给采样器。\n\n### 节点属性\n**UNETLoader**\n- `unet_name`：minimax_h3_fl2va_pruned_int8_convrot.safetensors\n- `weight_dtype`：default\n- fl2va = 支持参考图 + 参考音频 + 原生音频；别改 fp8，H3 已是 int8 convrot 量化，再套 fp8 会糊\n\n**CLIPLoader**\n- `clip_name`：qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors\n- `type`：必须选 minimax，选错直接报错\n- `device`：default\n\n**VAELoader ×2**\n- 上面接 minimax_h3_video_vae_fp16（画面）\n- 下面接 minimax_h3_audio_vae_fp32（声音，**必接**，不接就出不了人声）\n\n**PathchSageAttentionKJ**\n- `sage_attention`：`auto`（只有老卡或报错时才改 disabled）\n- `allow_compile`：false\n\n**EasyCache**\n- `reuse_threshold`：0.2，越小越准越慢\n- `start_percent` / `end_percent`：0.15 / 0.90，头尾不缓存，保证起幅与收尾稳定\n- `verbose`：false\n\n> 模型来自 Comfy-Org/MiniMax-H3，四个文件放 diffusion_models / text_encoders / vae 三个目录。缺哪个，加载器下拉里就选不到——不是工作流的问题。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "说明｜Ⅲ 模型区｜MiniMax H3", "mode": 0, "bgcolor": "#653", "size": [480, 556], "pos": [780, 1612], "id": 102, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 18, "widgets_values_named": {"text": "## Ⅲ 模型区｜MiniMax H3\n\n四个加载器 + 两个加速节点，串成一条 MODEL 链交给采样器。\n\n### 节点属性\n**UNETLoader**\n- `unet_name`：minimax_h3_fl2va_pruned_int8_convrot.safetensors\n- `weight_dtype`：default\n- fl2va = 支持参考图 + 参考音频 + 原生音频；别改 fp8，H3 已是 int8 convrot 量化，再套 fp8 会糊\n\n**CLIPLoader**\n- `clip_name`：qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors\n- `type`：必须选 minimax，选错直接报错\n- `device`：default\n\n**VAELoader ×2**\n- 上面接 minimax_h3_video_vae_fp16（画面）\n- 下面接 minimax_h3_audio_vae_fp32（声音，**必接**，不接就出不了人声）\n\n**PathchSageAttentionKJ**\n- `sage_attention`：`auto`（只有老卡或报错时才改 disabled）\n- `allow_compile`：false\n\n**EasyCache**\n- `reuse_threshold`：0.2，越小越准越慢\n- `start_percent` / `end_percent`：0.15 / 0.90，头尾不缓存，保证起幅与收尾稳定\n- `verbose`：false\n\n> 模型来自 Comfy-Org/MiniMax-H3，四个文件放 diffusion_models / text_encoders / vae 三个目录。缺哪个，加载器下拉里就选不到——不是工作流的问题。"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Ⅳ 生成区｜分辨率 · 时长 · 参考绑定\n\n### 节点属性\n**ResolutionSelector**\n- `aspect_ratio`：`9:16 (Portrait Widescreen)` 竖版带货\n- `megapixels`：0.5 → 约 544×928；追画质 0.9 → 704×1280，显存吃紧降到 0.4\n- `multiple`：32（H3 要求 32 的倍数）\n\n**PrimitiveInt（时长）**\n- `value`：秒数，**5~15**（H3 训练区间 124~362 帧，超出必崩）\n\n**ComfyMathExpression**\n- `expression`：max(5, round(a*24)) 再补齐到 5+17n（已填好，不用动）\n- `values.a`：接秒数\n- 作用：24fps × 秒数，再补到 5+17n 的合法帧数（H3 帧数步长 17）\n\n**MiniMax H3 参考生视频**\n- `prompt`：由 Ⅱ 文案区拼好送进来（已转成输入，节点上看不到框）\n- `width` / `height`：由分辨率节点送进来\n- `length`：由换算节点送进来\n- `ref_image_size`：\n  - `match`：按画布像素面积缩放，快\n  - `max`：按 2048 短边保留，身份/产品还原更准，**慢数倍**\n- 参考槽：`ref_image_0~2`（三图）、`ref_audio_0`（音色）\n\n### 为什么不用负向提示词\nH3 这条链走 BasicGuider，只有 positive 一路；负面要求写进尾部提示词的「【禁止】」里。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "说明｜Ⅳ 生成区｜分辨率 · 时长 · 参考绑定", "mode": 0, "bgcolor": "#653", "size": [460, 516], "pos": [2420, 1612], "id": 103, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 19, "widgets_values_named": {"text": "## Ⅳ 生成区｜分辨率 · 时长 · 参考绑定\n\n### 节点属性\n**ResolutionSelector**\n- `aspect_ratio`：`9:16 (Portrait Widescreen)` 竖版带货\n- `megapixels`：0.5 → 约 544×928；追画质 0.9 → 704×1280，显存吃紧降到 0.4\n- `multiple`：32（H3 要求 32 的倍数）\n\n**PrimitiveInt（时长）**\n- `value`：秒数，**5~15**（H3 训练区间 124~362 帧，超出必崩）\n\n**ComfyMathExpression**\n- `expression`：max(5, round(a*24)) 再补齐到 5+17n（已填好，不用动）\n- `values.a`：接秒数\n- 作用：24fps × 秒数，再补到 5+17n 的合法帧数（H3 帧数步长 17）\n\n**MiniMax H3 参考生视频**\n- `prompt`：由 Ⅱ 文案区拼好送进来（已转成输入，节点上看不到框）\n- `width` / `height`：由分辨率节点送进来\n- `length`：由换算节点送进来\n- `ref_image_size`：\n  - `match`：按画布像素面积缩放，快\n  - `max`：按 2048 短边保留，身份/产品还原更准，**慢数倍**\n- 参考槽：`ref_image_0~2`（三图）、`ref_audio_0`（音色）\n\n### 为什么不用负向提示词\nH3 这条链走 BasicGuider，只有 positive 一路；负面要求写进尾部提示词的「【禁止】」里。"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Ⅴ 采样区\n\n五件套拼出 SamplerCustomAdvanced，H3 官方推荐组合。\n\n### 节点属性\n**RandomNoise**\n- `noise_seed`：种子；右侧 `randomize / fixed` 控制每次是否换种子\n- 想复现同一版就切 fixed，想碰运气就 randomize\n\n**KSamplerSelect**\n- `sampler_name`：`res_multistep`（H3 推荐，别用 euler 系）\n\n**BasicScheduler**\n- `scheduler`：`simple`\n- `steps`：25（20~30 都行；低于 20 细节散，高于 30 收益很小）\n- `denoise`：1.0（这是全新建，不是重绘）\n\n**BasicGuider**\n- `model`：接加速后的 MODEL\n- `conditioning`：接 H3 的 positive\n\n**SamplerCustomAdvanced**\n- 五个输入缺一不可：noise / guider / sampler / sigmas / latent_image\n- `latent_image` 就是 H3 出的空 latent（含音轨长度），不要自己接 EmptyLatent\n\n> 出的 latent 同时含画面与音频两路，所以下面要一分为二：VAEDecode 走视频 VAE，VAEDecodeAudio 走音频 VAE。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "说明｜Ⅴ 采样区", "mode": 0, "bgcolor": "#653", "size": [460, 494], "pos": [512.4109616070548, 3068.0876533934374], "id": 104, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 20, "widgets_values_named": {"text": "## Ⅴ 采样区\n\n五件套拼出 SamplerCustomAdvanced，H3 官方推荐组合。\n\n### 节点属性\n**RandomNoise**\n- `noise_seed`：种子；右侧 `randomize / fixed` 控制每次是否换种子\n- 想复现同一版就切 fixed，想碰运气就 randomize\n\n**KSamplerSelect**\n- `sampler_name`：`res_multistep`（H3 推荐，别用 euler 系）\n\n**BasicScheduler**\n- `scheduler`：`simple`\n- `steps`：25（20~30 都行；低于 20 细节散，高于 30 收益很小）\n- `denoise`：1.0（这是全新建，不是重绘）\n\n**BasicGuider**\n- `model`：接加速后的 MODEL\n- `conditioning`：接 H3 的 positive\n\n**SamplerCustomAdvanced**\n- 五个输入缺一不可：noise / guider / sampler / sigmas / latent_image\n- `latent_image` 就是 H3 出的空 latent（含音轨长度），不要自己接 EmptyLatent\n\n> 出的 latent 同时含画面与音频两路，所以下面要一分为二：VAEDecode 走视频 VAE，VAEDecodeAudio 走音频 VAE。"}}, {"outputs": [], "color": "#432", "widgets_values": ["## Ⅵ 输出区\n\n### 节点属性\n**VAEDecode**\n- `samples` ← 采样结果，`vae` ← **视频** VAE\n\n**VAEDecodeAudio**\n- `samples` ← 同一条采样结果，`vae` ← **音频** VAE\n- 别漏接，漏了成片没声音\n\n**CreateVideo**\n- `fps`：**24**（H3 原生帧率，改成 30 会变速）\n- `bit_depth`：8\n- `color_space`：sRGB\n- `codec`：none（交给 SaveVideo 决定封装）\n- `chroma_subsampling`：420。有些版本没这一项，那就把 codec 保持 none\n\n**SaveVideo**\n- `filename_prefix`：输出目录前缀，默认 `MiniMax_H3`\n- `format`：auto，mp4 直接可发\n- 存到 output 目录，节点上可预览\n\n### 成片时长\n= 帧数 ÷ 24。比如时长填 10 秒 → 243 帧 → 10.1 秒。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "说明｜Ⅵ 输出区", "mode": 0, "bgcolor": "#653", "size": [440, 454], "pos": [2241.7863078569317, 3083.265730179329], "id": 105, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 21, "widgets_values_named": {"text": "## Ⅵ 输出区\n\n### 节点属性\n**VAEDecode**\n- `samples` ← 采样结果，`vae` ← **视频** VAE\n\n**VAEDecodeAudio**\n- `samples` ← 同一条采样结果，`vae` ← **音频** VAE\n- 别漏接，漏了成片没声音\n\n**CreateVideo**\n- `fps`：**24**（H3 原生帧率，改成 30 会变速）\n- `bit_depth`：8\n- `color_space`：sRGB\n- `codec`：none（交给 SaveVideo 决定封装）\n- `chroma_subsampling`：420。有些版本没这一项，那就把 codec 保持 none\n\n**SaveVideo**\n- `filename_prefix`：输出目录前缀，默认 `MiniMax_H3`\n- `format`：auto，mp4 直接可发\n- 存到 output 目录，节点上可预览\n\n### 成片时长\n= 帧数 ÷ 24。比如时长填 10 秒 → 243 帧 → 10.1 秒。"}}, {"outputs": [], "color": "#432", "widgets_values": ["# 数字人 · 电商带货视频 · 三图版（MiniMax H3）\n\n**一句话**：给一张模特图、一张产品图、一张背景图、一段音色、一段台词、一段动作提示词，直接出**竖版带货口播视频**——画面和人声一起生成，不用另外配音、不用对口型。\n\n---\n\n## 一、六个输入都在哪\n\n| 输入 | 位置 | 节点 |\n|---|---|---|\n| 产品图 | Ⅰ 输入区 | ② 产品图 |\n| 背景图 | Ⅰ 输入区 | ③ 背景图 |\n| 模特图 | Ⅰ 输入区 | ① 模特图 |\n| 模特音色 | Ⅰ 输入区 | ④ 模特音色 |\n| 要说的话 | Ⅱ 文案区 | ⑦ 要说的话 |\n| 动作提示词 | Ⅱ 文案区 | ⑥ 动作提示词 |\n\n## 二、参考标签必须对上号\n\nH3 用标签把参考物绑定进提示词，**编号从 1 开始，按接线顺序**：\n\n- `<Picture 1>` = 模特图（人物身份）\n- `<Picture 2>` = 产品图（商品外观）\n- `<Picture 3>` = 背景图（场景光影）\n- `<Audio 1>` = 模特音色（只取音色）\n\n改了接线顺序，模板里的编号要一起改。\n\n## 三、主要参数\n\n- **时长**：Ⅳ 区「时长（秒）」，5~15 秒；帧数由公式补成 5+17n\n- **分辨率**：Ⅳ 区 ResolutionSelector，9:16 / 0.5MP / 32 → 约 544×928\n- **采样**：res_multistep + simple + 25 步 + denoise 1.0\n- **参考精度**：H3 节点 `ref_image_size`，match 快 / max 准（慢数倍）\n- **输出**：24fps，mp4，音轨来自生成结果\n\n## 四、模型（Comfy-Org/MiniMax-H3）\n\n- `minimax_h3_fl2va_pruned_int8_convrot.safetensors` → diffusion_models\n- `qwen3vl_32b_minimax_h3_*.safetensors` → text_encoders\n- `minimax_h3_video_vae_fp16.safetensors` → vae\n- `minimax_h3_audio_vae_fp32.safetensors` → vae\n\n## 五、常见问题\n\n- **产品被改款**：产品图换纯色背景正面图；提示词已写「不得改写产品」，别删\n- **人物不像**：`ref_image_size` 改 `max`；模特图脸部占画面 25% 以上\n- **台词没说完**：每秒 4~5 个汉字，10 秒别超过 45 字\n- **还是有字幕**：台词里别写引号、书名号；模板「【禁止】」那段别删\n- **时长报错**：只能是 5~15 秒（124~362 帧）\n- **没声音**：检查音频 VAE 是否接到 H3 的 `audio_vae`，以及 VAEDecodeAudio 是否接了"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "使用说明（先看这里）", "mode": 0, "bgcolor": "#653", "size": [1700, 902], "pos": [-40, -1142], "id": 200, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 22, "widgets_values_named": {"text": "# 数字人 · 电商带货视频 · 三图版（MiniMax H3）\n\n**一句话**：给一张模特图、一张产品图、一张背景图、一段音色、一段台词、一段动作提示词，直接出**竖版带货口播视频**——画面和人声一起生成，不用另外配音、不用对口型。\n\n---\n\n## 一、六个输入都在哪\n\n| 输入 | 位置 | 节点 |\n|---|---|---|\n| 产品图 | Ⅰ 输入区 | ② 产品图 |\n| 背景图 | Ⅰ 输入区 | ③ 背景图 |\n| 模特图 | Ⅰ 输入区 | ① 模特图 |\n| 模特音色 | Ⅰ 输入区 | ④ 模特音色 |\n| 要说的话 | Ⅱ 文案区 | ⑦ 要说的话 |\n| 动作提示词 | Ⅱ 文案区 | ⑥ 动作提示词 |\n\n## 二、参考标签必须对上号\n\nH3 用标签把参考物绑定进提示词，**编号从 1 开始，按接线顺序**：\n\n- `<Picture 1>` = 模特图（人物身份）\n- `<Picture 2>` = 产品图（商品外观）\n- `<Picture 3>` = 背景图（场景光影）\n- `<Audio 1>` = 模特音色（只取音色）\n\n改了接线顺序，模板里的编号要一起改。\n\n## 三、主要参数\n\n- **时长**：Ⅳ 区「时长（秒）」，5~15 秒；帧数由公式补成 5+17n\n- **分辨率**：Ⅳ 区 ResolutionSelector，9:16 / 0.5MP / 32 → 约 544×928\n- **采样**：res_multistep + simple + 25 步 + denoise 1.0\n- **参考精度**：H3 节点 `ref_image_size`，match 快 / max 准（慢数倍）\n- **输出**：24fps，mp4，音轨来自生成结果\n\n## 四、模型（Comfy-Org/MiniMax-H3）\n\n- `minimax_h3_fl2va_pruned_int8_convrot.safetensors` → diffusion_models\n- `qwen3vl_32b_minimax_h3_*.safetensors` → text_encoders\n- `minimax_h3_video_vae_fp16.safetensors` → vae\n- `minimax_h3_audio_vae_fp32.safetensors` → vae\n\n## 五、常见问题\n\n- **产品被改款**：产品图换纯色背景正面图；提示词已写「不得改写产品」，别删\n- **人物不像**：`ref_image_size` 改 `max`；模特图脸部占画面 25% 以上\n- **台词没说完**：每秒 4~5 个汉字，10 秒别超过 45 字\n- **还是有字幕**：台词里别写引号、书名号；模板「【禁止】」那段别删\n- **时长报错**：只能是 5~15 秒（124~362 帧）\n- **没声音**：检查音频 VAE 是否接到 H3 的 `audio_vae`，以及 VAEDecodeAudio 是否接了"}}], "extra": {"links_added_by_ue": [], "ue_links": [], "pixaromaGroups": [], "0246.VERSION": [0, 0, 4], "frontendVersion": "1.30.0", "ds": {"offset": [-1022.2889640810102, -65.91693450908565], "scale": 0.9646149645000041}}, "groups": [{"color": "#88A", "flags": {}, "id": 901, "title": "Ⅰ 输入区｜模特 · 产品 · 背景 · 音色", "bounding": [0, 0, 1580, 666]}, {"color": "#88A", "flags": {}, "id": 902, "title": "Ⅱ 文案区｜动作 · 台词 · 提示词模板", "bounding": [1780, 0, 1620, 1276]}, {"color": "#A88", "flags": {}, "id": 903, "title": "Ⅲ 模型区｜MiniMax H3 全套加载器", "bounding": [0, 1556, 1300, 1056]}, {"color": "#A88", "flags": {}, "id": 904, "title": "Ⅳ 生成区｜分辨率 · 时长 · 参考绑定", "bounding": [1780, 1556, 1140, 1126]}, {"color": "#8A8", "flags": {}, "id": 905, "title": "Ⅴ 采样区｜res_multistep 25 步", "bounding": [0, 2962, 1020, 866]}, {"color": "#8A8", "flags": {}, "id": 906, "title": "Ⅵ 输出区｜24fps 成片", "bounding": [1780, 2962, 952.410961607055, 1409.024535361123]}], "links": [[13, 23, 0, 28, 1, "CONDITIONING"], [14, 28, 0, 29, 1, "GUIDER"], [15, 23, 1, 29, 4, "LATENT"], [16, 12, 0, 16, 0, "MODEL"], [17, 16, 0, 17, 0, "MODEL"], [18, 17, 0, 27, 0, "MODEL"], [19, 17, 0, 28, 0, "MODEL"], [20, 25, 0, 29, 0, "NOISE"], [21, 26, 0, 29, 2, "SAMPLER"], [22, 27, 0, 29, 3, "SIGMAS"], [23, 14, 0, 30, 1, "VAE"], [24, 15, 0, 31, 1, "VAE"], [25, 29, 0, 30, 0, "LATENT"], [26, 29, 0, 31, 0, "LATENT"], [27, 30, 0, 32, 0, "IMAGE"], [28, 31, 0, 32, 1, "AUDIO"], [30, 7, 0, 8, 0, "STRING"], [31, 5, 0, 8, 1, "STRING"], [32, 8, 0, 9, 0, "STRING"], [33, 6, 0, 9, 1, "STRING"], [34, 9, 0, 10, 0, "STRING"], [35, 11, 0, 10, 1, "STRING"], [11, 21, 0, 22, 0, "INT"], [29, 32, 0, 33, 0, "VIDEO"], [5, 13, 0, 23, 0, "CLIP"], [6, 14, 0, 23, 1, "VAE"], [7, 15, 0, 23, 2, "VAE"], [1, 1, 0, 23, 3, "IMAGE"], [2, 2, 0, 23, 4, "IMAGE"], [3, 3, 0, 23, 5, "IMAGE"], [4, 4, 0, 23, 10, "AUDIO"], [8, 10, 0, 23, 13, "STRING"], [9, 20, 0, 23, 14, "INT"], [10, 20, 1, 23, 15, "INT"], [12, 22, 1, 23, 16, "INT"]], "id": "e5c1a7b2-3f04-4d18-9a6c-7b1d2c9e4f50", "config": {}, "version": 0.4, "last_node_id": 200, "revision": 0}