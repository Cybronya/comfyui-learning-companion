e": "IMAGE", "localized_name": "image"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "megapixels"}, {"widget": {"name": "resolution_steps"}, "name": "resolution_steps", "label": "resolution_steps", "type": "INT", "localized_name": "resolution_steps"}], "flags": {}, "type": "ImageScaleToTotalPixels", "mode": 0, "bgcolor": "#353", "size": [295.2969055175781, 106], "pos": [1818.070068359375, 1881.2935791015625], "id": 25, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImageScaleToTotalPixels"}, "order": 20}, {"outputs": [], "color": "#323", "widgets_values": ["型号：选择您的 DiT 型号\n\n3B 型号：速度更快，显存需求更低\n- seedvr2_ema_3b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_3b_fp8_e4m3fn.safetensorsFP8 8位（高质量）\n- seedvr2_ema_3b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_3b-Q8_0.ggufGGUF 8 位量化（高质量）\n\n7B 型号：画质更高，显存需求更高\n- seedvr2_ema_7b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors：FP8，最后一个数据块使用FP16，以减少伪影（质量良好）\n- seedvr2_ema_7b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_7b_sharp_*：锐化版本，增强细节\n\n设备：用于 DiT 推理的 GPU 设备（例如，cuda:0）\n\noffload_device：当 DiT 模型不处于活跃处理状态时，用于卸载 DiT 模型的设备\n- none：将模型保存在推理设备（速度最快、显存最大的设备）上\n- cpu：卸载到系统内存（减少显存）\n- cuda:X：将负载转移到另一块GPU（如果可用，则可获得良好的负载均衡）\n\ncache_model：在工作流运行之间，保持卸载设备上的 DiT 模型加载状态\n- 适用于批量处理，避免重复加载\n- 需要设置 offload_device\n\nblocks_to_swap：块交换内存优化\n- 0：已禁用（默认）\n- 1-32：需要替换为 3B 型号的变压器模块数量\n- 1-36：需要更换为 7B 型号的变压器模块数量\n- 数值越高，节省的显存越多，但处理速度越慢。\n- 需要设置 offload_device 并且使其与 device 不同。\n\nswap_io_components：卸载输入/输出嵌入和归一化层\n\n- 结合 blocks_to_swap 可进一步节省 VRAM\n- 需要设置 offload_device 并且使其与 device 不同。\n\nattention_mode：注意力计算后端\n- sdpa: PyTorch scaled_dot_product_attention（默认值，稳定，始终可用）\n- flash_attnFlash Attention 2（在支持的硬件上速度更快，需要 flash-attn 软件包）\n\ntorch_compile_args：连接到 SeedVR2 Torch 编译设置节点，可提升 20-40% 的速度。\n\nBlockSwap详解：\nBlockSwap 允许在显存有限的 GPU 上运行大型模型，它在推理过程中动态地在 GPU 和 CPU 内存之间交换 Transformer 模块。其工作原理如下：\n\n- 它的作用：仅将当前需要的转换器模块保留在 GPU 上，而将其余模块存储在 CPU 或其他设备上。\n- 何时使用：在放大阶段出现 OOM（内存不足）错误时\n- 如何配置：\n设置offload_device为cpu或其他 GPU\n先从blocks_to_swap=16（一半的积木）开始\n如果仍然出现内存不足的情况，请增加到 24 或 32 (3B) / 36 (7B)。\n启用此功能swap_io_components可最大程度节省显存\n如果显存充足，可以降低或设置为 0 以加快处理速度。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#535", "size": [414.3453674316406, 715.8207397460938], "pos": [3025.19482421875, 1825.556640625], "id": 26, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"mode": 0, "outputs": [{"name": "INT", "links": [9], "label": "INT", "type": "INT", "localized_name": "INT"}], "size": [247.49913024902344, 58], "pos": [2279.746337890625, 2357.22705078125], "widgets_values": [1088], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "id": 27, "type": "Int", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"}, "order": 9}, {"mode": 4, "outputs": [{"color_off": "#a80", "name": "OPT_CONNECTION", "links": [29], "label": "OPT_CONNECTION", "dir": 4, "type": "*", "color_on": "#Fc0"}], "size": [247.65780639648438, 60], "pos": [1012.7942504882812, 419.584228515625], "inputs": [{"name": "", "label": "", "dir": 3, "type": "*"}], "flags": {}, "id": 28, "type": "Mute / Bypass Repeater (rgthree)", "properties": {"widget_ue_connectable": {}}, "order": 10}, {"outputs": [{"name": "INT", "links": [17, 19], "label": "INT", "type": "INT", "localized_name": "INT"}], "color": "#332922", "widgets_values": [2], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "INT", "localized_name": "value"}], "flags": {}, "type": "Int", "mode": 4, "bgcolor": "#593930", "size": [240.3561553955078, 59.68643569946289], "pos": [1021.9893188476562, 633.6181640625], "id": 29, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Int"},