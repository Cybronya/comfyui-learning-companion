] —— Octane Render / Unreal Engine 5 风格，照片级真实感 3D CGI；高细节皮肤着色，包含次表面散射（SSS）效果，皮肤毛孔与肌理细腻真实；逼真的织物纹理，精细的基于发丝的毛发渲染，清晰的高光贴图；8K 分辨率，中性原始渲染输出，无卡通滤镜，无塑料感的光滑皮肤效果。"], "inputs": [{"widget": {"name": "text"}, "name": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"pinned": true}, "id": 82, "type": "CR Text", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CR Text"}, "order": 10}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "image_urls"}, {"name": "images", "links": [], "type": "IMAGE", "localized_name": "images"}], "size": [292.9459228515625, 479.4766845703125], "pos": [426.27392578125, 84.3280029296875], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {"pinned": true}, "id": 116, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 11}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [957.1940097424634, -271.46690645301874], "scale": 0.7627768444385551}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 3, "title": "设置宽高-支持2K直出", "bounding": [-962.4932250976562, 326.3267517089844, 434.70013427734375, 250.6745147705078]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 4, "title": "第一步", "bounding": [-488.7353820800781, -0.009261732921004295, 1475.90966796875, 588.0526123046875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 5, "title": "第三步", "bounding": [-958.4130859375, 1209.1514892578125, 1200.78857421875, 642.1343383789062]}, {"color": "#3f789e", "font_size": 24, "flags": {"pinned": true}, "id": 6, "title"