瓜、葡萄、洋葱、胡萝卜等），作为边框装饰\n\n请确保识别时区分文字层、图形层、价格标签层、商品照片层，并为每层标注清晰语义和空间位置关系。\n\n"], "inputs": [{"name": "clip", "link": 27, "label": "CLIP", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "文本"}], "flags": {"collapsed": false}, "id": 22, "type": "CLIPTextEncode", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.5.1", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 9}, {"mode": 0, "outputs": [{"name": "LATENT", "links": [25], "label": "LATENT", "type": "LATENT", "localized_name": "Latent"}], "size": [309.6197204589844, 130], "pos": [1584.6910400390625, 1285.0880126953125], "widgets_values": [1024, 1024, 13, 1], "inputs": [{"widget": {"name": "width"}, "name": "width", "link": 52, "label": "width", "type": "INT", "localized_name": "宽度"}, {"widget": {"name": "height"}, "name": "height", "link": 53, "label": "height", "type": "INT", "localized_name": "高度"}, {"widget": {"name": "length"}, "name": "length", "link": 10, "label": "length", "type": "INT", "localized_name": "长度"}, {"widget": {"name": "batch_size"}, "name": "batch_size", "label": "batch_size", "type": "INT", "localized_name": "批量大小"}], "flags": {}, "id": 7, "type": "EmptyHunyuanLatentVideo", "properties": {"hasSecondTab": false, "cnr_id": "comfy-core", "ver": "0.5.1", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "EmptyHunyuanLatentVideo", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "ue_links": [], "VHS_MetadataImage": true, "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.0", "VHS_latentpreview": false, "ds": {"offset": [-959.2650570112764, -474.