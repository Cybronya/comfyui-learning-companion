[318], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [270, 102], "pos": [3260.084228515625, 1011.93212890625], "widgets_values": ["right", true], "inputs": [{"name": "image1", "link": 296, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"name": "image2", "link": 277, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"widget": {"name": "direction"}, "name": "direction", "label": "direction", "type": "COMBO", "localized_name": "direction"}, {"widget": {"name": "match_image_size"}, "name": "match_image_size", "label": "match_image_size", "type": "BOOLEAN", "localized_name": "match_image_size"}], "flags": {}, "id": 166, "type": "ImageConcanate", "properties": {"ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"match_image_size": true, "direction": true}, "Node name for S&R": "ImageConcanate"}, "order": 29}, {"mode": 2, "outputs": [{"name": "prompt", "links": [317], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [412.822265625, 300.47698974609375], "pos": [-1492.3382568359375, 1399.3182373046875], "widgets_values": ["分析这张图片，推测并创作一个可能导致该场景的事件时间线。以电影分镜方式，把推测的系列事件按发生顺序制作成9格分镜网格，每个分镜展现事件的连续发展过程。保证人物的外貌一致性,保持原有图片的风格。要求有多种景别,多场景和多种角度的图片,体现专业的电影镜头感."], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 214, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 17}, {"mode": 2, "outputs": [{"name": "prompt", "links": [316], "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"name": "show_help", "label": "show_help", "type": "STRING", "localized_name": "show_help"}], "size": [412.822265625, 300.47698974609375], "pos": [-1019.9365844726562, 1400.8685302734375], "widgets_values": ["<指令>\n\n分析输入图像的整个构图。识别出所有出现的主体（无论是单个人、一群人/一对人、一辆车还是某个特定的物体）以及它们之间的空间关系和互动方式。\n\n生成一个连贯的3x3网格“电影式联系图”，其中包含9个在同一场景中的不同主体镜头。\n\n你需要根据内容调整标准的电影镜头类型（例如，如果是一个人群，则将整个群体都拍进画面；如果是某个物体，则将整个物体完整地拍入画面）：\n\n\n\n**第一行（建立背景）：**\n\n1. **极远景（ELS）：** 在广阔的背景中，主体显得很小。\n\n2. **远景（LS）：** 从上到下（从头部到脚部/从轮子到车顶）完整展示主体或群体。\n\n3. **中远景（American/3-4）：** 从膝盖以上拍摄（针对人物）或从3/4的角度拍摄（针对物体）。\n\n\n\n**第二行（核心覆盖）：**\n\n4. **中景（MS）：** 从腰部以上拍摄（针对人物）或从物体的中心部分拍摄。\n\n5. **中近景（MCU）：** 从胸部以上拍摄。聚焦主要主体。\n\n6. **近景（CU）：** 紧凑地拍摄面部或物体的“正面”。\n\n\n\n**第三行（细节与角度）：**\n\n7. **特近景（ECU）：** 近距离拍摄某个关键部位（如眼睛、手部、标志、纹理）的细节。\n\n8. **低角度镜头（Worm's Eye）：** 从地面仰拍主体（营造威严或英雄感）。\n\n9. **高角度镜头（Bird's Eye）：** 从上方俯拍主体。\n\n\n\n确保严格的一致性：所有9个画面中的人物/物体、服装和光线都保持一致。景深应真实地变化（近景时出现虚化效果）。\n\n\n\n**要求：**\n\n生成一个专业的3x3电影式故事板网格，包含9个画面。\n\n该网格以多种焦距全面展示输入图像中的主体/场景。\n\n- **顶部行：** 宽广的环境镜头、全景、3/4视角。\n\n- **中间行：** 从腰部以上拍摄、从胸部以上拍摄、面部/正面特写。\n\n- **底部行：** 特写细节、低角度镜头、高角度镜头。\n\n所有画面都具有逼真的纹理、一致的电影色彩调色，并且根据分析出的主体或物体的数量进行正确的构图。"], "inputs": [{"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}], "flags": {}, "id": 213, "type": "CR Prompt Text", "properties": {"cnr_id": "ComfyUI_Comfyroll_CustomNodes", "ver": "d78b780ae43fcf8c6b7c6505e6ffb4584281ceca", "ue_properties": {"widget_ue_connectable": {}, "version": "7.0.1"}, "widget_ue_connectable": {"prompt": true}, "Node name for S&R": "CR Prompt Text"}, "order": 18}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [1241.477783203125, 982.6332397460938], "pos": [-172.08396911621094, 1205.343994140625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 342, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label":