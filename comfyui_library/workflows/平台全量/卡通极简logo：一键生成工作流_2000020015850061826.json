mage"}, "order": 27}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [38], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [400, 200], "pos": [417.129638671875, -233.77244567871094], "widgets_values": ["这是一个极简且带有卡通风格的数字插画，描绘了一个粉红色的、风格化的猪头部，具有夸张的特征。头部略微向右倾斜，顶部有一簇黑洞的探出头。头部有一个小巧的黑色椭圆形鼻子，眼睛小巧且为黑色，右侧黑色的圆形物体。猪卷卷的尾巴露出黑色的圆形物体外。背景是纯亮蓝色。在头部下方，用粗体、黑色、无衬线字体写着文字“rous hello,”。文字右侧有一个小小的黑色加号（+）。整体设计简洁干净，重点突出粉红色的头部和黑色的点缀。插画呈现出一种活泼且现代的感觉，强调极简主义和鲜明的色彩。图像居中于蓝色背景上，周围留有充足的空白空间，突显了设计的简洁与清晰。"], "inputs": [{"name": "clip", "link": 39, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "link": 200, "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 81, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "CLIPTextEncode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 26}, {"mode": 0, "outputs": [], "size": [475.9477844238281, 547.08154296875], "pos": [1180.6876220703125, -144.830322265625], "widgets_values": ["ComfyUI"], "inputs": [{"name": "images", "link": 29, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 60, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.57", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.1"}, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "SaveImage", "tabWidth": 65, "secondTabWidth": 65, "tab