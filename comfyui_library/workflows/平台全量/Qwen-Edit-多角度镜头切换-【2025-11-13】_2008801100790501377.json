镜头（Turn the camera to a wide-angle lens.）  \n将镜头转为特写镜头（Turn the camera to a close-up.）   \n将镜头向前移动至桌子下（Move the camera forward to under the table. ）    \n将镜头向上移动，俯视角度（Move the camera upwards to a bird's-eye view.）\n\n\n \n有很多可能性；你可以自己试试。"], "inputs": [], "flags": {"pinned": true}, "type": "MarkdownNote", "title": "Markdown Note: Model Links", "mode": 0, "bgcolor": "#653", "size": [406.39501953125, 666.3569946289062], "pos": [429.2369384765625, 2785.551025390625], "id": 84, "properties": {"widget_ue_connectable": {}}, "order": 8}, {"mode": 0, "outputs": [{"name": "STRING", "links": [150], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [336.4681091308594, 93], "pos": [858.1132202148438, 2785.49658203125], "widgets_values": ["将镜头俯视"], "inputs": [{"widget": {"name": "value"}, "name": "value", "label": "value", "type": "STRING", "localized_name": "value"}], "flags": {"pinned": true}, "id": 86, "type": "PrimitiveStringMultiline", "properties": {"cnr_id": "comfy-core", "ver": "0.3.67", "widget_ue_connectable": {}, "Node name for S&R": "PrimitiveStringMultiline"}, "order": 9}], "extra": {"VHS_KeepIntermediate": true, "links_added_by_ue": [], "VHS_MetadataImage": true, "ue_links": [], "0246.VERSION": [0, 0, 4], "workflowRendererVersion": "LG", "VHS_latentpreviewrate": 0, "frontendVersion": "1.27.10", "VHS_latentpreview": false, "ds": {"offset": [-683.3172441558168, -1974.8401971096132], "scale": 1.0610764609500059}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 9, "title": "通用", "bounding": [427.091064453125, 1984.036376953125, 1526.772705078125, 643.944580078125]}, {"color": "#8A8", "font_size": 24, "flags": {}, "id": 10, "title": "大模型", "bounding": [433.7992858886719, 1557.5279541015625, 1214.204833984375, 411.16082763671875]}], "links": [[1, 2, 0, 1, 0, "MODEL"], [16, 14, 0, 12, 0, "LATENT"], [20, 11, 0, 14, 1, "CONDITIONING"], [22, 10, 0, 14, 3, "LATENT"], [25, 20, 0, 2, 0, "MODEL"], [28, 22, 0, 11, 1, "VAE"], [29, 22, 0