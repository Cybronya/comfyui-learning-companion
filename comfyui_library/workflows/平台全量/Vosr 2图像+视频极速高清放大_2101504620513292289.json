_order": "position", "guhai_ig_color_filter": "none", "widget_ue_connectable": {}, "Node name for S&R": "忽略多组孤海", "guhai_ig_filter": "", "guhai_ig_disable": false, "guhai_ig_ui_scale": 1}, "order": 8}, {"outputs": [], "color": "#432", "widgets_values": ["Vosr 2图像+视频极速高清放大\n\nVOSR2 是**香港理工大学 + OPPO**联合推出的**纯视觉生成式超分辨率模型（CVPR2026）**，适配 ComfyUI，专门用于图片 / 视频帧高清修复放大，和你前面 MiniMax H3 视频工作流可以搭配使用，做视频后期画质增强。生成速度极快，图片放大发一般只需要10秒左右，10秒视频放大约180秒左右。\n\n1. 兼顾保真度 + 细节生成\n   - 传统 ESRGAN/RealESRGAN：偏锐化，容易糊脸、产生塑料质感，只能还原已有细节，不能补全丢失信息\n   - SeedVR2：生成能力强，但参数量巨大 7B，推理慢，容易轻微改动画面结构\n   - VOSR2：在保留原图结构不变的前提下，智能补全丢失纹理、五官细节；放大后画面自然，不容易出现崩坏。\n\n2. **支持图片、视频帧序列放大**\n你可以把 MiniMax H3 输出的视频拆成帧，送入 VOSR2 节点批量高清修复，再合成视频，提升成片分辨率与清晰度。\n\n\n\n 局限性\n1. 如果原图严重模糊、主体完全看不清，VOSR2 生成能力弱于 SeedVR2；\n2. 4 倍放大极限场景，偶尔会出现轻微纹理伪影；优先推荐 2 倍放大；\n3. 纯视觉模型，不能通过文字指令去修改画面内容，只能做画质修复。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [418.65673828125, 566.0560302734375], "pos": [-772.9678955078125, -1365.2244873046875], "id": 35, "properties": {}, "order": 9}], "extra": {"links_added_by_ue": [], "VHS_KeepIntermediate": true, "KKvideo_latentpreview": false, "ue_links": [], "VHS_MetadataImage": true, "KKvideo_latentpreviewrate": 0, "0246.VERSION": [0, 0, 4], "pixaromaGroups": [], "VHS_latentpreviewrate": 0, "frontendVersion": "1.49.6", "VHS_latentpreview": false, "ds": {"offset": [1235.266946617742, 1422.9973312804163], "scale": 1.9784466890013652}}, "groups": [{"color": "#b58b2a", "font_size": 24, "flags": {}, "id": 1, "title": "❤️ VOSR2视频超分放大", "bounding": [-336.035400390625, 149.865966796875, 2657.472900390625, 942.231201171875]}, {"color": "#b58b2a", "font_size": 24, "flags": {}, "id": 2, "title": "❤️ VOSR2图像超分放大", "bounding": [-332.7334289550781, -761.679443359375, 2651.023681640625, 873.5723876953125]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "对比组", "bounding": [-328.8604431152344, -1391.80517578125, 2623.7021484375, 594.302490234375]}], "links": [[1, 2, 0, 1, 0