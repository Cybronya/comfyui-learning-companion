: 0}, {"outputs": [], "color": "#432", "widgets_values": ["模型选择说明：\nGeneral: 用于一般用例的预训练模型。\nGeneral-HR: 用于一般用例的预训练模型，在更高分辨率的图像上表现出色(训练分辨率2048x2048)。\nGeneral-Lite: 用于一般用例的轻量级预训练模型。\nGeneral-Lite-2K: 用于一般用例的轻量级预训练模型，适用于高分辨率图像(最佳分辨率2560x1440)。\nGeneral-dynamic: 用于动态分辨率的预训练模型，基于256x256到2304x2304的图片分辨率进行训练。\nGeneral-reso_512: 一个更快、更准确的低分辨率预训练模型，基于512x512的图像训练。\nGeneral-legacy: 一般用例的预训练模型，基于DIS5K-TR,DIS-TEs, DUTS-TR_TE,HRSOD-TR_TE,UHRSD-TR_TE, HRS10K-TR_TE (w/o portrait seg data)。\nPortrait: 人物肖像预训练模型。\nMatting: 一种使用无过渡遮罩抠图的预训练模型。\nMatting-HR: 在更高分辨率的图像上显示出出色的性能的预训练模型 (2048x2048)。\nMatting-Lite: 用一般用例的无过渡遮罩抠图的轻量级预训练模型。\nDIS: 一种用于二分图像分割（DIS）的预训练模型。\nHRSOD: 一种用于高分辨率显著目标检测（HRSOD）的预训练模型。\nCOD: 一种用于隐蔽目标检测（COD）的预训练模型。\nDIS-TR_TEs: 具有大量数据集的预训练模型。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [795.6000366210938, 272.08001708984375], "pos": [30.690107345581055, -204.3975830078125], "id": 4, "properties": {"widget_ue_connectable": {}}, "order": 1}, {"mode": 0, "outputs": [{"name": "IMAGE", "links": [2], "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"name": "frame_count", "label": "帧计数", "type": "INT", "localized_name": "frame_count"}, {"name": "audio", "links": [10], "label": "音频", "type": "AUDIO", "localized_name": "audio"}, {"name": "video_info", "links": [3], "label": "视频信息", "type": "VHS_VIDEOINFO", "localized_name": "video_info"}], "size": [210, 334], "pos": [12.126495361328125, 314.4085998535156], "widgets_values": {"custom_height": 0, "force_rate": 0, "custom_width": 0, "select_every_nth": 1, "frame_load_cap": 0, "videopreview": {"paused": false, "hidden": false, "params": {"custom_height": 0, "force_rate": 0, "filename": "05433a56403ca859dcd5e4be896488fb50eb7e8731c06b2bf34fa4bdf798406a.mp4", "custom_width": 0, "select_every_nth": 1, "frame_load_cap": 0, "format": "video/mp4", "skip_first_frames": 0, "type": "input"}}, "format": "None", "video": "05433a56403ca859dcd5e4be896488fb50eb7e8731c06b2bf34fa4bdf798406a.mp4", "skip_fi