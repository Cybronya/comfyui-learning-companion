e": 0, "outputs": [{"name": "image", "links": [2, 13], "label": "image", "type": "IMAGE", "localized_name": "image"}, {"name": "image_url", "label": "image_url", "type": "STRING", "localized_name": "image_url"}, {"name": "response", "label": "response", "type": "STRING", "localized_name": "response"}], "size": [615.7537841796875, 886.7241821289062], "pos": [544.5708618164062, -406.2634582519531], "widgets_values": ["第一步：场景与精确实例分析\n分析提供的复杂古代中国室内场景图 image_0.png。\n\n分离背景：检测并映射背景（非人体身体元素）。\n\n精确人体分割：执行高精度人体语义分割，检测所有角色的身体（躯干和四肢）。特别关键的是，必须使用先进的模型或技术，将“人体身体”从“手持道具”（例如，蓝色角色手中的金属盆）和“身下受遮挡区域”（例如，红色角色身下的木椅）中精确区分出来，不要将道具和身下家具误认为是人体的一部分。\n\n姿态与脸部提取：对于每个检测到的角色，精确提取其姿势和面部关键点。\n\n第二步：排除道具与遮挡的精确蒙版生成\n基于精确的人体身体分割，为每个检测到的角色的身体本身生成一个半透明的语义蒙版。\n\n应用以下条件逻辑分配颜色：\n\n如果检测到一个（1个）角色身体：创建一个精确覆盖该角色身体区域的半透明红色蒙版。\n\n如果检测到两个（2个）或更多角色身体：为每个独立的人体身体蒙版分配一种独特的、有区分度的、半透明的颜色（例如：人体A为红色；人体B为蓝色；人体C为绿色，以此类推，确保颜色可区分）。\n\n排除规则：此蒙版应精确裁剪，必须排除任何手持道具（例如，蓝色角色手中的金属盆不应有蓝色遮罩），必须排除任何身下受遮挡区域（例如，红色角色身下的木椅不应有红色遮罩）。遮罩仅覆盖角色的身体本身。\n\n第三步：多层精确合成\n按以下顺序（从后到前）合成最终图像：\n\n底层：原始的复杂场景（包含所有背景、未受遮罩影响的道具和家具，如金属盆和木椅）。\n\n蒙版层：生成的半透明彩色蒙版，精确地、仅叠加在各自的人体身体上。\n\n细节层：提取的骨骼线条和面部关键点，完美地叠加在它们对应的人体蒙版之上。\n\n第四步：最终输出\n渲染最终图像，显示原始场景，其中只有角色的身体被精确的半透明彩色蒙版覆盖，并且最上层有清晰可见的骨骼姿势图（姿势/面部细节）。\n\n视觉确认：在最终图像中，蓝色角色手中的金属盆和红色角色身下的木椅必须清晰可见，且没有被任何颜色遮罩覆盖。\n\n强制限制：图片上除了上述精确的人体颜色遮罩和骨架姿势，不要在图片上加任何多余的信息。", 621635201, "randomize", "9:16", "1k", false, "Third-party"], "inputs": [{"shape": 7, "name": "images", "link": 55, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "image1", "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name