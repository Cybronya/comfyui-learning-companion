bgcolor": "#3f5159", "size": [265.0985107421875, 123.20183563232422], "pos": [1428.265625, 64.22310638427734], "id": 497, "properties": {"cnr_id": "comfy-core", "models": [{"name": "qwen3vl_8b_bf16.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_bf16.safetensors"}], "ver": "0.37.1", "widget_ue_connectable": {}, "Node name for S&R": "CLIPLoader"}, "order": 4, "widgets_values_named": {"clip_name": "qwen3.5_9b_qwen_image_2.1_pe_i2i.int8_convrot.safetensors", "type": "qwen_image", "device": "default"}}, {"outputs": [{"name": "CLIP", "links": [901], "label": "CLIP", "type": "CLIP", "localized_name": "CLIP"}], "color": "#2a363b", "widgets_values": ["qwen3vl_8b_bf16.safetensors", "qwen_image", "default"], "inputs": [{"widget": {"name": "clip_name"}, "name": "clip_name", "label": "clip_name", "type": "COMBO", "localized_name": "CLIP名称"}, {"widget": {"name": "type"}, "name": "type", "label": "type", "type": "COMBO", "localized_name": "类型"}, {"widget": {"name": "device"}, "shape": 7, "name": "device", "label": "device", "type": "COMBO", "localized_name": "设备"}], "flags": {"collapsed": false}, "type": "CLIPLoader", "mode": 0, "bgcolor": "#3f5159", "size": [339.6865539550781, 106], "pos": [1847.5428466796875, 226.0881805419922], "id": 470, "properties": {"cnr_id": "comfy-core", "models": [{"directory_invalid": true, "name": "qwen3vl_8b_bf16.safetensors", "directory": "text_encoders", "url": "https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_bf16.safetensors"}], "ver": "0.37.1", "widget_ue_connectable": {"clip_name": true, "type": true, "device": true}, "Node name for S&R": "CLIPLoader"}, "order": 5, "widgets_values_named": {"clip_name": "qwen3vl_8b_bf16.safetensors", "type": "qwen_image", "device": "default"}}, {"outputs": [{"name": "STRING", "links": [716], "label": "字符串", "type": "STRING", "localized_name": "字符串"}], "color": "#2a363b", "widgets_values": ["一位成年亚裔女性真人时尚写真，人物是成年女性。她的辨识点是全黑漆皮机能装、棕黑松散丸子头、眼下银色蝴蝶形水钻，以及手中那把中世纪长剑；这四处是认出她的依据，缺一处就不是同一个人。\n\n烟雾里跪姿起身的横构图全身人像 × 私密感时尚 editorial × 低照度电影摄影 × 冷调双色烟雾光影 × 杂志硬照质感 × 启程意志的成年女性肖像。\n\n杂志跨页版式，人物在画面里不占满、横向留出空处，画面里没有文字裁切线折痕或版面标记。相机在她正前方偏左约两米四，高度在她跪着时的肩部、明显低于站立时的胸口，镜头上仰约 6 度；全身景别，从丸子头到跪地的膝与小腿完整入画，剑柄与剑尖都在画面内；横构图，人物偏左、右侧留给烟雾。\n\n服装采用一整套全黑机能装：漆皮挂脖深 V 短上衣，衣领在颈后相连、衣摆停在肋骨下缘、露出侧腰；漆皮迷你短裤；宽腰带横过腰髋交界，带面多排金属气眼孔、正中一枚方形银扣；前臂戴罗纹长臂套与细银戒；颈侧缀黑珍珠的黑蕾丝 choker；漆皮过膝长靴。银色剑身与冷白皮肤是仅有的非黑色。\n\n不要把起身的瞬间拍成静态跪姿肖像，而是用身体的支撑关系交代动势——双手叠握剑柄、两臂伸直把躯干撑离地面，竖直的剑身像一根立柱把她的重量接住。\n\n她双膝跪在地面上，小腿与脚背贴地、膝盖分开与肩同宽；身体正在从跪姿向上撑起——双手叠握剑柄，两臂伸直但肘部微弯、肩膀下沉、部分重量压在剑上；剑身竖直立在身体侧面、剑尖朝上、贴近左肩外侧；腰腹收紧、脊背从跪姿的前倾调整为向上挺起；头转向镜头。视线方向——从剑与身体的正前方平视镜头；落点——镜头中心；路径——从竖直剑身起，沿剑身上行到肩，再到脸上。\n\n妆容为高级电影感真人妆：冷白底妆在面部中间干净服帖；皮肤表面平滑细腻干净，看不到毛孔颗粒与粗糙噪点；眼下一排银色蝴蝶形水钻从眼尾向太阳穴排列、向外渐小；冷调眼妆，眼线细而清晰；因为光在背后，眼睛微微眯起；唇裸粉色。\n\n背景为极简低信息量的深色无缝纸：纸面几乎不反光、上部沉到接近纯黑、只在下缘透出暗洋红；地面铺一层没过膝盖的低矮烟雾，在跪地膝盖周围压出一圈略薄的区域，被侧逆光挑亮成青蓝与品红双色；地面不出现镜面反光。\n\n主光源是一盏硬光，从她的斜后上方约四十五度打来，在头顶、肩膀、背部漆皮边缘与手臂边缘勾出一条明亮的轮廓线——这条线是青蓝色的，来自正后方的青蓝边缘光而非白光；品红主光从左侧偏后染亮背光面的烟雾，与青蓝轮廓在她身上对撞；她面向镜头这侧相对暗，靠地面烟雾反射补出微弱反光；剑身金属被拉成一条很细的青蓝亮带。\n\n50mm 人像视角，距离约两米四；实焦在她的眼睛与睫毛上；剑身紧贴她的身体一侧、距离近，金属高光与近处烟雾清晰；背景被柔化但层次可辨。\n\n静态疯感为主、清冷疏离为辅：嘴唇微微张开一线、像刚要呼出一口气；眼神稳定看向镜头、不笑；眉毛自然平直、眼睛因逆光而微微眯起；下巴绷紧、面部肌肉几乎不动；头从剑与身体的正方转向镜头；她直视镜头，动作越少越要让这点呼气说话——不是凶狠，是往前走。\n\n剑身笔直朝上不弯折，十字护手与缠柄清晰；叠握双手十指分明、不粘连，叠握处手腕顺前臂、两手一上一下；撑地与撑膝的接触清楚；短裤在大腿根贴合合理、靴筒与小腿不穿模；烟雾不糊五官、不纯白过曝。\n\n整体呈现高级时装杂志跨页拍摄而非商业写真：竖直的剑身是一根立柱，从下缘的烟雾通到上部背景，把横画幅稳住；剑的青蓝亮边、品红烟雾与背景的黑形成三段亮度；起身的动势在肩线与脊背的倾斜角里交代清楚。生成结果允许随机改变烟雾形态与转头角度，但始终保持角色身份、服装结构与双色烟雾关系。\n\n横构图 3:2。画面中不出现任何标题、日文、英文、数字、海报排版、品牌 logo 或 UI 元素。", true], "inputs": [{"widget": {"name": "string"}, "name": "string", "label": "string", "type": "STRING", "localized_name": "字符串"}, {"widget": {"name": "strip_newlines"}, "name": "strip_newlines", "label": "strip_newlines", "type": "BOOLEAN", "localized_name": "带换行符"}], "flags": {}, "type": "StringConstantMultiline", "mode": 4, "bgcolor": "#3f5159", "size": [390.8980712890625, 703.7211303710938], "pos": [1005.60693359375, 49.628