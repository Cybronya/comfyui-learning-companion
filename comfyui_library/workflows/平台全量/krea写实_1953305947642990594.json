re of the fabric is discernible, creating a 3D effect of interwoven knots. The depth of field blur simulates the diffraction effect of the lens's 11 aperture blades."], "inputs": [{"name": "clip", "link": 64, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 45, "type": "CLIPTextEncode", "properties": {"cnr_id": "comfy-core", "ver": "0.3.47", "widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 4}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [72], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 82], "pos": [-313.4984130859375, 655.7359008789062], "widgets_values": ["墨幽网图beta.safetensors", 0.7000000000000002], "inputs": [{"name": "model", "link": 71, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 52, "type": "LoraLoaderModelOnly", "properties": {"cnr_id": "comfy-core", "ver": "0.3.47", "widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 5}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [71], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [270, 82], "pos": [-320.84326171875, 133.97877502441406], "widgets_values": ["Flux.Krea.FP8_fast.safetensors", "default"], "inputs": [{"widget": {"name": "unet_name"}, "name": "unet_name", "label": "unet_name", "type": "COMBO", "localized_name": "unet_name"}, {"widget": {"name": "weight_dtype"}, "name": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 38, "type": "UNETLoader", "properties": {"cnr_id": "comfy-core"