feathering"}, "name": "feathering", "type": "INT", "localized_name": "羽化"}], "flags": {}, "id": 127, "type": "ImagePadForOutpaint", "properties": {"hasSecondTab": false, "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "ImagePadForOutpaint", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["\n 工作流的过程：\n\n 上传图像后 先经过图像按像素缩放节点，缩放分辨率，再到外补画板扩展画布，这时候如果扩展的画布超过了1600分辨率就很容易爆显存。\n\n 解决办法：到 图像按像素缩放节点缩放分辨率，如果外补画板的数值越大，图像按像素缩放就得越小要不然爆显存，除非你的显卡顶得住。\n\n如果外补画板数值较小可以把图像按像素缩放提高一些，保证出图分辨率。\n\n扩图数值建议不要超过700\n\n如果扩图的数值比较大那么出图像素\n建议小一点，要不然会爆显存\n\n我测试下来，扩图尺寸分辨率超过1600很容易爆显存。\n如果不想爆显存可以使用Plus48G的，但是扩太大还是会爆显存的\n\n\n\n\n"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [803.6057739257812, 353.6238098144531], "pos": [-1776.9609375, -855.2294311523438], "id": 128, "properties": {"widget_ue_connectable": {}}, "order": 8}], "extra": {"links_added_by_ue": [], "ue_links": [{"controller": 104, "upstream": "106", "downstream_slot": 3, "downstream": 108, "upstream_slot": 0, "type": "VAE"}, {"controller": 104, "upstream": "106", "downstream_slot": 1, "downstream": 113, "upstream_slot": 0, "type": "VAE"}, {"controller": 104, "upstream": "106", "downstream_slot": 1, "downstream": 114, "upstream_slot": 0, "type": "VAE"}, {"controller": 104, "upstream": "105", "downstream_slot": 0, "downstream": 115, "upstream_slot": 0, "type": "MODEL"}, {"controller": 104, "upstream": "107", "downstream_slot": 0, "downstream": 121, "upstream_slot": 0, "type": "CLIP"}], "0246.VERSION": [0, 0, 4], "VHS_latentpreviewrate": 0, "frontendVersion": "1.23.4", "VHS_latentpreview": false, "ds": {"offset": [3407.942487029734, 2038.432129280429], "scale": 0.25937424601000014}}, "groups": [{"color": "#3f789e", "font_size": 60, "flags": {}, "id": 7, "title": "作者", "bounding": [-1668.0533447265625, -342.1077880859375, 623.5817260742188, 849.163330078125]},