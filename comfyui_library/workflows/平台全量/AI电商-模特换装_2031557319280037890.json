asy-use", "ver": "1.3.1", "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 29}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": "STRING", "localized_name": "image_urls"}], "size": [330, 510], "pos": [410, -820], "widgets_values": ["模特换装V1"], "inputs": [{"name": "images", "link": 217, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "label": "filename_prefix", "type": "STRING", "localized_name": "filename_prefix"}], "flags": {}, "id": 95, "type": "SaveImage", "properties": {"cnr_id": "comfy-core", "ver": "0.3.56", "widget_ue_connectable": {"filename_prefix": true}, "Node name for S&R": "SaveImage"}, "order": 34}, {"mode": 4, "outputs": [{"name": "STRING", "links": [162], "label": "STRING", "type": "STRING", "localized_name": "STRING"}], "size": [270, 240], "pos": [-150, -190], "widgets_values": ["【上装】以上传的白底新中式上衣为唯一版型参考；\n【领型】领型为标准圆领，领口高度与白底图一致，贴合颈部不紧绷，无外翻；\n【门襟】门襟为对襟设计，搭配3-4颗白底图同款盘扣，扣合后门襟对齐无偏移；\n【宽松程度】((宽松度:1.2)) 衣身与身体保留3-4cm空隙，舒适不紧绷，无臃肿感；\n【衣长】衣摆精准落在腰线下方5cm处，覆盖腰部，不遮挡臀线；\n【袖口】长袖为直筒型，长度到手腕骨处，袖口贴合手腕，预留1cm空隙；\n\n【内搭层级】白底图中的吊带为内搭唯一版型参考，完全穿在上衣内部，仅领口边缘露出宽度不超过2cm；内搭长度不超过上衣下摆，下摆被上衣完全遮挡；内搭版型贴合身形，与上衣之间预留1-2cm自然空隙，无堆叠褶皱；\n【上衣穿着方式】上衣为自然敞开状态，敞开角度控制在15-20°，门襟两侧不扣合，呈V字开口；站立姿态时，上衣敞开角度适中，衣摆自然垂坠；敞开状态不改变上衣原有版型、肩宽、衣长；\n\n【下装】以上传的白底新中式直筒裤为唯一版型参考；\n【裤型】裤型为标准直筒，裤腿从上到下宽度一致，两侧不贴合腿部曲线；\n【宽松程度】((宽松度:1.3))，裤腿与腿部保留6-8cm空隙，无贴腿感；\n【裤长】裤长精准落在脚踝骨正上方0.5cm处，无拖地、无过短；\n\n【适配规则】仅调整服装尺寸适配人物身形比例，不改变白底图版型、廓形、细节特征；\n【全局】高清4K分辨率，光影自然，面料质感与白底图一致，服装褶皱随人物姿态自然分布，无AI生成痕迹。"], "inputs": [{"widget": {"name": "Text"}, "name": "Text", "label": "Text", "type": "STRING", "localized_name": "Text"}], "flags": {}, "id": 106, "type": "DF_Text_Box", "title": "自定义服装提示词", "properties": {"cnr_id": "derfuu_comfyui_moddednodes", "ver": "1.0.1", "widget_ue_connectable": {"Text": true}, "Node name for S&R": "DF_Text_Box"}, "order": 5}, {"mode": 0, "outputs": [{"name": "output", "label": "ou