": 4, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "crop"}, "name": "crop", "label": "crop", "type": "COMBO", "localized_name": "crop"}], "flags": {}, "id": 6, "type": "ImageScale", "properties": {"cnr_id": "comfy-core", "ver": "0.3.43", "widget_ue_connectable": {"width": true, "upscale_method": true, "crop": true, "height": true}, "Node name for S&R": "ImageScale"}, "order": 13}, {"outputs": [], "color": "#432", "widgets_values": ["|参数|说明|\n|---|--------|\n|model|7B或者3B，要求画质选7B，要求速度选3B|\n|batch_size|非常重要！此模型会消耗大量显存，即使是 3B 型号也会消耗所有显存，因此对于显存低于 24GB 的 GPU，请将此值保持较低，一个好的值是“1”（不考虑时间一致性），“5”（考虑时间一致性），但此值越高，结果越好。|\n|new_resolution|新的所需短边尺寸（以像素为单位），其他边将保持宽高比|\n\n### 时间一致性：\n启用时间一致性至少需要batch_size为 5。SEEDVR2 至少需要 5 帧来计算时间一致性。更大的 batch_size 可以带来更好的性能/结果，但需要超过 24GB 的显存。\n\n### 显存使用情况：\n输入视频分辨率会影响处理过程中的显存消耗。输入视频越大，处理过程中消耗的显存就越多。因此，如果 batch_size 至少为 5 时出现内存溢出 (OOM) 错误，请尝试降低输入视频分辨率，直到问题解决。\n当然，输出分辨率也会产生影响，所以如果你的硬件不允许，请降低输出分辨率。"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [456.1426696777344, 316.42169189453125], "pos": [-14640.46484375, 3330.698974609375], "id": 45, "properties": {"widget_ue_connectable": {}}, "order": 4}, {"mode": 0, "outputs": [{"name": "block_swap_config", "links": [3], "label": "block_swap_config", "type": "block_swap_config", "localized_name": "block_swap_config"}], "size": [345.32562255859375, 188.16407775878906], "pos": [-15110.9150390625, 3076.646484375], "widgets_values": [16, true, false], "inputs": [{"widget": {"name": "blocks_to_swap"}, "name": "blocks_to_swap", "label": "blocks_to_swap", "type": "INT", "localized_name": "blocks_to_swap"}, {"widget": {"name": "use_non_blocking"}, "name": "use_non_blocking", "label": "use_non_blocking", "type": "BOOLEAN", "localized_name": "use_non_blocking"}, {"widget": {"name": "offload_io_components"}, "name": "offload_io_components", "label": "offload_io_components", "type": "BOOLEAN", "localized_name": "offload_io_components"}], "flags": {}, "id": 5, "type": "SeedVR2BlockSwap", "properties": {"ver": "c88c9e61c17f1fed912b3f0d74cf9816f351b3a7", "widget_ue_connectable": {"offload_io_components": true, "blocks_to_swap": true, "use_non_blocking": true}, "aux_id": "AInVFX/ComfyUI-SeedVR2_VideoUpscaler", "Node name for S&R": "SeedVR2BlockSwap"}, "order": 5}, {"mode": 2, "outputs": [{"name": "IMAGE", "links": [15], "label": "IMAGE", "type": "IMAGE", "localized_name": "IMAGE"}], "size": [270, 130], "pos": [-14214.5634765625, 4097.48388671875], "widgets_values": ["bilinear", 1920, 1080, "disabled"], "inputs": [{"name": "image", "link": 14, "label": "image", "type": "IMAGE", "localized_name": "image"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "upscale_method"}, {"widget": {"name": "width"}, "name": "width", "label": "width", "type": "INT", "localized_name": "width"}, {"widget": {"name": "height"}, "name": "height", "label": "height", "type": "INT", "localized_name": "height"}, {"widget": {"name": "crop"}, "name": "crop", "label": "crop", "type": "COMBO", "localized_name": "crop"}], "flags": {}, "id": 14, "type": "ImageScale", "properties": {"cnr_id": "comfy-core", "ver": "0.3.43", "widget_ue_connectable": {"width": true, "upscale_method": true, "crop": true, "height": true}, "Node name for S&R": "ImageScale"}, "order": 14}, {"outputs": [], "color": "#432", "widgets_values": ["|参数|说明|\n|---|--------|\n|blocks_to_swap|（3B 型号为 0-32，7B 型号为 0-36）：待卸载的变压器模块数量<br>0 = 禁用（速度最快，显存最高）<br>16 = 平衡型（速度/显存适中）<br>32-36 = 最大节省（速度最慢，显存占用最低）|\n|use_non_blocking|将嵌入/I/O 层移至 CPU（进一步节省显存，但速度较慢）异步 GPU 传输（保持“True”以获得更佳性能）|\n|offload_io_components|非常重要！此模型会消耗大量显存，即使是 3B 型号也会消耗所有显存，因此对于显存低于 24GB 的 GPU，请将此值保持较低，一个好的值是“1”（不考虑时间一致性），“5”（考虑时间一致性），但此值越高，结果越好。|\n\n## 使用技巧：\nBlockSwap 允许在显存有限的 GPU 上运行大型模型，方法是在推理过程中动态地在 GPU 和 CPU 内存之间交换转换器块。\n\n先从这个值开始blocks_to_swap=16，如果出现内存不足错误就增加，如果有剩余显存就减少。如果数值调整到最大还是OOM，就开启offload_io_components\n\n\n启用调试模式以监控内存使用情况\n前 1-2 个区块的交换时间可能会较长——这是正常现象。\n结合使用preserve_vram=True可最大限度节省内存"], "inputs": [], "flags": {}, "type": "MarkdownNote", "mode": 0, "bgcolor": "#653", "size": [458.9071044921875, 436.67694091796875], "pos": [-15166.9912109375, 3337.185791015625], "id": 46, "properties": {"widget_ue_connectable": {}}, "order": 7}, {"mode": 2, "outputs": [{"name": "Filenames", "label": "Filenames", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "size": [534.5183715820312, 661.4165649414062], "pos": [-13882.0224609375, 4088.240966796875], "widgets_values": {"save_output": true, "filename_prefix": "AIGCTV", "loop_count": 0, "pix_fmt": "yuv420p", "save_metadata": true, "crf": 19, "trim_to_audio": false, "videopreview": {"paused": false, "hidden": false, "params": {"score": "0", "filename": "AnimateDiff_00001_p84_jdyga_1762162890.mp4", "workflow": "AnimateDiff_00001_p84.png", "fullpath": "/data/ComfyUI/personal/1dcb872eeb8aaa0c4f6c90133ce85dd4/output/AnimateDiff_00001_p84.mp4", "format": "video/h264-mp4", "subfolder": "", "label": "Normal", "type": "output", "frame_rate": 25}}, "format": "video/h264-mp4", "no_preview": false, "frame_rate": 25, "pingpong": false}, "inputs": [{"name": "images", "link": 15, "label": "images", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "audio", "label": "audio", "type": "AUDIO", "localized_name": "audio"}, {"shape": 7, "name": "meta_batch", "label": "meta_batch", "type": "VHS_BatchManager", "localized_name": "meta_batch"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "frame_rate"}, "name": "frame_rate", "link"