me": "weight_dtype", "label": "weight_dtype", "type": "COMBO", "localized_name": "weight_dtype"}], "flags": {}, "id": 57, "type": "UNETLoader", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "UNETLoader"}, "order": 13}, {"mode": 0, "outputs": [{"name": "output", "label": "output", "type": "LATENT", "localized_name": "output"}, {"name": "denoised_output", "label": "denoised_output", "type": "LATENT", "localized_name": "denoised_output"}], "size": [288.5321044921875, 354.22930908203125], "pos": [2097.51318359375, 1158.6163330078125], "widgets_values": [], "inputs": [{"name": "noise", "link": 6, "label": "noise", "type": "NOISE", "localized_name": "noise"}, {"name": "guider", "link": 10, "label": "guider", "type": "GUIDER", "localized_name": "guider"}, {"name": "sampler", "link": 11, "label": "sampler", "type": "SAMPLER", "localized_name": "sampler"}, {"name": "sigmas", "link": 28, "label": "sigmas", "type": "SIGMAS", "localized_name": "sigmas"}, {"name": "latent_image", "link": 14, "label": "latent_image", "type": "LATENT", "localized_name": "latent_image"}], "flags": {}, "id": 11, "type": "SamplerCustomAdvanced", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SamplerCustomAdvanced"}, "order": 17}, {"outputs": [], "color": "#432", "widgets_values": ["对AI来说，最核心的是“模型”，但是模型就是一个包含了巨量信息的数字体，单一模型除了占据硬盘空间外不能做任何事情。并且，因为模型本身充满各种图片信息，它无法做到从0到1在“纸”上填充信息，比如先描绘小狗的轮廓再细化小狗的毛发等等。相反，它做的是减法，类似雕刻石头，从充满信息的“纸”上去除无用信息，最终让结果”显示“出来：\n\t\n1.要告诉模型，需要多大的“纸”（图片尺寸/分辨率）；\n2.告诉模型，我要一个黑色的边牧小狗；\n3.模型在定义的”纸“上去除无用信息，保留”黑色边牧小狗“相关的信息；\n4.信息被转译成图片。\n\t\n所以除调取模型外：\n1.对应latent - 潜空间画布；\n2.对应prompt - 提示语/关键词；\n3.对应ksampler - 算法模块;\n4.对应vae - 解码器。\n需要注意，prompt还需要一次翻译，把语言翻译成模型懂得的信息，这一步需要借助clip。"], "inputs": [], "flags": {}, "type": "Note", "title": "说明", "mode": 0, "bgcolor": "#653", "size": [329.0884094238281, 476.5624084472656], "pos": [500.8203125, -768.5680541992188], "id": 62, "properties": {}, "order": 14}, {"outputs": [], "color": "#432", "widgets_values": ["KSampler 节点本质上就是一个数学计算公式，它是AI绘图的核心计算模块。它把这些符合 Karras 定义的参数打包好，扔给 k-diffusion 库去循环计算：\nLatent是当前变量；\nNoise (Seed)是初始条件；\nSigmas (Schedule)是时间变化曲线/时间表；\nSampler (Solver)是解方程的方法（Euler, DPM++ 等），行走的节奏；\nGuider (Model/Cond): 是方程的导数，负责往哪里走。\n\n种子一般设定为随机，可以增加抽卡的多样性。\ncfg一般设定7，但是很多模型要求默认为1，需要注意。\n变数最大的是采样器+调度器组合，可以做测试决定，也有默认的组合方式例如euler+simple。"], "inputs": [], "flags": {}, "type": "Note", "title": "说明", "mode": 0, "bgcolor": "#653", "size": [395.01629638671875, 683.0845336914062], "pos": [526.6222534179688, 1004.9564819335938], "id": 64, "properties": {}, "order": 15}, {"outputs": [], "color": "#432", "widgets_values": ["模型本身不包括clip和vae。\n前期模型、clip、vae体积相对交小，可以打包在一起。\n随着三者信息量爆炸式增长，再打包在一起，对内存和显存的经济性提出挑战。\nflux之后，基本上model、clip、vae都分开载入。\n\n无论多复杂的工作流，都是在核心工作流做增量。\n想微调模型出图的风格，增加一个lora节点，让小模型微调大模型；\n想对原图人物换脸，增加一个蒙版节点，让模型只作用于脸部区域；\n想把图片放大，增加一个放大模型节点，或分块处理节点，把每一块进行单独放大，再拼成大图。。。\n\t\n这些增量节点的拼接具有很大想象空间，例如图生图后对局部物体进行替换、去除水印、增加图片上的文字、最后做成高清海报，即完成所谓的洗图。\n\t\n这时候工作流更是一种思路。\nComfyUI工作流最根本的思路是：总分总。"], "inputs": [], "flags": {}, "type": "Note", "title": "说明", "mode": 0, "bgcolor": "#653", "size": [388.1222229003906, 264.1879577636719], "pos": [516.3580322265625, 439.029541015625], "id": 63, "properties": {}, "order": 16}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [33], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [400, 200], "pos": [960.6676635742188, -839.290283203125], "widgets_values": ["a coffee shop logo, masterpiece, creative design, "], "inputs": [{"name": "clip", "link": 31, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 44, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 18}, {"mode": 0, "outputs": [{"name": "CONDITIONING", "links": [34], "label": "CONDITIONING", "type": "CONDITIONING", "localized_name": "CONDITIONING"}], "size": [400, 200], "pos": [961.0121459960938, -593.8474731445312], "widgets_values": ["bad, low quality, waterkark, "], "inputs": [{"name": "clip", "link": 32, "label": "clip", "type": "CLIP", "localized_name": "clip"}, {"widget": {"name": "text"}, "name": "text", "label": "text", "type": "STRING", "localized_name": "text"}], "flags": {}, "id": 45, "type": "CLIPTextEncode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "CLIPTextEncode"}, "order": 19}], "extra": {"links_added_by_ue": [], "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [-594.9261786288663, 1208.662228419717], "scale": 1.08347059433884}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 1, "title": "ksampler", "bounding": [468.9283447265625, 883.1201782226562, 2085.749267578125, 867.0811157226562]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "核心工作流", "bounding": [443.7926940917969, -1034.7490234375, 2093.850341796875, 830.035888671875]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "核心工作流", "bounding": [461.5348815917969, -91.98519897460938, 2093.850341796875, 830.035888671875]}], "links": [[6, 16, 0, 11, 0, "NOISE"], [10, 20, 0, 11, 1, "GUIDER"], [11, 21, 0, 11, 2, "SAMPLER"], [14, 24, 0, 11, 4, "LATENT"], [28, 23, 0, 11, 3, "SIGMAS"], [30, 43, 0, 42, 0, "MODEL"], [31, 43, 1, 44, 0, "CLIP"], [32, 43, 1, 45, 0, "CLIP"], [33, 44, 0, 42, 1, "CONDITIONING"], [34, 45, 0, 42, 2, "CONDITIONING"], [35, 46, 0, 42, 3, "LATENT"], [36, 42, 0, 47, 0, "LATENT"], [37, 43, 2, 47, 1, "VAE"], [38, 47, 0, 48, 0, "IMAGE"], [41, 54, 0, 53, 0, "IMAGE"], [42, 55, 0, 54, 0, "LATENT"], [45, 49, 0, 55, 1, "CONDITIONING"], [46, 50, 0, 55, 2, "CONDITIONING"], [47, 51, 0, 55, 3, "LATENT"], [48, 57, 0, 55, 0, "MODEL"], [49, 58, 0, 49, 0, "CLIP"], [50, 58, 0, 50, 0, "CLIP"], [51, 59, 0, 54, 1, "VAE"]], "id": "b4eb355d-4074-4436-99af-569a5186ca81", "config": {}, "version": 0.4, "last_node_id": 64, "revision": 0}