ode_tile_overlap", "type": "INT", "localized_name": "decode_tile_overlap"}, {"widget": {"name": "tile_debug"}, "shape": 7, "name": "tile_debug", "label": "tile_debug", "type": "COMBO", "localized_name": "tile_debug"}, {"widget": {"name": "offload_device"}, "shape": 7, "name": "offload_device", "label": "offload_device", "type": "COMBO", "localized_name": "offload_device"}], "flags": {}, "type": "SeedVR2LoadVAEModel", "mode": 4, "bgcolor": "#653", "size": [312.8667907714844, 298], "pos": [-277.7333068847656, 861.3596801757812], "id": 44, "properties": {"cnr_id": "seedvr2_videoupscaler", "ver": "2.5.14", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {"encode_tiled": true, "encode_tile_overlap": true, "encode_tile_size": true, "decode_tiled": true, "decode_tile_size": true, "tile_debug": true, "offload_device": true, "model": true, "decode_tile_overlap": true, "device": true}, "Node name for S&R": "SeedVR2LoadVAEModel"}, "order": 9}, {"mode": 0, "outputs": [{"name": "OPT_CONNECTION", "label": "可选连接", "type": "*"}], "bgcolor": "#ff7b00", "size": [266.1227722167969, 109.40542602539062], "color": "#ff8f14", "pos": [-1155.9600830078125, 155.7626495361328], "inputs": [], "flags": {}, "id": 57, "type": "Fast Groups Bypasser (rgthree)", "properties": {"customSortAlphabet": "", "matchColors": "", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "showAllGraphs": true, "sort": "position", "matchTitle": "❤️", "showNav": true, "toggleRestriction": "default"}, "order": 5}, {"outputs": [], "color": "#2a363b", "widgets_values": ["# 🍺 使用说明 🍺\n\n## 版本：SeedVR2.5.1 图片分块高清放大 2026.5.21更新\n\n版本介绍：本版本是最新版的2.5.1版本，降低对电脑性能的要求，同时加快了生图速度，若使用gguf量化版本模型，应该最低8g显存可以跑。\n   本版本对人像高还原放大、多人合照像素修复、大量文字放大（含中英文）、矢量平面设计高清化等效果明显，放大后完全保持原对象的所有特征，解决了其他放大手段过分重绘对象细节的缺点。\n### 模型下载\n| 模型名称 |下载地址 |备注 |\n|---|---|---|\n| seedvr2 p8原模 |[huggingface](https://huggingface.co/numz/SeedVR2_comfyUI/tree/main) | （3b更平滑 ）（7b更细节）|\n| seedvr2 p8 GGUf模型 | [huggingface](https://huggingface.co/cmeka/SeedVR2-GGUF/tree/main) | （3b更平滑）（7b更细节）|\n\n注意：\n\n1、新版本对于原图尺寸较大的图片（2k左右的图）放大时仍旧对机器要求较高（会吃满16g显存）而且直接放大效果也不太好，因此对于原图尺寸较大的图可以通过图像缩小的节点，把原图尺寸缩小到20万像素左右再进行后续放大，这样既降低了电脑资源要求，又加快了生图速度。\n\n2、（SeedVR2 (Down)Load DiT Model）节点中的（blocks to swap）选项指的是分块数量，对于3b模型填写0-32（建议直接填32），7b模型填写0-36（建议直接填32），其余参数建议不要修改\n\n3、（SeedVR2 Video Upscaler (v2.5.10)）节点中的max resolution选项指的是生图后最长边的尺寸限制在多少像素，默认填写4500（若不限制，个别图片尺寸放大尺寸太大仍会爆显存。\n\n4、对于本地部署，若更新了新版本SeedVR2.5.1节点，旧版本节点将会失效。\n\n5、节点下载地址：https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler\n\n可以直接git安装，或下载zip文件解压后放在model文件夹中\n\n6、所有需要调整参数或加载文件的节点均设置为绿色。\n"], "inputs": [], "flags": {}, "type": "MarkdownNote", "title": "SeedVR2.5.1 最新版本图片高清放大", "mode": 0, "bgcolor": "#3f5159", "size": [539.15771484375, 711.4525146484375], "pos": [-1420.20654296875, -621.5818481445312], "id": 32, "properties": {"widget_ue_connectable": {}}, "order": 10}], "extra": {"links_added_by_ue": [], "workspace_info": {"id": "TmH5DnGVS_R6AAP36NCw_"}, "ue_links": [], "0246.VERSION": [0, 0, 4], "ds": {"offset": [1528.506149138784, 692.0179314400809], "scale": 2.5019627910715343}}, "groups": [{"color": "#3f789e", "font_size": 24, "flags": {}, "id": 6, "title": "❤️SeedVR2.5.1 放大", "bounding": [-865.04443359375, -649.8182983398438, 2496.490478515625, 735.0677490234375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 2, "title": "放大", "bounding": [143.24488830566406, -606.211669921875, 650.136474609375, 675.0560302734375]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 3, "title": "缩小处理", "bounding": [-198.5726318359375, -604.0685424804688, 317.7845458984375, 575.640869140625]}, {"color": "#3f789e", "font_size": 24, "flags": {}, "id": 4, "title": "对比效果", "bounding": [814.5180053710938, -606.2183227539062, 392.6018371582031, 677.8115234375]}, {"color": "#8A8", "font_size": 20, "flags": {}, "id": 5, "title": "图像放大后最长边尺寸", "bounding": 