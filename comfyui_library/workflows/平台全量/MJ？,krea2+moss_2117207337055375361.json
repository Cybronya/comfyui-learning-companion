": "latent_image", "link": 23, "label": "Latent", "type": "LATENT", "localized_name": "Latent图像"}, {"widget": {"name": "seed"}, "name": "seed", "type": "INT", "localized_name": "随机种"}, {"widget": {"name": "steps"}, "name": "steps", "type": "INT", "localized_name": "步数"}, {"widget": {"name": "cfg"}, "name": "cfg", "type": "FLOAT", "localized_name": "CFG"}, {"widget": {"name": "sampler_name"}, "name": "sampler_name", "type": "COMBO", "localized_name": "采样器"}, {"widget": {"name": "scheduler"}, "name": "scheduler", "type": "COMBO", "localized_name": "调度器"}, {"widget": {"name": "denoise"}, "name": "denoise", "type": "FLOAT", "localized_name": "降噪"}], "flags": {}, "id": 21, "type": "KSampler", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "KSampler"}, "order": 25, "widgets_values_named": {"scheduler": "simple", "denoise": 0.35, "seed": 42, "cfg": 2.5, "sampler_name": "er_sde", "steps": 25, "control_after_generate": "fixed"}}, {"mode": 0, "outputs": [{"name": "IMAGE", "slot_index": 0, "links": [26], "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "size": [300, 60], "pos": [640, 260], "inputs": [{"name": "samples", "link": 24, "label": "Latent", "type": "LATENT", "localized_name": "Latent"}, {"name": "vae", "link": 25, "label": "VAE", "type": "VAE", "localized_name": "vae"}], "flags": {}, "id": 22, "type": "VAEDecode", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "VAEDecode"}, "order": 26}, {"mode": 0, "outputs": [{"name": "image_urls", "type": "STRING", "localized_name": "images"}, {"name": "images", "type": "IMAGE", "localized_name": "images"}], "size": [420, 520], "pos": [1047.3461891643708, -715.6473829201099], "widgets_values": ["Krea2_MOSS_MJ"], "inputs": [{"name": "images", "link": 26, "label": "图像", "type": "IMAGE", "localized_name": "图片"}, {"widget": {"name": "filename_prefix"}, "name": "filename_prefix", "type": "STRING", "localized_name": "文件名前缀"}], "flags": {}, "id": 23, "type": "SaveImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "SaveImage"}, "order": 27, "widgets_values_named": {"filename_prefix": "Krea2_MOSS_MJ"}}, {"outputs": [], "color": "#432", "widgets_values": ["【顺序】Krea 2 文生图 → 1.5× 放大 → MOSS 精修 → 保存\n\n【尺寸怎么选】\n节点 25「分辨率选择」三个参数：\n  aspect_ratio  比例，8 种预设\n  megapixels    总像素目标，1.0 ≈ 1024²\n  multiple      必须是 32，别改\n为什么是 32 而不是 16：MOSS 用 Flux2 latent（16× 压缩），\n中间又要放大 1.5 倍。只有底面是 32 的倍数，\n放大后才是 16 的倍数，VAE 编码才不丢边。\n\n常用组合（multiple=32）：\n  3:4  / 1.4MP → 1056×1408 → 1584×2112\n  1:1  / 1.0MP → 1024×1024 → 1536×1536\n  16:9 / 1.2MP → 1504×854  → 2256×1281\n  9:16 / 1.2MP → 854×1504 → 1281×2256\n\n【为什么中间要放大一次】\nKrea 2 用 Wan21 latent（16 通道 / 8× 压缩），\nMOSS 用 Flux2 latent（128 通道 / 16× 压缩），\n通道数与压缩率都不同，latent 无法直连，\n必须走 VAEDecode → 放大 → VAEEncode 的像素域转换。\n\n【提示词只填一处】节点 11 同时喂两段。\nMOSS 只做 denoise 0.35 的精修，不改构图，共用安全。\n但别写 8K / ultra HD / micro detail / pores / film grain ——\n这些词会让 MOSS 在平坦区硬造纹理，出黑点。\n\n【denoise 红线】0.30 只锐化 / 0.35 默认 / 0.45 改皮肤 / 0.5+ 动五官\n\n【要更大图】把节点 19 的 scale_by 改 2.0，MOSS 需 24GB 实例。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#653", "size": [480, 700], "pos": [1047.3461891643708, -115.64738292010983], "id": 24, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "Note"}, "order": 7, "widgets_values_named": {"text": "【顺序】Krea 2 文生图 → 1.5× 放大 → MOSS 精修 → 保存\n\n【尺寸怎么选】\n节点 25「分辨率选择」三个参数：\n  aspect_ratio  比例，8 种预设\n  megapixels    总像素目标，1.0 ≈ 1024²\n  multiple      必须是 32，别改\n为什么是 32 而不是 16：MOSS 用 Flux2 latent（16× 压缩），\n中间又要放大 1.5 倍。只有底面是 32 的倍数，\n放大后才是 16 的倍数，VAE 编码才不丢边。\n\n常用组合（multiple=32）：\n  3:4  / 1.4MP → 1056×1408 → 1584×2112\n  1:1  / 1.0MP → 1024×1024 → 1536×1536\n  16:9 / 1.2MP → 1504×854  → 2256×1281\n  9:16 / 1.2MP → 854×1504 → 1281×2256\n\n【为什么中间要放大一次】\nKrea 2 用 Wan21 latent（16 通道 / 8× 压缩），\nMOSS 用 Flux2 latent（128 通道 / 16× 压缩），\n通道数与压缩率都不同，latent 无法直连，\n必须走 VAEDecode → 放大 → VAEEncode 的像素域转换。\n\n【提示词只填一处】节点 11 同时喂两段。\nMOSS 只做 denoise 0.35 的精修，不改构图，共用安全。\n但别写 8K / ultra HD / micro detail / pores / film grain ——\n这些词会让 MOSS 在平坦区硬造纹理，出黑点。\n\n【denoise 红线】0.30 只锐化 / 0.35 默认 / 0.45 改皮肤 / 0.5+ 动五官\n\n【要更大图】把节点 19 的 scale_by 改 2.0，MOSS 需 24GB 实例。"}}, {"outputs": [{"name": "width", "slot_index": 0, "links": [27], "label": "width", "type": "INT", "localized_name": "宽度"}, {"name": "height", "slot_index": 1, "links": [28], "label": "height", "type": "INT", "localized_name": "高度"}], "widgets_values": ["3:4 (Portrait Standard)", 2.2, 32], "inputs": [{"widget": {"name": "aspect_ratio"}, "name": "aspect_ratio", "label": "aspect_ratio", "type": "COMBO", "localized_name": "宽高比"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "百万像素"}, {"widget": {"name": "multiple"}, "name": "multiple", "label": "multiple", "type": "INT", "localized_name": "倍数"}, {"widget": {"name": "preview"}, "shape": 7, "name": "preview", "label": "preview", "type": "RESOLUTION_PREVIEW", "localized_name": "预览"}], "flags": {}, "type": "ResolutionSelector", "title": "分辨率选择（比例 / 百万像素 / 倍数32）", "mode": 0, "size": [340, 150], "pos": [-420, -160], "id": 25, "properties": {"widget_ue_connectable": {"aspect_ratio": true, "megapixels": true, "multiple": true}, "Node name for S&R": "ResolutionSelector"}, "order": 8, "widgets_values_named": {"aspect_ratio": "3:4 (Portrait Standard)", "megapixels": 2.2, "multiple": 32}}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [30], "label": "模型", "type": "MODEL", "localized_name": "模型"}], "size": [336.9781821954916, 82], "pos": [-880.7014027875648, 508.04011180801757], "widgets_values": ["KOOK-MOSS-SFT-观澜.safetensors", 1], "inputs": [{"name": "model", "link": 32, "label": "模型", "type": "MODEL", "localized_name": "模型"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "LoRA名称"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "模型强度"}], "flags": {"collapse