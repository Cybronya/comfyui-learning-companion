45度，带有一个动态转头的动作。捕捉白色衬衫在微动状态下的空间感，展示袖口蕾丝与整体版型的流动性。下摆自然覆盖在黑色修身长裤外，确保不塞裤腰，体现随性优雅的商业质感。8k分辨率，商业摄影，超清画质。\"\n}\n```"], "inputs": [{"shape": 7, "name": "anything", "link": 14, "label": "输入任何", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 12, "type": "easy showAnything", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 8}, {"mode": 0, "outputs": [{"name": "STRING", "links": [21], "label": "STRING", "type": "STRING", "localized_name": "字符串"}], "size": [270, 58], "pos": [1301.0482177734375, 473.16436767578125], "widgets_values": ["提示词1"], "inputs": [{"name": "json", "link": 20, "label": "json", "type": "JSON", "localized_name": "json"}, {"widget": {"name": "key"}, "name": "key", "label": "key", "type": "STRING", "localized_name": "key"}], "flags": {}, "id": 18, "type": "GetTextFromJson", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "GetTextFromJson"}, "order": 14}, {"mode": 0, "outputs": [{"name": "STRING", "links": [18], "label": "字符串", "type": "*", "localized_name": "STRING"}, {"name": "show_help", "label": "显示帮助", "type": "STRING", "localized_name": "show_help"}], "size": [270, 198], "pos": [2417.194091796875, 8.93125057220459], "widgets_values": ["```json", "", "```", "", "", ""], "inputs": [{"name": "text", "link": 15, "label": "文本", "type": "STRING", "localized_name": "text"}, {"widget": {"name": "find1"}, "shape": 7, "name": "find1", "type": "STRING", "localized_name": "搜索1"}, {"widget": {"name": "replace1"}, "shape": 7, "name": "replace1", "type": "STRING", "localized_name": "替换1"}, {"widget": {"name": "find2"}, "shape": 7, "name": "find2", "type": "STRING", "localized_name": "搜索2"}, {"widget": {"name": "replace2"}, "shape": 7, "name": "replace2", "type": "STRING", "localized_name": "替换2"}, {"widget": {"name": "find3"}, "shape": 7, "name": "find3", "type": "STRING", "localized_name": "搜索3"}, {"widget": {"name": "replace3"}, "shape": 7, "name": "replace3", "type": "STRING", "localized