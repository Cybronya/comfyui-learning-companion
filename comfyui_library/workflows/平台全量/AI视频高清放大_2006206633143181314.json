_values": ["lanczos", 0.30000000000000004, 1], "inputs": [{"name": "image", "link": 52, "label": "图像", "type": "IMAGE", "localized_name": "图像"}, {"widget": {"name": "upscale_method"}, "name": "upscale_method", "label": "upscale_method", "type": "COMBO", "localized_name": "缩放方法"}, {"widget": {"name": "megapixels"}, "name": "megapixels", "label": "megapixels", "type": "FLOAT", "localized_name": "像素数量"}, {"widget": {"name": "resolution_steps"}, "name": "resolution_steps", "type": "INT", "localized_name": "resolution_steps"}], "flags": {}, "type": "ImageScaleToTotalPixels", "mode": 0, "bgcolor": "#353", "size": [295.2969055175781, 106], "pos": [690.0601806640625, 2931.981201171875], "id": 68, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "ImageScaleToTotalPixels"}, "order": 6}, {"outputs": [], "color": "#323", "widgets_values": ["型号：选择您的 DiT 型号\n\n3B 型号：速度更快，显存需求更低\n- seedvr2_ema_3b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_3b_fp8_e4m3fn.safetensorsFP8 8位（高质量）\n- seedvr2_ema_3b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_3b-Q8_0.ggufGGUF 8 位量化（高质量）\n\n7B 型号：画质更高，显存需求更高\n- seedvr2_ema_7b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors：FP8，最后一个数据块使用FP16，以减少伪影（质量良好）\n- seedvr2_ema_7b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_7b_sharp_*：锐化版本，增强细节\n\n设备：用于 DiT 推理的 GPU 设备（例如，cuda:0）\n\noffload_device：当 DiT 模型不处于活跃处理状态时，用于卸载 DiT 模型的设备\n- none：将模型保存在推理设备（速度最快、显存最大的设备）上\n- cpu：卸载到系统内存（减少显存）\n- cuda:X：将负载转移到另一块GPU（如果可用，则可获得良好的负载均衡）\n\ncache_model：在工作流运行之间，保持卸载设备上的 DiT 模型加载状态\n- 适用于批量处理，避免重复加载\n- 需要设置 offload_device\n\nblocks_to_swap：块交换内存优化\n- 0：已禁用（默认）\n- 1-32：需要替换为 3B 型号的变压器模块数量\n- 1-36：需要更换为 7B 型号的变压器模块数量\n- 数值越高，节省的显存越多，但处理速度越慢。\n- 需要设置 offload_device 并且使其与 device 不同。\n\nswap_io_components：卸载输入/输出嵌入和归一化层\n\n- 结合 blocks_to_swap 可进一步节省 VRAM\n- 需要设置 offload_device 并且使其与 device 不同。\n\nattention_mode：注意力计算后端\n- sdpa: PyTorch scaled_dot_product_attention（默认值，稳定，始终可用）\n- flash_attnFlash Attention 2（在支持的硬件上速度更快，需要 flash-attn 软件包）\n\ntorch_compile_args：连接到 SeedVR2 Torch 编译设置节点，可提升 20-40% 的速度。\n\nBlockSwap详解：\nBlockSwap 允许在显存有限的 GPU 上运行大型模型，它在推理过程中动态地在 GPU 和 CPU 内存之间交换 Transformer 模块。其工作原理如下：\n\n- 它的作用：仅将当前需要的转换器模块保留在 GPU 上，而将其余模块存储在 CPU 或其他设备上。\n- 何时使用：在放大阶段出现 OOM（内存不足）错误时\n- 如何配置：\n设置offload_device为cpu或其他 GPU\n先从blocks_to_swap=16（一半的积木）开始\n如果仍然出现内存不足的情况，请增加到 24 或 32 (3B) / 36 (7B)。\n启用此功能swap_io_components可最大程度节省显存\n如果显存充足，可以降低或设置为 0 以加快处理速度。"], "inputs": [], "flags": {}, "type": "Note", "mode": 0, "bgcolor": "#535", "size": [414.3453674316406, 715.8207397460938], "pos": [1946.3702392578125, 2883.0234375], "id": 2, "properties": {"widget_ue_connectable": {}}, "order": 3}, {"mode": 0, "outputs": [{"name": "Filenames", "label": "文件名", "type": "VHS_FILENAMES", "localized_name": "Filenames"}], "size": [617.4718627929688, 700.9723510742188], "pos": [2484.574462890625, 2597.34423828125], "widgets_values": {"save_output": true, "filename_prefix": "AnimateDiff", "loop_count": 0, "pix_fmt": "yuv420p", "save_metadata": true, "crf": 19, "trim_to_audio": false, "videopreview": {"paused": false, "hidden": false, "params": {"score": "0", "filename": "AnimateDiff_00001_p80-audio_pfuvq_1767159871.mp4", "workflow": "AnimateDiff_00001_p80.png", "fullpath": "/data/ComfyUI/personal/28d637c8e34ad1d0e5db10f3a41ca637/output/AnimateDiff_00001_p80-audio.mp4", "format": "video/h264-mp4", "subfolder": "", "label": "Normal", "type": "output", "frame_rate": 30}}, "format": "video/h264-mp4", "no_preview": false, "frame_rate": 8, "pingpong": false}, "inputs": [{"name": "images", "link": 55, "label": "图像", "type": "IMAGE", "localized_name": "images"}, {"shape": 7, "name": "audio", "link": 56, "label": "音频", "type": "AUDIO", "localized_name": "audio"}, {"shape": 7, "name": "meta_batch", "label": "批次管理", "type": "VHS_BatchManager", "localized_name": "meta_batch"}, {"shape": 7, "name": "vae", "label": "vae", "type": "VAE", "localized_name": "vae"}, {"widget": {"name": "frame_rate"}, "name": "frame_rate", "link": 57, "la