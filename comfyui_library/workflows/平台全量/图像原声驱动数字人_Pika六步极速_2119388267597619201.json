l", "links": [11], "label": "model", "type": "MODEL", "localized_name": "模型"}], "color": "#813D43", "widgets_values": ["sol-attn", 1.3, 0.2, 1, "", 12288, 256, "exact_kv_and_rows", false], "inputs": [{"name": "model", "link": 16, "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "selection"}, "name": "selection", "label": "selection", "type": "COMFY_DYNAMICCOMBO_V3", "localized_name": "selection"}, {"widget": {"name": "selection.tau"}, "name": "selection.tau", "label": "selection.tau", "type": "FLOAT", "localized_name": "tau"}, {"widget": {"name": "start_percent"}, "name": "start_percent", "label": "start_percent", "type": "FLOAT", "localized_name": "start_percent"}, {"widget": {"name": "end_percent"}, "name": "end_percent", "label": "end_percent", "type": "FLOAT", "localized_name": "end_percent"}, {"widget": {"name": "dense_blocks"}, "name": "dense_blocks", "label": "dense_blocks", "type": "STRING", "localized_name": "dense_blocks"}, {"widget": {"name": "min_tokens"}, "name": "min_tokens", "label": "min_tokens", "type": "INT", "localized_name": "min_tokens"}, {"widget": {"name": "extra_tokens"}, "name": "extra_tokens", "label": "extra_tokens", "type": "INT", "localized_name": "extra_tokens"}, {"widget": {"name": "sink_conditioning"}, "name": "sink_conditioning", "label": "sink_conditioning", "type": "COMBO", "localized_name": "sink_conditioning"}, {"widget": {"name": "verbose"}, "name": "verbose", "label": "verbose", "type": "BOOLEAN", "localized_name": "verbose"}], "flags": {}, "type": "BlockSparseAttention", "title": "可选 Sol 加速｜默认旁路｜Ctrl+B 启用", "mode": 0, "bgcolor": "#303030", "size": [470, 300], "pos": [560, 1450], "id": 217, "properties": {"widget_ue_connectable": {"selection": true, "extra_tokens": true, "selection.tau": true, "dense_blocks": true, "start_percent": true, "end_percent": true, "sink_conditioning": true, "min_tokens": true, "verbose": true}, "Node name for S&R": "BlockSparseAttention"}, "order": 21, "widgets_values_named": {"selection": "sol-attn", "extra_tokens": 256, "selection.tau": 1.3, "dense_blocks": "", "start_percent": 0.2, "end_percent": 1, "sink_conditioning": "exact_kv_and_rows", "min_tokens": 12288, "verbose": false}}, {"outputs": [], "color": "#35664F", "widgets_values": ["# AI-KSK｜PikaFlex｜原声裁剪＋官方宽高选择更新版\n\n1. 上传人物图片与原始音频。\n2. 在“原声音频裁剪”设置开始位置和截取时长，单位均为秒。默认从0秒开始取5秒。例如开始20、时长8，表示只生成原音频20—28秒这一段。先试听裁剪结果。不要将时长0当作“全部音频”；要整段可旁路裁剪节点，并确认单段显存容量。\n3. 官方ResolutionSelector控制输出宽高：选画幅、megapixels和对齐倍数。默认16:9、0.5MP、32倍数，按当前官方算法为960×544；可选竖屏等其他画幅。宽高已接入Ref2VA，实际尺寸由选择器决定。\n4. 帧数按裁剪后的实际音频时长计算，24fps、17k+5网格；最终VHS合成裁剪后的源音频并开启trim_to_audio。仅渲染所选片段，不用整条原音轨。\n5. 已放入可编辑的通用提示词，人物身份跟随Picture 1、说话节奏跟随Audio 1；没有写死性别、年龄、服装、具体台词或场景。\n\n模型链：H3 Ref2VA → Flex Ref2VA LoRA(1.0) → SigmaShift(12/3) → 注意力后端 → 可选Sol → Guider。LCM＋官方六步手动SIGMAS。Sol默认旁路，启用会改变执行内核，需另测；不是SelfLift变体。\n\n音频路由：LoadAudio → TrimAudioDuration → 参考音频／VRGDG锁音频／实际时长计算／试听；VRGDG音频输出 → VHS最终音轨。视频采样使用经过VRGDG处理的AV latent。锁音频与口型效果仍需GPU实测。\n\n保留此前模型与采样配置、INT8编码器＋FP16视频VAE＋FP32音频VAE、seed9527，及红绿标题栏＋灰色主体。新增节点均来自原生ComfyUI；仍需VRGDG、SoundFlow与VideoHelperSuite。\n\n当前只更新第1、2套。文件名沿用R2，内容为裁剪与分辨率更新版；未做GPU渲染或线上实跑，不是已生成的视频。\n"], "inputs": [], "flags": {"collapsed": true}, "type": "MarkdownNote", "title": "原版说明｜原文保留｜当前接法见下方T8说明", "mode": 0, "bgcolor": "#303030", "size": [480, 310], "pos": [1820, 1520], "id": 218, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "MarkdownNote"}, "order": 10, "widgets_values_named": {"text": "# AI-KSK｜PikaFlex｜原声裁剪＋官方宽高选择更新版\n\n1. 上传人物图片与原始音频。\n2. 在“原声音频裁剪”设置开始位置和截取时长，单位均为秒。默认从0秒开始取5秒。例如开始20、时长8，表示只生成原音频20—28秒这一段。先试听裁剪结果。不要将时长0当作“全部音频”；要整段可旁路裁剪节点，并确认单段显存容量。\n3. 官方ResolutionSelector控制输出宽高：选画幅、megapixels和对齐倍数。默认16:9、0.5MP、32倍数，按当前官方算法为960×544；可选竖屏等其他画幅。宽高已接入Ref2VA，实际尺寸由选择器决定。\n4. 帧数按裁剪后的实际音频时长计算，24fps、17k+5网格；最终VHS合成裁剪后的源音频并开启trim_to_audio。仅渲染所选片段，不用整条原音轨。\n5. 已放入可编辑的通用提示词，人物身份跟随Picture 1、说话节奏跟随Audio 1；没有写死性别、年龄、服装、具体台词或场景。\n\n模型链：H3 Ref2VA → Flex Ref2VA LoRA(1.0) → SigmaShift(12/3) → 注意力后端 → 可选Sol → Guider。LCM＋官方六步手动SIGMAS。Sol默认旁路，启用会改变执行内核，需另测；不是SelfLift变体。\n\n音频路由：LoadAudio → TrimAudioDuration → 参考音频／VRGDG锁音频／实际时长计算／试听；VRGDG音频输出 → VHS最终音轨。视频采样使用经过VRGDG处理的AV latent。锁音频与口型效果仍需GPU实测。\n\n保留此前模型与采样配置、INT8编码器＋FP16视频VAE＋FP32音频VAE、seed9527，及红绿标题栏＋灰色主体。新增节点均来自原生ComfyUI；仍需VRGDG、SoundFlow与VideoHelperSuite。\n\n当前只更新第1、2套。文件名沿用R2，内容为裁剪与分辨率更新版；未做GPU渲染或线上实跑，不是已生成的视频。\n"}}, {"outputs": [{"name": "AUDIO", "links": [13, 14, 25, 26], "label": "AUDIO", "type": "AUDIO", "localized_name": "音频"}], "color": "#35664F", "widgets_values": [15, 15], "inputs": [{"name": "audio", "link": 12, "label": "audio", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "start_index"}, "name": "start_index", "label": "start_index", "type": "FLOAT", "localized_name": "起始索引"}, {"widget": {"name": "duration"}, "name": "duration", "label": "duration", "type": "FLOAT", "localized_name": "时长"}], "flags": {}, "type": "TrimAudioDuration", "title": "原声音频裁剪｜起点＋时长（秒）", "mode": 0, "bgcolor": "#303030", "size": [420, 145], "pos": [20, 800], "id": 219, "properties": {"widget_ue_connectable": {"duration": true, "start_index": true}, "Node name for S&R": "TrimAudioDuration"}, "order": 15, "widgets_values_named": {"duration": 15, "start_index": 15}}, {"outputs": [{"name": "audio", "links": [], "label": "audio", "type": "AUDIO", "localized_name": "audio"}], "color": "#35664F", "widgets_values": [], "inputs": [{"name": "audio", "link": 14, "label": "音频", "type": "AUDIO", "localized_name": "音频"}, {"widget": {"name": "audioUI"}, "name": "audioUI", "label": "audioUI", "type": "AUDIO_UI", "localized_name": "音频UI"}], "flags": {}, "type": "PreviewAudio", "mode": 0, "bgcolor": "#303030", "size": [420, 135], "pos": [20, 1020], "id": 220, "properties": {"cnr_id": "comfy-core", "ver": "0.30.0", "widget_ue_connectable": {"audioUI": true}, "Node name for S&R": "PreviewAudio"}, "order": 18, "widgets_values_named": {}}, {"showAdvanced": false, "outputs": [{"name": "width", "links": [21], "label": "width", "type": "INT", "locali