7], "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#322", "widgets_values": ["add", 10.000000000000002, 1, "Preview", "ComfyUI"], "inputs": [{"name": "target", "link": 2, "label": "target", "type": "IMAGE", "localized_name": "target"}, {"name": "source", "link": 3, "label": "source", "type": "IMAGE", "localized_name": "source"}, {"shape": 7, "name": "mask", "link": 5, "label": "mask", "type": "MASK", "localized_name": "mask"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"name": "blur_sigma"}, "name": "blur_sigma", "label": "blur_sigma", "type": "FLOAT", "localized_name": "blur_sigma"}, {"widget": {"name": "blend_factor"}, "name": "blend_factor", "label": "blend_factor", "type": "FLOAT", "localized_name": "blend_factor"}, {"widget": {"name": "image_output"}, "name": "image_output", "label": "image_output", "type": "COMBO", "localized_name": "image_output"}, {"widget": {"name": "save_prefix"}, "name": "save_prefix", "label": "save_prefix", "type": "STRING", "localized_name": "save_prefix"}], "flags": {}, "type": "easy imageDetailTransfer", "mode": 0, "bgcolor": "#533", "size": [270, 382], "pos": [558.6116333007812, -315.3536071777344], "id": 1, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy imageDetailTransfer"}, "order": 20}, {"outputs": [], "color": "#432", "widgets_values": ["作用：根据mask 从source替换到target上\n\nmode（当前设为add）\nadd\t直接叠加细节，增强目标图像的亮度与纹理\t基础细节增强（如皮肤纹理、服装材质），适合提升帧间细节一致性\nmultiply（正片叠底）\t加深目标图像的暗部细节，保留亮部层次\t增强阴影质感（如头发、服装暗部）、复古风格迁移（如胶片颗粒、暗色调纹理）\nscreen（滤色）\t提亮目标图像的亮部细节，保留暗部层次\t增强高光与通透感（如皮肤光泽、反光表面纹理）、提升画面亮度\noverlay（叠加）\t同时增强亮部与暗部细节，保留中间调自然过渡\t自然的细节增强（如面部立体感、纹理层次），是数字人视频的首选模式\nsoft_light（柔光）\t柔和地增强细节，避免生硬对比\t细腻的皮肤纹理迁移、自然风格融合（如油画质感、柔焦效果）\nhard_light（强光）\t强烈地增强细节，提升对比度\t高对比度纹理增强（如金属质感、锐利边缘、服装纹理）\ncolor_dodge（颜色减淡）\t大幅提亮亮部，增强通透感\t增强玻璃、反光表面的细节，提升画面通透度\ncolor_burn（颜色加深）\t大幅加深暗部，增强阴影层次\t增强头发、服装的暗部纹理，提升画面层次感\ndifference/exclusion\t突出细节差异，生成对比效果\t检测帧间变化、修复跳变（较少用于细节增强）\ndivide（划分）\t提亮并简化细节，去除杂色\t保留清晰纹理的同时减少噪声，适合修复模糊帧\n\n\nblur_sigma（3.00）\t细节模糊强度：数值越大，迁移的细节越柔和（如 3.0 适合自然融合，1.0 适合保留锐利边缘）。\nblend_factor（1.000）\t细节混合因子：数值越大（0.5-1.0），source 细节的占比越高（1.0 表示完全保留 source 细节，0.5 表示与 target 各占 50%）。"], "inputs": [], "flags": {"pinned": true}, "type": "Note", "title": "Image Detail Transfer", "mode": 0, "bgcolor": "#653", "size": [864.4779663085938, 348.8337707519531], "pos": [537.1907348632812, 271.929443359375], "id": 5, "properties": {"widget_ue_connectable": {}}, "order": 10}, {"mode": 0, "outputs": [{"name": "image", "links": [35, 38, 70], "label": "image", "type": "IMAGE", "localized_name": "image"}], "size": [270, 382], "pos": [1597.6622314453125, -305.8144836425781], "widgets_values": ["add", 3.0000000000000004, 1, "Preview", "ComfyUI"], "inputs": [{"name": "target", "link": 31, "label": "target", "type": "IMAGE", "localized_name": "target"}, {"name": "source", "link": 33, "label": "source", "type": "IMAGE", "localized_name": "source"}, {"shape": 7, "name": "mask", "link": 32, "label": "mask", "type": "MASK", "localized_name": "mask"}, {"widget": {"name": "mode"}, "name": "mode", "label": "mode", "type": "COMBO", "localized_name": "mode"}, {"widget": {"name": "blur_sigma"}, "name": "blur_sigma", "label": "blur_sigma", "type": "FLOAT", "localized_name": "blur_sigma"}, {"widget": {"name": "blend_factor"}, "name": "blend_factor", "label": "blend_factor", "type": "FLOAT", "localized_name": "blend_factor"}, {"widget": {"name": "image_output"}, "name": "image_output", "label": "image_output", "type": "COMBO", "localized_name": "image_output"}, {"widget": {"name": "save_prefix"}, "name": "save_prefix", "label": "save_prefix", "type": "STRING", "localized_name": "save_prefix"}], "flags": {}, "id": 33, "type": "easy imageDetailTransfer", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy imageDetailTransfer"}, "order": 27}, {"mode": 0, "outputs": [{"name": "image_urls", "label": "image_urls", "type": 