ized_name": "images"}], "bgcolor": "#653", "size": [838.0352172851562, 1079.65673828125], "color": "#432", "pos": [2782.4228515625, 892.8359375], "inputs": [{"name": "images", "link": 35, "label": "图像", "type": "IMAGE", "localized_name": "图像"}], "flags": {}, "id": 28, "type": "PreviewImage", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "PreviewImage"}, "order": 29}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [262.7143859863281, 188.23828125], "color": "#fff0", "pos": [4173.03955078125, 1316.7459716796875], "inputs": [], "flags": {"allow_interaction": true}, "id": 30, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#1B4669", "borderRadius": 20, "textAlign": "center", "fontSize": 11, "backgroundAlpha": 0.25, "lineHeight": 1.4, "text": " factor【匹配强度｜0～1.5 常用】\n等效 “色彩迁移力度”\n0.0：完全不生效，原图原样输出\n0.6～0.8：柔和融合，保留自身画面气质，视频批量调色推荐区间\n1.0 默认：完整套用参考图色调\n>1.0：强化染色，参考色调会过重，容易出现偏色、色彩溢出\n✅ 建议：人像尽量 ≤0.9；氛围风景图可以尝试 1.0～1.1。", "stroke": true, "fontColor": "#C8C8C8"}, "order": 8}, {"mode": 0, "outputs": [], "bgcolor": "transparent", "size": [262.7143859863281, 272.93829345703125], "color": "#fff0", "pos": [4173.51806640625, 1530.1063232421875], "inputs": [], "flags": {"allow_interaction": true}, "id": 31, "type": "孤海注释", "properties": {"padding": 12, "backgroundColor": "#1B4669", "borderRadius": 20, "textAlign": "center", "fontSize": 11, "backgroundAlpha": 0.25, "lineHeight": 1.4, "text": "wavelet_levels【小波分层等级｜仅 wavelet 模式生效】\n范围一般 1~8，代表图像频率分层数量\n数值越大 = 更多层级参与色彩迁移\n3~4：只改变大面积底色（天空、墙面这种大块区域），极小影响物体明暗反差，适合保护主体光影\n5 默认：均衡方案，大面积色调 + 中等光影同时迁移，通用选择\n6~7：连中等尺度光影（物体明暗交界）一起跟着参考图变化，画面风格贴合度更高，但更容易轻微改变立体感\n≥8：精细细节层也参与调色，有概率出现噪点波动、画面微闪烁（视频尽量不要拉太高）", "stroke": true, "fontColor": "#C8C8C8"}, "order": 9}, {"outputs": [{"name": "image", "links": [28, 30, 32], "label": "image", "type": "IMAGE", "localized_name": "image"}], "color": "#232", "widgets_values": ["wavelet", 0.7000000000000002, 5], "inputs": [{"name": "image_ref", "link": 36, "label": "ima