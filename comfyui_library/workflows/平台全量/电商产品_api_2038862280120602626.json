视\n产品尺寸需符合原物体逻辑\n透视关系与场景一致\n不可出现比例异常或违和感\n5️⃣ 小红书风格控制\n保持“真实生活感”\n不强化商业感\n不增加额外视觉特效\n不做海报化处理\n【输出结构规则】\n\n必须仅输出以下内容：\n\n画面整体风格\n产品替换方式\n融合细节表现\n视觉一致性控制\n最终画面效果描述\n【输出限制规则】\n禁止出现：\n文案\n标题\n种草内容\nprompt / AI相关词\n禁止解释过程\n不输出步骤说明\n只输出结果描述", "", 0.6, 676485992, "randomize"], "inputs": [{"shape": 7, "name": "image1", "link": 48, "label": "image1", "type": "IMAGE", "localized_name": "image1"}, {"shape": 7, "name": "image2", "link": 49, "label": "image2", "type": "IMAGE", "localized_name": "image2"}, {"shape": 7, "name": "image3", "label": "image3", "type": "IMAGE", "localized_name": "image3"}, {"shape": 7, "name": "image4", "label": "image4", "type": "IMAGE", "localized_name": "image4"}, {"shape": 7, "name": "video", "label": "video", "type": "VIDEO", "localized_name": "video"}, {"shape": 7, "name": "image5", "label": "image5", "type": "IMAGE", "localized_name": "image5"}, {"shape": 7, "name": "image6", "label": "image6", "type": "IMAGE", "localized_name": "image6"}, {"shape": 7, "name": "image7", "label": "image7", "type": "IMAGE", "localized_name": "image7"}, {"shape": 7, "name": "image8", "label": "image8", "type": "IMAGE", "localized_name": "image8"}, {"widget": {"name": "model"}, "name": "model", "label": "model", "type": "COMBO", "localized_name": "model"}, {"widget": {"name": "role"}, "name": "role", "label": "role", "type": "STRING", "localized_name": "role"}, {"widget": {"name": "prompt"}, "name": "prompt", "label": "prompt", "type": "STRING", "localized_name": "prompt"}, {"widget": {"name": "temperature"}, "name": "temperature", "label": "temperature", "type": "FLOAT", "localized_name": "temperature"}, {"widget": {"name": "seed"}, "name": "seed", "label": "seed", "type": "INT", "localized_name": "seed"}], "flags": {}, "id": 43, "type": "RH_LLMAPI_Pro_Node", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "RH_LLMAPI_Pro_Node"}, "order": 2}, {"mode": 0, "outputs": [{"name": "image_urls", "links": [], "label": "image_urls", "type": "STRING", "locali