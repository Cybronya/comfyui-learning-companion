mode": 2, "outputs": [{"name": "output", "label": "output", "type": "*", "localized_name": "output"}], "size": [269.70355224609375, 209.97665405273438], "pos": [689.4466552734375, 741.1461181640625], "widgets_values": ["一辆未来感十足的流线型概念车，以侧后方四分之三视角呈现，车身轮廓饱满而富有张力，线条流畅且充满动感。主体为一辆低矮、宽体的电动跑车，车顶弧线优雅地延伸至车尾，形成一体式溜背造型，车窗线条锐利，与车体无缝衔接。车尾设计极具雕塑感，尾灯组以细长的水平光带贯穿，下方是夸张的扩散器与双排气布局，强调性能与速度。轮毂采用多辐条镂空设计，视觉上轻盈而富有科技感，轮胎宽大，紧贴地面，突显抓地力。\n\n前景聚焦于车辆后轮与侧裙部分，线条密集且富有层次，通过粗细不一的笔触勾勒出光影变化与体积感，轮拱外扩，强化了力量与肌肉感。中景是车身主体，从车门到车尾的过渡流畅，腰线微微上扬，赋予车辆向前俯冲的动态姿态。背景为纯白留白，无任何干扰元素，使观者注意力完全集中在车辆本身，凸显设计的纯粹与专注。\n\n构图采用经典黄金比例布局，车辆占据画面中心偏右位置，视觉重心稳定而富有张力。视觉引导从车头灯延伸至车尾灯，再由车身腰线引导至轮毂，形成一条动态的S形曲线，带动视线流动，增强速度感与空间纵深。线条运用极具表现力，既有轻盈的草图笔触，也有重压的轮廓线，形成对比与节奏，展现设计过程中的思考与探索。\n\n色调为单色黑白，以铅笔素描形式呈现，线条粗细变化丰富，明暗对比强烈，通过交叉排线与阴影处理，营造出金属质感与光影层次。光影氛围静谧而专注，"], "inputs": [{"shape": 7, "name": "anything", "link": 98, "label": "anything", "type": "*", "localized_name": "anything"}], "flags": {}, "id": 64, "type": "easy showAnything", "properties": {"cnr_id": "comfyui-easy-use", "ver": "499ed4eafc3ad9d0f26e2cad40219a9e0d613fe5", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.1"}, "widget_ue_connectable": {}, "Node name for S&R": "easy showAnything"}, "order": 22}, {"mode": 2, "outputs": [{"name": "log", "links": [100], "label": "log", "type": "STRING", "localized_name": "log"}, {"name": "save_path", "label": "save_path", "type": "STRING", "localized_name": "save_path"}], "size": [400, 348], "pos": [235.21011352539062, 1067.6397705078125], "widgets_values": ["C:\\Users\\Phil\\Downloads\\新建文件夹", "C:\\Users\\Phil\\Downloads\\新建文件夹", "Siliconflow", "<url>", "<your_key>", "Qwen/Qwen3-VL-32B-Instruct", "你是一位专业的AI图像生成提示词工程师。请详细描述这张图像的主体、前景、中景、背景、构图、视觉引导、色调、光影氛围等细节并创作出具有深度、氛围和艺术感的图像提示词。要求：中文提示词，不要出现对图像水印的描述，不要出现无关的文字和符号，不需要总结，限制在800字以内", "Chinese", 0.5, 6, 6], "inputs": [{"widget": {"name": "input_dir"}, "name": "input_dir", "label": "input_dir", "type": "STRING", "localized_name": "input_dir"}, {"widget": {"name": 