3.47998046875], "widgets_values": [], "inputs": [{"name": "samples", "link": 33, "label": "samples", "type": "LATENT", "localized_name": "samples"}, {"name": "vae", "link": 34, "label": "vae", "type": "VAE", "localized_name": "vae"}], "flags": {"collapsed": false}, "id": 41, "type": "VAEDecode", "properties": {"cnr_id": "comfy-core", "hasSecondTab": false, "ver": "0.3.48", "widget_ue_connectable": {}, "secondTabText": "Send Back", "enableTabs": false, "secondTabOffset": 80, "Node name for S&R": "VAEDecode", "tabWidth": 65, "secondTabWidth": 65, "tabXOffset": 10}, "order": 17}, {"outputs": [{"name": "prompt_list", "label": "prompt_list", "type": "LIST", "localized_name": "prompt_list"}, {"shape": 6, "name": "prompt_strings", "label": "prompt_strings", "type": "STRING", "localized_name": "prompt_strings"}], "color": "#233", "widgets_values": ["户外草地场景，阳光照射，影子投射在草地上，影子形似穿着长裙的人物轮廓，裙身部分覆盖着紫色、白色、淡紫色的花朵，自然清新风格，写实，近景拍摄", "文字创意海报，插画，竖纹磨砂玻璃，小标题瘦金体“初夏”，与小字“CHUXIA”作为点缀，极其抽象树、抽象花、抽象的叶，梦幻，柔性纤维，淡淡绿渐变色，治愈配色，纤维艺术，3D设计，前卫艺术、先锋艺术、时尚摄影、概念设计、材质实验、干净背景，装置艺术，C4D渲染，大师风格，背景调色渐变，极简主义，大师作品。", "金属镭射质感的一束铿锵玫瑰，酸性色彩，金属环，穿插，叠加，立体，层次感，重构，大胆，前卫，先锋艺术，海报设计，创意，冲击力，排版艺术，但彩色弥散渐变简约柔和背景，主标题“Avant-garde Art”，装饰文案“Dreamine 2025”,“Design by Kacha2”, “Rose Rose I love you”“Embrace your dreams and Go Now!” ，杰作", "一张特写照片中，年轻女子拥有中棕色长发与柔和的灰眸，身着简约白色棉质衬衫，灰色围巾松垮地搭在颈间。焦点凝聚于她的双手——正轻捧冒着热气的咖啡杯，素雅的银戒在光线中微微闪烁。她神情放松，唇角噙着若有似无的笑意。温暖晨光透过窗户流淌而入，轻柔照亮她的面庞与杯口升腾的蒸汽。相机采用平视视角，捕捉到她宁静的凝视。背景是虚化的室内环境，中性色调的舒适客厅让画面主体更为突出，整体氛围温暖而静谧。", "画面内容描述：\n\n背景为阳光明媚的户外场景，绿草如茵，树木郁郁葱葱，天空湛蓝，白云飘逸。画面中央为一个家庭在户外野餐、放风筝，充满活力与互动感。远处有湖泊、小山和野花点缀，增添自然气息。画面整体风格清新、阳光、充满生机。\n\n文字排版说明：\n\n大标题（中文，粗体，绿色系，带树叶、风筝、野餐篮装饰）：\n“五一出游，拥抱自然”\n副标题（英文，现代字体，淡绿色）：\n“SPRING OUTING, MAY 1ST”\n标语（居中，白色背景框，绿色边框，手写字体）：\n“五一不宅家，阳光正当时”\n活动亮点（小字，绿色，居中两行）：\n“户外野餐 · 骑行探险 · 亲子互动”\n“自然摄影 · 湖边漫步 · 春日市集”\n时间地点（现代中文字体，居中两行，绿色）：\n“活动时间：2025年5月1日”\n“活动地点：绿野湖畔公园”\n字体、颜色、装饰建议：\n\n字体：标题使用粗体中文手写体，副标题使用现代无衬线字体，标语使用手写字体，正文使用清晰易读的中文字体。\n配色：主色调为绿色（如#4CAF50、#81C784），辅以黄色（#FFEB3B）、白色、浅蓝色（#80DEEA）等，营造清新自然的氛围。\n装饰元素：风筝、野餐篮、树叶、花朵、阳光光晕、小动物等，增强画面趣味性和节日感。\n整体布局：标题居上，标语居中，亮点和时间地点居下，画面元素分布均衡，留白适度，视觉层次分明。"], "inputs": [{"shape": 7, "name": "optional_prompt_list", "label": "optional_prompt_list", "type": "LIST", "localized_name": "optional_prompt_list"}, {"widget": {"name": "prompt_1"}, "name": "prompt_1", "label": "prompt_1", "type": "STRING", "localized_name": "prompt_1"}, {"widget": {"name": "prompt_2"}, "name": "prompt_2", "label": "prompt_2", "type": "STRING", "localized_name": "prompt_2"}, {"widget": {"name": "prompt_3"}, "name": "prompt_3", "label": "prompt_3", "type": "STRING", "localized_name": "prompt_3"}, {"widget": {"name": "prompt_4"}, "name": "prompt_4", "label": "prompt_4", "type": "STRING", "localized_name": "prompt_4"}, {"widget": {"name": "prompt_5"}, "name": "prompt_5", "label": "prompt_5", "type": "STRING", "localized_name": "prompt_5"}], "flags": {}, "type": "easy promptList", "mode": 0, "bgcolor": "#355", "size": [552.470703125, 395.0610046386719], "pos": [717.72021484375, 590.6726684570312], "id": 81, "properties": {"widget_ue_connectable": {}, "Node name for S&R": "easy promptList"}, "order": 6}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [], "label": "MODEL", "type": "MODEL", "localized_name": "MODEL"}], "size": [363.9422607421875, 99.33280181884766], "pos": [892.3572998046875, 387.3671875], "widgets_values": ["AWPortrait-QW_1.0.safetensors", 1], "inputs": [{"name": "model", "label": "model", "type": "MODEL", "localized_name": "model"}, {"widget": {"name": "lora_name"}, "name": "lora_name", "label": "lora_name", "type": "COMBO", "localized_name": "lora_name"}, {"widget": {"name": "strength_model"}, "name": "strength_model", "label": "strength_model", "type": "FLOAT", "localized_name": "strength_model"}], "flags": {}, "id": 80, "type": "LoraLoaderModelOnly", "title": "Load LoRA/亚洲人像", "properties": {"widget_ue_connectable": {}, "Node name for S&R": "LoraLoaderModelOnly"}, "order": 7}, {"mode": 0, "outputs": [{"name": "MODEL", "links": [32], "label": "